{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "binding_id", "stage_id", "status", "ontology_id", "compiled_predecessors", "protected_admitted_runtime", "candidate_crate", "symbol_bindings", "behavior_bindings", "implementation_constraints", "next_product_frontier", "product_approval", "implementation_authorized", "authority_effect", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "cal.implementation-binding/v2"},
    "binding_id": {"const": "CAL-D65-EPOCH-002-IMPLEMENTATION-BINDING-001"},
    "stage_id": {"const": "D65-S6"},
    "status": {"const": "prototype"},
    "ontology_id": {"const": "cal.ontology-runtime-export-cutover.system.epoch-002"},
    "compiled_predecessors": {"type": "array", "minItems": 5},
    "protected_admitted_runtime": {"type": "array", "minItems": 8},
    "candidate_crate": {"type": "object", "required": ["crate_name", "crate_version", "root", "files", "dependency"]},
    "symbol_bindings": {"type": "array", "minItems": 5},
    "behavior_bindings": {"type": "array", "minItems": 4},
    "implementation_constraints": {"type": "array", "minItems": 5},
    "next_product_frontier": {"const": "D65-S7"},
    "product_approval": {"const": "not-requested"},
    "implementation_authorized": {"const": false},
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"type": "string"}
  }
}
