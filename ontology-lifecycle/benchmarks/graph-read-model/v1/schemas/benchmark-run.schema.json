{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cal://schemas/graph-read-model-benchmark-run/1.1.0",
  "title": "CyberAlchemy graph read-model benchmark run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "benchmark_id",
    "status",
    "config",
    "triple_count",
    "query_executions_per_backend",
    "fixture_digest_sha256",
    "correctness",
    "backends",
    "external_backends",
    "canonical_authority",
    "claim_ceiling"
  ],
  "properties": {
    "record_type": { "const": "benchmark_run" },
    "schema_version": { "const": "1.1.0" },
    "benchmark_id": { "const": "CAL-GRAPH-READ-MODEL-BENCHMARK-001" },
    "status": { "enum": ["pass", "fail", "not_evaluable"] },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "node_count", "relation_edges_per_node", "query_count", "repetitions"],
      "properties": {
        "seed": { "type": "integer", "minimum": 0 },
        "node_count": { "type": "integer", "minimum": 1 },
        "relation_edges_per_node": { "type": "integer", "minimum": 1 },
        "query_count": { "type": "integer", "minimum": 1 },
        "repetitions": { "type": "integer", "minimum": 1 }
      }
    },
    "triple_count": { "type": "integer", "minimum": 1 },
    "query_executions_per_backend": { "type": "integer", "minimum": 1 },
    "fixture_digest_sha256": { "$ref": "#/$defs/sha256" },
    "correctness": {
      "type": "object",
      "required": ["status", "compared_backends", "shared_result_digest_sha256", "interop_result_digest_sha256", "query_results_compared"]
    },
    "backends": { "type": "array", "minItems": 2 },
    "external_backends": { "type": "array", "minItems": 1 },
    "canonical_authority": { "const": "canonical events only; every read model is disposable and rebuildable" },
    "claim_ceiling": { "const": "local_single_process_experiment_only" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
