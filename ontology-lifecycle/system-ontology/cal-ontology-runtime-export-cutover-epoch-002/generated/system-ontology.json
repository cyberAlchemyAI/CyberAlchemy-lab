    },
    {
      "ref": "cal.context.ontology-lifecycle/v2",
      "role": "downstream-event-calculated-projection-owner",
      "version": "1.1.0-candidate.1"
    }
  ],
  "context_map_binding": {
    "direction": "source-to-target",
    "ref": "cal.context-map.governance-ontology-lifecycle/v2",
    "relationship": "published-language-plus-anticorruption-layer",
    "version": "2.0.0-candidate.1"
  },
  "event_types": [
    {
      "aggregate": "OntologyNode",
