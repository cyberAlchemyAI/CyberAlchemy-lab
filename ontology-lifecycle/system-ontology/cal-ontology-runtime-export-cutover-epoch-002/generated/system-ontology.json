      "stream_identity": "node:{ontology_id}:{node_id}"
    },
    {
      "aggregate_id": "OntologyRelation",
      "governance_stream": "relation-governance",
      "semantic_stream": "relation-semantic",
      "state_calculation": "latest complete resulting state at or before exact semantic cursor",
      "stream_identity": "relation:{ontology_id}:{relation_id}"
    }
  ],
