    "crate": "cal-ontology-context-adapters-v2",
    "map_binding_symbol": "V2_CONTEXT_MAP",
    "modules": [
      "governance_v2",
      "ontology_lifecycle_v2"
    ],
    "source_runtime": "cal-ontology-lifecycle"
  },
  "aggregate_types": [
    {
      "aggregate_id": "OntologyNode",
