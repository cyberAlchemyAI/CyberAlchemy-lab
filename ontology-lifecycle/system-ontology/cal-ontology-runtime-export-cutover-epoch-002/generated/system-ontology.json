      "family": "semantic"
    }
  ],
  "invariants": [
    {
      "invariant_id": "INV-CANONICAL-EVENTS-ONLY",
      "rule": "Only canonical node and relation events calculate ontology state."
    },
    {
      "invariant_id": "INV-EXACT-GOVERNANCE-JOIN",
      "rule": "Every governance event cites one exact semantic event identity, digest, and cursor."
    },
    {
      "invariant_id": "INV-V2-TOPOLOGY",
      "rule": "Projection requests require the exact declared v2 endpoints, map, and source-to-target direction."
    },
    {
      "invariant_id": "INV-NO-AUTHORITY-TRANSFER",
      "rule": "Translated governance evidence never transfers authority or enforcement capability."
    },
    {
      "invariant_id": "INV-DERIVATIVES-NONCANONICAL",
      "rule": "Snapshots, projections, indexes, compiled graphs, and system ontologies cannot be replay sources."
    }
  ],
