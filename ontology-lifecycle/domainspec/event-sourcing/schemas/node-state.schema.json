{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cyberalchemy-lab:ontology-lifecycle:node-state:v2-candidate",
  "title": "Ontology node complete resulting semantic state",
  "type": "object",
  "additionalProperties": false,
  "required": ["identity", "lifecycle", "label", "definition_or_claim", "scope", "semantic_components", "semantic_definition_refs", "typed_properties", "use_obligations", "forbidden_collapse", "profile_ref"],
  "properties": {
    "identity": {"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:common:v2-candidate#/$defs/NodeIdentity"},
    "lifecycle": {"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:common:v2-candidate#/$defs/Lifecycle"},
    "label": {"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:common:v2-candidate#/$defs/NonEmptyString"},
    "definition_or_claim": {"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:common:v2-candidate#/$defs/NonEmptyString"},
    "scope": {"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:common:v2-candidate#/$defs/NonEmptyString"},
    "semantic_components": {"type": "array", "items": {"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:common:v2-candidate#/$defs/SemanticComponent"}},
    "semantic_definition_refs": {"type": "array", "minItems": 1, "items": {"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:common:v2-candidate#/$defs/DefinitionReference"}},
    "typed_properties": {"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:common:v2-candidate#/$defs/TypedPropertySet"},
    "use_obligations": {"type": "array", "items": {"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:common:v2-candidate#/$defs/UseObligation"}},
    "forbidden_collapse": {"type": "array", "items": {"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:common:v2-candidate#/$defs/ForbiddenCollapse"}},
    "profile_ref": {"const": "test-empty-profile/v1"}
  },
  "x-definition-ref": "ontology-lifecycle.ontology-semantic-state",
  "x-lifecycle-decision-ref": "GONLIFE-1",
  "x-authority-effect": "none"
}
