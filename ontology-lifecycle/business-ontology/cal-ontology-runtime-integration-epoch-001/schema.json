{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cal.schema.business-ontology-runtime-integration/v1",
  "type": "object",
  "additionalProperties": true,
  "$defs": {
    "profile": {"type":"object","required":["schema_version","ontology_id","ontology_type","branch","materialization","package_root","package_owner","visibility","candidate_status","authority_effect","predecessor","owner_gate","blocked_outputs"]},
    "sources": {"type":"object","required":["schema_version","sources"],"properties":{"sources":{"type":"array","minItems":8,"maxItems":8}}},
    "nodes": {"type":"object","required":["schema_version","nodes"],"properties":{"nodes":{"type":"array","minItems":26,"maxItems":26}}},
    "relations": {"type":"object","required":["schema_version","relation_vocabulary","relations"],"properties":{"relation_vocabulary":{"type":"array","minItems":12,"maxItems":12},"relations":{"type":"array","minItems":35,"maxItems":35}}},
    "contracts": {"type":"object","required":["schema_version","contracts"],"properties":{"contracts":{"type":"array","minItems":8,"maxItems":8}}},
    "policies": {"type":"object","required":["schema_version","policies"],"properties":{"policies":{"type":"array","minItems":3,"maxItems":3}}},
    "workflows": {"type":"object","required":["schema_version","workflows"],"properties":{"workflows":{"type":"array","minItems":2,"maxItems":2}}},
    "failures": {"type":"object","required":["schema_version","failures"],"properties":{"failures":{"type":"array","minItems":13,"maxItems":13}}},
    "residue": {"type":"object","required":["schema_version","residue"],"properties":{"residue":{"type":"array","minItems":5,"maxItems":5}}},
    "decision_request": {"type":"object","required":["schema_version","request_id","gate_id","status","question","candidate_refs","candidate_summary","options","decision_owner_route","blocked_until_selection","authority_effect","claim_ceiling"]}
  }
}
