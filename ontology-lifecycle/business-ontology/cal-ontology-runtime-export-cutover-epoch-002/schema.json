{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ontology_id", "stage_id", "status", "capability_ref", "predecessors", "context_contract", "nodes", "relations", "bridge_contract", "rules", "next_product_frontier", "product_approval", "authority_effect", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "cal.business-ontology-prototype/v2"},
    "ontology_id": {"const": "cal.ontology-runtime-export-cutover.business.epoch-002"},
    "stage_id": {"const": "D65-S3"},
    "status": {"const": "prototype"},
    "capability_ref": {"type": "string", "minLength": 1},
    "predecessors": {"type": "array", "minItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "context_contract": {"type": "object", "required": ["governance_context_ref", "ontology_lifecycle_context_ref", "context_map_ref", "direction", "source_language_ref", "target_language_ref"]},
    "nodes": {"type": "array", "minItems": 5, "items": {"type": "object", "required": ["id", "kind", "meaning"]}},
    "relations": {"type": "array", "minItems": 3, "items": {"type": "object", "required": ["id", "source", "predicate", "target"]}},
    "bridge_contract": {"type": "object", "required": ["contract_id", "payload_required", "acl_translation", "preserved_upstream_fields", "forbidden_fields", "failures", "challenge_contract"]},
    "rules": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 1}},
    "next_product_frontier": {"const": "D65-S4"},
    "product_approval": {"const": "not-requested"},
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  }
}
