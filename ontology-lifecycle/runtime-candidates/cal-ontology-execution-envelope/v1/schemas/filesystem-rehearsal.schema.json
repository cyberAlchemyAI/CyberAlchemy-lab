{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cal.d65-filesystem-rehearsal-contract/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target", "invariants"],
  "properties": {
    "schema_version": {
      "const": "cal.d65-filesystem-rehearsal-contract/v1"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "identity",
        "path_policy",
        "caller_supplied_path",
        "live",
        "production_data",
        "credential_kind",
        "network",
        "external_effects",
        "disposable_local_filesystem_effects"
      ]
    },
    "invariants": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["invariant_id", "required_observation"],
        "properties": {
          "invariant_id": {"type": "string"},
          "required_observation": {"type": "string"}
        }
      }
    }
  }
}
