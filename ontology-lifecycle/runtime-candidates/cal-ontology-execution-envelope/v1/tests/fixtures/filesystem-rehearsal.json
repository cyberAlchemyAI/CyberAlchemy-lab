{
  "schema_version": "cal.d65-filesystem-rehearsal-contract/v1",
  "target": {
    "kind": "filesystem-disposable-target",
    "identity": "cal.prototype.rust-disposable-filesystem-target/epoch-002",
    "path_policy": "adapter-created-process-temporary-directory",
    "caller_supplied_path": false,
    "live": false,
    "production_data": false,
    "credential_kind": "none",
    "network": false,
    "external_effects": false,
    "disposable_local_filesystem_effects": true
  },
  "invariants": [
    {
      "invariant_id": "FSR-01-PATH-CONFINEMENT",
      "required_observation": "root is created below the process temporary directory without a caller path"
    },
    {
      "invariant_id": "FSR-02-EXACT-BINDING",
      "required_observation": "only the exact disposable filesystem identity is accepted"
    },
    {
      "invariant_id": "FSR-03-BYTE-PREIMAGE",
      "required_observation": "normal rollback restores the exact preimage bytes"
    },
    {
      "invariant_id": "FSR-04-FAILURE-RESTORATION",
      "required_observation": "post-preimage failure performs exact emergency restoration"
    },
    {
      "invariant_id": "FSR-05-CLEANUP",
      "required_observation": "the complete rehearsal directory is absent after cleanup"
    },
    {
      "invariant_id": "FSR-06-DETERMINISTIC-REPORT",
      "required_observation": "two clean rehearsals emit identical canonical report bytes"
    }
  ]
}
