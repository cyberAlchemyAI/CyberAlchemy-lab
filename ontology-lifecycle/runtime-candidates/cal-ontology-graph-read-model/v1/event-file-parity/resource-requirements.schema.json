{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cal-event-file-parity-resource-requirements/v1-prototype",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "node_count",
    "relation_count",
    "subject_count",
    "semantic_event_file_count",
    "governance_event_file_count",
    "minimum_available_memory_bytes",
    "minimum_available_filesystem_bytes",
    "minimum_available_filesystem_inodes",
    "hard_virtual_memory_bytes",
    "maximum_generation_peak_rss_kib",
    "maximum_recovery_peak_rss_kib",
    "maximum_logical_event_bytes",
    "maximum_allocated_fixture_bytes",
    "maximum_generation_ns",
    "maximum_process_recovery_ns",
    "attempt_count",
    "compilation_time_excluded",
    "fixture_kind",
    "canonical_replay_source",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {"const": "cal-event-file-parity-resource-requirements/v1-prototype"},
    "profile_id": {"const": "parity"},
    "node_count": {"const": 50000},
    "relation_count": {"const": 200000},
    "subject_count": {"const": 250000},
    "semantic_event_file_count": {"const": 250000},
    "governance_event_file_count": {"const": 250000},
    "minimum_available_memory_bytes": {"type": "integer", "minimum": 1},
    "minimum_available_filesystem_bytes": {"type": "integer", "minimum": 1},
    "minimum_available_filesystem_inodes": {"type": "integer", "minimum": 500002},
    "hard_virtual_memory_bytes": {"type": "integer", "minimum": 1},
    "maximum_generation_peak_rss_kib": {"type": "integer", "minimum": 1},
    "maximum_recovery_peak_rss_kib": {"type": "integer", "minimum": 1},
    "maximum_logical_event_bytes": {"type": "integer", "minimum": 1},
    "maximum_allocated_fixture_bytes": {"type": "integer", "minimum": 1},
    "maximum_generation_ns": {"type": "integer", "minimum": 1},
    "maximum_process_recovery_ns": {"type": "integer", "minimum": 1},
    "attempt_count": {"const": 2},
    "compilation_time_excluded": {"const": true},
    "fixture_kind": {"const": "synthetic-canonical-format-event-files"},
    "canonical_replay_source": {"const": false},
    "authority_effect": {"const": "none"}
  },
  "additionalProperties": false
}
