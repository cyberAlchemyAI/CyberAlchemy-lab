{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cal-ontology-graph-read-model-benchmark-attempt/v1",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark_id",
    "profile_id",
    "attempt",
    "status",
    "implementation_digest_sha256",
    "config",
    "fixture_digest_sha256",
    "correctness",
    "calculated_delta",
    "concurrent_snapshots",
    "restart_recovery",
    "candidate",
    "scan_control",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "cal-ontology-graph-benchmark-attempt/v1"},
    "benchmark_id": {"const": "CAL-ONTOLOGY-GRAPH-READ-MODEL-BENCHMARK-002"},
    "profile_id": {"enum": ["smoke", "medium", "large"]},
    "attempt": {"type": "integer", "minimum": 1},
    "status": {"enum": ["pass", "block"]},
    "calculated_delta": {
      "type": "object",
      "required": [
        "total_changes",
        "semantic_changes",
        "incremental_apply_ns",
        "full_target_rebuild_ns",
        "transaction_strategy",
        "staged_previous_subject_count",
        "full_model_clone",
        "exact_model_equivalence",
        "target_projection_digest_sha256",
        "resulting_index_digest_sha256",
        "delta_digest_sha256"
      ],
      "properties": {
        "transaction_strategy": {"const": "bounded_rollback_journal"},
        "staged_previous_subject_count": {"type": "integer", "minimum": 1},
        "full_model_clone": {"const": false},
        "exact_model_equivalence": {"const": true}
      }
    },
    "concurrent_snapshots": {
      "type": "object",
      "required": [
        "publication_strategy",
        "worker_observations",
        "invalid_observations",
        "writer_completed_while_old_snapshot_held",
        "old_snapshot_retained_after_publication",
        "publication_staged_full_model_clone",
        "previous_subject_count",
        "shared_subject_count",
        "previous_challenge_contract_count",
        "shared_challenge_contract_count",
        "previous_index_bucket_count",
        "shared_index_bucket_count",
        "published_generation",
        "exact_final_model_equivalence",
        "readers_are_blocking"
      ],
      "properties": {
        "publication_strategy": {"const": "structurally_shared_arc_snapshot"},
        "invalid_observations": {"const": 0},
        "writer_completed_while_old_snapshot_held": {"const": true},
        "old_snapshot_retained_after_publication": {"const": true},
        "publication_staged_full_model_clone": {"const": false},
        "previous_subject_count": {"type": "integer", "minimum": 1},
        "shared_subject_count": {"type": "integer", "minimum": 1},
        "previous_challenge_contract_count": {"type": "integer", "minimum": 1},
        "shared_challenge_contract_count": {"type": "integer", "minimum": 1},
        "previous_index_bucket_count": {"type": "integer", "minimum": 1},
        "shared_index_bucket_count": {"type": "integer", "minimum": 1},
        "published_generation": {"const": 1},
        "exact_final_model_equivalence": {"const": true},
        "readers_are_blocking": {"const": false}
      }
    },
    "restart_recovery": {
      "type": "object",
      "required": [
        "recovery_strategy",
        "cold_recovery_ns",
        "maximum_cold_recovery_ns",
        "within_objective",
        "exact_model_equivalence",
        "exact_index_digest_match",
        "recovered_semantic_cursor",
        "recovered_source_event_count",
        "recovered_source_event_set_digest_sha256",
        "recovered_index_digest_sha256",
        "checkpoint_used",
        "corruption_controls_in_test_suite"
      ],
      "properties": {
        "recovery_strategy": {"const": "full_rebuild_from_verified_calculated_cut"},
        "cold_recovery_ns": {"type": "integer", "minimum": 1},
        "maximum_cold_recovery_ns": {"type": "integer", "minimum": 1},
        "within_objective": {"const": true},
        "exact_model_equivalence": {"const": true},
        "exact_index_digest_match": {"const": true},
        "checkpoint_used": {"const": false},
        "corruption_controls_in_test_suite": {"type": "integer", "minimum": 4}
      }
    },
    "claim_ceiling": {"const": "local_single_process_synthetic_prototype_evidence_only"}
  },
  "additionalProperties": true
}
