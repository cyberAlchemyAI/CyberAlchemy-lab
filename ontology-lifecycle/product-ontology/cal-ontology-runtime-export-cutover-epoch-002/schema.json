{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cal.d65-epoch-002-product-capability-prototype/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "prototype_id", "construction_id", "stage_id", "status", "authority_effect", "capability_id", "product_ref", "predecessor", "definition_predecessor", "stable_outcome", "epoch_contribution", "preserved_scope", "selected_evidence", "work_plan", "next_product_frontier", "product_approval", "challenge_route", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "cal.d65-epoch-002-product-capability-prototype/v1"},
    "prototype_id": {"const": "CAL-D65-EPOCH-002-PRODUCT-CAPABILITY-PROTOTYPE-001"},
    "construction_id": {"const": "CA2-CONSTRUCTION-CYBERALCHEMY-LAB-ONTOLOGY-RUNTIME-EXPORT-CUTOVER-EPOCH-002"},
    "stage_id": {"const": "D65-S2"},
    "status": {"const": "prototype"},
    "authority_effect": {"const": "none"},
    "capability_id": {"const": "CA2-CAP-CONSUME-GOVERNED-EVENT-CALCULATED-ONTOLOGY-PROJECTIONS"},
    "product_ref": {"const": "CA2-PRODUCT-CYBERALCHEMY"},
    "predecessor": {"type": "object", "required": ["path", "sha256", "admission_decision_path", "admission_decision_sha256"]},
    "definition_predecessor": {"type": "object", "required": ["path", "sha256", "validation_path", "validation_sha256"]},
    "stable_outcome": {"type": "string", "minLength": 1},
    "epoch_contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contribution_id", "objective", "consumer_refs", "input_contracts", "output_contracts", "promised_behaviors", "product_test_obligations"],
      "properties": {
        "contribution_id": {"const": "CAL-CAP-CONTRIBUTION-PUBLIC-V2-CONTEXT-ADAPTERS-001"},
        "objective": {"type": "string", "minLength": 1},
        "consumer_refs": {"type": "array", "minItems": 1, "uniqueItems": true},
        "input_contracts": {"type": "array", "minItems": 4, "uniqueItems": true},
        "output_contracts": {"type": "array", "minItems": 4, "uniqueItems": true},
        "promised_behaviors": {"type": "array", "minItems": 6, "uniqueItems": true},
        "product_test_obligations": {"type": "array", "minItems": 6, "uniqueItems": true}
      }
    },
    "preserved_scope": {"type": "object", "required": ["participants", "exclusions"]},
    "selected_evidence": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["path", "sha256"]}},
    "work_plan": {"type": "object", "required": ["lane", "current_frontier", "operational_tasks", "continuation_status"]},
    "next_product_frontier": {"const": "D65-S3"},
    "product_approval": {"const": "not-requested"},
    "challenge_route": {"type": "string", "minLength": 1},
    "claim_ceiling": {"type": "string", "minLength": 1}
  }
}
