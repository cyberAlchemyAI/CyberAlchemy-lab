{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cal.schema.ontology-runtime-integration-definition-pack/v1",
  "title": "CyberAlchemy ontology runtime integration Definition Pack",
  "type": "object",
  "required": [
    "schema_version",
    "pack_id",
    "status",
    "goal_ref",
    "intent",
    "context",
    "consumer",
    "source_refs",
    "required_concept_ids",
    "concepts",
    "relationships",
    "context_sufficiency",
    "owner_decision",
    "residue",
    "allowed_uses",
    "blocked_actions",
    "challenge_or_refresh_route",
    "claim_ceiling",
    "authority_effect"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "cal.ontology-runtime-integration-definition-pack/v1"},
    "pack_id": {"const": "CAL-DEFINE-PACK-ONTOLOGY-RUNTIME-INTEGRATION-001"},
    "status": {"const": "validated-candidate-awaiting-owner-selection"},
    "goal_ref": {"const": "CA2-GOAL-CYBERALCHEMY-LAB-ONTOLOGY-RUNTIME-INTEGRATION"},
    "intent": {"type": "string", "minLength": 1},
    "context": {"type": "object"},
    "consumer": {"type": "object"},
    "source_refs": {"type": "array", "minItems": 2},
    "required_concept_ids": {"type": "array", "minItems": 1, "uniqueItems": true},
    "concepts": {"type": "array", "minItems": 1},
    "relationships": {"type": "array", "minItems": 1},
    "context_sufficiency": {"type": "object"},
    "owner_decision": {"type": "object"},
    "residue": {"type": "array", "minItems": 1},
    "allowed_uses": {"type": "array", "minItems": 1},
    "blocked_actions": {"type": "array", "minItems": 1},
    "challenge_or_refresh_route": {"type": "string", "minLength": 1},
    "claim_ceiling": {"type": "string", "minLength": 1},
    "authority_effect": {"const": "none"}
  }
}
