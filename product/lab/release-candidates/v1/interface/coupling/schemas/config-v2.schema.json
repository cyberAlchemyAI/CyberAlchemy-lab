{
  "additionalProperties": false,
  "properties": {
    "allowed_categories": {
      "items": {
        "enum": [
          "artifact-instance",
          "typed-relation",
          "definition",
          "artifact-type",
          "relation-kind"
        ]
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "allowed_effects": {
      "items": {
        "enum": [
          "admit",
          "revise",
          "withdraw"
        ]
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "authority_boundary": {
      "const": "operator-provisioned-local-store"
    },
    "challenge_route": {
      "minLength": 1,
      "type": "string"
    },
    "endpoint_engine_id": {
      "const": "lab-operator-signed-coupling/v1-candidate"
    },
    "endpoint_mapping_authority": {
      "const": "isolated-candidate-local-interpretation"
    },
    "endpoint_mapping_binding": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "policy_ref": {
      "minLength": 1,
      "type": "string"
    },
    "public_key": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "repository_admission_effect": {
      "const": "none"
    },
    "schema_version": {
      "const": "lab-runtime-store-config/v2-candidate"
    },
    "scope_ref": {
      "minLength": 1,
      "type": "string"
    },
    "source_snapshot_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "store_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "store_id",
    "owner_ref",
    "scope_ref",
    "policy_ref",
    "challenge_route",
    "source_snapshot_digest",
    "public_key",
    "allowed_categories",
    "allowed_effects",
    "authority_boundary",
    "repository_admission_effect",
    "endpoint_engine_id",
    "endpoint_mapping_binding",
    "endpoint_mapping_authority"
  ],
  "type": "object"
}
