{
  "$id": "urn:cyberalchemy-lab:internal:lesson-host-plan:v1-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actual_owner_outcome": {
      "type": "null"
    },
    "assignment": {
      "allOf": [
        {
          "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"
        },
        {
          "properties": {
            "carrier_ref": {
              "const": "cal.artifact-type.agent-assignment/v1"
            }
          }
        }
      ]
    },
    "authority_effect": {
      "const": "none"
    },
    "coordination_context": {
      "allOf": [
        {
          "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"
        },
        {
          "properties": {
            "carrier_ref": {
              "const": "cal.artifact-type.coordination-context/v2"
            }
          }
        }
      ]
    },
    "domain_profile": {
      "additionalProperties": false,
      "properties": {
        "reviewed_use_postures": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "disposition": {
                "minLength": 1,
                "type": "string"
              },
              "effective_state": {
                "enum": [
                  "local-admitted-current",
                  "admitted-current"
                ]
              },
              "fixture_only": {
                "type": "boolean"
              }
            },
            "required": [
              "disposition",
              "effective_state",
              "fixture_only"
            ],
            "type": "object"
          },
          "maxItems": 1000,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "supported_lesson_statuses": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 1000,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "supported_retention_policy_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 1000,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "supported_lesson_statuses",
        "supported_retention_policy_refs",
        "reviewed_use_postures"
      ],
      "type": "object"
    },
    "family": {
      "minLength": 1,
      "type": "string"
    },
    "instruction_policy_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "lessons": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "applicability_rule_binding": {
            "oneOf": [
              {
                "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
              },
              {
                "type": "null"
              }
            ]
          },
          "exclusions": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "assessment_binding": {
                  "oneOf": [
                    {
                      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "excluded": {
                  "oneOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "text": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "text",
                "excluded",
                "assessment_binding"
              ],
              "type": "object"
            },
            "maxItems": 1000,
            "type": "array"
          },
          "fixture_only": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "lesson": {
            "allOf": [
              {
                "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"
              },
              {
                "properties": {
                  "carrier_ref": {
                    "const": "cal.artifact-type.operational-lesson/v1"
                  }
                }
              }
            ]
          },
          "retention_binding": {
            "oneOf": [
              {
                "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
              },
              {
                "type": "null"
              }
            ]
          },
          "review_binding": {
            "oneOf": [
              {
                "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
              },
              {
                "type": "null"
              }
            ]
          },
          "review_disposition": {
            "oneOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "lesson",
          "review_binding",
          "review_disposition",
          "fixture_only",
          "applicability_rule_binding",
          "retention_binding",
          "exclusions"
        ],
        "type": "object"
      },
      "maxItems": 1000,
      "type": "array"
    },
    "profile": {
      "allOf": [
        {
          "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"
        },
        {
          "properties": {
            "carrier_ref": {
              "const": "cal.artifact-type.agent-profile/v1"
            }
          }
        }
      ]
    },
    "project_ref": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "lab-lesson-host-plan/v1-candidate"
    },
    "source_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "source_cut": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/source_cut"
    },
    "work": {
      "allOf": [
        {
          "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"
        },
        {
          "properties": {
            "carrier_ref": {
              "const": "cal.artifact-type.work/v1"
            }
          }
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "source_cut",
    "assignment",
    "work",
    "coordination_context",
    "profile",
    "project_ref",
    "family",
    "source_binding",
    "instruction_policy_binding",
    "domain_profile",
    "lessons",
    "authority_effect",
    "actual_owner_outcome"
  ],
  "type": "object"
}
