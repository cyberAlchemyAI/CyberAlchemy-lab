{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cyberalchemy-lab:internal:lesson-selection-domain:v1-candidate",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "scope_ref", "source_cut", "context_basis_binding", "selection_method_binding", "supported_lesson_statuses", "supported_retention_policy_refs", "reviewed_use_postures", "authority_effect", "actual_owner_outcome"],
  "properties": {
    "schema_version": {"const": "lab-lesson-selection-domain/v1-candidate"},
    "scope_ref": {"type": "string", "minLength": 1},
    "source_cut": {"$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/source_cut"},
    "context_basis_binding": {"$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"},
    "selection_method_binding": {"$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"},
    "supported_lesson_statuses": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "supported_retention_policy_refs": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "reviewed_use_postures": {
      "type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["disposition", "effective_state", "fixture_only"],
        "properties": {
          "disposition": {"type": "string", "minLength": 1},
          "effective_state": {"enum": ["local-admitted-current", "admitted-current"]},
          "fixture_only": {"type": "boolean"}
        }
      }
    },
    "authority_effect": {"const": "none"},
    "actual_owner_outcome": {"type": "null"}
  }
}
