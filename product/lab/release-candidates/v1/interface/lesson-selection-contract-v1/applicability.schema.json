{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cyberalchemy-lab:internal:lesson-applicability:v1-candidate",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "lesson", "source_cut", "project_ref", "family", "source_binding", "required_instruction_refs", "excluded_tags", "influence_ref", "counterevidence", "authority_effect"],
  "properties": {
    "schema_version": {"const": "lab-lesson-applicability/v1-candidate"},
    "lesson": {"allOf": [{"$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"}, {"properties": {"carrier_ref": {"const": "cal.artifact-type.operational-lesson/v1"}}}]},
    "source_cut": {"$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/source_cut"},
    "project_ref": {"type": "string", "minLength": 1},
    "family": {"type": "string", "minLength": 1},
    "source_binding": {"$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"},
    "required_instruction_refs": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "excluded_tags": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "influence_ref": {"type": "string", "minLength": 1},
    "counterevidence": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["binding", "posture", "assessment_binding"],
        "properties": {
          "binding": {"$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"},
          "posture": {"enum": ["limits-claim", "contradicts-use", "unresolved"]},
          "assessment_binding": {"$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"}
        }
      }
    },
    "authority_effect": {"const": "none"}
  }
}
