{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cyberalchemy-lab:internal:lesson-selection-routing:v1-candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_cut", "assignment", "session_binding", "instruction_precedence_binding", "inventory_binding", "domain_profile_binding", "lessons", "authority_effect", "actual_owner_outcome"],
  "properties": {
    "schema_version": {"const": "lab-lesson-selection-routing/v1-candidate"},
    "source_cut": {"$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/source_cut"},
    "assignment": {"allOf": [{"$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"}, {"properties": {"carrier_ref": {"const": "cal.artifact-type.agent-assignment/v1"}}}]},
    "session_binding": {"$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"},
    "instruction_precedence_binding": {"$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"},
    "inventory_binding": {"$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"},
    "domain_profile_binding": {"$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"},
    "lessons": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["lesson", "review_binding", "applicability_rule_binding"],
        "properties": {
          "lesson": {"allOf": [{"$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"}, {"properties": {"carrier_ref": {"const": "cal.artifact-type.operational-lesson/v1"}}}]},
          "review_binding": {"oneOf": [{"$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"}, {"type": "null"}]},
          "applicability_rule_binding": {"oneOf": [{"$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"}, {"type": "null"}]}
        }
      }
    },
    "authority_effect": {"const": "none"},
    "actual_owner_outcome": {"type": "null"}
  }
}
