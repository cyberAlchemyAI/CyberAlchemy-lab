{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "authority_scope_ref": {
      "minLength": 1,
      "type": "string"
    },
    "container_scope_ref": {
      "minLength": 1,
      "type": "string"
    },
    "permitted_body_scope_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "principal_ref": {
      "minLength": 1,
      "type": "string"
    },
    "producer_binding": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "^/(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^\\u0000]+$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "producer_entrypoint": {
      "const": "NativeMixedPublisher.capture_selected"
    },
    "review_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "lab-private-native-workflow-scope/v1-candidate"
    },
    "source_binding": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "sha256"
      ],
      "type": "object"
    },
    "source_cut": {
      "additionalProperties": false,
      "properties": {
        "branch_ref": {
          "minLength": 1,
          "type": "string"
        },
        "commit_sequence": {
          "minimum": 0,
          "type": "integer"
        },
        "commit_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "source_profile_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "store_ref": {
          "minLength": 1,
          "type": "string"
        },
        "streams": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "cursor": {
                "minimum": 0,
                "type": "integer"
              },
              "head_sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "stream_ref": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "stream_ref",
              "cursor",
              "head_sha256"
            ],
            "type": "object"
          },
          "minItems": 0,
          "type": "array"
        }
      },
      "required": [
        "store_ref",
        "branch_ref",
        "commit_sequence",
        "commit_sha256",
        "source_profile_sha256",
        "streams"
      ],
      "type": "object"
    },
    "work_ref": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "producer_binding",
    "producer_entrypoint",
    "review_sha256",
    "source_binding",
    "source_cut",
    "principal_ref",
    "work_ref",
    "container_scope_ref",
    "authority_scope_ref",
    "permitted_body_scope_refs",
    "authority_effect"
  ],
  "type": "object"
}
