{
  "$id": "urn:cyberalchemy-lab:internal:package-export-contract:v1-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actual_owner_outcome": {
      "type": "null"
    },
    "artifact_refs": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"
      },
      "maxItems": 1000,
      "minItems": 1,
      "type": "array"
    },
    "authority_effect": {
      "const": "none"
    },
    "dependency_bindings": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
      },
      "maxItems": 1000,
      "minItems": 0,
      "type": "array"
    },
    "maximum_package_bytes": {
      "maximum": 1048576,
      "minimum": 1,
      "type": "integer"
    },
    "schema_version": {
      "const": "lab-package-export-contract/v1-candidate"
    },
    "source_admission_basis": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
      },
      "maxItems": 1000,
      "minItems": 0,
      "type": "array"
    },
    "source_cut": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/source_cut"
    },
    "source_posture": {
      "enum": [
        "controlled-candidate",
        "admitted-source"
      ]
    }
  },
  "required": [
    "schema_version",
    "source_cut",
    "artifact_refs",
    "dependency_bindings",
    "source_admission_basis",
    "source_posture",
    "maximum_package_bytes",
    "authority_effect",
    "actual_owner_outcome"
  ],
  "type": "object"
}
