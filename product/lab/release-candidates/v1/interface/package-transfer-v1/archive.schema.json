{
  "$id": "urn:cyberalchemy-lab:internal:package-archive:v1-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_refs": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"
      },
      "maxItems": 1000,
      "minItems": 1,
      "type": "array"
    },
    "authority_effect": {
      "const": "none"
    },
    "contains_private_credentials": {
      "const": false
    },
    "contains_session_memory": {
      "const": false
    },
    "export_contract_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "export_contract_bytes_b64": {
      "maxLength": 1400000,
      "type": "string"
    },
    "materials": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "artifact": {
            "anyOf": [
              {
                "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"
              },
              {
                "type": "null"
              }
            ]
          },
          "binding": {
            "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
          },
          "dependencies": {
            "items": {
              "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
            },
            "maxItems": 1000,
            "minItems": 0,
            "type": "array"
          },
          "original_bytes_b64": {
            "maxLength": 1400000,
            "type": "string"
          }
        },
        "required": [
          "binding",
          "artifact",
          "dependencies",
          "original_bytes_b64"
        ],
        "type": "object"
      },
      "maxItems": 1000,
      "minItems": 1,
      "type": "array"
    },
    "privacy_review_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "privacy_review_bytes_b64": {
      "maxLength": 1400000,
      "type": "string"
    },
    "schema_version": {
      "const": "lab-source-package/v1-candidate"
    },
    "source_admission_basis": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
      },
      "maxItems": 1000,
      "minItems": 0,
      "type": "array"
    },
    "source_admission_verified_by_this_calculation": {
      "const": false
    },
    "source_cut": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/source_cut"
    },
    "source_posture": {
      "enum": [
        "controlled-candidate",
        "admitted-source"
      ]
    },
    "target_admission_granted": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "source_cut",
    "artifact_refs",
    "source_admission_basis",
    "source_posture",
    "materials",
    "export_contract_binding",
    "privacy_review_binding",
    "export_contract_bytes_b64",
    "privacy_review_bytes_b64",
    "authority_effect",
    "target_admission_granted",
    "contains_session_memory",
    "contains_private_credentials",
    "source_admission_verified_by_this_calculation"
  ],
  "type": "object"
}
