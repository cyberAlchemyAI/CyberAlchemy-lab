  "required": [
    "schema_version",
    "principal_ref",
    "scope_ref",
    "authorization_basis_binding",
    "base_cut_binding",
    "not_before",
    "expires_at",
    "revoked",
    "proposal_ref",
    "idempotency_key",
    "members",
