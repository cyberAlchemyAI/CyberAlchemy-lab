{
  "$id": "urn:cyberalchemy-lab:source8-protocol:private-workflow-composition:v1-candidate:revision-1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actual_owner_outcome": {
      "type": "null"
    },
    "authority_effect": {
      "const": "none"
