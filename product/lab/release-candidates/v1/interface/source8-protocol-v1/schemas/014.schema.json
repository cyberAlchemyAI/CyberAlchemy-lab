      "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-1#/$defs/binding"
    },
    "base_cut_binding": {
      "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-1#/$defs/binding"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "idempotency_key": {
      "minLength": 1,
      "type": "string"
    },
    "members": {
      "items": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "byte_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "core_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "idempotency_key": {
                "minLength": 1,
                "type": "string"
              },
              "operation": {
                "const": "challenge.submit"
              },
              "source": {
                "const": "completed-producer"
              },
              "target_version_ref": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "source",
              "operation",
              "idempotency_key",
              "target_version_ref",
              "byte_sha256",
              "core_sha256"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "source": {
                "const": "provisioned-input"
              },
              "target_binding": {
                "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-1#/$defs/binding"
              }
            },
            "required": [
              "source",
              "target_binding"
            ],
            "type": "object"
          }
        ]
      },
      "maxItems": 64,
      "minItems": 1,
      "type": "array"
    },
    "not_before": {
      "format": "date-time",
      "type": "string"
    },
    "principal_ref": {
      "minLength": 1,
      "type": "string"
