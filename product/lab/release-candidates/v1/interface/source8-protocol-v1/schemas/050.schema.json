          }
        }
      ]
    },
    "authority_effect": {
      "const": "none"
    },
    "budget": {
      "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-1#/$defs/budget"
    },
    "coordination_context": {
      "allOf": [
        {
          "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-1#/$defs/artifact_ref"
        },
        {
          "properties": {
            "carrier_ref": {
              "const": "cal.artifact-type.coordination-context/v2"
            }
          }
        }
      ]
    },
    "exclusions": {
      "items": {
        "minLength": 1,
        "type": "string"
