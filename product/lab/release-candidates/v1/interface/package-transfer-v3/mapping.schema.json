{
  "$id": "urn:cyberalchemy-lab:internal:package-mapping:v1-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actual_owner_outcome": {
      "type": "null"
    },
    "authority_effect": {
      "const": "none"
    },
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "source": {
            "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"
          },
          "target": {
            "anyOf": [
              {
                "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/candidate_artifact_ref"
              },
              {
                "type": "null"
              }
            ]
          },
          "target_bytes_b64": {
            "anyOf": [
              {
                "maxLength": 1400000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "source",
          "target",
          "target_bytes_b64"
        ],
        "type": "object"
      },
      "maxItems": 1000,
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "lab-package-import-mapping/v1-candidate"
    },
    "source_package_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "target_base_cut": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/source_cut"
    }
  },
  "required": [
    "schema_version",
    "source_package_binding",
    "target_base_cut",
    "items",
    "authority_effect",
    "actual_owner_outcome"
  ],
  "type": "object"
}
