                "type": "null"
              }
            ]
          },
          "binding": {
            "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/binding"
          },
          "kind": {
            "enum": [
              "source",
              "evidence-set",
              "decision",
              "validation-receipt"
            ]
          },
          "original_binding": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "sha256": {
                    "pattern": "^[a-f0-9]{64}$",
                    "type": "string"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "receipt_binding": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "sha256": {
                    "pattern": "^[a-f0-9]{64}$",
                    "type": "string"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_posture": {
            "enum": [
              "signed-source",
              "candidate-original",
              "bound-original",
              "completed-validation"
            ]
          }
        },
        "required": [
          "kind",
          "binding",
          "artifact",
          "receipt_binding",
          "source_posture",
          "original_binding"
        ],
        "type": "object"
      },
      "maxItems": 128,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "actual_owner_outcome": {
      "type": "null"
    },
    "authority_effect": {
      "const": "none"
    },
    "candidate_scope_ref": {
      "minLength": 1,
      "type": "string"
    },
    "challenge_contract": {
