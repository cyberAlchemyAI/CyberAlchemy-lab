{
  "$id": "urn:cyberalchemy-lab:source8-protocol:independent-challenge-submit-routing:v1-candidate:revision-2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accepted_evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "artifact": {
            "anyOf": [
              {
                "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/artifact_ref"
