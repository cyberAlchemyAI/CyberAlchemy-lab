  "required": [
    "schema_version",
    "principal_ref",
    "storage_scope_ref",
    "candidate_scope_ref",
    "challenge_contract",
    "challenger",
    "source_cut",
    "subjects",
    "grounds",
    "accepted_evidence",
    "policy_ref",
    "owner_route",
    "resolution_gate_ref",
    "residue_route_ref",
    "response_mode",
    "not_before",
    "expires_at",
    "revoked",
    "development_authorization_binding",
    "actual_owner_outcome",
