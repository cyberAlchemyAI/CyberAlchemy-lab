      "type": "string"
    },
    "grounds": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "not_before": {
      "format": "date-time",
      "type": "string"
    },
    "owner_route": {
      "minLength": 1,
      "type": "string"
    },
    "policy_ref": {
      "minLength": 1,
      "type": "string"
    },
    "principal_ref": {
      "minLength": 1,
      "type": "string"
    },
    "residue_route_ref": {
      "minLength": 1,
      "type": "string"
    },
    "resolution_gate_ref": {
      "minLength": 1,
      "type": "string"
    },
    "response_mode": {
      "minLength": 1,
      "type": "string"
    },
    "revoked": {
      "const": false
    },
    "schema_version": {
      "const": "lab-independent-challenge-submit-routing/v1-candidate"
    },
    "source_cut": {
      "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/source_cut"
    },
    "storage_scope_ref": {
      "minLength": 1,
      "type": "string"
    },
    "subjects": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/artifact_ref"
