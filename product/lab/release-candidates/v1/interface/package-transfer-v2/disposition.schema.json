{
  "$id": "urn:cyberalchemy-lab:internal:package-disposition:v1-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actual_owner_outcome": {
      "type": "null"
    },
    "authority_effect": {
      "const": "none"
    },
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "disposition": {
            "enum": [
              "import-exact",
              "adapt",
              "retain-source",
              "exclude"
            ]
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          },
          "source": {
            "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"
          }
        },
        "required": [
          "source",
          "disposition",
          "reason"
        ],
        "type": "object"
      },
      "maxItems": 1000,
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "lab-package-import-disposition/v1-candidate"
    },
    "source_package_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "target_base_cut": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/source_cut"
    }
  },
  "required": [
    "schema_version",
    "source_package_binding",
    "target_base_cut",
    "items",
    "authority_effect",
    "actual_owner_outcome"
  ],
  "type": "object"
}
