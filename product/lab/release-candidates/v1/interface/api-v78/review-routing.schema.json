{
  "$id": "urn:cyberalchemy-lab:private-candidate-review-routing:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accountable_owner": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"
    },
    "actual_owner_outcome": {
      "type": "null"
    },
    "allowed_operation": {
      "const": "proposal.review"
    },
    "authority_effect": {
      "const": "none"
    },
    "authorization_basis_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "base_cut_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "current_owner_authority_verified": {
      "const": false
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "members": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "core_binding": {
            "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
          },
          "decision_ref": {
            "minLength": 1,
            "type": "string"
          },
          "required_owner_voices": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "principal": {
                  "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"
                },
                "role_declaration": {
                  "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"
                },
                "role_ref": {
                  "pattern": "^role:[A-Za-z0-9:._/-]+$",
                  "type": "string"
                }
              },
              "required": [
                "role_ref",
                "principal",
                "role_declaration"
              ],
              "type": "object"
            },
            "maxItems": 8,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "decision_ref",
          "core_binding",
          "required_owner_voices"
        ],
        "type": "object"
      },
      "maxItems": 64,
      "minItems": 1,
      "type": "array"
    },
    "not_before": {
      "format": "date-time",
      "type": "string"
    },
    "preference_basis": {
      "enum": [
        "current-source",
        "proposed-target"
      ]
    },
    "principal_ref": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "lab-independent-candidate-review-routing/v1-candidate"
    },
    "scope_posture": {
      "const": "isolated-candidate-review-preparation"
    },
    "scope_ref": {
      "minLength": 1,
      "type": "string"
    },
    "user_decision_preference": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"
    },
    "workflow_decision_profile": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"
    },
    "workflow_protocol": {
      "additionalProperties": false,
      "properties": {
        "authority_effect": {
          "const": "none"
        },
        "reference": {
          "pattern": "^protocol:R03-review-workflow:[a-zA-Z0-9:._/-]+$",
          "type": "string"
        },
        "reference_class": {
          "const": "protocol-review-workflow"
        }
      },
      "required": [
        "reference",
        "reference_class",
        "authority_effect"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "principal_ref",
    "scope_ref",
    "not_before",
    "expires_at",
    "authorization_basis_binding",
    "base_cut_binding",
    "workflow_decision_profile",
    "user_decision_preference",
    "preference_basis",
    "accountable_owner",
    "workflow_protocol",
    "members",
    "allowed_operation",
    "scope_posture",
    "current_owner_authority_verified",
    "actual_owner_outcome",
    "authority_effect"
  ],
  "type": "object"
}
