{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_file_id",
    "catalog_file_id",
    "kernel_identity_file_id",
    "kernel_operations_file_id",
    "schemas",
    "profiles",
    "declarations",
    "nodes",
    "eligibility_file_id",
    "proof_references",
    "context_references",
    "relation_contracts",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {
      "const": "lab-schema-declared-semantic-graph/v2-candidate"
    },
    "registry_file_id": {
      "type": "string",
      "minLength": 1
    },
    "catalog_file_id": {
      "type": "string",
      "minLength": 1
    },
    "kernel_identity_file_id": {
      "type": "string",
      "minLength": 1
    },
    "kernel_operations_file_id": {
      "type": "string",
      "minLength": 1
    },
    "schemas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "file_id"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "file_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile_id",
          "carrier_ref",
          "instance_schema_selector",
          "registry_pointer",
          "descriptor_file_id",
          "descriptor_pointer",
          "fields"
        ],
        "properties": {
          "profile_id": {
            "type": "string",
            "minLength": 1
          },
          "carrier_ref": {
            "type": "string",
            "minLength": 1
          },
          "instance_schema_selector": {
            "type": [
              "string",
              "null"
            ]
          },
          "registry_pointer": {
            "type": "string"
          },
          "descriptor_file_id": {
            "type": "string",
            "minLength": 1
          },
          "descriptor_pointer": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "instance_pointer",
                "schema_locations",
                "disposition"
              ],
              "properties": {
                "instance_pointer": {
                  "type": "string"
                },
                "schema_locations": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "disposition": {
                  "enum": [
                    "semantic-node",
                    "verified-proof",
                    "current-context",
                    "self-identity"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "declarations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file_id",
          "pointer",
          "schema_path",
          "schema_selector"
        ],
        "properties": {
          "file_id": {
            "type": "string",
            "minLength": 1
          },
          "pointer": {
            "type": "string"
          },
          "schema_path": {
            "type": "string",
            "minLength": 1
          },
          "schema_selector": {
            "type": "string"
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file_id",
          "profile_id",
          "version_ref",
          "category"
        ],
        "properties": {
          "file_id": {
            "type": "string",
            "minLength": 1
          },
          "profile_id": {
            "type": "string",
            "minLength": 1
          },
          "version_ref": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "artifact-instance",
              "definition",
              "relation-kind",
              "typed-relation",
              "artifact-type"
            ]
          }
        }
      }
    },
    "eligibility_file_id": {
      "type": "string",
      "minLength": 1
    },
    "proof_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference",
          "file_id"
        ],
        "properties": {
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "file_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "context_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "relation_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file_id",
          "registry_file_id",
          "registry_pointer",
          "qualifier_fields"
        ],
        "properties": {
          "file_id": {
            "type": "string",
            "minLength": 1
          },
          "registry_file_id": {
            "type": "string",
            "minLength": 1
          },
          "registry_pointer": {
            "type": "string"
          },
          "qualifier_fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "instance_pointer",
                "schema_locations",
                "disposition"
              ],
              "properties": {
                "instance_pointer": {
                  "type": "string"
                },
                "schema_locations": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "disposition": {
                  "enum": [
                    "semantic-node",
                    "verified-proof",
                    "current-context",
                    "self-identity"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "authority_effect": {
      "const": "none"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lab.invalid/completion/semantic-policy-v2",
  "title": "Closed independently selected semantic policy; no admission authority"
}
