{
  "$defs": {
    "binding": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "sha256"
      ],
      "type": "object"
    }
  },
  "$id": "urn:cyberalchemy-lab:typed-preparation-routing:v2-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actual_owner_outcome": {
      "type": "null"
    },
    "authority_effect": {
      "const": "none"
    },
    "canonical_writable_authority_ref": {
      "minLength": 1,
      "type": "string"
    },
    "catalog_profile_binding": {
      "$ref": "#/$defs/binding"
    },
    "catalog_review_binding": {
      "$ref": "#/$defs/binding"
    },
    "catalog_snapshot_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "helper_proof_binding": {
      "$ref": "#/$defs/binding"
    },
    "helper_source_binding": {
      "$ref": "#/$defs/binding"
    },
    "inspection_binding": {
      "$ref": "#/$defs/binding"
    },
    "proposal_binding": {
      "$ref": "#/$defs/binding"
    },
    "record_basis": {
      "const": "complete-current-and-exact-prospective-postimage"
    },
    "representation_profile_binding": {
      "$ref": "#/$defs/binding"
    },
    "schema_destinations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "runtime_schema_path": {
            "pattern": "^runtime/schemas/[A-Za-z0-9._/-]+\\.json$",
            "type": "string"
          },
          "schema_binding": {
            "$ref": "#/$defs/binding"
          }
        },
        "required": [
          "schema_binding",
          "runtime_schema_path"
        ],
        "type": "object"
      },
      "maxItems": 1000,
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": "lab-typed-preparation-routing/v2-candidate"
    },
    "scope_preparation_profile_binding": {
      "anyOf": [
        {
          "$ref": "#/$defs/binding"
        },
        {
          "type": "null"
        }
      ]
    },
    "scope_ref": {
      "minLength": 1,
      "type": "string"
    },
    "source_cut": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/source_cut"
    }
  },
  "required": [
    "schema_version",
    "scope_ref",
    "source_cut",
    "proposal_binding",
    "inspection_binding",
    "helper_source_binding",
    "helper_proof_binding",
    "catalog_profile_binding",
    "catalog_review_binding",
    "catalog_snapshot_digest",
    "representation_profile_binding",
    "canonical_writable_authority_ref",
    "schema_destinations",
    "scope_preparation_profile_binding",
    "record_basis",
    "actual_owner_outcome",
    "authority_effect"
  ],
  "title": "Exact independently selected typed preparation routing",
  "type": "object"
}
