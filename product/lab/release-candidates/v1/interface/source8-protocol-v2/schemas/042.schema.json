{
  "$id": "urn:cyberalchemy-lab:source8-protocol:protocol:checkpoint-resolution:v1-candidate:revision-2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "all_required_members_authorized": {
            "const": true
          }
        },
        "required": [
          "all_required_members_authorized"
        ]
      },
      "then": {
        "properties": {
          "ordered_outcomes": {
            "items": {
              "allOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "authorization_evidence_binding": {
                      "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/binding"
                    },
                    "core_binding": {
                      "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/binding"
                    },
                    "owner_principal_ref": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "owner_role_ref": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "selected_outcome": {
                      "enum": [
                        "approve-exact-effect",
                        "reject",
                        "defer"
                      ]
                    }
                  },
                  "required": [
                    "core_binding",
                    "owner_principal_ref",
                    "owner_role_ref",
                    "selected_outcome",
                    "authorization_evidence_binding"
                  ],
                  "type": "object"
                },
                {
                  "properties": {
                    "selected_outcome": {
                      "const": "approve-exact-effect"
                    }
                  }
                }
              ]
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "ordered_outcomes"
        ]
      }
    }
  ],
  "properties": {
    "all_required_members_authorized": {
      "type": "boolean"
    },
    "authority_effect": {
      "const": "none"
    },
    "authorization_channel": {
      "enum": [
        "owner-conversation",
        "operator-signature",
        "existing-exact-authority"
      ]
    },
    "channel_verification_binding": {
      "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/binding"
    },
    "checkpoint_binding": {
      "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/binding"
    },
    "ordered_outcomes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "authorization_evidence_binding": {
            "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/binding"
          },
          "core_binding": {
            "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/binding"
          },
          "owner_principal_ref": {
            "minLength": 1,
            "type": "string"
          },
          "owner_role_ref": {
            "minLength": 1,
            "type": "string"
          },
          "selected_outcome": {
            "enum": [
              "approve-exact-effect",
              "reject",
              "defer"
            ]
          }
        },
        "required": [
          "core_binding",
          "owner_principal_ref",
          "owner_role_ref",
          "selected_outcome",
          "authorization_evidence_binding"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "resolved_at": {
      "format": "date-time",
      "type": "string"
    },
    "review_package_binding": {
      "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/binding"
    },
    "schema_version": {
      "const": "lab-checkpoint-resolution/v1-candidate"
    }
  },
  "required": [
    "schema_version",
    "review_package_binding",
    "checkpoint_binding",
    "resolved_at",
    "ordered_outcomes",
    "authorization_channel",
    "channel_verification_binding",
    "all_required_members_authorized",
    "authority_effect"
  ],
  "title": "Candidate Lab checkpoint-resolution",
  "type": "object"
}
