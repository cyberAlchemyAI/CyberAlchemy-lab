{
  "$id": "urn:cyberalchemy-lab:source8-protocol:protocol:decision-core:v1-candidate:revision-2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accountable_principal_ref": {
      "minLength": 1,
      "type": "string"
    },
    "authority_boundary": {
      "allOf": [
        {
          "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/artifact_ref"
        },
        {
          "properties": {
            "carrier_ref": {
              "const": "cal.artifact-type.authority-boundary/v1"
            }
          }
        }
      ]
    },
    "authority_effect": {
      "const": "none"
    },
    "decision_ref": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_bindings": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/binding"
      },
      "minItems": 1,
      "type": "array"
    },
    "generated_output_digests_in_core": {
      "const": false
    },
    "invalidation_conditions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "owner_role_ref": {
      "minLength": 1,
      "type": "string"
    },
    "requested_effect": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "lab-decision-core/v1-candidate"
    },
    "scope": {
      "allOf": [
        {
          "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/artifact_ref"
        },
        {
          "properties": {
            "carrier_ref": {
              "const": "cal.artifact-type.decision-scope/v2"
            }
          }
        }
      ]
    },
    "target_content_bindings": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/content_binding"
      },
      "minItems": 1,
      "type": "array"
    },
    "targets": {
      "items": {
        "oneOf": [
          {
            "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/artifact_ref"
          },
          {
            "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/candidate_artifact_ref"
          }
        ]
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "decision_ref",
    "owner_role_ref",
    "accountable_principal_ref",
    "authority_boundary",
    "scope",
    "targets",
    "target_content_bindings",
    "requested_effect",
    "evidence_bindings",
    "invalidation_conditions",
    "generated_output_digests_in_core",
    "authority_effect"
  ],
  "title": "Candidate Lab decision-core",
  "type": "object"
}
