{
  "$id": "urn:cyberalchemy-lab:source8-protocol:protocol:lesson-selection:v1-candidate:revision-2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assignment": {
      "allOf": [
        {
          "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/artifact_ref"
        },
        {
          "properties": {
            "carrier_ref": {
              "const": "cal.artifact-type.agent-assignment/v1"
            }
          }
        }
      ]
    },
    "authority_effect": {
      "const": "none"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "instruction_precedence_binding": {
      "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/binding"
    },
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "applicability_check_binding": {
            "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/binding"
          },
          "conflict_refs": {
            "items": {
              "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/artifact_ref"
            },
            "minItems": 0,
            "type": "array"
          },
          "expired": {
            "type": "boolean"
          },
          "lesson": {
            "allOf": [
              {
                "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/artifact_ref"
              },
              {
                "properties": {
                  "carrier_ref": {
                    "const": "cal.artifact-type.operational-lesson/v1"
                  }
                }
              }
            ]
          },
          "posture": {
            "enum": [
              "selected",
              "omitted",
              "blocked"
            ]
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "lesson",
          "applicability_check_binding",
          "posture",
          "reason",
          "conflict_refs",
          "expired"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array"
    },
    "schema_version": {
      "const": "lab-lesson-selection/v1-candidate"
    },
    "selection_ref": {
      "minLength": 1,
      "type": "string"
    },
    "session_ref": {
      "minLength": 1,
      "type": "string"
    },
    "source_cut": {
      "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/source_cut"
    }
  },
  "required": [
    "schema_version",
    "selection_ref",
    "session_ref",
    "assignment",
    "source_cut",
    "items",
    "instruction_precedence_binding",
    "claim_ceiling",
    "authority_effect"
  ],
  "title": "Candidate Lab lesson-selection",
  "type": "object"
}
