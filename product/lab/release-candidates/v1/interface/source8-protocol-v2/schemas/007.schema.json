{
  "$id": "urn:cyberalchemy-lab:source8-protocol:api:trusted-call-context:v1-candidate:revision-2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accept_client_supplied_authority_context": {
      "const": false
    },
    "agent_instance_ref": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "assignment_ref": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "authentication_evidence_binding": {
      "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/binding"
    },
    "authority_scope": {
      "enum": [
        "repository",
        "operator-local",
        "delegated-action"
      ]
    },
    "connection_ref": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$",
      "type": "string"
    },
    "context_ref": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "host_instance_ref": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$",
      "type": "string"
    },
    "limits": {
      "additionalProperties": false,
      "properties": {
        "deadline": {
          "format": "date-time",
          "type": "string"
        },
        "max_actions": {
          "minimum": 0,
          "type": "integer"
        },
        "max_request_bytes": {
          "minimum": 4096,
          "type": "integer"
        },
        "max_response_bytes": {
          "minimum": 4096,
          "type": "integer"
        }
      },
      "required": [
        "max_request_bytes",
        "max_response_bytes",
        "max_actions",
        "deadline"
      ],
      "type": "object"
    },
    "origin": {
      "const": "verified-local-adapter"
    },
    "policy_bindings": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/binding"
      },
      "minItems": 1,
      "type": "array"
    },
    "principal_ref": {
      "minLength": 1,
      "type": "string"
    },
    "private_credentials_in_context": {
      "const": false
    },
    "role_assignment_bindings": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/binding"
      },
      "minItems": 0,
      "type": "array"
    },
    "schema_version": {
      "const": "lab-trusted-call-context/v1-candidate"
    },
    "scope_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "session_ref": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_profile_binding": {
      "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/binding"
    }
  },
  "required": [
    "schema_version",
    "context_ref",
    "host_instance_ref",
    "connection_ref",
    "principal_ref",
    "role_assignment_bindings",
    "authority_scope",
    "scope_refs",
    "source_profile_binding",
    "authentication_evidence_binding",
    "policy_bindings",
    "agent_instance_ref",
    "session_ref",
    "assignment_ref",
    "expires_at",
    "limits",
    "origin",
    "accept_client_supplied_authority_context",
    "private_credentials_in_context"
  ],
  "title": "Candidate local Lab API trusted-call-context",
  "type": "object"
}
