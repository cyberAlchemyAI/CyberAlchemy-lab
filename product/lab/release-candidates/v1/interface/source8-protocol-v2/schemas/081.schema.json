{
  "$id": "urn:cyberalchemy-lab:source8-protocol:protocol:release-manifest:v1-candidate:revision-2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "posture": {
            "const": "approved-exact-scope"
          }
        },
        "required": [
          "posture"
        ]
      },
      "then": {
        "properties": {
          "release_decision_binding": {
            "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/binding"
          }
        },
        "required": [
          "release_decision_binding"
        ]
      }
    }
  ],
  "properties": {
    "acceptance_contract_bindings": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/binding"
      },
      "minItems": 1,
      "type": "array"
    },
    "authority_effect": {
      "const": "none"
    },
    "capability_refs": {
      "items": {
        "allOf": [
          {
            "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/artifact_ref"
          },
          {
            "properties": {
              "carrier_ref": {
                "const": "cal.artifact-type.product-capability/v1"
              }
            }
          }
        ]
      },
      "minItems": 1,
      "type": "array"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "external_effect_refs": {
      "maxItems": 0,
      "type": "array"
    },
    "implementation_bindings": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/binding"
      },
      "minItems": 1,
      "type": "array"
    },
    "install_contract_binding": {
      "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/binding"
    },
    "package_bindings": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/binding"
      },
      "minItems": 1,
      "type": "array"
    },
    "pilot_evidence_bindings": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/binding"
      },
      "minItems": 1,
      "type": "array"
    },
    "posture": {
      "enum": [
        "candidate",
        "approved-exact-scope",
        "blocked"
      ]
    },
    "privacy_review_binding": {
      "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/binding"
    },
    "product": {
      "allOf": [
        {
          "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/artifact_ref"
        },
        {
          "properties": {
            "carrier_ref": {
              "const": "cal.artifact-type.product-identity/v2"
            }
          }
        }
      ]
    },
    "release_decision_binding": {
      "anyOf": [
        {
          "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/binding"
        },
        {
          "type": "null"
        }
      ]
    },
    "release_ref": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "lab-release-manifest/v1-candidate"
    },
    "supported_environment_bindings": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/binding"
      },
      "minItems": 1,
      "type": "array"
    },
    "thesis": {
      "allOf": [
        {
          "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/artifact_ref"
        },
        {
          "properties": {
            "carrier_ref": {
              "const": "cal.artifact-type.product-thesis/v1"
            }
          }
        }
      ]
    },
    "validation_bindings": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:source8-protocol:protocol:common:v1-candidate:revision-2#/$defs/binding"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "release_ref",
    "product",
    "thesis",
    "capability_refs",
    "implementation_bindings",
    "package_bindings",
    "acceptance_contract_bindings",
    "pilot_evidence_bindings",
    "privacy_review_binding",
    "validation_bindings",
    "install_contract_binding",
    "supported_environment_bindings",
    "release_decision_binding",
    "posture",
    "external_effect_refs",
    "claim_ceiling",
    "authority_effect"
  ],
  "title": "Candidate Lab release-manifest",
  "type": "object"
}
