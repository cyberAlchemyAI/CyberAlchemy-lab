{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "lab-protected-input-selector/v1-candidate"
    },
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "ref",
        "sha256"
      ]
    },
    "profile_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "ref",
        "sha256"
      ]
    },
    "source_cut": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "branch_ref": {
          "type": "string",
          "minLength": 1
        },
        "store_ref": {
          "type": "string",
          "minLength": 1
        },
        "commit_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "commit_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_profile_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "streams": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "stream_ref": {
                "type": "string",
                "minLength": 1
              },
              "cursor": {
                "type": "integer",
                "minimum": 0
              },
              "head_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "stream_ref",
              "cursor",
              "head_sha256"
            ]
          }
        }
      },
      "required": [
        "branch_ref",
        "store_ref",
        "commit_sequence",
        "commit_sha256",
        "source_profile_sha256",
        "streams"
      ]
    },
    "principal_ref": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "enum": [
        "release.prepare",
        "installation.execute"
      ]
    },
    "roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "device": {
            "type": "integer",
            "minimum": 0
          },
          "inode": {
            "type": "integer",
            "minimum": 0
          },
          "uid": {
            "type": "integer",
            "minimum": 0
          },
          "mode": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "path",
          "device",
          "inode",
          "uid",
          "mode"
        ]
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "root_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "logical_path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "governed-record",
              "governed-schema",
              "governed-descriptor",
              "semantic-policy",
              "source-manifest",
              "contract-profile",
              "execution-selection",
              "environment-contract",
              "history-proof",
              "recovery-proof",
              "public-package",
              "host-dependency",
              "custody-state"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "device": {
            "type": "integer",
            "minimum": 0
          },
          "inode": {
            "type": "integer",
            "minimum": 0
          },
          "uid": {
            "type": "integer",
            "minimum": 0
          },
          "mode": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "root_id",
          "path",
          "logical_path",
          "kind",
          "sha256",
          "size",
          "device",
          "inode",
          "uid",
          "mode"
        ]
      }
    },
    "proof_tables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file_id": {
            "type": "string",
            "minLength": 1
          },
          "row_selector": {
            "enum": [
              "/files",
              "/bindings",
              "/complete_source_bindings",
              "/complete_profile_bindings",
              "/schema_execution_bindings"
            ]
          },
          "coverage_file_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "file_id",
          "row_selector",
          "coverage_file_ids"
        ]
      }
    },
    "custody_state_file_id": {
      "type": "string",
      "minLength": 1
    },
    "authority_effect": {
      "const": "none"
    }
  },
  "required": [
    "schema_version",
    "source_binding",
    "profile_binding",
    "source_cut",
    "principal_ref",
    "operation",
    "roots",
    "files",
    "proof_tables",
    "custody_state_file_id",
    "authority_effect"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cyberalchemy-lab:T08:protected-selector.schema.json:v1-candidate"
}
