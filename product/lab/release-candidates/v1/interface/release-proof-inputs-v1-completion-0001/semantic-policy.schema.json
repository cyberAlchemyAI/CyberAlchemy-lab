{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "lab-schema-declared-semantic-graph/v1-candidate"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "schema_file_id": {
            "type": "string",
            "minLength": 1
          },
          "descriptor_file_id": {
            "type": "string",
            "minLength": 1
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "instance_pointer": {
                  "type": "string",
                  "minLength": 1
                },
                "schema_pointer": {
                  "type": "string",
                  "minLength": 1
                },
                "disposition": {
                  "enum": [
                    "semantic-node",
                    "verified-proof",
                    "current-context",
                    "self-identity"
                  ]
                }
              },
              "required": [
                "instance_pointer",
                "schema_pointer",
                "disposition"
              ]
            }
          }
        },
        "required": [
          "kind",
          "schema_file_id",
          "descriptor_file_id",
          "fields"
        ]
      }
    },
    "node_file_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "proof_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "file_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "reference",
          "file_id"
        ]
      }
    },
    "context_references": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority_effect": {
      "const": "none"
    }
  },
  "required": [
    "schema_version",
    "profiles",
    "node_file_ids",
    "proof_references",
    "context_references",
    "authority_effect"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cyberalchemy-lab:T08:semantic-policy.schema.json:v1-candidate"
}
