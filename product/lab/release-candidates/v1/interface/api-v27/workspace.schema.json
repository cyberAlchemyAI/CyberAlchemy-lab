{
  "$id": "urn:cyberalchemy-lab:owned-candidate-workspace:v1-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actual_owner_outcome": {
      "type": "null"
    },
    "authority_effect": {
      "const": "none"
    },
    "materials": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "pattern": "^inputs/[A-Za-z0-9_-]+[.]json$",
            "type": "string"
          },
          "ref": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "ref",
          "sha256",
          "path"
        ],
        "type": "object"
      },
      "maxItems": 256,
      "type": "array"
    },
    "principal_ref": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "lab-owned-candidate-workspace/v1-candidate"
    },
    "scope_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "target_metadata": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "ref": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "ref",
          "sha256"
        ],
        "type": "object"
      },
      "maxProperties": 64,
      "type": "object"
    },
    "workspace_ref": {
      "pattern": "^[A-Za-z0-9:._-]{1,120}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "workspace_ref",
    "principal_ref",
    "scope_refs",
    "materials",
    "target_metadata",
    "authority_effect",
    "actual_owner_outcome"
  ],
  "type": "object"
}
