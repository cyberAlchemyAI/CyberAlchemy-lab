{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cyberalchemy-lab:action-private-policy:0148",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "host_uid", "public_key", "principal_ref", "scope_ref", "expires_at", "allowed_operations", "source_binding", "source_public_key", "grant_binding", "authority_effect", "actual_owner_outcome", "revoked", "max_calls", "max_request_bytes", "max_response_bytes"],
  "properties": {
    "schema_version": {"const": "lab-local-action-policy/v1-candidate"},
    "host_uid": {"type": "integer", "minimum": 0},
    "public_key": {"type": "string", "minLength": 1},
    "principal_ref": {"type": "string", "minLength": 1},
    "scope_ref": {"type": "string", "minLength": 1},
    "expires_at": {"type": "string", "format": "date-time"},
    "allowed_operations": {"const": ["action.evaluate", "action.dispatch", "action.reconcile"]},
    "source_binding": {"type": "object", "required": ["ref", "sha256"]},
    "source_public_key": {"type": "string", "minLength": 1},
    "grant_binding": {"type": "object", "required": ["ref", "sha256"]},
    "authority_effect": {"const": "none"},
    "actual_owner_outcome": {"type": "null"},
    "revoked": {"const": false},
    "max_calls": {"type": "integer", "minimum": 1, "maximum": 256},
    "max_request_bytes": {"type": "integer", "minimum": 4096, "maximum": 65536},
    "max_response_bytes": {"type": "integer", "minimum": 32768, "maximum": 1048576}
  }
}
