    "session_control": {
      "type": "null"
    },
    "source_name": {
      "enum": [
        "genuine-C12-history",
        "genuine-W06-history",
        "genuine-W09-learning-history",
        "genuine-W09-engineering-history",
        "genuine-W09-research-history"
