        "catalog.get",
        "artifact.inspect",
        "artifact.query"
      ]
    },
    "authority_effect": {
      "const": "none"
    },
    "development_authorization_binding": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "sha256"
      ],
      "type": "object"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "history_control": {
      "additionalProperties": false,
      "properties": {
        "expired_lessons_grant_application": {
          "const": false
        },
        "inspection_only": {
          "const": true
        },
        "provider_selection_binding": {
          "additionalProperties": false,
          "properties": {
            "ref": {
              "minLength": 1,
              "type": "string"
            },
            "sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          },
          "required": [
            "ref",
            "sha256"
          ],
          "type": "object"
        },
        "provider_source_binding": {
          "additionalProperties": false,
          "properties": {
            "ref": {
              "minLength": 1,
              "type": "string"
            },
            "sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          },
          "required": [
            "ref",
            "sha256"
          ],
          "type": "object"
        },
        "source_archive_binding": {
          "additionalProperties": false,
          "properties": {
            "ref": {
              "minLength": 1,
              "type": "string"
            },
            "sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          },
          "required": [
            "ref",
            "sha256"
          ],
          "type": "object"
        },
        "source_cut": {
          "additionalProperties": false,
          "properties": {
            "baseline_snapshot_digest": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "sequence": {
              "const": 1
            },
            "signed_head": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          },
          "required": [
            "baseline_snapshot_digest",
            "signed_head",
            "sequence"
          ],
          "type": "object"
        }
      },
      "required": [
        "provider_source_binding",
        "provider_selection_binding",
        "source_archive_binding",
        "source_cut",
        "inspection_only",
        "expired_lessons_grant_application"
      ],
      "type": "object"
    },
    "host_uid": {
      "minimum": 0,
      "type": "integer"
    },
    "max_calls": {
      "maximum": 256,
      "minimum": 1,
      "type": "integer"
    },
    "max_request_bytes": {
      "maximum": 1048576,
      "minimum": 4096,
      "type": "integer"
    },
    "max_response_bytes": {
      "maximum": 4194304,
      "minimum": 4096,
      "type": "integer"
    },
