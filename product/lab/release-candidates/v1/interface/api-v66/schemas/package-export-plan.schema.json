{
  "$id": "urn:cyberalchemy-lab:internal:package-export-plan:v1-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actual_owner_outcome": {
      "type": "null"
    },
    "authority_effect": {
      "const": "none"
    },
    "export_contract_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "materials": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "artifact": {
            "anyOf": [
              {
                "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"
              },
              {
                "type": "null"
              }
            ]
          },
          "binding": {
            "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
          },
          "dependencies": {
            "items": {
              "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
            },
            "maxItems": 1000,
            "type": "array"
          },
          "encoding": {
            "const": "json-utf8"
          },
          "origin": {
            "enum": [
              "artifact",
              "schema",
              "source-proof",
              "proposal-input"
            ]
          }
        },
        "required": [
          "binding",
          "artifact",
          "dependencies",
          "origin",
          "encoding"
        ],
        "type": "object"
      },
      "maxItems": 1000,
      "minItems": 1,
      "type": "array"
    },
    "max_generations": {
      "maximum": 64,
      "minimum": 1,
      "type": "integer"
    },
    "max_package_bytes": {
      "maximum": 67108864,
      "minimum": 1,
      "type": "integer"
    },
    "output_root": {
      "minLength": 1,
      "type": "string"
    },
    "output_root_identity": {
      "additionalProperties": false,
      "properties": {
        "device": {
          "minimum": 0,
          "type": "integer"
        },
        "inode": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "device",
        "inode"
      ],
      "type": "object"
    },
    "output_root_scope_ref": {
      "minLength": 1,
      "type": "string"
    },
    "privacy_review_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "schema_version": {
      "const": "lab-package-export-plan/v1-candidate"
    },
    "scope_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "source_cut": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/source_cut"
    },
    "source_proposal_binding": {
      "anyOf": [
        {
          "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "source_cut",
    "export_contract_binding",
    "privacy_review_binding",
    "source_proposal_binding",
    "materials",
    "output_root",
    "output_root_scope_ref",
    "output_root_identity",
    "scope_binding",
    "max_package_bytes",
    "max_generations",
    "authority_effect",
    "actual_owner_outcome"
  ],
  "type": "object"
}
