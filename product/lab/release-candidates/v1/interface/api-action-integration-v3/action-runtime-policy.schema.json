{
  "$id": "urn:cyberalchemy-lab:action-private-policy:0148",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actual_owner_outcome": {
      "type": "null"
    },
    "allowed_operations": {
      "const": [
        "action.evaluate",
        "action.dispatch",
        "action.reconcile"
      ]
    },
    "authority_effect": {
      "const": "none"
    },
    "contract_profile_binding": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "sha256"
      ],
      "type": "object"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "grant_binding": {
      "required": [
        "ref",
        "sha256"
      ],
      "type": "object"
    },
    "host_uid": {
      "minimum": 0,
      "type": "integer"
    },
    "inspection_operations": {
      "const": [
        "operation.inspect"
      ]
    },
    "max_calls": {
      "maximum": 256,
      "minimum": 1,
      "type": "integer"
    },
    "max_request_bytes": {
      "maximum": 65536,
      "minimum": 4096,
      "type": "integer"
    },
    "max_response_bytes": {
      "maximum": 1048576,
      "minimum": 32768,
      "type": "integer"
    },
    "principal_ref": {
      "minLength": 1,
      "type": "string"
    },
    "public_key": {
      "minLength": 1,
      "type": "string"
    },
    "revoked": {
      "const": false
    },
    "schema_version": {
      "const": "lab-local-action-policy/v1-candidate"
    },
    "scope_ref": {
      "minLength": 1,
      "type": "string"
    },
    "source_binding": {
      "required": [
        "ref",
        "sha256"
      ],
      "type": "object"
    },
    "source_public_key": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "host_uid",
    "public_key",
    "principal_ref",
    "scope_ref",
    "expires_at",
    "allowed_operations",
    "source_binding",
    "source_public_key",
    "grant_binding",
    "authority_effect",
    "actual_owner_outcome",
    "revoked",
    "max_calls",
    "max_request_bytes",
    "max_response_bytes",
    "contract_profile_binding",
    "inspection_operations"
  ],
  "type": "object"
}
