            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "custody_grant_binding": {
            "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
          },
          "principal_ref": {
            "minLength": 1,
            "type": "string"
          },
          "public_key_binding": {
            "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
          },
          "signer_ref": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "signer_ref",
          "principal_ref",
          "public_key_binding",
          "allowed_kinds",
          "custody_grant_binding"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "source_cut": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/source_cut"
    }
  },
  "required": [
    "schema_version",
    "manifest_binding",
    "source_cut",
    "acceptance_scope_binding",
    "evidence_requirements",
    "signers",
    "owner_prerequisites",
    "authority_effect",
    "actual_owner_outcome"
  ],
  "type": "object"
}
