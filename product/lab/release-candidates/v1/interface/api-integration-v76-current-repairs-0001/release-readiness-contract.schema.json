{
  "$id": "urn:cyberalchemy-lab:private:release-readiness-contract:v2-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptance_scope_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "actual_owner_outcome": {
      "type": "null"
    },
    "authority_effect": {
      "const": "none"
    },
    "evidence_requirements": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "attestation_binding": {
            "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
          },
          "evidence_binding": {
            "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
          },
          "kind": {
            "enum": [
              "api-qualification",
              "human-pilot",
              "acceptance",
              "privacy",
              "installation",
              "review-closure"
            ]
          },
          "obligation_refs": {
            "items": {
              "enum": [
                "AC01",
                "AC02",
                "AC03",
                "AC04",
                "AC05",
                "AC06",
                "AC07",
                "AC08",
                "AC09",
                "AC10",
                "AC11",
                "AC12",
                "AC13"
              ]
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "signer_ref": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "obligation_refs",
          "kind",
          "evidence_binding",
          "attestation_binding",
          "signer_ref"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "manifest_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "owner_prerequisites": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "lab-release-readiness-contract/v2-candidate"
    },
    "signers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "allowed_kinds": {
            "items": {
              "enum": [
                "api-qualification",
                "human-pilot",
                "acceptance",
                "privacy",
                "installation",
                "review-closure"
