{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "current_protected_proof_verified": {
      "const": true
    },
    "eligibility_binding": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "sha256"
      ],
      "type": "object"
    },
    "final_release_decision_required": {
      "const": true
    },
    "member_bindings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "ref": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "ref",
          "sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "open_gaps": {
      "const": []
    },
    "original_full_proof_status": {
      "const": "REFUSED"
    },
    "owner_review_preconditions_resolved": {
      "const": true
    },
    "protected_selector_binding": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "sha256"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "lab-release-typed-review-closure/v3-candidate"
    },
    "semantic_edges": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "dependency": {
            "minLength": 1,
            "type": "string"
          },
          "source": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "source",
          "dependency"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "semantic_member_headers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "binding": {
            "additionalProperties": false,
            "properties": {
              "ref": {
                "minLength": 1,
                "type": "string"
              },
              "sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              }
            },
            "required": [
              "ref",
              "sha256"
            ],
            "type": "object"
          },
          "category": {
            "enum": [
              "artifact-instance",
              "definition",
              "relation-kind",
              "typed-relation",
              "artifact-type"
            ]
          },
          "identity": {
            "minLength": 1,
            "type": "string"
          },
          "version_ref": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "binding",
          "version_ref",
          "identity",
          "category"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "semantic_policy_binding": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "sha256"
      ],
      "type": "object"
    },
    "semantic_roots": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "typed_semantic_graph_acyclic": {
      "const": true
    }
  },
  "required": [
    "schema_version",
    "member_bindings",
    "protected_selector_binding",
    "semantic_policy_binding",
    "eligibility_binding",
    "semantic_member_headers",
    "semantic_roots",
    "semantic_edges",
    "open_gaps",
    "typed_semantic_graph_acyclic",
    "current_protected_proof_verified",
    "original_full_proof_status",
    "owner_review_preconditions_resolved",
    "final_release_decision_required"
  ],
  "type": "object"
}
