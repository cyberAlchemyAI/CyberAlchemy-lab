{
  "$id": "urn:cyberalchemy-lab:observed-lifetime-margin:v1-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "evidence_bindings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "execution_identity": {
      "additionalProperties": false,
      "properties": {
        "code_closure_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "dependency_selection_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "instrumentation_identity_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "load_identity_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "profile_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "source_cut_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "code_closure_sha256",
        "dependency_selection_sha256",
        "instrumentation_identity_sha256",
        "load_identity_sha256",
        "profile_sha256",
        "source_cut_sha256",
        "source_sha256"
      ],
      "type": "object"
    },
    "gate_overhead_upper_bound_us": {
      "minimum": 1,
      "type": "integer"
    },
    "phase_upper_bounds_us": {
      "additionalProperties": false,
      "properties": {
        "application-call": {
          "minimum": 1,
          "type": "integer"
        },
        "assessment-call": {
          "minimum": 1,
          "type": "integer"
        },
        "assessment-operator-preparation": {
          "minimum": 1,
          "type": "integer"
        },
        "attached-close": {
          "minimum": 1,
          "type": "integer"
        },
        "exact-application-retry": {
          "minimum": 1,
          "type": "integer"
        },
        "operation-inspection": {
          "minimum": 1,
          "type": "integer"
        },
        "original-cleanup": {
          "minimum": 1,
          "type": "integer"
        },
        "parent-close": {
          "minimum": 1,
          "type": "integer"
        },
        "parent-inspection": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "application-call",
        "exact-application-retry",
        "operation-inspection",
        "assessment-operator-preparation",
        "assessment-call",
        "attached-close",
        "parent-inspection",
        "parent-close",
        "original-cleanup"
      ],
      "type": "object"
    },
    "sample_count": {
      "minimum": 1,
      "type": "integer"
    },
    "schema_version": {
      "const": "lab-observed-lifetime-margin/v1-candidate"
    },
    "status": {
      "const": "empirically-qualified"
    },
    "uncertainty_method": {
      "const": "observed-maximum-plus-reviewed-uncertainty"
    },
    "uncertainty_reserve_us": {
      "minimum": 1,
      "type": "integer"
    },
    "valid_until": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
      "type": "string"
    }
  },
  "required": [
    "authority_effect",
    "evidence_bindings",
    "execution_identity",
    "gate_overhead_upper_bound_us",
    "phase_upper_bounds_us",
    "sample_count",
    "schema_version",
    "status",
    "uncertainty_method",
    "uncertainty_reserve_us",
    "valid_until"
  ],
  "type": "object"
}
