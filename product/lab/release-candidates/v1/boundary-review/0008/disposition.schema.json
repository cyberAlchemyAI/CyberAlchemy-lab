{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "disposition": {
      "enum": [
        "protected-prior-exclusion",
        "protected-nonexportable-migration",
        "protected-external-proof-dependency",
        "protected-cache-or-credential-path",
        "protected-new-field-or-format-finding",
        "protected-test-or-operation-evidence",
        "protected-source-history",
        "protected-verification-history",
        "candidate-public-code-schema-package",
        "protected-construction-or-fixture-code",
        "protected-runtime-history-reader"
      ]
    },
    "inspection_refusal_class": {
      "type": [
        "string",
        "null"
      ]
    },
    "mode": {
      "pattern": "^0o[0-7]+$",
      "type": "string"
    },
    "original_schema_input": {
      "type": "boolean"
    },
    "path": {
      "minLength": 1,
      "type": "string"
    },
    "private_field_findings": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "profile_verification_input": {
      "type": "boolean"
    },
    "public_body_export_allowed": {
      "const": false
    },
    "public_payload_proposed": {
      "type": "boolean"
    },
    "reason": {
      "minLength": 1,
      "type": "string"
    },
    "schema_execution_input": {
      "type": "boolean"
    },
    "selected_core_member": {
      "type": "boolean"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "size_bytes": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "path",
    "sha256",
    "size_bytes",
    "mode",
    "profile_verification_input",
    "schema_execution_input",
    "original_schema_input",
    "selected_core_member",
    "disposition",
    "reason",
    "public_payload_proposed",
    "public_body_export_allowed",
    "private_field_findings",
    "inspection_refusal_class"
  ],
  "type": "object"
}
