{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/admitted-ontology-navigation/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "projection_id",
    "version",
    "status",
    "ontology_type",
    "authority_effect",
    "authority_binding",
    "root",
    "components",
    "relations",
    "residue_routes",
    "review_routes",
    "work_lanes",
    "canonical_truth_contract",
    "query_contract",
    "source_direction",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "cyberalchemy-lab-admitted-ontology-navigation/v1"},
    "projection_id": {"const": "cal.ontology-navigation.lab-cohesion"},
    "version": {"const": "1.0.0"},
    "status": {"const": "derived-from-admitted-root"},
    "ontology_type": {"const": "business-system-bridge"},
    "authority_effect": {"const": "none"},
    "authority_binding": {"type": "object"},
    "root": {"type": "object"},
    "components": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_id", "kind", "branch", "source_authority_state", "effective_authority_state", "owner_route", "source_refs"],
        "properties": {
          "component_id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "branch": {"enum": ["business", "system", "bridge", "governance", "context"]},
          "source_authority_state": {"type": "string", "minLength": 1},
          "effective_authority_state": {"type": "string", "minLength": 1},
          "owner_route": {"type": "string", "minLength": 1},
          "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "relations": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relation_id", "type", "source", "target", "source_status", "effective_status", "source_refs"],
        "properties": {
          "relation_id": {"type": "string", "minLength": 1},
          "type": {"enum": ["realized_by", "depends_on", "constrained_by", "observed_by", "tested_by", "drifts_from", "traced_to"]},
          "source": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "source_status": {"type": "string", "minLength": 1},
          "effective_status": {"const": "admitted-composition-overlay"},
          "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "residue_routes": {"type": "array", "minItems": 5, "maxItems": 5},
    "review_routes": {"type": "array", "minItems": 10, "maxItems": 10},
    "work_lanes": {"type": "object"},
    "canonical_truth_contract": {"type": "object"},
    "query_contract": {"type": "object"},
    "source_direction": {"type": "object"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  }
}
