{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/agent-ontology-scaffold-prototype-v1.json",
  "title": "Agent-Facing Ontology Scaffold Prototype",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scaffold_id",
    "artifact_type",
    "prototype_epoch",
    "stage_id",
    "lifecycle_posture",
    "canonicality",
    "authority_effect",
    "canonicalization",
    "source_direction",
    "definition_registry_binding",
    "preserved_p0_materials",
    "definition_nodes",
    "relation_hints",
    "source_selector_index",
    "challenge_route_index",
    "dependency_drift_policy",
    "stage_transition",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "cyberalchemy-lab-agent-ontology-scaffold-prototype/v1"},
    "scaffold_id": {"type": "string", "minLength": 1},
    "artifact_type": {"const": "agent-facing-ontology-scaffold-prototype"},
    "prototype_epoch": {"const": "epoch-001"},
    "stage_id": {"const": "CML08-P1-AUTHOR-AGENT-ONTOLOGY-SCAFFOLD"},
    "lifecycle_posture": {"const": "prototype-scaffold"},
    "canonicality": {"const": "non-authoritative"},
    "authority_effect": {"const": "none"},
    "canonicalization": {"const": "json-sort-keys-compact-utf8-v1"},
    "source_direction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical", "human_projection", "projection_policy", "generator"],
      "properties": {
        "canonical": {"const": "scaffold.json"},
        "human_projection": {"const": "SCAFFOLD.md"},
        "projection_policy": {"const": "generated-only"},
        "generator": {"const": "build.py"}
      }
    },
    "definition_registry_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "validation_receipt_path", "validation_receipt_sha256", "required_result", "required_stage_state"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "validation_receipt_path": {"type": "string"},
        "validation_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "required_result": {"const": "PASS"},
        "required_stage_state": {"const": "TESTED_PROTOTYPE"}
      }
    },
    "preserved_p0_materials": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/materialBinding"}
    },
    "definition_nodes": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/definitionNode"}
    },
    "relation_hints": {
      "type": "array",
      "minItems": 11,
      "items": {"$ref": "#/$defs/relationHint"}
    },
    "source_selector_index": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sourceSelector"}
    },
    "challenge_route_index": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/challengeRoute"}
    },
    "dependency_drift_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected_dependency_drift", "unselected_ambient_drift", "implicit_dependency_expansion", "mandatory_ontology_runtime_gate"],
      "properties": {
        "selected_dependency_drift": {"const": "block"},
        "unselected_ambient_drift": {"const": "diagnostic-only"},
        "implicit_dependency_expansion": {"const": "forbidden"},
        "mandatory_ontology_runtime_gate": {"const": false}
      }
    },
    "stage_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_frontier", "tested_stage_state", "next_frontier_candidate", "next_stage_id", "transition_effect"],
      "properties": {
        "from_frontier": {"const": "ontology_scaffolds"},
        "tested_stage_state": {"const": "TESTED_PROTOTYPE"},
        "next_frontier_candidate": {"const": "product_business_domainspec_compiled_system_implementation_prototypes"},
        "next_stage_id": {"const": "CML09-P2-BUILD-THIN-END-TO-END-PRODUCT-PROTOTYPE"},
        "transition_effect": {"type": "string", "minLength": 1}
      }
    },
    "claim_ceiling": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "materialBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "definitionNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition_id", "term", "definition_sha256", "posture"],
      "properties": {
        "definition_id": {"type": "string", "minLength": 1},
        "term": {"type": "string", "minLength": 1},
        "definition_sha256": {"$ref": "#/$defs/sha256"},
        "posture": {"const": "prototype-node"}
      }
    },
    "relationHint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "relation_type", "target_ref", "posture"],
      "properties": {
        "source_ref": {"type": "string", "minLength": 1},
        "relation_type": {"type": "string", "minLength": 1},
        "target_ref": {"type": "string", "minLength": 1},
        "posture": {"const": "prototype-hint"}
      }
    },
    "sourceSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependency_id", "repository", "path", "selector", "sha256", "relevance", "drift_effect"],
      "properties": {
        "dependency_id": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "selector": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "relevance": {"type": "string", "minLength": 1},
        "drift_effect": {"const": "block-selected-dependency"}
      }
    },
    "challengeRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["challenge_id", "condition", "route", "outcome"],
      "properties": {
        "challenge_id": {"type": "string", "minLength": 1},
        "condition": {"type": "string", "minLength": 1},
        "route": {"type": "string", "minLength": 1},
        "outcome": {"type": "string", "minLength": 1}
      }
    }
  }
}
