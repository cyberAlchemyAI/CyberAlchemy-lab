{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/craft-first-capability/prototype-artifacts/v1",
  "title": "Craft First Capability Prototype Artifacts",
  "$defs": {
    "sourceDirection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical", "human_projection", "projection_policy", "generator"],
      "properties": {
        "canonical": {"type": "string", "minLength": 1},
        "human_projection": {"type": "string", "minLength": 1},
        "projection_policy": {"const": "generated-only"},
        "generator": {"type": "string", "minLength": 1}
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": true
    },
    "prototypeDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition_id", "version", "term", "aliases", "classification", "lifecycle_posture", "authority_effect", "applicability", "exclusions", "voices", "boundaries", "source_refs", "four_facets"],
      "properties": {
        "definition_id": {"type": "string", "pattern": "^cal\\.prototype\\.definition\\.[a-z0-9-]+$"},
        "version": {"const": "0.1.0-prototype.1"},
        "term": {"type": "string", "minLength": 3},
        "aliases": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "classification": {"const": "prototype-definition"},
        "lifecycle_posture": {"const": "prototype"},
        "authority_effect": {"const": "none"},
        "applicability": {"type": "string", "minLength": 20},
        "exclusions": {"type": "array", "items": {"type": "string"}, "minItems": 2, "uniqueItems": true},
        "voices": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scientific_formal", "plain_language", "domain_context"],
          "properties": {
            "scientific_formal": {
              "type": "object",
              "additionalProperties": false,
              "required": ["normative_statement", "formal_expression", "notation", "boundary_conditions", "testable_conditions"],
              "properties": {
                "normative_statement": {"type": "string", "minLength": 40},
                "formal_expression": {"type": "string", "minLength": 20},
                "notation": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["symbol", "meaning"], "properties": {"symbol": {"type": "string"}, "meaning": {"type": "string"}}, "additionalProperties": false}},
                "boundary_conditions": {"type": "array", "items": {"type": "string"}, "minItems": 3},
                "testable_conditions": {"type": "array", "items": {"type": "string"}, "minItems": 3}
              }
            },
            "plain_language": {"type": "object", "additionalProperties": false, "required": ["normative", "explanation"], "properties": {"normative": {"const": false}, "explanation": {"type": "string", "minLength": 20}}},
            "domain_context": {"type": "object", "additionalProperties": false, "required": ["normative", "workspace_ref", "explanation"], "properties": {"normative": {"const": false}, "workspace_ref": {"const": "/home/vrondelli/projects/CyberAlchemy-lab"}, "explanation": {"type": "string", "minLength": 20}}}
          }
        },
        "boundaries": {"type": "array", "items": {"type": "string"}, "minItems": 3},
        "source_refs": {"type": "array", "items": {"enum": ["CAV2-D65", "CAV2-D67", "CAL-CML08-14-CRAFT-FIRST-PRODUCT-CANDIDATE-0002"]}, "minItems": 2, "uniqueItems": true},
        "four_facets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["classification", "schema", "human_projection", "machine_checkable"],
          "properties": {
            "classification": {"type": "string", "minLength": 3},
            "schema": {"type": "string", "minLength": 3},
            "human_projection": {"type": "string", "minLength": 3},
            "machine_checkable": {"type": "array", "items": {"type": "string"}, "minItems": 3, "uniqueItems": true}
          }
        }
      }
    },
    "prototypeDefinitionRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "registry_id", "artifact_type", "prototype_epoch", "status", "canonicality", "authority_effect", "semantic_contributor_route", "source_bindings", "definitions", "source_direction", "claim_ceiling"],
      "properties": {
        "schema_version": {"const": "cyberalchemy-lab-prototype-definition-registry/v1"},
        "registry_id": {"const": "CAL-CML08-P0-DEFINITION-PROTOTYPES-EPOCH-001"},
        "artifact_type": {"const": "prototype-definition-registry"},
        "prototype_epoch": {"const": "epoch-001"},
        "status": {"const": "prototype"},
        "canonicality": {"const": "non-authoritative"},
        "authority_effect": {"const": "none"},
        "semantic_contributor_route": {"const": "role:prototype-definition-contributor"},
        "source_bindings": {"type": "array", "minItems": 3, "items": {"type": "object", "required": ["source_ref", "selector", "sha256"], "properties": {"source_ref": {"type": "string"}, "selector": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false}},
        "definitions": {"type": "array", "items": {"$ref": "#/$defs/prototypeDefinition"}, "minItems": 12, "maxItems": 12},
        "source_direction": {"$ref": "#/$defs/sourceDirection"},
        "claim_ceiling": {"type": "string", "minLength": 40}
      }
    },
    "prototypePackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "prototype_id", "artifact_type", "prototype_epoch", "stage_id", "lane", "state", "authority_effect", "chain_binding", "selected_dependencies", "artifacts", "stage_transition", "source_direction", "claim_ceiling"],
      "properties": {
        "schema_version": {"const": "cyberalchemy-lab-prototype-package/v1"},
        "prototype_id": {"const": "CAL-PROTOTYPE-CRAFT-FIRST-CAPABILITY-EPOCH-001"},
        "artifact_type": {"const": "prototype-package"},
        "prototype_epoch": {"const": "epoch-001"},
        "stage_id": {"const": "CML08-P0-AUTHOR-DEFINITION-PROTOTYPES"},
        "lane": {"const": "product-construction"},
        "state": {"const": "prototype"},
        "authority_effect": {"const": "none"},
        "chain_binding": {"type": "object", "required": ["chain_id", "path", "sha256"], "properties": {"chain_id": {"type": "string"}, "path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false},
        "selected_dependencies": {"type": "array", "minItems": 5, "items": {"type": "object", "required": ["dependency_id", "repository", "path", "selector", "sha256", "posture"], "properties": {"dependency_id": {"type": "string"}, "repository": {"type": "string"}, "path": {"type": "string"}, "selector": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "posture": {"type": "string"}}, "additionalProperties": false}},
        "artifacts": {"type": "object", "minProperties": 9, "additionalProperties": {"type": "string"}},
        "stage_transition": {"type": "object", "required": ["from_frontier", "tested_stage_state", "next_frontier_candidate", "transition_effect"], "properties": {"from_frontier": {"const": "definition_prototypes"}, "tested_stage_state": {"const": "TESTED_PROTOTYPE"}, "next_frontier_candidate": {"const": "ontology_scaffolds"}, "transition_effect": {"type": "string"}}, "additionalProperties": false},
        "source_direction": {"$ref": "#/$defs/sourceDirection"},
        "claim_ceiling": {"type": "string", "minLength": 40}
      }
    }
  }
}
