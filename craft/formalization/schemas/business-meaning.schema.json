{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/formalization/business-meaning/v1-candidate",
  "title": "BusinessMeaning/v1 Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "meaning_id", "version", "owner", "status", "domain_context", "rule", "applies_when", "actors", "inputs", "outcomes", "examples", "counterexamples", "boundaries", "acceptance", "claim_ceiling", "authority_effect"],
  "properties": {
    "schema_version": {"const": "domainspec-v2.business-meaning/v1-candidate"},
    "meaning_id": {"$ref": "#/$defs/text"},
    "version": {"$ref": "#/$defs/text"},
    "owner": {"$ref": "#/$defs/text"},
    "status": {"enum": ["draft", "reviewed", "accepted", "superseded"]},
    "supersedes": {"type": ["string", "null"]},
    "domain_context": {"$ref": "#/$defs/text"},
    "rule": {"$ref": "#/$defs/text"},
    "applies_when": {"$ref": "#/$defs/textSet"},
    "actors": {"$ref": "#/$defs/textSet"},
    "inputs": {"$ref": "#/$defs/textSet"},
    "outcomes": {"$ref": "#/$defs/textSet"},
    "examples": {"$ref": "#/$defs/cases"},
    "counterexamples": {"$ref": "#/$defs/cases"},
    "boundaries": {"$ref": "#/$defs/textSet"},
    "acceptance": {"$ref": "#/$defs/acceptance"},
    "claim_ceiling": {"$ref": "#/$defs/text"},
    "authority_effect": {"const": "none"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "accepted"}}}, "then": {"properties": {"acceptance": {"required": ["status", "owner_ref", "acceptance_ref", "acceptance_digest"], "properties": {"status": {"const": "accepted"}, "acceptance_ref": {"$ref": "#/$defs/text"}, "acceptance_digest": {"$ref": "#/$defs/digest"}}}}}},
    {"if": {"properties": {"acceptance": {"properties": {"status": {"const": "accepted"}}}}}, "then": {"properties": {"status": {"const": "accepted"}}}}
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "textSet": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "cases": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["case_id", "given", "when", "then", "why"], "properties": {"case_id": {"$ref": "#/$defs/text"}, "given": {"$ref": "#/$defs/text"}, "when": {"$ref": "#/$defs/text"}, "then": {"$ref": "#/$defs/text"}, "why": {"$ref": "#/$defs/text"}}}},
    "acceptance": {"type": "object", "additionalProperties": false, "required": ["status", "owner_ref", "acceptance_ref", "acceptance_digest"], "properties": {"status": {"enum": ["not-requested", "requested", "accepted", "rejected"]}, "owner_ref": {"$ref": "#/$defs/text"}, "acceptance_ref": {"type": ["string", "null"]}, "acceptance_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}}}
  }
}
