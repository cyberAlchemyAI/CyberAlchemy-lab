{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/formalization/native-source-bundle/v1-candidate",
  "title": "Provider Native Source Bundle Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "owner", "projection_ref", "preservation_binding_ref", "profile_ref", "provider_id", "files", "materializer", "bundle_digest", "authority_effect", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "domainspec-v2.native-source-bundle/v1-candidate"},
    "bundle_id": {"$ref": "#/$defs/text"},
    "owner": {"const": "projects/domainspec-v2/formalization"},
    "projection_ref": {"$ref": "#/$defs/exactRef"},
    "preservation_binding_ref": {"$ref": "#/$defs/exactRef"},
    "profile_ref": {"$ref": "#/$defs/exactRef"},
    "provider_id": {"$ref": "#/$defs/text"},
    "files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sourceFile"}},
    "materializer": {"type": "object", "additionalProperties": false, "required": ["algorithm_ref", "deterministic", "output_root_policy"], "properties": {"algorithm_ref": {"$ref": "#/$defs/exactRef"}, "deterministic": {"const": true}, "output_root_policy": {"$ref": "#/$defs/text"}}},
    "bundle_digest": {"$ref": "#/$defs/digest"},
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"const": "deterministic-provider-input-only-no-execution-claim"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "exactRef": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes"], "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/digest"}, "size_bytes": {"type": "integer", "minimum": 0}}},
    "sourceFile": {"type": "object", "additionalProperties": false, "required": ["relative_path", "media_type", "content", "content_sha256", "size_bytes"], "properties": {"relative_path": {"$ref": "#/$defs/text"}, "media_type": {"$ref": "#/$defs/text"}, "content": {"type": "string"}, "content_sha256": {"$ref": "#/$defs/digest"}, "size_bytes": {"type": "integer", "minimum": 0}}}
  }
}
