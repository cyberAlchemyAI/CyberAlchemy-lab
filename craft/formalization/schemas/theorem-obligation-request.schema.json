{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/formalization/theorem-obligation-request/v1-candidate",
  "title": "Theorem Obligation Request Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "owner", "request_state", "formal_claim_lean_binding_ref", "theorem_statement_ref", "provider_profile_ref", "runtime_binding_ref", "execution_policy_ref", "authority_effect", "claim_ceiling", "residue"],
  "properties": {
    "schema_version": {"const": "domainspec-v2.theorem-obligation-request/v1-candidate"},
    "request_id": {"$ref": "#/$defs/text"},
    "owner": {"const": "EVF"},
    "request_state": {"enum": ["ready", "blocked", "stale"]},
    "formal_claim_lean_binding_ref": {"$ref": "#/$defs/exactRef"},
    "theorem_statement_ref": {"$ref": "#/$defs/exactRef"},
    "provider_profile_ref": {"$ref": "#/$defs/exactRef"},
    "runtime_binding_ref": {"$ref": "#/$defs/exactRef"},
    "execution_policy_ref": {"$ref": "#/$defs/exactRef"},
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"const": "theorem-request-only-no-proof-claim"},
    "residue": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "exactRef": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes", "current"], "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/digest"}, "size_bytes": {"type": "integer", "minimum": 0}, "current": {"type": "boolean"}}}
  }
}
