{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/formalization/neutral-obligation-set/v1-candidate",
  "title": "TDE Neutral Obligation Set Bridge Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "obligation_set_id", "owner", "formal_claim_ref", "capability_assessment_ref", "projection_ref", "derivation_profile_ref", "derivation_status", "obligations", "residue", "determinism", "authority_effect", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "domainspec-v2.neutral-obligation-set/v1-candidate"},
    "obligation_set_id": {"$ref": "#/$defs/text"},
    "owner": {"const": "TDE"},
    "formal_claim_ref": {"$ref": "#/$defs/exactRef"},
    "capability_assessment_ref": {"$ref": "#/$defs/exactRef"},
    "projection_ref": {"oneOf": [{"$ref": "#/$defs/exactRef"}, {"type": "null"}]},
    "derivation_profile_ref": {"$ref": "#/$defs/exactRef"},
    "derivation_status": {"enum": ["derived", "unsupported", "indeterminate", "stale", "blocked"]},
    "obligations": {"type": "array", "items": {"$ref": "#/$defs/obligation"}},
    "residue": {"$ref": "#/$defs/residueSet"},
    "determinism": {"type": "object", "additionalProperties": false, "required": ["algorithm_ref", "input_digest", "output_digest"], "properties": {"algorithm_ref": {"$ref": "#/$defs/exactRef"}, "input_digest": {"$ref": "#/$defs/digest"}, "output_digest": {"$ref": "#/$defs/digest"}}},
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"$ref": "#/$defs/text"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "textSet": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "exactRef": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes"], "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/digest"}, "size_bytes": {"type": "integer", "minimum": 0}, "current": {"type": "boolean"}}},
    "obligation": {"type": "object", "additionalProperties": false, "required": ["obligation_id", "case_id", "kind", "normalized_inputs", "expected_relation_or_oracle", "source_basis", "case_class", "status", "claim_ceiling"], "properties": {"obligation_id": {"$ref": "#/$defs/text"}, "case_id": {"$ref": "#/$defs/text"}, "kind": {"enum": ["property", "witness", "counterexample", "boundary", "vacuity", "runtime-conformance"]}, "normalized_inputs": {"type": "object"}, "expected_relation_or_oracle": {"$ref": "#/$defs/text"}, "source_basis": {"$ref": "#/$defs/textSet"}, "case_class": {"enum": ["positive", "negative", "boundary", "vacuity"]}, "status": {"enum": ["ready", "needs-formal", "unsupported", "indeterminate"]}, "claim_ceiling": {"$ref": "#/$defs/text"}}},
    "residueSet": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["code", "message", "blocking"], "properties": {"code": {"$ref": "#/$defs/text"}, "message": {"$ref": "#/$defs/text"}, "blocking": {"type": "boolean"}}}}
  }
}
