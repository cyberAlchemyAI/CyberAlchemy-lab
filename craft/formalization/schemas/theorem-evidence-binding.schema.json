{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/formalization/theorem-evidence-binding/v1-candidate",
  "title": "Theorem Evidence Binding Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "binding_id", "provider_owner", "provider_id", "provider_version", "theorem_request_ref", "formal_claim_lean_binding_ref", "runtime_binding_ref", "theorem_provider_receipt_ref", "execution_status", "native_outcome", "normalized_outcome", "evidence_status", "residue", "authority_effect", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "domainspec-v2.theorem-evidence-binding/v1-candidate"},
    "binding_id": {"$ref": "#/$defs/text"},
    "provider_owner": {"$ref": "#/$defs/text"},
    "provider_id": {"$ref": "#/$defs/text"},
    "provider_version": {"$ref": "#/$defs/text"},
    "theorem_request_ref": {"$ref": "#/$defs/exactRef"},
    "formal_claim_lean_binding_ref": {"$ref": "#/$defs/exactRef"},
    "runtime_binding_ref": {"$ref": "#/$defs/exactRef"},
    "theorem_provider_receipt_ref": {"$ref": "#/$defs/exactRef"},
    "execution_status": {"enum": ["completed", "failed", "timeout", "blocked", "stale"]},
    "native_outcome": {"enum": ["checked", "rejected", "unknown", "not-run"]},
    "normalized_outcome": {"enum": ["passed", "failed", "indeterminate", "timeout", "stale", "provider-error", "blocked"]},
    "evidence_status": {"enum": ["current", "stale", "missing", "invalid"]},
    "residue": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"const": "theorem-in-exact-lean-model-only-no-runtime-or-release-claim"}
  },
  "allOf": [
    {"if": {"properties": {"normalized_outcome": {"const": "passed"}}}, "then": {"properties": {"execution_status": {"const": "completed"}, "native_outcome": {"const": "checked"}, "evidence_status": {"const": "current"}}}},
    {"if": {"properties": {"execution_status": {"const": "timeout"}}}, "then": {"properties": {"native_outcome": {"const": "not-run"}, "normalized_outcome": {"const": "timeout"}}}}
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "exactRef": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes", "current"], "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/digest"}, "size_bytes": {"type": "integer", "minimum": 0}, "current": {"type": "boolean"}}}
  }
}
