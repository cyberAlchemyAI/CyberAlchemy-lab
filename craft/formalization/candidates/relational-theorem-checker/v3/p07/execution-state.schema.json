{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:relational:v3:owned-execution-state",
  "type": "object",
  "properties": {
    "schema": {
      "const": "relational.execution-state/v3"
    },
    "accepted": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(P(?:0[0-9]|1[01])|E0[0-6])$"
      },
      "uniqueItems": true
    },
    "remaining_required": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(P(?:0[0-9]|1[01])|E0[0-6])$"
      },
      "uniqueItems": true
    },
    "remaining_optional": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(P(?:0[0-9]|1[01])|E0[0-6])$"
      },
      "uniqueItems": true
    },
    "resolved_optional": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^E0[0-6]$"
          },
          "resolution": {
            "const": "not-needed"
          }
        },
        "required": [
          "id",
          "resolution"
        ],
        "additionalProperties": false
      }
    },
    "complete": {
      "type": "boolean"
    },
    "authority_effect": {
      "const": "none"
    }
  },
  "required": [
    "schema",
    "accepted",
    "remaining_required",
    "remaining_optional",
    "resolved_optional",
    "complete",
    "authority_effect"
  ],
  "additionalProperties": false
}
