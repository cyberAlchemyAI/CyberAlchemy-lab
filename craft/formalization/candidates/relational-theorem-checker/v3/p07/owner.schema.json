{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:relational:v3:owned-owner",
  "type": "object",
  "properties": {
    "schema": {
      "const": "relational.run-owner/v3"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "ownership_token": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "job": {
      "type": "string",
      "minLength": 1
    },
    "cleanup": {
      "const": "proposal-only; accepted and other runs excluded"
    },
    "authority_effect": {
      "const": "none"
    }
  },
  "required": [
    "schema",
    "run_id",
    "ownership_token",
    "job",
    "cleanup",
    "authority_effect"
  ],
  "additionalProperties": false
}
