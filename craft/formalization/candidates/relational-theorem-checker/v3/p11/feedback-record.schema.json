{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "relational.actual-human-feedback/v3",
  "type": "object",
  "properties": {
    "schema": {
      "const": "relational.actual-human-feedback/v3"
    },
    "packet": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "actual_answer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "assessment_scope": {
      "const": "v3-worked-packet"
    },
    "source": {
      "const": "direct-user-message-in-this-chat"
    },
    "received_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "assessment": {
      "type": "object",
      "properties": {
        "meanings": {
          "enum": [
            "fits",
            "changes-needed"
          ]
        },
        "diagnostics": {
          "enum": [
            "fits",
            "changes-needed"
          ]
        },
        "bounded_local_shadow_use": {
          "enum": [
            "fits",
            "changes-needed"
          ]
        }
      },
      "required": [
        "meanings",
        "diagnostics",
        "bounded_local_shadow_use"
      ],
      "additionalProperties": false
    },
    "human_assessment": {
      "const": true
    },
    "deployment_authorized": {
      "const": false
    },
    "authority_effect": {
      "const": "none"
    }
  },
  "required": [
    "schema",
    "packet",
    "question",
    "actual_answer",
    "assessment_scope",
    "source",
    "received_at",
    "assessment",
    "human_assessment",
    "deployment_authorized",
    "authority_effect"
  ],
  "additionalProperties": false
}
