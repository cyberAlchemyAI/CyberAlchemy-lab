{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:relational:v3:performance-controls",
  "type": "object",
  "properties": {
    "result": {
      "const": "pass"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "qualified-candidate",
              "unknown-resource",
              "cancelled",
              "invalid",
              "unsupported",
              "unsupported-policy"
            ]
          },
          "client_seconds": {
            "type": "number",
            "minimum": 0
          },
          "worker_seconds": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "category_seconds": {
            "type": "object",
            "properties": {
              "compile_tools": {
                "type": "number",
                "minimum": 0
              },
              "general_replay": {
                "type": "number",
                "minimum": 0
              },
              "source_cache_guards": {
                "type": "number",
                "minimum": 0
              },
              "source_projection": {
                "type": "number",
                "minimum": 0
              },
              "reference_evaluator_process": {
                "type": "number",
                "minimum": 0
              },
              "saved_inspection_process": {
                "type": "number",
                "minimum": 0
              },
              "other_worker_time": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "compile_tools",
              "general_replay",
              "source_cache_guards",
              "source_projection",
              "reference_evaluator_process",
              "saved_inspection_process",
              "other_worker_time"
            ],
            "additionalProperties": false
          },
          "finite_evaluator_seconds": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "peak_rss_observed": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "status",
          "client_seconds",
          "worker_seconds",
          "category_seconds",
          "finite_evaluator_seconds",
          "peak_rss_observed",
          "scope"
        ],
        "additionalProperties": false
      }
    },
    "read_timings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "seconds": {
            "type": "number",
            "minimum": 0
          },
          "output": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "scope": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "seconds",
          "output",
          "scope"
        ],
        "additionalProperties": false
      }
    },
    "recorded_shadow_timings": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "layout": {
            "enum": [
              "combined",
              "staged"
            ]
          },
          "generation": {
            "type": "integer",
            "minimum": 0
          },
          "application_seconds_inclusive": {
            "type": "number",
            "minimum": 0
          },
          "proposal_supervised_seconds": {
            "type": "number",
            "minimum": 0
          },
          "successor_registration_supervised_seconds": {
            "type": "number",
            "minimum": 0
          },
          "application_source": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "proposal_record": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "registration_record": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "scope": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "layout",
          "generation",
          "application_seconds_inclusive",
          "proposal_supervised_seconds",
          "successor_registration_supervised_seconds",
          "application_source",
          "proposal_record",
          "registration_record",
          "scope"
        ],
        "additionalProperties": false
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "const": "pass"
          }
        },
        "required": [
          "name",
          "result"
        ],
        "additionalProperties": false
      }
    },
    "report": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "authority_effect": {
      "const": "none"
    }
  },
  "required": [
    "result",
    "rows",
    "read_timings",
    "recorded_shadow_timings",
    "controls",
    "report",
    "authority_effect"
  ],
  "additionalProperties": false
}
