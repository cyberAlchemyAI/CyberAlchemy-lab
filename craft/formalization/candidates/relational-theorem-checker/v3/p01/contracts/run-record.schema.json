{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:relational:v3:run-record",
  "type": "object",
  "properties": {
    "schema": {
      "const": "relational.run-record/v3"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "request_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "phase": {
      "enum": [
        "prepared",
        "running",
        "completed",
        "unknown-resource",
        "cancelled",
        "invalid",
        "unsupported",
        "unsupported-policy",
        "reconciliation-required"
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "repo"
              },
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "kind",
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "toolchain"
              },
              "toolchain_identity": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "path": {
                "type": "string",
                "pattern": "^lib/lean/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "kind",
              "toolchain_identity",
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "repo"
              },
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "kind",
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "toolchain"
              },
              "toolchain_identity": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "path": {
                "type": "string",
                "pattern": "^lib/lean/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "kind",
              "toolchain_identity",
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "resource_events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "detail"
        ],
        "additionalProperties": false
      }
    },
    "timings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string",
            "minLength": 1
          },
          "parent": {
            "type": [
              "string",
              "null"
            ]
          },
          "seconds": {
            "type": "number",
            "minimum": 0
          },
          "mode": {
            "enum": [
              "inclusive",
              "exclusive"
            ]
          }
        },
        "required": [
          "stage",
          "parent",
          "seconds",
          "mode"
        ],
        "additionalProperties": false
      }
    },
    "cache_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "binding": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "repo"
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "kind",
                  "path",
                  "sha256"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "toolchain"
                  },
                  "toolchain_identity": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^lib/lean/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "kind",
                  "toolchain_identity",
                  "path",
                  "sha256"
                ],
                "additionalProperties": false
              }
            ]
          },
          "current": {
            "type": "boolean"
          }
        },
        "required": [
          "binding",
          "current"
        ],
        "additionalProperties": false
      }
    },
    "result": {
      "oneOf": [
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "repo"
                },
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "kind",
                "path",
                "sha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "toolchain"
                },
                "toolchain_identity": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "path": {
                  "type": "string",
                  "pattern": "^lib/lean/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "kind",
                "toolchain_identity",
                "path",
                "sha256"
              ],
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "authority_effect": {
      "const": "none"
    }
  },
  "required": [
    "schema",
    "run_id",
    "request_identity",
    "phase",
    "inputs",
    "outputs",
    "resource_events",
    "timings",
    "cache_checks",
    "result",
    "authority_effect"
  ],
  "additionalProperties": false
}
