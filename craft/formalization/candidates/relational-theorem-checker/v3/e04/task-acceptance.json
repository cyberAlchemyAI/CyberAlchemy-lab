  "criteria": [
    {
      "criterion": "Lifecycle policy and transition theorem are fixed before mutation code.",
      "evidence": "Explicit separate lifecycle policy and universal exact transition/history-evidence preservation/no-historical-reactivation/declaration-only refusal compiled before mutation code."
    },
    {
      "criterion": "Conflict/recovery states are reviewable.",
      "evidence": "Three actual owned eligibility witnesses plus two competing cooperating writers yield one commit and one conflict. Actual isolated child exits before/after SQLite commit recover the expected old/new generation with no new freshness. Saved, altered, rule-only and declaration-only receipts refuse the public gate."
    },
    {
      "criterion": "Rule-only and append guarantees retain their original scope.",
      "evidence": "Candidate lifecycle head changes are separate from fixed-frame append/model-expansion guarantees. No old shadow store/API is altered; immutable declaration/input/completion references and prior history survive each exact generation transition."
    }
  ],
