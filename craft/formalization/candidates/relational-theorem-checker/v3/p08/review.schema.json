{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:relational:v3:shadow-review",
  "type": "object",
  "properties": {
    "schema": {
      "const": "relational.shadow-review/v3"
    },
    "store_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "expected_head": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "relational.shadow-head/v3"
        },
        "store_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "store_kind": {
          "enum": [
            "fixture-shadow",
            "io-probe-unqualified"
          ]
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_identity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "snapshot": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "registration": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "transaction_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "authority_effect": {
          "const": "none"
        },
        "application_authorized": {
          "const": false
        }
      },
      "required": [
        "schema",
        "store_id",
        "store_kind",
        "generation",
        "baseline_identity",
        "snapshot",
        "registration",
        "transaction_id",
        "authority_effect",
        "application_authorized"
      ],
      "additionalProperties": false
    },
    "request_bytes_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "proposal_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "successor_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewer": {
      "enum": [
        "author-integration-fixture",
        "actual-user-review"
      ]
    },
    "assessment": {
      "enum": [
        "reviewed-candidate",
        "declined"
      ]
    },
    "context_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mappings_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mapped_contexts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "authority_effect": {
      "const": "none"
    },
    "application_authorized": {
      "const": false
    }
  },
  "required": [
    "schema",
    "store_id",
    "expected_head",
    "request_bytes_sha256",
    "request_identity",
    "proposal_identity",
    "successor_identity",
    "reviewer",
    "assessment",
    "context_identity",
    "mappings_identity",
    "mapped_contexts",
    "authority_effect",
    "application_authorized"
  ],
  "additionalProperties": false
}
