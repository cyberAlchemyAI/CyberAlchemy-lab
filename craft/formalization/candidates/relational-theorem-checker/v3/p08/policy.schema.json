{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:relational:v3:shadow-policy",
  "type": "object",
  "properties": {
    "schema": {
      "const": "relational.shadow-policy/v3"
    },
    "writers": {
      "const": "exclusively-mediated-cooperating-writers"
    },
    "store_kind": {
      "enum": [
        "fixture-shadow",
        "io-probe-unqualified"
      ]
    },
    "scope": {
      "const": "bounded-local-candidate"
    },
    "authority_effect": {
      "const": "none"
    },
    "application_authorized": {
      "const": false
    }
  },
  "required": [
    "schema",
    "writers",
    "store_kind",
    "scope",
    "authority_effect",
    "application_authorized"
  ],
  "additionalProperties": false
}
