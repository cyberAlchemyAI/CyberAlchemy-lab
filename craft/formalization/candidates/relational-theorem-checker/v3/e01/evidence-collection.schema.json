{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "relational.evidence-collection/v1",
  "$defs": {
    "ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "frame": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "context": {
          "$ref": "#/$defs/ref"
        },
        "subject": {
          "$ref": "#/$defs/ref"
        },
        "target": {
          "$ref": "#/$defs/ref"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        }
      },
      "required": [
        "profile",
        "context",
        "subject",
        "target",
        "scope",
        "epoch"
      ],
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "evidence_ref": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_identity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "token",
        "source_identity"
      ],
      "additionalProperties": false
    },
    "assessment": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "mode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "subject": {
          "$ref": "#/$defs/ref"
        },
        "target": {
          "$ref": "#/$defs/ref"
        },
        "scope": {
          "type": "string",
          "maxLength": 256
        },
        "role": {
          "type": "string"
        },
        "output_digest": {
          "type": "string"
        },
        "accepted": {
          "type": "boolean"
        }
      },
      "required": [
        "ref",
        "mode",
        "subject",
        "target",
        "scope",
        "role",
        "output_digest",
        "accepted"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "relational.evidence-collection-result/v1"
        },
        "profile": {
          "enum": [
            "evidence-collection-v1",
            "legacy-single-token-adapter-v1"
          ]
        },
        "policy": {
          "const": "any-current-accepted-exact-match; all-valid-supports-in-source-order"
        },
        "frame": {
          "$ref": "#/$defs/frame"
        },
        "source_identity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_assertion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        },
        "conforms": {
          "type": "boolean"
        },
        "supports": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/assessment"
          }
        },
        "roots_before": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "roots_after": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "claim_scope": {
          "const": "Exact selected source assertion/evidence-collection projection; no whole graph qualification or external assessment truth."
        },
        "authority_effect": {
          "const": "none"
        },
        "application_authorized": {
          "const": false
        }
      },
      "required": [
        "schema",
        "profile",
        "policy",
        "frame",
        "source_identity",
        "source_assertion",
        "references",
        "conforms",
        "supports",
        "roots_before",
        "roots_after",
        "claim_scope",
        "authority_effect",
        "application_authorized"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schema": {
      "const": "relational.evidence-collection-request/v1"
    },
    "profile": {
      "enum": [
        "evidence-collection-v1",
        "legacy-single-token-adapter-v1"
      ]
    },
    "source": {
      "$ref": "#/$defs/file"
    },
    "source_assertion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "frame": {
      "$ref": "#/$defs/frame"
    },
    "references": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/evidence_ref"
      }
    },
    "legacy_token": {
      "type": "string",
      "maxLength": 256
    }
  },
  "required": [
    "schema",
    "profile",
    "source",
    "source_assertion",
    "frame",
    "references",
    "legacy_token"
  ],
  "additionalProperties": false
}
