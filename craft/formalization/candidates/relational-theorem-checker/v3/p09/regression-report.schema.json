{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:relational:v3:regression-report",
  "type": "object",
  "properties": {
    "result": {
      "const": "pass"
    },
    "suite": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "const": "pass"
          },
          "evidence_kind": {
            "enum": [
              "fresh-kernel",
              "saved-inspection",
              "decoder",
              "boundary",
              "contract",
              "inherited-control",
              "abstract-theorem",
              "unqualified-io"
            ]
          }
        },
        "required": [
          "name",
          "result",
          "evidence_kind"
        ],
        "additionalProperties": false
      }
    },
    "catalog_audits": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "layout": {
            "enum": [
              "combined",
              "staged"
            ]
          },
          "evidence": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "required_statement": {
            "const": "Successor.Runtime.Catalog.RequiredGeneralBundle"
          },
          "statement_mode": {
            "type": "string",
            "minLength": 1
          },
          "transitive_axioms": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "propext",
                "Classical.choice",
                "Quot.sound"
              ]
            }
          }
        },
        "required": [
          "layout",
          "evidence",
          "required_statement",
          "statement_mode",
          "transitive_axioms"
        ],
        "additionalProperties": false
      }
    },
    "selected_successful_fresh_horn_qualifications": {
      "type": "integer",
      "minimum": 0
    },
    "successful_layout_horn_qualifications": {
      "const": 12
    },
    "selected_successful_applications": {
      "const": 4
    },
    "new_fresh_mapped_qualifications": {
      "const": 1
    },
    "inherited_unique_controls": {
      "const": 342
    },
    "new_control_cases": {
      "type": "integer",
      "minimum": 0
    },
    "actual_rich_combined_status": {
      "enum": [
        "qualified-candidate",
        "unknown-resource"
      ]
    },
    "retained_staged_deadline_refusal": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "saved_or_schema_validation_does_not_issue_live_event": {
      "const": true
    },
    "measured_profile_only": {
      "const": true
    },
    "author_review": {
      "type": "string",
      "minLength": 1
    },
    "authority_effect": {
      "const": "none"
    }
  },
  "required": [
    "result",
    "suite",
    "controls",
    "catalog_audits",
    "selected_successful_fresh_horn_qualifications",
    "successful_layout_horn_qualifications",
    "selected_successful_applications",
    "new_fresh_mapped_qualifications",
    "inherited_unique_controls",
    "new_control_cases",
    "actual_rich_combined_status",
    "retained_staged_deadline_refusal",
    "saved_or_schema_validation_does_not_issue_live_event",
    "measured_profile_only",
    "author_review",
    "authority_effect"
  ],
  "additionalProperties": false
}
