{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "relational.profile/v2"
    },
    "id": {
      "const": "rich-positive-recursive-v2"
    },
    "model_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sealed_meanings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supported_changes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "catalog_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "trusted_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "toolchain": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "reference_policy": {
      "const": "immutable-reference-content-kind"
    },
    "authority_effect": {
      "const": "none"
    }
  },
  "required": [
    "schema",
    "id",
    "model_classes",
    "sealed_meanings",
    "supported_changes",
    "catalog_identity",
    "trusted_bindings",
    "toolchain",
    "reference_policy",
    "authority_effect"
  ],
  "additionalProperties": false
}
