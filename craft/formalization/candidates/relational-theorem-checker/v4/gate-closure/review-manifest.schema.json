{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "relational.gate-review-manifest/v4",
  "$defs": {
    "binding": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "relational.gate-review-manifest/v4"
        },
        "gate": {
          "const": "R06"
        },
        "scope": {
          "const": "original-v1-pilot-meaning-diagnostics"
        },
        "base_plan": {
          "$ref": "#/$defs/binding"
        },
        "artifacts": {
          "type": "object",
          "properties": {
            "packet": {
              "$ref": "#/$defs/binding"
            },
            "matrix": {
              "$ref": "#/$defs/binding"
            },
            "pilot": {
              "$ref": "#/$defs/binding"
            },
            "audit": {
              "$ref": "#/$defs/binding"
            }
          },
          "required": [
            "packet",
            "matrix",
            "pilot",
            "audit"
          ],
          "additionalProperties": false
        },
        "source_audit": {
          "$ref": "#/$defs/binding"
        },
        "implementation_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          },
          "minItems": 1
        },
        "authority_effect": {
          "const": "none"
        },
        "application_authorized": {
          "const": false
        }
      },
      "required": [
        "schema",
        "gate",
        "scope",
        "base_plan",
        "artifacts",
        "source_audit",
        "implementation_bindings",
        "authority_effect",
        "application_authorized"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "relational.gate-review-manifest/v4"
        },
        "gate": {
          "const": "G4"
        },
        "scope": {
          "const": "original-v1-l4-bounded-use"
        },
        "base_plan": {
          "$ref": "#/$defs/binding"
        },
        "artifacts": {
          "type": "object",
          "properties": {
            "packet": {
              "$ref": "#/$defs/binding"
            },
            "matrix": {
              "$ref": "#/$defs/binding"
            },
            "alignment": {
              "$ref": "#/$defs/binding"
            },
            "recommendation": {
              "$ref": "#/$defs/binding"
            }
          },
          "required": [
            "packet",
            "matrix",
            "alignment",
            "recommendation"
          ],
          "additionalProperties": false
        },
        "source_audit": {
          "$ref": "#/$defs/binding"
        },
        "implementation_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          },
          "minItems": 1
        },
        "authority_effect": {
          "const": "none"
        },
        "application_authorized": {
          "const": false
        }
      },
      "required": [
        "schema",
        "gate",
        "scope",
        "base_plan",
        "artifacts",
        "source_audit",
        "implementation_bindings",
        "authority_effect",
        "application_authorized"
      ],
      "additionalProperties": false
    }
  ]
}
