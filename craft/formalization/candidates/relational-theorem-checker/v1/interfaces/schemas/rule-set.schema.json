{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/relational-checker/v1/rule-set.schema.json",
  "title": "Rule Set",
  "description": "Rule declarations use variable/constant terms; head variables must occur in the body.",
  "x-layer": "L3",
  "x-status": "candidate-interface",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "relational-checker.rule-set/v1-candidate"
    },
    "rule_set_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "head": {
            "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/atom"
          },
          "body": {
            "type": "array",
            "items": {
              "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/atom"
            },
            "minItems": 1
          }
        },
        "required": [
          "rule_id",
          "version",
          "head",
          "body"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "rule_set_id",
    "profile_ref",
    "rules"
  ]
}
