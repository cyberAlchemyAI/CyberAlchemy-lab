{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/relational-checker/v1/graph.schema.json",
  "title": "Graph",
  "description": "Finite identified graph. Identity uniqueness and endpoint referential integrity are contract obligations.",
  "x-layer": "L0",
  "x-status": "candidate-interface",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "relational-checker.graph/v1-candidate"
    },
    "graph_id": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/node-ref"
      },
      "minItems": 1
    },
    "assertions": {
      "type": "array",
      "items": {
        "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/relation-assertion.schema.json"
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "graph_id",
    "nodes",
    "assertions"
  ]
}
