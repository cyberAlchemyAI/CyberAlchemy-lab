{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/relational-checker/v1/compatibility-report.schema.json",
  "title": "Compatibility Report",
  "description": "Selected-data compatibility, invariant preservation and model conservativity are independent claims.",
  "x-layer": "L2",
  "x-status": "candidate-interface",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "relational-checker.compatibility-report/v1-candidate"
    },
    "proposal_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "selected_data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "enum": [
            "satisfied",
            "violated",
            "unknown",
            "unsupported",
            "not-required"
          ]
        },
        "scope_ref": {
          "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "verdict",
        "scope_ref",
        "evidence_refs"
      ]
    },
    "invariant_preservation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "enum": [
            "satisfied",
            "violated",
            "unknown",
            "unsupported",
            "not-required"
          ]
        },
        "scope_ref": {
          "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "verdict",
        "scope_ref",
        "evidence_refs"
      ]
    },
    "model_conservativity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "enum": [
            "satisfied",
            "violated",
            "unknown",
            "unsupported",
            "not-required"
          ]
        },
        "scope_ref": {
          "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "verdict",
        "scope_ref",
        "evidence_refs"
      ]
    },
    "rule_obligations_pending": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/diagnostic"
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "proposal_ref",
    "selected_data",
    "invariant_preservation",
    "model_conservativity",
    "rule_obligations_pending",
    "diagnostics"
  ]
}
