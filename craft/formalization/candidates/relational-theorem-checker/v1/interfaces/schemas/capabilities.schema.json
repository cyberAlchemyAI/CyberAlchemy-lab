{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/relational-checker/v1/capabilities.schema.json",
  "title": "Capabilities",
  "description": "Explicit supported profiles and actually available execution engines; this package starts no engine.",
  "x-layer": "L4",
  "x-status": "candidate-interface",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "relational-checker.capabilities/v1-candidate"
    },
    "package_version": {
      "const": "v1-candidate"
    },
    "schema_dialect": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "profile_id": {
            "type": "string",
            "minLength": 1
          },
          "profile_ref": {
            "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
          },
          "state": {
            "enum": [
              "contract-only",
              "available",
              "unsupported"
            ]
          }
        },
        "required": [
          "profile_id",
          "profile_ref",
          "state"
        ]
      },
      "minItems": 1
    },
    "engines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "engine_id": {
            "type": "string",
            "minLength": 1
          },
          "availability": {
            "enum": [
              "not-implemented",
              "available",
              "unavailable"
            ]
          }
        },
        "required": [
          "engine_id",
          "availability"
        ]
      },
      "minItems": 1
    },
    "authority_effect": {
      "const": "none"
    }
  },
  "required": [
    "schema_version",
    "package_version",
    "schema_dialect",
    "profiles",
    "engines",
    "authority_effect"
  ]
}
