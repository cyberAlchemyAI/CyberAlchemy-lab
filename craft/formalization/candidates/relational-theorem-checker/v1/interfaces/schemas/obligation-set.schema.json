{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/relational-checker/v1/obligation-set.schema.json",
  "title": "Obligation Set",
  "description": "Complete required set generated from actual diff and selected policy; client-submitted subsets are not authoritative.",
  "x-layer": "L2",
  "x-status": "candidate-interface",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "relational-checker.obligation-set/v1-candidate"
    },
    "set_id": {
      "type": "string",
      "minLength": 1
    },
    "proposal_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "diff_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "policy_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "obligations": {
      "type": "array",
      "items": {
        "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/obligation.schema.json"
      },
      "minItems": 1
    },
    "coverage_statement_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    }
  },
  "required": [
    "schema_version",
    "set_id",
    "proposal_ref",
    "diff_ref",
    "policy_ref",
    "obligations",
    "coverage_statement_ref"
  ]
}
