{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/relational-checker/v1/relation-kind.schema.json",
  "title": "Relation Kind",
  "description": "Normalized declaration retaining ordered pairs, original qualifier schema and forbidden justifications.",
  "x-layer": "L1",
  "x-status": "candidate-interface",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "relational-checker.relation-kind/v1-candidate"
    },
    "kind_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "source_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "source_binding": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/source-binding"
    },
    "axis_id": {
      "type": "string",
      "minLength": 1
    },
    "allowed_endpoint_pairs": {
      "type": "array",
      "items": {
        "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/pair"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "qualifier_schema": {
      "type": "object",
      "description": "A Draft 2020-12 schema; validate against the meta-schema separately."
    },
    "forbidden_inferences": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "source_lifecycle": {
      "type": "string",
      "minLength": 1
    },
    "effective_lifecycle": {
      "type": "string",
      "minLength": 1
    },
    "semantic_state": {
      "enum": [
        "imported",
        "defined",
        "proved",
        "unsupported"
      ]
    },
    "prose_semantics": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "kind_id",
    "version",
    "source_ref",
    "source_binding",
    "axis_id",
    "allowed_endpoint_pairs",
    "qualifier_schema",
    "forbidden_inferences",
    "source_lifecycle",
    "effective_lifecycle",
    "semantic_state",
    "prose_semantics"
  ]
}
