{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/relational-checker/v1/obligation.schema.json",
  "title": "Obligation",
  "description": "An independently required statement with exact premises, scope and permitted evidence methods.",
  "x-layer": "L2",
  "x-status": "candidate-interface",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "relational-checker.obligation/v1-candidate"
    },
    "obligation_id": {
      "type": "string",
      "minLength": 1
    },
    "layer": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4"
      ]
    },
    "family": {
      "enum": [
        "signature-validity",
        "qualifier-validity",
        "reference-validity",
        "graph-invariant",
        "checker-soundness",
        "projection-fidelity",
        "obligation-coverage",
        "selected-data-compatibility",
        "invariant-preservation",
        "inhabitation",
        "model-conservativity",
        "derivation-soundness",
        "closure-adequacy",
        "protected-lineage",
        "non-entailment",
        "proof-submission-audit",
        "freshness"
      ]
    },
    "hard": {
      "type": "boolean"
    },
    "required_statement_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "required_dependency_refs": {
      "type": "array",
      "items": {
        "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "scope_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "generated_by_policy_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "permitted_evidence_methods": {
      "type": "array",
      "items": {
        "enum": [
          "verified-checker",
          "kernel-proof",
          "checked-model-witness"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "requirement_source_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    }
  },
  "required": [
    "schema_version",
    "obligation_id",
    "layer",
    "family",
    "hard",
    "required_statement_ref",
    "required_dependency_refs",
    "scope_ref",
    "generated_by_policy_ref",
    "permitted_evidence_methods",
    "requirement_source_ref"
  ]
}
