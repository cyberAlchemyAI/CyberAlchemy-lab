{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/relational-checker/v1/reference-assessment.schema.json",
  "title": "Reference Assessment",
  "description": "Resolution assessment does not upgrade an arbitrary qualifier string into authenticated authority.",
  "x-layer": "L1",
  "x-status": "candidate-interface",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "relational-checker.reference-assessment/v1-candidate"
    },
    "assertion_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "qualifier_name": {
      "type": "string",
      "minLength": 1
    },
    "raw_value": {
      "type": "string",
      "minLength": 1
    },
    "expected_kind": {
      "type": "string",
      "minLength": 1
    },
    "expected_version": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "resolved_ref": {
      "anyOf": [
        {
          "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "verdict": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/verdict"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/diagnostic"
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "assertion_ref",
    "qualifier_name",
    "raw_value",
    "expected_kind",
    "expected_version",
    "scope",
    "resolved_ref",
    "verdict",
    "diagnostics"
  ]
}
