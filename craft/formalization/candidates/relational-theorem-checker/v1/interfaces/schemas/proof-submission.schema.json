{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/relational-checker/v1/proof-submission.schema.json",
  "title": "Proof Submission",
  "description": "Untrusted proof submission; matching metadata does not itself prove its required statement.",
  "x-layer": "L4",
  "x-status": "candidate-interface",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "relational-checker.proof-submission/v1-candidate"
    },
    "submission_id": {
      "type": "string",
      "minLength": 1
    },
    "obligation_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "required_statement_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "proof_artifact_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "dependency_refs": {
      "type": "array",
      "items": {
        "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "toolchain_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "policy_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    }
  },
  "required": [
    "schema_version",
    "submission_id",
    "obligation_ref",
    "required_statement_ref",
    "proof_artifact_ref",
    "dependency_refs",
    "toolchain_ref",
    "policy_ref"
  ]
}
