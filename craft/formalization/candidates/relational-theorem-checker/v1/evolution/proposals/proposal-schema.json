{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/relational-extension-proposal/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "proposal_id",
    "baseline_identity",
    "before",
    "after"
  ],
  "properties": {
    "schema": {
      "const": "relational.extension-proposal/v1"
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1
    },
    "baseline_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "before": {
      "$ref": "#/$defs/snapshot"
    },
    "after": {
      "$ref": "#/$defs/snapshot"
    }
  },
  "$defs": {
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry",
        "rules",
        "graph"
      ],
      "properties": {
        "registry": {
          "type": "object"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "graph": {
          "type": "object"
        }
      }
    }
  }
}
