def added : List Kind := []
def expanded : Theory := Models.expandedTheory Snapshot.captured added
theorem added_valid : ∀ k ∈ added, KindValid Snapshot.captured.nodeKinds k := by decide
theorem expanded_valid : TheoryValid expanded := by
  refine ⟨Snapshot.valid_snapshot.1, Snapshot.valid_snapshot.2.1, by decide, ?_⟩
  intro k hk
  change k ∈ Snapshot.captured.kinds ++ added at hk
  rcases List.mem_append.mp hk with old | fresh
  · exact Snapshot.valid_snapshot.2.2.2 k old
  · exact added_valid k fresh
def extension : Evolution.FreshExtension Snapshot.captured expanded := { added := added, nodes_equal := rfl, kinds_append := rfl, fresh_ids := by decide, base_valid := Snapshot.valid_snapshot, expanded_valid := expanded_valid }
theorem actual_preservation : ∀ graph, Evolution.OldLanguage Snapshot.captured graph → (Inv expanded graph ↔ Inv Snapshot.captured graph) := Evolution.preserves_old_language extension
theorem actual_conservativity : ∀ model, Inv Snapshot.captured model → ∃ expansion, Inv expanded expansion ∧ Models.oldReduct Snapshot.captured expansion = model := Models.expands_every_base_model Snapshot.captured added expanded_valid
