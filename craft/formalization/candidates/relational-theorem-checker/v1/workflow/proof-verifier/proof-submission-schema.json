{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/relational-proof-submission/v1-candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "proposal_identity",
    "obligation_id",
    "required_statement",
    "statement_identity",
    "policy_identity",
    "theorem_id",
    "proof",
    "dependencies"
  ],
  "properties": {
    "schema": {
      "const": "relational.proof-submission/v1-candidate"
    },
    "proposal_identity": {
      "type": "string",
      "minLength": 1
    },
    "obligation_id": {
      "type": "string",
      "minLength": 1
    },
    "required_statement": {
      "type": "string",
      "minLength": 1
    },
    "statement_identity": {
      "type": "string",
      "minLength": 1
    },
    "policy_identity": {
      "type": "string",
      "minLength": 1
    },
    "theorem_id": {
      "type": "string",
      "minLength": 1
    },
    "proof": {
      "$ref": "#/$defs/binding"
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "proposal_identity",
        "baseline_identity",
        "baseline_dependency_identity",
        "policy_identity",
        "trusted_source_bindings",
        "host_runtime",
        "generated_fixture_sha256",
        "authority_effect",
        "dependency_identity"
      ],
      "properties": {
        "schema": {
          "type": "string"
        },
        "proposal_identity": {
          "type": "string"
        },
        "baseline_identity": {
          "type": "string"
        },
        "baseline_dependency_identity": {
          "type": "string"
        },
        "policy_identity": {
          "type": "string"
        },
        "dependency_identity": {
          "type": "string"
        },
        "trusted_source_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "host_runtime": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "absolute_path",
              "sha256"
            ],
            "properties": {
              "absolute_path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "generated_fixture_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "authority_effect": {
          "const": "none"
        }
      }
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "$comment": "Transport shape only. Proof truth and complete dependencies require the independent verifier."
}
