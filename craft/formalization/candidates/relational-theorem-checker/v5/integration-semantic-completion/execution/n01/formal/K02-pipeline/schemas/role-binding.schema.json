{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/candidates/relational-theorem-checker/v5/role-binding",
  "description": "Non-admitted candidate binding record; syntax validity establishes no authenticity or authority. Original bytes and digest are captured outside this record.",
  "$defs": {
    "revisionKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "artifact",
        "revision"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "revisionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "digest"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/revisionKey"
        },
        "digest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "subject",
        "target",
        "context",
        "scope",
        "snapshot",
        "epoch",
        "timeDomain"
      ],
      "properties": {
        "profile": {
          "$ref": "#/$defs/revisionRef"
        },
        "subject": {
          "$ref": "#/$defs/revisionRef"
        },
        "target": {
          "$ref": "#/$defs/revisionRef"
        },
        "context": {
          "$ref": "#/$defs/revisionRef"
        },
        "scope": {
          "$ref": "#/$defs/revisionRef"
        },
        "snapshot": {
          "$ref": "#/$defs/revisionRef"
        },
        "epoch": {
          "type": "integer",
          "minimum": 0
        },
        "timeDomain": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "code",
        "subjectKind"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/revisionRef"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "subjectKind": {
          "enum": [
            "agent-assignment",
            "goal",
            "product",
            "product-capability",
            "project",
            "research-inquiry",
            "other"
          ]
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binding_revision_key",
    "kind",
    "body",
    "owner_review_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "cyberalchemy-lab-intent-addressing-role-binding/candidate-v1"
    },
    "binding_revision_key": {
      "$ref": "#/$defs/revisionKey"
    },
    "kind": {
      "const": "intent-addressing-role-binding"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token",
        "target",
        "frame"
      ],
      "properties": {
        "token": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "frame": {
          "$ref": "#/$defs/frame"
        }
      }
    },
    "owner_review_ref": {
      "$ref": "#/$defs/revisionRef"
    }
  }
}
