{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cyberalchemy-lab:bounded-evidence-resource-configuration:candidate-v1",
  "title": "Candidate bounded evidence resource configuration (decoded-value shape only)",
  "type": "object",
  "additionalProperties": false,
  "required": ["captureLimits", "numericLimits"],
  "properties": {
    "captureLimits": {
      "type": "object", "additionalProperties": false,
      "required": ["perCaptureBytes", "totalBytes", "maxCaptures"],
      "properties": {"perCaptureBytes": {"$ref": "#/$defs/nat"}, "totalBytes": {"$ref": "#/$defs/nat"}, "maxCaptures": {"$ref": "#/$defs/nat"}}
    },
    "numericLimits": {
      "type": "object", "additionalProperties": false,
      "required": ["maxTokenCharacters", "maxMantissaDigits", "maxExponentDigits", "maxExponentMagnitude"],
      "properties": {"maxTokenCharacters": {"$ref": "#/$defs/nat"}, "maxMantissaDigits": {"$ref": "#/$defs/nat"}, "maxExponentDigits": {"$ref": "#/$defs/nat"}, "maxExponentMagnitude": {"$ref": "#/$defs/nat"}}
    }
  },
  "$defs": {"nat": {"type": "integer", "minimum": 0}},
  "$comment": "Zero is a legitimate configured bound. This shape is not a raw JSON/Nat decoder, an authentic profile selection, a measured operational policy, or a proof of memory/time bounds. Arbitrarily large configuration values can permit expensive work."
}
