{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cyberalchemy:lab:candidate:digest-profile-declaration:v1",
  "title": "Candidate digest profile declaration",
  "description": "Decoded-value source shape only. Full byte grammar, exact frame, eligibility, digest, selected profile support and authentic ownership require separate checks.",
  "$defs": {
    "revisionKey": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "owner",
        "artifact",
        "revision"
      ],
      "additionalProperties": false
    },
    "revisionRef": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/revisionKey"
        },
        "digest": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "key",
        "digest"
      ],
      "additionalProperties": false
    },
    "frame": {
      "type": "object",
      "properties": {
        "profile": {
          "$ref": "#/$defs/revisionRef"
        },
        "subject": {
          "$ref": "#/$defs/revisionRef"
        },
        "target": {
          "$ref": "#/$defs/revisionRef"
        },
        "context": {
          "$ref": "#/$defs/revisionRef"
        },
        "scope": {
          "$ref": "#/$defs/revisionRef"
        },
        "snapshot": {
          "$ref": "#/$defs/revisionRef"
        },
        "epoch": {
          "type": "integer",
          "minimum": 0
        },
        "timeDomain": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "profile",
        "subject",
        "target",
        "context",
        "scope",
        "snapshot",
        "epoch",
        "timeDomain"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "cyberalchemy-lab-digest-profile-declaration/candidate-v1"
    },
    "binding_revision_key": {
      "$ref": "#/$defs/revisionKey"
    },
    "kind": {
      "const": "digest-profile-declaration"
    },
    "body": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "object",
          "properties": {
            "algorithm": {
              "type": "string",
              "minLength": 1
            },
            "encoding": {
              "type": "string",
              "minLength": 1
            },
            "issuer": {
              "$ref": "#/$defs/revisionRef"
            },
            "review_posture": {
              "enum": [
                "missing",
                "accepted",
                "rejected"
              ]
            },
            "revocation_posture": {
              "enum": [
                "unknown",
                "clear",
                "revoked"
              ]
            },
            "expiry_epoch": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "algorithm",
            "encoding",
            "issuer",
            "review_posture",
            "revocation_posture",
            "expiry_epoch"
          ],
          "additionalProperties": false
        },
        "frame": {
          "$ref": "#/$defs/frame"
        }
      },
      "required": [
        "token",
        "target",
        "frame"
      ],
      "additionalProperties": false
    },
    "owner_review_ref": {
      "$ref": "#/$defs/revisionRef"
    }
  },
  "required": [
    "schema_version",
    "binding_revision_key",
    "kind",
    "body",
    "owner_review_ref"
  ],
  "additionalProperties": false
}
