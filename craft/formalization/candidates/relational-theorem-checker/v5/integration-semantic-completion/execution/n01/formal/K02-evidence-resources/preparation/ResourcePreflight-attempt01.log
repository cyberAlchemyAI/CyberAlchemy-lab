case cons
profile : Profile
budget : Nat
numbers : NumericLimits
capture : Envelope
reason : PreflightOutcome
first : Envelope
rest : List Envelope
ih :
  ∀ (index : Nat),
    firstSourceRefusal profile budget numbers rest = some (index, capture, reason) →
      capture ∈ rest ∧ classifyPreflight profile budget numbers capture = reason ∧ reason ≠ PreflightOutcome.ready
index : Nat
found :
  (have outcome := classifyPreflight profile budget numbers first;
    if outcome = PreflightOutcome.ready then
      Option.map (fun row => (row.fst + 1, row.snd)) (firstSourceRefusal profile budget numbers rest)
    else some (0, first, outcome)) =
    some (index, capture, reason)
