def witnessHolds (witness : ApplicableObligationWitness) : Bool :=
  match projectEdges.find? (fun edge => edge.edgeId == witness.edgeId) with
  | some edge => (signature edge.relation).obligations.contains witness.obligation && obligationHolds projectEdges witness.obligation edge
  | none => false
theorem allApplicableWitnessesHold : ∀ witness ∈ applicableWitnesses, witnessHolds witness = true := by decide

