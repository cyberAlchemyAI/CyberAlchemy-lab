{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domainspec://schemas/product-ontology-package/v1",
  "title": "DomainSpec product ontology package record shapes",
  "$defs": {
    "stable_id": {"type":"string","pattern":"^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"},
    "sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "source": {
      "type":"object",
      "additionalProperties":false,
      "required":["source_id","path","sha256","branch","role","authority_effect"],
      "properties":{
        "source_id":{"$ref":"#/$defs/stable_id"},
        "path":{"type":"string","minLength":1},
        "sha256":{"$ref":"#/$defs/sha256"},
        "branch":{"enum":["business","system","mixed"]},
        "role":{"type":"string","minLength":1},
        "authority_effect":{"type":"string","minLength":1}
      }
    },
    "node": {
      "type":"object",
      "additionalProperties":false,
      "required":["node_id","label","branch","role","status","source_refs","summary","forbidden_inference"],
      "properties":{
        "node_id":{"$ref":"#/$defs/stable_id"},
        "label":{"type":"string","minLength":1},
        "branch":{"enum":["business","system"]},
        "role":{"type":"string","minLength":1},
        "status":{"enum":["canonical","implemented","evidence-bound","designed"]},
        "source_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/stable_id"}},
        "summary":{"type":"string","minLength":1},
        "forbidden_inference":{"type":"string","minLength":1}
      }
    },
    "relation_evidence": {
      "type":"object",
      "additionalProperties":false,
      "required":["business_refs","system_refs"],
      "properties":{
        "business_refs":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/stable_id"}},
        "system_refs":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/stable_id"}}
      }
    },
    "relation": {
      "type":"object",
      "additionalProperties":false,
      "required":["relation_id","type","from","to","branch","evidence","authority_effect","forbidden_inference"],
      "properties":{
        "relation_id":{"$ref":"#/$defs/stable_id"},
        "type":{"enum":["realized_by","depends_on","constrained_by","observed_by","tested_by","drifts_from","traced_to"]},
        "from":{"$ref":"#/$defs/stable_id"},
        "to":{"$ref":"#/$defs/stable_id"},
        "branch":{"enum":["business","bridge","system"]},
        "evidence":{"$ref":"#/$defs/relation_evidence"},
        "authority_effect":{"type":"string","minLength":1},
        "forbidden_inference":{"type":"string","minLength":1}
      }
    },
    "residue": {
      "type":"object",
      "additionalProperties":false,
      "required":["residue_id","status","summary","owner_route","source_refs","node_refs","forbidden_inference"],
      "properties":{
        "residue_id":{"$ref":"#/$defs/stable_id"},
        "status":{"const":"open"},
        "summary":{"type":"string","minLength":1},
        "owner_route":{"type":"string","minLength":1},
        "source_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/stable_id"}},
        "node_refs":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/stable_id"}},
        "forbidden_inference":{"type":"string","minLength":1}
      }
    },
    "receipt": {
      "type":"object",
      "additionalProperties":false,
      "required":["schema_version","receipt_id","validated_at","ontology_id","ontology_type","package_digest","source_count","node_count","relation_count","bridge_relation_count","residue_count","checks","result","authority_effect"],
      "properties":{
        "schema_version":{"const":"domainspec.product-ontology-validation-receipt/v1"},
        "receipt_id":{"$ref":"#/$defs/stable_id"},
        "validated_at":{"type":"string","format":"date-time"},
        "ontology_id":{"const":"domainspec-product-ontology@1"},
        "ontology_type":{"const":"business-system-bridge"},
        "package_digest":{"$ref":"#/$defs/sha256"},
        "source_count":{"type":"integer","minimum":1},
        "node_count":{"type":"integer","minimum":1},
        "relation_count":{"type":"integer","minimum":1},
        "bridge_relation_count":{"type":"integer","minimum":1},
        "residue_count":{"type":"integer","minimum":0},
        "checks":{"type":"integer","minimum":1},
        "result":{"const":"pass"},
        "authority_effect":{"const":"none"}
      }
    }
  }
}
