{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:domainspec-v2:bte:authority-class:v1",
  "title": "BTE Authority Class v1",
  "description": "A closed authority role bound to one versioned owner identity and digest.",
  "type": "object",
  "required": ["schema_version", "class", "owner", "owner_digest"],
  "properties": {
    "schema_version": { "const": "bte-authority-class/v1" },
    "class": { "enum": ["semantic", "admission", "evidence", "aggregate", "lifecycle"] },
    "owner": { "$ref": "urn:domainspec-v2:bte:logical-identity:v1" },
    "owner_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}

