{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:domainspec-v2:bte:contract-publication-receipt:v1",
  "title": "BTE Contract Publication Receipt v1",
  "description": "A deterministic index of the L0A contract bytes, dialect, keyword policy, and diagnostic registry.",
  "type": "object",
  "required": ["schema_version", "receipt_kind", "receipt_id", "dialect", "supported_keywords", "contracts", "diagnostics_registry", "admission"],
  "properties": {
    "schema_version": { "const": "bte-contract-publication-receipt/v1" },
    "receipt_kind": { "const": "contract-publication" },
    "receipt_id": { "$ref": "urn:domainspec-v2:bte:logical-identity:v1" },
    "dialect": { "const": "https://json-schema.org/draft/2020-12/schema" },
    "supported_keywords": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "urn:domainspec-v2:bte:artifact-handle:v1" }
    },
    "diagnostics_registry": { "$ref": "urn:domainspec-v2:bte:artifact-handle:v1" },
    "admission": { "const": "not-granted" }
  },
  "additionalProperties": false
}
