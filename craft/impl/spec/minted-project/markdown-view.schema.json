{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/minted-project/markdown-view/v1",
  "title": "Minted Markdown View Receipt",
  "description": "Generated human-view record proving SPEC.md was derived from one normalized graph.",
  "type": "object",
  "required": ["schema_version", "authority", "output_path", "graph_digest", "content_digest", "generator_version"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "minted-markdown-view/v1"},
    "authority": {"const": "generated-human-read-model"},
    "output_path": {"const": "SPEC.md"},
    "graph_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "content_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "generator_version": {"type": "string", "minLength": 1}
  },
  "x-domainspec": {"record": "markdown-view", "role": "generated", "authority": "generated-human-read-model", "version": "minted-markdown-view/v1"}
}
