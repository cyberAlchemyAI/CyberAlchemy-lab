{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domainspec.stable-foundation-cli.source-manifest/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "source_count", "total_size_bytes", "sources", "aggregate_sha256", "authority_effect", "manifest_sha256"],
  "properties": {
    "schema_version": {"const": "domainspec.stable-foundation-cli.source-manifest/v1"},
    "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "source_count": {"type": "integer", "minimum": 1},
    "total_size_bytes": {"type": "integer", "minimum": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_type", "source_id", "feature_id", "relative_path", "size_bytes", "sha256"],
        "properties": {
          "source_type": {"enum": ["project", "feature", "node", "feature-edge", "project-edge"]},
          "source_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?::[a-z][a-z0-9]*(?:-[a-z0-9]+)*)?$"},
          "feature_id": {
            "oneOf": [
              {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
              {"type": "null"}
            ]
          },
          "relative_path": {
            "type": "string",
            "pattern": "^(?:project\\.json|edges/[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.json|specs/[a-z][a-z0-9]*(?:-[a-z0-9]+)*/(?:feature\\.json|(?:nodes|edges)/[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.json))$"
          },
          "size_bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "aggregate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority_effect": {"const": "none"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
