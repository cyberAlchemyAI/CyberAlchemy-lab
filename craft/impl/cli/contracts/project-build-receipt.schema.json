{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/contracts/project-build-receipt.schema.json",
  "title": "DomainSpec whole-project build receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "language", "source_manifest_sha256", "compiled_certificate", "formalization_projection_sha256", "node_selectors", "artifacts", "authority_effect", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "domainspec.project-build-receipt/v1"},
    "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "language": {"enum": ["typescript", "python", "rust"]},
    "source_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "compiled_certificate": {"$ref": "compiled-project-certificate.schema.json"},
    "formalization_projection_sha256": {"$ref": "#/$defs/sha256"},
    "node_selectors": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"}, "uniqueItems": true},
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "authority_effect": {"const": "none"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["relative_path", "size_bytes", "sha256"],
      "properties": {"relative_path": {"type": "string", "pattern": "^src/domainspec/(?:typescript|python|rust)/[a-z][a-z0-9-]*/[a-z][a-z0-9-]*\\.(?:ts|py|rs)$"}, "size_bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    }
  }
}
