{
  "schema_version": "domainspec.node/v1",
  "node_id": "settlement-status",
  "feature_id": "beta",
  "kind": "State Machine",
  "body": {
    "description": "The exact lifecycle of a fixture settlement.",
    "states": ["pending", "settled", "failed"],
    "initial": "pending",
    "transitions": [
      {
        "transition_id": "complete-settlement",
        "source_state": "pending",
        "target_state": "settled",
        "guard_ref": "beta:can-complete-settlement",
        "effect_event_ref": "beta:settlement-completed"
      },
      {
        "transition_id": "fail-settlement",
        "source_state": "pending",
        "target_state": "failed",
        "guard_ref": null,
        "effect_event_ref": null
      }
    ]
  }
}
