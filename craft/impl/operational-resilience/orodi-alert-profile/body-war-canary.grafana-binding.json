{
  "schema_version": "cav2.orodi.alert-profile.grafana-binding/v1-candidate",
  "binding_id": "orodi-body-war-canary-grafana-local-evaluation",
  "platform": "grafana-file-provisioning",
  "platform_version": "12.2.0",
  "org_id": 1,
  "folder": "ORODI",
  "group_name": "ORODI local evidence alerts",
  "evaluation_interval": "10s",
  "datasource_uid": "orodi-prometheus",
  "query_interval_ms": 2000,
  "max_data_points": 43200,
  "notification_suppression": {
    "mode": "always-muted-container-loopback",
    "mute_interval": "orodi-local-evaluation-only",
    "receiver": "ORODI disabled local sink",
    "receiver_uid": "orodi-disabled-local-sink",
    "sink": "http://127.0.0.1:9/orodi-disabled"
  },
  "external_delivery": "disabled",
  "authority_effect": "none"
}
