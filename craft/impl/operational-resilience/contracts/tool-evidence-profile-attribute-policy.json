{
  "schema_version": "domainspec.orodi.tool-evidence-profile-attribute-policy/v1",
  "policy_id": "domainspec.orodi.tool-evidence-profile-attributes",
  "policy_version": "1.0.0-candidate-local",
  "allowed_normalized_keys": [
    "analysis.window",
    "artifact.digest",
    "correlation.id",
    "deployment.id",
    "environment.id",
    "error.code",
    "fault.id",
    "health.status",
    "metric.name",
    "rollback.id",
    "service.name",
    "subject.id",
    "workload.id"
  ],
  "forbidden_exact_keys": ["authorization", "credential", "password", "secret", "token"],
  "forbidden_prefixes": ["auth.", "credential.", "secret.", "token."],
  "max_key_bytes": 64,
  "max_value_bytes": 256,
  "max_attribute_count": 16,
  "wildcards_allowed": false,
  "authority_effect": "none"
}
