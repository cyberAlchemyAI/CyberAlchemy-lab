{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://domainspec.dev/orodi/body-war-canary-decision-receipt.schema.json",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","run_id","input_sha256","telemetry_completeness","candidate_total","stable_total","candidate_bad_rate","stable_bad_rate","candidate_assessment","decision","outcome","authority_effect"],
  "properties":{
    "schema_version":{"const":"domainspec.orodi.body-war-canary-decision-receipt/v1"},
    "run_id":{"type":"string","minLength":1},
    "input_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "telemetry_completeness":{"enum":["complete","incomplete","invalid"]},
    "candidate_total":{"type":"integer","minimum":0},
    "stable_total":{"type":"integer","minimum":0},
    "candidate_bad_rate":{"type":"number","minimum":0,"maximum":1},
    "stable_bad_rate":{"type":"number","minimum":0,"maximum":1},
    "candidate_assessment":{"enum":["unacceptable","acceptable","inconclusive","invalid"]},
    "decision":{"enum":["rollback","continue","safety-rollback"]},
    "outcome":{"enum":["passed","failed","invalid","inconclusive","blocked"]},
    "authority_effect":{"const":"none"}
  }
}
