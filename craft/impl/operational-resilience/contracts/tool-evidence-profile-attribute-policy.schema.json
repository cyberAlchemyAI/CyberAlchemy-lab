{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:domainspec:orodi:tool-evidence-profile-attribute-policy:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "policy_version", "allowed_normalized_keys", "forbidden_exact_keys", "forbidden_prefixes", "max_key_bytes", "max_value_bytes", "max_attribute_count", "wildcards_allowed", "authority_effect"],
  "properties": {
    "schema_version": {"const": "domainspec.orodi.tool-evidence-profile-attribute-policy/v1"},
    "policy_id": {"const": "domainspec.orodi.tool-evidence-profile-attributes"},
    "policy_version": {"const": "1.0.0-candidate-local"},
    "allowed_normalized_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "forbidden_exact_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "forbidden_prefixes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "max_key_bytes": {"type": "integer", "minimum": 1},
    "max_value_bytes": {"type": "integer", "minimum": 1},
    "max_attribute_count": {"type": "integer", "minimum": 1},
    "wildcards_allowed": {"const": false},
    "authority_effect": {"const": "none"}
  }
}
