{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:domainspec:orodi:tool-evidence-profile-normalization-result:v1",
  "title": "ORODI Candidate-Local Tool Profile Normalization Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "normalizer_id", "normalizer_version", "registry_entry",
    "replay_id", "profile_id", "profile_version", "family_id", "fixture_id",
    "descriptor_sha256", "wp5_result_sha256", "source_sha256",
    "selected_value_sha256", "invalidation_key_digest", "replayed_at", "verdict",
    "observations", "findings", "runtime_admission", "referent_trust", "authority_effect"
  ],
  "properties": {
    "schema_version": {"const": "domainspec.orodi.tool-evidence-profile-normalization-result/v1"},
    "normalizer_id": {"type": "string", "minLength": 1},
    "normalizer_version": {"const": "1.0.0-candidate-local"},
    "registry_entry": {"anyOf": [{"$ref": "#/$defs/registryEntry"}, {"type": "null"}]},
    "replay_id": {"type": "string", "minLength": 1},
    "profile_id": {"type": "string", "minLength": 1},
    "profile_version": {"type": "string", "minLength": 1},
    "family_id": {"$ref": "#/$defs/family"},
    "fixture_id": {"type": "string", "minLength": 1},
    "descriptor_sha256": {"$ref": "#/$defs/sha256"},
    "wp5_result_sha256": {"$ref": "#/$defs/sha256"},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "selected_value_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "invalidation_key_digest": {"$ref": "#/$defs/sha256"},
    "replayed_at": {"type": "string", "format": "date-time"},
    "verdict": {"enum": ["normalized", "rejected"]},
    "observations": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/observation"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "runtime_admission": {"const": "denied"},
    "referent_trust": {"const": "unverified"},
    "authority_effect": {"const": "none"}
  },
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "normalized"}}, "required": ["verdict"]},
      "then": {"properties": {
        "registry_entry": {"$ref": "#/$defs/registryEntry"},
        "selected_value_sha256": {"$ref": "#/$defs/sha256"},
        "observations": {"minItems": 1, "maxItems": 1},
        "findings": {"maxItems": 0}
      }}
    },
    {
      "if": {"properties": {"verdict": {"const": "rejected"}}, "required": ["verdict"]},
      "then": {"properties": {
        "selected_value_sha256": {"type": "null"},
        "observations": {"maxItems": 0},
        "findings": {"minItems": 1}
      }}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "family": {"enum": [
      "telemetry", "health-failure", "workload", "fault", "canary-analysis",
      "deployment-observation", "rollback-observation"
    ]},
    "normalizerReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "version", "sha256"],
      "properties": {
        "ref": {"const": "orodi://normalizer/pure-profile/v1"},
        "version": {"const": "1.0.0"},
        "sha256": {"const": "d6a45d4e99806fca19e5d683d9fc0c7b216f9d57706a87ae5112b32dbabe92ca"}
      }
    },
    "registryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family_id", "normalizer", "normalizer_id", "normalizer_version", "observation_kind"],
      "properties": {
        "family_id": {"$ref": "#/$defs/family"},
        "normalizer": {"$ref": "#/$defs/normalizerReference"},
        "normalizer_id": {"type": "string", "minLength": 1},
        "normalizer_version": {"const": "1.0.0-candidate-local"},
        "observation_kind": {"enum": ["metric", "health", "log"]}
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offered", "queued", "exported", "rejected", "dropped", "pending", "partial_success"],
      "properties": {
        "offered": {"const": 0},
        "queued": {"const": 0},
        "exported": {"const": 0},
        "rejected": {"const": 0},
        "dropped": {"const": 0},
        "pending": {"const": 0},
        "partial_success": {"const": 0}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "observation_id", "plane", "kind", "mode", "correlation_id",
        "attributes", "attribute_allowlist", "cardinality", "telemetry", "deployment_effect",
        "independently_observed", "observed_at", "invalidation_key_digest"
      ],
      "properties": {
        "schema_version": {"const": "domainspec.orodi.observation/v1"},
        "observation_id": {"type": "string", "minLength": 1},
        "plane": {"const": "product"},
        "kind": {"enum": ["metric", "health", "log"]},
        "mode": {"const": "simulation"},
        "correlation_id": {"type": "string", "minLength": 1},
        "attributes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
        "attribute_allowlist": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "cardinality": {"$ref": "#/$defs/cardinality"},
        "telemetry": {"$ref": "#/$defs/telemetry"},
        "deployment_effect": {"const": false},
        "independently_observed": {"const": false},
        "observed_at": {"type": "string", "format": "date-time"},
        "invalidation_key_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "cardinality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed", "budget"],
      "properties": {
        "observed": {"type": "integer", "minimum": 0},
        "budget": {"type": "integer", "minimum": 1}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path", "detail"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
        "path": {"type": "string", "minLength": 1},
        "detail": {"type": "string", "minLength": 1}
      }
    }
  }
}
