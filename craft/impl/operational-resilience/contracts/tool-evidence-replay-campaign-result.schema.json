{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:domainspec:orodi:tool-evidence-replay-campaign-result:v1",
  "title": "ORODI Candidate-Local Offline Replay Campaign Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "composer_id", "composer_version", "evidence_lane", "campaign_id",
    "evaluated_at", "input_manifest_sha256", "item_receipts", "replay_observations",
    "eligibility_receipts", "per_binding_derived_results", "runtime_admitted_observations",
    "eligible_controls", "verdict", "findings", "runtime_admission", "referent_trust",
    "authority_effect"
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "family": {"enum": [
      "telemetry", "health-failure", "workload", "fault", "canary-analysis",
      "deployment-observation", "rollback-observation"
    ]},
    "controlId": {"enum": ["C01", "C05", "C11", "C12", "C14", "C15"]},
    "evidenceState": {"enum": ["passed", "failed", "missing", "invalid", "inconclusive", "stale", "not-run"]},
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path", "detail"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "detail": {"type": "string", "minLength": 1}
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offered", "queued", "exported", "rejected", "dropped", "pending", "partial_success"],
      "properties": {
        "offered": {"const": 0},
        "queued": {"const": 0},
        "exported": {"const": 0},
        "rejected": {"const": 0},
        "dropped": {"const": 0},
        "pending": {"const": 0},
        "partial_success": {"const": 0}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "observation_id", "plane", "kind", "mode", "correlation_id",
        "attributes", "attribute_allowlist", "cardinality", "telemetry", "deployment_effect",
        "independently_observed", "observed_at", "invalidation_key_digest"
      ],
      "properties": {
        "schema_version": {"const": "domainspec.orodi.observation/v1"},
        "observation_id": {"type": "string", "minLength": 1},
        "plane": {"const": "product"},
        "kind": {"enum": ["metric", "health", "log"]},
        "mode": {"const": "simulation"},
        "correlation_id": {"type": "string", "minLength": 1},
        "attributes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
        "attribute_allowlist": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "cardinality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observed", "budget"],
          "properties": {
            "observed": {"type": "integer", "minimum": 0},
            "budget": {"type": "integer", "minimum": 1}
          }
        },
        "telemetry": {"$ref": "#/$defs/telemetry"},
        "deployment_effect": {"const": false},
        "independently_observed": {"const": false},
        "observed_at": {"type": "string", "format": "date-time"},
        "invalidation_key_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "eligibilityReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "observation_id", "profile_id", "family_id", "decision",
        "eligible_controls", "ineligible_controls", "reason_codes", "authority_effect"
      ],
      "properties": {
        "schema_version": {"const": "domainspec.orodi.tool-profile-evidence-eligibility-receipt/v1"},
        "observation_id": {"type": "string", "minLength": 1},
        "profile_id": {"type": "string", "minLength": 1},
        "family_id": {"$ref": "#/$defs/family"},
        "decision": {"const": "replay-only"},
        "eligible_controls": {"type": "array", "maxItems": 0, "items": {"$ref": "#/$defs/controlId"}},
        "ineligible_controls": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/controlId"}},
        "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "authority_effect": {"const": "none"}
      }
    },
    "derivedFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "detail"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "detail": {"type": "string", "minLength": 1}
      }
    },
    "derivedReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "control_id", "state", "evaluator_id", "rule_version",
        "observation_refs", "evaluated_at", "expires_at", "invalidation_key_digest",
        "findings", "authority_effect"
      ],
      "properties": {
        "schema_version": {"const": "domainspec.orodi.derived-control-receipt/v1"},
        "control_id": {"$ref": "#/$defs/controlId"},
        "state": {"$ref": "#/$defs/evidenceState"},
        "evaluator_id": {"type": "string", "pattern": "^domainspec\\.orodi\\.c(01|05|11|12|14|15)-evaluator$"},
        "rule_version": {"const": "1.0.0-candidate-local"},
        "observation_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evaluated_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "invalidation_key_digest": {"$ref": "#/$defs/sha256"},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/derivedFinding"}},
        "authority_effect": {"const": "none"}
      }
    },
    "mismatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_id", "claimed_state", "derived_state", "code"],
      "properties": {
        "control_id": {"$ref": "#/$defs/controlId"},
        "claimed_state": {"anyOf": [{"$ref": "#/$defs/evidenceState"}, {"type": "null"}]},
        "derived_state": {"$ref": "#/$defs/evidenceState"},
        "code": {"type": "string", "minLength": 1}
      }
    },
    "derivedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "validator_id", "validator_version", "evidence_lane", "binding_id",
        "evaluated_at", "verdict", "comparison", "derived_controls", "mismatches", "findings",
        "authority_effect"
      ],
      "properties": {
        "schema_version": {"const": "domainspec.orodi.derived-control-set-result/v1"},
        "validator_id": {"const": "domainspec.orodi.foundational-derived-validator"},
        "validator_version": {"const": "1.0.0-candidate-local"},
        "evidence_lane": {"const": "candidate-local-prototype"},
        "binding_id": {"type": "string", "minLength": 1},
        "evaluated_at": {"type": "string", "format": "date-time"},
        "verdict": {"enum": ["pass", "reject"]},
        "comparison": {"enum": ["match", "mismatch", "unavailable"]},
        "derived_controls": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/derivedReceipt"}},
        "mismatches": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/mismatch"}},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "authority_effect": {"const": "none"}
      }
    },
    "itemReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "item_id", "replay_id", "profile_id", "profile_version", "family_id",
        "binding_id", "invalidation_key_digest", "observation_id", "supplied_result_sha256",
        "recomputed_result_sha256", "eligibility_decision", "runtime_admission", "referent_trust",
        "authority_effect"
      ],
      "properties": {
        "schema_version": {"const": "domainspec.orodi.tool-evidence-replay-campaign-item-receipt/v1"},
        "item_id": {"type": "string", "minLength": 1},
        "replay_id": {"type": "string", "minLength": 1},
        "profile_id": {"type": "string", "minLength": 1},
        "profile_version": {"type": "string", "minLength": 1},
        "family_id": {"$ref": "#/$defs/family"},
        "binding_id": {"type": "string", "minLength": 1},
        "invalidation_key_digest": {"$ref": "#/$defs/sha256"},
        "observation_id": {"type": "string", "minLength": 1},
        "supplied_result_sha256": {"$ref": "#/$defs/sha256"},
        "recomputed_result_sha256": {"$ref": "#/$defs/sha256"},
        "eligibility_decision": {"const": "replay-only"},
        "runtime_admission": {"const": "denied"},
        "referent_trust": {"const": "unverified"},
        "authority_effect": {"const": "none"}
      }
    },
    "derivedPartition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "item_id", "replay_id", "binding_id", "invalidation_key_digest",
        "derived_result", "authority_effect"
      ],
      "properties": {
        "schema_version": {"const": "domainspec.orodi.tool-evidence-replay-campaign-derived-partition/v1"},
        "item_id": {"type": "string", "minLength": 1},
        "replay_id": {"type": "string", "minLength": 1},
        "binding_id": {"type": "string", "minLength": 1},
        "invalidation_key_digest": {"$ref": "#/$defs/sha256"},
        "derived_result": {"$ref": "#/$defs/derivedResult"},
        "authority_effect": {"const": "none"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "domainspec.orodi.tool-evidence-replay-campaign-result/v1"},
    "composer_id": {"const": "domainspec.orodi.tool-evidence-replay-campaign-composer"},
    "composer_version": {"const": "1.0.0-candidate-local"},
    "evidence_lane": {"const": "candidate-local-prototype"},
    "campaign_id": {"type": "string", "minLength": 1},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "input_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "item_receipts": {"type": "array", "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/itemReceipt"}},
    "replay_observations": {"type": "array", "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/observation"}},
    "eligibility_receipts": {"type": "array", "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/eligibilityReceipt"}},
    "per_binding_derived_results": {"type": "array", "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/derivedPartition"}},
    "runtime_admitted_observations": {"type": "array", "maxItems": 0},
    "eligible_controls": {"type": "array", "maxItems": 0},
    "verdict": {"enum": ["composed", "rejected"]},
    "findings": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/finding"}},
    "runtime_admission": {"const": "denied"},
    "referent_trust": {"const": "unverified"},
    "authority_effect": {"const": "none"}
  },
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "composed"}}, "required": ["verdict"]},
      "then": {"properties": {
        "item_receipts": {"minItems": 2, "maxItems": 7},
        "replay_observations": {"minItems": 2, "maxItems": 7},
        "eligibility_receipts": {"minItems": 2, "maxItems": 7},
        "per_binding_derived_results": {"minItems": 2, "maxItems": 7},
        "findings": {"maxItems": 0}
      }}
    },
    {
      "if": {"properties": {"verdict": {"const": "rejected"}}, "required": ["verdict"]},
      "then": {"properties": {
        "item_receipts": {"maxItems": 0},
        "replay_observations": {"maxItems": 0},
        "eligibility_receipts": {"maxItems": 0},
        "per_binding_derived_results": {"maxItems": 0},
        "findings": {"minItems": 1}
      }}
    }
  ]
}
