{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:domainspec:orodi:evaluation-result:v1",
  "title": "ORODI Candidate-Local Evaluation Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","validator_id","validator_version","evidence_lane","binding_id","claim_id","evaluated_at","verdict","claim_state","required_control_states","findings","authority_effect"],
  "properties": {
    "schema_version":{"const":"domainspec.orodi.evaluation-result/v1"},
    "validator_id":{"const":"domainspec.orodi.generic-validator"},
    "validator_version":{"const":"1.0.0-candidate-local"},
    "evidence_lane":{"const":"candidate-local-prototype"},
    "binding_id":{"type":"string","minLength":1},
    "claim_id":{"type":"string","minLength":1},
    "evaluated_at":{"type":"string","format":"date-time"},
    "verdict":{"enum":["pass","reject"]},
    "claim_state":{"enum":["passed","failed","missing","invalid","inconclusive","stale","not-run"]},
    "required_control_states":{"type":"array","maxItems":16,"items":{"type":"object","additionalProperties":false,"required":["control_id","state"],"properties":{"control_id":{"enum":["C01","C02","C03","C04","C05","C06","C07","C08","C09","C10","C11","C12","C13","C14","C15","C16"]},"state":{"enum":["passed","failed","missing","invalid","inconclusive","stale","not-run"]}}}},
    "findings":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["code","path","detail"],"properties":{"code":{"type":"string","minLength":1},"path":{"type":"string","minLength":1},"detail":{"type":"string","minLength":1}}}},
    "authority_effect":{"const":"none"}
  }
}
