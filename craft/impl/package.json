{
  "name": "@domainspec-v2/impl",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "DomainSpec v2 implementation home — engine + governance tooling (migrated from v1; see ../IMPORT-MANIFEST.md).",
  "engines": {
    "node": "26.8.1"
  },
  "workspaces": [
    "test-derivation-engine"
  ],
  "devDependencies": {
    "@types/node": "26.4.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "tsx": "4.20.6",
    "vitest": "3.2.6"
  },
  "scripts": {
    "validate": "pnpm run validate:docs && pnpm run validate:rels && pnpm run validate:content && pnpm run tools:test && pnpm run engine:lint",
    "validate:docs": "tsx tools/validate-doc-links.ts",
    "validate:rels": "tsx tools/validate-relationships.ts",
    "validate:content": "tsx tools/validate-content.ts",
    "validate:format": "tsx tools/validate-format-honesty.ts --root .. --baseline tools/format-honesty-baseline.json",
    "verify:evf-s1": "tsx test-derivation-engine/src/minted-project/verify-evf-s1.ts",
    "verify:evf-l2": "tsx test-derivation-engine/src/minted-project/l2/verify-l2-one-shot.ts",
    "test:evf-l2": "vitest run test-derivation-engine/src/minted-project/l2 --maxWorkers=1 --minWorkers=1",
    "verify:evf-l2:c0": "tsx test-derivation-engine/src/minted-project/l2/verify-c0.ts",
    "verify:evf-l2:c1": "tsx test-derivation-engine/src/minted-project/l2/verify-c1.ts",
    "verify:evf-l2:c2": "tsx test-derivation-engine/src/minted-project/l2/verify-c2.ts",
    "definitions:aggregate": "tsx tools/aggregate-concept-registry.ts",
    "audit:retired-orchestration": "tsx tools/audit-retired-orchestration-references.ts",
    "engine:lint": "tsx test-derivation-engine/src/cli.ts lint spec/features/sample",
    "engine:test": "pnpm --filter @domainspec/test-derivation-engine test",
    "generate:bte:financial-settlement": "tsx test-derivation-engine/src/bte/financial-settlement-cli.ts generate",
    "verify:bte:financial-settlement": "tsx test-derivation-engine/src/bte/financial-settlement-verify.ts",
    "build:sfol:financial-settlement": "tsx tools/build-financial-settlement-sfol.ts",
    "verify:sfol:financial-settlement": "tsx tools/build-financial-settlement-sfol.ts --verify-only",
    "adopt:sfol:financial-settlement": "tsx tools/run-financial-settlement-sfol.ts",
    "verify:adoption:sfol:financial-settlement": "tsx tools/validate-financial-settlement-sfol.ts",
    "verify:bte:contract-publication": "tsx test-derivation-engine/src/bte/contract-publication.ts --output-dir ../development/first-production-release/backend-type-test-engine-completeness/runs/20260723T020759Z/l0a",
    "verify:bte:contracts": "vitest run test-derivation-engine/src/bte/validation/validate-semantics.test.ts",
    "verify:bte:formation-v2": "vitest run test-derivation-engine/src/bte/development-engine.test.ts",
    "verify:bte:build": "vitest run test-derivation-engine/src/bte/development-engine.test.ts",
    "verify:bte:catalogue": "vitest run test-derivation-engine/src/bte/proof-engine.test.ts",
    "verify:bte:core": "vitest run test-derivation-engine/src/bte/proof-engine.test.ts",
    "verify:bte:consumers": "vitest run test-derivation-engine/src/bte/consumer-engine.test.ts",
    "verify:bte": "vitest run test-derivation-engine/src/bte && tsx test-derivation-engine/src/bte/development-pipeline.ts",
    "tags:extract": "tsx governance/tags/tools/extract-code-tags.ts",
    "tags:validate": "tsx governance/tags/tools/validate-code-tags.ts",
    "tags:drift": "tsx governance/tags/tools/compare-code-tag-drift.ts",
    "tags:composability": "tsx governance/tags/tools/check-code-tag-composability.ts",
    "tags:test": "node --import tsx --test governance/tags/tools/tests/*.test.ts",
    "tools:test": "node --import tsx --test tools/tests/*.test.ts",
    "instances:generate": "tsx tools/instances.ts generate",
    "instances:validate": "tsx tools/instances.ts validate",
    "factory": "tsx architecture-conformance/factory/cli/index.ts",
    "factory:test": "vitest run architecture-conformance/factory --testTimeout=70000 --maxWorkers=1 --minWorkers=1",
    "factory:typecheck": "tsc --project architecture-conformance/factory/tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@10.34.5"
}
