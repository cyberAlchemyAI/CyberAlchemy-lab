{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/definition-profiles/v2",
  "title": "Proposed closed Definition/v2 profile carriers; unadmitted",
  "oneOf": [
    {
      "$ref": "#/$defs/evaluationProfile"
    },
    {
      "$ref": "#/$defs/lifecycleProfile"
    }
  ],
  "$defs": {
    "sourceDirection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical",
        "human_projection",
        "projection_policy",
        "generator_ref",
        "generator_sha256"
      ],
      "properties": {
        "canonical": {
          "type": "string",
          "minLength": 1
        },
        "human_projection": {
          "type": "string",
          "minLength": 1
        },
        "projection_policy": {
          "const": "generated-only"
        },
        "generator_ref": {
          "const": "cal.generator.definition-profile-projections/v2"
        },
        "generator_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "base": {
      "type": "object",
      "required": [
        "schema_version",
        "record_id",
        "artifact_type_ref",
        "status",
        "authority_effect",
        "owner_ref",
        "source_direction",
        "claim_ceiling",
        "schema_ref",
        "schema_digest",
        "binding_contract_ref",
        "binding_contract_sha256"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_type_ref": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "candidate-unadmitted"
        },
        "authority_effect": {
          "const": "none"
        },
        "owner_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_direction": {
          "$ref": "#/$defs/sourceDirection"
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 1
        },
        "schema_ref": {
          "const": "cal.schema.definition-profiles/v2"
        },
        "schema_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "binding_contract_ref": {
          "type": "string",
          "minLength": 1
        },
        "binding_contract_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "gate",
        "effect"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "gate": {
          "type": "string",
          "minLength": 1
        },
        "effect": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evaluationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "purpose",
        "blocked_by"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "blocked_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evaluationProfile": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "record_id",
            "artifact_type_ref",
            "status",
            "authority_effect",
            "owner_ref",
            "source_direction",
            "claim_ceiling",
            "subject_artifact_type_ref",
            "outcomes",
            "evaluation_mode",
            "checks",
            "admission_rule",
            "schema_ref",
            "schema_digest",
            "binding_contract_ref",
            "binding_contract_sha256"
          ],
          "properties": {
            "schema_version": {
              "const": "cyberalchemy-lab-evaluation-profile/v2"
            },
            "record_id": {
              "type": "string",
              "minLength": 1
            },
            "artifact_type_ref": {
              "const": "cal.artifact-type.evaluation-profile/v2"
            },
            "status": {
              "const": "candidate-unadmitted"
            },
            "authority_effect": {
              "const": "none"
            },
            "owner_ref": {
              "type": "string",
              "minLength": 1
            },
            "source_direction": {
              "$ref": "#/$defs/sourceDirection"
            },
            "claim_ceiling": {
              "type": "string",
              "minLength": 1
            },
            "subject_artifact_type_ref": {
              "const": "cal.artifact-type.definition/v2"
            },
            "outcomes": {
              "type": "array",
              "const": [
                "PASS",
                "FAIL",
                "NOT_EVALUABLE"
              ]
            },
            "evaluation_mode": {
              "const": "collect-all"
            },
            "checks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/evaluationCheck"
              }
            },
            "admission_rule": {
              "type": "string",
              "minLength": 1
            },
            "schema_ref": {
              "const": "cal.schema.definition-profiles/v2"
            },
            "schema_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "binding_contract_ref": {
              "type": "string",
              "minLength": 1
            },
            "binding_contract_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      ]
    },
    "lifecycleProfile": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "record_id",
            "artifact_type_ref",
            "status",
            "authority_effect",
            "owner_ref",
            "source_direction",
            "claim_ceiling",
            "subject_artifact_type_ref",
            "states",
            "initial_state",
            "transitions",
            "separation_invariants",
            "schema_ref",
            "schema_digest",
            "binding_contract_ref",
            "binding_contract_sha256"
          ],
          "properties": {
            "schema_version": {
              "const": "cyberalchemy-lab-lifecycle-profile/v2"
            },
            "record_id": {
              "type": "string",
              "minLength": 1
            },
            "artifact_type_ref": {
              "const": "cal.artifact-type.lifecycle-profile/v2"
            },
            "status": {
              "const": "candidate-unadmitted"
            },
            "authority_effect": {
              "const": "none"
            },
            "owner_ref": {
              "type": "string",
              "minLength": 1
            },
            "source_direction": {
              "$ref": "#/$defs/sourceDirection"
            },
            "claim_ceiling": {
              "type": "string",
              "minLength": 1
            },
            "subject_artifact_type_ref": {
              "const": "cal.artifact-type.definition/v2"
            },
            "states": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "initial_state": {
              "type": "string",
              "minLength": 1
            },
            "transitions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/transition"
              }
            },
            "separation_invariants": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "schema_ref": {
              "const": "cal.schema.definition-profiles/v2"
            },
            "schema_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "binding_contract_ref": {
              "type": "string",
              "minLength": 1
            },
            "binding_contract_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      ]
    }
  }
}
