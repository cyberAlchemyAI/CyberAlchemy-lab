{
  "schema_version": "cal.define-preparation-compatibility-plan/v1",
  "authority_effect": "none",
  "consumers": [
    {
      "consumer": "run/chat",
      "input": "existing supported native inputs",
      "output": "legacy cav2.definition-pack-candidate/v1 inside current Lab result",
      "route": "preserve"
    },
    {
      "consumer": "prepare",
      "input": "legacy pack v1 plus explicit supplement",
      "output": "versioned preparation envelope and Lab pack v2 with exact adaptation lineage",
      "route": "explicit adapter"
    },
    {
      "consumer": "prepare",
      "input": "supported closed Lab pack v2",
      "output": "Definition/v2 candidates or scoped blockers",
      "route": "native new path"
    },
    {
      "consumer": "compile",
      "input": "legacy pack v1",
      "output": "existing selected Alch/Craft compilation",
      "route": "preserve no-open-question compiler-specific checks"
    },
    {
      "consumer": "compile",
      "input": "Lab pack v2",
      "output": "visible unsupported-version result",
      "route": "unsupported this release"
    },
    {
      "consumer": "legacy durable resume",
      "input": "existing v1 session/store records",
      "output": "same version/revision/idempotency behavior",
      "route": "preserve no silent migration"
    },
    {
      "consumer": "new preparation history",
      "input": "explicit caller work/job identity and legacy references if supplied",
      "output": "declared work records, not durable machine Agent memory",
      "route": "new bounded protocol"
    },
    {
      "consumer": "existing operational stores",
      "input": "original exact baseline",
      "output": "historical/stale inspection and replay where supported",
      "route": "no in-place rebase; provision new successor branch explicitly"
    }
  ]
}
