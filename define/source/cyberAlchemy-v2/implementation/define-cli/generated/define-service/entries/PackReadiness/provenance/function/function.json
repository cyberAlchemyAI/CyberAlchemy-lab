{
  "schemas": {
    "PackFacts": {
      "version_supported": {
        "type": "boolean"
      },
      "identity_complete": {
        "type": "boolean"
      },
      "scope_complete": {
        "type": "boolean"
      },
      "concepts_present": {
        "type": "boolean"
      },
      "dispositions_exact": {
        "type": "boolean"
      },
      "dispositions_declared": {
        "type": "boolean"
      },
      "authority_none": {
        "type": "boolean"
      },
      "language_quality_pass": {
        "type": "boolean"
      },
      "language_evidence_complete": {
        "type": "boolean"
      },
      "open_questions_empty": {
        "type": "boolean"
      }
    },
    "PackDecision": {
      "status": {
        "type": "string",
        "pattern": "^(invalid|valid_open|handoff_ready)$"
      },
      "valid": {
        "type": "boolean"
      },
      "handoff_ready": {
        "type": "boolean"
      },
      "session_state": {
        "type": "string",
        "pattern": "^(validation-blocked|blocked-open-meaning|definition-pack-complete)$"
      },
      "authority_effect": {
        "type": "string",
        "const": "none"
      }
    }
  },
  "integrations": {},
  "flows": {},
  "endpoint": {
    "id": "DefinePackReadiness",
    "target": "node-http",
    "runtime": "node>=26.8.1",
    "method": "POST",
    "path": "/define/pack-readiness",
    "input": "PackFacts",
    "output": "PackDecision",
    "authEnv": "DEFINE_RUNTIME_TOKEN",
    "maxBytes": 16384,
    "timeout": 1000,
    "errorStatus": 422,
    "statuses": {
      "invalid": 422,
      "valid_open": 409,
      "handoff_ready": 200
    },
    "errors": {},
    "result": "EvaluatePackReadiness"
  }
}
