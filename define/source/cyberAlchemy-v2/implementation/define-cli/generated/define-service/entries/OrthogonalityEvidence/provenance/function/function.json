{
  "schemas": {
    "OrthogonalityEvidenceFacts": {
      "relation": {
        "type": "string",
        "pattern": "^(independent|coupled|redundant|unresolved|unsupported)$"
      },
      "difference_present": {
        "type": "boolean"
      },
      "coupling_named": {
        "type": "boolean"
      }
    },
    "OrthogonalityEvidenceDecision": {
      "status": {
        "type": "string",
        "pattern": "^(accept|block)$"
      },
      "repair_focus": {
        "type": "string",
        "pattern": "^(none|evidence|redundant|unresolved|coupling)$"
      },
      "authority_effect": {
        "type": "string",
        "const": "none"
      }
    }
  },
  "integrations": {},
  "flows": {},
  "endpoint": {
    "id": "DefineOrthogonalityEvidence",
    "target": "node-http",
    "runtime": "node>=26.8.1",
    "method": "POST",
    "path": "/define/orthogonality-evidence",
    "input": "OrthogonalityEvidenceFacts",
    "output": "OrthogonalityEvidenceDecision",
    "authEnv": "DEFINE_LANGUAGE_GATE_TOKEN",
    "maxBytes": 16384,
    "timeout": 1000,
    "errorStatus": 422,
    "statuses": {
      "accept": 200,
      "block": 422
    },
    "errors": {},
    "result": "EvaluateOrthogonalityEvidence"
  }
}
