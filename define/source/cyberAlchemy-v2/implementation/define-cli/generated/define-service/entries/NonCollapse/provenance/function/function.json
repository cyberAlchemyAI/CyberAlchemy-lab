{
  "schemas": {
    "NonCollapseFacts": {
      "terms_valid": {
        "type": "boolean"
      },
      "pair_targets_valid": {
        "type": "boolean"
      },
      "pair_coverage_complete": {
        "type": "boolean"
      },
      "evidence_valid": {
        "type": "boolean"
      },
      "terms_distinct": {
        "type": "boolean"
      },
      "pairs_resolved": {
        "type": "boolean"
      },
      "option_coverage_complete": {
        "type": "boolean"
      },
      "definitions_distinct": {
        "type": "boolean"
      }
    },
    "NonCollapseDecision": {
      "status": {
        "type": "string",
        "pattern": "^(pass|block)$"
      },
      "repair_focus": {
        "type": "string",
        "pattern": "^(none|non-collapse)$"
      },
      "authority_effect": {
        "type": "string",
        "const": "none"
      }
    }
  },
  "integrations": {},
  "flows": {},
  "endpoint": {
    "id": "DefineNonCollapse",
    "target": "node-http",
    "runtime": "node>=26.8.1",
    "method": "POST",
    "path": "/define/non-collapse",
    "input": "NonCollapseFacts",
    "output": "NonCollapseDecision",
    "authEnv": "DEFINE_LANGUAGE_GATE_TOKEN",
    "maxBytes": 16384,
    "timeout": 1000,
    "errorStatus": 422,
    "statuses": {
      "pass": 200,
      "block": 422
    },
    "errors": {},
    "result": "EvaluateNonCollapse"
  }
}
