{
  "schemas": {
    "ProductReadinessFacts": {
      "definition_pack_current": {
        "type": "boolean"
      },
      "product_questions_complete": {
        "type": "boolean"
      },
      "semantic_grounding_pass": {
        "type": "boolean"
      },
      "non_collapse_pass": {
        "type": "boolean"
      },
      "orthogonality_pass": {
        "type": "boolean"
      }
    },
    "ProductReadinessDecision": {
      "status": {
        "type": "string",
        "pattern": "^(block|ready)$"
      },
      "repair_focus": {
        "type": "string",
        "pattern": "^(definition-pack|product-questions|semantic-grounding|non-collapse|orthogonality|none)$"
      },
      "authority_effect": {
        "type": "string",
        "const": "none"
      }
    }
  },
  "integrations": {},
  "flows": {},
  "endpoint": {
    "id": "DefineProductOntologyReadiness",
    "target": "node-http",
    "runtime": "node>=26.8.1",
    "method": "POST",
    "path": "/define/product-ontology/readiness",
    "input": "ProductReadinessFacts",
    "output": "ProductReadinessDecision",
    "authEnv": "DEFINE_RUNTIME_TOKEN",
    "maxBytes": 16384,
    "timeout": 1000,
    "errorStatus": 422,
    "statuses": {
      "block": 422,
      "ready": 200
    },
    "errors": {},
    "result": "EvaluateProductOntologyReadiness"
  }
}
