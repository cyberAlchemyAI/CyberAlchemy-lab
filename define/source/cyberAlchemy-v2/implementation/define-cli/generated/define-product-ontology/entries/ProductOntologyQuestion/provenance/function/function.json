{
  "schemas": {
    "ProductQuestionFacts": {
      "capability_present": {
        "type": "boolean"
      },
      "primary_user_present": {
        "type": "boolean"
      },
      "user_job_present": {
        "type": "boolean"
      },
      "outcome_present": {
        "type": "boolean"
      },
      "constraint_present": {
        "type": "boolean"
      }
    },
    "ProductQuestionDecision": {
      "status": {
        "type": "string",
        "pattern": "^(ask|complete)$"
      },
      "next_focus": {
        "type": "string",
        "pattern": "^(capability|primary-user|user-job|outcome|constraint|none)$"
      },
      "authority_effect": {
        "type": "string",
        "const": "none"
      }
    }
  },
  "integrations": {},
  "flows": {},
  "endpoint": {
    "id": "DefineProductOntologyQuestion",
    "target": "node-http",
    "runtime": "node>=26.8.1",
    "method": "POST",
    "path": "/define/product-ontology/question",
    "input": "ProductQuestionFacts",
    "output": "ProductQuestionDecision",
    "authEnv": "DEFINE_RUNTIME_TOKEN",
    "maxBytes": 16384,
    "timeout": 1000,
    "errorStatus": 422,
    "statuses": {
      "ask": 200,
      "complete": 200
    },
    "errors": {},
    "result": "SelectProductOntologyQuestion"
  }
}
