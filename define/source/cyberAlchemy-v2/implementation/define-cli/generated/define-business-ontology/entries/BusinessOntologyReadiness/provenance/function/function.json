{
  "schemas": {
    "BusinessReadinessFacts": {
      "product_receipt_current": {
        "type": "boolean"
      },
      "business_questions_complete": {
        "type": "boolean"
      },
      "semantic_grounding_pass": {
        "type": "boolean"
      },
      "non_collapse_pass": {
        "type": "boolean"
      },
      "orthogonality_pass": {
        "type": "boolean"
      }
    },
    "BusinessReadinessDecision": {
      "status": {
        "type": "string",
        "pattern": "^(block|ready)$"
      },
      "repair_focus": {
        "type": "string",
        "pattern": "^(product-receipt|business-questions|semantic-grounding|non-collapse|orthogonality|none)$"
      },
      "authority_effect": {
        "type": "string",
        "const": "none"
      }
    }
  },
  "integrations": {},
  "flows": {},
  "endpoint": {
    "id": "DefineBusinessOntologyReadiness",
    "target": "node-http",
    "runtime": "node>=26.8.1",
    "method": "POST",
    "path": "/define/business-ontology/readiness",
    "input": "BusinessReadinessFacts",
    "output": "BusinessReadinessDecision",
    "authEnv": "DEFINE_RUNTIME_TOKEN",
    "maxBytes": 16384,
    "timeout": 1000,
    "errorStatus": 422,
    "statuses": {
      "block": 422,
      "ready": 200
    },
    "errors": {},
    "result": "EvaluateBusinessOntologyReadiness"
  }
}
