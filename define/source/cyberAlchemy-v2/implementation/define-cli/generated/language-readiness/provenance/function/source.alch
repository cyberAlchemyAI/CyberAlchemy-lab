domain define-language-readiness "Define language readiness"
profile declarative-function-v1
owner cyberalchemy-define-owner
logic sfol-v1

schema LanguageChecks:
  semantic_grounding: string pattern "^(pass|review|block)$"
  non_collapse: string pattern "^(pass|block)$"
  orthogonality: string pattern "^(pass|block)$"
  user_confirmed: boolean

schema ReadinessDecision:
  status: string pattern "^(pass|review|block)$"
  repair_focus: string pattern "^(none|semantic-grounding|non-collapse|orthogonality|user-confirmation)$"
  authority_effect: string const "none"

mapping GroundingRepair:
  ontology "ALCH-DEFINE-GROUNDING-REPAIR"
  meaning "Block readiness when candidate language is not grounded in user-supplied language."
  target ReadinessDecision
  field status = "block"
  field repair_focus = "semantic-grounding"
  field authority_effect = "none"

mapping NonCollapseRepair:
  ontology "ALCH-DEFINE-NON-COLLAPSE-REPAIR"
  meaning "Block readiness when two candidate terms collapse or remain operationally indistinguishable."
  target ReadinessDecision
  field status = "block"
  field repair_focus = "non-collapse"
  field authority_effect = "none"

mapping OrthogonalityRepair:
  ontology "ALCH-DEFINE-ORTHOGONALITY-REPAIR"
  meaning "Block readiness when classification axes are redundant, unresolved, or coupled without an explicit relation."
  target ReadinessDecision
  field status = "block"
  field repair_focus = "orthogonality"
  field authority_effect = "none"

mapping ConfirmationReview:
  ontology "ALCH-DEFINE-CONFIRMATION-REVIEW"
  meaning "Keep grounded candidate inference in review posture until the user confirms or corrects it."
  target ReadinessDecision
  field status = "review"
  field repair_focus = "user-confirmation"
  field authority_effect = "none"

mapping Ready:
  ontology "ALCH-DEFINE-LANGUAGE-READY"
  meaning "Report that all three language checks pass after explicit user confirmation; this grants no canonical or execution authority."
  target ReadinessDecision
  field status = "pass"
  field repair_focus = "none"
  field authority_effect = "none"

rule GroundingBlocked:
  ontology "ALCH-DEFINE-GROUNDING-BLOCKED"
  meaning "Semantic grounding has a blocking defect."
  condition input.semantic_grounding == "block"

rule NonCollapseBlocked:
  ontology "ALCH-DEFINE-NON-COLLAPSE-BLOCKED"
  meaning "Grounding is not blocked and candidate-term non-collapse has a blocking defect."
  condition input.semantic_grounding != "block" and input.non_collapse == "block"

rule OrthogonalityBlocked:
  ontology "ALCH-DEFINE-ORTHOGONALITY-BLOCKED"
  meaning "Grounding and non-collapse are not blocked and orthogonality has a blocking defect."
  condition input.semantic_grounding != "block" and input.non_collapse != "block" and input.orthogonality == "block"

rule ConfirmationPending:
  ontology "ALCH-DEFINE-CONFIRMATION-PENDING"
  meaning "All structural language checks pass but candidate inference still awaits user confirmation."
  condition input.semantic_grounding != "block" and input.non_collapse == "pass" and input.orthogonality == "pass" and input.user_confirmed == false

rule LanguageReady:
  ontology "ALCH-DEFINE-LANGUAGE-READY-RULE"
  meaning "All language checks pass after explicit user confirmation."
  condition input.semantic_grounding == "pass" and input.non_collapse == "pass" and input.orthogonality == "pass" and input.user_confirmed

result EvaluateLanguageReadiness:
  ontology "ALCH-DEFINE-EVALUATE-LANGUAGE-READINESS"
  meaning "Select exactly one readiness disposition without granting authority."
  when GroundingBlocked yield GroundingRepair
  when NonCollapseBlocked yield NonCollapseRepair
  when OrthogonalityBlocked yield OrthogonalityRepair
  when ConfirmationPending yield ConfirmationReview
  when LanguageReady yield Ready

ontology LanguageChecks:
  id "ALCH-DEFINE-LANGUAGE-CHECKS"
  meaning "The three independently evaluated language-quality dimensions plus the explicit user-confirmation posture."
  property semantic_grounding "ALCH-DEFINE-LANGUAGE-CHECKS#semantic_grounding" "Whether every proposed language item is grounded in user language."
  property non_collapse "ALCH-DEFINE-LANGUAGE-CHECKS#non_collapse" "Whether every candidate-term pair remains operationally distinguishable."
  property orthogonality "ALCH-DEFINE-LANGUAGE-CHECKS#orthogonality" "Whether every applicable classification-axis pair is independent or explicitly coupled."
  property user_confirmed "ALCH-DEFINE-LANGUAGE-CHECKS#user_confirmed" "Whether the user explicitly confirmed the candidate language."

ontology ReadinessDecision:
  id "ALCH-DEFINE-READINESS-DECISION"
  meaning "A non-authoritative gate result naming pass, review, or block and the next repair focus."
  property status "ALCH-DEFINE-READINESS-DECISION#status" "The readiness disposition."
  property repair_focus "ALCH-DEFINE-READINESS-DECISION#repair_focus" "The single language dimension that needs the next user interaction."
  property authority_effect "ALCH-DEFINE-READINESS-DECISION#authority_effect" "Always none; readiness does not promote meaning or authorize effects."

endpoint DefineLanguageReadiness:
  target node-http
  runtime node>=26.8.1
  method POST
  path "/define/language-readiness"
  input LanguageChecks
  output ReadinessDecision
  result EvaluateLanguageReadiness
  auth-env DEFINE_LANGUAGE_GATE_TOKEN
  max-bytes 16384
  timeout-ms 1000
  error-status 422
  status pass 200
  status review 409
  status block 422
  error FUNCTION_OUTPUT_SCHEMA 500
  error FUNCTION_BODY_LIMIT 413
