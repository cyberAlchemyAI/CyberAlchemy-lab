{
  "schema_version": "alchlang.portable-http/v1",
  "entry": "app/function/index.mjs#handler",
  "launcher": "app/function/server.mjs",
  "target": "node-http",
  "runtime": "node>=26.8.1",
  "limits": {
    "request_bytes": 16384,
    "request_read_timeout_ms": 1000
  },
  "method": "POST",
  "path": "/define/integration/stage-handoff",
  "environment_references": [
    "DEFINE_RUNTIME_TOKEN"
  ],
  "integrations": {},
  "provisioned": false,
  "authority_effect": "none"
}
