{
  "schemas": {
    "SystemQuestionFacts": {
      "runtime_boundary_present": {
        "type": "boolean"
      },
      "components_present": {
        "type": "boolean"
      },
      "interfaces_present": {
        "type": "boolean"
      },
      "state_model_present": {
        "type": "boolean"
      },
      "persistence_recovery_present": {
        "type": "boolean"
      },
      "operating_constraints_present": {
        "type": "boolean"
      }
    },
    "SystemQuestionDecision": {
      "status": {
        "type": "string",
        "pattern": "^(ask|complete)$"
      },
      "next_focus": {
        "type": "string",
        "pattern": "^(runtime-boundary|components|interfaces|state-model|persistence-recovery|operating-constraints|none)$"
      },
      "authority_effect": {
        "type": "string",
        "const": "none"
      }
    }
  },
  "integrations": {},
  "flows": {},
  "endpoint": {
    "id": "DefineSystemOntologyQuestion",
    "target": "node-http",
    "runtime": "node>=26.8.1",
    "method": "POST",
    "path": "/define/system-ontology/question",
    "input": "SystemQuestionFacts",
    "output": "SystemQuestionDecision",
    "authEnv": "DEFINE_RUNTIME_TOKEN",
    "maxBytes": 16384,
    "timeout": 1000,
    "errorStatus": 422,
    "statuses": {
      "ask": 200,
      "complete": 200
    },
    "errors": {},
    "result": "SelectSystemOntologyQuestion"
  }
}
