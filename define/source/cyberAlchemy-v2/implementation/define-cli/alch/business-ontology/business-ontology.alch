# Candidate multi-entry assembly for the selected Alch Business Ontology source.
domain define-business-ontology "Define Business Ontology authoring"
profile service-v1
owner alch-language-business-owner

import BusinessOntologyQuestionFunction from "./business-question.alch"
import BusinessOntologyReadinessFunction from "./business-readiness.alch"

service DefineBusinessOntologyRuntime:
  ontology "ALCH-DEFINE-BUSINESS-ONTOLOGY-RUNTIME"
  meaning "Author a source-bound Business Ontology candidate from one exact Product Ontology handoff without moving business meaning into Define core."

entry BusinessOntologyQuestion:
  function BusinessOntologyQuestionFunction
  ontology "ALCH-DEFINE-BUSINESS-ONTOLOGY-QUESTION-ENTRY"
  meaning "Select the next Business-owned meaning required by the selected Business Ontology contract."

entry BusinessOntologyReadiness:
  function BusinessOntologyReadinessFunction
  ontology "ALCH-DEFINE-BUSINESS-ONTOLOGY-READINESS-ENTRY"
  meaning "Require the current Product handoff, complete Business meaning, and independent language quality."
