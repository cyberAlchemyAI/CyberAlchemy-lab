# Candidate multi-entry assembly for the selected Define System Runtime Ontology.
domain define-system-ontology "Define System Ontology authoring"
profile service-v1
owner define-system-runtime-owner

import SystemOntologyQuestionFunction from "./system-question.alch"
import SystemOntologyReadinessFunction from "./system-readiness.alch"

service DefineSystemOntologyRuntime:
  ontology "CAV2-DEFINE-SYSTEM-ONTOLOGY-AUTHORING-RUNTIME"
  meaning "Author a source-bound System Runtime Ontology candidate from one exact Business Ontology handoff without claiming implementation or conformance."

entry SystemOntologyQuestion:
  function SystemOntologyQuestionFunction
  ontology "CAV2-DEFINE-SYSTEM-ONTOLOGY-QUESTION-ENTRY"
  meaning "Select the next System-owned runtime distinction required by the selected candidate package."

entry SystemOntologyReadiness:
  function SystemOntologyReadinessFunction
  ontology "CAV2-DEFINE-SYSTEM-ONTOLOGY-READINESS-ENTRY"
  meaning "Require the current Business handoff, current candidate source, complete System meaning, and independent language quality."
