{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cav2.define-stage-run/v1",
  "type": "object",
  "properties": {
    "schema_version": {"const": "cav2.define-stage-run/v1"},
    "ok": {"type": "boolean"},
    "disposition": {"enum": ["handoff-ready", "blocked", "unavailable"]},
    "stage_id": {"type": "string", "minLength": 1},
    "phase": {"type": "string", "minLength": 1},
    "candidate": {"type": ["object", "null"]},
    "candidate_digest": {"type": ["string", "null"]},
    "handoff_receipt": {"type": ["object", "null"]},
    "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence": {"type": "object"},
    "stage_graph_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "module_set_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "authority_effect": {"const": "none"},
    "result_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "required": ["schema_version", "ok", "disposition", "stage_id", "phase", "candidate", "candidate_digest", "handoff_receipt", "reason_codes", "evidence", "stage_graph_digest", "module_set_digest", "authority_effect", "result_digest"],
  "additionalProperties": false
}

