{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/private/schemas/cav2-define-system-ontology/v1",
  "title": "CyberAlchemy v2 Define system ontology package",
  "$defs": {
    "sourceRefList": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "profile": {
      "type":"object",
      "required":["schema_version","ontology_id","ontology_type","branch","status","visibility","owner_route","authority_effect","implementation_status","materialization_mode","registries","inventory_contract","domainspec_binding","allowed_kinds","allowed_relation_types","claim_ceiling"],
      "properties":{"ontology_id":{"const":"cav2.define.system-runtime.v1"},"ontology_type":{"const":"system-runtime"},"branch":{"const":"system"},"status":{"const":"candidate"},"visibility":{"const":"private"},"authority_effect":{"const":"none"},"implementation_status":{"const":"not-implemented"},"materialization_mode":{"const":"package-required"}}
    },
    "sources": {
      "type":"object","required":["schema_version","sources"],
      "properties":{"sources":{"type":"array","minItems":1,"items":{"type":"object","required":["source_id","path","sha256","size_bytes","use"],"additionalProperties":false,"properties":{"source_id":{"type":"string","minLength":1},"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"size_bytes":{"type":"integer","minimum":1},"use":{"type":"string","minLength":1}}}}}
    },
    "nodes": {
      "type":"object","required":["schema_version","nodes"],
      "properties":{"nodes":{"type":"array","minItems":1,"items":{"type":"object","required":["node_id","source_path","kind","intent","status","implementation_status","source_refs","evidence_confidence","commitment_confidence","authority_effect"],"additionalProperties":false,"properties":{"node_id":{"type":"string","minLength":1},"source_path":{"type":"string","minLength":1},"kind":{"type":"string","minLength":1},"intent":{"type":"string","minLength":1},"status":{"const":"candidate"},"implementation_status":{"const":"not-implemented"},"source_refs":{"$ref":"#/$defs/sourceRefList"},"evidence_confidence":{"enum":["low","medium","high"]},"commitment_confidence":{"enum":["candidate","conditional","committed"]},"authority_effect":{"const":"none"}}}}}
    },
    "relations": {
      "type":"object","required":["schema_version","relations"],
      "properties":{"relations":{"type":"array","minItems":1,"items":{"type":"object","required":["relation_id","type","from_node_id","to_node_id","source_node_path","status","source_refs","authority_effect"],"additionalProperties":false,"properties":{"relation_id":{"type":"string","minLength":1},"type":{"type":"string","minLength":1},"from_node_id":{"type":"string","minLength":1},"to_node_id":{"type":"string","minLength":1},"source_node_path":{"type":"string","minLength":1},"status":{"const":"candidate"},"source_refs":{"$ref":"#/$defs/sourceRefList"},"authority_effect":{"const":"none"}}}}}
    },
    "views": {
      "type":"object","required":["schema_version","views"],
      "properties":{"views":{"type":"array","minItems":2,"items":{"type":"object","required":["view_id","label","purpose","allowed_claim","blocked_claim"]}}}
    },
    "residue": {
      "type":"object","required":["residue_id","status","kind","statement","source_refs","owner_route","authority_effect"],
      "additionalProperties":false,
      "properties":{"residue_id":{"type":"string","minLength":1},"status":{"enum":["open","blocked","resolved"]},"kind":{"type":"string","minLength":1},"statement":{"type":"string","minLength":1},"source_refs":{"$ref":"#/$defs/sourceRefList"},"owner_route":{"type":"string","minLength":1},"authority_effect":{"const":"none"}}
    }
  }
}
