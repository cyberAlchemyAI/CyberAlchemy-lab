{
  "schema_version": "cav2.define.runtime-design-candidate/v1",
  "design_id": "cav2.define.runtime-design.discovery.v1",
  "target_ontology_id": "cav2.define.system-runtime.v1",
  "status": "discovery-candidate",
  "design_posture": {
    "mode": "design",
    "canonical_w1_w3_status": "not-run",
    "reason": "No exact target-owner Design input-boundary approval and no current admitted Define v3 stage plus matching admission receipt were supplied.",
    "evidence_ceiling": "Evidence-backed discovery architecture only; not an governed Design candidate, bundle, or admission."
  },
  "design_unit": "One versioned command changes one expected session revision, crosses one atomic confirmed-state boundary, and can be resumed through the other interface with the same revision and state digest.",
  "components": [
    {"id": "component.cli-adapter", "name": "CLI adapter", "responsibility": "Render one current question and translate terminal actions into the shared command/query contracts."},
    {"id": "component.chat-adapter", "name": "Chat adapter", "responsibility": "Render the same session state conversationally and translate chat actions into the shared command/query contracts."},
    {"id": "component.session-application", "name": "Session application service", "responsibility": "Authenticate the actor context, load one revision, enforce command rules, invoke domain behavior, and commit one confirmed outcome."},
    {"id": "component.session-domain", "name": "Define session domain", "responsibility": "Own session, question, answer, Definition Pack, lifecycle, and authority-envelope invariants without transport or storage dependencies."},
    {"id": "component.pack-projector", "name": "Definition Pack projector", "responsibility": "Project one exact validated session revision into a consumer-bound Definition Pack without hiding gaps or changing authority."},
    {"id": "component.pack-validator", "name": "Definition Pack validator", "responsibility": "Check structural completeness, exact dispositions, source and owner references, open gaps, and the authority ceiling without approving content."},
    {"id": "component.persistence-adapter", "name": "Persistence adapter", "responsibility": "Implement the technology-neutral repository contract and preserve version, revision, state, and outcome atomically."},
    {"id": "component.telemetry-adapter", "name": "Telemetry adapter", "responsibility": "Record privacy-safe command, revision, latency, and outcome evidence without session answer or source content."},
    {"id": "component.context-resolution", "name": "Context resolution service", "responsibility": "Apply explicit-user, related-reference, current-window, then saved-session precedence; preserve candidate provenance; invoke bounded sufficiency evaluation; and request more context without turning inference into user intent."}
  ],
  "contracts": [
    {"id": "contract.session-command", "name": "SessionCommand", "required_fields": ["command_id", "command_type", "session_id", "expected_revision", "actor_access_context", "payload_schema_version", "payload"]},
    {"id": "contract.session-query", "name": "SessionQuery", "required_fields": ["query_type", "session_id", "actor_access_context", "projection_schema_version"]},
    {"id": "contract.session-snapshot", "name": "SessionSnapshot", "required_fields": ["session_id", "session_schema_version", "revision", "state_digest", "goal", "intent", "context", "context_candidates", "context_sufficiency_evaluation", "current_question_id", "questions", "answers", "sources", "evidence", "dispositions", "owners", "gaps", "check_results", "authority_envelope"]},
    {"id": "contract.session-write-result", "name": "SessionWriteResult", "required_fields": ["command_id", "session_id", "expected_revision", "observed_revision", "resulting_revision", "outcome", "failure_class", "state_digest", "event_id"]},
    {"id": "contract.authority-evaluation", "name": "AuthorityEvaluation", "required_fields": ["actor_ref", "matter_ref", "scope_ref", "requested_effect", "decision", "owner_route", "evidence_refs"]},
    {"id": "contract.definition-pack-export", "name": "DefinitionPackExport", "required_fields": ["pack_id", "session_id", "session_revision", "consumer_ref", "context_candidate_refs", "context_sufficiency_evaluation_ref", "material_digest", "open_gaps", "authority_envelope", "validation_result"]},
    {"id": "contract.audit-record", "name": "RuntimeAuditRecord", "required_fields": ["command_id", "session_id_hash", "revision", "operation", "outcome", "failure_class", "latency_ms", "occurred_at"]},
    {"id": "contract.health-status", "name": "RuntimeHealthStatus", "required_fields": ["repository_reachable", "schema_compatible", "read_probe_status", "observed_at"]},
    {"id": "contract.context-candidate", "name": "ContextCandidate", "required_fields": ["candidate_id", "source_kind", "source_ref", "content_digest", "derivation_posture", "confidence", "user_disposition"]},
    {"id": "contract.context-sufficiency-request", "name": "ContextSufficiencyRequest", "required_fields": ["evaluation_id", "define_job_ref", "requirement_set_digest", "candidate_set_digest", "as_of", "evaluator_version"]},
    {"id": "contract.context-sufficiency-result", "name": "ContextSufficiencyResult", "required_fields": ["evaluation_id", "status", "derivation", "residue", "evaluator_receipt_ref", "authority_effect"]}
  ],
  "workflow_steps": [
    {"id": "step.receive", "name": "Receive and decode", "owner": "component.cli-adapter|component.chat-adapter"},
    {"id": "step.authorize", "name": "Authenticate and evaluate exact authority", "owner": "component.session-application"},
    {"id": "step.load", "name": "Load last confirmed revision", "owner": "component.persistence-adapter"},
    {"id": "step.resolve-context", "name": "Resolve provenance-bearing context candidates in source order", "owner": "component.context-resolution"},
    {"id": "step.evaluate-context", "name": "Evaluate frozen context sufficiency", "owner": "component.context-resolution"},
    {"id": "step.request-context", "name": "Invite more context for insufficient or indeterminate results", "owner": "component.cli-adapter|component.chat-adapter"},
    {"id": "step.decide", "name": "Apply domain rule or policy after sufficient context", "owner": "component.session-domain"},
    {"id": "step.commit", "name": "Compare expected revision and atomically commit", "owner": "component.persistence-adapter"},
    {"id": "step.project", "name": "Project session or Definition Pack view", "owner": "component.pack-projector"},
    {"id": "step.respond", "name": "Return confirmed outcome or visible rejection", "owner": "component.cli-adapter|component.chat-adapter"}
  ],
  "decisions": [
    {"id": "decision.authority", "question": "May this actor make this exact matter count in this scope?", "outcomes": ["allow-routine-record", "route-to-owner", "deny"]},
    {"id": "decision.revision", "question": "Does expected_revision equal the last confirmed revision?", "outcomes": ["continue", "reject-conflict"]},
    {"id": "decision.validation", "question": "Does the exact Definition Pack pass structural checks?", "outcomes": ["validated", "reject-with-all-structural-gaps"]},
    {"id": "decision.export", "question": "Is this exact validated revision exportable to the named consumer within its authority envelope?", "outcomes": ["export", "route-or-deny"]},
    {"id": "decision.context-sufficiency", "question": "Do the frozen context candidates satisfy the frozen requirements of this bounded Define job?", "outcomes": ["sufficient", "insufficient", "indeterminate"]}
  ],
  "dependencies": [
    {"id": "dependency.repository", "name": "Session repository port", "selection": "required-port-backend-unselected"},
    {"id": "dependency.transport", "name": "Shared session transport port", "selection": "required-port-protocol-unselected"},
    {"id": "dependency.source-registry", "name": "Owned source and definition registries", "selection": "existing-owned-sources"},
    {"id": "dependency.authority-evidence", "name": "Actor authentication and owner evidence", "selection": "required-provider-unselected"},
    {"id": "dependency.arcanum", "name": "Arcanum capability boundary", "selection": "private-adapter-candidate-public-migration-not-authorized"},
    {"id": "dependency.domainspec", "name": "DomainSpec v2 source and conformance surface", "selection": "complete-backend-criteria@2-candidate-conformance-not-evaluable"},
    {"id": "dependency.semantic-evaluator", "name": "Private semantic evaluator port", "selection": "bounded-witness-reuse-candidate-define-adapter-not-implemented"}
  ],
  "relations": [
    {"from": "component.cli-adapter", "type": "uses", "to": "contract.session-command"},
    {"from": "component.cli-adapter", "type": "uses", "to": "contract.session-query"},
    {"from": "component.chat-adapter", "type": "uses", "to": "contract.session-command"},
    {"from": "component.chat-adapter", "type": "uses", "to": "contract.session-query"},
    {"from": "component.session-application", "type": "applies", "to": "contract.authority-evaluation"},
    {"from": "component.session-application", "type": "coordinates", "to": "component.session-domain"},
    {"from": "component.session-application", "type": "depends-on", "to": "dependency.repository"},
    {"from": "component.persistence-adapter", "type": "implements", "to": "dependency.repository"},
    {"from": "component.persistence-adapter", "type": "persists", "to": "contract.session-snapshot"},
    {"from": "component.persistence-adapter", "type": "returns", "to": "contract.session-write-result"},
    {"from": "component.pack-projector", "type": "produces", "to": "contract.definition-pack-export"},
    {"from": "component.pack-validator", "type": "validates", "to": "contract.definition-pack-export"},
    {"from": "component.telemetry-adapter", "type": "records", "to": "contract.audit-record"},
    {"from": "component.context-resolution", "type": "produces", "to": "contract.context-candidate"},
    {"from": "component.context-resolution", "type": "uses", "to": "contract.context-sufficiency-request"},
    {"from": "component.context-resolution", "type": "returns", "to": "contract.context-sufficiency-result"},
    {"from": "component.context-resolution", "type": "depends-on", "to": "dependency.semantic-evaluator"},
    {"from": "step.receive", "type": "precedes", "to": "step.authorize"},
    {"from": "step.authorize", "type": "precedes", "to": "step.load"},
    {"from": "step.load", "type": "precedes", "to": "step.resolve-context"},
    {"from": "step.resolve-context", "type": "precedes", "to": "step.evaluate-context"},
    {"from": "step.evaluate-context", "type": "precedes", "to": "step.request-context"},
    {"from": "step.evaluate-context", "type": "precedes", "to": "step.decide"},
    {"from": "step.request-context", "type": "precedes", "to": "step.resolve-context"},
    {"from": "step.decide", "type": "precedes", "to": "step.commit"},
    {"from": "step.commit", "type": "precedes", "to": "step.project"},
    {"from": "step.project", "type": "precedes", "to": "step.respond"},
    {"from": "decision.authority", "type": "controls", "to": "step.load"},
    {"from": "decision.revision", "type": "controls", "to": "step.commit"},
    {"from": "decision.validation", "type": "controls", "to": "component.pack-projector"},
    {"from": "decision.export", "type": "controls", "to": "contract.definition-pack-export"},
    {"from": "decision.context-sufficiency", "type": "controls", "to": "step.decide"},
    {"from": "decision.context-sufficiency", "type": "controls", "to": "step.request-context"},
    {"from": "dependency.transport", "type": "serves", "to": "component.cli-adapter"},
    {"from": "dependency.transport", "type": "serves", "to": "component.chat-adapter"},
    {"from": "dependency.arcanum", "type": "supports", "to": "component.pack-validator"},
    {"from": "dependency.domainspec", "type": "constrains", "to": "component.session-domain"},
    {"from": "dependency.semantic-evaluator", "type": "supports", "to": "component.context-resolution"}
  ],
  "views": [
    {"view_id": "context", "record_ids": ["component.cli-adapter", "component.chat-adapter", "component.session-application", "component.context-resolution", "dependency.transport", "dependency.repository", "dependency.arcanum", "dependency.domainspec", "dependency.semantic-evaluator"]},
    {"view_id": "high-level-structure", "record_ids": ["component.session-application", "component.session-domain", "component.context-resolution", "component.pack-projector", "component.pack-validator", "component.persistence-adapter", "component.telemetry-adapter"]},
    {"view_id": "low-level-components", "record_ids": ["contract.session-command", "contract.session-query", "contract.session-snapshot", "contract.session-write-result", "contract.authority-evaluation", "contract.definition-pack-export", "contract.audit-record", "contract.health-status", "contract.context-candidate", "contract.context-sufficiency-request", "contract.context-sufficiency-result"]},
    {"view_id": "workflow-process", "record_ids": ["step.receive", "step.authorize", "step.load", "step.resolve-context", "step.evaluate-context", "step.request-context", "step.decide", "step.commit", "step.project", "step.respond"]},
    {"view_id": "decision-flow", "record_ids": ["decision.authority", "decision.revision", "decision.context-sufficiency", "decision.validation", "decision.export"]},
    {"view_id": "dependency-interface", "record_ids": ["dependency.repository", "dependency.transport", "dependency.source-registry", "dependency.authority-evidence", "dependency.arcanum", "dependency.domainspec", "dependency.semantic-evaluator"]}
  ],
  "ontology_node_bindings": ["define-session-runtime.ActorAccessContext", "define-session-runtime.AdditionalContextRequested", "define-session-runtime.DefineRuntimeInterface", "define-session-runtime.ContextCandidate", "define-session-runtime.ContextResolutionPolicy", "define-session-runtime.ContextSourceKind", "define-session-runtime.ContextSufficiencyEvaluation", "define-session-runtime.ContextSufficiencyStatus", "define-session-runtime.EvaluateContextSufficiency", "define-session-runtime.ExpectedRevisionRule", "define-session-runtime.IdempotentCommandRule", "define-session-runtime.InteractionAccessibilityPolicy", "define-session-runtime.ProportionateGovernancePolicy", "define-session-runtime.RequestAdditionalContext", "define-session-runtime.ResolveIntentContext", "define-session-runtime.RuntimeHealth", "define-session-runtime.RuntimeSloPolicy", "define-session-runtime.RuntimeTelemetryPolicy", "define-session-runtime.SaveSession", "define-session-runtime.SemanticEvaluatorInterface", "define-session-runtime.SessionAccessPolicy", "define-session-runtime.SessionPersistenceMapping", "define-session-runtime.SessionRepositoryInterface", "define-session-runtime.SessionRetentionPolicy", "define-session-runtime.SessionRevision", "define-session-runtime.SessionSaved", "define-session-runtime.SessionSchemaVersion", "define-session-runtime.SessionTransportInterface", "define-session-runtime.SessionWriteRejected"],
  "next_route": "owner-bound-design-input-approval-or-design-gap-resolution",
  "authority_effect": "none"
}
