{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptance_conditions": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "consumer_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "context_policy_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "type": "array",
      "uniqueItems": true
    },
    "evidence_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "type": "array",
      "uniqueItems": true
    },
    "exclusions": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "input_contract_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "type": "array",
      "uniqueItems": true
    },
    "kind": {
      "const": "product-capability"
    },
    "lifecycle_posture": {
      "additionalProperties": false,
      "properties": {
        "commitment_ref": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_refs": {
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 100,
          "type": "array",
          "uniqueItems": true
        },
        "kind": {
          "const": "product-capability"
        },
        "owner_ref": {
          "pattern": "\\S",
          "type": "string"
        },
        "provenance_refs": {
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "residue_refs": {
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 100,
          "type": "array",
          "uniqueItems": true
        },
        "status": {
          "pattern": "\\S",
          "type": "string"
        },
        "status_vocabulary_ref": {
          "pattern": "\\S",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "status",
        "status_vocabulary_ref",
        "evidence_refs",
        "commitment_ref",
        "provenance_refs",
        "owner_ref",
        "residue_refs"
      ],
      "type": "object"
    },
    "name": {
      "pattern": "\\S",
      "type": "string"
    },
    "node_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "outcome": {
      "pattern": "\\S",
      "type": "string"
    },
    "output_contract_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_routes": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "participant_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "product_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "product_thesis_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "realization_binding_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "type": "array",
      "uniqueItems": true
    },
    "revision_history": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "changed_anchors": {
            "items": {
              "enum": [
                "product_ref",
                "outcome",
                "scope_ref",
                "owner_routes"
              ]
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "decision_ref": {
            "pattern": "\\S",
            "type": "string"
          },
          "rationale": {
            "pattern": "\\S",
            "type": "string"
          },
          "revision_id": {
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "revision_id",
          "changed_anchors",
          "rationale",
          "decision_ref"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "type": "array"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "successor_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "type": "array",
      "uniqueItems": true
    },
    "thesis_outcome_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "acceptance_conditions",
    "authority_effect",
    "exclusions",
    "kind",
    "node_id",
    "outcome",
    "owner_ref",
    "product_ref",
    "scope_ref",
    "status",
    "name",
    "product_thesis_ref",
    "thesis_outcome_refs",
    "participant_refs",
    "consumer_refs",
    "input_contract_refs",
    "output_contract_refs",
    "context_policy_refs",
    "owner_routes",
    "lifecycle_posture",
    "realization_binding_refs",
    "evidence_refs",
    "revision_history",
    "successor_refs",
    "challenge_route"
  ],
  "type": "object"
}
