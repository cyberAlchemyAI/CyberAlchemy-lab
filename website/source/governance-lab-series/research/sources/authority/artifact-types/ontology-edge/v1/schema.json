{
  "$id": "https://cyberalchemy.local/schemas/ontology-edge/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "payload": {
            "properties": {
              "edge_mode": {
                "const": "global-projection"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "global_typed_relation_binding": {
                "additionalProperties": false,
                "properties": {
                  "typed_relation_digest": {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  },
                  "typed_relation_ref": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "typed_relation_version_ref": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "typed_relation_ref",
                  "typed_relation_version_ref",
                  "typed_relation_digest"
                ],
                "type": "object"
              },
              "local_interpretation": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payload": {
            "properties": {
              "edge_mode": {
                "const": "local-interpretation"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "global_typed_relation_binding": {
                "type": "null"
              },
              "local_interpretation": {
                "additionalProperties": false,
                "properties": {
                  "evidence_refs": {
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array",
                    "uniqueItems": true
                  },
                  "interpretation": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "local_scope": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "owner_ref": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "interpretation",
                  "local_scope",
                  "owner_ref",
                  "evidence_refs"
                ],
                "type": "object"
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "minLength": 1,
      "type": "string"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "kind": {
      "const": "ontology-edge"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "node_id": {
      "minLength": 1,
      "type": "string"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "closed_qualifiers": {
          "type": "object"
        },
        "direction": {
          "enum": [
            "directed",
            "symmetric"
          ]
        },
        "edge_mode": {
          "enum": [
            "global-projection",
            "local-interpretation"
          ]
        },
        "forbidden_collapse": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "global_typed_relation_binding": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "typed_relation_digest": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                "typed_relation_ref": {
                  "minLength": 1,
                  "type": "string"
                },
                "typed_relation_version_ref": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "typed_relation_ref",
                "typed_relation_version_ref",
                "typed_relation_digest"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "lifecycle": {
          "enum": [
            "active",
            "retired",
            "removed"
          ]
        },
        "local_interpretation": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "evidence_refs": {
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array",
                  "uniqueItems": true
                },
                "interpretation": {
                  "minLength": 1,
                  "type": "string"
                },
                "local_scope": {
                  "minLength": 1,
                  "type": "string"
                },
                "owner_ref": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "interpretation",
                "local_scope",
                "owner_ref",
                "evidence_refs"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "ontology_ref": {
          "minLength": 1,
          "type": "string"
        },
        "relation_type_ref": {
          "minLength": 1,
          "type": "string"
        },
        "replay_source": {
          "const": false
        },
        "semantic_event_ref": {
          "additionalProperties": false,
          "properties": {
            "semantic_cursor": {
              "minimum": 1,
              "type": "integer"
            },
            "semantic_event_digest": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "semantic_event_id": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "semantic_event_id",
            "semantic_event_digest",
            "semantic_cursor"
          ],
          "type": "object"
        },
        "source_node_ref": {
          "minLength": 1,
          "type": "string"
        },
        "target_node_ref": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "ontology_ref",
        "edge_mode",
        "relation_type_ref",
        "source_node_ref",
        "target_node_ref",
        "direction",
        "closed_qualifiers",
        "global_typed_relation_binding",
        "local_interpretation",
        "lifecycle",
        "forbidden_collapse",
        "semantic_event_ref",
        "replay_source"
      ],
      "type": "object"
    },
    "record_state": {
      "enum": [
        "candidate",
        "admitted",
        "historical",
        "retired"
      ]
    },
    "schema_version": {
      "const": "cyberalchemy-lab-ontology-edge/v1"
    },
    "scope_ref": {
      "minLength": 1,
      "type": "string"
    },
    "successor_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "node_id",
    "kind",
    "name",
    "record_state",
    "authority_effect",
    "owner_ref",
    "scope_ref",
    "evidence_refs",
    "challenge_route",
    "successor_refs",
    "payload",
    "claim_ceiling"
  ],
  "type": "object"
}
