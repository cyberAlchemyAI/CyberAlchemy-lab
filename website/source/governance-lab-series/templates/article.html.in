<script>
(() => {
 document.querySelectorAll('[data-graph]').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('[data-graph]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));const d=document.querySelector('#figure-records-and-ontology .diagram-shell');d.classList.remove('focus-records','focus-view');if(b.dataset.graph!=='both')d.classList.add('focus-'+b.dataset.graph);}));
 let session='active';const toggle=document.getElementById('session-toggle');toggle.addEventListener('click',()=>{if(session==='closed'){session='fresh';document.getElementById('session-note').textContent='Empty. This new instance has no notes from the previous session.';document.getElementById('session-status').textContent='New session · empty short-term memory';document.getElementById('session-explanation').textContent='A fresh session can obtain newly prepared information from saved Project State. The previous working note has not returned.';toggle.textContent='Close this session';}else{session='closed';document.getElementById('session-note').textContent='Cleared. The session and machine instance have ended.';document.getElementById('session-status').textContent='Ended · working memory cleared';document.getElementById('session-explanation').textContent='Saved Project State remains available. A later session obtains current task information and starts with empty working memory.';toggle.textContent='Start a fresh session';}});
 const sections=[...document.querySelectorAll('.article-section, .read-more')],nav=[...document.querySelectorAll('[data-section]')],progress=document.querySelector('.progress'),article=document.getElementById('lab-article');let pending=false;
 function update(){if(document.body.hasAttribute('data-docs-enhanced')){pending=false;return;}let current=null;for(const s of sections)if(s.getBoundingClientRect().top<=80)current=s.id;nav.forEach(a=>{if(a.dataset.section===current)a.setAttribute('aria-current','location');else a.removeAttribute('aria-current');});const rect=article.getBoundingClientRect(),start=rect.top+scrollY,distance=Math.max(1,rect.height-innerHeight+80),percent=Math.max(0,Math.min(100,(scrollY-start+80)/distance*100)),rounded=Math.round(percent),blocks=Math.round(percent/100*16);progress.style.width=percent+'%';document.getElementById('reading-blocks').textContent='█'.repeat(blocks)+'░'.repeat(16-blocks);document.getElementById('reading-percent').textContent=rounded+'%';document.getElementById('article-progress').value=rounded;pending=false;}
 function queue(){if(!pending){pending=true;requestAnimationFrame(update);}}addEventListener('scroll',queue,{passive:true});addEventListener('resize',queue);document.addEventListener('toggle',queue,true);update();
})();
</script>
</body></html>
