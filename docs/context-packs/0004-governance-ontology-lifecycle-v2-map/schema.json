{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cyberalchemy-lab-context-map-v2-prototype-pack/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "stage_id",
    "version",
    "status",
    "authority_effect",
    "objective",
    "canonical_artifact",
    "selected_inputs",
    "four_facet_contract",
    "two_lane_binding",
    "validation_contract",
    "source_direction",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "cyberalchemy-lab-context-map-v2-prototype-pack/v1"},
    "pack_id": {"const": "CAL-CONTEXT-MAP-PACK-CTXMAP2-0004"},
    "stage_id": {"const": "CTXMAP2-S1"},
    "version": {"const": "2.0.0-candidate.1"},
    "status": {"const": "testable-prototype-candidate"},
    "authority_effect": {"const": "none"},
    "objective": {"type": "string", "minLength": 1},
    "canonical_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type_ref", "artifact_id", "path", "projection"],
      "properties": {
        "artifact_type_ref": {"const": "cal.artifact-type.context-map/v2"},
        "artifact_id": {"const": "cal.context-map.governance-ontology-lifecycle"},
        "path": {"const": "contexts/maps/governance-ontology-lifecycle/v2/map.json"},
        "projection": {"const": "contexts/maps/governance-ontology-lifecycle/v2/MAP.md"}
      }
    },
    "selected_inputs": {
      "type": "array",
      "minItems": 15,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input_id", "path", "sha256"],
        "properties": {
          "input_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "four_facet_contract": {"type": "object", "required": ["classification", "schema", "human_continuation", "machine_checkable"]},
    "two_lane_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_lane", "current_product_frontier", "operational_tasks", "continuation_status", "blocking_policy", "residue_policy"],
      "properties": {
        "product_lane": {"const": "product-construction"},
        "current_product_frontier": {"const": "CTXMAP2-S1"},
        "operational_tasks": {"type": "array"},
        "continuation_status": {"const": "runnable"},
        "blocking_policy": {"const": "only-exact-frontier-prerequisite-or-applicable-boundary"},
        "residue_policy": {"const": "defer-visible-operational-support"}
      }
    },
    "validation_contract": {"type": "object", "required": ["positive", "hostile"]},
    "source_direction": {"type": "object", "required": ["canonical", "human_projection", "projection_policy", "generator"]},
    "claim_ceiling": {"type": "string", "minLength": 1}
  }
}
