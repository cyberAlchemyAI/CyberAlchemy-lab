{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cal.d65-export-cutover-plan/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "revision",
    "status",
    "goal_id",
    "project_id",
    "construction_id",
    "source_epoch",
    "selected_sources",
    "invariants",
    "layers",
    "stages",
    "first_executable_stage",
    "first_owner_gate",
    "product_candidate",
    "first_stage_write_scope",
    "work_plan",
    "validation_contract",
    "rollback_contract",
    "execution",
    "goals_registration",
    "owner_decision_request_path",
    "authority_effect",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "cal.d65-export-cutover-plan/v1"},
    "plan_id": {"const": "CAL-PLAN-0004"},
    "revision": {"const": 6},
    "status": {"const": "product-approved-awaiting-separate-authority-decision"},
    "goal_id": {"const": "CA2-GOAL-CYBERALCHEMY-LAB-ONTOLOGY-RUNTIME-INTEGRATION"},
    "project_id": {"const": "CA2-PROJECT-CYBERALCHEMY-LAB-ONTOLOGY-RUNTIME-INTEGRATION"},
    "construction_id": {"const": "CA2-CONSTRUCTION-CYBERALCHEMY-LAB-ONTOLOGY-RUNTIME-EXPORT-CUTOVER-EPOCH-002"},
    "source_epoch": {"type": "object"},
    "selected_sources": {"type": "array", "minItems": 20, "items": {"type": "object"}},
    "invariants": {"type": "array", "minItems": 8, "items": {"type": "string", "minLength": 1}},
    "layers": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object"}},
    "stages": {"type": "array", "minItems": 11, "items": {"type": "object"}},
    "first_executable_stage": {"type": "null"},
    "first_owner_gate": {"type": "null"},
    "product_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "manifest_path", "manifest_sha256", "product_test_evidence_path", "product_test_evidence_sha256", "approval_request_path", "approval_request_sha256", "approval_decision_path", "approval_decision_sha256", "approval_evidence_path", "approval_evidence_sha256", "state", "product_approval_eligible", "product_approval", "authority_effect"],
      "properties": {
        "candidate_id": {"const": "CAL-D65-EPOCH-002-TESTABLE-PRODUCT-001"},
        "manifest_path": {"type": "string"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "product_test_evidence_path": {"type": "string"},
        "product_test_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "approval_request_path": {"type": "string"},
        "approval_request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "approval_decision_path": {"type": "string"},
        "approval_decision_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "approval_evidence_path": {"type": "string"},
        "approval_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "state": {"const": "approved-tested-product"},
        "product_approval_eligible": {"const": true},
        "product_approval": {"const": "approved"},
        "authority_effect": {"const": "product-approval-only"}
      }
    },
    "first_stage_write_scope": {"type": "array", "minItems": 9, "uniqueItems": true, "items": {"type": "string"}},
    "work_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "product_stage_state_ref", "current_product_frontier", "operational_tasks", "continuation_status", "continuation_policy", "blocking_policy", "residue_policy", "authority_effect"],
      "properties": {
        "schema_version": {"const": "cav2-d65-two-lane-construction-plan/v1"},
        "product_stage_state_ref": {"const": "stages"},
        "current_product_frontier": {"type": "null"},
        "operational_tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["task_id", "lane", "state", "applies_to_stage", "blocking_basis", "detail", "owner_route", "authority_effect"],
            "properties": {
              "task_id": {"type": "string", "minLength": 1},
              "lane": {"const": "operational-support"},
              "state": {"enum": ["pending", "blocked", "complete", "not_applicable"]},
              "applies_to_stage": {"type": ["string", "null"]},
              "blocking_basis": {"enum": ["none", "exact-prerequisite", "safety-boundary", "privacy-boundary", "authority-boundary", "destructive-action-boundary", "credential-boundary", "external-effect-boundary"]},
              "detail": {"type": "string", "minLength": 1},
              "owner_route": {"type": "string", "minLength": 1},
              "authority_effect": {"const": "none"}
            }
          }
        },
        "continuation_status": {"const": "complete"},
        "continuation_policy": {"const": "continue-dependency-ready-product-construction"},
        "blocking_policy": {"const": "only-exact-frontier-prerequisite-or-applicable-boundary"},
        "residue_policy": {"const": "defer-visible-operational-support"},
        "authority_effect": {"const": "none"}
      }
    },
    "validation_contract": {"type": "object"},
    "rollback_contract": {"type": "object"},
    "execution": {"type": "object"},
    "goals_registration": {"type": "object"},
    "owner_decision_request_path": {"const": "ontology-lifecycle/conformance/cal-d65-s8-export-cutover-epoch-002/product-approval-request.json"},
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  }
}
