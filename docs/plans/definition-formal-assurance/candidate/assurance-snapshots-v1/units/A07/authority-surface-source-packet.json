{
  "assumption_links": [],
  "authority_effect": "none",
  "correspondence": [
    {
      "clause_id": "clause-1",
      "end_character": 118,
      "excerpt": "An authority layer can cite evidence, but evidence does not become authority\nunless the responsible owner promotes it.",
      "unit_id": "unit-339a9a99c02341245f51aefcfa97b78d17d81863d752c89cc46e5c2c72b0248e"
    },
    {
      "clause_id": "clause-2",
      "end_character": 251,
      "excerpt": "Candidate Definition reconstructed from an accepted normalization scaffold and exact CyberAlchemy-v2 source sections. It is not admitted and grants no implementation, migration, registry, publication, release, deployment, or external-effect authority.",
      "unit_id": "unit-551051d584e8331e5ddcc495261d314ed89f7cf4cc2e9b5d89d0ceba64f24fbe"
    },
    {
      "clause_id": "clause-3",
      "end_character": 182,
      "excerpt": "Use authority layers to prevent research, inventory, ontology, observability,\nmemory, generated projections, and implementation evidence from silently\nrewriting definitions or rules.",
      "unit_id": "unit-c87857672af83d65aa2417f0a2e647b5bed7289c8297c973dce3ac2c4336ab6d"
    },
    {
      "clause_id": "clause-4",
      "end_character": 22,
      "excerpt": "scope.shared-authority",
      "unit_id": "unit-d98b0dcc8c90b5d742e9beb805c5005c88770dc54b7c3939d5b7cc2388378d48"
    },
    {
      "clause_id": "clause-5",
      "end_character": 78,
      "excerpt": "Admission, activation, publication, release, deployment, and external effects.",
      "unit_id": "unit-8dec732fb5d927545d4bf5c1bea73405d34e388983cdba3240a36b63ba348803"
    },
    {
      "clause_id": "clause-6",
      "end_character": 88,
      "excerpt": "Meanings assigned to split or reclassified sibling targets unless explicitly referenced.",
      "unit_id": "unit-94bf2030418c421474ce1629a5f3255fde290758d03623f29467345f93ee9ea0"
    },
    {
      "clause_id": "clause-7",
      "end_character": 90,
      "excerpt": "Resolve semantic.authority-surface by its machine identity rather than its directory name.",
      "unit_id": "unit-3dbb899dfdf036397238716a2bc6e8e181ae382826d10cc5222deaad748f4cba"
    },
    {
      "clause_id": "clause-8",
      "end_character": 86,
      "excerpt": "Challenge source drift through the L1 drift audit before relying on Authority Surface.",
      "unit_id": "unit-ff90228d7a1a4e1937568cb3ad668e6efbd7ea195840b5287c901b8ee0981dc5"
    },
    {
      "clause_id": "clause-9",
      "end_character": 430,
      "excerpt": "In CyberAlchemy-lab migration work, Authority Surface is a prototype meaning reconstructed from CAL-NORMALIZE-01. It remains non-authoritative until the correct Lab owner admits a fully validated candidate.\n\nSource context retained for reconstruction:\n\nIn CyberAlchemy v2, the authority layers are currently\n`authority/definitions/`, `authority/constitutions/`, `disciplines/`,\n`authority/decisions/`, and later promoted `specs/`.",
      "unit_id": "unit-ebccb8c54f697cac698322a56841f34a023a16620c48702313201aacc9947747"
    },
    {
      "clause_id": "clause-10",
      "end_character": 41,
      "excerpt": "/home/vrondelli/projects/CyberAlchemy-lab",
      "unit_id": "unit-ffa309e64b53ab85866dd9c0bce78b5cb2d9a40913e906c9ea92bc3faa5b2ed5"
    },
    {
      "clause_id": "clause-11",
      "end_character": 59,
      "excerpt": "An authority layer says which document is allowed to count.",
      "unit_id": "unit-b6044800e26a9c1b313ef73167f9cfcbefe3ef3fa98db6ad2634259323fb0973"
    },
    {
      "clause_id": "clause-12",
      "end_character": 118,
      "excerpt": "An authority layer can cite evidence, but evidence does not become authority\nunless the responsible owner promotes it.",
      "unit_id": "unit-cad6d184f0a3c0b79ca1c69e54d757f5e8f109c117ed25e1c4701cce3f9eb121"
    },
    {
      "clause_id": "clause-13",
      "end_character": 257,
      "excerpt": "semantic.authority-surface := (semantic_kind=definition, carrier=type.definition, owner_scope=scope.shared-authority, source_set={CAV2-D3}). Identity, carrier, and owner scope are independent axes; equality of labels does not establish equality of concepts.",
      "unit_id": "unit-4b338d1ee5cc56bbd5b5c44d119aa46544063af36d94e1704e152366581f4d21"
    },
    {
      "clause_id": "clause-14",
      "end_character": 504,
      "excerpt": "Authority Surface is the normalized definition identified by semantic.authority-surface, owned within scope.shared-authority, and carried by type.definition. Any canonical instance must preserve that classification and the accepted source relations to CAV2-D3 without silently merging it with another target.\n\nBound source-semantic basis:\n\nAn authority layer is a project-local surface that is allowed to define\nnormative meaning, structural rules, promotion decisions, or contracts for a\nspecific scope.",
      "unit_id": "unit-cc9c963feb8c4bcd752deefc72d9d12c00518192ce19355f4610b703d141a689"
    },
    {
      "clause_id": "clause-15",
      "end_character": 49,
      "excerpt": "Stable normalized identity for Authority Surface.",
      "unit_id": "unit-f5b34602ac13a29e91232e7734aa3ec82beba448da4ca31c14bf7f3b9c966c84"
    },
    {
      "clause_id": "clause-16",
      "end_character": 26,
      "excerpt": "semantic.authority-surface",
      "unit_id": "unit-b468bf2113bc40d148e9432c2fa961177300386f28d82949ad761a8edbdde252"
    },
    {
      "clause_id": "clause-17",
      "end_character": 49,
      "excerpt": "Bound CyberAlchemy-v2 source-definition identity.",
      "unit_id": "unit-589257840cd95cd1a238672e86bd6b9137eba67d8ce5929322ef98c2127693fd"
    },
    {
      "clause_id": "clause-18",
      "end_character": 7,
      "excerpt": "CAV2-D3",
      "unit_id": "unit-d4fcd38fc9762f4d02ba129797ca186e1213b8393c1764924d312807cc17d870"
    },
    {
      "clause_id": "clause-19",
      "end_character": 64,
      "excerpt": "The candidate identity remains cal.definition.authority-surface.",
      "unit_id": "unit-4d4dcc8312cf70d2bf38e76ddaf087a94c6dc9143d3fc1264a68bdc0bf03ed71"
    },
    {
      "clause_id": "clause-20",
      "end_character": 53,
      "excerpt": "Every selected source-section digest remains current.",
      "unit_id": "unit-62d9b9f0f2e14b44077e3a0db7904079fca058376b549a92223861c2220f97bc"
    },
    {
      "clause_id": "clause-21",
      "end_character": 51,
      "excerpt": "The machine record validates against Definition/v1.",
      "unit_id": "unit-6e0a36a3e7ce10e3274f2fe9e2ee41f7701f2c203d126d1278b94a5f3bd6b8fd"
    },
    {
      "clause_id": "clause-22",
      "end_character": 68,
      "excerpt": "The human projection is regenerated exactly from the machine record.",
      "unit_id": "unit-6e3477ec8786dca6eee728124933d1959d2501d9fa6c5a4a317baaec6d87d593"
    }
  ],
