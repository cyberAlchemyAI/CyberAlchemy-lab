{
  "assumption_links": [],
  "authority_effect": "none",
  "correspondence": [
    {
      "clause_id": "clause-1",
      "end_character": 46,
      "excerpt": "Authority Boundary is not Decision Checkpoint.",
      "unit_id": "unit-ebd3ecf1198ae09553dc24cf95207477077299f1277e943297206e9e683be798"
    },
    {
      "clause_id": "clause-2",
      "end_character": 56,
      "excerpt": "Shared principal identity is not shared authority scope.",
      "unit_id": "unit-0f76c2a4d85814f76fd7b1897f0d6b28fed7aacd4b16c8b60fcc4c0ca14923dc"
    },
    {
      "clause_id": "clause-3",
      "end_character": 100,
      "excerpt": "Authority is not inferred from evidence, workflow position, implementation, or filesystem placement.",
      "unit_id": "unit-49edbc01bfe3387add53fce20cb5e8d7b627ed18e3224931a0ddf56ed14f16ba"
    },
    {
      "clause_id": "clause-4",
      "end_character": 163,
      "excerpt": "This candidate clarifies Authority Boundary semantics only. It does not grant authority, assign an owner, create a decision, adopt a rule, or authorize any effect.",
      "unit_id": "unit-98a527c970281774a59809b25982b2f1748ff70ec655203a1248fcd422e2ac1c"
    },
    {
      "clause_id": "clause-5",
      "end_character": 103,
      "excerpt": "Owner-scoped semantic and effect authority used by CyberAlchemy Lab workflows and governance decisions.",
      "unit_id": "unit-030705265ab1657ae1a85f702d010f3ab207f2761bc61f5d001f9227a66b29f9"
    },
    {
      "clause_id": "clause-6",
      "end_character": 40,
      "excerpt": "scope:cyberalchemy-lab-shared-governance",
      "unit_id": "unit-2d72690690ce047a3dc960a38f445b4399f4aa9c53b91c2778d659748ab779c1"
    },
    {
      "clause_id": "clause-7",
      "end_character": 31,
      "excerpt": "Workflow interaction placement.",
      "unit_id": "unit-6813c19c46210e6c2d2dbb506e1ed0ec1c086f29e3381a1482b3e6fbf934cefb"
    },
    {
      "clause_id": "clause-8",
      "end_character": 40,
      "excerpt": "Evidence quality or validation outcomes.",
      "unit_id": "unit-08b08985b49b8ae7e9b7bd1e787ca4f121f821b90bd3258eeecb6c59ca749cfb"
    },
    {
      "clause_id": "clause-9",
      "end_character": 85,
      "excerpt": "Authority inferred from repository location, automation, or principal identity alone.",
      "unit_id": "unit-c2328ccbb3f9e21582c3b7b57c5fcd31157f95bd07e3bedd35c59062ae760fee"
    },
    {
      "clause_id": "clause-10",
      "end_character": 81,
      "excerpt": "The definition owner may admit a term but cannot thereby admit a Bounded Context.",
      "unit_id": "unit-2bbbfaf8f6f72e9a0116e283806dd527f35e84ce813b6b2856f8a7ed7a74cbd9"
    },
    {
      "clause_id": "clause-11",
      "end_character": 83,
      "excerpt": "Selecting an earlier Decision Checkpoint cannot expand a context owner's authority.",
      "unit_id": "unit-a6aaa3a38fc28b4ec465bccfb486c16cd536a8dfbccc76cd2274dd25b0d26be1"
    },
    {
      "clause_id": "clause-12",
      "end_character": 178,
      "excerpt": "In CyberAlchemy Lab, definition, context, artifact-type, evidence, migration, and publication owners may resolve to the same person while retaining separate scopes and decisions.",
      "unit_id": "unit-aa0c6d93b9995bbe4ea7b40d3866fa2d6a4222b3bf96dfbbfb6b79371b7c4a99"
    },
    {
      "clause_id": "clause-13",
      "end_character": 41,
      "excerpt": "/home/vrondelli/projects/CyberAlchemy-lab",
      "unit_id": "unit-ffa309e64b53ab85866dd9c0bce78b5cb2d9a40913e906c9ea92bc3faa5b2ed5"
    },
    {
      "clause_id": "clause-14",
      "end_character": 140,
      "excerpt": "The exact limit around what a particular owner is allowed to decide. It says who can decide what; it does not say when a workflow asks them.",
      "unit_id": "unit-7c3a478b41c39f6580bc29b3cbdf6b5e7e1954652c6331011a09f3f844c3a155"
    },
    {
      "clause_id": "clause-15",
      "end_character": 79,
      "excerpt": "One principal holding multiple roles does not merge their Authority Boundaries.",
      "unit_id": "unit-9a50f434d63eb3a3f665068c20899e2f98e522c712cfd11dec7db50221fbda03"
    },
    {
      "clause_id": "clause-16",
      "end_character": 47,
      "excerpt": "A Decision Checkpoint does not grant authority.",
      "unit_id": "unit-c9d9e917d11ff12605db7d06ef7f472894172292b09072896a69711ab523525e"
    },
    {
      "clause_id": "clause-17",
      "end_character": 60,
      "excerpt": "Validation evidence cannot substitute for an owner decision.",
      "unit_id": "unit-507eb8343423904f8b3972d3a4ad497b57f3417d2ae4fc10dd8f0ca927c4fb02"
    },
    {
      "clause_id": "clause-18",
      "end_character": 278,
      "excerpt": "AuthorityBoundary(b) = (owner_role, principal_binding, authority_scope, allowed_effects, excluded_effects, challenge_route). MayDecide(p,d,b) iff Holds(p,b.owner_role) and Target(d) in b.authority_scope and Effect(d) in b.allowed_effects and Effect(d) not in b.excluded_effects.",
      "unit_id": "unit-ca8d25f8b1fad6b4d10c784017c0bbd43d3cfcbdcaf8978e946826c1c1094390"
    },
    {
      "clause_id": "clause-19",
      "end_character": 447,
      "excerpt": "An Authority Boundary is the explicit owner-scoped limit within which one role may make Governance Decisions about named meanings, targets, and effects. It binds an owner role, an accountable principal binding, an authority scope, allowed effects, excluded effects, and a challenge route. An Authority Boundary is independent of where a workflow requests a decision, and no workflow profile or user preference may create, move, merge, or widen it.",
      "unit_id": "unit-c64d2327c1be9f273a6eef684e96aebcd8d00a760f80b3beda1d174c902bd887"
    },
    {
      "clause_id": "clause-20",
      "end_character": 29,
      "excerpt": "One exact Authority Boundary.",
      "unit_id": "unit-f30f3ca24c3496bb488ed706fc4fd91818af4f994db9feafa28096e587be7b9a"
    },
    {
      "clause_id": "clause-21",
      "end_character": 1,
      "excerpt": "b",
      "unit_id": "unit-d3c1aec8e7de480713dfb488ee2bbea24d3e97f27720724fe4b52f73c67c8649"
    },
    {
      "clause_id": "clause-22",
      "end_character": 30,
      "excerpt": "One exact Governance Decision.",
      "unit_id": "unit-9b85492c29cca00ac205f1ce227eac157ca590e60c4d065998b19deaeac4fa62"
    },
    {
      "clause_id": "clause-23",
      "end_character": 1,
      "excerpt": "d",
      "unit_id": "unit-3223125f66cb1d6b49edd61c46775419b5343ab2dd4b980af9917774ad244eef"
    },
    {
      "clause_id": "clause-24",
      "end_character": 53,
      "excerpt": "The accountable principal acting under an owner role.",
      "unit_id": "unit-999881da2a609e910396b549bf15eb003503d8ae08924e2364d7fcfcb83f3ef6"
    },
    {
      "clause_id": "clause-25",
      "end_character": 1,
      "excerpt": "p",
      "unit_id": "unit-93943e35bdc29f79f51c45cb09a802e00347bf2b77d5293deeb83f1b9953e06c"
    },
    {
      "clause_id": "clause-26",
      "end_character": 69,
      "excerpt": "Every decision resolves an explicit owner role and principal binding.",
      "unit_id": "unit-7748cf7d10d9c26b7bb98acb06c92c43baa3453915e313fd869f0de9c83531b2"
    },
    {
      "clause_id": "clause-27",
      "end_character": 76,
      "excerpt": "Every decision target and effect are within the selected Authority Boundary.",
      "unit_id": "unit-00dd8aba81fa46af9b120f2ccd8b0619d4e21489fa585402500761b3c1e069f7"
    },
    {
      "clause_id": "clause-28",
      "end_character": 75,
      "excerpt": "No workflow or preference field changes authority scope or allowed effects.",
      "unit_id": "unit-7c7b5ee823e404af1c720f396c6054ed86aeaead875085559b10fbd859c6c204"
    }
  ],
