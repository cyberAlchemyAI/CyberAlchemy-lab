{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cyberalchemy-lab:classification-preparation-routing:v1-candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope_ref", "source_cut", "proposal_binding", "rule_source_binding", "rule_proof_binding", "record_basis", "authority_effect", "actual_owner_outcome"],
  "properties": {
    "schema_version": {"const": "lab-classification-preparation-routing/v1-candidate"},
    "scope_ref": {"type": "string", "minLength": 1},
    "source_cut": {"$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/source_cut"},
    "proposal_binding": {"$ref": "#/$defs/binding"},
    "rule_source_binding": {"$ref": "#/$defs/binding"},
    "rule_proof_binding": {"$ref": "#/$defs/binding"},
    "record_basis": {"const": "current-plus-exact-prospective-postimage"},
    "authority_effect": {"const": "none"},
    "actual_owner_outcome": {"type": "null"}
  },
  "$defs": {
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
