{
  "$id": "urn:cyberalchemy-lab:protocol:tool-adapter-contract:v1-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapter_ref": {
      "minLength": 1,
      "type": "string"
    },
    "allowed_action_kinds": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "authority_effect": {
      "const": "none"
    },
    "compensation_binding": {
      "anyOf": [
        {
          "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
        },
        {
          "type": "null"
        }
      ]
    },
    "effect_scope_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "external_effect_refs": {
      "maxItems": 0,
      "type": "array"
    },
    "failure_mode_refs": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"
      },
      "minItems": 0,
      "type": "array"
    },
    "implementation": {
      "allOf": [
        {
          "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"
        },
        {
          "properties": {
            "carrier_ref": {
              "const": "cal.artifact-type.implementation/v1"
            }
          }
        }
      ]
    },
    "input_schema_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "output_schema_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "reconciliation_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "retry_semantics": {
      "enum": [
        "read-only",
        "idempotent",
        "non-idempotent"
      ]
    },
    "runtime_activations": {
      "const": 0
    },
    "schema_version": {
      "const": "lab-tool-adapter-contract/v1-candidate"
    },
    "tool": {
      "allOf": [
        {
          "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"
        },
        {
          "properties": {
            "carrier_ref": {
              "const": "cal.artifact-type.tool/v1"
            }
          }
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "adapter_ref",
    "tool",
    "implementation",
    "input_schema_binding",
    "output_schema_binding",
    "allowed_action_kinds",
    "effect_scope_refs",
    "retry_semantics",
    "reconciliation_binding",
    "compensation_binding",
    "failure_mode_refs",
    "runtime_activations",
    "external_effect_refs",
    "authority_effect"
  ],
  "title": "Candidate Lab tool-adapter-contract",
  "type": "object"
}
