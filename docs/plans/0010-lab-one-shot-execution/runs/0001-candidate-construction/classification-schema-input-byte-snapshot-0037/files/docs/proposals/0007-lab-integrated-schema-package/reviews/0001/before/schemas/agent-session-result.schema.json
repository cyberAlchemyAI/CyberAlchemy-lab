{
  "$id": "urn:cyberalchemy-lab:protocol:agent-session-result:v1-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_instance_ref": {
      "minLength": 1,
      "type": "string"
    },
    "assignment": {
      "allOf": [
        {
          "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"
        },
        {
          "properties": {
            "carrier_ref": {
              "const": "cal.artifact-type.agent-assignment/v1"
            }
          }
        }
      ]
    },
    "authority_effect": {
      "const": "none"
    },
    "context_delivery_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "durable_continuity_source": {
      "const": "project-state-via-context-and-ontology-views"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "gaps": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/gap"
      },
      "minItems": 0,
      "type": "array"
    },
    "memory_persistence_allowed": {
      "const": false
    },
    "posture": {
      "enum": [
        "active",
        "blocked"
      ]
    },
    "request_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "schema_version": {
      "const": "lab-agent-session-result/v1-candidate"
    },
    "session_ref": {
      "minLength": 1,
      "type": "string"
    },
    "source_cut": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/source_cut"
    },
    "started_at": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "request_binding",
    "session_ref",
    "agent_instance_ref",
    "assignment",
    "context_delivery_binding",
    "source_cut",
    "started_at",
    "expires_at",
    "memory_persistence_allowed",
    "durable_continuity_source",
    "posture",
    "gaps",
    "authority_effect"
  ],
  "title": "Candidate Lab agent-session-result",
  "type": "object"
}
