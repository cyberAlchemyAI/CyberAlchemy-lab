{
  "$id": "urn:cyberalchemy-lab:candidate-storage:artifact-package-manifest:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "committed-package"
          }
        }
      },
      "then": {
        "properties": {
          "commit_binding_ref": {
            "minLength": 1,
            "type": "string"
          }
        }
      }
    }
  ],
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "commit_binding_ref": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "content_file": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "const": "content.jsonl"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "type": "object"
    },
    "dependency_bindings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "ref": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "ref",
          "sha256"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array"
    },
    "materials": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "role": {
                  "enum": [
                    "artifact-revision",
                    "typed-relation"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "artifact_binding": {
                  "additionalProperties": false,
                  "properties": {
                    "carrier_ref": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "identity_ref": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "identity_selector": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "schema_content_ref": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "schema_selector": {
                      "minLength": 1,
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "semantic_kind": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "version_ref": {
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "identity_ref",
                    "version_ref",
                    "carrier_ref",
                    "schema_content_ref",
                    "schema_selector",
                    "identity_selector",
                    "semantic_kind"
                  ],
                  "type": "object"
                }
              }
            }
          }
        ],
        "properties": {
          "artifact_binding": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "carrier_ref": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "identity_ref": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "identity_selector": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "schema_content_ref": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "schema_selector": {
                    "minLength": 1,
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "semantic_kind": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "version_ref": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "identity_ref",
                  "version_ref",
                  "carrier_ref",
                  "schema_content_ref",
                  "schema_selector",
                  "identity_selector",
                  "semantic_kind"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "byte_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "content_ref": {
            "minLength": 1,
            "type": "string"
          },
          "role": {
            "enum": [
              "artifact-revision",
              "schema",
              "typed-relation",
              "semantic-event",
              "governance-event",
              "decision-core",
              "authorization",
              "consequence",
              "receipt",
              "evidence",
              "source-document"
            ]
          },
          "size_bytes": {
            "minimum": 0,
            "type": "integer"
          },
          "source_locator": {
            "minLength": 1,
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "content_ref",
          "role",
          "byte_sha256",
          "size_bytes",
          "source_locator",
          "artifact_binding"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "mode": {
      "enum": [
        "review-candidate",
        "committed-package"
      ]
    },
    "package_ref": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "lab-artifact-package-manifest/v1-candidate"
    },
    "scope_ref": {
      "minLength": 1,
      "type": "string"
    },
    "serialization_profile_ref": {
      "minLength": 1,
      "type": "string"
    },
    "source_cut": {
      "additionalProperties": false,
      "properties": {
        "branch_ref": {
          "minLength": 1,
          "type": "string"
        },
        "commit_sequence": {
          "minimum": 0,
          "type": "integer"
        },
        "commit_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "source_profile_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "store_ref": {
          "minLength": 1,
          "type": "string"
        },
        "streams": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "cursor": {
                "minimum": 0,
                "type": "integer"
              },
              "head_sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "stream_ref": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "stream_ref",
              "cursor",
              "head_sha256"
            ],
            "type": "object"
          },
          "minItems": 0,
          "type": "array"
        }
      },
      "required": [
        "store_ref",
        "branch_ref",
        "commit_sequence",
        "commit_sha256",
        "source_profile_sha256",
        "streams"
      ],
      "type": "object"
    },
    "transaction_record_ref": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "package_ref",
    "scope_ref",
    "source_cut",
    "mode",
    "authority_effect",
    "content_file",
    "materials",
    "dependency_bindings",
    "transaction_record_ref",
    "commit_binding_ref",
    "serialization_profile_ref",
    "claim_ceiling"
  ],
  "title": "Proposed artifact-package-manifest protocol",
  "type": "object"
}
