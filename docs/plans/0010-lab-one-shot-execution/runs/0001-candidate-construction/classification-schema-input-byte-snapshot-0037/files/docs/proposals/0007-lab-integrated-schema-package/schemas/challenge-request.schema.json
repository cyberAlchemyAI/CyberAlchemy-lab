{
  "$id": "urn:cyberalchemy-lab:protocol:challenge-request:v1-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/actor"
    },
    "authority_effect": {
      "const": "none"
    },
    "challenge_candidate_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "challenge_contract": {
      "allOf": [
        {
          "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"
        },
        {
          "properties": {
            "carrier_ref": {
              "const": "cal.artifact-type.challenge-contract/v1"
            }
          }
        }
      ]
    },
    "eligibility_evaluation_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "evidence_bindings": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
      },
      "minItems": 1,
      "type": "array"
    },
    "ground": {
      "minLength": 1,
      "type": "string"
    },
    "request_ref": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "lab-challenge-request/v1-candidate"
    },
    "source_cut": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/source_cut"
    },
    "subject": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"
    }
  },
  "required": [
    "schema_version",
    "request_ref",
    "actor",
    "subject",
    "challenge_contract",
    "ground",
    "evidence_bindings",
    "eligibility_evaluation_binding",
    "challenge_candidate_binding",
    "source_cut",
    "authority_effect"
  ],
  "title": "Candidate Lab challenge-request",
  "type": "object"
}
