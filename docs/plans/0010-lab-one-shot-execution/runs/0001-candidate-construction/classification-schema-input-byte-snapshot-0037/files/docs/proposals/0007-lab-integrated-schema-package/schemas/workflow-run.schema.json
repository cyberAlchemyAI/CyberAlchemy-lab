{
  "$id": "urn:cyberalchemy-lab:protocol:workflow-run:v1-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/actor"
    },
    "authority_effect": {
      "const": "none"
    },
    "coordination_context": {
      "allOf": [
        {
          "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"
        },
        {
          "properties": {
            "carrier_ref": {
              "const": "cal.artifact-type.coordination-context/v2"
            }
          }
        }
      ]
    },
    "definition_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "event_bindings": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
      },
      "minItems": 0,
      "type": "array"
    },
    "gaps": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/gap"
      },
      "minItems": 0,
      "type": "array"
    },
    "intent": {
      "allOf": [
        {
          "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"
        },
        {
          "properties": {
            "carrier_ref": {
              "const": "cal.artifact-type.intent/v1"
            }
          }
        }
      ]
    },
    "intent_resolution": {
      "allOf": [
        {
          "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"
        },
        {
          "properties": {
            "carrier_ref": {
              "const": "cal.artifact-type.intent-resolution/v1"
            }
          }
        }
      ]
    },
    "outcome_assessment": {
      "anyOf": [
        {
          "allOf": [
            {
              "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"
            },
            {
              "properties": {
                "carrier_ref": {
                  "const": "cal.artifact-type.work-outcome-assessment/v1"
                }
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "run_ref": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "lab-workflow-run/v1-candidate"
    },
    "source_cut": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/source_cut"
    },
    "state": {
      "minLength": 1,
      "type": "string"
    },
    "work": {
      "allOf": [
        {
          "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"
        },
        {
          "properties": {
            "carrier_ref": {
              "const": "cal.artifact-type.work/v1"
            }
          }
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "run_ref",
    "definition_binding",
    "intent",
    "intent_resolution",
    "work",
    "coordination_context",
    "actor",
    "source_cut",
    "state",
    "event_bindings",
    "outcome_assessment",
    "gaps",
    "authority_effect"
  ],
  "title": "Candidate Lab workflow-run",
  "type": "object"
}
