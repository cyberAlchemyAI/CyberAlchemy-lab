{
  "$id": "urn:cyberalchemy-lab:protocol:review-package:v1-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "all_targets_materialized": {
      "const": true
    },
    "atomicity_requirement": {
      "const": "all-or-nothing"
    },
    "authority_effect": {
      "const": "none"
    },
    "base_cut": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/source_cut"
    },
    "checkpoint": {
      "allOf": [
        {
          "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"
        },
        {
          "properties": {
            "carrier_ref": {
              "const": "cal.artifact-type.decision-checkpoint/v1"
            }
          }
        }
      ]
    },
    "decision_bundle": {
      "allOf": [
        {
          "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"
        },
        {
          "properties": {
            "carrier_ref": {
              "const": "cal.artifact-type.decision-bundle/v1"
            }
          }
        }
      ]
    },
    "example_bindings": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
      },
      "minItems": 1,
      "type": "array"
    },
    "human_checkpoint_count": {
      "const": 1
    },
    "invalidation_conditions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "manifest_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "operational_instruction_bindings": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
      },
      "minItems": 0,
      "type": "array"
    },
    "ordered_core_bindings": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
      },
      "minItems": 1,
      "type": "array"
    },
    "package_ref": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "lab-review-package/v1-candidate"
    },
    "validation_bindings": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
      },
      "minItems": 1,
      "type": "array"
    },
    "workflow_decision_profile": {
      "allOf": [
        {
          "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"
        },
        {
          "properties": {
            "carrier_ref": {
              "const": "cal.artifact-type.workflow-decision-profile/v1"
            }
          }
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "package_ref",
    "base_cut",
    "manifest_binding",
    "decision_bundle",
    "checkpoint",
    "workflow_decision_profile",
    "ordered_core_bindings",
    "validation_bindings",
    "example_bindings",
    "operational_instruction_bindings",
    "all_targets_materialized",
    "human_checkpoint_count",
    "atomicity_requirement",
    "invalidation_conditions",
    "authority_effect"
  ],
  "title": "Candidate Lab review-package",
  "type": "object"
}
