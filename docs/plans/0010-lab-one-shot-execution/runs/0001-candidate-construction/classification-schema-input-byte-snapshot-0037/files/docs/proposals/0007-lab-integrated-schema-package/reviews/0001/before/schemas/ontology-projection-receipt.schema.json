{
  "$id": "urn:cyberalchemy-lab:protocol:ontology-projection-receipt:v1-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "gaps": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/gap"
      },
      "minItems": 0,
      "type": "array"
    },
    "lab_source_cut": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/source_cut"
    },
    "mapping_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "ontology_applied_cut": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/source_cut"
    },
    "ontology_view": {
      "allOf": [
        {
          "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"
        },
        {
          "properties": {
            "carrier_ref": {
              "const": "cal.artifact-type.ontology-view/v1"
            }
          }
        }
      ]
    },
    "posture": {
      "enum": [
        "applied",
        "pending",
        "blocked"
      ]
    },
    "represented_refs": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"
      },
      "minItems": 0,
      "type": "array"
    },
    "request_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "schema_version": {
      "const": "lab-ontology-projection-receipt/v1-candidate"
    }
  },
  "required": [
    "schema_version",
    "request_binding",
    "lab_source_cut",
    "ontology_applied_cut",
    "mapping_binding",
    "represented_refs",
    "ontology_view",
    "posture",
    "gaps",
    "claim_ceiling",
    "authority_effect"
  ],
  "title": "Candidate Lab ontology-projection-receipt",
  "type": "object"
}
