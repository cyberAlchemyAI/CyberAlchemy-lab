{
  "$id": "urn:cyberalchemy-lab:protocol:commit-record:v1-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "enum": [
        "local-artifact-admission",
        "repository-artifact-admission"
      ]
    },
    "authorization_evidence_bindings": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
      },
      "minItems": 1,
      "type": "array"
    },
    "commit_ref": {
      "minLength": 1,
      "type": "string"
    },
    "consequence_bindings": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
      },
      "minItems": 0,
      "type": "array"
    },
    "content_package_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "decision_core_bindings": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
      },
      "minItems": 1,
      "type": "array"
    },
    "external_effect_refs": {
      "maxItems": 0,
      "type": "array"
    },
    "governance_event_bindings": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
      },
      "minItems": 0,
      "type": "array"
    },
    "input_cut": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/source_cut"
    },
    "previous_commit_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "proposal_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "resolution_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "runtime_activations": {
      "const": 0
    },
    "schema_version": {
      "const": "lab-commit-record/v1-candidate"
    },
    "scope_ref": {
      "minLength": 1,
      "type": "string"
    },
    "semantic_event_bindings": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
      },
      "minItems": 0,
      "type": "array"
    },
    "sequence": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "commit_ref",
    "scope_ref",
    "sequence",
    "previous_commit_sha256",
    "input_cut",
    "proposal_binding",
    "resolution_binding",
    "content_package_binding",
    "decision_core_bindings",
    "semantic_event_bindings",
    "governance_event_bindings",
    "consequence_bindings",
    "authorization_evidence_bindings",
    "authority_effect",
    "runtime_activations",
    "external_effect_refs"
  ],
  "title": "Candidate Lab commit-record",
  "type": "object"
}
