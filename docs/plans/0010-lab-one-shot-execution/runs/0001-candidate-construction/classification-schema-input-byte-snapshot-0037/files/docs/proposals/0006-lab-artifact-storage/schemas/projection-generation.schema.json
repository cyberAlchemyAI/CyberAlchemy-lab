{
  "$id": "urn:cyberalchemy-lab:candidate-storage:projection-generation:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "canonical_replay_source": {
      "const": false
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "contract_catalog_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "coverage": {
      "additionalProperties": false,
      "properties": {
        "artifact_revisions": {
          "minimum": 0,
          "type": "integer"
        },
        "resolved_references": {
          "minimum": 0,
          "type": "integer"
        },
        "typed_relations": {
          "minimum": 0,
          "type": "integer"
        },
        "unresolved_references": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "artifact_revisions",
        "typed_relations",
        "resolved_references",
        "unresolved_references"
      ],
      "type": "object"
    },
    "derived_rows_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "generation_ref": {
      "minLength": 1,
      "type": "string"
    },
    "posture": {
      "enum": [
        "building",
        "ready",
        "stale",
        "invalidated"
      ]
    },
    "projector_binding": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "sha256"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "lab-artifact-projection-generation/v1-candidate"
    },
    "source_cut": {
      "additionalProperties": false,
      "properties": {
        "branch_ref": {
          "minLength": 1,
          "type": "string"
        },
        "commit_sequence": {
          "minimum": 0,
          "type": "integer"
        },
        "commit_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "source_profile_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "store_ref": {
          "minLength": 1,
          "type": "string"
        },
        "streams": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "cursor": {
                "minimum": 0,
                "type": "integer"
              },
              "head_sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "stream_ref": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "stream_ref",
              "cursor",
              "head_sha256"
            ],
            "type": "object"
          },
          "minItems": 0,
          "type": "array"
        }
      },
      "required": [
        "store_ref",
        "branch_ref",
        "commit_sequence",
        "commit_sha256",
        "source_profile_sha256",
        "streams"
      ],
      "type": "object"
    },
    "source_verification_ref": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "generation_ref",
    "source_cut",
    "projector_binding",
    "contract_catalog_sha256",
    "derived_rows_sha256",
    "source_verification_ref",
    "posture",
    "coverage",
    "canonical_replay_source",
    "authority_effect",
    "claim_ceiling"
  ],
  "title": "Proposed projection-generation protocol",
  "type": "object"
}
