{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/product-identity/v1",
  "title": "CyberAlchemy Lab Product Identity v1 candidate instance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_id",
    "version",
    "name",
    "status",
    "authority_effect",
    "semantic_definition_refs",
    "purpose",
    "scope",
    "semantic_owner_ref",
    "lineage_ref",
    "evidence_refs",
    "challenge_route",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "cyberalchemy-lab-product-identity/v1"
    },
    "product_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "authority_effect": {
      "const": "none"
    },
    "semantic_definition_refs": {
      "const": [
        "cal.definition.product@1.0.0-candidate.1",
        "cal.definition.identity-carrier@1.0.0-candidate.1"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "semantic_owner_ref": {
      "type": "string",
      "minLength": 1
    },
    "lineage_ref": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "$ref": "#/$defs/nonEmptyUniqueStrings"
    },
    "challenge_route": {
      "type": "string",
      "minLength": 1
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "includes",
        "excludes"
      ],
      "properties": {
        "includes": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "excludes": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_ref",
        "identity_kind"
      ],
      "properties": {
        "identity_ref": {
          "type": "string",
          "minLength": 1
        },
        "identity_kind": {
          "enum": [
            "product",
            "project",
            "method",
            "goal"
          ]
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_id",
        "relation_kind",
        "source_ref",
        "target_ref"
      ],
      "properties": {
        "relation_id": {
          "type": "string",
          "minLength": 1
        },
        "relation_kind": {
          "enum": [
            "contains_product",
            "coordinated_by",
            "embodies_method",
            "uses_method",
            "pursues_goal"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "target_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
