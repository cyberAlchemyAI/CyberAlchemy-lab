{
  "$id": "https://cyberalchemy.local/schemas/challenge-event/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "minLength": 1,
      "type": "string"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "kind": {
      "const": "challenge-event"
    },
    "lifecycle_state": {
      "enum": [
        "candidate",
        "active",
        "historical",
        "retired"
      ]
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "node_id": {
      "minLength": 1,
      "type": "string"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "challenge_contract_ref": {
          "minLength": 1,
          "type": "string"
        },
        "challenger_ref": {
          "minLength": 1,
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "ground": {
          "minLength": 1,
          "type": "string"
        },
        "residue_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "resolution_decision_ref": {
          "minLength": 1,
          "type": "string"
        },
        "response_state": {
          "minLength": 1,
          "type": "string"
        },
        "subject_ref": {
          "minLength": 1,
          "type": "string"
        },
        "subject_version_ref": {
          "minLength": 1,
          "type": "string"
        },
        "submitted_at": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "challenge_contract_ref",
        "challenger_ref",
        "subject_ref",
        "subject_version_ref",
        "ground",
        "evidence_refs",
        "submitted_at",
        "response_state",
        "resolution_decision_ref",
        "residue_refs"
      ],
      "type": "object"
    },
    "relation_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "counterpart_kind": {
            "enum": [
              "agent-action",
              "agent-assignment",
              "agent-capability",
              "agent-instance",
              "agent-profile",
              "agent-reflection",
              "agent-session",
              "artifact-type",
              "artifact-type-request",
              "authority-claim",
              "bounded-context",
              "canonical-package-manifest",
              "capability-instance",
              "capability-realization-binding",
              "challenge-contract",
              "challenge-event",
              "classification-assignment",
              "classification-scheme",
              "classification-value",
              "communication-preference",
              "constitution",
              "context",
              "context-lineage-record",
              "context-map",
              "context-migration-manifest",
              "context-profile",
              "context-request",
              "context-view",
              "contract",
              "decision",
              "decision-scope",
              "definition",
              "delegation",
              "drift-assessment",
              "effect",
              "evaluation",
              "evidence-set",
              "experiment-design",
              "experiment-run",
              "failure-assessment",
              "failure-control-binding",
              "failure-mode",
              "failure-occurrence",
              "feedback-record",
              "finding",
              "generated-output",
              "goal",
              "governance-event-history",
              "governed-model",
              "hypothesis",
              "identity-claim",
              "implementation",
              "improvement-signal",
              "improvement-target",
              "incident",
              "intent-resolution",
              "lesson-application",
              "lesson-outcome-assessment",
              "measurement-method",
              "measurement-result",
              "method",
              "model-instance-binding",
              "observation",
              "ontology",
              "ontology-cut",
              "ontology-edge",
              "ontology-manifest",
              "ontology-node",
              "ontology-package",
              "ontology-view",
              "operational-lesson",
              "operational-observation",
              "person",
              "person-reference",
              "policy",
              "preference-application-assessment",
              "principal",
              "principal-reference",
              "product",
              "product-capability",
              "product-thesis",
              "project",
              "project-state",
              "relation-kind",
              "research-inquiry",
              "research-run",
              "responsibility",
              "review",
              "role",
              "role-assignment",
              "schema",
              "semantic-event-history",
              "source",
              "team",
              "team-membership",
              "tool",
              "typed-relation",
              "ubiquitous-language",
              "work",
              "work-outcome-assessment"
            ]
          },
          "counterpart_ref": {
            "minLength": 1,
            "type": "string"
          },
          "direction": {
            "enum": [
              "source",
              "target"
            ]
          },
          "relation_kind_ref": {
            "enum": [
              "relation.challenges",
              "relation.declares-effect-on",
              "relation.evidence-bears-on",
              "relation.governed-by",
              "relation.produces",
              "relation.successor-of"
            ]
          }
        },
        "required": [
          "relation_kind_ref",
          "direction",
          "counterpart_kind",
          "counterpart_ref"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "cyberalchemy-lab-challenge-event/v1"
    },
    "scope_ref": {
      "minLength": 1,
      "type": "string"
    },
    "successor_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "node_id",
    "kind",
    "name",
    "lifecycle_state",
    "authority_effect",
    "owner_ref",
    "scope_ref",
    "evidence_refs",
    "challenge_route",
    "successor_refs",
    "relation_refs",
    "payload",
    "claim_ceiling"
  ],
  "type": "object"
}
