{
  "$id": "https://cyberalchemy.local/schemas/contract/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "minLength": 1,
      "type": "string"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "kind": {
      "const": "contract"
    },
    "lifecycle_state": {
      "enum": [
        "candidate",
        "active",
        "historical",
        "retired"
      ]
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "node_id": {
      "minLength": 1,
      "type": "string"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "breach_route": {
          "minLength": 1,
          "type": "string"
        },
        "obligation_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "party_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "permission_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "prohibition_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "subject_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "party_refs",
        "subject_refs",
        "obligation_refs",
        "permission_refs",
        "prohibition_refs",
        "breach_route"
      ],
      "type": "object"
    },
    "relation_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "counterpart_kind": {
            "enum": [
              "capability-instance",
              "contract"
            ]
          },
          "counterpart_ref": {
            "minLength": 1,
            "type": "string"
          },
          "direction": {
            "enum": [
              "source",
              "target"
            ]
          },
          "relation_kind_ref": {
            "enum": [
              "relation.conforms-to",
              "relation.inherits-contract",
              "relation.successor-of"
            ]
          }
        },
        "required": [
          "relation_kind_ref",
          "direction",
          "counterpart_kind",
          "counterpart_ref"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "cyberalchemy-lab-contract/v1"
    },
    "scope_ref": {
      "minLength": 1,
      "type": "string"
    },
    "successor_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "node_id",
    "kind",
    "name",
    "lifecycle_state",
    "authority_effect",
    "owner_ref",
    "scope_ref",
    "evidence_refs",
    "challenge_route",
    "successor_refs",
    "relation_refs",
    "payload",
    "claim_ceiling"
  ],
  "type": "object"
}
