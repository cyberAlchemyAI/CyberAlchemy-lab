{
  "$id": "https://cyberalchemy.local/runtime/session-memory/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "expires_with_session": {
      "const": true
    },
    "persistence_allowed": {
      "const": false
    },
    "recent_action_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "selected_input_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "session_ref": {
      "minLength": 1,
      "type": "string"
    },
    "tool_result_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "unresolved_questions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "working_record_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "session_ref",
    "selected_input_refs",
    "working_record_refs",
    "recent_action_refs",
    "tool_result_refs",
    "unresolved_questions",
    "expires_with_session",
    "persistence_allowed"
  ],
  "type": "object"
}
