{
  "$defs": {
    "binding": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "sha256"
      ],
      "type": "object"
    }
  },
  "$id": "urn:cyberalchemy-lab:failure-preparation-routing:v1-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actual_owner_outcome": {
      "type": "null"
    },
    "authority_effect": {
      "const": "none"
    },
    "axis_basis_binding": {
      "$ref": "#/$defs/binding"
    },
    "incident_threshold_binding": {
      "anyOf": [
        {
          "$ref": "#/$defs/binding"
        },
        {
          "type": "null"
        }
      ]
    },
    "proposal_binding": {
      "$ref": "#/$defs/binding"
    },
    "record_basis": {
      "const": "current-plus-exact-prospective-postimage"
    },
    "rule_proof_binding": {
      "$ref": "#/$defs/binding"
    },
    "rule_source_binding": {
      "$ref": "#/$defs/binding"
    },
    "schema_version": {
      "const": "lab-failure-preparation-routing/v1-candidate"
    },
    "scope_ref": {
      "minLength": 1,
      "type": "string"
    },
    "source_cut": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/source_cut"
    }
  },
  "required": [
    "schema_version",
    "scope_ref",
    "source_cut",
    "proposal_binding",
    "rule_source_binding",
    "rule_proof_binding",
    "record_basis",
    "authority_effect",
    "actual_owner_outcome",
    "axis_basis_binding",
    "incident_threshold_binding"
  ],
  "type": "object"
}
