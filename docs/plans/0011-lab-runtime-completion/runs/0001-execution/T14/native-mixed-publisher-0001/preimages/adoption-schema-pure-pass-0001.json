{
  "$id": "urn:lab:T14:native-mixed-adoption:v1-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "boundary": {
      "type": "object"
    },
    "boundary_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "extension_packages": {
      "type": "object"
    },
    "identity_path": {
      "minLength": 1,
      "type": "string"
    },
    "identity_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "mirrors": {
      "type": "array"
    },
    "native_selection": {
      "type": "object"
    },
    "output_roles": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "receipt_root": {
      "minLength": 1,
      "type": "string"
    },
    "receipt_root_identity": {
      "items": false,
      "minItems": 4,
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        },
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "type": "array"
    },
    "review_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "lab-T14-native-mixed-adoption/v1-candidate"
    },
    "selections": {
      "items": {
        "type": "object"
      },
      "maxItems": 1000,
      "minItems": 1,
      "type": "array"
    },
    "status": {
      "const": "independently-selected-active"
    }
  },
  "required": [
    "boundary",
    "native_selection",
    "receipt_root",
    "identity_path",
    "boundary_sha256",
    "review_sha256",
    "identity_sha256",
    "receipt_root_identity",
    "selections",
    "extension_packages",
    "mirrors",
    "output_roles",
    "schema_version",
    "status",
    "authority_effect"
  ],
  "type": "object"
}
