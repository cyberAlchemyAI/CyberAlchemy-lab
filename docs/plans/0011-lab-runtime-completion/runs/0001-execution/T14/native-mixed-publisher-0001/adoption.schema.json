{
  "$id": "urn:lab:T14:native-mixed-adoption:v1-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "boundary": {
      "additionalProperties": false,
      "properties": {
        "authority_effect": {
          "const": "none"
        },
        "expires_at": {
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?(?:Z|\\+00:00)$",
          "type": "string"
        },
        "native_branch_ref": {
          "minLength": 1,
          "type": "string"
        },
        "native_store_ref": {
          "minLength": 1,
          "type": "string"
        },
        "operation": {
          "minLength": 1,
          "type": "string"
        },
        "permission_snapshot": {
          "minProperties": 1,
          "type": "object"
        },
        "principal_ref": {
          "minLength": 1,
          "type": "string"
        },
        "profile_binding": {
          "additionalProperties": false,
          "properties": {
            "ref": {
              "minLength": 1,
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "ref",
            "sha256"
          ],
          "type": "object"
        },
        "schema_version": {
          "const": "lab-mixed-native-current-boundary/v1-candidate"
        },
        "source_binding": {
          "additionalProperties": false,
          "properties": {
            "ref": {
              "minLength": 1,
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "ref",
            "sha256"
          ],
          "type": "object"
        },
        "source_cut": {
          "minProperties": 1,
          "type": "object"
        },
        "work_ref": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "source_binding",
        "profile_binding",
        "source_cut",
        "principal_ref",
        "work_ref",
        "native_store_ref",
        "native_branch_ref",
        "operation",
        "permission_snapshot",
        "expires_at",
        "authority_effect"
      ],
      "type": "object"
    },
    "boundary_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "extension_packages": {
      "type": "object"
    },
    "identity_path": {
      "minLength": 1,
      "type": "string"
    },
    "identity_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "mirrors": {
      "type": "array"
    },
    "native_selection": {
      "additionalProperties": false,
      "properties": {
        "event_files": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "minProperties": 1,
          "type": "object"
        },
        "generation": {
          "pattern": "^operation-[0-9a-f]{32}$",
          "type": "string"
        },
        "head_binding": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "minLength": 1,
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "type": "object"
        },
        "projection_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "review_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "source_cut": {
          "minProperties": 1,
          "type": "object"
        },
        "witness_correspondence": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "target_version_ref": {
                "minLength": 1,
                "type": "string"
              },
              "witness_pointer": {
                "pattern": "^/",
                "type": "string"
              },
              "witness_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "target_version_ref",
              "witness_pointer",
              "witness_sha256"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "head_binding",
        "generation",
        "event_files",
        "projection_sha256",
        "source_cut",
        "review_sha256",
        "witness_correspondence"
      ],
      "type": "object"
    },
    "output_roles": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "receipt_root": {
      "minLength": 1,
      "type": "string"
    },
    "receipt_root_identity": {
      "items": false,
      "minItems": 4,
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        },
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "type": "array"
    },
    "replay_root": {
      "minLength": 1,
      "type": "string"
    },
    "replay_root_identity": {
      "items": false,
      "minItems": 4,
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        },
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "type": "array"
    },
    "review_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "lab-T14-native-mixed-adoption/v1-candidate"
    },
    "selections": {
      "items": {
        "type": "object"
      },
      "maxItems": 1000,
      "minItems": 1,
      "type": "array"
    },
    "status": {
      "const": "independently-selected-active"
    }
  },
  "required": [
    "authority_effect",
    "boundary",
    "boundary_sha256",
    "extension_packages",
    "identity_path",
    "identity_sha256",
    "mirrors",
    "native_selection",
    "output_roles",
    "receipt_root",
    "receipt_root_identity",
    "review_sha256",
    "schema_version",
    "selections",
    "status",
    "replay_root",
    "replay_root_identity"
  ],
  "type": "object"
}
