{
  "$defs": {
    "binding": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "path": {
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$",
      "type": "string"
    },
    "sha": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    }
  },
  "$id": "urn:cal:full-learning-input-selection:v1-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_bootstrap_bindings": {
      "items": {
        "$ref": "#/$defs/binding"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "api_path": {
      "$ref": "#/$defs/path"
    },
    "application_method_binding": {
      "$ref": "#/$defs/binding"
    },
    "assessment_method_binding": {
      "$ref": "#/$defs/binding"
    },
    "authority_effect": {
      "const": "none"
    },
    "caller_boundary_binding": {
      "$ref": "#/$defs/binding"
    },
    "factory_module": {
      "const": "source_bridge"
    },
    "factory_name": {
      "const": "current_session_fixture_delivery"
    },
    "lifecycle_bindings": {
      "additionalProperties": false,
      "properties": {
        "positive": {
          "$ref": "#/$defs/binding"
        },
        "security": {
          "$ref": "#/$defs/binding"
        }
      },
      "required": [
        "positive",
        "security"
      ],
      "type": "object"
    },
    "period_binding": {
      "$ref": "#/$defs/binding"
    },
    "producer_root": {
      "$ref": "#/$defs/path"
    },
    "provider_binding": {
      "$ref": "#/$defs/binding"
    },
    "runtime_selection_binding": {
      "$ref": "#/$defs/binding"
    },
    "schema_version": {
      "const": "lab-full-learning-input-selection/v1-candidate"
    },
    "source_name": {
      "minLength": 1,
      "type": "string"
    },
    "source_package_pin": {
      "$ref": "#/$defs/sha"
    },
    "source_pin": {
      "$ref": "#/$defs/sha"
    }
  },
  "required": [
    "schema_version",
    "authority_effect",
    "api_path",
    "source_name",
    "factory_module",
    "factory_name",
    "producer_root",
    "source_pin",
    "source_package_pin",
    "runtime_selection_binding",
    "period_binding",
    "provider_binding",
    "caller_boundary_binding",
    "api_bootstrap_bindings",
    "application_method_binding",
    "assessment_method_binding",
    "lifecycle_bindings"
  ],
  "type": "object"
}
