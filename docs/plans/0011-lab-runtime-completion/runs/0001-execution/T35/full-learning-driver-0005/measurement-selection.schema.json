{
  "$id": "urn:cal:full-learning-measurement-selection:v1-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "cProfile_enabled": {
      "const": false
    },
    "collection_mode": {
      "const": "phase-only"
    },
    "monitoring_reservation": {
      "additionalProperties": false,
      "properties": {
        "tool_id": {
          "enum": [
            4,
            5
          ],
          "type": "integer"
        },
        "tool_name": {
          "const": "cal-full-learning-measurement-v2"
        }
      },
      "required": [
        "tool_id",
        "tool_name"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "lab-full-learning-measurement-selection/v1-candidate"
    }
  },
  "required": [
    "schema_version",
    "collection_mode",
    "monitoring_reservation",
    "cProfile_enabled",
    "authority_effect"
  ],
  "type": "object"
}
