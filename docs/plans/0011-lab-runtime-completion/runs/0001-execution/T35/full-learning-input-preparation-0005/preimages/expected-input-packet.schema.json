{
  "$defs": {
    "binding": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    }
  },
  "$id": "urn:cal:T35:final-input-packet:v4-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_bootstrap_bindings": {
      "items": {
        "$ref": "#/$defs/binding"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "application_method_binding": {
      "$ref": "#/$defs/binding"
    },
    "assessment_method_binding": {
      "$ref": "#/$defs/binding"
    },
    "authority_effect": {
      "const": "none"
    },
    "caller_boundary_binding": {
      "$ref": "#/$defs/binding"
    },
    "composition_binding": {
      "$ref": "#/$defs/binding"
    },
    "dependency_installation": {
      "minLength": 1,
      "type": "string"
    },
    "dependency_selection_binding": {
      "$ref": "#/$defs/binding"
    },
    "driver_binding": {
      "$ref": "#/$defs/binding"
    },
    "expected_monitor_tool": {
      "enum": [
        4,
        5
      ],
      "type": "integer"
    },
    "family_closure_acceptance_binding": {
      "$ref": "#/$defs/binding"
    },
    "family_closure_preview_binding": {
      "$ref": "#/$defs/binding"
    },
    "family_generation": {
      "enum": [
        4,
        5
      ],
      "type": "integer"
    },
    "family_instance": {
      "minLength": 1,
      "type": "string"
    },
    "final_profile_binding": {
      "$ref": "#/$defs/binding"
    },
    "final_source_binding": {
      "$ref": "#/$defs/binding"
    },
    "helper_bindings": {
      "additionalProperties": false,
      "properties": {
        "margin_capture": {
          "$ref": "#/$defs/binding"
        },
        "margin_kernel": {
          "$ref": "#/$defs/binding"
        },
        "margin_seal": {
          "$ref": "#/$defs/binding"
        },
        "observed_margin": {
          "$ref": "#/$defs/binding"
        }
      },
      "required": [
        "margin_capture",
        "margin_kernel",
        "margin_seal",
        "observed_margin"
      ],
      "type": "object"
    },
    "instrumentation_binding": {
      "$ref": "#/$defs/binding"
    },
    "lifecycle_bindings": {
      "additionalProperties": false,
      "properties": {
        "positive": {
          "$ref": "#/$defs/binding"
        },
        "security": {
          "$ref": "#/$defs/binding"
        }
      },
      "required": [
        "positive",
        "security"
      ],
      "type": "object"
    },
    "postselector_current_context_binding": {
      "$ref": "#/$defs/binding"
    },
    "preparer_binding": {
      "$ref": "#/$defs/binding"
    },
    "producer_root": {
      "minLength": 1,
      "type": "string"
    },
    "protected_control": {
      "additionalProperties": false,
      "properties": {
        "configuration_leaf": {
          "pattern": "^config-[0-9]{4}\\.json$",
          "type": "string"
        },
        "identity": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "root": {
          "pattern": "^/tmp/cal-T03-margin-[a-zA-Z0-9_-]+$",
          "type": "string"
        }
      },
      "required": [
        "root",
        "identity",
        "configuration_leaf"
      ],
      "type": "object"
    },
    "provider_binding": {
      "$ref": "#/$defs/binding"
    },
    "runtime_selection_binding": {
      "$ref": "#/$defs/binding"
    },
    "schema_version": {
      "const": "lab-T35-final-input-packet/v4-candidate"
    },
    "selection_output_leaf": {
      "pattern": "^selection-[0-9]{4}\\.json$",
      "type": "string"
    },
    "selection_output_root_identity": {
      "items": {
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    },
    "selection_schema_binding": {
      "$ref": "#/$defs/binding"
    },
    "selector_merge_review_binding": {
      "$ref": "#/$defs/binding"
    },
    "software_input_selection_binding": {
      "$ref": "#/$defs/binding"
    },
    "software_inventory_binding": {
      "$ref": "#/$defs/binding"
    },
    "source_name": {
      "minLength": 1,
      "type": "string"
    },
    "source_package_pin": {
      "minLength": 1,
      "type": "string"
    },
    "source_pin": {
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "const": "Root-selected-after-family-selector-merge-and-final-capture"
    }
  },
  "required": [
    "api_bootstrap_bindings",
    "application_method_binding",
    "assessment_method_binding",
    "authority_effect",
    "caller_boundary_binding",
    "composition_binding",
    "dependency_installation",
    "dependency_selection_binding",
    "driver_binding",
    "expected_monitor_tool",
    "family_closure_acceptance_binding",
    "family_closure_preview_binding",
    "family_generation",
    "family_instance",
    "final_profile_binding",
    "final_source_binding",
    "helper_bindings",
    "instrumentation_binding",
    "lifecycle_bindings",
    "postselector_current_context_binding",
    "preparer_binding",
    "producer_root",
    "protected_control",
    "provider_binding",
    "runtime_selection_binding",
    "schema_version",
    "selection_output_leaf",
    "selection_output_root_identity",
    "selection_schema_binding",
    "selector_merge_review_binding",
    "software_input_selection_binding",
    "software_inventory_binding",
    "source_name",
    "source_package_pin",
    "source_pin",
    "status"
  ],
  "type": "object"
}
