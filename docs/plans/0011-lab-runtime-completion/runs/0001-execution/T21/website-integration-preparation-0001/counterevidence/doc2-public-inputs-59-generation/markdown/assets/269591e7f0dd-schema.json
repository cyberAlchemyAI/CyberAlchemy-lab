{
  "$defs": {
    "domainVoice": {
      "additionalProperties": false,
      "properties": {
        "examples": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "explanation": {
          "minLength": 1,
          "type": "string"
        },
        "normative": {
          "const": false
        },
        "workspace_ref": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "normative",
        "workspace_ref",
        "explanation",
        "examples"
      ],
      "type": "object"
    },
    "formalVoice": {
      "additionalProperties": false,
      "properties": {
        "boundary_conditions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "formal_expression": {
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "normative_statement": {
          "minLength": 1,
          "type": "string"
        },
        "notation": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "meaning": {
                "minLength": 1,
                "type": "string"
              },
              "symbol": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "symbol",
              "meaning"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "testable_conditions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "normative_statement",
        "formal_expression",
        "notation",
        "boundary_conditions",
        "testable_conditions"
      ],
      "type": "object"
    },
    "plainVoice": {
      "additionalProperties": false,
      "properties": {
        "explanation": {
          "minLength": 1,
          "type": "string"
        },
        "normative": {
          "const": false
        }
      },
      "required": [
        "normative",
        "explanation"
      ],
      "type": "object"
    },
    "sourceRef": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "source_admission_ref": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "admission_posture": {
                "const": "admitted"
              }
            }
          },
          "then": {
            "properties": {
              "source_admission_ref": {
                "minLength": 1,
                "type": "string"
              }
            }
          }
        }
      ],
      "properties": {
        "admission_posture": {
          "enum": [
            "candidate-unadmitted",
            "admitted"
          ]
        },
        "content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "selector": {
          "minLength": 1,
          "type": "string"
        },
        "source_admission_ref": {
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "source_ref": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "source_ref",
        "selector",
        "content_sha256",
        "admission_posture",
        "source_admission_ref"
      ],
      "type": "object"
    },
    "typedRelation": {
      "additionalProperties": false,
      "properties": {
        "from_ref": {
          "minLength": 1,
          "type": "string"
        },
        "owner_ref": {
          "minLength": 1,
          "type": "string"
        },
        "relation_kind_ref": {
          "enum": [
            "relation.member-of",
            "relation.contributes-to",
            "relation.uses-method",
            "relation.evaluates",
            "relation.realizes",
            "relation.engages-inquiry",
            "relation.originates-from",
            "relation.derives-from",
            "relation.evidence-bears-on",
            "relation.governed-by",
            "relation.declares-effect-on",
            "relation.instance-of",
            "relation.binds-implementation",
            "relation.conforms-to",
            "relation.inherits-contract",
            "relation.frames",
            "relation.requests-resolution-of",
            "relation.fulfills-request",
            "relation.successor-of",
            "relation.assigned-to",
            "relation.asserts-identity-of",
            "relation.scopes-authority-over",
            "relation.carries-definition"
          ]
        },
        "to_ref": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "relation_kind_ref",
        "from_ref",
        "to_ref",
        "owner_ref"
      ],
      "type": "object"
    }
  },
  "$id": "https://cyberalchemy.local/schemas/definition/v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "aliases": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "boundaries": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "classification": {
      "additionalProperties": false,
      "properties": {
        "artifact_type_ref": {
          "const": "cal.artifact-type.definition/v2"
        },
        "authority_kind": {
          "const": "semantic-authority"
        },
        "lifecycle_posture_ref": {
          "minLength": 1,
          "type": "string"
        },
        "semantic_kind": {
          "const": "definition"
        }
      },
      "required": [
        "artifact_type_ref",
        "semantic_kind",
        "authority_kind",
        "lifecycle_posture_ref"
      ],
      "type": "object"
    },
    "definition_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    },
    "drift_route": {
      "additionalProperties": false,
      "properties": {
        "audit_ref": {
          "minLength": 1,
          "type": "string"
        },
        "challenge_ref": {
          "minLength": 1,
          "type": "string"
        },
        "owner_ref": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "owner_ref",
        "audit_ref",
        "challenge_ref"
      ],
      "type": "object"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "index_entry": {
      "additionalProperties": false,
      "properties": {
        "entry_id": {
          "minLength": 1,
          "type": "string"
        },
        "index_ref": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "index_ref",
        "entry_id"
      ],
      "type": "object"
    },
    "primary_consumer_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "residue_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "schema_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "schema_ref": {
      "const": "cal.schema.definition/v2"
    },
    "schema_version": {
      "const": "cyberalchemy-lab-definition/v2"
    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "minLength": 1,
          "type": "string"
        },
        "authority_scope_ref": {
          "minLength": 1,
          "type": "string"
        },
        "exclusions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "authority_scope_ref",
        "applicability",
        "exclusions"
      ],
      "type": "object"
    },
    "semantic_owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "source_direction": {
      "additionalProperties": false,
      "properties": {
        "canonical": {
          "const": "definition.json"
        },
        "generator_ref": {
          "const": "cal.generator.definition-markdown/v2"
        },
        "generator_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "human_projection": {
          "const": "DEFINITION.md"
        },
        "projection_policy": {
          "const": "generated-only"
        }
      },
      "required": [
        "canonical",
        "human_projection",
        "projection_policy",
        "generator_ref",
        "generator_sha256"
      ],
      "type": "object"
    },
    "source_refs": {
      "items": {
        "$ref": "#/$defs/sourceRef"
      },
      "type": "array"
    },
    "term": {
      "minLength": 1,
      "type": "string"
    },
    "typed_relations": {
      "items": {
        "$ref": "#/$defs/typedRelation"
      },
      "type": "array"
    },
    "version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "type": "string"
    },
    "voices": {
      "additionalProperties": false,
      "properties": {
        "domain_context": {
          "$ref": "#/$defs/domainVoice"
        },
        "plain_language": {
          "$ref": "#/$defs/plainVoice"
        },
        "scientific_formal": {
          "$ref": "#/$defs/formalVoice"
        }
      },
      "required": [
        "scientific_formal",
        "plain_language",
        "domain_context"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "definition_id",
    "version",
    "term",
    "aliases",
    "classification",
    "semantic_owner_ref",
    "scope",
    "voices",
    "boundaries",
    "source_refs",
    "primary_consumer_refs",
    "index_entry",
    "drift_route",
    "source_direction",
    "schema_ref",
    "schema_digest",
    "evidence_refs",
    "residue_refs",
    "typed_relations",
    "claim_ceiling"
  ],
  "title": "CyberAlchemy Lab Definition v2 candidate instance",
  "type": "object"
}
