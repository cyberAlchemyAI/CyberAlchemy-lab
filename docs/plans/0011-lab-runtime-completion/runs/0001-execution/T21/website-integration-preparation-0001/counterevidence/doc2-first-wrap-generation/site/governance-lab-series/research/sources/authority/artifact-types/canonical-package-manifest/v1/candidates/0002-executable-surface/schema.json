{
  "$id": "https://cyberalchemy.local/schemas/canonical-package-manifest/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "properties": {
        "surface_entries": {
          "items": {
            "else": {
              "properties": {
                "artifact_type_ref": {
                  "type": "null"
                }
              }
            },
            "if": {
              "properties": {
                "role": {
                  "const": "canonical-instance"
                }
              }
            },
            "then": {
              "properties": {
                "artifact_type_ref": {
                  "minLength": 1,
                  "type": "string"
                },
                "resolution_count": {
                  "const": 1
                }
              },
              "required": [
                "artifact_type_ref",
                "resolution_count"
              ]
            }
          }
        }
      }
    }
  ],
  "properties": {
    "aggregate_ref": {
      "minLength": 1,
      "type": "string"
    },
    "authority_effect": {
      "const": "none"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "lifecycle_owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "nested_packages": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "independent_lifecycle": {
            "const": true
          },
          "manifest_ref": {
            "minLength": 1,
            "type": "string"
          },
          "package_ref": {
            "minLength": 1,
            "type": "string"
          },
          "relation_kind": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "package_ref",
          "manifest_ref",
          "relation_kind",
          "independent_lifecycle"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "package_id": {
      "minLength": 1,
      "type": "string"
    },
    "package_root": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "cyberalchemy-lab-canonical-package-manifest/v1"
    },
    "source_direction": {
      "additionalProperties": false,
      "properties": {
        "canonical": {
          "const": "package.json"
        },
        "generator_ref": {
          "minLength": 1,
          "type": "string"
        },
        "human_projection": {
          "const": "PACKAGE.md"
        },
        "projection_policy": {
          "const": "generated-only"
        }
      },
      "required": [
        "canonical",
        "human_projection",
        "projection_policy",
        "generator_ref"
      ],
      "type": "object"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "surface_entries": {
      "contains": {
        "properties": {
          "artifact_type_ref": {
            "const": "cal.artifact-type.canonical-package-manifest/v1"
          },
          "path": {
            "const": "package.json"
          },
          "resolution_count": {
            "const": 1
          },
          "role": {
            "const": "canonical-instance"
          }
        },
        "required": [
          "path",
          "role",
          "artifact_type_ref",
          "resolution_count"
        ],
        "type": "object"
      },
      "items": {
        "additionalProperties": false,
        "properties": {
          "artifact_type_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "resolution_count": {
            "maximum": 1,
            "minimum": 0,
            "type": "integer"
          },
          "role": {
            "enum": [
              "canonical-instance",
              "declared-component",
              "generated-projection",
              "evidence",
              "fixture",
              "transient-state"
            ]
          }
        },
        "required": [
          "path",
          "role",
          "artifact_type_ref"
        ],
        "type": "object"
      },
      "maxContains": 1,
      "minContains": 1,
      "minItems": 1,
      "type": "array"
    },
    "unit_of_change": {
      "minLength": 1,
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "package_id",
    "version",
    "status",
    "authority_effect",
    "aggregate_ref",
    "package_root",
    "lifecycle_owner_ref",
    "unit_of_change",
    "surface_entries",
    "nested_packages",
    "source_direction",
    "claim_ceiling"
  ],
  "type": "object"
}
