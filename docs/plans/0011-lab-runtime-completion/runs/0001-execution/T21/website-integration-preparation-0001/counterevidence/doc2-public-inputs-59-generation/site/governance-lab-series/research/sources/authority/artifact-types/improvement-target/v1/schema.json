{
  "$id": "https://cyberalchemy.local/schemas/improvement-target/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "minLength": 1,
      "type": "string"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "kind": {
      "const": "improvement-target"
    },
    "lifecycle_state": {
      "enum": [
        "candidate",
        "active",
        "historical",
        "retired"
      ]
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "node_id": {
      "minLength": 1,
      "type": "string"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "affected_scope_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "basis_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "priority_posture": {
          "minLength": 1,
          "type": "string"
        },
        "research_route_ref": {
          "minLength": 1,
          "type": "string"
        },
        "success_measure_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "target_statement": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "target_statement",
        "basis_refs",
        "affected_scope_refs",
        "success_measure_refs",
        "research_route_ref",
        "priority_posture"
      ],
      "type": "object"
    },
    "relation_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "counterpart_kind": {
            "enum": [
              "challenge-event",
              "classification-value",
              "decision",
              "improvement-signal",
              "improvement-target",
              "lesson-outcome-assessment",
              "operational-lesson",
              "research-inquiry"
            ]
          },
          "counterpart_ref": {
            "minLength": 1,
            "type": "string"
          },
          "direction": {
            "enum": [
              "source",
              "target"
            ]
          },
          "relation_kind_ref": {
            "enum": [
              "relation.addresses-improvement-target",
              "relation.challenges",
              "relation.declares-effect-on",
              "relation.derives-from",
              "relation.instance-of",
              "relation.successor-of"
            ]
          }
        },
        "required": [
          "relation_kind_ref",
          "direction",
          "counterpart_kind",
          "counterpart_ref"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "cyberalchemy-lab-improvement-target/v1"
    },
    "scope_ref": {
      "minLength": 1,
      "type": "string"
    },
    "successor_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "node_id",
    "kind",
    "name",
    "lifecycle_state",
    "authority_effect",
    "owner_ref",
    "scope_ref",
    "evidence_refs",
    "challenge_route",
    "successor_refs",
    "relation_refs",
    "payload",
    "claim_ceiling"
  ],
  "type": "object"
}
