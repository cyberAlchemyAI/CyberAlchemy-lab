{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "run_state": {
            "const": "completed"
          }
        },
        "required": [
          "run_state"
        ]
      },
      "then": {
        "properties": {
          "evidence_set_ref": {
            "pattern": "\\S",
            "type": "string"
          },
          "observation_refs": {
            "minItems": 1
          },
          "period": {
            "properties": {
              "end": {
                "format": "date-time",
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "run_state": {
            "enum": [
              "stopped",
              "failed"
            ]
          }
        },
        "required": [
          "run_state"
        ]
      },
      "then": {
        "properties": {
          "period": {
            "properties": {
              "end": {
                "format": "date-time",
                "type": "string"
              }
            }
          },
          "stop_reason": {
            "pattern": "\\S",
            "type": "string"
          }
        }
      }
    }
  ],
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "claim_ceiling": {
      "pattern": "\\S",
      "type": "string"
    },
    "counterevidence_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "type": "array",
      "uniqueItems": true
    },
    "evidence_set_ref": {
      "anyOf": [
        {
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "goal_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "inquiry_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "inquiry_version_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "inspected_sources": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "observed_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "selector": {
            "pattern": "\\S",
            "type": "string"
          },
          "source_ref": {
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "source_ref",
          "selector",
          "observed_sha256"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
    },
    "kind": {
      "const": "research-run"
    },
    "limitations": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "method_performed": {
      "additionalProperties": false,
      "properties": {
        "deviation_refs": {
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 100,
          "type": "array",
          "uniqueItems": true
        },
        "method_ref": {
          "pattern": "\\S",
          "type": "string"
        },
        "procedure_summary": {
          "pattern": "\\S",
          "type": "string"
        }
      },
      "required": [
        "method_ref",
        "procedure_summary",
        "deviation_refs"
      ],
      "type": "object"
    },
    "node_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "observation_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "type": "array",
      "uniqueItems": true
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "period": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "start": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "end",
        "start"
      ],
      "type": "object"
    },
    "project_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "receipt_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "run_state": {
      "enum": [
        "running",
        "completed",
        "stopped",
        "failed"
      ],
      "type": "string"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "stop_reason": {
      "anyOf": [
        {
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "authority_effect",
    "inquiry_ref",
    "kind",
    "limitations",
    "node_id",
    "owner_ref",
    "period",
    "receipt_ref",
    "scope_ref",
    "status",
    "inquiry_version_ref",
    "project_ref",
    "goal_refs",
    "inspected_sources",
    "method_performed",
    "observation_refs",
    "counterevidence_refs",
    "evidence_set_ref",
    "run_state",
    "stop_reason",
    "owner_route",
    "challenge_route",
    "claim_ceiling"
  ],
  "type": "object"
}
