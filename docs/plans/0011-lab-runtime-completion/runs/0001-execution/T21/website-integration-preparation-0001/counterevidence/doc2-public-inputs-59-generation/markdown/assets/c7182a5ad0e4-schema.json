{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "authority_treatment": {
      "enum": [
        "non-governing",
        "advisory",
        "governed-by-separate-decision"
      ],
      "type": "string"
    },
    "challenge_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "claim_ceiling": {
      "pattern": "\\S",
      "type": "string"
    },
    "claim_status": {
      "enum": [
        "theorem",
        "conjecture",
        "analogy",
        "review"
      ],
      "type": "string"
    },
    "conditions": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "entropy_register": {
      "enum": [
        "finite-probabilistic",
        "finite-microcanonical",
        "weighted",
        "retrieval",
        "categorical"
      ],
      "type": "string"
    },
    "interpretation": {
      "pattern": "\\S",
      "type": "string"
    },
    "kind": {
      "const": "measurement-method"
    },
    "mathematical_reading": {
      "pattern": "\\S",
      "type": "string"
    },
    "name": {
      "pattern": "\\S",
      "type": "string"
    },
    "node_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "observable_kind": {
      "enum": [
        "shannon-entropy",
        "fiber-cardinality",
        "declared-numeric-bridge"
      ],
      "type": "string"
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "procedure": {
      "pattern": "\\S",
      "type": "string"
    },
    "property": {
      "const": "residue entropy"
    },
    "residue_type_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "scope_kind": {
      "enum": [
        "finite",
        "weighted",
        "retrieval",
        "probabilistic",
        "categorical"
      ],
      "type": "string"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "source_operation_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "uncertainty_rule": {
      "pattern": "\\S",
      "type": "string"
    },
    "unit": {
      "pattern": "\\S",
      "type": "string"
    }
  },
  "required": [
    "authority_effect",
    "kind",
    "node_id",
    "owner_ref",
    "scope_ref",
    "status",
    "name",
    "property",
    "entropy_register",
    "source_operation_ref",
    "residue_type_ref",
    "observable_kind",
    "mathematical_reading",
    "scope_kind",
    "procedure",
    "conditions",
    "unit",
    "uncertainty_rule",
    "claim_status",
    "authority_treatment",
    "interpretation",
    "owner_route",
    "challenge_route",
    "claim_ceiling"
  ],
  "type": "object"
}
