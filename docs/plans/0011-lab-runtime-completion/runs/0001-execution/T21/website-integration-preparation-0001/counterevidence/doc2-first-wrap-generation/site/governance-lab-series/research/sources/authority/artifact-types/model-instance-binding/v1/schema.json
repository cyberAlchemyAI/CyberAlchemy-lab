{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "binding_state": {
      "enum": [
        "proposed",
        "active",
        "suspended",
        "superseded",
        "retired"
      ],
      "type": "string"
    },
    "challenge_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "claim_ceiling": {
      "pattern": "\\S",
      "type": "string"
    },
    "conformance_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "type": "array",
      "uniqueItems": true
    },
    "extension_scope": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "type": "array",
      "uniqueItems": true
    },
    "inherited_contract_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "instance_authority_scope": {
      "pattern": "\\S",
      "type": "string"
    },
    "instance_owner_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "instance_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "kind": {
      "const": "model-instance-binding"
    },
    "local_override_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "type": "array",
      "uniqueItems": true
    },
    "node_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "parent_authority_scope": {
      "pattern": "\\S",
      "type": "string"
    },
    "parent_model_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "parent_model_version_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "parent_owner_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "successor_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "authority_effect",
    "kind",
    "node_id",
    "owner_ref",
    "scope_ref",
    "status",
    "parent_model_ref",
    "parent_model_version_ref",
    "instance_ref",
    "parent_owner_route",
    "instance_owner_route",
    "inherited_contract_refs",
    "parent_authority_scope",
    "instance_authority_scope",
    "extension_scope",
    "local_override_refs",
    "conformance_refs",
    "binding_state",
    "successor_refs",
    "owner_route",
    "challenge_route",
    "claim_ceiling"
  ],
  "type": "object"
}
