{
  "$id": "https://cyberalchemy.local/schemas/semantic-event-history/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "minLength": 1,
      "type": "string"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "kind": {
      "const": "semantic-event-history"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "node_id": {
      "minLength": 1,
      "type": "string"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "append_only": {
          "const": true
        },
        "chain_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "event_records_are_replay_source": {
          "const": true
        },
        "events": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "cursor": {
                "minimum": 1,
                "type": "integer"
              },
              "event_digest": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "event_id": {
                "minLength": 1,
                "type": "string"
              },
              "previous_event_digest": {
                "oneOf": [
                  {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "record_ref": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "event_id",
              "event_digest",
              "cursor",
              "previous_event_digest",
              "record_ref"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "history_id": {
          "minLength": 1,
          "type": "string"
        },
        "history_manifest_is_event_index": {
          "const": true
        },
        "latest_cursor": {
          "minimum": 1,
          "type": "integer"
        },
        "ontology_ref": {
          "minLength": 1,
          "type": "string"
        },
        "stream_id": {
          "minLength": 1,
          "type": "string"
        },
        "subject_kind": {
          "enum": [
            "ontology-node",
            "ontology-edge"
          ]
        },
        "subject_ref": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "history_id",
        "ontology_ref",
        "subject_kind",
        "subject_ref",
        "stream_id",
        "events",
        "latest_cursor",
        "chain_digest",
        "append_only",
        "event_records_are_replay_source",
        "history_manifest_is_event_index"
      ],
      "type": "object"
    },
    "record_state": {
      "enum": [
        "candidate",
        "admitted",
        "historical",
        "retired"
      ]
    },
    "schema_version": {
      "const": "cyberalchemy-lab-semantic-event-history/v1"
    },
    "scope_ref": {
      "minLength": 1,
      "type": "string"
    },
    "successor_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "node_id",
    "kind",
    "name",
    "record_state",
    "authority_effect",
    "owner_ref",
    "scope_ref",
    "evidence_refs",
    "challenge_route",
    "successor_refs",
    "payload",
    "claim_ceiling"
  ],
  "type": "object"
}
