{
  "$id": "https://cyberalchemy.local/schemas/decision-checkpoint/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "minLength": 1,
      "type": "string"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "kind": {
      "const": "decision-checkpoint"
    },
    "lifecycle_state": {
      "enum": [
        "candidate",
        "active",
        "historical",
        "retired"
      ]
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "node_id": {
      "minLength": 1,
      "type": "string"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "checkpoint_kind": {
          "enum": [
            "before-application",
            "final-review"
          ]
        },
        "closed_at": {
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "decision_bundle_ref": {
          "minLength": 1,
          "type": "string"
        },
        "opened_at": {
          "minLength": 1,
          "type": "string"
        },
        "presentation_state": {
          "enum": [
            "pending",
            "resolved",
            "invalidated"
          ]
        },
        "resolved_preference_ref": {
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "workflow_instance_ref": {
          "minLength": 1,
          "type": "string"
        },
        "workflow_profile_ref": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "workflow_instance_ref",
        "workflow_profile_ref",
        "checkpoint_kind",
        "decision_bundle_ref",
        "presentation_state",
        "resolved_preference_ref",
        "opened_at",
        "closed_at"
      ],
      "type": "object"
    },
    "relation_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "counterpart_kind": {
            "enum": [
              "policy"
            ]
          },
          "counterpart_ref": {
            "minLength": 1,
            "type": "string"
          },
          "direction": {
            "enum": [
              "source"
            ]
          },
          "relation_kind_ref": {
            "enum": [
              "relation.governed-by"
            ]
          }
        },
        "required": [
          "relation_kind_ref",
          "direction",
          "counterpart_kind",
          "counterpart_ref"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "cyberalchemy-lab-decision-checkpoint/v1"
    },
    "scope_ref": {
      "minLength": 1,
      "type": "string"
    },
    "successor_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "node_id",
    "kind",
    "name",
    "lifecycle_state",
    "authority_effect",
    "owner_ref",
    "scope_ref",
    "evidence_refs",
    "challenge_route",
    "successor_refs",
    "relation_refs",
    "payload",
    "claim_ceiling"
  ],
  "type": "object"
}
