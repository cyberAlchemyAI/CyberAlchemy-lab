{
  "$defs": {
    "binding": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "edition_id": {
      "pattern": "^[a-z0-9-]+$",
      "type": "string"
    },
    "expected_review_result": {
      "pattern": "^PASS",
      "type": "string"
    },
    "final_publication_qualified": {
      "const": false
    },
    "narrative_binding": {
      "$ref": "#/$defs/binding"
    },
    "owner_handoff_binding": {
      "$ref": "#/$defs/binding"
    },
    "owner_manifest_binding": {
      "$ref": "#/$defs/binding"
    },
    "page_count": {
      "const": 14
    },
    "public_source_count": {
      "minimum": 72,
      "type": "integer"
    },
    "review_binding": {
      "$ref": "#/$defs/binding"
    },
    "schema_version": {
      "const": "lab-T21-reviewed-runtime-documentation-inputs/v1-candidate"
    },
    "section_count": {
      "const": 67
    },
    "source_map_binding": {
      "$ref": "#/$defs/binding"
    },
    "standing": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "authority_effect",
    "edition_id",
    "standing",
    "narrative_binding",
    "source_map_binding",
    "review_binding",
    "owner_manifest_binding",
    "owner_handoff_binding",
    "expected_review_result",
    "page_count",
    "section_count",
    "public_source_count",
    "final_publication_qualified"
  ],
  "title": "Explicit reviewed runtime documentation staging packet",
  "type": "object"
}
