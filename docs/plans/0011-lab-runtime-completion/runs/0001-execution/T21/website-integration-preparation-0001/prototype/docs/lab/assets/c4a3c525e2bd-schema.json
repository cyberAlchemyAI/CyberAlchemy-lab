{
  "$id": "https://cyberalchemy.local/schemas/authority-boundary/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "minLength": 1,
      "type": "string"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "kind": {
      "const": "authority-boundary"
    },
    "lifecycle_state": {
      "enum": [
        "candidate",
        "active",
        "historical",
        "retired"
      ]
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "node_id": {
      "minLength": 1,
      "type": "string"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "accountable_principal_ref": {
          "minLength": 1,
          "type": "string"
        },
        "allowed_effect_kinds": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "authority_scope_ref": {
          "minLength": 1,
          "type": "string"
        },
        "challenge_route_ref": {
          "minLength": 1,
          "type": "string"
        },
        "effective_period": {
          "minLength": 1,
          "type": "string"
        },
        "excluded_effect_kinds": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "owner_role_ref": {
          "minLength": 1,
          "type": "string"
        },
        "revocation_state": {
          "enum": [
            "not-revoked",
            "revoked",
            "expired"
          ]
        }
      },
      "required": [
        "owner_role_ref",
        "accountable_principal_ref",
        "authority_scope_ref",
        "allowed_effect_kinds",
        "excluded_effect_kinds",
        "challenge_route_ref",
        "effective_period",
        "revocation_state"
      ],
      "type": "object"
    },
    "relation_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "counterpart_kind": {
            "enum": [
              "decision-scope",
              "policy"
            ]
          },
          "counterpart_ref": {
            "minLength": 1,
            "type": "string"
          },
          "direction": {
            "enum": [
              "source"
            ]
          },
          "relation_kind_ref": {
            "enum": [
              "relation.governed-by",
              "relation.scopes-authority-over"
            ]
          }
        },
        "required": [
          "relation_kind_ref",
          "direction",
          "counterpart_kind",
          "counterpart_ref"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "cyberalchemy-lab-authority-boundary/v1"
    },
    "scope_ref": {
      "minLength": 1,
      "type": "string"
    },
    "successor_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "node_id",
    "kind",
    "name",
    "lifecycle_state",
    "authority_effect",
    "owner_ref",
    "scope_ref",
    "evidence_refs",
    "challenge_route",
    "successor_refs",
    "relation_refs",
    "payload",
    "claim_ceiling"
  ],
  "type": "object"
}
