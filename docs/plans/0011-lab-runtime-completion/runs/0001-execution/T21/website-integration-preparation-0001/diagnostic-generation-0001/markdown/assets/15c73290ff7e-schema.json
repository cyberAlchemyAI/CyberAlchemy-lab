{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "context_kind": {
            "const": "product"
          }
        },
        "required": [
          "context_kind"
        ]
      },
      "then": {
        "properties": {
          "goal_ref": {
            "type": "null"
          },
          "project_ref": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "context_kind": {
            "const": "project"
          }
        },
        "required": [
          "context_kind"
        ]
      },
      "then": {
        "properties": {
          "goal_ref": {
            "type": "null"
          },
          "project_ref": {
            "pattern": "\\S",
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "context_kind": {
            "const": "goal"
          }
        },
        "required": [
          "context_kind"
        ]
      },
      "then": {
        "properties": {
          "goal_ref": {
            "pattern": "\\S",
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle_state": {
            "const": "superseded"
          }
        },
        "required": [
          "lifecycle_state"
        ]
      },
      "then": {
        "properties": {
          "successor_refs": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "bounded_context_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "type": "array",
      "uniqueItems": true
    },
    "challenge_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "claim_ceiling": {
      "pattern": "\\S",
      "type": "string"
    },
    "consumer_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "context_kind": {
      "enum": [
        "product",
        "project",
        "goal"
      ],
      "type": "string"
    },
    "goal_ref": {
      "anyOf": [
        {
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "intended_uses": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "kind": {
      "const": "context"
    },
    "lifecycle_state": {
      "enum": [
        "draft",
        "active",
        "superseded",
        "retired"
      ],
      "type": "string"
    },
    "node_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "product_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "profile_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "project_ref": {
      "anyOf": [
        {
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "purpose": {
      "pattern": "\\S",
      "type": "string"
    },
    "revision_history": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "type": "array",
      "uniqueItems": true
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "source_policy_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "subject_scope": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "successor_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "authority_effect",
    "kind",
    "node_id",
    "owner_ref",
    "scope_ref",
    "status",
    "context_kind",
    "product_ref",
    "project_ref",
    "goal_ref",
    "purpose",
    "bounded_context_refs",
    "consumer_refs",
    "intended_uses",
    "subject_scope",
    "source_policy_refs",
    "profile_ref",
    "owner_route",
    "lifecycle_state",
    "revision_history",
    "successor_refs",
    "challenge_route",
    "claim_ceiling"
  ],
  "type": "object"
}
