{
  "$id": "https://cyberalchemy.local/schemas/failure-occurrence/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "minLength": 1,
      "type": "string"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "kind": {
      "const": "failure-occurrence"
    },
    "lifecycle_state": {
      "enum": [
        "candidate",
        "active",
        "historical",
        "retired"
      ]
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "node_id": {
      "minLength": 1,
      "type": "string"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "cause_posture": {
          "minLength": 1,
          "type": "string"
        },
        "detection_evidence_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "expected_boundary_ref": {
          "minLength": 1,
          "type": "string"
        },
        "impact_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "observed_manifestations": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "occurrence_posture": {
          "minLength": 1,
          "type": "string"
        },
        "recovery_posture": {
          "minLength": 1,
          "type": "string"
        },
        "residue_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "response_action_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "subject_ref": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "subject_ref",
        "expected_boundary_ref",
        "observed_manifestations",
        "detection_evidence_refs",
        "occurrence_posture",
        "cause_posture",
        "impact_refs",
        "response_action_refs",
        "recovery_posture",
        "residue_refs"
      ],
      "type": "object"
    },
    "relation_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "counterpart_kind": {
            "enum": [
              "agent-action",
              "agent-capability",
              "agent-session",
              "artifact-type",
              "challenge-contract",
              "challenge-event",
              "classification-value",
              "contract",
              "decision",
              "evidence-set",
              "experiment-run",
              "failure-assessment",
              "failure-mode",
              "failure-occurrence",
              "feedback-record",
              "finding",
              "generated-output",
              "implementation",
              "incident",
              "measurement-result",
              "observation",
              "ontology",
              "operational-observation",
              "person-reference",
              "policy",
              "product",
              "product-capability",
              "project",
              "research-run",
              "schema",
              "work"
            ]
          },
          "counterpart_ref": {
            "minLength": 1,
            "type": "string"
          },
          "direction": {
            "enum": [
              "source",
              "target"
            ]
          },
          "relation_kind_ref": {
            "enum": [
              "relation.affects",
              "relation.challenges",
              "relation.declares-effect-on",
              "relation.evaluates",
              "relation.evidence-bears-on",
              "relation.governed-by",
              "relation.instance-of",
              "relation.member-of",
              "relation.occurs-during",
              "relation.produces",
              "relation.responds-to",
              "relation.successor-of",
              "relation.violates"
            ]
          }
        },
        "required": [
          "relation_kind_ref",
          "direction",
          "counterpart_kind",
          "counterpart_ref"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "cyberalchemy-lab-failure-occurrence/v1"
    },
    "scope_ref": {
      "minLength": 1,
      "type": "string"
    },
    "successor_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "node_id",
    "kind",
    "name",
    "lifecycle_state",
    "authority_effect",
    "owner_ref",
    "scope_ref",
    "evidence_refs",
    "challenge_route",
    "successor_refs",
    "relation_refs",
    "payload",
    "claim_ceiling"
  ],
  "type": "object"
}
