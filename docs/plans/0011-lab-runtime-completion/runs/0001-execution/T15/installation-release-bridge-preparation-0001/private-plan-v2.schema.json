{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actual_owner_outcome": {
      "const": null
    },
    "authority_effect": {
      "const": "none"
    },
    "bridge_binding": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "sha256"
      ],
      "type": "object"
    },
    "install": {
      "additionalProperties": false,
      "properties": {
        "approval_binding": {
          "additionalProperties": false,
          "properties": {
            "ref": {
              "minLength": 1,
              "type": "string"
            },
            "sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          },
          "required": [
            "ref",
            "sha256"
          ],
          "type": "object"
        },
        "generation": {
          "minLength": 1,
          "type": "string"
        },
        "package_binding": {
          "additionalProperties": false,
          "properties": {
            "ref": {
              "minLength": 1,
              "type": "string"
            },
            "sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          },
          "required": [
            "ref",
            "sha256"
          ],
          "type": "object"
        },
        "package_path": {
          "minLength": 1,
          "type": "string"
        },
        "private_custody_scope_ref": {
          "minLength": 1,
          "type": "string"
        },
        "request_controls": {
          "additionalProperties": false,
          "properties": {
            "operation": {
              "enum": [
                "install",
                "upgrade",
                "rollback"
              ]
            },
            "preimage_binding": {
              "additionalProperties": false,
              "properties": {
                "ref": {
                  "minLength": 1,
                  "type": "string"
                },
                "sha256": {
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                }
              },
              "required": [
                "ref",
                "sha256"
              ],
              "type": "object"
            },
            "private_custody_scope_ref": {
              "minLength": 1,
              "type": "string"
            },
            "recovery_contract_binding": {
              "additionalProperties": false,
              "properties": {
                "ref": {
                  "minLength": 1,
                  "type": "string"
                },
                "sha256": {
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                }
              },
              "required": [
                "ref",
                "sha256"
              ],
              "type": "object"
            },
            "release_manifest_binding": {
              "additionalProperties": false,
              "properties": {
                "ref": {
                  "minLength": 1,
                  "type": "string"
                },
                "sha256": {
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                }
              },
              "required": [
                "ref",
                "sha256"
              ],
              "type": "object"
            },
            "source_profile_binding": {
              "additionalProperties": false,
              "properties": {
                "ref": {
                  "minLength": 1,
                  "type": "string"
                },
                "sha256": {
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                }
              },
              "required": [
                "ref",
                "sha256"
              ],
              "type": "object"
            },
            "target_environment_binding": {
              "additionalProperties": false,
              "properties": {
                "ref": {
                  "minLength": 1,
                  "type": "string"
                },
                "sha256": {
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                }
              },
              "required": [
                "ref",
                "sha256"
              ],
              "type": "object"
            }
          },
          "required": [
            "operation",
            "release_manifest_binding",
            "source_profile_binding",
            "target_environment_binding",
            "preimage_binding",
            "recovery_contract_binding",
            "private_custody_scope_ref"
          ],
          "type": "object"
        },
        "root": {
          "minLength": 1,
          "type": "string"
        },
        "root_identity": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "scope_binding": {
          "additionalProperties": false,
          "properties": {
            "ref": {
              "minLength": 1,
              "type": "string"
            },
            "sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          },
          "required": [
            "ref",
            "sha256"
          ],
          "type": "object"
        }
      },
      "required": [
        "root",
        "root_identity",
        "scope_binding",
        "private_custody_scope_ref",
        "generation",
        "package_path",
        "package_binding",
        "request_controls",
        "approval_binding"
      ],
      "type": "object"
    },
    "principal_ref": {
      "minLength": 1,
      "type": "string"
    },
    "release": {
      "additionalProperties": false,
      "properties": {
        "manifest_binding": {
          "additionalProperties": false,
          "properties": {
            "ref": {
              "minLength": 1,
              "type": "string"
            },
            "sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          },
          "required": [
            "ref",
            "sha256"
          ],
          "type": "object"
        },
        "readiness_contract_binding": {
          "additionalProperties": false,
          "properties": {
            "ref": {
              "minLength": 1,
              "type": "string"
            },
            "sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          },
          "required": [
            "ref",
            "sha256"
          ],
          "type": "object"
        }
      },
      "required": [
        "manifest_binding",
        "readiness_contract_binding"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "lab-installation-release-plan/v2-candidate"
    },
    "source_cut": {
      "additionalProperties": false,
      "properties": {
        "branch_ref": {
          "minLength": 1,
          "type": "string"
        },
        "commit_sequence": {
          "minimum": 0,
          "type": "integer"
        },
        "commit_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "source_profile_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "store_ref": {
          "minLength": 1,
          "type": "string"
        },
        "streams": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "cursor": {
                "minimum": 0,
                "type": "integer"
              },
              "head_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "stream_ref": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "stream_ref",
              "cursor",
              "head_sha256"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "branch_ref",
        "store_ref",
        "commit_sequence",
        "commit_sha256",
        "source_profile_sha256",
        "streams"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "principal_ref",
    "source_cut",
    "install",
    "release",
    "bridge_binding",
    "authority_effect",
    "actual_owner_outcome"
  ],
  "type": "object"
}
