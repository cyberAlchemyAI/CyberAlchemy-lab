{
  "$id": "urn:cyberalchemy-lab:protocol:authority-evaluation:v1-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "posture": {
            "const": "permitted"
          }
        },
        "required": [
          "posture"
        ]
      },
      "then": {
        "properties": {
          "checks": {
            "items": {
              "allOf": [
                {
                  "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/check"
                },
                {
                  "properties": {
                    "result": {
                      "const": "pass"
                    }
                  }
                }
              ]
            },
            "minItems": 1,
            "type": "array"
          },
          "evidence_bindings": {
            "items": {
              "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "checks",
          "evidence_bindings"
        ]
      }
    }
  ],
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "authority_envelope_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "checks": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/check"
      },
      "minItems": 1,
      "type": "array"
    },
    "evaluated_at": {
      "format": "date-time",
      "type": "string"
    },
    "evaluation_ref": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_bindings": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
      },
      "minItems": 0,
      "type": "array"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "gaps": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/gap"
      },
      "minItems": 0,
      "type": "array"
    },
    "posture": {
      "enum": [
        "permitted",
        "denied",
        "gate-required",
        "indeterminate"
      ]
    },
    "request_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "schema_version": {
      "const": "lab-authority-evaluation/v1-candidate"
    },
    "source_cut": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/source_cut"
    }
  },
  "required": [
    "schema_version",
    "evaluation_ref",
    "request_binding",
    "authority_envelope_binding",
    "source_cut",
    "evaluated_at",
    "expires_at",
    "posture",
    "checks",
    "evidence_bindings",
    "gaps",
    "authority_effect"
  ],
  "title": "Candidate Lab authority-evaluation",
  "type": "object"
}
