{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowlist_pointer": {
      "pattern": "^/",
      "type": "string"
    },
    "authority_effect": {
      "const": "none"
    },
    "copies": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "expected_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "source_path": {
            "minLength": 1,
            "type": "string"
          },
          "target_path": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "source_path",
          "target_path",
          "expected_sha256"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "exclusions_pointer": {
      "pattern": "^/",
      "type": "string"
    },
    "row_selectors": {
      "additionalProperties": false,
      "properties": {
        "expected_postimage": {
          "additionalProperties": false,
          "properties": {
            "path_pointer": {
              "pattern": "^/",
              "type": "string"
            },
            "rows_pointer": {
              "pattern": "^/",
              "type": "string"
            },
            "sha256_pointer": {
              "pattern": "^/",
              "type": "string"
            }
          },
          "required": [
            "rows_pointer",
            "path_pointer",
            "sha256_pointer"
          ],
          "type": "object"
        },
        "source_inventory": {
          "additionalProperties": false,
          "properties": {
            "path_pointer": {
              "pattern": "^/",
              "type": "string"
            },
            "rows_pointer": {
              "pattern": "^/",
              "type": "string"
            },
            "sha256_pointer": {
              "pattern": "^/",
              "type": "string"
            }
          },
          "required": [
            "rows_pointer",
            "path_pointer",
            "sha256_pointer"
          ],
          "type": "object"
        },
        "target_baseline": {
          "additionalProperties": false,
          "properties": {
            "path_pointer": {
              "pattern": "^/",
              "type": "string"
            },
            "rows_pointer": {
              "pattern": "^/",
              "type": "string"
            },
            "sha256_pointer": {
              "pattern": "^/",
              "type": "string"
            }
          },
          "required": [
            "rows_pointer",
            "path_pointer",
            "sha256_pointer"
          ],
          "type": "object"
        }
      },
      "required": [
        "source_inventory",
        "target_baseline",
        "expected_postimage"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "lab-original-migration-scope-inputs/v1-candidate"
    },
    "source_files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "binding": {
            "additionalProperties": false,
            "properties": {
              "path": {
                "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^\\u0000]+$",
                "type": "string"
              },
              "sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "type": "object"
          },
          "declared_path": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "declared_path",
          "binding"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "target_baseline_files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "binding": {
            "additionalProperties": false,
            "properties": {
              "path": {
                "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^\\u0000]+$",
                "type": "string"
              },
              "sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "type": "object"
          },
          "declared_path": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "declared_path",
          "binding"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "source_files",
    "target_baseline_files",
    "copies",
    "row_selectors",
    "allowlist_pointer",
    "exclusions_pointer",
    "authority_effect"
  ],
  "type": "object"
}
