+// T32 additive observer: no event validation or persistence replacement.
+fn t32_observe(directory: &Path, stage: &str) {
+    let wanted = std::env::var("CAL_T32_STOP_STAGE").unwrap_or_default();
+    let family = std::env::var("CAL_T32_STOP_FAMILY").unwrap_or_default();
