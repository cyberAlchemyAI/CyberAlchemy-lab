{
  "$id": "urn:cyberalchemy-lab:implementation:source-profile:v1-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_basis": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "authority_effect": {
      "const": "none"
    },
    "content_manifest": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "domain_posture": {
      "enum": [
        "isolated-candidate",
        "admitted-source"
      ]
    },
    "executable_manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "expected_cut": {
      "minLength": 1,
      "type": "string"
    },
    "policy_core_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "profile_id": {
      "minLength": 1,
      "type": "string"
    },
    "protocol_version": {
      "const": 1
    },
    "registries": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "lab-independent-source-profile/v1-candidate"
    },
    "transition_basis": {
      "additionalProperties": false,
      "properties": {
        "basis_refs": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "path": {
                "minLength": 1,
                "type": "string"
              },
              "sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "mode": {
          "enum": [
            "initial",
            "declared-consequence",
            "reviewed-successor"
          ]
        }
      },
      "required": [
        "mode",
        "basis_refs"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "authority_effect",
    "profile_id",
    "protocol_version",
    "executable_manifest_sha256",
    "policy_core_sha256",
    "authority_basis",
    "registries",
    "content_manifest",
    "expected_cut",
    "domain_posture",
    "transition_basis"
  ],
  "type": "object"
}
