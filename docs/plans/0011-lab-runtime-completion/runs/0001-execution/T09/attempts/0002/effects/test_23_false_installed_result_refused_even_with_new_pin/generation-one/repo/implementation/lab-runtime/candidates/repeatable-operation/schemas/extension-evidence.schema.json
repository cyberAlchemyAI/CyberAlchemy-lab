{
  "$defs": {
    "binding": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "sha256"
      ],
      "type": "object"
    },
    "pair": {
      "additionalProperties": false,
      "properties": {
        "canonical_authority": {
          "enum": [
            "typed-relation",
            "specialized-carrier"
          ]
        },
        "cross_constraints_binding": {
          "$ref": "#/$defs/binding"
        },
        "projection_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/binding"
            },
            {
              "type": "null"
            }
          ]
        },
        "qualifier_schema_binding": {
          "$ref": "#/$defs/binding"
        },
        "source_contract_ref": {
          "minLength": 1,
          "type": "string"
        },
        "source_kind": {
          "minLength": 1,
          "type": "string"
        },
        "source_role": {
          "minLength": 1,
          "type": "string"
        },
        "target_contract_ref": {
          "minLength": 1,
          "type": "string"
        },
        "target_kind": {
          "minLength": 1,
          "type": "string"
        },
        "target_role": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "source_kind",
        "target_kind",
        "source_contract_ref",
        "target_contract_ref",
        "source_role",
        "target_role",
        "qualifier_schema_binding",
        "cross_constraints_binding",
        "canonical_authority",
        "projection_binding"
      ],
      "type": "object"
    }
  },
  "$id": "urn:cyberalchemy-lab:closed-extension-evidence:v1-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowed_endpoint_pairs": {
      "items": {
        "$ref": "#/$defs/pair"
      },
      "maxItems": 1000,
      "minItems": 1,
      "type": "array"
    },
    "authority_effect": {
      "const": "none"
    },
    "axis_ref": {
      "minLength": 1,
      "type": "string"
    },
    "contestability_binding": {
      "$ref": "#/$defs/binding"
    },
    "effect_rule": {
      "const": "candidate-only; no pair availability or instance admission"
    },
    "lifecycle_effect": {
      "minLength": 1,
      "type": "string"
    },
    "mode": {
      "enum": [
        "reuse",
        "distinct-kind"
      ]
    },
    "noncollapse_report_binding": {
      "$ref": "#/$defs/binding"
    },
    "ontology_contract_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "predecessor_version_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "proposal_ref": {
      "minLength": 1,
      "type": "string"
    },
    "relation_kind_ref": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "lab-closed-extension-proposal/v1-candidate"
    },
    "scope": {
      "enum": [
        "global",
        "ontology-local"
      ]
    },
    "source_kinds": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "successor_version_ref": {
      "minLength": 1,
      "type": "string"
    },
    "target_kinds": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "unique_question": {
      "minLength": 1,
      "type": "string"
    },
    "validation_effect": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "proposal_ref",
    "relation_kind_ref",
    "successor_version_ref",
    "unique_question",
    "axis_ref",
    "owner_ref",
    "lifecycle_effect",
    "validation_effect",
    "schema_version",
    "authority_effect",
    "scope",
    "ontology_contract_ref",
    "mode",
    "predecessor_version_ref",
    "allowed_endpoint_pairs",
    "source_kinds",
    "target_kinds",
    "noncollapse_report_binding",
    "contestability_binding",
    "effect_rule"
  ],
  "title": "Candidate closed extension proposal, no authority effect",
  "type": "object"
}
