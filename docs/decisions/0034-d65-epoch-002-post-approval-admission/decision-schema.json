{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/cal.d65-post-approval-admission-decision/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "decision_id", "gate_id", "status", "decided_at",
    "decision_source", "candidate_refs", "selected_option", "alternatives",
    "admission", "downstream_authority", "non_effects", "authority_effect", "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "cal.d65-post-approval-admission-decision/v1"},
    "decision_id": {"const": "CAL-D65PADM-0034"},
    "gate_id": {"const": "G-D65-EPOCH-002-POST-APPROVAL-ADMISSION"},
    "status": {"const": "selected"},
    "decided_at": {"type": "string", "format": "date-time"},
    "decision_source": {"type": "object"},
    "candidate_refs": {"type": "object"},
    "selected_option": {
      "type": "object", "additionalProperties": false,
      "required": ["option_id", "effect"],
      "properties": {
        "option_id": {"const": "D65PADM-1"},
        "effect": {"const": "admission-only"}
      }
    },
    "alternatives": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["D65PADM-2", "D65PADM-3", "D65PADM-4"]}},
    "admission": {"type": "object"},
    "downstream_authority": {"type": "object"},
    "non_effects": {"type": "array", "minItems": 7, "items": {"type": "string", "minLength": 1}},
    "authority_effect": {"const": "admission-only"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  }
}
