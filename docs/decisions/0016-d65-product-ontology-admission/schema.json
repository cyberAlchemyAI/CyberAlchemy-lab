{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cal.schema.d65-product-ontology-admission/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_ref",
    "decision_id",
    "gate_id",
    "status",
    "decided_at",
    "decision_source",
    "admissibility",
    "selected_plan_preimage",
    "candidate_refs",
    "selection",
    "admitted_product_meaning",
    "next_gate",
    "non_effects",
    "authority_effect",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "cal.d65-product-ontology-admission-decision/v1"},
    "schema_ref": {"const": "schema.json"},
    "decision_id": {"const": "CAL-D65PROD-0016"},
    "gate_id": {"const": "G-D65-PRODUCT"},
    "status": {"const": "selected"},
    "decided_at": {"type": "string", "format": "date-time"},
    "decision_source": {"type": "object"},
    "admissibility": {"type": "object"},
    "selected_plan_preimage": {"type": "object"},
    "candidate_refs": {"type": "object"},
    "selection": {"type": "object"},
    "admitted_product_meaning": {"type": "object"},
    "next_gate": {"const": "G-D65-BUSINESS"},
    "non_effects": {"type": "array", "minItems": 5},
    "authority_effect": {"const": "admit-exact-d65-s2-product-ontology-only"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  }
}
