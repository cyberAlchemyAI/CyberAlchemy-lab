{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/cohesive-ontology-system-root-admission-decision/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_ref",
    "decision_id",
    "gate_id",
    "status",
    "decided_at",
    "decision_source",
    "admissibility",
    "candidate_refs",
    "selected_option",
    "alternatives",
    "rationale",
    "root_admission",
    "preserved_child_authority",
    "canonical_truth_boundary",
    "retained_residue_ids",
    "downstream_authority",
    "non_effects",
    "authority_effect",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "cyberalchemy-lab-cohesive-ontology-system-root-admission-decision/v1"
    },
    "schema_ref": {"const": "decision-schema.json"},
    "decision_id": {"const": "CAL-ONTOLOGY-SYSTEM-ROOT-ADMISSION-0045"},
    "gate_id": {"const": "G-CAL-COHESIVE-ONTOLOGY-SYSTEM-ROOT-ADMISSION"},
    "status": {"const": "selected"},
    "decided_at": {"type": "string", "format": "date-time"},
    "decision_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "verbatim", "selected_option_id", "observed_count"],
      "properties": {
        "kind": {"const": "explicit-user-selection"},
        "verbatim": {"const": "`CLOSYS-ADM-1`"},
        "selected_option_id": {"const": "CLOSYS-ADM-1"},
        "observed_count": {"const": 1}
      }
    },
    "admissibility": {"type": "object"},
    "candidate_refs": {"type": "object"},
    "selected_option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["option_id", "effect"],
      "properties": {
        "option_id": {"const": "CLOSYS-ADM-1"},
        "effect": {"const": "root-admission-only"}
      }
    },
    "alternatives": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["CLOSYS-ADM-2", "CLOSYS-ADM-3", "CLOSYS-ADM-4"]}
    },
    "rationale": {"type": "string", "minLength": 1},
    "root_admission": {"type": "object"},
    "preserved_child_authority": {"type": "object"},
    "canonical_truth_boundary": {"type": "object"},
    "retained_residue_ids": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "downstream_authority": {"type": "object"},
    "non_effects": {
      "type": "array",
      "minItems": 8,
      "items": {"type": "string", "minLength": 1}
    },
    "authority_effect": {"const": "root-admission-only"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  }
}
