{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cal.d65-implementation-binding-acceptance-decision/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_ref",
    "decision_id",
    "gate_id",
    "status",
    "decided_at",
    "decision_source",
    "selected_plan_preimage",
    "candidate_refs",
    "selection",
    "accepted_binding",
    "successor_eligibility",
    "next_gate",
    "non_effects",
    "authority_effect",
    "implementation_authorized",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "cal.d65-implementation-binding-acceptance-decision/v1"},
    "schema_ref": {"const": "schema.json"},
    "decision_id": {"const": "CAL-D65BIND-0023"},
    "gate_id": {"const": "G-D65-BINDING"},
    "status": {"const": "selected"},
    "decided_at": {"type": "string", "format": "date-time"},
    "decision_source": {"type": "object"},
    "selected_plan_preimage": {"type": "object"},
    "candidate_refs": {"type": "object"},
    "selection": {"type": "object"},
    "accepted_binding": {"type": "object"},
    "successor_eligibility": {"type": "object"},
    "next_gate": {"const": "G-D65-IMPLEMENTATION"},
    "non_effects": {"type": "array", "minItems": 10, "items": {"type": "string", "minLength": 1}},
    "authority_effect": {"const": "accept-exact-d65-s6-implementation-binding-only"},
    "implementation_authorized": {"const": false},
    "claim_ceiling": {"type": "string", "minLength": 1}
  }
}
