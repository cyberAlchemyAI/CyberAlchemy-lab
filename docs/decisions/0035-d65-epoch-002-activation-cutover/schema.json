{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/cal.d65-activation-cutover-candidate/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "candidate_id", "gate_id", "status", "admitted_product",
    "shadow_evidence", "admissibility", "options", "decision_state",
    "existing_state", "candidate_non_effects", "authority_effect", "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "cal.d65-activation-cutover-candidate/v1"},
    "candidate_id": {"const": "CAL-D65-EPOCH-002-ACTIVATION-CUTOVER-CANDIDATE-001"},
    "gate_id": {"const": "G-D65-EPOCH-002-ACTIVATION-CUTOVER"},
    "status": {"const": "frozen-awaiting-owner-decision"},
    "admitted_product": {"type": "object"},
    "shadow_evidence": {"type": "object"},
    "admissibility": {"type": "object"},
    "options": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "prefixItems": [
        {"$ref": "#/$defs/option1"}, {"$ref": "#/$defs/option2"},
        {"$ref": "#/$defs/option3"}, {"$ref": "#/$defs/option4"}
      ],
      "items": false
    },
    "decision_state": {"const": "not-decided"},
    "existing_state": {
      "type": "object",
      "properties": {
        "implementation_admitted": {"const": true},
        "runtime_activated": {"const": false},
        "migration_authorized": {"const": false},
        "cutover_authorized": {"const": false},
        "cutover_performed": {"const": false}
      },
      "required": ["implementation_admitted", "runtime_activated", "migration_authorized", "cutover_authorized", "cutover_performed"],
      "additionalProperties": false
    },
    "candidate_non_effects": {"$ref": "#/$defs/nonEffects"},
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "optionBase": {
      "type": "object", "additionalProperties": false,
      "required": ["option_id", "option_kind", "meaning", "benefit", "risk", "when_to_choose", "downstream_impact", "if_selected_authority_effect"],
      "properties": {
        "option_id": {"type": "string"},
        "option_kind": {"enum": ["action", "defer", "stop"]},
        "meaning": {"type": "string", "minLength": 1},
        "benefit": {"type": "string", "minLength": 1},
        "risk": {"type": "string", "minLength": 1},
        "when_to_choose": {"type": "string", "minLength": 1},
        "downstream_impact": {"type": "string", "minLength": 1},
        "if_selected_authority_effect": {"type": "string", "minLength": 1}
      }
    },
    "option1": {"allOf": [{"$ref": "#/$defs/optionBase"}, {"properties": {"option_id": {"const": "D65CUT-1"}, "option_kind": {"const": "action"}}}]},
    "option2": {"allOf": [{"$ref": "#/$defs/optionBase"}, {"properties": {"option_id": {"const": "D65CUT-2"}, "option_kind": {"const": "action"}}}]},
    "option3": {"allOf": [{"$ref": "#/$defs/optionBase"}, {"properties": {"option_id": {"const": "D65CUT-3"}, "option_kind": {"const": "defer"}}}]},
    "option4": {"allOf": [{"$ref": "#/$defs/optionBase"}, {"properties": {"option_id": {"const": "D65CUT-4"}, "option_kind": {"const": "stop"}}}]},
    "nonEffects": {
      "type": "object", "additionalProperties": false,
      "required": ["runtime_activated", "migration_authorized", "cutover_authorized", "cutover_performed", "publication_authorized", "release_authorized", "deployment_authorized", "external_effect_authorized", "separate_execution_envelope_required"],
      "properties": {
        "runtime_activated": {"const": false},
        "migration_authorized": {"const": false},
        "cutover_authorized": {"const": false},
        "cutover_performed": {"const": false},
        "publication_authorized": {"const": false},
        "release_authorized": {"const": false},
        "deployment_authorized": {"const": false},
        "external_effect_authorized": {"const": false},
        "separate_execution_envelope_required": {"const": true}
      }
    }
  }
}
