{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/d65-l3-filesystem-adapter-admission-candidate/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "decision_id",
    "gate_id",
    "status",
    "approved_product",
    "adapter_binding",
    "rehearsal_evidence",
    "admissibility",
    "options",
    "decision_state",
    "downstream_authority",
    "authority_effect",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "cal.d65-l3-filesystem-adapter-admission-candidate/v1"},
    "candidate_id": {"const": "CAL-D65-EPOCH-002-FILESYSTEM-ADAPTER-ADMISSION-CANDIDATE-001"},
    "decision_id": {"const": "CAL-D65-L3AADM-0037"},
    "gate_id": {"const": "G-D65-L3-FILESYSTEM-ADAPTER-ADMISSION"},
    "status": {"const": "frozen-awaiting-owner-decision"},
    "approved_product": {"type": "object"},
    "adapter_binding": {"type": "object"},
    "rehearsal_evidence": {"type": "object"},
    "admissibility": {"type": "object"},
    "options": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["option_id", "meaning", "benefit", "risk", "authority_effect"],
        "properties": {
          "option_id": {"enum": ["L3AADM-1", "L3AADM-2", "L3AADM-3", "L3AADM-4"]},
          "meaning": {"type": "string", "minLength": 1},
          "benefit": {"type": "string", "minLength": 1},
          "risk": {"type": "string", "minLength": 1},
          "authority_effect": {"enum": ["adapter-admission-only", "rejection-only", "none"]}
        }
      }
    },
    "decision_state": {"const": "not-decided"},
    "downstream_authority": {"type": "object"},
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  }
}
