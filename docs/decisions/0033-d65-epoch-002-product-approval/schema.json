{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cal.d65-epoch-002-product-approval-decision/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_ref",
    "decision_id",
    "gate_id",
    "status",
    "decided_at",
    "decision_source",
    "admissibility",
    "candidate_refs",
    "selected_option",
    "alternatives",
    "product_approval",
    "downstream_authority",
    "non_effects",
    "authority_effect",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "cal.d65-epoch-002-product-approval-decision/v1"},
    "schema_ref": {"const": "schema.json"},
    "decision_id": {"const": "CAL-D65PAPP-0033"},
    "gate_id": {"const": "G-D65-EPOCH-002-PRODUCT-APPROVAL"},
    "status": {"const": "selected"},
    "decided_at": {"type": "string", "format": "date-time"},
    "decision_source": {"type": "object"},
    "admissibility": {"type": "object"},
    "candidate_refs": {"type": "object"},
    "selected_option": {
      "type": "object",
      "required": ["option_id", "effect"],
      "additionalProperties": false,
      "properties": {
        "option_id": {"const": "D65PAPP-1"},
        "effect": {"const": "product-approval-only"}
      }
    },
    "alternatives": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["D65PAPP-2", "D65PAPP-3", "D65PAPP-4"]}
    },
    "product_approval": {"type": "object"},
    "downstream_authority": {"type": "object"},
    "non_effects": {"type": "array", "minItems": 7, "items": {"type": "string", "minLength": 1}},
    "authority_effect": {"const": "product-approval-only"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  }
}
