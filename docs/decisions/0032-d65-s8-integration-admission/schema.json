{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cal.d65-s8-integration-admission-decision/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_ref",
    "decision_id",
    "gate_id",
    "status",
    "decided_at",
    "decision_source",
    "admissibility",
    "candidate_refs",
    "ordered_decisions",
    "admitted_integration_epoch",
    "successor_preparation",
    "cutover",
    "remaining_gate",
    "non_effects",
    "authority_effect",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "cal.d65-s8-integration-admission-decision/v1"},
    "schema_ref": {"const": "schema.json"},
    "decision_id": {"const": "CAL-D65S8ADM-0032"},
    "gate_id": {"const": "G-INTEGRATION-ADMISSION-CUTOVER"},
    "status": {"const": "selected"},
    "decided_at": {"type": "string", "format": "date-time"},
    "decision_source": {"type": "object"},
    "admissibility": {"type": "object"},
    "candidate_refs": {"type": "object"},
    "ordered_decisions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "object"}
    },
    "admitted_integration_epoch": {"type": "object"},
    "successor_preparation": {"type": "object"},
    "cutover": {"type": "object"},
    "remaining_gate": {"const": "G-INTEGRATION-ADMISSION-CUTOVER/cutover"},
    "non_effects": {"type": "array", "minItems": 8, "items": {"type": "string", "minLength": 1}},
    "authority_effect": {"const": "admit-exact-d65-s8-epoch-and-authorize-reviewed-cutover-candidate-preparation-only"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  }
}
