{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cal.schema.d65-definition-candidate-selection/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_ref",
    "decision_id",
    "gate_id",
    "status",
    "decided_at",
    "decision_source",
    "admissibility",
    "selected_plan_preimage",
    "candidate_refs",
    "selection",
    "selected_canonical_definition_selectors",
    "accepted_local_meanings",
    "next_gate",
    "non_effects",
    "authority_effect",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "cal.d65-definition-candidate-selection-decision/v1"},
    "schema_ref": {"const": "schema.json"},
    "decision_id": {"const": "CAL-D65DEF-0015"},
    "gate_id": {"const": "G-D65-DEFINITIONS"},
    "status": {"const": "selected"},
    "decided_at": {"type": "string", "format": "date-time"},
    "decision_source": {"type": "object"},
    "admissibility": {"type": "object"},
    "selected_plan_preimage": {"type": "object"},
    "candidate_refs": {"type": "object"},
    "selection": {"type": "object"},
    "selected_canonical_definition_selectors": {"type": "array", "minItems": 5, "maxItems": 5},
    "accepted_local_meanings": {"type": "object"},
    "next_gate": {"const": "G-D65-PRODUCT"},
    "non_effects": {"type": "array", "minItems": 4},
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  }
}
