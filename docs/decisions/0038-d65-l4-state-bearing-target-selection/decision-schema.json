{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/d65-l4-state-bearing-target-selection-decision/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_ref",
    "decision_id",
    "gate_id",
    "status",
    "decided_at",
    "decision_source",
    "admissibility",
    "candidate_refs",
    "selected_option",
    "alternatives",
    "rejected_options",
    "rationale",
    "product_direction",
    "downstream_state",
    "non_effects",
    "authority_effect",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "cal.d65-l4-state-bearing-target-selection-decision/v1"},
    "schema_ref": {"const": "decision-schema.json"},
    "decision_id": {"const": "CAL-D65-L4TGT-0038"},
    "gate_id": {"const": "G-D65-L4-STATE-BEARING-TARGET-SELECTION"},
    "status": {"const": "selected"},
    "decided_at": {"type": "string", "format": "date-time"},
    "decision_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "verbatim", "selected_option_id", "observed_count"],
      "properties": {
        "kind": {"const": "explicit-user-selection"},
        "verbatim": {"const": "`L4TGT-1`"},
        "selected_option_id": {"const": "L4TGT-1"},
        "observed_count": {"const": 1}
      }
    },
    "admissibility": {"type": "object"},
    "candidate_refs": {"type": "object"},
    "selected_option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["option_id", "effect"],
      "properties": {
        "option_id": {"const": "L4TGT-1"},
        "effect": {"const": "product-direction-selection-only"}
      }
    },
    "alternatives": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["L4TGT-4", "L4TGT-5"]}
    },
    "rejected_options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["L4TGT-2", "L4TGT-3"]}
    },
    "rationale": {"type": "string", "minLength": 1},
    "product_direction": {"type": "object"},
    "downstream_state": {"type": "object"},
    "non_effects": {
      "type": "array",
      "minItems": 7,
      "items": {"type": "string", "minLength": 1}
    },
    "authority_effect": {"const": "product-direction-selection-only"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  }
}
