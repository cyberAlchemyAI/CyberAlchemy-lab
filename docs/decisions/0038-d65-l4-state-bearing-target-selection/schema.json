{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/d65-l4-state-bearing-target-selection-candidate/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "decision_id",
    "gate_id",
    "status",
    "admitted_predecessor",
    "direct_activation_evaluation",
    "recommended_successor",
    "admissibility",
    "presented_options",
    "rejected_options",
    "decision_state",
    "candidate_non_effects",
    "authority_effect",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "cal.d65-l4-state-bearing-target-selection-candidate/v1"},
    "candidate_id": {"const": "CAL-D65-L4-STATE-BEARING-TARGET-SELECTION-CANDIDATE-001"},
    "decision_id": {"const": "CAL-D65-L4TGT-0038"},
    "gate_id": {"const": "G-D65-L4-STATE-BEARING-TARGET-SELECTION"},
    "status": {"const": "frozen-awaiting-owner-decision"},
    "admitted_predecessor": {"type": "object"},
    "direct_activation_evaluation": {
      "type": "object",
      "required": ["result", "reason", "evidence", "causal_blockers"],
      "properties": {
        "result": {"const": "not_evaluable"},
        "reason": {"type": "string", "minLength": 1},
        "evidence": {"type": "object"},
        "causal_blockers": {"type": "array", "minItems": 3}
      }
    },
    "recommended_successor": {"type": "object"},
    "admissibility": {"type": "object"},
    "presented_options": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["option_id", "option_kind", "meaning", "benefit", "risk", "when_to_choose", "downstream_impact", "if_selected_effect"],
        "properties": {
          "option_id": {"enum": ["L4TGT-1", "L4TGT-4", "L4TGT-5"]},
          "option_kind": {"enum": ["action", "defer", "stop"]},
          "meaning": {"type": "string", "minLength": 1},
          "benefit": {"type": "string", "minLength": 1},
          "risk": {"type": "string", "minLength": 1},
          "when_to_choose": {"type": "string", "minLength": 1},
          "downstream_impact": {"type": "string", "minLength": 1},
          "if_selected_effect": {"enum": ["product-direction-selection-only", "stop-direction-only", "none"]}
        }
      }
    },
    "rejected_options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "object"}
    },
    "decision_state": {"const": "not-decided"},
    "candidate_non_effects": {"type": "object"},
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  }
}
