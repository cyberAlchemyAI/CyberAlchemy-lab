{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/d65-l4-product-approval-decision/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "schema_ref", "decision_id", "gate_id", "status",
    "decided_at", "decision_source", "admissibility", "candidate_refs",
    "selected_option", "alternatives", "rationale", "product_approval",
    "downstream_authority", "non_effects", "authority_effect", "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "cal.d65-l4-product-approval-decision/v1"},
    "schema_ref": {"const": "decision-schema.json"},
    "decision_id": {"const": "CAL-D65-L4PAPP-0039"},
    "gate_id": {"const": "G-D65-L4-STATE-BEARING-SANDBOX-PRODUCT-APPROVAL"},
    "status": {"const": "selected"},
    "decided_at": {"type": "string", "format": "date-time"},
    "decision_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "verbatim", "selected_option_id", "observed_count"],
      "properties": {
        "kind": {"const": "explicit-user-selection"},
        "verbatim": {"const": "`L4PAPP-1`"},
        "selected_option_id": {"const": "L4PAPP-1"},
        "observed_count": {"const": 1}
      }
    },
    "admissibility": {"type": "object"},
    "candidate_refs": {"type": "object"},
    "selected_option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["option_id", "effect"],
      "properties": {
        "option_id": {"const": "L4PAPP-1"},
        "effect": {"const": "product-approval-only"}
      }
    },
    "alternatives": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["L4PAPP-2", "L4PAPP-3", "L4PAPP-4"]}
    },
    "rationale": {"type": "string", "minLength": 1},
    "product_approval": {"type": "object"},
    "downstream_authority": {"type": "object"},
    "non_effects": {"type": "array", "minItems": 7, "items": {"type": "string", "minLength": 1}},
    "authority_effect": {"const": "product-approval-only"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  }
}
