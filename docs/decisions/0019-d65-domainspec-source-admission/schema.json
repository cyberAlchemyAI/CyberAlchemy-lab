{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cal.schema.d65-domainspec-source-admission/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schema_ref", "decision_id", "gate_id", "status", "decided_at", "decision_source", "admissibility", "selected_plan_preimage", "candidate_refs", "selection", "admitted_source_meaning", "next_gate", "non_effects", "authority_effect", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "cal.d65-domainspec-source-admission-decision/v1"},
    "schema_ref": {"const": "schema.json"},
    "decision_id": {"const": "CAL-D65SRC-0019"},
    "gate_id": {"const": "G-D65-DOMAINSPEC-SOURCE"},
    "status": {"const": "selected"},
    "decided_at": {"type": "string", "format": "date-time"},
    "decision_source": {"type": "object"},
    "admissibility": {"type": "object"},
    "selected_plan_preimage": {"type": "object"},
    "candidate_refs": {"type": "object"},
    "selection": {"type": "object"},
    "admitted_source_meaning": {"type": "object"},
    "next_gate": {"const": "G-D65-COMPILE"},
    "non_effects": {"type": "array", "minItems": 8},
    "authority_effect": {"const": "admit-exact-d65-s4-domainspec-source-only"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  }
}
