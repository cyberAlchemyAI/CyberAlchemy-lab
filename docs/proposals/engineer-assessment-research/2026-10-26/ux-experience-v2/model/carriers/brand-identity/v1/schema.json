{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type_ref": {
      "const": "ea.artifact-type.brand-identity/v1-candidate"
    },
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "minLength": 1,
      "type": "string"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "record_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "ea.brand-identity/v1-candidate"
    },
    "source_excerpt_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "source_index": {
      "minimum": 0,
      "type": "integer"
    },
    "source_ref": {
      "const": "design/source.json"
    },
    "source_row": {
      "additionalProperties": false,
      "properties": {
        "acceptance": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "audiences": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "experiment_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "metric_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "non_promises": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "owner_route": {
          "minLength": 1,
          "type": "string"
        },
        "promise": {
          "minLength": 1,
          "type": "string"
        },
        "purpose": {
          "minLength": 1,
          "type": "string"
        },
        "requirements": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "acceptance",
        "audiences",
        "experiment_refs",
        "id",
        "metric_refs",
        "non_promises",
        "owner_route",
        "promise",
        "purpose",
        "requirements",
        "title"
      ],
      "type": "object"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "version": {
      "const": "0.1.0-candidate.1"
    }
  },
  "required": [
    "schema_version",
    "artifact_type_ref",
    "record_id",
    "version",
    "status",
    "authority_effect",
    "source_ref",
    "source_sha256",
    "source_index",
    "source_excerpt_sha256",
    "owner_ref",
    "challenge_route",
    "source_row",
    "claim_ceiling"
  ],
  "type": "object"
}
