{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type_ref": {
      "const": "ea.artifact-type.policy-clause/v1-candidate"
    },
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "minLength": 1,
      "type": "string"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "condition": {
      "minLength": 1,
      "type": "string"
    },
    "effect": {
      "enum": [
        "require",
        "prohibit",
        "permit",
        "hold"
      ]
    },
    "enforcement_point": {
      "minLength": 1,
      "type": "string"
    },
    "exception_route": {
      "minLength": 1,
      "type": "string"
    },
    "open_parameters": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "owner_role": {
      "minLength": 1,
      "type": "string"
    },
    "policy_ref": {
      "minLength": 1,
      "type": "string"
    },
    "record_id": {
      "minLength": 1,
      "type": "string"
    },
    "required_evidence": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "ea.policy-clause/v1-candidate"
    },
    "source_excerpt_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "source_index": {
      "minimum": 0,
      "type": "integer"
    },
    "source_ref": {
      "minLength": 1,
      "type": "string"
    },
    "source_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "statement": {
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "record_id",
    "version",
    "status",
    "authority_effect",
    "source_ref",
    "source_sha256",
    "source_index",
    "source_excerpt_sha256",
    "owner_ref",
    "challenge_route",
    "claim_ceiling",
    "schema_version",
    "artifact_type_ref",
    "policy_ref",
    "condition",
    "effect",
    "statement",
    "enforcement_point",
    "required_evidence",
    "exception_route",
    "owner_role",
    "source_refs",
    "open_parameters"
  ],
  "type": "object"
}
