{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "administration_policy_ref": {
      "minLength": 1,
      "type": "string"
    },
    "approval_ref": {
      "type": "null"
    },
    "artifact_type_ref": {
      "const": "ea.artifact-type.assistance-matrix/v1-candidate"
    },
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "minLength": 1,
      "type": "string"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "notice_requirement": {
      "minLength": 1,
      "type": "string"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "owner_role": {
      "minLength": 1,
      "type": "string"
    },
    "policy_ref": {
      "minLength": 1,
      "type": "string"
    },
    "pre_exposure_note": {
      "minLength": 1,
      "type": "string"
    },
    "record_id": {
      "minLength": 1,
      "type": "string"
    },
    "rows": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "accessibility_protection": {
            "type": "boolean"
          },
          "baseline_state": {
            "enum": [
              "candidate-permit",
              "candidate-prohibit"
            ]
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "phase": {
            "enum": [
              "before-case",
              "timed-answer"
            ]
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          },
          "research_override": {
            "type": [
              "string",
              "null"
            ]
          },
          "resource": {
            "minLength": 1,
            "type": "string"
          },
          "session": {
            "maximum": 3,
            "minimum": 1,
            "type": "integer"
          },
          "violation_handling": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "session",
          "resource",
          "phase",
          "baseline_state",
          "reason",
          "research_override",
          "violation_handling",
          "accessibility_protection"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "ea.assistance-matrix/v1-candidate"
    },
    "source_excerpt_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "source_index": {
      "minimum": 0,
      "type": "integer"
    },
    "source_ref": {
      "minLength": 1,
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "record_id",
    "version",
    "status",
    "authority_effect",
    "source_ref",
    "source_sha256",
    "source_index",
    "source_excerpt_sha256",
    "owner_ref",
    "challenge_route",
    "claim_ceiling",
    "schema_version",
    "artifact_type_ref",
    "policy_ref",
    "administration_policy_ref",
    "notice_requirement",
    "pre_exposure_note",
    "rows",
    "owner_role",
    "approval_ref"
  ],
  "type": "object"
}
