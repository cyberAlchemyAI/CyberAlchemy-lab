{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type_ref": {
      "const": "ea.artifact-type.integration-boundary/v1-candidate"
    },
    "authority_effect": {
      "const": "none"
    },
    "capability_ref": {
      "minLength": 1,
      "type": "string"
    },
    "challenge_contract_ref": {
      "minLength": 1,
      "type": "string"
    },
    "challenge_route": {
      "minLength": 1,
      "type": "string"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "consumer": {
      "minLength": 1,
      "type": "string"
    },
    "data_classification": {
      "minLength": 1,
      "type": "string"
    },
    "failure_and_recovery": {
      "minLength": 1,
      "type": "string"
    },
    "inputs": {
      "minLength": 1,
      "type": "string"
    },
    "interface_contract": {
      "minLength": 1,
      "type": "string"
    },
    "invariants": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "option_review_ref": {
      "minLength": 1,
      "type": "string"
    },
    "outputs": {
      "minLength": 1,
      "type": "string"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "producer": {
      "minLength": 1,
      "type": "string"
    },
    "purpose": {
      "minLength": 1,
      "type": "string"
    },
    "record_id": {
      "minLength": 1,
      "type": "string"
    },
    "responsibility": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "ea.integration-boundary/v1-candidate"
    },
    "slug": {
      "minLength": 1,
      "type": "string"
    },
    "source_excerpt_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "source_index": {
      "minimum": 0,
      "type": "integer"
    },
    "source_ref": {
      "minLength": 1,
      "type": "string"
    },
    "source_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "verification_contract_ref": {
      "minLength": 1,
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "artifact_type_ref",
    "record_id",
    "version",
    "status",
    "authority_effect",
    "source_ref",
    "source_sha256",
    "source_index",
    "source_excerpt_sha256",
    "slug",
    "responsibility",
    "producer",
    "consumer",
    "inputs",
    "outputs",
    "data_classification",
    "purpose",
    "interface_contract",
    "capability_ref",
    "invariants",
    "failure_and_recovery",
    "source_refs",
    "option_review_ref",
    "verification_contract_ref",
    "challenge_contract_ref",
    "owner_ref",
    "challenge_route",
    "claim_ceiling"
  ],
  "type": "object"
}
