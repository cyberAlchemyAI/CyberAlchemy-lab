{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapter_contract_ref": {
      "minLength": 1,
      "type": "string"
    },
    "artifact_type_ref": {
      "const": "ea.artifact-type.integration-binding/v1-candidate"
    },
    "authority_effect": {
      "const": "none"
    },
    "boundary_ref": {
      "minLength": 1,
      "type": "string"
    },
    "challenge_contract_ref": {
      "minLength": 1,
      "type": "string"
    },
    "challenge_route": {
      "minLength": 1,
      "type": "string"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "component_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "configuration_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "data_route_ref": {
      "minLength": 1,
      "type": "string"
    },
    "environment_ref": {
      "minLength": 1,
      "type": "string"
    },
    "operating_owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "owner_decision_ref": {
      "minLength": 1,
      "type": "string"
    },
    "privacy_approval_ref": {
      "minLength": 1,
      "type": "string"
    },
    "record_id": {
      "minLength": 1,
      "type": "string"
    },
    "release_ref": {
      "minLength": 1,
      "type": "string"
    },
    "rollback_ref": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "ea.integration-binding/v1-candidate"
    },
    "status": {
      "enum": [
        "candidate-unadmitted",
        "selected-pending-activation",
        "active",
        "retired"
      ]
    },
    "verification_result_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "version": {
      "minLength": 1,
      "type": "string"
    },
    "version_pins": {
      "additionalProperties": {
        "minLength": 1,
        "type": "string"
      },
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "artifact_type_ref",
    "record_id",
    "version",
    "status",
    "authority_effect",
    "boundary_ref",
    "environment_ref",
    "component_refs",
    "version_pins",
    "configuration_digest",
    "adapter_contract_ref",
    "data_route_ref",
    "owner_decision_ref",
    "challenge_contract_ref",
    "verification_result_refs",
    "privacy_approval_ref",
    "operating_owner_ref",
    "rollback_ref",
    "release_ref",
    "challenge_route",
    "claim_ceiling"
  ],
  "type": "object"
}
