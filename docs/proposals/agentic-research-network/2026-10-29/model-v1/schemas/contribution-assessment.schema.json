{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/arn/contribution-assessment/v1",
  "title": "ARN contribution-assessment candidate record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "version",
    "status",
    "authority_effect",
    "subject_ref",
    "owner_ref",
    "source_refs",
    "challenge_route",
    "claim_ceiling",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "arn.contribution-assessment/v1"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "authority_effect": {
      "const": "none"
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "owner_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "challenge_route": {
      "type": "string",
      "minLength": 1
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_ref",
        "claimant_refs",
        "role",
        "baseline_ref",
        "evidence_refs",
        "counterevidence_refs",
        "duplicate_check",
        "causal_account",
        "decision_impact",
        "reviewer_refs",
        "conflict_declarations",
        "recommendation",
        "appeal_deadline"
      ],
      "properties": {
        "object_ref": {
          "type": "string",
          "minLength": 1
        },
        "claimant_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "role": {
          "enum": [
            "research-advance",
            "execution-work",
            "mixed"
          ]
        },
        "baseline_ref": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "counterevidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "duplicate_check": {
          "type": "string",
          "minLength": 1
        },
        "causal_account": {
          "type": "string",
          "minLength": 1
        },
        "decision_impact": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "conflict_declarations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "recommendation": {
          "enum": [
            "no-credit",
            "hold",
            "work-reward-candidate",
            "participation-candidate",
            "both-candidate"
          ]
        },
        "appeal_deadline": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
