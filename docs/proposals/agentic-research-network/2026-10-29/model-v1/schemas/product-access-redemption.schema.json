{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/arn/product-access-redemption/v1",
  "title": "ARN product-access-redemption candidate record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "version",
    "status",
    "authority_effect",
    "subject_ref",
    "owner_ref",
    "source_refs",
    "challenge_route",
    "claim_ceiling",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "arn.product-access-redemption/v1"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "authority_effect": {
      "const": "none"
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "owner_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "challenge_route": {
      "type": "string",
      "minLength": 1
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_ref",
        "service_ref",
        "balance_ref",
        "debit",
        "access_decision_ref",
        "consent_ref",
        "fulfillment_ref"
      ],
      "properties": {
        "product_ref": {
          "type": "string",
          "minLength": 1
        },
        "service_ref": {
          "type": "string",
          "minLength": 1
        },
        "balance_ref": {
          "type": "string",
          "minLength": 1
        },
        "debit": {
          "type": "string",
          "minLength": 1
        },
        "access_decision_ref": {
          "type": "string",
          "minLength": 1
        },
        "consent_ref": {
          "type": "string",
          "minLength": 1
        },
        "fulfillment_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
