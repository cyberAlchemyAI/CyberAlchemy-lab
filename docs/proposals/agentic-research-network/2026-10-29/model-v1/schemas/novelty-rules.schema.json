{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/arn/novelty-rules/v1",
  "title": "ARN Novelty Rule Set candidate record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "version",
    "status",
    "authority_effect",
    "subject_ref",
    "owner_ref",
    "source_refs",
    "challenge_route",
    "claim_ceiling",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "arn.novelty-rules/v1"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "authority_effect": {
      "const": "none"
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "owner_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "challenge_route": {
      "type": "string",
      "minLength": 1
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison_scope",
        "allowed_units",
        "check_result_values",
        "rules",
        "dispositions",
        "promotion_boundary"
      ],
      "properties": {
        "comparison_scope": {
          "type": "string",
          "minLength": 1
        },
        "allowed_units": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "check_result_values": {
          "const": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "rules": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "question",
              "failure_effect"
            ],
            "properties": {
              "id": {
                "enum": [
                  "NR-01",
                  "NR-02",
                  "NR-03",
                  "NR-04",
                  "NR-05",
                  "NR-06",
                  "NR-07"
                ]
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "failure_effect": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "dispositions": {
          "const": [
            "duplicate",
            "hold",
            "test-candidate",
            "useful-local-addition",
            "rejected-after-test"
          ]
        },
        "promotion_boundary": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
