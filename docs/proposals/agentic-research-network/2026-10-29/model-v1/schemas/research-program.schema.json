{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/arn/research-program/v1",
  "title": "ARN research-program candidate record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "version",
    "status",
    "authority_effect",
    "subject_ref",
    "owner_ref",
    "source_refs",
    "challenge_route",
    "claim_ceiling",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "arn.research-program/v1"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "authority_effect": {
      "const": "none"
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "owner_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "challenge_route": {
      "type": "string",
      "minLength": 1
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_ref",
        "thesis_ref",
        "charter_ref",
        "budget_ref",
        "rights_policy_ref",
        "disclosure_ref",
        "research_owner_ref"
      ],
      "properties": {
        "product_ref": {
          "type": "string",
          "minLength": 1
        },
        "thesis_ref": {
          "type": "string",
          "minLength": 1
        },
        "charter_ref": {
          "type": "string",
          "minLength": 1
        },
        "budget_ref": {
          "type": "string",
          "minLength": 1
        },
        "rights_policy_ref": {
          "type": "string",
          "minLength": 1
        },
        "disclosure_ref": {
          "type": "string",
          "minLength": 1
        },
        "research_owner_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
