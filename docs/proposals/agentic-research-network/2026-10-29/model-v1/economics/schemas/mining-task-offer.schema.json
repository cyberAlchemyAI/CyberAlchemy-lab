{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/arn/mining-task-offer/v1",
  "title": "ARN mining-task-offer candidate record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "version",
    "status",
    "authority_effect",
    "subject_ref",
    "owner_ref",
    "source_refs",
    "challenge_route",
    "claim_ceiling",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "arn.mining-task-offer/v1"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "authority_effect": {
      "const": "none"
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "owner_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "challenge_route": {
      "type": "string",
      "minLength": 1
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program_ref",
        "epoch_ref",
        "inquiry_ref",
        "decision_target_ref",
        "task_kind",
        "baseline_ref",
        "novelty_rules_ref",
        "rights_policy_ref",
        "slots",
        "base_bounty_units",
        "decision_bonus_units",
        "reviewer_fee_units",
        "max_liability_units",
        "commit_deadline",
        "reveal_deadline",
        "challenge_end",
        "quality_criteria",
        "reproducibility_rule",
        "decision_ref",
        "application_deadline",
        "assignment_rule",
        "epoch_seed_ref",
        "replication_policy"
      ],
      "properties": {
        "program_ref": {
          "type": "string",
          "minLength": 1
        },
        "epoch_ref": {
          "type": "string",
          "minLength": 1
        },
        "inquiry_ref": {
          "type": "string",
          "minLength": 1
        },
        "decision_target_ref": {
          "type": "string",
          "minLength": 1
        },
        "task_kind": {
          "enum": [
            "question",
            "prior-search",
            "design",
            "simulation",
            "experiment",
            "evaluator",
            "replication",
            "product-feedback"
          ]
        },
        "baseline_ref": {
          "type": "string",
          "minLength": 1
        },
        "novelty_rules_ref": {
          "type": "string",
          "minLength": 1
        },
        "rights_policy_ref": {
          "type": "string",
          "minLength": 1
        },
        "slots": {
          "type": "integer",
          "minimum": 1
        },
        "base_bounty_units": {
          "type": "integer",
          "minimum": 1
        },
        "decision_bonus_units": {
          "type": "integer",
          "minimum": 0
        },
        "reviewer_fee_units": {
          "type": "integer",
          "minimum": 1
        },
        "max_liability_units": {
          "type": "integer",
          "minimum": 1
        },
        "commit_deadline": {
          "type": "string",
          "minLength": 1
        },
        "reveal_deadline": {
          "type": "string",
          "minLength": 1
        },
        "challenge_end": {
          "type": "string",
          "minLength": 1
        },
        "quality_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "reproducibility_rule": {
          "type": "string",
          "minLength": 1
        },
        "decision_ref": {
          "type": "string",
          "minLength": 1
        },
        "application_deadline": {
          "type": "string",
          "minLength": 1
        },
        "assignment_rule": {
          "type": "string",
          "minLength": 1
        },
        "epoch_seed_ref": {
          "type": "string",
          "minLength": 1
        },
        "replication_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
