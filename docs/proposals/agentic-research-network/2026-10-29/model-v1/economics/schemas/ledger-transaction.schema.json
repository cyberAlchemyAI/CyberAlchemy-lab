{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/arn/ledger-transaction/v1",
  "title": "ARN ledger-transaction candidate record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "version",
    "status",
    "authority_effect",
    "subject_ref",
    "owner_ref",
    "source_refs",
    "challenge_route",
    "claim_ceiling",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "arn.ledger-transaction/v1"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "authority_effect": {
      "const": "none"
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "owner_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "challenge_route": {
      "type": "string",
      "minLength": 1
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "previous_digest",
        "asset_ref",
        "kind",
        "amount_units",
        "debit_account",
        "credit_account",
        "signer_ref",
        "signer_nonce",
        "idempotency_key",
        "decision_ref",
        "event_digest",
        "finality_state"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "previous_digest": {
          "type": "string",
          "minLength": 1
        },
        "asset_ref": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "work-award",
            "review-fee",
            "transfer",
            "product-redemption",
            "unit-allocation",
            "eligible-revenue-deposit",
            "stablecoin-settlement",
            "compensation"
          ]
        },
        "amount_units": {
          "type": "integer",
          "minimum": 1
        },
        "debit_account": {
          "type": "string",
          "minLength": 1
        },
        "credit_account": {
          "type": "string",
          "minLength": 1
        },
        "signer_ref": {
          "type": "string",
          "minLength": 1
        },
        "signer_nonce": {
          "type": "integer",
          "minimum": 0
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        },
        "decision_ref": {
          "type": "string",
          "minLength": 1
        },
        "event_digest": {
          "type": "string",
          "minLength": 1
        },
        "finality_state": {
          "enum": [
            "simulation-only",
            "pending",
            "final",
            "reversed"
          ]
        }
      }
    }
  }
}
