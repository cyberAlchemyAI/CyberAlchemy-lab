{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/arn/service-redemption-policy/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "version",
    "status",
    "authority_effect",
    "subject_ref",
    "owner_ref",
    "source_refs",
    "challenge_route",
    "claim_ceiling",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "arn.service-redemption-policy/v1"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "authority_effect": {
      "const": "none"
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "owner_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "challenge_route": {
      "type": "string",
      "minLength": 1
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_ref",
        "service_ref",
        "period_rule",
        "price_w_units",
        "capacity_units",
        "marginal_cost_c_units",
        "service_budget_c_units",
        "eligibility_rule",
        "consent_rule",
        "refund_rule",
        "owner_decision_ref",
        "open_decisions"
      ],
      "properties": {
        "product_ref": {
          "type": "string",
          "minLength": 1
        },
        "service_ref": {
          "type": "string",
          "minLength": 1
        },
        "period_rule": {
          "type": "string",
          "minLength": 1
        },
        "price_w_units": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "capacity_units": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "marginal_cost_c_units": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "service_budget_c_units": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "eligibility_rule": {
          "type": "string",
          "minLength": 1
        },
        "consent_rule": {
          "type": "string",
          "minLength": 1
        },
        "refund_rule": {
          "type": "string",
          "minLength": 1
        },
        "owner_decision_ref": {
          "type": "string",
          "minLength": 1
        },
        "open_decisions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
