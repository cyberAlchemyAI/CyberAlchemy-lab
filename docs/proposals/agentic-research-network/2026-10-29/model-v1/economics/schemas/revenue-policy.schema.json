{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/arn/revenue-policy/v1",
  "title": "ARN revenue-policy candidate record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "version",
    "status",
    "authority_effect",
    "subject_ref",
    "owner_ref",
    "source_refs",
    "challenge_route",
    "claim_ceiling",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "arn.revenue-policy/v1"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "authority_effect": {
      "const": "none"
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "owner_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "challenge_route": {
      "type": "string",
      "minLength": 1
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_ref",
        "participation_policy_ref",
        "share_bps",
        "fixed_unit_cap",
        "eligible_receipt_kinds",
        "excluded_receipt_kinds",
        "allowed_deduction_kinds",
        "accounting_period_rule",
        "duration_rule",
        "audit_rule",
        "settlement_finality_rule",
        "open_decisions"
      ],
      "properties": {
        "product_ref": {
          "type": "string",
          "minLength": 1
        },
        "participation_policy_ref": {
          "type": "string",
          "minLength": 1
        },
        "share_bps": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "fixed_unit_cap": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "eligible_receipt_kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "excluded_receipt_kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "allowed_deduction_kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "accounting_period_rule": {
          "type": "string",
          "minLength": 1
        },
        "duration_rule": {
          "type": "string",
          "minLength": 1
        },
        "audit_rule": {
          "type": "string",
          "minLength": 1
        },
        "settlement_finality_rule": {
          "type": "string",
          "minLength": 1
        },
        "open_decisions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
