{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/arn/decision-rights-profile/v1",
  "title": "ARN decision-rights-profile candidate record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "status",
    "authority_effect",
    "claim_ceiling",
    "project_ref",
    "policy_ref",
    "role_registry_ref",
    "actions",
    "direct_transactions_note"
  ],
  "properties": {
    "schema_version": {
      "const": "arn.decision-rights-profile/v1"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "authority_effect": {
      "const": "none"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "project_ref": {
      "type": "string",
      "minLength": 1
    },
    "policy_ref": {
      "type": "string",
      "minLength": 1
    },
    "role_registry_ref": {
      "type": "string",
      "minLength": 1
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "proposer_roles",
          "reviewer_quorum",
          "approver_quorum",
          "executor_quorum",
          "required_evidence",
          "separation_pairs",
          "subject_excluded_stages",
          "requires_challenge_close",
          "min_delay_seconds",
          "prospective_only",
          "max_duration_seconds",
          "claim_ceiling"
        ],
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "proposer_roles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "reviewer_quorum": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role_ref",
                "count"
              ],
              "properties": {
                "role_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "count": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "approver_quorum": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role_ref",
                "count"
              ],
              "properties": {
                "role_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "count": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "executor_quorum": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role_ref",
                "count"
              ],
              "properties": {
                "role_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "count": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "required_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "separation_pairs": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "enum": [
                  "proposer",
                  "reviewers",
                  "approvers",
                  "executors"
                ]
              }
            }
          },
          "subject_excluded_stages": {
            "type": "array",
            "items": {
              "enum": [
                "proposer",
                "reviewers",
                "approvers",
                "executors"
              ]
            },
            "uniqueItems": true
          },
          "requires_challenge_close": {
            "type": "boolean"
          },
          "min_delay_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "prospective_only": {
            "type": "boolean"
          },
          "max_duration_seconds": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "claim_ceiling": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "direct_transactions_note": {
      "type": "string",
      "minLength": 1
    }
  }
}
