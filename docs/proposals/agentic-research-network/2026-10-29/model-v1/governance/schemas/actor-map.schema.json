{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/arn/actor-map/v1",
  "title": "ARN actor-map candidate record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "status",
    "authority_effect",
    "claim_ceiling",
    "project_ref",
    "roles",
    "stakeholder_kinds",
    "agent_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "arn.actor-map/v1"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "authority_effect": {
      "const": "none"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "project_ref": {
      "type": "string",
      "minLength": 1
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role_id",
          "name",
          "functions",
          "exclusions",
          "eligible_actor_kinds",
          "assignment_state"
        ],
        "properties": {
          "role_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "functions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "exclusions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "eligible_actor_kinds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "assignment_state": {
            "const": "unassigned"
          }
        }
      }
    },
    "stakeholder_kinds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "standing"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "standing": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "agent_boundary": {
      "type": "string",
      "minLength": 1
    }
  }
}
