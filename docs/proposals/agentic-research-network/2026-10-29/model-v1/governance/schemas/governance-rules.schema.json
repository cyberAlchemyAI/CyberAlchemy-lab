{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/arn/governance-rules/v1",
  "title": "ARN governance-rules candidate record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "status",
    "authority_effect",
    "claim_ceiling",
    "project_ref",
    "rules",
    "change_rule"
  ],
  "properties": {
    "schema_version": {
      "const": "arn.governance-rules/v1"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "authority_effect": {
      "const": "none"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "project_ref": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "statement",
          "applies_to",
          "required_evidence",
          "failure_effect",
          "owner_role_ref"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^ARN-G[0-9]{2}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "applies_to": {
            "type": "string",
            "minLength": 1
          },
          "required_evidence": {
            "type": "string",
            "minLength": 1
          },
          "failure_effect": {
            "enum": [
              "hold",
              "reject",
              "pause"
            ]
          },
          "owner_role_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "change_rule": {
      "type": "string",
      "minLength": 1
    }
  }
}
