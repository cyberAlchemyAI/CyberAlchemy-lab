      ],
      "text": "Keep twelve correct sealed releases by minute 13 fixed. Transfer supplies nine source carriers; inspection handles twelve and must correct B9. Transfer labor ranks only successful sequences."
    },
    {
      "id": "core_action",
      "source_refs": [
        "C2",
        "C3",
        "C4",
        "C5",
        "C6",
