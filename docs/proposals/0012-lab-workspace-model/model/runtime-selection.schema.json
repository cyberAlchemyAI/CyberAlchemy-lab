{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cyberalchemy:proposal:workspace-runtime-selection:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_ref",
    "workspace_revision_ref",
    "claim_ceiling",
    "format",
    "authority_effect",
    "mode",
    "behavior",
    "runtime_ref",
    "specialization_ref",
    "selection_state",
    "runtime_provisioned",
    "copy_runtime",
    "authority_grants"
  ],
  "properties": {
    "workspace_ref": {
      "type": "string",
      "minLength": 1
    },
    "workspace_revision_ref": {
      "type": "string",
      "minLength": 1
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "const": "lab-workspace-runtime-selection/v1-candidate"
    },
    "authority_effect": {
      "const": "none"
    },
    "mode": {
      "enum": [
        "shared",
        "dedicated"
      ]
    },
    "behavior": {
      "enum": [
        "inherited",
        "specialized"
      ]
    },
    "runtime_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "specialization_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "selection_state": {
      "enum": [
        "proposed-default-not-a-deployment",
        "proposed-explicit-not-a-deployment"
      ]
    },
    "runtime_provisioned": {
      "const": false
    },
    "copy_runtime": {
      "const": false
    },
    "authority_grants": {
      "type": "array",
      "maxItems": 0
    }
  }
}
