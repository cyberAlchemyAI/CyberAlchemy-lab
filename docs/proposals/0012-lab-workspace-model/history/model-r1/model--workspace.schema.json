{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cyberalchemy:proposal:lab-workspace-profile:v1",
  "title": "Local Lab Workspace proposal profile; not an admitted Artifact Type",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_ref",
    "revision",
    "project_ref",
    "purpose",
    "scope_ref",
    "owner_route",
    "current_location",
    "proposed_location",
    "source_selection_ref",
    "claim_ceiling",
    "schema_version",
    "status",
    "authority_effect",
    "product_ref",
    "areas",
    "goals",
    "canonical_home_refs",
    "adoption",
    "local_configuration",
    "recursion",
    "shared_runtime_policy",
    "runtime_installation_refs",
    "actual_adoption_outcome",
    "global_relation_effects",
    "authority_grants"
  ],
  "properties": {
    "workspace_ref": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "project_ref": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "scope_ref": {
      "type": "string",
      "minLength": 1
    },
    "owner_route": {
      "type": "string",
      "minLength": 1
    },
    "current_location": {
      "type": "string",
      "minLength": 1
    },
    "proposed_location": {
      "type": "string",
      "minLength": 1
    },
    "source_selection_ref": {
      "type": "string",
      "minLength": 1
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "lab-workspace-profile/v1-candidate"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "authority_effect": {
      "const": "none"
    },
    "product_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "areas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "project",
        "work",
        "authority",
        "ontology",
        "architecture",
        "implementation",
        "docs"
      ],
      "properties": {
        "product": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_home",
            "selection_home",
            "owner_route",
            "semantic_ownership_policy"
          ],
          "properties": {
            "source_home": {
              "type": "string",
              "minLength": 1
            },
            "selection_home": {
              "type": "string",
              "minLength": 1
            },
            "owner_route": {
              "type": "string",
              "minLength": 1
            },
            "semantic_ownership_policy": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "project": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_home",
            "selection_home",
            "owner_route",
            "semantic_ownership_policy"
          ],
          "properties": {
            "source_home": {
              "type": "string",
              "minLength": 1
            },
            "selection_home": {
              "type": "string",
              "minLength": 1
            },
            "owner_route": {
              "type": "string",
              "minLength": 1
            },
            "semantic_ownership_policy": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "work": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_home",
            "selection_home",
            "owner_route",
            "semantic_ownership_policy"
          ],
          "properties": {
            "source_home": {
              "type": "string",
              "minLength": 1
            },
            "selection_home": {
              "type": "string",
              "minLength": 1
            },
            "owner_route": {
              "type": "string",
              "minLength": 1
            },
            "semantic_ownership_policy": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_home",
            "selection_home",
            "owner_route",
            "semantic_ownership_policy"
          ],
          "properties": {
            "source_home": {
              "type": "string",
              "minLength": 1
            },
            "selection_home": {
              "type": "string",
              "minLength": 1
            },
            "owner_route": {
              "type": "string",
              "minLength": 1
            },
            "semantic_ownership_policy": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "ontology": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_home",
            "selection_home",
            "owner_route",
            "semantic_ownership_policy"
          ],
          "properties": {
            "source_home": {
              "type": "string",
              "minLength": 1
            },
            "selection_home": {
              "type": "string",
              "minLength": 1
            },
            "owner_route": {
              "type": "string",
              "minLength": 1
            },
            "semantic_ownership_policy": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "architecture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_home",
            "selection_home",
            "owner_route",
            "semantic_ownership_policy"
          ],
          "properties": {
            "source_home": {
              "type": "string",
              "minLength": 1
            },
            "selection_home": {
              "type": "string",
              "minLength": 1
            },
            "owner_route": {
              "type": "string",
              "minLength": 1
            },
            "semantic_ownership_policy": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_home",
            "selection_home",
            "owner_route",
            "semantic_ownership_policy"
          ],
          "properties": {
            "source_home": {
              "type": "string",
              "minLength": 1
            },
            "selection_home": {
              "type": "string",
              "minLength": 1
            },
            "owner_route": {
              "type": "string",
              "minLength": 1
            },
            "semantic_ownership_policy": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "docs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_home",
            "selection_home",
            "owner_route",
            "semantic_ownership_policy"
          ],
          "properties": {
            "source_home": {
              "type": "string",
              "minLength": 1
            },
            "selection_home": {
              "type": "string",
              "minLength": 1
            },
            "owner_route": {
              "type": "string",
              "minLength": 1
            },
            "semantic_ownership_policy": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "goal_ref",
          "path",
          "membership"
        ],
        "properties": {
          "goal_ref": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "membership": {
            "enum": [
              "existing-source-reference",
              "candidate-reverse-link-not-applied"
            ]
          }
        }
      }
    },
    "canonical_home_refs": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "adoption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_ref",
        "model_version_ref",
        "binding_ref",
        "profile_revision"
      ],
      "properties": {
        "model_ref": {
          "type": "string",
          "minLength": 1
        },
        "model_version_ref": {
          "type": "string",
          "minLength": 1
        },
        "binding_ref": {
          "type": "string",
          "minLength": 1
        },
        "profile_revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "local_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_budget_tokens",
        "operator_note"
      ],
      "properties": {
        "context_budget_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "operator_note": {
          "type": "string",
          "maxLength": 160
        }
      }
    },
    "recursion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_depth",
        "stop"
      ],
      "properties": {
        "max_depth": {
          "const": 1
        },
        "stop": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "shared_runtime_policy": {
      "const": "reference-only-no-copy-no-shared-writes"
    },
    "runtime_installation_refs": {
      "type": "array",
      "maxItems": 0
    },
    "actual_adoption_outcome": {
      "type": "null"
    },
    "global_relation_effects": {
      "type": "array",
      "maxItems": 0
    },
    "authority_grants": {
      "type": "array",
      "maxItems": 0
    }
  }
