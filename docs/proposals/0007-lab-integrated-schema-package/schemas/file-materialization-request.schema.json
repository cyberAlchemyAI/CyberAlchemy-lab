{
  "$id": "urn:cyberalchemy-lab:protocol:file-materialization-request:v1-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "rendered"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "renderer_binding": {
            "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
          }
        },
        "required": [
          "renderer_binding"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "byte-exact"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "renderer_binding": {
            "type": "null"
          }
        },
        "required": [
          "renderer_binding"
        ]
      }
    }
  ],
  "properties": {
    "actor": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/actor"
    },
    "artifact_refs": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"
      },
      "minItems": 0,
      "type": "array"
    },
    "authority_effect": {
      "const": "none"
    },
    "include_session_memory": {
      "const": false
    },
    "managed_relative_paths": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/safe_relative_path"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "mode": {
      "enum": [
        "byte-exact",
        "rendered"
      ]
    },
    "output_root_scope_ref": {
      "minLength": 1,
      "type": "string"
    },
    "overwrite_unmanaged_files": {
      "const": false
    },
    "privacy_review_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "renderer_binding": {
      "anyOf": [
        {
          "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_ref": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "lab-file-materialization-request/v1-candidate"
    },
    "selection_ref": {
      "minLength": 1,
      "type": "string"
    },
    "source_cut": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/source_cut"
    }
  },
  "required": [
    "schema_version",
    "request_ref",
    "actor",
    "source_cut",
    "selection_ref",
    "artifact_refs",
    "output_root_scope_ref",
    "mode",
    "renderer_binding",
    "managed_relative_paths",
    "overwrite_unmanaged_files",
    "include_session_memory",
    "privacy_review_binding",
    "authority_effect"
  ],
  "title": "Candidate Lab file-materialization-request",
  "type": "object"
}
