{
  "$id": "urn:cyberalchemy-lab:protocol:lesson-assessment-request:v1-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/actor"
    },
    "application": {
      "allOf": [
        {
          "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"
        },
        {
          "properties": {
            "carrier_ref": {
              "const": "cal.artifact-type.lesson-application/v1"
            }
          }
        }
      ]
    },
    "assessment_candidate_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "authority_effect": {
      "const": "none"
    },
    "causal_claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "counterevidence_bindings": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
      },
      "minItems": 0,
      "type": "array"
    },
    "evidence_bindings": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
      },
      "minItems": 1,
      "type": "array"
    },
    "request_ref": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "lab-lesson-assessment-request/v1-candidate"
    },
    "source_cut": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/source_cut"
    }
  },
  "required": [
    "schema_version",
    "request_ref",
    "actor",
    "application",
    "assessment_candidate_binding",
    "evidence_bindings",
    "counterevidence_bindings",
    "causal_claim_ceiling",
    "source_cut",
    "authority_effect"
  ],
  "title": "Candidate Lab lesson-assessment-request",
  "type": "object"
}
