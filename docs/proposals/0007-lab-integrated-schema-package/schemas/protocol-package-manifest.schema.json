{
  "$id": "urn:cyberalchemy-lab:protocol:protocol-package-manifest:v1-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authoring_receipt_binding": {
      "anyOf": [
        {
          "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
        },
        {
          "type": "null"
        }
      ]
    },
    "authority_effect": {
      "const": "none"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "domain_catalog_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "obligation_catalog_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "package_ref": {
      "minLength": 1,
      "type": "string"
    },
    "schema_bindings": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "lab-protocol-package-manifest/v1-candidate"
    },
    "source_baseline_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "status": {
      "const": "candidate"
    },
    "workflow_model_bindings": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "package_ref",
    "status",
    "schema_bindings",
    "domain_catalog_binding",
    "workflow_model_bindings",
    "obligation_catalog_binding",
    "source_baseline_binding",
    "authoring_receipt_binding",
    "claim_ceiling",
    "authority_effect"
  ],
  "title": "Candidate Lab protocol-package-manifest",
  "type": "object"
}
