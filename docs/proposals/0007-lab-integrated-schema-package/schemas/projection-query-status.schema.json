{
  "$id": "urn:cyberalchemy-lab:protocol:projection-query-status:v1-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "posture": {
            "const": "ready"
          }
        },
        "required": [
          "posture"
        ]
      },
      "then": {
        "properties": {
          "gaps": {
            "maxItems": 0,
            "type": "array"
          },
          "generation_binding": {
            "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
          },
          "source_verification_binding": {
            "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
          }
        },
        "required": [
          "generation_binding",
          "source_verification_binding",
          "gaps"
        ]
      }
    }
  ],
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "canonical_current_cut": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/source_cut"
    },
    "canonical_replay_source": {
      "const": false
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "gaps": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/gap"
      },
      "minItems": 0,
      "type": "array"
    },
    "generation_binding": {
      "anyOf": [
        {
          "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
        },
        {
          "type": "null"
        }
      ]
    },
    "posture": {
      "enum": [
        "ready",
        "stale",
        "building",
        "invalidated"
      ]
    },
    "schema_version": {
      "const": "lab-projection-query-status/v1-candidate"
    },
    "source_cut": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/source_cut"
    },
    "source_verification_binding": {
      "anyOf": [
        {
          "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "generation_binding",
    "source_cut",
    "canonical_current_cut",
    "posture",
    "source_verification_binding",
    "canonical_replay_source",
    "gaps",
    "claim_ceiling",
    "authority_effect"
  ],
  "title": "Candidate Lab projection-query-status",
  "type": "object"
}
