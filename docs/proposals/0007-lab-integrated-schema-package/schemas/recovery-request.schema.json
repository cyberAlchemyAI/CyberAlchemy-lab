{
  "$id": "urn:cyberalchemy-lab:protocol:recovery-request:v1-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/actor"
    },
    "allowed_residue_bindings": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
      },
      "minItems": 0,
      "type": "array"
    },
    "authority_basis": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/authority_basis"
    },
    "authority_effect": {
      "const": "none"
    },
    "expected_cut": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/source_cut"
    },
    "recovery_contract_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "recovery_kind": {
      "enum": [
        "canonical-commit",
        "action-reconciliation",
        "projection-rebuild",
        "file-generation"
      ]
    },
    "request_ref": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "lab-recovery-request/v1-candidate"
    },
    "subject_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    }
  },
  "required": [
    "schema_version",
    "request_ref",
    "actor",
    "expected_cut",
    "subject_binding",
    "recovery_kind",
    "recovery_contract_binding",
    "authority_basis",
    "allowed_residue_bindings",
    "authority_effect"
  ],
  "title": "Candidate Lab recovery-request",
  "type": "object"
}
