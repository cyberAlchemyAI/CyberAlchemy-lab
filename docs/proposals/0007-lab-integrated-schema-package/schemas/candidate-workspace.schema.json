{
  "$id": "urn:cyberalchemy-lab:protocol:candidate-workspace:v1-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "base_cut": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/source_cut"
    },
    "candidate_refs": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/candidate_artifact_ref"
      },
      "minItems": 0,
      "type": "array"
    },
    "canonical_state_mutation": {
      "const": false
    },
    "connection_bindings": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
      },
      "minItems": 0,
      "type": "array"
    },
    "contract_bindings": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
      },
      "minItems": 0,
      "type": "array"
    },
    "eligible_persistence_refs": {
      "items": {
        "oneOf": [
          {
            "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"
          },
          {
            "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/candidate_artifact_ref"
          }
        ]
      },
      "minItems": 0,
      "type": "array"
    },
    "excluded_material_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array"
    },
    "material_bindings": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/content_binding"
      },
      "minItems": 0,
      "type": "array"
    },
    "profile_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "reference_checks": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/reference_check"
      },
      "minItems": 0,
      "type": "array"
    },
    "schema_version": {
      "const": "lab-candidate-workspace/v1-candidate"
    },
    "validation_binding": {
      "anyOf": [
        {
          "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
        },
        {
          "type": "null"
        }
      ]
    },
    "workspace_ref": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "workspace_ref",
    "base_cut",
    "profile_binding",
    "material_bindings",
    "candidate_refs",
    "contract_bindings",
    "connection_bindings",
    "eligible_persistence_refs",
    "excluded_material_refs",
    "reference_checks",
    "validation_binding",
    "canonical_state_mutation",
    "authority_effect"
  ],
  "title": "Candidate Lab candidate-workspace",
  "type": "object"
}
