{
  "$id": "urn:cyberalchemy-lab:protocol:artifact-query-result:v1-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "query_basis": {
            "const": "canonical"
          }
        },
        "required": [
          "query_basis"
        ]
      },
      "then": {
        "properties": {
          "projection_generation": {
            "type": "null"
          }
        },
        "required": [
          "projection_generation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "query_basis": {
            "const": "projection"
          }
        },
        "required": [
          "query_basis"
        ]
      },
      "then": {
        "properties": {
          "projection_generation": {
            "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
          }
        },
        "required": [
          "projection_generation"
        ]
      }
    }
  ],
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "connections": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:typed-connection:v1-candidate"
      },
      "minItems": 0,
      "type": "array"
    },
    "freshness": {
      "enum": [
        "current",
        "historical",
        "stale"
      ]
    },
    "gaps": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/gap"
      },
      "minItems": 0,
      "type": "array"
    },
    "next_page_cursor": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "projection_generation": {
      "anyOf": [
        {
          "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
        },
        {
          "type": "null"
        }
      ]
    },
    "query_basis": {
      "enum": [
        "canonical",
        "projection"
      ]
    },
    "request_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "requested_source_cut": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/source_cut"
    },
    "results": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"
      },
      "minItems": 0,
      "type": "array"
    },
    "schema_version": {
      "const": "lab-artifact-query-result/v1-candidate"
    },
    "source_cut": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/source_cut"
    }
  },
  "required": [
    "schema_version",
    "request_binding",
    "source_cut",
    "projection_generation",
    "results",
    "connections",
    "next_page_cursor",
    "gaps",
    "claim_ceiling",
    "authority_effect",
    "query_basis",
    "requested_source_cut",
    "freshness"
  ],
  "title": "Candidate Lab artifact-query-result",
  "type": "object"
}
