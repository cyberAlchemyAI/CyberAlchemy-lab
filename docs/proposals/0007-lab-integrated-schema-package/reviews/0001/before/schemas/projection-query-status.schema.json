{
  "$id": "urn:cyberalchemy-lab:protocol:projection-query-status:v1-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "canonical_current_cut": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/source_cut"
    },
    "canonical_replay_source": {
      "const": false
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "gaps": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/gap"
      },
      "minItems": 0,
      "type": "array"
    },
    "generation_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "posture": {
      "enum": [
        "ready",
        "stale",
        "building",
        "invalidated"
      ]
    },
    "schema_version": {
      "const": "lab-projection-query-status/v1-candidate"
    },
    "source_cut": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/source_cut"
    },
    "source_verification_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    }
  },
  "required": [
    "schema_version",
    "generation_binding",
    "source_cut",
    "canonical_current_cut",
    "posture",
    "source_verification_binding",
    "canonical_replay_source",
    "gaps",
    "claim_ceiling",
    "authority_effect"
  ],
  "title": "Candidate Lab projection-query-status",
  "type": "object"
}
