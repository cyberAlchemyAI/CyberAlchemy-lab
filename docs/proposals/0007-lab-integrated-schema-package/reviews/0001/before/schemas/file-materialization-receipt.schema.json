{
  "$id": "urn:cyberalchemy-lab:protocol:file-materialization-receipt:v1-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "canonical_replay_source": {
      "const": false
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "gaps": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/gap"
      },
      "minItems": 0,
      "type": "array"
    },
    "generation_ref": {
      "minLength": 1,
      "type": "string"
    },
    "manifest_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "output_bindings": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/content_binding"
      },
      "minItems": 0,
      "type": "array"
    },
    "posture": {
      "enum": [
        "published",
        "staged",
        "failed"
      ]
    },
    "request_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "schema_version": {
      "const": "lab-file-materialization-receipt/v1-candidate"
    },
    "source_cut": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/source_cut"
    },
    "unmanaged_files_overwritten": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "request_binding",
    "manifest_binding",
    "source_cut",
    "generation_ref",
    "posture",
    "output_bindings",
    "canonical_replay_source",
    "unmanaged_files_overwritten",
    "gaps",
    "claim_ceiling",
    "authority_effect"
  ],
  "title": "Candidate Lab file-materialization-receipt",
  "type": "object"
}
