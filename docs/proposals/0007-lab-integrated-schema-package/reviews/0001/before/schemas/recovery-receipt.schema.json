{
  "$id": "urn:cyberalchemy-lab:protocol:recovery-receipt:v1-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "committed_history_removed": {
      "const": false
    },
    "gaps": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/gap"
      },
      "minItems": 0,
      "type": "array"
    },
    "observed_bindings": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
      },
      "minItems": 0,
      "type": "array"
    },
    "post_cut": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/source_cut"
    },
    "posture": {
      "enum": [
        "recovered",
        "blocked",
        "indeterminate"
      ]
    },
    "pre_cut": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/source_cut"
    },
    "removed_uncommitted_bindings": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
      },
      "minItems": 0,
      "type": "array"
    },
    "request_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "schema_version": {
      "const": "lab-recovery-receipt/v1-candidate"
    }
  },
  "required": [
    "schema_version",
    "request_binding",
    "pre_cut",
    "post_cut",
    "posture",
    "observed_bindings",
    "removed_uncommitted_bindings",
    "committed_history_removed",
    "gaps",
    "claim_ceiling",
    "authority_effect"
  ],
  "title": "Candidate Lab recovery-receipt",
  "type": "object"
}
