{
  "$id": "urn:cyberalchemy-lab:protocol:workflow-transition-receipt:v1-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "posture": {
            "const": "applied"
          }
        },
        "required": [
