        ]
      },
      "then": {
        "properties": {
          "event_binding": {
            "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
          },
          "evidence_bindings": {
            "items": {
              "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "event_binding",
          "evidence_bindings"
        ]
      }
    }
  ],
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "event_binding": {
      "anyOf": [
        {
          "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_bindings": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
      },
      "minItems": 0,
      "type": "array"
    },
    "from_state": {
      "minLength": 1,
      "type": "string"
    },
    "gaps": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/gap"
      },
      "minItems": 0,
      "type": "array"
    },
    "output_artifact_refs": {
      "items": {
        "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/artifact_ref"
      },
      "minItems": 0,
      "type": "array"
    },
    "posture": {
      "enum": [
        "applied",
        "blocked",
        "indeterminate"
      ]
    },
    "request_binding": {
      "$ref": "urn:cyberalchemy-lab:protocol:common:v1-candidate#/$defs/binding"
    },
    "run_ref": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "lab-workflow-transition-receipt/v1-candidate"
    },
    "to_state": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "request_binding",
    "run_ref",
    "from_state",
    "to_state",
    "posture",
    "event_binding",
    "output_artifact_refs",
    "evidence_bindings",
    "gaps",
    "claim_ceiling",
    "authority_effect"
  ],
  "title": "Candidate Lab workflow-transition-receipt",
  "type": "object"
}
