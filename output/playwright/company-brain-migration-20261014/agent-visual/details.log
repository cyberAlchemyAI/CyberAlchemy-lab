 await page.locator('figure.company-brain-map').screenshot({path:`${root}/role-${label.toLowerCase()}-390-dark.png`});await btn.click();
 }
 const legacy=[];
 for(const [route,fragment] of [['index','lab'],['index','craft'],['start-here','definitions-first']]) {
 await page.goto(`http://127.0.0.1:8767/governance-lab-series/${route}.html?mode=light&verify=migration-visual#${fragment}`);await page.waitForTimeout(150);legacy.push({from:`${route}#${fragment}`,url:page.url(),target:await page.evaluate(()=>({hash:location.hash,element:document.getElementById(location.hash.slice(1))?.textContent?.slice(0,150)}))});
 }
 return {results,roleResults,legacy};
}
)(page);
