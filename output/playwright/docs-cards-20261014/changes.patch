  [data-theme=dark] body.preview-document [data-model-concept]{--model-color:CanvasText;--smap-color:CanvasText}
  [data-theme=dark] body.preview-document .smap-edge text{fill:CanvasText!important;stroke:Canvas!important}
 }
+
+/* Cards mark a choice of destination; prose and contract disclosures stay linear.
+   Two 300px cards fit the reading column; narrow columns stack automatically. */
+body.preview-document[data-docs-enhanced] :is(.docs-card-grid,.start-reading-paths,.entry-paths,.resource-shelf .chapter-grid,.docs-reference-index,.reference-grid){
+ display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:16px;
+ padding:0!important;margin:24px 0 32px;border:0;background:transparent!important;
+}
+body.preview-document[data-docs-enhanced] :is(.docs-path-card,.start-reading-paths>a,.entry-paths>a,.resource-shelf .chapter-card,.docs-reference-index>a,.reference-grid>a){
+ display:flex;flex-direction:column;align-items:stretch;min-width:0;gap:12px;padding:24px;
+ border:1px solid var(--preview-line)!important;border-radius:3px!important;
+ background:var(--preview-surface)!important;color:var(--preview-ink)!important;
+ text-decoration:none;text-align:left;transform:none;box-shadow:none!important;
+ transition:border-color 150ms ease,background-color 150ms ease;
+}
+body.preview-document[data-docs-enhanced] :is(.docs-path-card,.start-reading-paths>a,.entry-paths>a,.resource-shelf .chapter-card,.docs-reference-index>a,.reference-grid>a):hover{
+ border-color:var(--preview-accent)!important;background:var(--preview-soft)!important;transform:none;
+}
+body.preview-document[data-docs-enhanced] :is(.docs-path-card,.start-reading-paths>a,.entry-paths>a,.resource-shelf .chapter-card,.docs-reference-index>a,.reference-grid>a):focus-visible{
+ outline:2px solid var(--preview-accent);outline-offset:4px;
+}
+body.preview-document[data-docs-enhanced] :is(.docs-path-card,.start-reading-paths>a,.entry-paths>a,.docs-reference-index>a,.reference-grid>a)>strong{
+ display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin:0;
+ font:600 18px/1.5 var(--preview-font);color:var(--preview-ink)!important;overflow-wrap:anywhere;
+}
+body.preview-document[data-docs-enhanced] :is(.docs-path-card,.start-reading-paths>a,.entry-paths>a,.docs-reference-index>a,.reference-grid>a)>span{
+ display:block;font:14px/1.8 var(--preview-font);color:var(--preview-muted)!important;
+}
+body.preview-document .docs-path-card small{display:block;margin-top:auto;padding-top:8px;font:12px/1.6 var(--preview-font);color:var(--preview-accent)}
+body.preview-document .docs-card-arrow{flex-shrink:0;margin-top:3px;color:var(--preview-accent)}
+body.preview-document[data-docs-enhanced] .entry-paths a::before{content:none}
+body.preview-document[data-docs-enhanced] .resource-shelf .chapter-card>*{grid-row:auto;grid-column:auto;align-self:auto;max-width:none;margin:0}
+body.preview-document[data-docs-enhanced] .resource-shelf .chapter-number{font:12px/1.6 var(--preview-font);color:var(--preview-accent)}
+body.preview-document[data-docs-enhanced] .resource-shelf .chapter-number::before{content:'Essay '}
+body.preview-document[data-docs-enhanced] .resource-shelf .chapter-card-title{font:600 18px/1.5 var(--preview-font);color:var(--preview-ink)}
+body.preview-document[data-docs-enhanced] .resource-shelf .chapter-description{font:14px/1.8 var(--preview-font);color:var(--preview-muted)}
+body.preview-document[data-docs-enhanced] .resource-shelf .chapter-time{font:12px/1.6 var(--preview-font);color:var(--preview-accent);margin-top:auto;padding-top:8px}
+body.preview-document[data-docs-enhanced] .start-content .docs-path-picker{border-top:0;padding-top:28px}
+body.preview-document .docs-path-picker .docs-path-grid{margin-bottom:0}
+body.preview-document .docs-reading-path .start-masthead{padding-bottom:24px}
+body.preview-document .docs-all-paths{display:inline-flex;align-items:center;min-height:44px;font-size:13px;margin-bottom:8px}
+body.preview-document .docs-reading-progress{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:8px 24px;padding:24px 0}
+body.preview-document .docs-reading-progress p{margin:0;font-size:14px;color:var(--preview-ink)}
+body.preview-document .docs-reading-progress>span{font-size:12px;color:var(--preview-muted)}
+body.preview-document .docs-reading-steps{list-style:none;margin:0;padding:0;display:grid;gap:16px}
+body.preview-document .docs-reading-step{border:1px solid var(--preview-line);border-radius:3px;background:var(--preview-surface);scroll-margin-top:130px}
+body.preview-document .docs-reading-step>summary{display:flex;align-items:baseline;gap:16px;padding:20px 24px;cursor:pointer;list-style:none;color:var(--preview-ink);font:600 17px/1.6 var(--preview-font)}
+body.preview-document .docs-reading-step>summary::-webkit-details-marker{display:none}
+body.preview-document .docs-reading-step>summary::after{content:'+';font:400 20px/1 var(--preview-font);margin-left:auto;color:var(--preview-accent)}
+body.preview-document .docs-reading-step[open]>summary::after{content:'−'}
+body.preview-document .docs-step-number{font:14px/1.6 var(--preview-font);color:var(--preview-accent);min-width:1ch}
+body.preview-document .docs-step-title{flex:1;min-width:0}
+body.preview-document .docs-step-state{font:12px/1.6 var(--preview-font);color:var(--preview-success)}
+body.preview-document .docs-step-body{padding:0 24px 24px 49px}
+body.preview-document .docs-step-body>p{margin:0 0 20px;font:14px/1.85 var(--preview-font);color:var(--preview-muted)}
+body.preview-document .docs-step-actions{display:flex;flex-wrap:wrap;gap:12px 20px;align-items:center;justify-content:space-between}
+body.preview-document .docs-step-actions>a{display:inline-flex;gap:10px;align-items:center;min-height:44px;font:13px/1.6 var(--preview-font)}
+body.preview-document .docs-step-actions>a .docs-card-arrow{width:16px;height:16px;margin-top:0}
+body.preview-document .docs-reading-path button{min-height:44px;padding:10px 14px;border:1px solid var(--preview-control);border-radius:3px;background:var(--preview-soft);font:12px/1.6 var(--preview-font);color:var(--preview-ink);cursor:pointer}
+body.preview-document .docs-reading-path button[aria-pressed=true]{background:var(--preview-accent);border-color:var(--preview-accent);color:var(--preview-on-accent)}
+body.preview-document .docs-reading-path button:disabled{color:var(--preview-muted);cursor:default}
+body.preview-document .docs-path-end{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:16px;padding:28px 0;font-size:13px}
+body.preview-document .docs-path-end>a{display:inline-flex;align-items:center;min-height:44px}
+body.preview-document .docs-reading-path :is(button,summary):focus-visible{outline:2px solid var(--preview-accent);outline-offset:4px}
+@media(max-width:680px){
+ body.preview-document[data-docs-enhanced] :is(.docs-path-card,.start-reading-paths>a,.entry-paths>a,.resource-shelf .chapter-card,.docs-reference-index>a,.reference-grid>a){padding:20px}
+ body.preview-document .docs-reading-step>summary{padding:18px 16px;gap:12px;font-size:16px}
+ body.preview-document .docs-step-body{padding:0 16px 20px}
+ body.preview-document .docs-step-state{font-size:11px}
+}
+@media(prefers-reduced-motion:reduce){body.preview-document[data-docs-enhanced] :is(.docs-path-card,.start-reading-paths>a,.entry-paths>a,.resource-shelf .chapter-card,.docs-reference-index>a,.reference-grid>a){transition:none}}
+@media print{
+ body.preview-document .docs-reading-step{break-inside:avoid}
+ body.preview-document .docs-reading-step>.docs-step-body{display:block!important}
+ body.preview-document :is(.docs-reading-progress,[data-mark-read],[data-reset-reading]){display:none!important}
+}
