{
  "$id": "https://cyberalchemy.local/schemas/evaluation/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "minLength": 1,
      "type": "string"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "kind": {
      "const": "evaluation"
    },
    "lifecycle_state": {
      "enum": [
        "candidate",
        "active",
        "historical",
        "retired"
      ]
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "node_id": {
      "minLength": 1,
      "type": "string"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "input_state_ref": {
          "minLength": 1,
          "type": "string"
        },
        "outcomes": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "blocker_ref": {
                "minLength": 1,
                "type": "string"
              },
              "check_id": {
                "minLength": 1,
                "type": "string"
              },
              "evidence_refs": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "result": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "check_id",
              "result",
              "evidence_refs",
              "blocker_ref"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "profile_ref": {
          "minLength": 1,
          "type": "string"
        },
        "subject_ref": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "profile_ref",
        "subject_ref",
        "input_state_ref",
        "outcomes"
      ],
      "type": "object"
    },
    "relation_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "counterpart_kind": {
            "enum": [
              "capability-realization-binding",
              "product-capability",
              "product-thesis"
            ]
          },
          "counterpart_ref": {
            "minLength": 1,
            "type": "string"
          },
          "direction": {
            "enum": [
              "source"
            ]
          },
          "relation_kind_ref": {
            "enum": [
              "relation.evaluates"
            ]
          }
        },
        "required": [
          "relation_kind_ref",
          "direction",
          "counterpart_kind",
          "counterpart_ref"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "cyberalchemy-lab-evaluation/v1"
    },
    "scope_ref": {
      "minLength": 1,
      "type": "string"
    },
    "successor_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "node_id",
    "kind",
    "name",
    "lifecycle_state",
    "authority_effect",
    "owner_ref",
    "scope_ref",
    "evidence_refs",
    "challenge_route",
    "successor_refs",
    "relation_refs",
    "payload",
    "claim_ceiling"
  ],
  "type": "object"
}
