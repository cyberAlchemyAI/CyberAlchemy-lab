{
  "$id": "https://cyberalchemy.local/schemas/operational-lesson/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "minLength": 1,
      "type": "string"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "kind": {
      "const": "operational-lesson"
    },
    "lifecycle_state": {
      "enum": [
        "candidate",
        "active",
        "historical",
        "retired"
      ]
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "node_id": {
      "minLength": 1,
      "type": "string"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "minLength": 1,
          "type": "string"
        },
        "classification_assignment_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "counterevidence_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "exclusions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "expires_at": {
          "minLength": 1,
          "type": "string"
        },
        "falsifier": {
          "minLength": 1,
          "type": "string"
        },
        "lesson_statement": {
          "minLength": 1,
          "type": "string"
        },
        "predicted_benefit": {
          "minLength": 1,
          "type": "string"
        },
        "retention_policy_ref": {
          "minLength": 1,
          "type": "string"
        },
        "scope_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "status": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "lesson_statement",
        "scope_refs",
        "applicability",
        "exclusions",
        "predicted_benefit",
        "falsifier",
        "evidence_refs",
        "counterevidence_refs",
        "retention_policy_ref",
        "expires_at",
        "classification_assignment_refs",
        "status"
      ],
      "type": "object"
    },
    "relation_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "counterpart_kind": {
            "enum": [
              "agent-action",
              "agent-reflection",
              "challenge-event",
              "classification-value",
              "decision",
              "evidence-set",
              "failure-assessment",
              "feedback-record",
              "finding",
              "improvement-target",
              "lesson-application",
              "lesson-outcome-assessment",
              "measurement-result",
              "observation",
              "operational-lesson",
              "operational-observation",
              "policy"
            ]
          },
          "counterpart_ref": {
            "minLength": 1,
            "type": "string"
          },
          "direction": {
            "enum": [
              "source",
              "target"
            ]
          },
          "relation_kind_ref": {
            "enum": [
              "relation.applies-lesson",
              "relation.challenges",
              "relation.declares-effect-on",
              "relation.derives-from",
              "relation.evidence-bears-on",
              "relation.governed-by",
              "relation.instance-of",
              "relation.produces",
              "relation.successor-of"
            ]
          }
        },
        "required": [
          "relation_kind_ref",
          "direction",
          "counterpart_kind",
          "counterpart_ref"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "cyberalchemy-lab-operational-lesson/v1"
    },
    "scope_ref": {
      "minLength": 1,
      "type": "string"
    },
    "successor_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "node_id",
    "kind",
    "name",
    "lifecycle_state",
    "authority_effect",
    "owner_ref",
    "scope_ref",
    "evidence_refs",
    "challenge_route",
    "successor_refs",
    "relation_refs",
    "payload",
    "claim_ceiling"
  ],
  "type": "object"
}
