{
  "$id": "https://cyberalchemy.local/schemas/agent-session/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "minLength": 1,
      "type": "string"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "kind": {
      "const": "agent-session"
    },
    "lifecycle_state": {
      "enum": [
        "candidate",
        "active",
        "historical",
        "retired"
      ]
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "node_id": {
      "minLength": 1,
      "type": "string"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "agent_instance_ref": {
          "minLength": 1,
          "type": "string"
        },
        "assignment_ref": {
          "minLength": 1,
          "type": "string"
        },
        "authority_envelope_ref": {
          "minLength": 1,
          "type": "string"
        },
        "budget_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "context_view_ref": {
          "minLength": 1,
          "type": "string"
        },
        "event_cursor": {
          "minLength": 1,
          "type": "string"
        },
        "input_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "ontology_view_ref": {
          "minLength": 1,
          "type": "string"
        },
        "policy_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "session_memory": {
          "additionalProperties": false,
          "properties": {
            "expires_with_session": {
              "type": "boolean"
            },
            "selected_input_refs": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            },
            "unresolved_questions": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            },
            "working_record_refs": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "selected_input_refs",
            "working_record_refs",
            "unresolved_questions",
            "expires_with_session"
          ],
          "type": "object"
        },
        "termination_state": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "agent_instance_ref",
        "assignment_ref",
        "context_view_ref",
        "ontology_view_ref",
        "policy_refs",
        "authority_envelope_ref",
        "input_refs",
        "budget_refs",
        "event_cursor",
        "session_memory",
        "termination_state"
      ],
      "type": "object"
    },
    "relation_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "counterpart_kind": {
            "enum": [
              "agent-action",
              "agent-instance",
              "agent-reflection",
              "agent-session",
              "challenge-event",
              "context-view",
              "failure-occurrence",
              "implementation",
              "incident",
              "ontology-view",
              "policy",
              "tool"
            ]
          },
          "counterpart_ref": {
            "minLength": 1,
            "type": "string"
          },
          "direction": {
            "enum": [
              "source",
              "target"
            ]
          },
          "relation_kind_ref": {
            "enum": [
              "relation.affects",
              "relation.challenges",
              "relation.consumes-view",
              "relation.derives-from",
              "relation.governed-by",
              "relation.member-of",
              "relation.occurs-during",
              "relation.successor-of",
              "relation.uses-tool"
            ]
          }
        },
        "required": [
          "relation_kind_ref",
          "direction",
          "counterpart_kind",
          "counterpart_ref"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "cyberalchemy-lab-agent-session/v1"
    },
    "scope_ref": {
      "minLength": 1,
      "type": "string"
    },
    "successor_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "node_id",
    "kind",
    "name",
    "lifecycle_state",
    "authority_effect",
    "owner_ref",
    "scope_ref",
    "evidence_refs",
    "challenge_route",
    "successor_refs",
    "relation_refs",
    "payload",
    "claim_ceiling"
  ],
  "type": "object"
}
