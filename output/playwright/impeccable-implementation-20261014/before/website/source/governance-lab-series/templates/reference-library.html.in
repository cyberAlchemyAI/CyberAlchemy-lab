  <script src="assets/lab-library-docs.js" defer></script>
<link rel="stylesheet" href="assets/site-search.css">
<script src="assets/search-engine.js" defer></script>
<script src="assets/site-search.js" defer></script>
</head>
<body data-edition="reference">
  <a class="skip-link" href="#reference">Skip to the reference library</a>
  <header class="topbar"><div class="topbar-inner">
    <a class="brand" href="governance-lab-reference.html#start"><img src="assets/kep/cyberalchemy-lab-logo-light-v2.svg" alt="CyberAlchemy Lab" width="470" height="110"><span class="brand-text" aria-hidden="true">CyberAlchemy Lab</span></a>
    <span class="docs-brand-label">Knowledge &amp; work</span>
    <nav aria-label="Quick navigation">
      <a href="governance-lab-reference.html#start">Overview</a>
      <a href="governance-lab-reference.html#governance">Guide</a>
