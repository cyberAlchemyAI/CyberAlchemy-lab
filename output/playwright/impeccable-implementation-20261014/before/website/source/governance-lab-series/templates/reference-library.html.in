  <meta name="color-scheme" content="light">
  <title>Reference library · CyberAlchemy Lab</title>
  <link rel="icon" type="image/svg+xml" href="assets/kep/cyberalchemy-lab-logo-light-v2.svg">
  <link rel="stylesheet" href="assets/kep/design-system.css">
  <link rel="stylesheet" href="assets/reference-library.css">
  <link rel="stylesheet" href="assets/lab-editorial.css">
  <link rel="stylesheet" href="assets/lab-article.css">
  <link rel="stylesheet" href="assets/lab-ux.css">
