{
  "$defs": {
    "binding": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)[^\\s]+$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "admission": {
      "type": "string"
    },
    "allowed_levels": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "commitment_level": {
      "type": "string"
    },
    "evidence_level": {
      "type": "string"
    },
    "meaning": {
      "type": "string"
    },
    "scheme_ref": {
      "type": "string"
    }
  },
  "required": [
    "admission",
    "allowed_levels",
    "commitment_level",
    "evidence_level",
    "meaning",
    "scheme_ref"
  ],
  "type": "object"
}
