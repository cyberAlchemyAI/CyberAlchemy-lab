{
  "$defs": {
    "binding": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)[^\\s]+$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actual_owner_outcome": {
      "type": "null"
    },
    "archive_binding": {
      "$ref": "#/$defs/binding"
    },
    "authority_effect": {
      "const": "none"
    },
    "consequence_rule": {
      "additionalProperties": false,
      "properties": {
        "append_new_governance_event_after_exact_R08_member_acceptance": {
          "const": true
        },
        "commitment_confidence": {
          "type": "string"
        },
        "evidence_confidence": {
          "type": "string"
        },
        "new_Cuts_and_Views_regenerated_without_new_semantic_Decision": {
          "const": true
        },
        "old_candidate_event_relabeling_allowed": {
          "const": false
        },
        "old_rich_carrier_remains_exact_historical_projection": {
          "const": true
        },
        "owner_route_requires_verified_current_accountable_owner": {
          "const": true
        },
        "preserve_original_semantic_bytes": {
          "const": true
        },
        "provenance_requires_actual_owner_Decision_binding": {
          "const": true
        },
        "resulting_candidate_or_maturity_status": {
          "type": "string"
        },
        "source_meaning_admitted": {
          "const": false
        }
      },
      "required": [
        "append_new_governance_event_after_exact_R08_member_acceptance",
        "commitment_confidence",
        "evidence_confidence",
        "new_Cuts_and_Views_regenerated_without_new_semantic_Decision",
        "old_candidate_event_relabeling_allowed",
        "old_rich_carrier_remains_exact_historical_projection",
        "owner_route_requires_verified_current_accountable_owner",
        "preserve_original_semantic_bytes",
        "provenance_requires_actual_owner_Decision_binding",
        "resulting_candidate_or_maturity_status",
        "source_meaning_admitted"
      ],
      "type": "object"
    },
    "final_event_bytes_and_owner_core_must_be_materialized_at": {
      "type": "string"
    },
    "metadata_record_binding": {
      "$ref": "#/$defs/binding"
    },
    "owner_outcome_required": {
      "const": true
    },
    "permanent_runtime_installation_authorized": {
      "const": false
    },
    "predecessor_governance_tuple": {
      "additionalProperties": false,
      "properties": {
        "event_digest": {
          "type": "string"
        },
        "event_id": {
          "type": "string"
        },
        "governance_cursor": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "event_digest",
        "event_id",
        "governance_cursor"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "lab-O06-representation-adoption-intent/v1-candidate"
    },
    "semantic_tuple": {
      "additionalProperties": false,
      "properties": {
        "semantic_cursor": {
          "minimum": 0,
          "type": "integer"
        },
        "semantic_event_digest": {
          "type": "string"
        },
        "semantic_event_id": {
          "type": "string"
        }
      },
      "required": [
        "semantic_cursor",
        "semantic_event_digest",
        "semantic_event_id"
      ],
      "type": "object"
    },
    "subject_carrier_version_ref": {
      "type": "string"
    },
    "verified_owner_required": {
      "const": true
    }
  },
  "required": [
    "actual_owner_outcome",
    "archive_binding",
    "authority_effect",
    "consequence_rule",
    "final_event_bytes_and_owner_core_must_be_materialized_at",
    "metadata_record_binding",
    "owner_outcome_required",
    "permanent_runtime_installation_authorized",
    "predecessor_governance_tuple",
    "schema_version",
    "semantic_tuple",
    "subject_carrier_version_ref",
    "verified_owner_required"
  ],
  "type": "object"
}
