{
  "$id": "urn:lab:O03:query-response:v1-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "claims": {
      "items": {
        "required": [
          "obligation",
          "status",
          "scope_ref",
          "basis",
          "authority_effect"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "connections": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "confirmed": {
            "type": "boolean"
          },
          "direction": {
            "const": "directed"
          },
          "edge_id": {},
          "effective_admission": {},
          "evidence": {},
          "mode": {},
          "predicate": {},
          "profile_posture": {},
          "qualifiers": {},
          "relation_subject_ref": {},
          "source": {},
          "target": {},
          "version_resolution": {
            "const": "exact"
          }
        },
        "required": [
          "edge_id",
          "source",
          "target",
          "predicate",
          "mode",
          "direction",
          "qualifiers",
          "evidence",
          "relation_subject_ref",
          "effective_admission",
          "version_resolution",
          "confirmed",
          "profile_posture"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "coverage": {
      "additionalProperties": false,
      "properties": {
        "continuation": {},
        "excluded_areas": {},
        "omitted_frontier": {},
        "partition": {},
        "required_obligations": {},
        "scope_ref": {},
        "selected_edges": {},
        "selected_nodes": {},
        "selected_subjects": {},
        "source_item_accounting": {},
        "subject_rows": {},
        "truncated": {}
      },
      "required": [
        "scope_ref",
        "selected_subjects",
        "partition",
        "subject_rows",
        "required_obligations",
        "selected_nodes",
        "selected_edges",
        "truncated",
        "omitted_frontier",
        "continuation",
        "source_item_accounting",
        "excluded_areas"
      ],
      "type": "object"
    },
    "explanation_paths": {
      "items": {
        "required": [
          "root",
          "target",
          "steps"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "freshness": {
      "additionalProperties": false,
      "properties": {
        "changed": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "checked_count": {
          "minimum": 0,
          "type": "integer"
        },
        "missing": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "state": {
          "enum": [
            "current",
            "historical",
            "stale",
            "unknown"
          ]
        },
        "unchecked": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "unsafe": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "state",
        "changed",
        "missing",
        "unsafe",
        "unchecked",
        "checked_count"
      ],
      "type": "object"
    },
    "gaps": {
      "type": "array"
    },
    "query": {
      "$id": "urn:lab:O03:query-request:v1-candidate",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "admission_as_of": {
          "minLength": 1,
          "type": "string"
        },
        "direction": {
          "enum": [
            "incoming",
            "outgoing",
            "both"
          ]
        },
        "edge_selection": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "type": "array",
          "uniqueItems": true
        },
        "limits": {
          "additionalProperties": false,
          "properties": {
            "depth": {
              "maximum": 20,
              "minimum": 0,
              "type": "integer"
            },
            "edges": {
              "maximum": 4000,
              "minimum": 1,
              "type": "integer"
            },
            "nodes": {
              "maximum": 1000,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "depth",
            "nodes",
            "edges"
          ],
          "type": "object"
        },
        "obligations": {
          "items": {
            "enum": [
              "current-state",
              "separate-project-histories",
              "exact-predecessor-path",
              "state-admission",
              "recorded-admission",
              "exact-authorization",
              "effect-scope",
              "exact-lineage",
              "implementation-bridge",
              "effectiveness",
              "new-action-permission",
              "ontology-event-join"
            ]
          },
          "maxItems": 12,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "query_id": {
          "enum": [
            "lifecycle-slice",
            "authority-explanation",
            "capability-provenance"
          ]
        },
        "root": {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        "schema_version": {
          "const": "lab-three-lens-query/v1-candidate"
        },
        "scope_ref": {
          "enum": [
            "d75-selected-source",
            "historical-d73-slice",
            "O05-source-interpretation"
          ]
        },
        "view": {
          "enum": [
            "current",
            "historical"
          ]
        }
      },
      "required": [
        "schema_version",
        "query_id",
        "root",
        "scope_ref",
        "admission_as_of",
        "view",
        "direction",
        "edge_selection",
        "limits",
        "obligations"
      ],
      "type": "object"
    },
    "replay_source": {
      "const": false
    },
    "result_status": {
      "enum": [
        "complete",
        "partial",
        "blocked"
      ]
    },
    "schema_version": {
      "const": "lab-three-lens-response/v1-candidate"
    },
    "source_snapshot": {
      "additionalProperties": false,
      "properties": {
        "admission_epoch": {},
        "bindings": {},
        "canonical_ontology_cut": {},
        "check_time_rule": {},
        "graph_digest": {},
        "historical_source_relocations": {},
        "histories": {},
        "manifest_digest": {},
        "source_cut_digest": {}
      },
      "required": [
        "manifest_digest",
        "source_cut_digest",
        "graph_digest",
        "admission_epoch",
        "bindings",
        "histories",
        "historical_source_relocations",
        "check_time_rule",
        "canonical_ontology_cut"
      ],
      "type": "object"
    },
    "state_tracks": {
      "type": "array"
    },
    "subjects": {
      "items": {
        "required": [
          "graph_id",
          "namespace",
          "kind",
          "identity_ref",
          "version_ref",
          "source_binding"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "query",
    "result_status",
    "source_snapshot",
    "freshness",
    "subjects",
    "state_tracks",
    "connections",
    "explanation_paths",
    "claims",
    "gaps",
    "coverage",
    "authority_effect",
    "replay_source",
    "claim_ceiling"
  ],
  "type": "object"
}
