{
  "$id": "urn:lab:O03:query-request:v1-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "admission_as_of": {
      "minLength": 1,
      "type": "string"
    },
    "direction": {
      "enum": [
        "incoming",
        "outgoing",
        "both"
      ]
    },
    "edge_selection": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "type": "array",
      "uniqueItems": true
    },
    "limits": {
      "additionalProperties": false,
      "properties": {
        "depth": {
          "maximum": 20,
          "minimum": 0,
          "type": "integer"
        },
        "edges": {
          "maximum": 4000,
          "minimum": 1,
          "type": "integer"
        },
        "nodes": {
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "depth",
        "nodes",
        "edges"
      ],
      "type": "object"
    },
    "obligations": {
      "items": {
        "enum": [
          "current-state",
          "separate-project-histories",
          "exact-predecessor-path",
          "state-admission",
          "recorded-admission",
          "exact-authorization",
          "effect-scope",
          "exact-lineage",
          "implementation-bridge",
          "effectiveness",
          "new-action-permission",
          "ontology-event-join"
        ]
      },
      "maxItems": 12,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "query_id": {
      "enum": [
        "lifecycle-slice",
        "authority-explanation",
        "capability-provenance"
      ]
    },
    "root": {
      "maxLength": 2048,
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "lab-three-lens-query/v1-candidate"
    },
    "scope_ref": {
      "enum": [
        "d75-selected-source",
        "historical-d73-slice",
        "O05-source-interpretation"
      ]
    },
    "view": {
      "enum": [
        "current",
        "historical"
      ]
    }
  },
  "required": [
    "schema_version",
    "query_id",
    "root",
    "scope_ref",
    "admission_as_of",
    "view",
    "direction",
    "edge_selection",
    "limits",
    "obligations"
  ],
  "type": "object"
}
