module LabIntegration version 1

entry LabIntegration.ReceiveCandidateEntry:
  invokes LabIntegration.ReceiveCandidate.ReceiveCandidate
  interaction event Define.CandidatePrepared
  bind notice <- LabIntegration.ReceiveCandidate.NoticeToReview(payload)
  access:
    authenticated relay
    permission define.receive
    auth-resource define
    auth-action receive
    auth-scope define-review
