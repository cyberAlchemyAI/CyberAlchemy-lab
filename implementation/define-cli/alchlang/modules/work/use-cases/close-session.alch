module Define.Work.CloseSession version 1
use Define.Work.Command
use Define.CommandOf
use Define.Invocation
use Define.Work.Payload
use Define.Work.Shared.PhaseOf
use Define.Work.Session
use Define.Work.Shared.SessionLifecycle
use Define.Work.Shared.SessionSignal

calculation CloseSessionInput:
  pure
  input invocation Invocation
  result Bool
  expression require-variant(CommandOf(invocation).payload,Payload.Close).marker

mapping Closed:
  input session Session
  input marker Bool
  target Session
  total true
  expression Session(schema_version=session.schema_version,session_id=session.session_id,revision=session.revision + 1,request_revision=session.request_revision,request_lineage=session.request_lineage,scope=session.scope,context_evaluation=session.context_evaluation,questions=session.questions,responses=session.responses,required_concepts=session.required_concepts,handling=session.handling,source_bindings=session.source_bindings,evidence_bindings=session.evidence_bindings,applications=session.applications,assessments=session.assessments,materialization_selection=session.materialization_selection,validation_scope=session.validation_scope,confirmation=none,closed=marker,status=session.status,authority_effect=session.authority_effect)

operation CloseSession:
  input current optional<Session>
  input invocation Invocation
  output optional<Session>
  when not (match invocation Command(value) => true else false):
    return current
  when not (match CommandOf(invocation).payload Close(marker) => true else false):
    return current
  on absent(current) reject session-missing
  on SessionLifecycle.propose(PhaseOf(current.closed),CloseSessionSignal).tag != "transition" reject invalid-session-transition
  return some(Closed(current,true))
