module Define.Work.SetContext version 1
use Define.Work.Command
use Define.CommandOf
use Define.Work.Context
use Define.Invocation
use Define.Work.Payload
use Define.Work.Session

calculation SetContextInput:
  pure
  input invocation Invocation
  result Context
  expression require-variant(CommandOf(invocation).payload,Payload.SetContext).value

mapping WithContext:
  input session Session
  input value Context
  target Session
  total true
  expression Session(schema_version=session.schema_version,session_id=session.session_id,revision=session.revision + 1,request_revision=session.request_revision,request_lineage=session.request_lineage,scope=session.scope,context_evaluation=some(value),questions=session.questions,responses=session.responses,required_concepts=session.required_concepts,handling=session.handling,source_bindings=session.source_bindings,evidence_bindings=session.evidence_bindings,applications=session.applications,assessments=session.assessments,materialization_selection=session.materialization_selection,validation_scope=session.validation_scope,confirmation=none,closed=session.closed,status=session.status,authority_effect=session.authority_effect)

operation SetContext:
  input current optional<Session>
  input invocation Invocation
  output optional<Session>
  when not (match invocation Command(value) => true else false):
    return current
  when not (match CommandOf(invocation).payload SetContext(value) => true else false):
    return current
  on absent(current) reject session-missing
  on SetContextInput(invocation).project != current.scope.project reject project-mismatch
  on SetContextInput(invocation).work != current.scope.work reject work-mismatch
  return some(WithContext(current,SetContextInput(invocation)))
