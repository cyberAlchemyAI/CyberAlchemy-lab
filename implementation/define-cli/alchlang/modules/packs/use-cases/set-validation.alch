module Define.Packs.SetValidation version 1
use Define.Work.Command
use Define.CommandOf
use Define.Invocation
use Define.Work.Payload
use Define.Work.Session
use Define.Packs.ValidationScope

calculation SetValidationInput:
  pure
  input invocation Invocation
  result ValidationScope
  expression require-variant(CommandOf(invocation).payload,Payload.SetValidation).value

mapping WithValidation:
  input session Session
  input value ValidationScope
  target Session
  total true
  expression Session(schema_version=session.schema_version,session_id=session.session_id,revision=session.revision + 1,request_revision=session.request_revision,request_lineage=session.request_lineage,scope=session.scope,context_evaluation=session.context_evaluation,questions=session.questions,responses=session.responses,required_concepts=session.required_concepts,handling=session.handling,source_bindings=session.source_bindings,evidence_bindings=session.evidence_bindings,applications=session.applications,assessments=session.assessments,materialization_selection=session.materialization_selection,validation_scope=value,confirmation=none,closed=session.closed,status=session.status,authority_effect=session.authority_effect)

operation SetValidation:
  input current optional<Session>
  input invocation Invocation
  output optional<Session>
  when not (match invocation Command(value) => true else false):
    return current
  when not (match CommandOf(invocation).payload SetValidation(value) => true else false):
    return current
  on absent(current) reject session-missing
  return some(WithValidation(current,SetValidationInput(invocation)))
