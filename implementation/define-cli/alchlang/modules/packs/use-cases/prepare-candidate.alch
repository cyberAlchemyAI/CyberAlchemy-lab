module Define.Packs.PrepareCandidate version 1
use Define.Shared.AuthorityEffect
use Define.Shared.Digest
use Define.Packs.Shared.PreparationEligibility
use Define.Packs.PrepareRequest
use Define.Shared.Ref
use Define.Work.Session
use Define.Shared.Standing
use Define.Packs.Shared.ToPrepareRequest

operation PrepareCandidate:
  input session Session
  output PrepareRequest
  enforce PreparationEligibility(session=session)
  return ToPrepareRequest(session)
