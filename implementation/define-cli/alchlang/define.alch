module Define version 1
use Define.Conversation.AskQuestion.AskQuestion
use Define.Work.BindInputs.BindEvidence
use Define.Work.BindInputs.BindSource
use Define.Shared.Binding
use Define.Work.CloseSession.CloseSession
use Define.Work.Command
use Define.Packs.ConfirmCandidate.ConfirmCandidate
use Define.Work.Context
use LabIntegration.InspectOperation.ContinueLab
use Define.Meanings.DefinitionPlacement
use Define.Meanings.DefinitionScope
use Define.Shared.Digest
use Define.Packs.PrepareRequest.ExportPreparation
use Define.Packs.ExportResult
use LabIntegration.LabContinuation
use LabIntegration.NativeObservation
use Define.Meanings.PlaceDefinition.PlaceDefinition
use Define.Packs.PrepareRequest
use Define.Meanings.RecordApplication.RecordApplication
use Define.Meanings.RecordAssessment.RecordAssessment
use Define.Meanings.RecordMeaning.RecordMeaning
use Define.Shared.Ref
use Define.Work.Rejection
use Define.Meanings.RequireConcept.RequireConcept
use Define.Conversation.RespondToQuestion.RespondToQuestion
use Define.Work.Result
use Define.Work.ResumeSession.ResumeSession
use Define.Packs.SelectMaterialization.SelectMaterialization
use Define.Work.Session
use Define.Work.SetContext.SetContext
use Define.Packs.SetValidation.SetValidation
use Define.Work.StartSession.StartSession
use Define.Work.ReviseRequest.StartSuccessor

interface CandidateAuthoring:
  kind bounded-schema
  exposes Session, Command, PrepareRequest

interface SourceContext:
  kind bounded-schema
  exposes Context, Binding

enum Invocation:
  variant Command value Command
  variant Export marker Bool
  variant ObserveLab value NativeObservation
  variant PlaceDefinition scope DefinitionScope
  variant CacheProjection value ProjectionInput

enum Reply:
  variant Transition value Result
  variant Request value ExportResult
  variant LabNext value LabContinuation
  variant Placement value DefinitionPlacement

value-object ProjectionInput:
  projection_id UInt64
  source_digest Digest
  session Session

rule Always:
  expression true

rule Resuming:
  input command Command
  expression match command.payload Resume(marker) => true else false

calculation CommandOf:
  pure
  input invocation Invocation
  result Command
  expression require-variant(invocation,Invocation.Command).value

calculation CacheInput:
  pure
  input invocation Invocation
  result ProjectionInput
  expression require-variant(invocation,Invocation.CacheProjection).value

mapping PresentReply:
  input current optional<Session>
  input invocation Invocation
  input prepared optional<PrepareRequest>
  target Reply
  total true
  expression match invocation:
    Command(value) => match current some(session) => Reply.Transition(value=Result.Updated(value=session)) else Reply.Transition(value=Result.Rejected(reason=SessionMissing))
    Export(marker) => match prepared some(request) => Reply.Request(value=ExportResult.Prepared(value=request)) else Reply.Request(value=ExportResult.Rejected(reason=SessionMissing))
    ObserveLab(value) => Reply.LabNext(value=ContinueLab(value))
    PlaceDefinition(scope) => Reply.Placement(value=PlaceDefinition(scope))
    CacheProjection(value) => Reply.Transition(value=Result.Updated(value=value.session))

operation ValidateInvocation:
  input current optional<Session>
  input invocation Invocation
  output optional<Session>
  when not (match invocation Command(value) => true else false):
    return current
  when present(current):
    on current.session_id != CommandOf(invocation).session_id reject session-mismatch
    on current.scope.project != CommandOf(invocation).project reject project-mismatch
    on current.scope.work != CommandOf(invocation).work reject work-mismatch
    on current.revision != CommandOf(invocation).expected_revision reject revision-conflict
    on current.closed and not Resuming(CommandOf(invocation)) reject session-closed
    return some(current)
  on not (match CommandOf(invocation).payload Initialize(value) => true else false) reject session-missing
  return current

entity Projection:
  id UInt64
  source_digest Digest
  value Session
  identity id

operation Execute:
  input current optional<Session>
  input invocation Invocation
  output Reply
  call verified ValidateInvocation(current=current,invocation=invocation)
  call stage0 StartSession(current=verified,invocation=invocation)
  call stage1 StartSuccessor(current=stage0,invocation=invocation)
  call stage2 SetContext(current=stage1,invocation=invocation)
  call stage3 AskQuestion(current=stage2,invocation=invocation)
  call stage4 RespondToQuestion(current=stage3,invocation=invocation)
  call stage5 RequireConcept(current=stage4,invocation=invocation)
  call stage6 RecordMeaning(current=stage5,invocation=invocation)
  call stage7 BindSource(current=stage6,invocation=invocation)
  call stage8 BindEvidence(current=stage7,invocation=invocation)
  call stage9 RecordApplication(current=stage8,invocation=invocation)
  call stage10 RecordAssessment(current=stage9,invocation=invocation)
  call stage11 SelectMaterialization(current=stage10,invocation=invocation)
  call stage12 SetValidation(current=stage11,invocation=invocation)
  call stage13 ConfirmCandidate(current=stage12,invocation=invocation)
  call stage14 CloseSession(current=stage13,invocation=invocation)
  call stage15 ResumeSession(current=stage14,invocation=invocation)
  call request ExportPreparation(current=stage15,invocation=invocation)
  transaction CacheProjection:
    atomic-participants Projection
    when (match invocation CacheProjection(value) => true else false):
      create projected Projection:
        id <- CacheInput(invocation).projection_id
        source_digest <- CacheInput(invocation).source_digest
        value <- CacheInput(invocation).session
    on-version-conflict reject projection-conflict
    on-unique-conflict reject projection-identity-conflict
    on-proven-rollback fail cache-rolled-back
    on-unknown-commit fail cache-outcome-unknown
  return PresentReply(stage15,invocation,request)

entry Define.ExecuteEntry:
  invokes Define.Execute
  interaction request-response
  access:
    authenticated customer
    permission define.author
    auth-resource define
    auth-action author
    auth-scope define-authoring

query ReadProjection:
  input id UInt64
  input project Ref
  input work Ref
  source row Projection
  output optional<Projection>
  where row.id == id and row.value.scope.project == project and row.value.scope.work == work
  project row
  on-missing return none
  on-unavailable fail cache-unavailable

entry Define.ReadProjectionEntry:
  invokes Define.ReadProjection
  interaction request-response
  access:
    authenticated customer
    permission define.ReadProjectionEntry
    auth-resource define
    auth-action ReadProjectionEntry
    auth-scope define-authoring
