{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/lab-define-result-v1.json",
  "title": "Lab Define candidate result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ok",
    "route",
    "context",
    "session",
    "definition_pack",
    "validation",
    "authority_effect",
    "lab_binding"
  ],
  "properties": {
    "schema_version": {
      "const": "cal.define-cli-result/v1"
    },
    "ok": {
      "const": true
    },
    "route": {
      "type": "object"
    },
    "context": {
      "type": "object"
    },
    "session": {
      "type": "object"
    },
    "definition_pack": {
      "type": "object"
    },
    "validation": {
      "type": "object"
    },
    "authority_effect": {
      "const": "none"
    },
    "lab_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_snapshot_digest",
        "head",
        "envelope",
        "authority_effect"
      ],
      "properties": {
        "source_snapshot_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "head": {
          "type": "string",
          "minLength": 1
        },
        "envelope": {
          "type": "object",
          "required": [
            "schema_version",
            "source_epoch",
            "context_epoch_id",
            "expires_at",
            "head",
            "included_items"
          ],
          "properties": {
            "schema_version": {
              "const": "cal.define-context-envelope/v1"
            },
            "included_items": {
              "type": "array",
              "minItems": 4
            },
            "expires_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "authority_effect": {
          "const": "none"
        }
      }
    },
    "output_path": {
      "type": "string"
    }
  }
}
