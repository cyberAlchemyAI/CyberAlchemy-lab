{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cav2.define-system-ontology-candidate/v1",
  "type": "object",
  "required": ["schema_version", "ontology_type", "source_package_ref", "source_snapshot", "source_snapshot_digest", "source_status", "source_implementation_status", "source_compiler_conformance", "business_candidate_digest", "business_handoff_receipt_digest", "dependency_receipt_set_digest", "system", "claim_ceiling", "status", "authority_effect"],
  "properties": {
    "schema_version": {"const": "cav2.define-system-ontology-candidate/v1"},
    "ontology_type": {"const": "system-runtime"},
    "source_package_ref": {"const": "define/system-ontology"},
    "source_snapshot": {
      "type": "object",
      "required": ["profile_sha256", "nodes_sha256", "relations_sha256"],
      "properties": {
        "profile_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "nodes_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "relations_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "source_snapshot_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_status": {"const": "candidate"},
    "source_implementation_status": {"const": "not-implemented"},
    "source_compiler_conformance": {"const": "not_evaluable"},
    "business_candidate_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "business_handoff_receipt_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dependency_receipt_set_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "system": {
      "type": "object",
      "required": ["runtime_boundary", "components", "interfaces", "state_model", "persistence_recovery", "operating_constraints"],
      "properties": {
        "runtime_boundary": {"type": "string", "minLength": 1},
        "components": {"type": "string", "minLength": 1},
        "interfaces": {"type": "string", "minLength": 1},
        "state_model": {"type": "string", "minLength": 1},
        "persistence_recovery": {"type": "string", "minLength": 1},
        "operating_constraints": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "claim_ceiling": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "status": {"const": "candidate"},
    "authority_effect": {"const": "none"}
  },
  "additionalProperties": false
}
