{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cav2.define-stage-registry/v1",
  "type": "object",
  "properties": {
    "schema_version": {"const": "cav2.define-ontology-stage/v1"},
    "stage_id": {"type": "string", "pattern": "^[a-z0-9](?:[-a-z0-9._/:]{0,126}[a-z0-9])?$"},
    "ontology_type": {"type": "string", "pattern": "^[a-z0-9](?:[-a-z0-9._/:]{0,126}[a-z0-9])?$"},
    "module_id": {"type": "string", "minLength": 1},
    "module_version": {"type": "string", "minLength": 1},
    "manifest_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "prerequisite_stage_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "capabilities": {
      "type": "object",
      "properties": {
        "describe": {"type": "string", "minLength": 1},
        "next_question": {"type": "string", "minLength": 1},
        "evaluate": {"type": "string", "minLength": 1},
        "materialize": {"type": "string", "minLength": 1},
        "validate": {"type": "string", "minLength": 1}
      },
      "required": ["describe", "next_question", "evaluate", "materialize", "validate"],
      "additionalProperties": false
    },
    "alch_entrypoints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "authority_effect": {"const": "none"}
  },
  "required": ["schema_version", "stage_id", "ontology_type", "module_id", "module_version", "manifest_digest", "prerequisite_stage_ids", "capabilities", "alch_entrypoints", "authority_effect"],
  "additionalProperties": false
}

