{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cav2.alch-product-ontology-candidate/v1",
  "type": "object",
  "required": ["schema_version", "ontology_type", "source_ontology_ref", "source_ontology_digest", "definition_pack_digest", "product", "non_collapse", "status", "authority_effect"],
  "properties": {
    "schema_version": {"const": "cav2.alch-product-ontology-candidate/v1"},
    "ontology_type": {"const": "product"},
    "source_ontology_ref": {"type": "string", "minLength": 1},
    "source_ontology_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "definition_pack_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "product": {
      "type": "object",
      "required": ["capability", "primary_user", "user_job", "outcome", "constraint"],
      "properties": {
        "capability": {"type": "string", "minLength": 1},
        "primary_user": {"type": "string", "minLength": 1},
        "user_job": {"type": "string", "minLength": 1},
        "outcome": {"type": "string", "minLength": 1},
        "constraint": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "non_collapse": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "status": {"const": "candidate"},
    "authority_effect": {"const": "none"}
  },
  "additionalProperties": false
}
