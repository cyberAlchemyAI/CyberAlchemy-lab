{
  "schemas": {
    "HandoffFacts": {
      "pack_handoff_ready": {
        "type": "boolean"
      },
      "language_quality_present": {
        "type": "boolean"
      },
      "semantic_grounding_pass": {
        "type": "boolean"
      },
      "non_collapse_pass": {
        "type": "boolean"
      },
      "orthogonality_pass": {
        "type": "boolean"
      },
      "output_target_new": {
        "type": "boolean"
      }
    },
    "HandoffDecision": {
      "status": {
        "type": "string",
        "pattern": "^(block|ready)$"
      },
      "repair_focus": {
        "type": "string",
        "pattern": "^(definition-pack|language-quality|semantic-grounding|non-collapse|orthogonality|output-target|none)$"
      },
      "authority_effect": {
        "type": "string",
        "const": "none"
      }
    }
  },
  "integrations": {},
  "flows": {},
  "endpoint": {
    "id": "DefineAlchHandoffReadiness",
    "target": "node-http",
    "runtime": "node>=26.8.1",
    "method": "POST",
    "path": "/define/alch-handoff-readiness",
    "input": "HandoffFacts",
    "output": "HandoffDecision",
    "authEnv": "DEFINE_RUNTIME_TOKEN",
    "maxBytes": 16384,
    "timeout": 1000,
    "errorStatus": 422,
    "statuses": {
      "block": 422,
      "ready": 200
    },
    "errors": {},
    "result": "EvaluateAlchHandoffReadiness"
  }
}
