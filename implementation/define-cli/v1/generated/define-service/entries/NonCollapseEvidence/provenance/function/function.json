{
  "schemas": {
    "NonCollapseEvidenceFacts": {
      "relation": {
        "type": "string",
        "pattern": "^(distinct|related|collapsed|unresolved|unsupported)$"
      },
      "difference_present": {
        "type": "boolean"
      }
    },
    "NonCollapseEvidenceDecision": {
      "status": {
        "type": "string",
        "pattern": "^(accept|block)$"
      },
      "repair_focus": {
        "type": "string",
        "pattern": "^(none|evidence|collapsed|unresolved)$"
      },
      "authority_effect": {
        "type": "string",
        "const": "none"
      }
    }
  },
  "integrations": {},
  "flows": {},
  "endpoint": {
    "id": "DefineNonCollapseEvidence",
    "target": "node-http",
    "runtime": "node>=26.8.1",
    "method": "POST",
    "path": "/define/non-collapse-evidence",
    "input": "NonCollapseEvidenceFacts",
    "output": "NonCollapseEvidenceDecision",
    "authEnv": "DEFINE_LANGUAGE_GATE_TOKEN",
    "maxBytes": 16384,
    "timeout": 1000,
    "errorStatus": 422,
    "statuses": {
      "accept": 200,
      "block": 422
    },
    "errors": {},
    "result": "EvaluateNonCollapseEvidence"
  }
}
