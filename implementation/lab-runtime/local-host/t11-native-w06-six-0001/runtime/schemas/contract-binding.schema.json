{
  "additionalProperties": false,
  "properties": {
    "allowed_relation_kinds": {
      "items": {
        "pattern": "^relation\\.[a-z0-9-]+$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "identity_field": {
      "minLength": 1,
      "type": "string"
    },
    "instance_discriminator": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "path",
        "value"
      ],
      "type": "object"
    },
    "relation_roles": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "counterpart_kinds": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "direction": {
            "enum": [
              "source",
              "target"
            ]
          },
          "relation_kind_ref": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "direction",
          "relation_kind_ref",
          "counterpart_kinds"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema_path": {
      "minLength": 1,
      "type": "string"
    },
    "schema_selector": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "semantic_kind": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "semantic_kind",
    "schema_path",
    "schema_sha256",
    "schema_selector",
    "identity_field",
    "instance_discriminator",
    "allowed_relation_kinds",
    "relation_roles"
  ],
  "type": "object"
}
