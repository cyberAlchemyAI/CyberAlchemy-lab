{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One source-pinned W08 workflow transition design route",
  "type": "object",
  "required": ["index", "member_ref", "route_kind", "original_body_binding", "original_disposition_binding", "review_choice_binding", "w08_design_binding", "original_definition_binding", "workflow_type_ref", "initial_state", "terminal_states", "transition_refs", "selected_original_relation", "admitted_or_executable"],
  "properties": {
    "index": {"type": "integer", "minimum": 4, "maximum": 13},
    "member_ref": {"type": "string", "pattern": "^protocol:W08:workflow:[a-z-]+$"},
    "route_kind": {"const": "task-local-workflow-transition-design"},
    "original_body_binding": {"$ref": "#/$defs/binding"},
    "original_disposition_binding": {"$ref": "#/$defs/binding"},
    "review_choice_binding": {"$ref": "#/$defs/binding"},
    "w08_design_binding": {"$ref": "#/$defs/binding"},
    "original_definition_binding": {"$ref": "#/$defs/binding"},
    "workflow_type_ref": {"type": "string", "pattern": "^workflow:[a-z-]+:v1-candidate$"},
    "initial_state": {"type": "string", "minLength": 1},
    "terminal_states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "transition_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^transition:[a-z-]+:[a-z-]+$"}},
    "selected_original_relation": {"type": "null"},
    "admitted_or_executable": {"const": false}
  },
  "$defs": {"binding": {"type": "object", "required": ["path", "sha256"],
    "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "size_bytes": {"type": "integer", "minimum": 0}},
    "additionalProperties": false}},
  "additionalProperties": false
}
