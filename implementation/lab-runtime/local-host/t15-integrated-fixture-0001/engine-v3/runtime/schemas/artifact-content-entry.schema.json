{
  "$id": "urn:cyberalchemy-lab:candidate-storage:artifact-content-entry:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "byte_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "content_ref": {
      "minLength": 1,
      "type": "string"
    },
    "data": {
      "contentEncoding": "base64",
      "type": "string"
    },
    "encoding": {
      "const": "base64"
    },
    "media_type": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "lab-artifact-content-entry/v1-candidate"
    },
    "semantic_binding": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "algorithm_ref": {
              "minLength": 1,
              "type": "string"
            },
            "value_sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          },
          "required": [
            "algorithm_ref",
            "value_sha256"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "size_bytes": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "content_ref",
    "media_type",
    "byte_sha256",
    "size_bytes",
    "encoding",
    "data",
    "semantic_binding"
  ],
  "title": "Proposed artifact-content-entry protocol",
  "type": "object"
}
