{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cold O05 generator and local-vocabulary route",
  "type": "object",
  "required": ["schema_version", "generator", "vocabulary", "source_bodies_copied", "source_effects_applied", "authority_effect", "generator_rerun_this_run"],
  "properties": {
    "schema_version": {"const": "lab-T10-O05-retained-local-route/v2"},
    "generator": {
      "type": "object",
      "required": ["scope_binding", "code_binding", "profile_binding", "manifest_binding", "reproduction_binding", "output_schema_binding", "output_record_binding", "output_carrier_ref", "core_sha256", "repeated_build", "cold_reconstruction"],
      "properties": {
        "scope_binding": {"$ref": "#/$defs/binding"},
        "code_binding": {"$ref": "#/$defs/binding"},
        "profile_binding": {"$ref": "#/$defs/binding"},
        "manifest_binding": {"$ref": "#/$defs/binding"},
        "reproduction_binding": {"$ref": "#/$defs/binding"},
        "output_schema_binding": {"$ref": "#/$defs/binding"},
        "output_record_binding": {"$ref": "#/$defs/binding"},
        "output_carrier_ref": {"const": "cal.artifact-type.generated-output/v2"},
        "core_sha256": {"$ref": "#/$defs/sha"},
        "repeated_build": {"const": "PASS"},
        "cold_reconstruction": {"const": "PASS"}
      },
      "additionalProperties": false
    },
    "vocabulary": {
      "type": "object",
      "required": ["profile_binding", "namespace", "predicate_count", "edge_directions", "global_typed_relations_created", "confidence_level"],
      "properties": {
        "profile_binding": {"$ref": "#/$defs/binding"},
        "namespace": {"const": "lab.legacy-source-assertion.cav2-product-thesis"},
        "predicate_count": {"const": 20},
        "edge_directions": {"const": {"directed": 49, "symmetric": 1}},
        "global_typed_relations_created": {"const": 0},
        "confidence_level": {"const": "not-assessed"}
      },
      "additionalProperties": false
    },
    "source_bodies_copied": {"const": 0},
    "source_effects_applied": {"const": 0},
    "authority_effect": {"const": "none"},
    "generator_rerun_this_run": {"const": false}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
