{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exact local O05 source-retention route summary",
  "type": "object",
  "required": ["members", "original_refs", "source_projection", "o05_receipt_binding", "o06_disposition_binding", "o06_private_use_binding", "selected_governed_models", "source_import_or_archive_replay_executed", "authority_effect"],
  "properties": {
    "members": {"const": [24, 25, 26]},
    "original_refs": {"const": ["protocol:O06:source-dispositions", "protocol:O06:private-metadata-use", "protocol:O06:original-native-archive-retention"]},
    "source_projection": {
      "type": "object",
      "required": ["disposition_counts", "source_manifest_counts", "archive_sha256", "source_selection_binding", "public_body_export_allowed", "selected_source_effects"],
      "properties": {
        "disposition_counts": {"const": {"adapt": 88, "reference": 43, "block": 9}},
        "source_manifest_counts": {"const": {"source": 131, "ontology-node": 38, "ontology-edge": 50, "generated-output": 1}},
        "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_selection_binding": {"$ref": "#/$defs/binding"},
        "public_body_export_allowed": {"const": false},
        "selected_source_effects": {"const": 0}
      },
      "additionalProperties": false
    },
    "o05_receipt_binding": {"$ref": "#/$defs/binding"},
    "o06_disposition_binding": {"$ref": "#/$defs/binding"},
    "o06_private_use_binding": {"$ref": "#/$defs/binding"},
    "selected_governed_models": {"const": 0},
    "source_import_or_archive_replay_executed": {"const": false},
    "authority_effect": {"const": "none"}
  },
  "$defs": {
    "binding": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
