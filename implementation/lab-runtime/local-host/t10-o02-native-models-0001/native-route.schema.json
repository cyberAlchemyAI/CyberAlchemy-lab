{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Retained O02 native representation and confidence route",
  "type": "object",
  "required": ["members", "original_refs", "observed", "selected_governed_models", "authority_effect", "representation_profile_binding", "translation_profile_binding", "unknown_confidence_proposal_binding", "o02_receipt_binding", "episode_binding", "mapping_witness_binding", "native_view_binding"],
  "properties": {
    "members": {"const": [16, 17, 19, 20]},
    "original_refs": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "observed": {"type": "object", "required": ["actual_native_replay_this_run", "candidate_node_ids", "confidence_level", "global_edge_selected", "native_checkpoint_parity", "rich_nodes", "typed_relations"],
      "properties": {"actual_native_replay_this_run": {"const": false},
        "candidate_node_ids": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "confidence_level": {"const": "not-assessed"}, "global_edge_selected": {"const": false},
        "native_checkpoint_parity": {"const": "PASS"}, "rich_nodes": {"const": 3}, "typed_relations": {"const": 1}},
      "additionalProperties": false},
    "selected_governed_models": {"const": 0}, "authority_effect": {"const": "none"},
    "representation_profile_binding": {"$ref": "#/$defs/binding"},
    "translation_profile_binding": {"$ref": "#/$defs/binding"},
    "unknown_confidence_proposal_binding": {"$ref": "#/$defs/binding"},
    "o02_receipt_binding": {"$ref": "#/$defs/binding"},
    "episode_binding": {"$ref": "#/$defs/binding"},
    "mapping_witness_binding": {"$ref": "#/$defs/binding"},
    "native_view_binding": {"$ref": "#/$defs/binding"}
  },
  "$defs": {"binding": {"type": "object", "required": ["path", "sha256"],
    "properties": {"path": {"type": "string", "minLength": 1},
      "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "additionalProperties": false}},
  "additionalProperties": false
}
