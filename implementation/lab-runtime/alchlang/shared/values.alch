module Lab.Shared version 1

value-object Ref:
  carrier String
  utf8-bytes 1..256
  unicode-scalars 1..256
value-object Text:
  carrier String
  utf8-bytes 1..10000
  unicode-scalars 1..10000
value-object Digest:
  carrier String
  utf8-bytes 64..64
  unicode-scalars 64..64
  pattern "^[a-f0-9]{64}$"
value-object Binding:
  path Ref
  sha256 Digest
  bytes UInt64
  digest_kind literal "original-file-sha256"
enum NoAuthority:
  value NoAuthority wire "none"
