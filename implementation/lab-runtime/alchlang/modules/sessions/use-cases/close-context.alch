module Lab.Sessions.CloseContext version 1
use Lab.Sessions.SessionPhase
use Lab.Sessions.SessionSignal
use Lab.Sessions.SessionView

mapping EraseSession:
  input view SessionView
  target SessionView
  total true
  expression SessionView(session_id=view.session_id,project=view.project,subject=view.subject,head=view.head,snapshot=view.snapshot,deadline=view.deadline,phase=SessionClosed,memory=[])
operation CloseContext:
  input view SessionView
  output SessionView
  return EraseSession(view)
