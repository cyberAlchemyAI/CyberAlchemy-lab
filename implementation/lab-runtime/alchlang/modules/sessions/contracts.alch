module Lab.Sessions version 1
use Lab.Shared.Digest
use Lab.Shared.Ref
use Lab.Shared.Text

enum SessionPhase:
  value SessionOpen
  value SessionClosed
  value SessionExpired
enum SessionSignal:
  value ReadContext
  value CloseContext
  value SessionExpiry
value-object SessionView:
  session_id Ref
  project Ref
  subject Ref
  head Digest
  snapshot Digest
  deadline UInt64
  phase SessionPhase
  memory List<Text,100>
