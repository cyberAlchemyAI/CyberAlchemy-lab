module Lab.Definitions.CreateDefinition version 1
use Lab.Records.CreationRequest
use Lab.Records.RecordDraft
use Lab.Records.CreationBound
use Lab.Records.DraftScope
use Lab.Records.DraftLocation
use Lab.Records.DraftStatus
use Lab.SourceContext.Branch
use Lab.SourceContext.SourcesCurrent
use Lab.Transactions.Target
use Lab.Transactions.Category
use Lab.Transactions.Effect
use Lab.Shared.NoAuthority

enum DefinitionCreationReason:
  value StaleSource wire "source-stale"
  value WrongProject wire "project-mismatch"
  value MissingWork wire "work-required"
  value SharedWorkAmbiguous wire "project-scope-has-work"
  value StaleValidation wire "creation-validation-stale"
  value UnboundBody wire "creation-body-unbound"
  value WrongDefinitionCarrier wire "definition-carrier-required"
  value CarrierUnavailable wire "carrier-not-current"
  value InvalidBody wire "creation-schema-invalid"
  value ExistingIdentity wire "creation-identity-exists"
  value NotCandidate wire "creation-requires-candidate"
  value DerivedTarget wire "creation-derived-target"
enum DefinitionCreationAdmission:
  variant Allow
  variant Reject reason DefinitionCreationReason
calculation PermitDefinition:
  pure
  result DefinitionCreationAdmission
  expression DefinitionCreationAdmission.Allow()
calculation RefuseDefinition:
  pure
  input reason DefinitionCreationReason
  result DefinitionCreationAdmission
  expression DefinitionCreationAdmission.Reject(reason=reason)
policy DefinitionCreationEligibility:
  input request CreationRequest
  input branch Branch
  result DefinitionCreationAdmission
  ordered-cases:
    staleSource when not SourcesCurrent(branch) -> RefuseDefinition(reason=DefinitionCreationReason.StaleSource)
    differentProject when request.project != branch.project -> RefuseDefinition(reason=DefinitionCreationReason.WrongProject)
    missingWork when request.scope == WorkScope and absent(request.work) -> RefuseDefinition(reason=DefinitionCreationReason.MissingWork)
    projectHasWork when request.scope == ProjectScope and present(request.work) -> RefuseDefinition(reason=DefinitionCreationReason.SharedWorkAmbiguous)
    staleValidation when request.validation.head != branch.head.transaction_digest or request.validation.snapshot != branch.sources.snapshot -> RefuseDefinition(reason=DefinitionCreationReason.StaleValidation)
    bodyUnbound when not CreationBound(request) -> RefuseDefinition(reason=DefinitionCreationReason.UnboundBody)
    wrongCarrier when request.carrier != "cal.artifact-type.definition/v2" or request.validation.semantic_kind != "definition" -> RefuseDefinition(reason=DefinitionCreationReason.WrongDefinitionCarrier)
    inactiveCarrier when not request.validation.current_carrier -> RefuseDefinition(reason=DefinitionCreationReason.CarrierUnavailable)
    invalidBody when not request.validation.schema_valid -> RefuseDefinition(reason=DefinitionCreationReason.InvalidBody)
    identityExists when not request.validation.identity_available -> RefuseDefinition(reason=DefinitionCreationReason.ExistingIdentity)
    notCandidate when not request.validation.candidate_payload -> RefuseDefinition(reason=DefinitionCreationReason.NotCandidate)
    derivedTarget when not request.validation.authored_target -> RefuseDefinition(reason=DefinitionCreationReason.DerivedTarget)
    otherwise -> PermitDefinition()
calculation DefinitionLocation:
  pure
  input scope DraftScope
  result DraftLocation
  expression match scope ProjectScope => ProjectDefinitions else WorkDefinitions
mapping ToDefinitionDraft:
  input request CreationRequest
  target RecordDraft
  total true
  expression RecordDraft(project=request.project,scope=request.scope,work=request.work,identity_ref=request.identity_ref,owner=request.owner,location=DefinitionLocation(request.scope),target=Target(category=Definition,effect=Admit,version=request.version,carrier=request.carrier,predecessor=none,decision=request.decision,authored_record=some(request.source),contract=none),schemas=[],status=CandidateDraft,authority_effect=NoAuthority)
operation CreateDefinition:
  input request CreationRequest
  input branch Branch
  output RecordDraft
  enforce DefinitionCreationEligibility(request=request,branch=branch)
  return ToDefinitionDraft(request)
