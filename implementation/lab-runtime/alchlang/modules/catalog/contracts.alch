module Lab.Catalog version 1
use Lab.Shared.Binding
use Lab.Shared.Ref

enum SubjectStanding:
  value AdmittedCurrent
  value AdmittedHistorical
  value LocalCurrent
  value LocalHistorical
  value WithdrawnStanding
value-object Subject:
