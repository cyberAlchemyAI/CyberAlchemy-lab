module Lab.Ontology version 1
use Lab.Shared.NoAuthority
use Lab.Shared.Ref

enum Direction:
  value Incoming wire "incoming"
  value Outgoing wire "outgoing"
  value Both wire "both"
value-object Traversal:
  root Ref
  direction Direction
  depth UInt64
  max_nodes UInt64
  max_edges UInt64
value-object TraversalPlan:
  request Traversal
  confirmed_paths_allowed Bool
  replay_source Bool
  authority_effect NoAuthority
