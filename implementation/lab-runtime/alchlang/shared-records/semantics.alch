module Lab.SharedDesign.Semantics version 1
use Lab.SharedDesign.Contracts.Ref
use Lab.SharedDesign.Contracts.CheckResult
use Lab.SharedDesign.Contracts.CheckSpecification
use Lab.SharedDesign.Contracts.Verification
use Lab.SharedDesign.Contracts.Digest
use Lab.SharedDesign.Contracts.Binding
use Lab.SharedDesign.Contracts.Carrier
use Lab.SharedDesign.Contracts.Disposition
use Lab.SharedDesign.Contracts.Decision
use Lab.SharedDesign.Contracts.CompatibilityIntent
use Lab.SharedDesign.Contracts.DispositionEvidence
use Lab.SharedDesign.Contracts.DefinitionReview
use Lab.SharedDesign.Contracts.RelationMapping
use Lab.SharedDesign.Contracts.CompatibilityCase
use Lab.SharedDesign.Contracts.WorkspaceKind
use Lab.SharedDesign.Contracts.ExecutionContext
use Lab.SharedDesign.Contracts.CreationKind
use Lab.SharedDesign.Contracts.CreationCase
use Lab.SharedDesign.Contracts.CreationPlan
use Lab.SharedDesign.Contracts.NativeOutcome
use Lab.SharedDesign.Contracts.NativeReceipt
use Lab.SharedDesign.Contracts.PublicationCase
use Lab.SharedDesign.Contracts.JoinPhase
use Lab.SharedDesign.Contracts.JoinSignal
use Lab.SharedDesign.Contracts.JoinObservation
use Lab.SharedDesign.Contracts.LifecycleIntent
use Lab.SharedDesign.Contracts.LifecycleCase
use Lab.SharedDesign.Contracts.Stage
use Lab.SharedDesign.Contracts.StageSubject
use Lab.SharedDesign.Contracts.StageHandoff
use Lab.SharedDesign.Contracts.ConstructionCase
use Lab.SharedDesign.Contracts.ConstructionCompletion
use Lab.SharedDesign.Contracts.RegistryClosureCase
use Lab.SharedDesign.Contracts.ReviewCarryForward
use Lab.SharedDesign.Contracts.CarriedConstructionCase
use Lab.SharedDesign.Contracts.RuntimeReadiness

rule DispositionMatches:
  input review DefinitionReview
  expression match review.disposition some(value) => value.target == review.target and value.owner == review.expected_owner and value.scope == review.scope and value.source_cut == review.source_cut and present(value.role_assignment) and present(value.verification_receipt) else false
calculation ChooseDecision:
  pure
  input value Decision
  result Decision
  expression value
policy DefinitionReviewPlan:
  input review DefinitionReview
  result Decision
  ordered-cases:
    stale when not review.source_current -> ChooseDecision(value=Decision.Stale)
    missingFields when absent(review.fields_receipt) -> ChooseDecision(value=Decision.NeedsEvidence)
    contextDrift when not review.consumer_bindings_current -> ChooseDecision(value=Decision.NeedsContextUpdate)
    noOwner when absent(review.disposition) -> ChooseDecision(value=Decision.NeedsOwnerReview)
    unboundOwner when not DispositionMatches(review) -> ChooseDecision(value=Decision.InvalidEvidence)
    accepted when ReviewIs(review,Disposition.Accepted) -> ChooseDecision(value=Decision.CandidateOnly)
    rejected when ReviewIs(review,Disposition.Rejected) -> ChooseDecision(value=Decision.Rejected)
    otherwise -> ChooseDecision(value=Decision.NeedsOwnerReview)
rule ReviewIs:
  input review DefinitionReview
  input outcome Disposition
  expression match review.disposition some(value) => value.outcome == outcome else false
rule ReviewsAccepted:
  input reviews List<DefinitionReview,64>
  expression length(reviews) > 0 and fold(reviews,true,accepted:Bool,review:DefinitionReview => accepted and DefinitionReviewPlan(review) == Decision.CandidateOnly)
rule ReviewTargetsUnique:
  input reviews List<DefinitionReview,5>
  expression fold(reviews,true,unique:Bool,review:DefinitionReview => unique and length(filter(reviews,other:DefinitionReview => other.target.ref == review.target.ref)) == 1)
rule TargetRelationsSupported:
  input value CompatibilityCase
  expression fold(value.target_relations,true,valid:Bool,kind:Ref => valid and length(filter(value.allowed_target_relations,allowed:Ref => allowed == kind)) == 1)
rule SourceRelationsMapped:
  input value CompatibilityCase
  expression fold(value.source_relations,true,valid:Bool,kind:Ref => valid and (length(filter(value.allowed_target_relations,allowed:Ref => allowed == kind)) == 1 or length(filter(value.relation_mappings,mapping:RelationMapping => mapping.old_kind == kind and length(filter(value.allowed_target_relations,allowed:Ref => allowed == mapping.new_kind)) == 1)) == 1))
rule UpgradeReviewBound:
  input value CompatibilityCase
  expression match value.meaning_review some(review) => review.target == value.target_body and review.owner == value.expected_owner and review.scope == value.expected_scope and review.source_cut == value.cut and present(review.previous) and review.previous == value.source_body and review.outcome == Disposition.Accepted and present(review.role_assignment) and present(review.verification_receipt) else false
policy CarrierCompatibility:
  input value CompatibilityCase
  result Decision
  ordered-cases:
    wrongSchema when value.selected_schema != value.observed_schema or absent(value.schema_receipt) or not value.target_schema_valid -> ChooseDecision(value=Decision.NeedsEvidence)
    identityRewrite when value.source_body.ref == value.target_body.ref and value.source_body.sha256 != value.target_body.sha256 -> ChooseDecision(value=Decision.IdentityRewriteRefused)
    downcast when value.intent == CompatibilityIntent.Downgrade -> ChooseDecision(value=Decision.AutomaticDowngradeRefused)
    unsupportedTarget when not TargetRelationsSupported(value) -> ChooseDecision(value=Decision.UnsupportedRelation)
    changedRead when value.intent == CompatibilityIntent.ReadRetained and value.source_body != value.target_body -> ChooseDecision(value=Decision.InvalidEvidence)
    fidelity when not Verified(value.fidelity,value.target_body,value.expected_scope,value.cut,Ref("representation-fidelity")) -> ChooseDecision(value=Decision.InvalidEvidence)
    historicalRead when value.intent == CompatibilityIntent.ReadRetained and value.source_carrier == Carrier.V1 and value.target_carrier == Carrier.V1 -> ChooseDecision(value=Decision.HistoricalRead)
    unavailableCarrier when not value.carrier_current or absent(value.carrier_admission) -> ChooseDecision(value=Decision.NeedsEvidence)
    newV2 when value.intent == CompatibilityIntent.CreateV2 and value.target_carrier == Carrier.V2 -> ChooseDecision(value=Decision.CandidateV2)
    unmappedRelations when not SourceRelationsMapped(value) or not ExactEdgesMapped(value) -> ChooseDecision(value=Decision.NeedsRelationReview)
    meaningChanged when value.source_normative != value.target_normative -> ChooseDecision(value=Decision.NeedsMeaningChange)
    unreviewedUpgrade when absent(value.lineage) or not UpgradeReviewBound(value) -> ChooseDecision(value=Decision.NeedsOwnerReview)
    exactUpgrade when value.intent == CompatibilityIntent.Upgrade and value.source_carrier == Carrier.V1 and value.target_carrier == Carrier.V2 -> ChooseDecision(value=Decision.CandidateSuccessor)
    otherwise -> ChooseDecision(value=Decision.InvalidEvidence)
policy ExecutionContextPlan:
  input value ExecutionContext
  result Decision
  ordered-cases:
    stale when value.source_cut != value.current_source_cut -> ChooseDecision(value=Decision.Stale)
    workWithoutProject when present(value.work) and absent(value.project) -> ChooseDecision(value=Decision.WrongScope)
    projectUnselected when value.kind == WorkspaceKind.Project and absent(value.project) -> ChooseDecision(value=Decision.NeedsProject)
    projectNotLinked when present(value.project) and length(filter(value.linked_projects,item:Ref => item == value.project)) != 1 -> ChooseDecision(value=Decision.WrongScope)
    inspectOnly when not value.effect_requested -> ChooseDecision(value=Decision.ContextPlanReady)
    noHost when absent(value.host) -> ChooseDecision(value=Decision.NeedsHost)
    noNativeProject when value.host_project_only and absent(value.project) -> ChooseDecision(value=Decision.NeedsProject)
    noCustody when absent(value.custody) or absent(value.store) -> ChooseDecision(value=Decision.NeedsCustody)
    otherwise -> ChooseDecision(value=Decision.ContextPlanReady)
policy CreationRouting:
  input value CreationCase
  result Decision
  ordered-cases:
    noContext when value.context_decision != Decision.ContextPlanReady -> ChooseDecision(value=value.context_decision)
    unverifiedBody when absent(value.verification_receipt) -> ChooseDecision(value=Decision.NeedsEvidence)
    wrongDefinitionCarrier when value.kind == CreationKind.Definition and value.selected_carrier != "cal.artifact-type.definition/v2" -> ChooseDecision(value=Decision.InvalidEvidence)
    publicRouteMissing when not value.public_route_compiled -> ChooseDecision(value=Decision.NeedsRouteWiring)
    otherwise -> ChooseDecision(value=Decision.DraftPlanReady)
mapping ToCreationPlan:
  input value CreationCase
  target CreationPlan
  total true
  expression CreationPlan(decision=CreationRouting(value),entry_ref=match (value.kind == CreationKind.Definition) true => Ref("Lab.CreateDefinitionEntry") else match (value.kind == CreationKind.ArtifactType) true => Ref("Lab.CreateArtifactTypeEntry") else Ref("Lab.CreateRecordEntry"),original=value.original,source_cut=value.source_cut,unsigned=true,authority_effect="none")
rule NativeReceiptMatches:
  input value PublicationCase
  expression match value.native_receipt some(receipt) => receipt.workspace == value.workspace and receipt.head == value.native_head and receipt.operation_ref == value.operation_ref and receipt.proposal == value.proposal and receipt.targets == value.expected_targets and receipt.source_cut == value.source_cut else false
rule SemanticCoverage:
  input targets List<Binding,64>
  input reviews List<DefinitionReview,64>
  expression length(targets) > 0 and length(targets) == length(reviews) and ReviewsAccepted(reviews) and fold(targets,true,valid:Bool,target:Binding => valid and length(filter(targets,other:Binding => other.ref == target.ref)) == 1 and length(filter(reviews,review:DefinitionReview => review.target == target)) == 1)
policy PublicationPlanning:
  input value PublicationCase
  result Decision
  ordered-cases:
    observed when PublicationObserved(value) -> ChooseDecision(value=Decision.PreservePublicationReceipt)
    unrelatedReceipt when present(value.observed_receipt) or present(value.publication_receipt) -> ChooseDecision(value=Decision.InvalidEvidence)
    ownerPending when not SemanticCoverage(value.target_bodies,value.semantic_reviews) or not ReviewsAtCut(value.semantic_reviews,value.source_cut) -> ChooseDecision(value=Decision.NeedsOwnerReview)
    registryContractMissing when not value.registry_contract_current or absent(value.registry_contract) -> ChooseDecision(value=Decision.NeedsRegistryContract)
    headChanged when value.expected_selector != value.observed_selector or value.expected_registry != value.observed_registry -> ChooseDecision(value=Decision.NeedsPublicationRebase)
    invalidBundle when not AdmissionSnapshotMatches(value) or not Verified(value.bundle_review,value.bundle,value.workspace,value.source_cut,Ref("closed-publication-bundle")) -> ChooseDecision(value=Decision.InvalidEvidence)
    noCanonicalPermission when not CanonicalPermission(value) -> ChooseDecision(value=Decision.NeedsPermission)
    noPermission when absent(value.permission) or absent(value.permission_proposal) or value.permission_proposal != value.proposal -> ChooseDecision(value=Decision.NeedsPermission)
    noNative when absent(value.native_receipt) -> ChooseDecision(value=Decision.NeedsNativeCommit)
    wrongNative when not NativeReceiptMatches(value) -> ChooseDecision(value=Decision.InvalidEvidence)
    unknown when NativeIs(value,NativeOutcome.Unknown) -> ChooseDecision(value=Decision.InspectOriginalOperation)
    refused when NativeIs(value,NativeOutcome.Refused) -> ChooseDecision(value=Decision.PreserveRefusal)
    committed when NativeIs(value,NativeOutcome.Committed) or NativeIs(value,NativeOutcome.Replayed) -> ChooseDecision(value=Decision.PublicationPlanReady)
    otherwise -> ChooseDecision(value=Decision.NeedsNativeCommit)
rule NativeIs:
  input value PublicationCase
  input outcome NativeOutcome
  expression match value.native_receipt some(receipt) => receipt.outcome == outcome else false
state-machine JoinLifecycle:
  state JoinPhase
  input JoinSignal
  initial Proposed
  terminal Completed, Refused
  transition Proposed SelectContext -> ContextSelected
  transition ContextSelected PrepareDraft -> DraftPrepared
  transition DraftPrepared RequestReview -> AwaitingSemanticReview
  transition AwaitingSemanticReview ObserveSemanticAcceptance -> AwaitingPermission
  transition AwaitingPermission ObservePermission -> ReadyToDispatch
  transition ReadyToDispatch ObserveNativeUnknown -> NativeUnknown
  transition ReadyToDispatch ObserveNativeCommit -> LocalCommitted
  transition NativeUnknown ObserveRefusal -> Refused
  transition PublicationUnknown ObserveRefusal -> Refused
  transition PublicationPrepared ObserveRefusal -> Refused
  transition NativeUnknown ObserveNativeCommit -> LocalCommitted
  transition LocalCommitted PreparePublication -> PublicationPrepared
  transition PublicationPrepared ObservePublicationUnknown -> PublicationUnknown
  transition PublicationPrepared ObservePublication -> CanonicalPublished
  transition PublicationUnknown ObservePublication -> CanonicalPublished
  transition CanonicalPublished RequestSourceTransition -> SourceTransitionPending
  transition SourceTransitionPending ObserveSourceTransition -> Completed
  transition AwaitingSemanticReview ObserveRefusal -> Refused
  transition AwaitingPermission ObserveRefusal -> Refused
  transition ReadyToDispatch ObserveRefusal -> Refused
  otherwise reject invalid-join-transition
policy JoinContinuation:
  input value JoinObservation
  result Decision
  ordered-cases:
    terminalMismatch when value.phase == JoinPhase.Completed and not CompletionObserved(value) -> ChooseDecision(value=Decision.InvalidEvidence)
    completed when value.phase == JoinPhase.Completed -> ChooseDecision(value=Decision.PreserveCompleted)
    refusalMismatch when value.phase == JoinPhase.Refused and not RefusalObserved(value) -> ChooseDecision(value=Decision.InvalidEvidence)
    terminalRefusal when value.phase == JoinPhase.Refused -> ChooseDecision(value=Decision.PreserveRefusal)
    unknownNative when value.native_outcome == NativeOutcome.Unknown -> ChooseDecision(value=Decision.InspectOriginalOperation)
    unknownPublication when value.publication_outcome == NativeOutcome.Unknown -> ChooseDecision(value=Decision.InspectOriginalOperation)
    refused when value.native_outcome == NativeOutcome.Refused or value.publication_outcome == NativeOutcome.Refused -> ChooseDecision(value=Decision.PreserveRefusal)
    unverifiedPublication when (value.phase == JoinPhase.CanonicalPublished or value.phase == JoinPhase.SourceTransitionPending) and not PublicationHistoryObserved(value) -> ChooseDecision(value=Decision.InvalidEvidence)
    published when value.phase == JoinPhase.CanonicalPublished or value.phase == JoinPhase.SourceTransitionPending -> ChooseDecision(value=Decision.NeedsSourceTransition)
    changedSource when value.source_cut != value.current_source_cut -> ChooseDecision(value=Decision.Stale)
    localCommitted when value.phase == JoinPhase.LocalCommitted and (value.native_outcome == NativeOutcome.Committed or value.native_outcome == NativeOutcome.Replayed) -> ChooseDecision(value=Decision.PublicationPlanReady)
    otherwise -> ChooseDecision(value=Decision.NeedsPermission)
rule LifecycleOwnerMatches:
  input value LifecycleCase
  expression match value.owner_review some(review) => review.target == value.current and review.owner == value.expected_owner and review.scope == value.scope and review.source_cut == value.source_cut and review.outcome == Disposition.Accepted and present(review.role_assignment) and present(review.verification_receipt) else false
policy LifecycleImpactPlan:
  input value LifecycleCase
  result Decision
  ordered-cases:
    stale when value.source_cut != value.closure_cut -> ChooseDecision(value=Decision.Stale)
    incomplete when absent(value.closure_receipt) or absent(value.consumer_manifest) or value.truncated or value.unresolved_dependents > 0 -> ChooseDecision(value=Decision.NeedsImpactClosure)
    noSuccessor when value.intent != LifecycleIntent.Withdraw and absent(value.successor) -> ChooseDecision(value=Decision.NeedsEvidence)
    transitionMismatch when not LifecycleBound(value) -> ChooseDecision(value=Decision.InvalidEvidence)
    ownerPending when not LifecycleOwnerMatches(value) -> ChooseDecision(value=Decision.NeedsOwnerReview)
    permissionMissing when absent(value.permission) or not LifecyclePermission(value) -> ChooseDecision(value=Decision.NeedsPermission)
    otherwise -> ChooseDecision(value=Decision.LifecyclePlanReady)
rule AdjacentStages:
  input left Stage
  input right Stage
  expression (left == Stage.Definitions and right == Stage.Artifacts) or (left == Stage.Artifacts and right == Stage.Business) or (left == Stage.Business and right == Stage.Bridge) or (left == Stage.Bridge and right == Stage.System) or (left == Stage.System and right == Stage.AlchLang) or (left == Stage.AlchLang and right == Stage.Generation)
rule ConstructionShape:
  input value ConstructionCase
  expression length(value.stages) == 7 and length(value.handoffs) == 6 and fold(value.stages,true,valid:Bool,item:StageSubject => valid and item.source_cut == value.source_cut and length(filter(value.stages,other:StageSubject => other.stage == item.stage)) == 1) and fold(value.handoffs,true,valid:Bool,item:StageHandoff => valid and item.source_cut == value.source_cut and AdjacentStages(item.source_stage,item.target_stage) and length(filter(value.handoffs,other:StageHandoff => other.source_stage == item.source_stage)) == 1 and length(filter(value.stages,stage:StageSubject => stage.stage == item.source_stage and stage.subject == item.input_subject)) == 1 and length(filter(value.stages,stage:StageSubject => stage.stage == item.target_stage and stage.subject == item.output_subject)) == 1)
rule RequiredChecksSpecified:
  input required List<Ref,100>
  input supplied List<Ref,100>
  expression length(required) > 0 and fold(required,true,valid:Bool,item:Ref => valid and length(filter(supplied,other:Ref => other == item)) == 1)
policy ConstructionEntryPlan:
  input value ConstructionCase
  result Decision
  ordered-cases:
    invalidShape when not ConstructionShape(value) or value.unresolved_mappings > 0 -> ChooseDecision(value=Decision.NeedsCoverage)
    undefinedChecks when not SpecificationsCover(value.required_obligations,value.specifications) -> ChooseDecision(value=Decision.NeedsCoverage)
    selectionMismatch when not SelectionPartition(value) or not Verified(value.selection_review,value.selection,Ref("construction"),value.source_cut,Ref("complete-selection")) -> ChooseDecision(value=Decision.NeedsCoverage)
    ownerPending when (length(value.review_targets) > 0 and not SemanticCoverage(value.review_targets,value.definitions)) or length(value.review_targets) != length(value.definitions) or not ReviewsAtCut(value.definitions,value.source_cut) or absent(value.definition_selection_receipt) -> ChooseDecision(value=Decision.NeedsOwnerReview)
    inheritedRoute when absent(value.construction_compatibility) or absent(value.prototype_selection) -> ChooseDecision(value=Decision.NeedsConstructionCompatibility)
    noResources when absent(value.language_selection) or absent(value.native_closure) or absent(value.resolved_capabilities_receipt) -> ChooseDecision(value=Decision.NeedsEvidence)
    noPermission when value.effects_requested and absent(value.permission) -> ChooseDecision(value=Decision.NeedsPermission)
    otherwise -> ChooseDecision(value=Decision.GenerationEntryPlanReady)
policy ConstructionCompletionPlan:
  input value ConstructionCompletion
  result Decision
  ordered-cases:
    noEntry when value.entry_decision != Decision.GenerationEntryPlanReady or not EntryBound(value) -> ChooseDecision(value=Decision.NeedsCoverage)
    changedCut when value.expected_source_cut != value.observed_source_cut -> ChooseDecision(value=Decision.Stale)
    noOutput when absent(value.output_manifest) or absent(value.assessed_output) or value.output_manifest != value.assessed_output -> ChooseDecision(value=Decision.NeedsCompletionEvidence)
    noIndependentResult when absent(value.independent_assessment) or absent(value.independence_review) -> ChooseDecision(value=Decision.NeedsCompletionEvidence)
    failed when value.failed_checks > 0 or value.unknown_checks > 0 or not ResultsCover(value) -> ChooseDecision(value=Decision.NeedsCompletionEvidence)
    otherwise -> ChooseDecision(value=Decision.ConformancePlanReady)

rule FiveTargetsMatch:
  input expected List<Binding,5>
  input reviews List<DefinitionReview,5>
  expression length(expected) == 5 and length(reviews) == 5 and fold(expected,true,valid:Bool,target:Binding => valid and length(filter(expected,other:Binding => other.ref == target.ref)) == 1 and length(filter(reviews,review:DefinitionReview => review.target == target)) == 1)

rule Verified:
  input value Verification
  input subject Binding
  input scope Ref
  input cut Digest
  input predicate Ref
  expression value.subject == subject and value.scope == scope and value.cut == cut and value.predicate == predicate
rule ReviewsAtCut:
  input reviews List<DefinitionReview,64>
  input cut Digest
  expression fold(reviews,true,valid:Bool,item:DefinitionReview => valid and item.source_cut == cut)
rule ExactEdgesMapped:
  input value CompatibilityCase
  expression length(value.source_edges) == length(value.source_relations) and length(value.target_edges) == length(value.target_relations) and length(value.source_edges) == length(value.target_edges) and fold(value.source_edges,true,valid:Bool,edge:Binding => valid and length(filter(value.source_edges,x:Binding => x == edge)) == 1 and (length(filter(value.target_edges,x:Binding => x == edge)) == 1 or length(filter(value.relation_mappings,x:RelationMapping => x.source_edge == edge and length(filter(value.target_edges,y:Binding => y == x.target_edge)) == 1)) == 1)) and fold(value.target_edges,true,valid:Bool,edge:Binding => valid and length(filter(value.target_edges,x:Binding => x == edge)) == 1 and (length(filter(value.source_edges,x:Binding => x == edge)) == 1 or length(filter(value.relation_mappings,x:RelationMapping => x.target_edge == edge and length(filter(value.source_edges,y:Binding => y == x.source_edge)) == 1)) == 1))
rule CanonicalPermission:
  input value PublicationCase
  expression match value.canonical_permission some(receipt) => Verified(receipt,value.bundle,value.workspace,value.source_cut,Ref("canonical-publication")) else false
rule PublicationObserved:
  input value PublicationCase
  expression match value.observed_receipt some(receipt) => receipt.operation == value.operation_ref and receipt.selector_before == value.expected_selector and receipt.selected_source == value.snapshot.source and receipt.bundle == value.bundle and receipt.predecessor == value.expected_registry and receipt.postimage == value.proposed_registry and Verified(receipt.evidence,receipt.postimage,value.workspace,value.source_cut,Ref("observed-publication")) else false
rule LifecycleBound:
  input value LifecycleCase
  expression value.current == value.reviewed_current and value.operation == value.reviewed_operation and value.intent == value.reviewed_intent and value.successor == value.reviewed_successor and value.transition_review.issuer == value.expected_owner and Verified(value.transition_review,value.proposal,value.scope,value.source_cut,Ref("lifecycle-review")) and Verified(value.impact_review,value.proposal,value.scope,value.source_cut,Ref("impact-closure"))
rule LifecyclePermission:
  input value LifecycleCase
  expression match value.permission_review some(receipt) => Verified(receipt,value.proposal,value.scope,value.source_cut,Ref("lifecycle-permission")) else false
rule SpecificationsCover:
  input obligations List<Ref,100>
  input specifications List<CheckSpecification,100>
  expression length(obligations) > 0 and length(obligations) == length(specifications) and fold(obligations,true,valid:Bool,item:Ref => valid and length(filter(obligations,x:Ref => x == item)) == 1 and length(filter(specifications,x:CheckSpecification => x.obligation == item)) == 1)
rule EntryBound:
  input value ConstructionCompletion
  expression value.entry_receipt.entry == value.expected_entry and value.assessed_entry == value.expected_entry and Verified(value.entry_receipt.evidence,value.entry_receipt.entry,Ref("construction"),value.expected_source_cut,Ref("construction-entry")) and SpecificationsCover(value.required_checks,value.entry_receipt.specifications)
rule ResultsCover:
  input value ConstructionCompletion
  expression match value.output_manifest some(output) => Verified(value.assessment,output,Ref("construction"),value.expected_source_cut,Ref("independent-conformance")) and length(value.results) == length(value.entry_receipt.specifications) and fold(value.entry_receipt.specifications,true,valid:Bool,spec:CheckSpecification => valid and length(filter(value.results,x:CheckResult => x.specification == spec and x.output == output and x.passed)) == 1) else false

rule AdmissionSnapshotMatches:
  input value PublicationCase
  expression value.snapshot.bundle == value.bundle and value.snapshot.operation == value.operation_ref and value.snapshot.workspace == value.workspace and value.snapshot.cut == value.source_cut and value.snapshot.expected_head == value.native_head and value.snapshot.predecessor == value.expected_registry and value.snapshot.expected_selector == value.expected_selector and value.snapshot.registry == value.proposed_registry and value.snapshot.targets == value.expected_targets and value.snapshot.draft_only and Verified(value.snapshot.readers,value.snapshot.source,value.workspace,value.source_cut,Ref("qualified-readers")) and Verified(value.snapshot.migration,value.snapshot.registry,value.workspace,value.source_cut,Ref("registry-migration"))

rule SelectionPartition:
  input value ConstructionCase
  expression value.selected_targets == value.definition_targets and length(value.selected_targets) == length(value.admitted_targets) + length(value.review_targets) and fold(value.selected_targets,true,valid:Bool,target:Binding => valid and length(filter(value.selected_targets,x:Binding => x.ref == target.ref)) == 1 and length(filter(value.admitted_targets,x:Binding => x == target)) + length(filter(value.review_targets,x:Binding => x == target)) == 1)

rule CompletionObserved:
  input value JoinObservation
  expression (value.native_outcome == NativeOutcome.Committed or value.native_outcome == NativeOutcome.Replayed) and (value.publication_outcome == NativeOutcome.Committed or value.publication_outcome == NativeOutcome.Replayed) and match value.terminal_receipt some(receipt) => receipt.subject.ref == value.run_ref and Verified(receipt,receipt.subject,value.workspace,value.source_cut,Ref("join-completed")) else false
rule PublicationHistoryObserved:
  input value JoinObservation
  expression match value.published_snapshot some(snapshot) => match value.published_verification some(receipt) => (value.publication_outcome == NativeOutcome.Committed or value.publication_outcome == NativeOutcome.Replayed) and Verified(receipt,snapshot,value.workspace,value.source_cut,Ref("observed-publication")) else false else false

rule RefusalObserved:
  input value JoinObservation
  expression value.native_outcome != NativeOutcome.Unknown and value.publication_outcome != NativeOutcome.Unknown and value.publication_outcome != NativeOutcome.Committed and value.publication_outcome != NativeOutcome.Replayed and (value.native_outcome == NativeOutcome.Refused or value.publication_outcome == NativeOutcome.Refused) and match value.terminal_receipt some(receipt) => receipt.subject.ref == value.run_ref and Verified(receipt,receipt.subject,value.workspace,value.source_cut,Ref("join-refused")) else false

rule RegistryEffectsClosed:
  input value RegistryClosureCase
  expression value.provenance_verified and length(value.expected) == length(value.observed) and length(value.effects_match) == length(value.expected) and fold(value.effects_match,true,ok:Bool,item:Bool => ok and item) and fold(value.expected,true,ok:Bool,item:Ref => ok and length(filter(value.expected,x:Ref => x == item)) == 1 and length(filter(value.observed,x:Ref => x == item)) == 1)
rule ReviewCanCarryForward:
  input value ReviewCarryForward
  expression value.original_target == value.current_target and value.original_receipt == value.current_receipt and value.original_owner == value.current_owner and value.original_scope == value.current_scope and value.accepted and value.authority_current
rule CarriedConstructionValid:
  input value CarriedConstructionCase
  expression SpecificationsCover(value.current_obligations,value.current_specifications) and ConstructionEntryPlan(value.original) == Decision.GenerationEntryPlanReady and length(value.reviews) == length(value.original.definitions) and fold(value.original.definitions,true,ok:Bool,item:DefinitionReview => ok and length(filter(value.reviews,review:ReviewCarryForward => review.original_target == item.target and review.original_cut == item.source_cut and review.current_cut == value.current_cut and ReviewCanCarryForward(review))) == 1)
rule RuntimeResourcesReady:
  input value RuntimeReadiness
  expression value.selected and value.implementation_current and value.snapshot_verified and value.native_verified and value.journal_verified and value.qualifications_verified and value.source_current
