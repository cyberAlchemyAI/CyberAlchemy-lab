{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed mixed-version Definition Registry v2; not admitted",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type_ref",
    "expected_predecessor",
    "entries",
    "current_lookup",
    "publication_decision"
  ],
  "properties": {
    "schema_version": {
      "const": "cyberalchemy-lab-definition-registry/v2"
    },
    "artifact_type_ref": {
      "const": "cal.artifact-type.definition-registry/v2"
    },
    "expected_predecessor": {
      "$ref": "#/$defs/binding"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "definition_id",
          "version",
          "body",
          "carrier",
          "schema",
          "generator",
          "owner_disposition",
          "standing",
          "projection",
          "predecessor"
        ],
        "properties": {
          "definition_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "$ref": "#/$defs/binding"
          },
          "carrier": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "descriptor",
              "admission"
            ],
            "properties": {
              "ref": {
                "enum": [
                  "cal.artifact-type.definition/v1",
                  "cal.artifact-type.definition/v2"
                ]
              },
              "descriptor": {
                "$ref": "#/$defs/binding"
              },
              "admission": {
                "$ref": "#/$defs/binding"
              }
            }
          },
          "schema": {
            "$ref": "#/$defs/binding"
          },
          "generator": {
            "$ref": "#/$defs/binding"
          },
          "owner_disposition": {
            "$ref": "#/$defs/binding"
          },
          "standing": {
            "enum": [
              "admitted-current",
              "admitted-retained",
              "withdrawn"
            ]
          },
          "projection": {
            "$ref": "#/$defs/binding"
          },
          "predecessor": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/binding"
              }
            ]
          }
        }
      }
    },
    "current_lookup": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "publication_decision": {
      "$ref": "#/$defs/binding"
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
