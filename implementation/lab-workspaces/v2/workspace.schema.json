{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cyberalchemy:lab-workspace:v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model_version",
    "workspace_ref",
    "revision",
    "kind",
    "primary_subject",
    "linked_project_refs",
    "related_product_refs",
    "purpose",
    "scope_ref",
    "home",
    "areas",
    "goals",
    "runtime_selection",
    "authority_effect",
    "model_binding_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "lab-workspace/v2"
    },
    "model_version": {
      "const": "lab-workspace-model/v2"
    },
    "workspace_ref": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "product",
        "project"
      ]
    },
    "primary_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "key",
        "ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "product",
            "project"
          ]
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "linked_project_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "related_product_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "scope_ref": {
      "type": "string",
      "minLength": 1
    },
    "home": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "path"
      ],
      "properties": {
        "mode": {
          "enum": [
            "hosted",
            "repository-root",
            "external"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "areas": {
      "const": [
        "product",
        "project",
        "work",
        "authority",
        "ontology",
        "architecture",
        "implementation",
        "docs"
      ]
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "goal_ref",
          "project_ref"
        ],
        "properties": {
          "goal_ref": {
            "type": "string",
            "minLength": 1
          },
          "project_ref": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string"
          },
          "membership": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "runtime_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "placement",
        "runtime_ref",
        "behavior",
        "specialization_ref"
      ],
      "properties": {
        "placement": {
          "enum": [
            "shared",
            "dedicated"
          ]
        },
        "runtime_ref": {
          "type": "string",
          "minLength": 1
        },
        "behavior": {
          "enum": [
            "inherited",
            "specialized"
          ]
        },
        "specialization_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "authority_effect": {
      "const": "none"
    },
    "model_binding_ref": {
      "type": "string",
      "minLength": 1
    }
  }
}
