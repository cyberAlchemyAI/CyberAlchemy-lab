{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/formalization/contract-fixture-matrix/v1-candidate",
  "title": "Formalization Contract Fixture Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_set_id", "evidence_origin", "macros", "bases", "cases", "authority_effect", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "domainspec-v2.formalization-contract-fixtures/v1-candidate"},
    "fixture_set_id": {"type": "string", "minLength": 1},
    "evidence_origin": {"const": "synthetic-validator-input"},
    "macros": {"type": "object"},
    "bases": {"type": "object"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}},
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"const": "schema-and-cross-contract-validation-only-no-domain-provider-or-runtime-claim"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "case": {"type": "object", "additionalProperties": false, "required": ["case_id", "class", "schema_path", "base_ref", "mutation", "expected_valid", "expected_error_contains"], "properties": {"case_id": {"$ref": "#/$defs/text"}, "class": {"enum": ["positive", "exact-cause-negative", "stale", "unknown", "duplicate", "malformed", "timeout", "ceiling"]}, "schema_path": {"$ref": "#/$defs/text"}, "base_ref": {"$ref": "#/$defs/text"}, "mutation": {"oneOf": [{"$ref": "#/$defs/mutation"}, {"type": "null"}]}, "expected_valid": {"type": "boolean"}, "expected_error_contains": {"type": ["string", "null"]}}},
    "mutation": {"type": "object", "additionalProperties": false, "required": ["operation", "path"], "properties": {"operation": {"enum": ["set", "delete"]}, "path": {"type": "array", "minItems": 1, "items": {"type": ["string", "integer"]}}, "value": {}}}
  }
}
