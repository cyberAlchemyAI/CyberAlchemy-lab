{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/formalization/definition-index/v1-candidate",
  "title": "DomainSpec Formalization Definition Index Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "index_id", "status", "registry_ref", "entries", "authority_effect", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "domainspec-v2.formalization-definition-index/v1-candidate"},
    "index_id": {"const": "domainspec-v2.formalization.critical-terms-index"},
    "status": {"const": "candidate"},
    "registry_ref": {"$ref": "#/$defs/exactRef"},
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}},
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"$ref": "#/$defs/text"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "textSet": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "exactRef": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes", "current"], "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/digest"}, "size_bytes": {"type": "integer", "minimum": 1}, "current": {"const": true}}},
    "entry": {"type": "object", "additionalProperties": false, "required": ["definition_id", "term", "aliases", "status", "definition_pointer"], "properties": {"definition_id": {"type": "string", "pattern": "^DSF-D[0-9]{2}$"}, "term": {"$ref": "#/$defs/text"}, "aliases": {"$ref": "#/$defs/textSet"}, "status": {"const": "candidate"}, "definition_pointer": {"type": "string", "pattern": "^#/definitions/[0-9]+$"}}}
  }
}
