{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/formalization/authoring-session/v1-candidate",
  "title": "Formalization Authoring Session Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "subject", "owner", "state", "current_question_id", "coordination", "transcript", "draft_outputs", "unresolved", "authority_effect", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "domainspec-v2.authoring-session/v1-candidate"},
    "session_id": {"$ref": "#/$defs/text"},
    "subject": {"$ref": "#/$defs/text"},
    "owner": {"$ref": "#/$defs/text"},
    "state": {"enum": ["started", "questions-open", "meaning-ready", "interpretation-ready", "claim-draft", "claim-source-ready", "route-assessed", "projection-ready", "obligations-ready", "provider-complete", "evidence-joined", "revise", "blocked", "closed"]},
    "current_question_id": {"type": ["string", "null"]},
    "coordination": {"type": "object", "additionalProperties": false, "required": ["mode", "visible_in", "canonical_store", "ipc_required"], "properties": {"mode": {"const": "shared-json-state"}, "visible_in": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"enum": ["cli", "chat"]}}, "canonical_store": {"const": "this-document"}, "ipc_required": {"const": false}}},
    "transcript": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "draft_outputs": {"type": "array", "items": {"$ref": "#/$defs/exactRef"}},
    "unresolved": {"$ref": "#/$defs/textSet"},
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"$ref": "#/$defs/text"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "textSet": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "exactRef": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes"], "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/digest"}, "size_bytes": {"type": "integer", "minimum": 0}}},
    "entry": {"type": "object", "additionalProperties": false, "required": ["sequence", "kind", "question_id", "text", "visible_in"], "properties": {"sequence": {"type": "integer", "minimum": 0}, "kind": {"enum": ["question", "answer", "decision", "notice"]}, "question_id": {"type": ["string", "null"]}, "text": {"$ref": "#/$defs/text"}, "visible_in": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"enum": ["cli", "chat"]}}}}
  }
}
