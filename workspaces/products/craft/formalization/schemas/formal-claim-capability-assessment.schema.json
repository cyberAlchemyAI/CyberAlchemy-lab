{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/formalization/formal-claim-capability-assessment/v1-candidate",
  "title": "FormalClaim Capability Assessment Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assessment_id", "owner", "formal_claim_ref", "policy_ref", "classification", "needs_formal_reasons", "admitted_for_tde_execution", "provider_route", "currentness", "authority_effect", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "domainspec-v2.formal-claim-capability-assessment/v1-candidate"},
    "assessment_id": {"$ref": "#/$defs/text"},
    "owner": {"const": "validation-governance"},
    "formal_claim_ref": {"$ref": "#/$defs/exactRef"},
    "policy_ref": {"$ref": "#/$defs/exactRef"},
    "classification": {"enum": ["executable-bounded", "solver-admissible", "proof-provider-required", "unsupported", "indeterminate"]},
    "needs_formal_reasons": {"type": "array", "uniqueItems": true, "items": {"enum": ["missing-formal-statement", "outside-executable-profile", "implementation-oracle-dependence", "unsupported-theory-or-language", "indeterminate-classification"]}},
    "admitted_for_tde_execution": {"type": "boolean"},
    "provider_route": {"enum": ["tde", "evf-solver", "evf-theorem", "evf-model-checker", "evf-relational", "evf-datalog", "none"]},
    "currentness": {"enum": ["current", "stale"]},
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"const": "classification-and-routing-only-no-execution-claim"}
  },
  "allOf": [
    {"if": {"properties": {"admitted_for_tde_execution": {"const": true}}}, "then": {"properties": {"classification": {"const": "executable-bounded"}, "provider_route": {"const": "tde"}, "currentness": {"const": "current"}}}}
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "exactRef": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes"], "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/digest"}, "size_bytes": {"type": "integer", "minimum": 0}, "current": {"type": "boolean"}}}
  }
}
