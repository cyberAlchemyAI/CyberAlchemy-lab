{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/formalization/projection/v1-candidate",
  "title": "Formalization Projection Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "projection_id", "owner", "formal_claim_ref", "capability_assessment_ref", "obligation_set_ref", "purpose", "target_profile_ref", "source_semantics_digest", "projected_semantics_digest", "domain_and_bound", "preservation_kind", "currentness", "authority_effect", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "domainspec-v2.formalization-projection/v1-candidate"},
    "projection_id": {"$ref": "#/$defs/text"},
    "owner": {"const": "projects/domainspec-v2/formalization"},
    "formal_claim_ref": {"$ref": "#/$defs/exactRef"},
    "capability_assessment_ref": {"$ref": "#/$defs/exactRef"},
    "obligation_set_ref": {"oneOf": [{"$ref": "#/$defs/exactRef"}, {"type": "null"}]},
    "purpose": {"enum": ["tde-executable-slice", "solver-query", "theorem-provider", "model-check", "relational-check", "datalog-check"]},
    "target_profile_ref": {"$ref": "#/$defs/exactRef"},
    "source_semantics_digest": {"$ref": "#/$defs/digest"},
    "projected_semantics_digest": {"$ref": "#/$defs/digest"},
    "domain_and_bound": {"$ref": "#/$defs/text"},
    "preservation_kind": {"enum": ["exact-equivalent", "counterexample-preserving", "witness-preserving", "one-way-implication", "unsupported"]},
    "currentness": {"enum": ["current", "stale"]},
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"$ref": "#/$defs/text"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "exactRef": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes"], "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/digest"}, "size_bytes": {"type": "integer", "minimum": 0}, "current": {"type": "boolean"}}}
  }
}
