{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/formalization/formal-claim-envelope/v1-candidate",
  "title": "FormalClaim Definition Envelope Candidate",
  "description": "A deterministic, definition-complete consumer view of one FormalClaim and its explicitly bound canonical definitions. It is derived and never becomes definition authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "envelope_id",
    "formal_claim_ref",
    "definition_binding_ref",
    "definition_authority_ref",
    "definition_closure",
    "resolved_definitions",
    "materialization_policy",
    "reference_policy",
    "authority_effect",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "domainspec-v2.formal-claim-envelope/v1-candidate"},
    "envelope_id": {"$ref": "#/$defs/text"},
    "formal_claim_ref": {"$ref": "#/$defs/exactCurrentRef"},
    "definition_binding_ref": {"$ref": "#/$defs/exactCurrentRef"},
    "definition_authority_ref": {"$ref": "#/$defs/exactCurrentRef"},
    "definition_closure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition_ids", "canonicalization", "digest_algorithm", "digest"],
      "properties": {
        "definition_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "canonicalization": {"const": "domainspec-json-keysort-v1"},
        "digest_algorithm": {"const": "sha256"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "resolved_definitions": {"type": "array", "minItems": 1, "items": {"type": "object", "minProperties": 1}},
    "materialization_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "selection", "name_inference", "derived_not_authoritative"],
      "properties": {
        "source": {"const": "definition_binding_ref"},
        "selection": {"const": "explicit-uses_definition-edges"},
        "name_inference": {"const": "forbidden"},
        "derived_not_authoritative": {"const": true}
      }
    },
    "reference_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["copied_external_references", "dereference_required_for_claim_meaning", "unresolved_external_references_expand_claim"],
      "properties": {
        "copied_external_references": {"const": "retained-as-opaque-traceability-metadata"},
        "dereference_required_for_claim_meaning": {"const": false},
        "unresolved_external_references_expand_claim": {"const": false}
      }
    },
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"$ref": "#/$defs/text"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "exactCurrentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "current"],
      "properties": {
        "path": {"$ref": "#/$defs/text"},
        "sha256": {"$ref": "#/$defs/digest"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "current": {"const": true}
      }
    }
  }
}
