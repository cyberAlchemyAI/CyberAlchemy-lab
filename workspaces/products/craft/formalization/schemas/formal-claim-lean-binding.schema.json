{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/formalization/formal-claim-lean-binding/v1-candidate",
  "title": "FormalClaim Lean Binding Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "binding_id", "owner", "formal_claim_ref", "lean_profile_ref", "lean_environment_ref", "canonical_proposition_semantic_digest", "lean_statement_ref", "preservation_binding_ref", "currentness", "authority_effect", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "domainspec-v2.formal-claim-lean-binding/v1-candidate"},
    "binding_id": {"$ref": "#/$defs/text"},
    "owner": {"const": "projects/domainspec-v2/formalization"},
    "formal_claim_ref": {"$ref": "#/$defs/exactRef"},
    "lean_profile_ref": {"$ref": "#/$defs/exactRef"},
    "lean_environment_ref": {"$ref": "#/$defs/exactRef"},
    "canonical_proposition_semantic_digest": {"$ref": "#/$defs/digest"},
    "lean_statement_ref": {"$ref": "#/$defs/exactRef"},
    "preservation_binding_ref": {"$ref": "#/$defs/exactRef"},
    "currentness": {"enum": ["current", "stale"]},
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"const": "formalclaim-to-lean-statement-binding-only-no-theorem-result"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "exactRef": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes", "current"], "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/digest"}, "size_bytes": {"type": "integer", "minimum": 0}, "current": {"type": "boolean"}}}
  }
}
