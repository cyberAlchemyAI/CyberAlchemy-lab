{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/formalization-ontology/v1",
  "title": "DomainSpec Formalization Ontology",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_ref",
    "ontology_id",
    "label",
    "ontology_type",
    "ontology_type_alias",
    "branches",
    "status",
    "visibility",
    "authority_effect",
    "package_ref",
    "model_origin",
    "model_delta",
    "scope",
    "nodes",
    "relations",
    "views",
    "invariants",
    "residue",
    "forbidden_collapses"
  ],
  "properties": {
    "schema_version": {
      "const": "domainspec-v2.formalization-ontology/v1"
    },
    "schema_ref": {
      "const": "../schemas/formalization-ontology.schema.json"
    },
    "ontology_id": {
      "const": "domainspec-v2.formalization-bridge"
    },
    "label": {"$ref": "#/$defs/nonEmptyString"},
    "ontology_type": {"const": "business-system-bridge"},
    "ontology_type_alias": {"const": "formalization-bridge"},
    "branches": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["business", "system", "bridge"]}
    },
    "status": {"const": "candidate"},
    "visibility": {"const": "private"},
    "authority_effect": {"const": "none"},
    "package_ref": {"const": "../formalization-package.json"},
    "model_origin": {"$ref": "#/$defs/modelOrigin"},
    "model_delta": {"$ref": "#/$defs/modelDelta"},
    "scope": {"$ref": "#/$defs/scope"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/node"}
    },
    "relations": {
      "type": "array",
      "items": {"$ref": "#/$defs/relation"}
    },
    "views": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/view"}
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/invariant"}
    },
    "residue": {
      "type": "array",
      "items": {"$ref": "#/$defs/residue"}
    },
    "forbidden_collapses": {"$ref": "#/$defs/stringSet"}
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_confidence", "commitment_confidence"],
      "properties": {
        "evidence_confidence": {"enum": ["low", "medium", "high"]},
        "commitment_confidence": {"enum": ["low", "medium", "high"]}
      }
    },
    "challengeContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challenge_response",
        "valid_challenge_modes",
        "contradiction_edges",
        "validation_edges",
        "owner_route",
        "resolution_gate",
        "blocking_questions",
        "challenge_residue_route"
      ],
      "properties": {
        "challenge_response": {"$ref": "#/$defs/nonEmptyString"},
        "valid_challenge_modes": {"$ref": "#/$defs/stringSet"},
        "contradiction_edges": {"$ref": "#/$defs/stringSet"},
        "validation_edges": {"$ref": "#/$defs/stringSet"},
        "owner_route": {"$ref": "#/$defs/nonEmptyString"},
        "resolution_gate": {"$ref": "#/$defs/nonEmptyString"},
        "blocking_questions": {"$ref": "#/$defs/stringSet"},
        "challenge_residue_route": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formal", "plain_language", "domain_context"],
      "properties": {
        "formal": {"$ref": "#/$defs/nonEmptyString"},
        "plain_language": {"$ref": "#/$defs/nonEmptyString"},
        "domain_context": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concept_id",
        "label",
        "concept_role",
        "domain_role",
        "branch_affinity",
        "definition",
        "semantic_components",
        "source_refs",
        "owner_route",
        "candidate_status",
        "confidence",
        "challenge_contract",
        "residue",
        "forbidden_collapse"
      ],
      "properties": {
        "concept_id": {"$ref": "#/$defs/nonEmptyString"},
        "label": {"$ref": "#/$defs/nonEmptyString"},
        "concept_role": {
          "enum": [
            "authority object",
            "evidence object",
            "workflow object",
            "projection object",
            "residue object"
          ]
        },
        "domain_role": {"$ref": "#/$defs/nonEmptyString"},
        "branch_affinity": {"enum": ["business", "system", "bridge"]},
        "definition": {"$ref": "#/$defs/definition"},
        "semantic_components": {"$ref": "#/$defs/stringSet"},
        "source_refs": {"$ref": "#/$defs/stringSet"},
        "owner_route": {"$ref": "#/$defs/nonEmptyString"},
        "candidate_status": {
          "enum": ["candidate", "reviewed-candidate", "deferred", "blocked", "projected"]
        },
        "confidence": {"$ref": "#/$defs/confidence"},
        "challenge_contract": {"$ref": "#/$defs/challengeContract"},
        "residue": {"$ref": "#/$defs/stringSet"},
        "forbidden_collapse": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_id",
        "relation_type",
        "source_concept",
        "target_concept",
        "direction",
        "branch_view",
        "owner_route",
        "evidence_refs",
        "authority_effect",
        "value_effect",
        "cycle_policy",
        "forbidden_collapse"
      ],
      "properties": {
        "relation_id": {"$ref": "#/$defs/nonEmptyString"},
        "relation_type": {"$ref": "#/$defs/nonEmptyString"},
        "source_concept": {"$ref": "#/$defs/nonEmptyString"},
        "target_concept": {"$ref": "#/$defs/nonEmptyString"},
        "direction": {"enum": ["directed", "symmetric", "view-only"]},
        "branch_view": {"enum": ["business", "system", "bridge"]},
        "owner_route": {"$ref": "#/$defs/nonEmptyString"},
        "evidence_refs": {"$ref": "#/$defs/stringSet"},
        "authority_effect": {"const": "none"},
        "value_effect": {"enum": ["value-free", "value-constraining", "unknown"]},
        "cycle_policy": {"enum": ["acyclic", "cycle-permitted", "unknown"]},
        "forbidden_collapse": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view_id",
        "branch",
        "purpose",
        "node_refs",
        "relation_refs",
        "authority_effect"
      ],
      "properties": {
        "view_id": {"$ref": "#/$defs/nonEmptyString"},
        "branch": {"enum": ["business", "system", "bridge"]},
        "purpose": {"$ref": "#/$defs/nonEmptyString"},
        "node_refs": {"$ref": "#/$defs/stringSet"},
        "relation_refs": {"$ref": "#/$defs/stringSet"},
        "authority_effect": {"const": "none"}
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant_id", "statement", "formal", "status", "failure_result"],
      "properties": {
        "invariant_id": {"$ref": "#/$defs/nonEmptyString"},
        "statement": {"$ref": "#/$defs/nonEmptyString"},
        "formal": {"$ref": "#/$defs/nonEmptyString"},
        "status": {"const": "candidate"},
        "failure_result": {"enum": ["MODEL_BLOCK", "NON_PASS", "STALE"]}
      }
    },
    "residue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["residue_id", "description", "owner_route", "status", "blocks"],
      "properties": {
        "residue_id": {"$ref": "#/$defs/nonEmptyString"},
        "description": {"$ref": "#/$defs/nonEmptyString"},
        "owner_route": {"$ref": "#/$defs/nonEmptyString"},
        "status": {"const": "open"},
        "blocks": {"$ref": "#/$defs/stringSet"}
      }
    },
    "modelOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "model_role", "source_refs", "adoption_effect"],
      "properties": {
        "model_id": {"const": "cyberalchemy-v2.ontology-model"},
        "model_role": {"const": "structural-and-semantic-starting-model"},
        "source_refs": {"$ref": "#/$defs/stringSet"},
        "adoption_effect": {"const": "candidate-local-copy-only"}
      }
    },
    "modelDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adopted_contract_fields",
        "domain_extensions",
        "deferred_items",
        "forbidden_inferences"
      ],
      "properties": {
        "adopted_contract_fields": {"$ref": "#/$defs/stringSet"},
        "domain_extensions": {"$ref": "#/$defs/stringSet"},
        "deferred_items": {"$ref": "#/$defs/stringSet"},
        "forbidden_inferences": {"$ref": "#/$defs/stringSet"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in_scope", "out_of_scope"],
      "properties": {
        "in_scope": {"$ref": "#/$defs/stringSet"},
        "out_of_scope": {"$ref": "#/$defs/stringSet"}
      }
    }
  }
}
