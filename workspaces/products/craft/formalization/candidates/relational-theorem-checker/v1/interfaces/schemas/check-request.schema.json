{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/relational-checker/v1/check-request.schema.json",
  "title": "Check Request",
  "description": "Request contract for checkAddition; exact references must resolve through the local artifact store.",
  "x-layer": "L0",
  "x-status": "candidate-interface",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "relational-checker.check-request/v1-candidate"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "profile_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "graph_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "proposal_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "check_scope": {
      "enum": [
        "structural",
        "supported-semantics"
      ]
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "snapshot_ref",
    "profile_ref",
    "graph_ref",
    "proposal_ref",
    "check_scope"
  ]
}
