{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/relational-checker/v1/registry-snapshot.schema.json",
  "title": "Registry Snapshot",
  "description": "A finite registry declaration import; counts and hash bindings are recomputed by the consumer.",
  "x-layer": "L1",
  "x-status": "candidate-interface",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "relational-checker.registry-snapshot/v1-candidate"
    },
    "registry_id": {
      "type": "string",
      "minLength": 1
    },
    "baseline_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "kinds": {
      "type": "array",
      "items": {
        "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/relation-kind.schema.json"
      },
      "minItems": 1
    },
    "kind_count": {
      "type": "integer",
      "minimum": 1
    },
    "relation_specific_pair_count": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "schema_version",
    "registry_id",
    "baseline_ref",
    "kinds",
    "kind_count",
    "relation_specific_pair_count"
  ]
}
