{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/relational-checker/v1/evidence-bundle.schema.json",
  "title": "Evidence Bundle",
  "description": "Replayable untrusted submission with exact scope and dependencies; does not carry client readiness flags.",
  "x-layer": "L4",
  "x-status": "candidate-interface",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "relational-checker.evidence-bundle/v1-candidate"
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "profile_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "graph_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "proposal_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "obligation_set_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "proof_policy_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "dependency_refs": {
      "type": "array",
      "items": {
        "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "provider_result_refs": {
      "type": "array",
      "items": {
        "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "compatibility_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "authority_effect": {
      "const": "none"
    }
  },
  "required": [
    "schema_version",
    "bundle_id",
    "snapshot_ref",
    "profile_ref",
    "graph_ref",
    "proposal_ref",
    "obligation_set_ref",
    "proof_policy_ref",
    "evidence_refs",
    "dependency_refs",
    "provider_result_refs",
    "compatibility_ref",
    "authority_effect"
  ]
}
