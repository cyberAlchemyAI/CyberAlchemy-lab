{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/relational-checker/v1/baseline-snapshot.schema.json",
  "title": "Baseline Snapshot",
  "description": "Exact source snapshot with explicit source/effective-state overlay; no claim of perpetual freshness.",
  "x-layer": "L0",
  "x-status": "candidate-interface",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "relational-checker.baseline-snapshot/v1-candidate"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "registry_source": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/source-binding"
    },
    "source_bindings": {
      "type": "array",
      "items": {
        "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/source-binding"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "effective_state_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind_id": {
            "type": "string",
            "minLength": 1
          },
          "source_lifecycle": {
            "type": "string",
            "minLength": 1
          },
          "effective_lifecycle": {
            "type": "string",
            "minLength": 1
          },
          "admission_decision_id": {
            "type": "string",
            "minLength": 1
          },
          "registry_evidence": {
            "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/source-binding"
          }
        },
        "required": [
          "kind_id",
          "source_lifecycle",
          "effective_lifecycle",
          "admission_decision_id",
          "registry_evidence"
        ]
      },
      "minItems": 1
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "authority_effect": {
      "const": "none"
    }
  },
  "required": [
    "schema_version",
    "snapshot_id",
    "registry_source",
    "source_bindings",
    "effective_state_bindings",
    "captured_at",
    "authority_effect"
  ]
}
