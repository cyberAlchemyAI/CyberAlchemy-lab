{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/relational-checker/v1/change-proposal.schema.json",
  "title": "Change Proposal",
  "description": "Exact baseline and proposed graph/registry/rules identities; author labels are checked against an independent diff.",
  "x-layer": "L2",
  "x-status": "candidate-interface",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "relational-checker.change-proposal/v1-candidate"
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1
    },
    "baseline_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "base_graph_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "proposed_graph_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "base_registry_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "proposed_registry_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "base_rules_ref": {
      "anyOf": [
        {
          "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "proposed_rules_ref": {
      "anyOf": [
        {
          "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "author_change_labels": {
      "type": "array",
      "items": {
        "enum": [
          "instance-addition",
          "kind-addition",
          "endpoint-pair-change",
          "qualifier-change",
          "rule-change",
          "identity-mapping-change"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "requested_claims": {
      "type": "array",
      "items": {
        "enum": [
          "selected-data-compatibility",
          "invariant-preservation",
          "model-conservativity",
          "protected-lineage",
          "non-entailment"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "authority_effect": {
      "const": "none"
    }
  },
  "required": [
    "schema_version",
    "proposal_id",
    "baseline_ref",
    "base_graph_ref",
    "proposed_graph_ref",
    "base_registry_ref",
    "proposed_registry_ref",
    "base_rules_ref",
    "proposed_rules_ref",
    "author_change_labels",
    "requested_claims",
    "authority_effect"
  ]
}
