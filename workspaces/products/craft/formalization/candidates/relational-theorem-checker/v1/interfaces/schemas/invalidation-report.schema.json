{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/relational-checker/v1/invalidation-report.schema.json",
  "title": "Invalidation Report",
  "description": "Changed dependency identities invalidate exactly scoped evidence; currentness is assessed by the verifier.",
  "x-layer": "L1",
  "x-status": "candidate-interface",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "relational-checker.invalidation-report/v1-candidate"
    },
    "old_baseline_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "new_baseline_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "changed_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "before_ref": {
            "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
          },
          "after_ref": {
            "anyOf": [
              {
                "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "before_ref",
          "after_ref"
        ]
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "invalidated_evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "recheck_obligation_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "old_baseline_ref",
    "new_baseline_ref",
    "changed_dependencies",
    "invalidated_evidence_refs",
    "recheck_obligation_ids"
  ]
}
