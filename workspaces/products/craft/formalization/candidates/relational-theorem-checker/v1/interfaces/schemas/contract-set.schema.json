{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/relational-checker/v1/contract-set.schema.json",
  "title": "Contract Set",
  "description": "Machine-readable preconditions, postconditions, failure rules and DAG traceability.",
  "x-layer": "shared",
  "x-status": "candidate-interface",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "relational-checker.contract-set/v1-candidate"
    },
    "status": {
      "const": "candidate"
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "contract_id": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "type": "string",
            "minLength": 1
          },
          "task_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "input_schema": {
            "type": "string",
            "minLength": 1
          },
          "output_schema": {
            "type": "string",
            "minLength": 1
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "postconditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "failure_controls": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "trust_boundary": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "authority_effect": {
            "const": "none"
          }
        },
        "required": [
          "contract_id",
          "layer",
          "task_ids",
          "input_schema",
          "output_schema",
          "preconditions",
          "rules",
          "postconditions",
          "failure_controls",
          "trust_boundary",
          "authority_effect"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "status",
    "contracts"
  ]
}
