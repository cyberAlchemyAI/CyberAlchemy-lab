{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/relational-checker/v1/derivation-request.schema.json",
  "title": "Derivation Request",
  "description": "Request contract for checkDerivation; exact references must resolve through the local artifact store.",
  "x-layer": "L3",
  "x-status": "candidate-interface",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "relational-checker.derivation-request/v1-candidate"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "rule_set_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "base_facts_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "certificate_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "profile_ref",
    "rule_set_ref",
    "base_facts_ref",
    "certificate_ref"
  ]
}
