{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/relational-checker/v1/base-facts.schema.json",
  "title": "Base Facts",
  "description": "Finite ground facts and separately attested protected roots; root legitimacy needs a trusted adapter check.",
  "x-layer": "L3",
  "x-status": "candidate-interface",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "relational-checker.base-facts/v1-candidate"
    },
    "profile_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fact_id": {
            "type": "string",
            "minLength": 1
          },
          "atom": {
            "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/ground-atom"
          },
          "origin_ref": {
            "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
          }
        },
        "required": [
          "fact_id",
          "atom",
          "origin_ref"
        ]
      },
      "minItems": 1
    },
    "protected_roots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "root_id": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/protected-key"
          },
          "fact_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "trusted_adapter_attestation_ref": {
            "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
          }
        },
        "required": [
          "root_id",
          "key",
          "fact_id",
          "evidence_refs",
          "trusted_adapter_attestation_ref"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "profile_ref",
    "facts",
    "protected_roots"
  ]
}
