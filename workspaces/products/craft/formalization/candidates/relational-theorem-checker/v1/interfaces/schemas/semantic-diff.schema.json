{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/relational-checker/v1/semantic-diff.schema.json",
  "title": "Semantic Diff",
  "description": "Normalized exact changes computed by the consumer, not accepted from author labels.",
  "x-layer": "L2",
  "x-status": "candidate-interface",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "relational-checker.semantic-diff/v1-candidate"
    },
    "proposal_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "base_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "proposed_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "change_id": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "before_ref": {
            "anyOf": [
              {
                "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
              },
              {
                "type": "null"
              }
            ]
          },
          "after_ref": {
            "anyOf": [
              {
                "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "change_id",
          "classification",
          "location",
          "before_ref",
          "after_ref"
        ]
      },
      "minItems": 1
    },
    "unsupported_changes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "proposal_ref",
    "base_ref",
    "proposed_ref",
    "changes",
    "unsupported_changes"
  ]
}
