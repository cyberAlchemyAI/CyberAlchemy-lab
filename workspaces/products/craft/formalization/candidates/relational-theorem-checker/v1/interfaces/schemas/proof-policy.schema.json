{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/relational-checker/v1/proof-policy.schema.json",
  "title": "Proof Policy",
  "description": "Pin toolchain, isolate untrusted submissions and audit exact statements, dependencies and transitive axioms.",
  "x-layer": "L4",
  "x-status": "candidate-interface",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "relational-checker.proof-policy/v1-candidate"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "toolchain_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "allowed_axioms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "required_dependency_refs": {
      "type": "array",
      "items": {
        "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "allow_sorry": {
      "const": false
    },
    "network_during_replay": {
      "const": false
    },
    "isolation": {
      "const": "submission-isolated"
    },
    "statement_equivalence": {
      "const": "exact-bound-required-statement"
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "toolchain_ref",
    "allowed_axioms",
    "required_dependency_refs",
    "allow_sorry",
    "network_during_replay",
    "isolation",
    "statement_equivalence"
  ]
}
