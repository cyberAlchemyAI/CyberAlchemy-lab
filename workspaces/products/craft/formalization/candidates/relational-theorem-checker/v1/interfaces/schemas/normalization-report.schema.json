{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/relational-checker/v1/normalization-report.schema.json",
  "title": "Normalization Report",
  "description": "Field-preservation projection, exact dependencies and remaining parser trust boundary.",
  "x-layer": "L0",
  "x-status": "candidate-interface",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "relational-checker.normalization-report/v1-candidate"
    },
    "input_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "profile_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "normal_form_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "source_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_pointer": {
            "type": "string",
            "minLength": 1
          },
          "target_pointer": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
          }
        },
        "required": [
          "source_pointer",
          "target_pointer",
          "source_ref"
        ]
      },
      "minItems": 1
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/diagnostic"
      },
      "minItems": 0
    },
    "parser_proof_status": {
      "enum": [
        "trusted",
        "proved",
        "unsupported"
      ]
    }
  },
  "required": [
    "schema_version",
    "input_ref",
    "profile_ref",
    "normal_form_ref",
    "source_mappings",
    "diagnostics",
    "parser_proof_status"
  ]
}
