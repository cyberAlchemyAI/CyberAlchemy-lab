{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/relational-checker/v1/closure-certificate.schema.json",
  "title": "Closure Certificate",
  "description": "Claimed least fixed point; all initial facts, every rule consequence and no unexplained facts must be checked.",
  "x-layer": "L3",
  "x-status": "candidate-interface",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "relational-checker.closure-certificate/v1-candidate"
    },
    "certificate_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "rule_set_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "base_facts_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "ground_universe": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "closure": {
      "type": "array",
      "items": {
        "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/ground-atom"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "derivation_refs": {
      "type": "array",
      "items": {
        "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "adequacy_statement_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    }
  },
  "required": [
    "schema_version",
    "certificate_id",
    "profile_ref",
    "rule_set_ref",
    "base_facts_ref",
    "ground_universe",
    "closure",
    "derivation_refs",
    "adequacy_statement_ref"
  ]
}
