{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/relational-checker/v1/relation-assertion.schema.json",
  "title": "Relation Assertion",
  "description": "Identified relation assertion. Dynamic qualifier validity is checked against the selected kind declaration.",
  "x-layer": "L0",
  "x-status": "candidate-interface",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "relational-checker.relation-assertion/v1-candidate"
    },
    "assertion_id": {
      "type": "string",
      "minLength": 1
    },
    "relation_kind_id": {
      "type": "string",
      "minLength": 1
    },
    "relation_kind_version": {
      "type": "string",
      "minLength": 1
    },
    "definition_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "source": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/node-ref"
    },
    "target": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/node-ref"
    },
    "qualifiers": {
      "type": "object",
      "description": "Intentional dynamic map; the selected kind's closed qualifier schema applies."
    }
  },
  "required": [
    "schema_version",
    "assertion_id",
    "relation_kind_id",
    "relation_kind_version",
    "definition_ref",
    "source",
    "target",
    "qualifiers"
  ]
}
