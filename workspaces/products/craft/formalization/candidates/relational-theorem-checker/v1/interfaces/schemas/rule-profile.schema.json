{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/relational-checker/v1/rule-profile.schema.json",
  "title": "Rule Profile",
  "description": "Finite positive function-free range-restricted profile with explicitly defined protected roots.",
  "x-layer": "L3",
  "x-status": "candidate-interface",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "relational-checker.rule-profile/v1-candidate"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "const": "finite-positive-function-free-range-restricted"
    },
    "ground_universe": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "protected_predicates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "predicate": {
            "type": "string",
            "minLength": 1
          },
          "argument_roles": {
            "const": [
              "targetVersion",
              "effect",
              "scope",
              "epoch"
            ]
          }
        },
        "required": [
          "predicate",
          "argument_roles"
        ]
      },
      "minItems": 1
    },
    "root_adapter_policy_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "semantics_statement_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "new_identity_generation": {
      "const": false
    },
    "external_fact_lookup": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "profile_id",
    "language",
    "ground_universe",
    "protected_predicates",
    "root_adapter_policy_ref",
    "semantics_statement_ref",
    "new_identity_generation",
    "external_fact_lookup"
  ]
}
