{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/relational-checker/v1/provider-result.schema.json",
  "title": "Provider Result",
  "description": "Raw provider execution separated from normalized verdict; exhausted bounded search is not theorem evidence.",
  "x-layer": "L4",
  "x-status": "candidate-interface",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "relational-checker.provider-result/v1-candidate"
    },
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "obligation_ref": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
    },
    "execution": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/execution"
    },
    "evidence_method": {
      "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/evidence-method"
    },
    "raw_output_ref": {
      "anyOf": [
        {
          "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/exact-ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "search_bounds": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "domain_size": {
              "type": "integer",
              "minimum": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "domain_size",
            "description"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "https://cyberalchemy.local/schemas/relational-checker/v1/common.schema.json#/$defs/diagnostic"
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "provider_id",
    "obligation_ref",
    "execution",
    "evidence_method",
    "raw_output_ref",
    "search_bounds",
    "diagnostics"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence_method": {
            "const": "bounded-search"
          }
        }
      },
      "then": {
        "properties": {
          "search_bounds": {
            "type": "object"
          }
        }
      }
    }
  ]
}
