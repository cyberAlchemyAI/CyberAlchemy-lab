{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/relational-checker/v1/normal-form-schema.json",
  "$defs": {
    "ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/ref"
        },
        "kind": {
          "enum": [
            "admission-transaction",
            "agent-capability",
            "agent-profile",
            "artifact-type",
            "capability-instance",
            "capability-realization-binding",
            "challenge-event",
            "classification-assignment",
            "communication-preference",
            "context",
            "context-profile",
            "contract",
            "decision",
            "definition",
            "delegation",
            "effect",
            "failure-assessment",
            "failure-control-binding",
            "failure-mode",
            "failure-occurrence",
            "generated-output",
            "governed-model",
            "improvement-target",
            "incident",
            "intent-resolution",
            "operational-lesson",
            "product-capability",
            "project-governance-event-history",
            "project-semantic-event-history",
            "project-state",
            "relation-kind"
          ]
        },
        "content_identity": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "ref",
        "kind",
        "content_identity"
      ],
      "additionalProperties": false
    },
    "assertion": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "relation.conforms-to"
            },
            "source": {
              "$ref": "#/$defs/ref"
            },
            "target": {
              "$ref": "#/$defs/ref"
            },
            "qualifiers": {
              "type": "object",
              "properties": {
                "conformance_evidence_refs": {
                  "minLength": 1,
                  "type": "string"
                },
                "conformance_scope": {
                  "minLength": 1,
                  "type": "string"
                },
                "exact_version_ref": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "conformance_scope",
                "exact_version_ref",
                "conformance_evidence_refs"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "kind",
            "source",
            "target",
            "qualifiers"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "relation.declares-effect-on"
            },
            "source": {
              "$ref": "#/$defs/ref"
            },
            "target": {
              "$ref": "#/$defs/ref"
            },
            "qualifiers": {
              "type": "object",
              "properties": {
                "effect_kind": {
                  "minLength": 1,
                  "type": "string"
                },
                "exact_target_version_ref": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "effect_kind",
                "exact_target_version_ref"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "kind",
            "source",
            "target",
            "qualifiers"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "relation.materializes-consequence"
            },
            "source": {
              "$ref": "#/$defs/ref"
            },
            "target": {
              "$ref": "#/$defs/ref"
            },
            "qualifiers": {
              "type": "object",
              "properties": {
                "application_receipt_ref": {
                  "minLength": 1,
                  "type": "string"
                },
                "consequence_role": {
                  "minLength": 1,
                  "type": "string"
                },
                "output_digest": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "application_receipt_ref",
                "consequence_role",
                "output_digest"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "kind",
            "source",
            "target",
            "qualifiers"
          ],
          "additionalProperties": false
        }
      ]
    },
    "assessment": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "conformance",
            "application-receipt"
          ]
        },
        "subject": {
          "$ref": "#/$defs/ref"
        },
        "target": {
          "$ref": "#/$defs/ref"
        },
        "scope": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "output_digest": {
          "type": "string"
        },
        "accepted": {
          "type": "boolean"
        }
      },
      "required": [
        "ref",
        "mode",
        "subject",
        "target",
        "scope",
        "role",
        "output_digest",
        "accepted"
      ],
      "additionalProperties": false
    },
    "root": {
      "type": "object",
      "properties": {
        "subject": {
          "$ref": "#/$defs/ref"
        },
        "decision": {
          "$ref": "#/$defs/ref"
        },
        "authority_evidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "subject",
        "decision",
        "authority_evidence"
      ],
      "additionalProperties": false
    },
    "graph": {
      "type": "object",
      "properties": {
        "graph_id": {
          "type": "string",
          "minLength": 1
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "assessments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assessment"
          }
        },
        "admission_roots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/root"
          }
        }
      },
      "required": [
        "graph_id",
        "nodes",
        "assertions",
        "assessments",
        "admission_roots"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "relational-checker.normal-form/v1"
    },
    "graph": {
      "$ref": "#/$defs/graph"
    },
    "addition": {
      "$ref": "#/$defs/assertion"
    }
  },
  "required": [
    "schema_version",
    "graph"
  ],
  "additionalProperties": false
}
