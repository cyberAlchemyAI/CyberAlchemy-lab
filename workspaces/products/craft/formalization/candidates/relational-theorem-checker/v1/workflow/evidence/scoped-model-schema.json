{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "relational.scoped-model-evidence/v1-candidate"
    },
    "proposal_identity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    }
  },
  "required": [
    "schema",
    "proposal_identity",
    "witness"
  ],
  "description": "Local successor binding raw registry-model or inference-model bytes. The actual claim and context are checked independently; this wrapper is not a theorem.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/relational-checker/scoped-model-schema.json"
}
