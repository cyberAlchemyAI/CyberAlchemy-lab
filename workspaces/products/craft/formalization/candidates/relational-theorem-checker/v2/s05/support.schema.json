{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "relational.source-support/v2"
    },
    "atom": {
      "type": "object",
      "properties": {
        "predicate": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "id",
            "version",
            "hash"
          ],
          "additionalProperties": false
        },
        "values": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "reference"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "id",
                  "version"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "epoch"
                  },
                  "value": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "kind",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "effect",
                      "scope",
                      "text"
                    ]
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "value"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "predicate",
        "values"
      ],
      "additionalProperties": false
    },
    "source_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "selected_graph_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profile_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "catalog_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "context_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "witness": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "conformance",
                "existential-conformance"
              ]
            },
            "assertion_id": {
              "type": "string",
              "minLength": 1
            },
            "assessment_token": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "assertion_id",
            "assessment_token"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "node-kind"
            },
            "node_ref": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "version"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "node_ref"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema",
    "atom",
    "source_identity",
    "selected_graph_identity",
    "profile_identity",
    "catalog_identity",
    "context_identity",
    "witness"
  ],
  "additionalProperties": false
}
