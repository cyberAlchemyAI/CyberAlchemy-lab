{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "relational.human-gate-review/v4",
  "$defs": {
    "binding": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "relational.human-gate-review/v4"
        },
        "gate": {
          "const": "R06"
        },
        "scope": {
          "const": "original-v1-pilot-meaning-diagnostics"
        },
        "review_manifest": {
          "$ref": "#/$defs/binding"
        },
        "reviewed_artifacts": {
          "type": "object",
          "properties": {
            "packet": {
              "$ref": "#/$defs/binding"
            },
            "matrix": {
              "$ref": "#/$defs/binding"
            },
            "pilot": {
              "$ref": "#/$defs/binding"
            },
            "audit": {
              "$ref": "#/$defs/binding"
            }
          },
          "required": [
            "packet",
            "matrix",
            "pilot",
            "audit"
          ],
          "additionalProperties": false
        },
        "answers": {
          "type": "object",
          "properties": {
            "meanings": {
              "enum": [
                "accepted",
                "revisions",
                "undecided"
              ]
            },
            "diagnostics": {
              "enum": [
                "accepted",
                "revisions",
                "undecided"
              ]
            }
          },
          "required": [
            "meanings",
            "diagnostics"
          ],
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "properties": {
            "source": {
              "const": "observed-direct-user-response"
            },
            "thread_id": {
              "type": "string",
              "minLength": 1
            },
            "message_anchor": {
              "type": "string",
              "minLength": 1
            },
            "quote": {
              "type": "string",
              "minLength": 1
            },
            "captured_at": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "source",
            "thread_id",
            "message_anchor",
            "quote",
            "captured_at"
          ],
          "additionalProperties": false
        },
        "capture_kind": {
          "enum": [
            "actual",
            "fixture"
          ]
        },
        "authority_effect": {
          "const": "none"
        },
        "application_authorized": {
          "const": false
        }
      },
      "required": [
        "schema",
        "gate",
        "scope",
        "review_manifest",
        "reviewed_artifacts",
        "answers",
        "provenance",
        "capture_kind",
        "authority_effect",
        "application_authorized"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "relational.human-gate-review/v4"
        },
        "gate": {
          "const": "G4"
        },
        "scope": {
          "const": "original-v1-l4-bounded-use"
        },
        "review_manifest": {
          "$ref": "#/$defs/binding"
        },
        "reviewed_artifacts": {
          "type": "object",
          "properties": {
            "packet": {
              "$ref": "#/$defs/binding"
            },
            "matrix": {
              "$ref": "#/$defs/binding"
            },
            "alignment": {
              "$ref": "#/$defs/binding"
            },
            "recommendation": {
              "$ref": "#/$defs/binding"
            }
          },
          "required": [
            "packet",
            "matrix",
            "alignment",
            "recommendation"
          ],
          "additionalProperties": false
        },
        "answers": {
          "type": "object",
          "properties": {
            "layers": {
              "enum": [
                "accepted",
                "revisions",
                "undecided"
              ]
            },
            "bounded_use": {
              "enum": [
                "accepted",
                "revisions",
                "undecided"
              ]
            }
          },
          "required": [
            "layers",
            "bounded_use"
          ],
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "properties": {
            "source": {
              "const": "observed-direct-user-response"
            },
            "thread_id": {
              "type": "string",
              "minLength": 1
            },
            "message_anchor": {
              "type": "string",
              "minLength": 1
            },
            "quote": {
              "type": "string",
              "minLength": 1
            },
            "captured_at": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "source",
            "thread_id",
            "message_anchor",
            "quote",
            "captured_at"
          ],
          "additionalProperties": false
        },
        "capture_kind": {
          "enum": [
            "actual",
            "fixture"
          ]
        },
        "authority_effect": {
          "const": "none"
        },
        "application_authorized": {
          "const": false
        }
      },
      "required": [
        "schema",
        "gate",
        "scope",
        "review_manifest",
        "reviewed_artifacts",
        "answers",
        "provenance",
        "capture_kind",
        "authority_effect",
        "application_authorized"
      ],
      "additionalProperties": false
    }
  ]
}
