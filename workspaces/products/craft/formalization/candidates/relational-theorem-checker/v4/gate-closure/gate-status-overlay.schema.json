{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "relational.gate-overlay-entry/v4",
  "$defs": {
    "binding": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schema": {
      "const": "relational.gate-overlay-entry/v4"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "previous": {
      "oneOf": [
        {
          "$ref": "#/$defs/binding"
        },
        {
          "type": "null"
        }
      ]
    },
    "base_plan": {
      "$ref": "#/$defs/binding"
    },
    "gate": {
      "enum": [
        "R06",
        "G4"
      ]
    },
    "receipt": {
      "$ref": "#/$defs/binding"
    },
    "authority_effect": {
      "const": "none"
    },
    "application_authorized": {
      "const": false
    }
  },
  "required": [
    "schema",
    "generation",
    "previous",
    "base_plan",
    "gate",
    "receipt",
    "authority_effect",
    "application_authorized"
  ],
  "additionalProperties": false
}
