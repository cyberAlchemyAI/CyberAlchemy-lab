{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "relational.gate-acceptance/v4",
  "$defs": {
    "binding": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schema": {
      "const": "relational.gate-acceptance/v4"
    },
    "task_id": {
      "enum": [
        "R06",
        "G4"
      ]
    },
    "validation_id": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "const": "accepted"
    },
    "review_mode": {
      "const": "Actual human assessment plus current candidate evidence audit"
    },
    "base_plan": {
      "$ref": "#/$defs/binding"
    },
    "review_manifest": {
      "$ref": "#/$defs/binding"
    },
    "human_feedback": {
      "$ref": "#/$defs/binding"
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "const": "pass"
          },
          "finding": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/binding"
            },
            "minItems": 1
          }
        },
        "required": [
          "criterion",
          "result",
          "finding",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 2
    },
    "failure_controls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "const": "pass"
          },
          "finding": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/binding"
            },
            "minItems": 1
          }
        },
        "required": [
          "criterion",
          "result",
          "finding",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 2
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/binding"
      },
      "minProperties": 3
    },
    "source_bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      },
      "minItems": 1
    },
    "implementation_bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      },
      "minItems": 1
    },
    "authority_effect": {
      "const": "none"
    },
    "application_authorized": {
      "const": false
    }
  },
  "required": [
    "schema",
    "task_id",
    "validation_id",
    "result",
    "review_mode",
    "base_plan",
    "review_manifest",
    "human_feedback",
    "criteria",
    "failure_controls",
    "artifacts",
    "source_bindings",
    "implementation_bindings",
    "authority_effect",
    "application_authorized"
  ],
  "additionalProperties": false
}
