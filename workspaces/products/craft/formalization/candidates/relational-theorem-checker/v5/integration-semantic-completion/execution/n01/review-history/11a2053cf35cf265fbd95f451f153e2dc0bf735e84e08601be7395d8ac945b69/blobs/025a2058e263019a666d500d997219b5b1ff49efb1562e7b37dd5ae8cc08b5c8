{
  "$id": "https://cyberalchemy.local/schemas/relation-kind/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "minLength": 1,
      "type": "string"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "kind": {
      "const": "relation-kind"
    },
    "lifecycle_state": {
      "enum": [
        "candidate",
        "active",
        "historical",
        "retired"
      ]
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "node_id": {
      "minLength": 1,
      "type": "string"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "allowed_endpoint_pairs": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "source_kind": {
                "minLength": 1,
                "type": "string"
              },
              "target_kind": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "source_kind",
              "target_kind"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "axis_id": {
          "minLength": 1,
          "type": "string"
        },
        "inverse_ref": {
          "minLength": 1,
          "type": "string"
        },
        "predicate": {
          "minLength": 1,
          "type": "string"
        },
        "qualifier_schema_ref": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "axis_id",
        "predicate",
        "inverse_ref",
        "qualifier_schema_ref",
        "allowed_endpoint_pairs"
      ],
      "type": "object"
    },
    "relation_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "counterpart_kind": {
            "enum": [
              "constitution",
              "decision",
              "relation-kind",
              "source"
            ]
          },
          "counterpart_ref": {
            "minLength": 1,
            "type": "string"
          },
          "direction": {
            "enum": [
              "source",
              "target"
            ]
          },
          "relation_kind_ref": {
            "enum": [
              "relation.declares-effect-on",
              "relation.governed-by",
              "relation.originates-from",
              "relation.successor-of"
            ]
          }
        },
        "required": [
          "relation_kind_ref",
          "direction",
          "counterpart_kind",
          "counterpart_ref"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "cyberalchemy-lab-relation-kind/v1"
    },
    "scope_ref": {
      "minLength": 1,
      "type": "string"
    },
    "successor_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "node_id",
    "kind",
    "name",
    "lifecycle_state",
    "authority_effect",
    "owner_ref",
    "scope_ref",
    "evidence_refs",
    "challenge_route",
    "successor_refs",
    "relation_refs",
    "payload",
    "claim_ceiling"
  ],
  "type": "object"
}
