{
  "$id": "https://cyberalchemy.local/schemas/agent-instance/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "minLength": 1,
      "type": "string"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "kind": {
      "const": "agent-instance"
    },
    "lifecycle_state": {
      "enum": [
        "candidate",
        "active",
        "historical",
        "retired"
      ]
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "node_id": {
      "minLength": 1,
      "type": "string"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "accountable_principal_ref": {
          "minLength": 1,
          "type": "string"
        },
        "agent_classification_assignment_ref": {
          "minLength": 1,
          "type": "string"
        },
        "capability_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "implementation_ref": {
          "minLength": 1,
          "type": "string"
        },
        "profile_ref": {
          "minLength": 1,
          "type": "string"
        },
        "session_ref": {
          "minLength": 1,
          "type": "string"
        },
        "started_at": {
          "minLength": 1,
          "type": "string"
        },
        "terminated_at": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "agent_classification_assignment_ref",
        "profile_ref",
        "implementation_ref",
        "capability_refs",
        "accountable_principal_ref",
        "session_ref",
        "started_at",
        "terminated_at"
      ],
      "type": "object"
    },
    "relation_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "counterpart_kind": {
            "enum": [
              "agent-action",
              "agent-capability",
              "agent-instance",
              "agent-profile",
              "agent-session",
              "challenge-event",
              "classification-value",
              "experiment-run",
              "policy",
              "principal",
              "research-run",
              "responsibility",
              "review",
              "role",
              "work"
            ]
          },
          "counterpart_ref": {
            "minLength": 1,
            "type": "string"
          },
          "direction": {
            "enum": [
              "source",
              "target"
            ]
          },
          "relation_kind_ref": {
            "enum": [
              "relation.acts-for",
              "relation.assigned-to",
              "relation.challenges",
              "relation.governed-by",
              "relation.has-capability",
              "relation.instance-of",
              "relation.member-of",
              "relation.performs",
              "relation.profiled-by",
              "relation.successor-of"
            ]
          }
        },
        "required": [
          "relation_kind_ref",
          "direction",
          "counterpart_kind",
          "counterpart_ref"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "cyberalchemy-lab-agent-instance/v1"
    },
    "scope_ref": {
      "minLength": 1,
      "type": "string"
    },
    "successor_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "node_id",
    "kind",
    "name",
    "lifecycle_state",
    "authority_effect",
    "owner_ref",
    "scope_ref",
    "evidence_refs",
    "challenge_route",
    "successor_refs",
    "relation_refs",
    "payload",
    "claim_ceiling"
  ],
  "type": "object"
}
