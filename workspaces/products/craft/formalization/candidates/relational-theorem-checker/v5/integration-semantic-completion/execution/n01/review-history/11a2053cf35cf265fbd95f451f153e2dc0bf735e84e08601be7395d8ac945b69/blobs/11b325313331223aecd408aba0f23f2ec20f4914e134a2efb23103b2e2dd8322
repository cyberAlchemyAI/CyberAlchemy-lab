{
  "$id": "https://cyberalchemy.local/schemas/challenge-contract/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "minLength": 1,
      "type": "string"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "kind": {
      "const": "challenge-contract"
    },
    "lifecycle_state": {
      "enum": [
        "candidate",
        "active",
        "historical",
        "retired"
      ]
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "node_id": {
      "minLength": 1,
      "type": "string"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "challengeable_subject_kinds": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "eligible_challenger_kinds": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "grounds": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "owner_route": {
          "minLength": 1,
          "type": "string"
        },
        "policy_ref": {
          "minLength": 1,
          "type": "string"
        },
        "required_evidence_kinds": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "resolution_gate_ref": {
          "minLength": 1,
          "type": "string"
        },
        "response_modes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "response_period": {
          "minLength": 1,
          "type": "string"
        },
        "unresolved_residue_route": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "policy_ref",
        "challengeable_subject_kinds",
        "eligible_challenger_kinds",
        "grounds",
        "required_evidence_kinds",
        "response_modes",
        "owner_route",
        "resolution_gate_ref",
        "response_period",
        "unresolved_residue_route"
      ],
      "type": "object"
    },
    "relation_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "counterpart_kind": {
            "enum": [
              "challenge-contract",
              "challenge-event",
              "failure-occurrence",
              "policy"
            ]
          },
          "counterpart_ref": {
            "minLength": 1,
            "type": "string"
          },
          "direction": {
            "enum": [
              "source",
              "target"
            ]
          },
          "relation_kind_ref": {
            "enum": [
              "relation.challenges",
              "relation.governed-by",
              "relation.successor-of",
              "relation.violates"
            ]
          }
        },
        "required": [
          "relation_kind_ref",
          "direction",
          "counterpart_kind",
          "counterpart_ref"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "cyberalchemy-lab-challenge-contract/v1"
    },
    "scope_ref": {
      "minLength": 1,
      "type": "string"
    },
    "successor_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "node_id",
    "kind",
    "name",
    "lifecycle_state",
    "authority_effect",
    "owner_ref",
    "scope_ref",
    "evidence_refs",
    "challenge_route",
    "successor_refs",
    "relation_refs",
    "payload",
    "claim_ceiling"
  ],
  "type": "object"
}
