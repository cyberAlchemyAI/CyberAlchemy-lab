{
  "$id": "https://cyberalchemy.local/schemas/agent-action/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "minLength": 1,
      "type": "string"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "kind": {
      "const": "agent-action"
    },
    "lifecycle_state": {
      "enum": [
        "candidate",
        "active",
        "historical",
        "retired"
      ]
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "node_id": {
      "minLength": 1,
      "type": "string"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "action_kind": {
          "minLength": 1,
          "type": "string"
        },
        "agent_instance_ref": {
          "minLength": 1,
          "type": "string"
        },
        "assignment_ref": {
          "minLength": 1,
          "type": "string"
        },
        "authority_evidence_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "implementation_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "input_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "output_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "posture": {
          "minLength": 1,
          "type": "string"
        },
        "receipt_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "residue_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "session_ref": {
          "minLength": 1,
          "type": "string"
        },
        "tool_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "agent_instance_ref",
        "session_ref",
        "assignment_ref",
        "action_kind",
        "posture",
        "input_refs",
        "output_refs",
        "tool_refs",
        "implementation_refs",
        "authority_evidence_refs",
        "receipt_refs",
        "residue_refs"
      ],
      "type": "object"
    },
    "relation_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "counterpart_kind": {
            "enum": [
              "agent-action",
              "agent-instance",
              "agent-reflection",
              "agent-session",
              "challenge-event",
              "classification-assignment",
              "classification-value",
              "definition",
              "drift-assessment",
              "evidence-set",
              "failure-assessment",
              "failure-occurrence",
              "feedback-record",
              "finding",
              "generated-output",
              "goal",
              "implementation",
              "improvement-signal",
              "incident",
              "lesson-application",
              "measurement-result",
              "method",
              "observation",
              "operational-lesson",
              "operational-observation",
              "policy",
              "product",
              "tool",
              "typed-relation",
              "work-outcome-assessment"
            ]
          },
          "counterpart_ref": {
            "minLength": 1,
            "type": "string"
          },
          "direction": {
            "enum": [
              "source",
              "target"
            ]
          },
          "relation_kind_ref": {
            "enum": [
              "relation.challenges",
              "relation.contributes-to",
              "relation.derives-from",
              "relation.evaluates",
              "relation.governed-by",
              "relation.instance-of",
              "relation.member-of",
              "relation.occurs-during",
              "relation.performs",
              "relation.produces",
              "relation.responds-to",
              "relation.successor-of",
              "relation.uses-method",
              "relation.uses-tool"
            ]
          }
        },
        "required": [
          "relation_kind_ref",
          "direction",
          "counterpart_kind",
          "counterpart_ref"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "cyberalchemy-lab-agent-action/v1"
    },
    "scope_ref": {
      "minLength": 1,
      "type": "string"
    },
    "successor_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "node_id",
    "kind",
    "name",
    "lifecycle_state",
    "authority_effect",
    "owner_ref",
    "scope_ref",
    "evidence_refs",
    "challenge_route",
    "successor_refs",
    "relation_refs",
    "payload",
    "claim_ceiling"
  ],
  "type": "object"
}
