{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "commitment_state": {
            "enum": [
              "committed",
              "revised"
            ]
          }
        },
        "required": [
          "commitment_state"
        ]
      },
      "then": {
        "properties": {
          "counterevidence_routes": {
            "minItems": 1
          },
          "evidence_routes": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "commitment_state": {
            "const": "revised"
          }
        },
        "required": [
          "commitment_state"
        ]
      },
      "then": {
        "properties": {
          "revision_history": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "commitment_state": {
            "const": "superseded"
          }
        },
        "required": [
          "commitment_state"
        ]
      },
      "then": {
        "properties": {
          "successor_refs": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "properties": {
    "assumptions": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "audience": {
      "pattern": "\\S",
      "type": "string"
    },
    "authority_effect": {
      "const": "none"
    },
    "boundaries": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "challenge_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "commitment_state": {
      "enum": [
        "draft",
        "committed",
        "revised",
        "retired",
        "superseded"
      ],
      "type": "string"
    },
    "counterevidence_routes": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "type": "array",
      "uniqueItems": true
    },
    "evidence_routes": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "type": "array",
      "uniqueItems": true
    },
    "first_order_principles": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "hypotheses": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidence_state": {
            "enum": [
              "untested",
              "supported",
              "challenged",
              "rejected"
            ],
            "type": "string"
          },
          "hypothesis_id": {
            "pattern": "\\S",
            "type": "string"
          },
          "statement": {
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "hypothesis_id",
          "statement",
          "evidence_state"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
    },
    "intended_outcomes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "outcome_id": {
            "pattern": "\\S",
            "type": "string"
          },
          "statement": {
            "pattern": "\\S",
            "type": "string"
          },
          "value_measure_refs": {
            "items": {
              "pattern": "\\S",
              "type": "string"
            },
            "maxItems": 100,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "outcome_id",
          "statement",
          "value_measure_refs"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
    },
    "kind": {
      "const": "product-thesis"
    },
    "node_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "participants": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "problem": {
      "pattern": "\\S",
      "type": "string"
    },
    "product_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "revision_criteria": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "revision_history": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "change_summary": {
            "pattern": "\\S",
            "type": "string"
          },
          "decision_ref": {
            "pattern": "\\S",
            "type": "string"
          },
          "evidence_refs": {
            "items": {
              "pattern": "\\S",
              "type": "string"
            },
            "maxItems": 100,
            "type": "array",
            "uniqueItems": true
          },
          "rationale": {
            "pattern": "\\S",
            "type": "string"
          },
          "revision_id": {
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "revision_id",
          "change_summary",
          "rationale",
          "decision_ref",
          "evidence_refs"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "type": "array"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "successor_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "type": "array",
      "uniqueItems": true
    },
    "value_mechanism": {
      "pattern": "\\S",
      "type": "string"
    },
    "value_proposition": {
      "pattern": "\\S",
      "type": "string"
    }
  },
  "required": [
    "assumptions",
    "audience",
    "authority_effect",
    "kind",
    "node_id",
    "owner_ref",
    "problem",
    "product_ref",
    "revision_criteria",
    "scope_ref",
    "status",
    "value_proposition",
    "participants",
    "value_mechanism",
    "first_order_principles",
    "intended_outcomes",
    "boundaries",
    "hypotheses",
    "evidence_routes",
    "counterevidence_routes",
    "owner_route",
    "commitment_state",
    "successor_refs",
    "revision_history",
    "challenge_route"
  ],
  "type": "object"
}
