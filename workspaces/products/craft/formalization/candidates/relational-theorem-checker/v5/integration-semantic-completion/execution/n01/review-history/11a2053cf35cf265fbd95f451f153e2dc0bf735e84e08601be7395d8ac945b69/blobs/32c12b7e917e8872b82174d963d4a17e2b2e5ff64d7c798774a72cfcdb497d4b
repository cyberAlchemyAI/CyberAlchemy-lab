{
  "$id": "https://cyberalchemy.local/schemas/ontology-view/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "minLength": 1,
      "type": "string"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "kind": {
      "const": "ontology-view"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "node_id": {
      "minLength": 1,
      "type": "string"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "consumer_ref": {
          "minLength": 1,
          "type": "string"
        },
        "cut_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "cut_ref": {
          "minLength": 1,
          "type": "string"
        },
        "exclusions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "expires_at": {
          "minLength": 1,
          "type": "string"
        },
        "freshness_at": {
          "minLength": 1,
          "type": "string"
        },
        "governance_join_policy_ref": {
          "minLength": 1,
          "type": "string"
        },
        "intended_use": {
          "minLength": 1,
          "type": "string"
        },
        "ontology_ref": {
          "minLength": 1,
          "type": "string"
        },
        "replay_source": {
          "const": false
        },
        "selected_edge_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "selected_node_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "selector_ref": {
          "minLength": 1,
          "type": "string"
        },
        "semantic_cursor": {
          "minimum": 1,
          "type": "integer"
        },
        "source_event_set_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "ontology_ref",
        "cut_ref",
        "cut_digest",
        "selector_ref",
        "consumer_ref",
        "intended_use",
        "selected_node_refs",
        "selected_edge_refs",
        "exclusions",
        "freshness_at",
        "expires_at",
        "source_event_set_digest",
        "semantic_cursor",
        "governance_join_policy_ref",
        "replay_source"
      ],
      "type": "object"
    },
    "record_state": {
      "enum": [
        "candidate",
        "admitted",
        "historical",
        "retired"
      ]
    },
    "schema_version": {
      "const": "cyberalchemy-lab-ontology-view/v1"
    },
    "scope_ref": {
      "minLength": 1,
      "type": "string"
    },
    "successor_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "node_id",
    "kind",
    "name",
    "record_state",
    "authority_effect",
    "owner_ref",
    "scope_ref",
    "evidence_refs",
    "challenge_route",
    "successor_refs",
    "payload",
    "claim_ceiling"
  ],
  "type": "object"
}
