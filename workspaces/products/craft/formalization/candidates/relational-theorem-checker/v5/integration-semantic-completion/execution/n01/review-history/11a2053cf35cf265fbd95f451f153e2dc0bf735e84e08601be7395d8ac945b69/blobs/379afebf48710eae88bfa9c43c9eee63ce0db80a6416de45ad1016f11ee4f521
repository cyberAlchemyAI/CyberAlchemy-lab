{
  "$id": "https://cyberalchemy.local/schemas/failure-assessment/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "minLength": 1,
      "type": "string"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "kind": {
      "const": "failure-assessment"
    },
    "lifecycle_state": {
      "enum": [
        "candidate",
        "active",
        "historical",
        "retired"
      ]
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "node_id": {
      "minLength": 1,
      "type": "string"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "cause_hypothesis_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "containment_posture": {
          "minLength": 1,
          "type": "string"
        },
        "impact_posture": {
          "minLength": 1,
          "type": "string"
        },
        "mode_assignment_ref": {
          "minLength": 1,
          "type": "string"
        },
        "mode_posture": {
          "minLength": 1,
          "type": "string"
        },
        "occurrence_posture": {
          "minLength": 1,
          "type": "string"
        },
        "occurrence_ref": {
          "minLength": 1,
          "type": "string"
        },
        "recovery_posture": {
          "minLength": 1,
          "type": "string"
        },
        "uncertainty_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "occurrence_ref",
        "mode_assignment_ref",
        "occurrence_posture",
        "mode_posture",
        "cause_hypothesis_refs",
        "impact_posture",
        "containment_posture",
        "recovery_posture",
        "uncertainty_refs"
      ],
      "type": "object"
    },
    "relation_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "counterpart_kind": {
            "enum": [
              "agent-action",
              "agent-reflection",
              "challenge-event",
              "decision",
              "evidence-set",
              "failure-assessment",
              "failure-occurrence",
              "feedback-record",
              "finding",
              "improvement-signal",
              "measurement-result",
              "observation",
              "operational-lesson",
              "operational-observation",
              "policy"
            ]
          },
          "counterpart_ref": {
            "minLength": 1,
            "type": "string"
          },
          "direction": {
            "enum": [
              "source",
              "target"
            ]
          },
          "relation_kind_ref": {
            "enum": [
              "relation.challenges",
              "relation.declares-effect-on",
              "relation.derives-from",
              "relation.evaluates",
              "relation.evidence-bears-on",
              "relation.governed-by",
              "relation.produces",
              "relation.successor-of"
            ]
          }
        },
        "required": [
          "relation_kind_ref",
          "direction",
          "counterpart_kind",
          "counterpart_ref"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "cyberalchemy-lab-failure-assessment/v1"
    },
    "scope_ref": {
      "minLength": 1,
      "type": "string"
    },
    "successor_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "node_id",
    "kind",
    "name",
    "lifecycle_state",
    "authority_effect",
    "owner_ref",
    "scope_ref",
    "evidence_refs",
    "challenge_route",
    "successor_refs",
    "relation_refs",
    "payload",
    "claim_ceiling"
  ],
  "type": "object"
}
