{
  "$id": "https://cyberalchemy.local/schemas/ontology-manifest/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "minLength": 1,
      "type": "string"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "kind": {
      "const": "ontology-manifest"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "node_id": {
      "minLength": 1,
      "type": "string"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "branch_policy": {
          "minLength": 1,
          "type": "string"
        },
        "challenge_contract_ref": {
          "minLength": 1,
          "type": "string"
        },
        "configuration_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "governance_history_ref": {
          "minLength": 1,
          "type": "string"
        },
        "ontology_definition_ref": {
          "minLength": 1,
          "type": "string"
        },
        "ontology_owner_ref": {
          "minLength": 1,
          "type": "string"
        },
        "ontology_ref": {
          "minLength": 1,
          "type": "string"
        },
        "ontology_version": {
          "minLength": 1,
          "type": "string"
        },
        "policy_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "projection_contract_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "relation_kind_registry_ref": {
          "minLength": 1,
          "type": "string"
        },
        "runtime_binding_ref": {
          "minLength": 1,
          "type": "string"
        },
        "semantic_history_ref": {
          "minLength": 1,
          "type": "string"
        },
        "state_model_ref": {
          "minLength": 1,
          "type": "string"
        },
        "subject_replay_source": {
          "const": false
        }
      },
      "required": [
        "ontology_ref",
        "ontology_version",
        "ontology_definition_ref",
        "ontology_owner_ref",
        "state_model_ref",
        "relation_kind_registry_ref",
        "policy_refs",
        "runtime_binding_ref",
        "projection_contract_refs",
        "branch_policy",
        "semantic_history_ref",
        "governance_history_ref",
        "challenge_contract_ref",
        "configuration_digest",
        "subject_replay_source"
      ],
      "type": "object"
    },
    "record_state": {
      "enum": [
        "candidate",
        "admitted",
        "historical",
        "retired"
      ]
    },
    "schema_version": {
      "const": "cyberalchemy-lab-ontology-manifest/v1"
    },
    "scope_ref": {
      "minLength": 1,
      "type": "string"
    },
    "successor_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "node_id",
    "kind",
    "name",
    "record_state",
    "authority_effect",
    "owner_ref",
    "scope_ref",
    "evidence_refs",
    "challenge_route",
    "successor_refs",
    "payload",
    "claim_ceiling"
  ],
  "type": "object"
}
