{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "claim_ceiling": {
      "pattern": "\\S",
      "type": "string"
    },
    "identity_scope": {
      "pattern": "\\S",
      "type": "string"
    },
    "kind": {
      "const": "person-reference"
    },
    "lifecycle_state": {
      "enum": [
        "active",
        "superseded",
        "retired"
      ],
      "type": "string"
    },
    "local_label": {
      "pattern": "\\S",
      "type": "string"
    },
    "minimization_basis": {
      "pattern": "\\S",
      "type": "string"
    },
    "node_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "permitted_uses": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "prohibited_uses": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "purpose": {
      "pattern": "\\S",
      "type": "string"
    },
    "reference_type": {
      "enum": [
        "opaque-local",
        "workspace-handle",
        "external-pseudonym"
      ],
      "type": "string"
    },
    "reference_value": {
      "pattern": "\\S",
      "type": "string"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "successor_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "authority_effect",
    "kind",
    "node_id",
    "owner_ref",
    "scope_ref",
    "status",
    "local_label",
    "reference_type",
    "reference_value",
    "purpose",
    "identity_scope",
    "minimization_basis",
    "permitted_uses",
    "prohibited_uses",
    "lifecycle_state",
    "successor_refs",
    "owner_route",
    "challenge_route",
    "claim_ceiling"
  ],
  "type": "object"
}
