{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/artifact-type/v1",
  "title": "CyberAlchemy Lab Artifact Type v1 candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type_id", "version", "name", "status", "authority_effect", "classification", "semantic_owner_ref", "schema_ref", "schema_digest", "source_direction", "self_application", "registered_types", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "cyberalchemy-lab-artifact-type/v1"},
    "artifact_type_id": {"const": "cal.artifact-type.artifact-type"},
    "version": {"type": "string", "minLength": 1},
    "name": {"const": "Artifact Type"},
    "status": {"const": "candidate-unadmitted"},
    "authority_effect": {"const": "none"},
    "classification": {"type": "object", "additionalProperties": false, "required": ["artifact_type_ref", "semantic_kind", "authority_kind", "lifecycle_posture_ref"], "properties": {"artifact_type_ref": {"const": "cal.artifact-type.artifact-type/v1"}, "semantic_kind": {"const": "artifact-type"}, "authority_kind": {"const": "none"}, "lifecycle_posture_ref": {"type": "string", "minLength": 1}}},
    "semantic_owner_ref": {"type": "string", "minLength": 1},
    "schema_ref": {"const": "cal.schema.artifact-type/v1"},
    "schema_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_direction": {"type": "object", "additionalProperties": false, "required": ["canonical", "human_projection", "projection_policy", "generator_ref", "generator_sha256"], "properties": {"canonical": {"const": "artifact.json"}, "human_projection": {"const": "ARTIFACT.md"}, "projection_policy": {"const": "generated-only"}, "generator_ref": {"const": "cal.generator.foundation-projections/v1"}, "generator_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "self_application": {"type": "object", "additionalProperties": false, "required": ["mode", "bound", "bootstrap_gate", "non_effect"], "properties": {"mode": {"const": "bounded-self-description"}, "bound": {"type": "string", "minLength": 1}, "bootstrap_gate": {"type": "string", "minLength": 1}, "non_effect": {"type": "string", "minLength": 1}}},
    "registered_types": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["artifact_type_ref", "semantic_kind", "schema_path", "schema_selector", "schema_sha256", "distinct_validation_purpose"], "properties": {"artifact_type_ref": {"type": "string", "minLength": 1}, "semantic_kind": {"type": "string", "minLength": 1}, "schema_path": {"type": "string", "minLength": 1}, "schema_selector": {"type": ["string", "null"]}, "schema_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "distinct_validation_purpose": {"type": "string", "minLength": 1}}}},
    "claim_ceiling": {"type": "string", "minLength": 1}
  }
}
