{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "intent_state": {
            "const": "satisfied"
          }
        },
        "required": [
          "intent_state"
        ]
      },
      "then": {
        "properties": {
          "satisfaction_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "intent_state": {
            "const": "superseded"
          }
        },
        "required": [
          "intent_state"
        ]
      },
      "then": {
        "properties": {
          "successor_refs": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "properties": {
    "attributed_to": {
      "pattern": "\\S",
      "type": "string"
    },
    "authority_effect": {
      "const": "none"
    },
    "constraints": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "current_output_hypothesis": {
      "additionalProperties": false,
      "properties": {
        "artifact_type_ref": {
          "pattern": "\\S",
          "type": "string"
        },
        "description": {
          "pattern": "\\S",
          "type": "string"
        }
      },
      "required": [
        "artifact_type_ref",
        "description"
      ],
      "type": "object"
    },
    "direction": {
      "pattern": "\\S",
      "type": "string"
    },
    "intent_state": {
      "enum": [
        "proposed",
        "active",
        "satisfied",
        "superseded",
        "rejected"
      ],
      "type": "string"
    },
    "kind": {
      "const": "intent"
    },
    "motivation": {
      "pattern": "\\S",
      "type": "string"
    },
    "node_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "review_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "revision_history": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "change_kind": {
            "enum": [
              "refined",
              "split",
              "renamed",
              "rejected",
              "reactivated"
            ],
            "type": "string"
          },
          "decision_ref": {
            "pattern": "\\S",
            "type": "string"
          },
          "rationale": {
            "pattern": "\\S",
            "type": "string"
          },
          "resulting_intent_refs": {
            "items": {
              "pattern": "\\S",
              "type": "string"
            },
            "maxItems": 100,
            "type": "array",
            "uniqueItems": true
          },
          "revision_id": {
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "revision_id",
          "change_kind",
          "rationale",
          "decision_ref",
          "resulting_intent_refs"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "type": "array"
    },
    "revision_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "satisfaction_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "type": "array",
      "uniqueItems": true
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "successor_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "type": "array",
      "uniqueItems": true
    },
    "target_pressure": {
      "pattern": "\\S",
      "type": "string"
    }
  },
  "required": [
    "attributed_to",
    "authority_effect",
    "constraints",
    "direction",
    "kind",
    "motivation",
    "node_id",
    "owner_ref",
    "review_route",
    "scope_ref",
    "status",
    "intent_state",
    "target_pressure",
    "current_output_hypothesis",
    "satisfaction_refs",
    "successor_refs",
    "revision_route",
    "revision_history"
  ],
  "type": "object"
}
