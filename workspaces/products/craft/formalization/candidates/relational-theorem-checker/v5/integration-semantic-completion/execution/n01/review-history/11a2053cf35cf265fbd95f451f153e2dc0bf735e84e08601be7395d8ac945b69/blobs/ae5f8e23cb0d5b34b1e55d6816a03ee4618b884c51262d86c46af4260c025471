{
  "$id": "https://cyberalchemy.local/schemas/ontology-cut/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "minLength": 1,
      "type": "string"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "kind": {
      "const": "ontology-cut"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "node_id": {
      "minLength": 1,
      "type": "string"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "calculated_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "edge_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "governance_join_policy_ref": {
          "minLength": 1,
          "type": "string"
        },
        "integrity_result": {
          "const": "pass"
        },
        "node_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "ontology_ref": {
          "minLength": 1,
          "type": "string"
        },
        "replay_source": {
          "const": false
        },
        "semantic_cursor": {
          "minimum": 1,
          "type": "integer"
        },
        "source_event_set_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "ontology_ref",
        "semantic_cursor",
        "governance_join_policy_ref",
        "source_event_set_digest",
        "node_refs",
        "edge_refs",
        "integrity_result",
        "calculated_digest",
        "replay_source"
      ],
      "type": "object"
    },
    "record_state": {
      "enum": [
        "candidate",
        "admitted",
        "historical",
        "retired"
      ]
    },
    "schema_version": {
      "const": "cyberalchemy-lab-ontology-cut/v1"
    },
    "scope_ref": {
      "minLength": 1,
      "type": "string"
    },
    "successor_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "node_id",
    "kind",
    "name",
    "record_state",
    "authority_effect",
    "owner_ref",
    "scope_ref",
    "evidence_refs",
    "challenge_route",
    "successor_refs",
    "payload",
    "claim_ceiling"
  ],
  "type": "object"
}
