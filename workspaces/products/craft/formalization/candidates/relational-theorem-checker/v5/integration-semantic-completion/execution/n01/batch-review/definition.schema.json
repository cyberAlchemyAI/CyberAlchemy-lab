{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cyberalchemy:relational:batch-proposed-meaning:v1",
  "type": "object",
  "required": ["schema", "unit", "kind", "revision", "status", "source", "prior_definition", "formal_expression", "notation", "base_definition", "plain_language_intuition", "qualifiers", "operational_interpretation", "forbidden_conclusions", "worked_cases", "source_refinement_gap", "branch_matrix", "theorem_targets", "pending_ids", "inherited_discharges", "actual_owner_review"],
  "properties": {
    "schema": {"const": "relational.batch-proposed-meaning/v1"},
    "unit": {"type": "string", "pattern": "^K[0-4][0-9]$"},
    "kind": {"type": "string", "pattern": "^relation\\.[a-z]+(?:-[a-z]+)*$"},
    "revision": {"const": "v5-batch-definitions-2026-10-11-1"},
    "status": {"const": "proposed-for-consolidated-review"},
    "actual_owner_review": {"type": "null"},
    "inherited_discharges": {"const": 0},
    "source": {"$ref": "#/$defs/binding"},
    "prior_definition": {"$ref": "#/$defs/binding"},
    "formal_expression": {"type": "string", "minLength": 30},
    "base_definition": {"type": "string", "minLength": 30},
    "notation": {
      "type": "object",
      "required": ["W", "e", "f", "s", "t", "q", "w", "witness_fields", "special_atoms"],
      "properties": {"witness_fields": {"type": "object", "minProperties": 3}, "special_atoms": {"type": "object"}}
    },
    "plain_language_intuition": {
      "type": "object", "required": ["normative", "text"],
      "properties": {"normative": {"const": false}, "text": {"type": "string", "minLength": 30}},
      "additionalProperties": false
    },
    "qualifiers": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["id", "field", "type", "exact_role", "interpretation", "catalog_key", "success_condition", "unresolved_result", "raw_mapping_status"]}
    },
    "operational_interpretation": {
      "type": "object", "required": ["id", "meaning", "precondition", "record_postcondition", "meaning_world_preserved", "composed_closure_status"]
    },
    "forbidden_conclusions": {
      "type": "array", "minItems": 3,
      "items": {"type": "object", "required": ["id", "label", "predicate", "parameter_types", "definition", "anchor", "theorem_target", "proof_status", "positive_coexistence_allowed"], "properties": {"positive_coexistence_allowed": {"const": true}}}
    },
    "worked_cases": {
      "type": "object", "required": ["positive", "insufficient", "correction", "examples_are_synthetic", "full_source_model_checked"],
      "properties": {"examples_are_synthetic": {"const": true}, "full_source_model_checked": {"const": false}}
    },
    "source_refinement_gap": {"type": "string", "minLength": 30},
    "branch_matrix": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "unit", "source_kind", "target_kind", "interpretation", "proof_target", "source_mapping_implemented", "refinement_proved"], "properties": {"source_mapping_implemented": {"const": false}, "refinement_proved": {"const": false}}}},
    "theorem_targets": {"type": "object", "required": ["satisfiable", "checker_soundness", "checker_completeness", "qualifier_refinements", "effect", "non_entailments", "assumption_note"]},
    "pending_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "$defs": {
    "binding": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false}
  }
}
