{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:relational:v3:qualification-suite",
  "type": "object",
  "properties": {
    "schema": {
      "const": "relational.qualification-suite/v3"
    },
    "result": {
      "const": "pass"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "entry_point": {
            "type": "string",
            "minLength": 1
          },
          "evidence_kind": {
            "enum": [
              "fresh-kernel",
              "saved-inspection",
              "decoder",
              "boundary",
              "contract",
              "inherited-control",
              "abstract-theorem",
              "unqualified-io"
            ]
          },
          "input": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "output": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "observed": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "const": "pass"
          },
          "claim_scope": {
            "type": "string",
            "minLength": 1
          },
          "authority_effect": {
            "const": "none"
          }
        },
        "required": [
          "name",
          "entry_point",
          "evidence_kind",
          "input",
          "output",
          "expected",
          "observed",
          "result",
          "claim_scope",
          "authority_effect"
        ],
        "additionalProperties": false
      }
    },
    "catalog": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "required_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "finite_regression_only": {
      "const": true
    },
    "authority_effect": {
      "const": "none"
    }
  },
  "required": [
    "schema",
    "result",
    "cases",
    "catalog",
    "required_ids",
    "source_receipts",
    "finite_regression_only",
    "authority_effect"
  ],
  "additionalProperties": false
}
