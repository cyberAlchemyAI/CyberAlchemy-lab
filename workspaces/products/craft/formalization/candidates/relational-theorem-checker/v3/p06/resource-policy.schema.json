{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:relational:v3:resource-policy",
  "type": "object",
  "properties": {
    "schema": {
      "const": "relational.resource-policy/v3"
    },
    "work_limits": {
      "const": {
        "input_bytes": 4194304,
        "json_depth": 64,
        "nodes": 128,
        "assertions": 256,
        "assessments": 256,
        "domain": 32,
        "rules": 16,
        "predicates": 16,
        "variables": 4,
        "arity": 4,
        "ground_candidates": 50000,
        "atom_candidates": 3000000,
        "stress_candidates": 256,
        "conflict_pairs": 65536,
        "saturation_steps": 50000,
        "certificate_steps": 50000
      }
    },
    "stage_seconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 60
    },
    "run_seconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 3600
    },
    "memory_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 68719476736
    },
    "memory_mode": {
      "enum": [
        "required",
        "advisory"
      ]
    },
    "output_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8388608
    },
    "max_parallel_workers": {
      "const": 1
    }
  },
  "required": [
    "schema",
    "work_limits",
    "stage_seconds",
    "run_seconds",
    "memory_bytes",
    "memory_mode",
    "output_bytes",
    "max_parallel_workers"
  ],
  "additionalProperties": false
}
