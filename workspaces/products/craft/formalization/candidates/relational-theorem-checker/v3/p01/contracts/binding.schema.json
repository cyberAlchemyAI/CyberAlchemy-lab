{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:relational:v3:binding",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "repo"
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "kind",
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "toolchain"
        },
        "toolchain_identity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "path": {
          "type": "string",
          "pattern": "^lib/lean/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "kind",
        "toolchain_identity",
        "path",
        "sha256"
      ],
      "additionalProperties": false
    }
  ]
}
