{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:relational:v3:shadow-owner",
  "type": "object",
  "properties": {
    "schema": {
      "const": "relational.shadow-owner/v3"
    },
    "store_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "policy": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "relational.shadow-policy/v3"
        },
        "writers": {
          "const": "exclusively-mediated-cooperating-writers"
        },
        "store_kind": {
          "enum": [
            "fixture-shadow",
            "io-probe-unqualified"
          ]
        },
        "scope": {
          "const": "bounded-local-candidate"
        },
        "authority_effect": {
          "const": "none"
        },
        "application_authorized": {
          "const": false
        }
      },
      "required": [
        "schema",
        "writers",
        "store_kind",
        "scope",
        "authority_effect",
        "application_authorized"
      ],
      "additionalProperties": false
    },
    "authority_effect": {
      "const": "none"
    },
    "application_authorized": {
      "const": false
    }
  },
  "required": [
    "schema",
    "store_id",
    "root",
    "policy",
    "authority_effect",
    "application_authorized"
  ],
  "additionalProperties": false
}
