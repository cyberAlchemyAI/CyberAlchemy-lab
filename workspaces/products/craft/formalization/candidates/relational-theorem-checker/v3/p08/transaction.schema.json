{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:relational:v3:shadow-transaction",
  "type": "object",
  "properties": {
    "schema": {
      "const": "relational.shadow-transaction/v3"
    },
    "store_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "transaction_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "store_kind": {
      "enum": [
        "fixture-shadow",
        "io-probe-unqualified"
      ]
    },
    "phase": {
      "enum": [
        "prepared",
        "committed",
        "aborted",
        "reconciliation-required"
      ]
    },
    "progress": {
      "enum": [
        "journal",
        "snapshot",
        "registration",
        "metadata-head",
        "complete"
      ]
    },
    "before_head": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "relational.shadow-head/v3"
        },
        "store_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "store_kind": {
          "enum": [
            "fixture-shadow",
            "io-probe-unqualified"
          ]
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_identity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "snapshot": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "registration": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "transaction_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "authority_effect": {
          "const": "none"
        },
        "application_authorized": {
          "const": false
        }
      },
      "required": [
        "schema",
        "store_id",
        "store_kind",
        "generation",
        "baseline_identity",
        "snapshot",
        "registration",
        "transaction_id",
        "authority_effect",
        "application_authorized"
      ],
      "additionalProperties": false
