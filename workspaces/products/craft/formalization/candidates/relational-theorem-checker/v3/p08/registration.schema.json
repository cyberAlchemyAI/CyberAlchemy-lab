          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "required_inventory": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fresh_at_creation": {
      "type": "boolean"
    },
    "authority_effect": {
      "const": "none"
    },
    "application_authorized": {
      "const": false
    }
  },
