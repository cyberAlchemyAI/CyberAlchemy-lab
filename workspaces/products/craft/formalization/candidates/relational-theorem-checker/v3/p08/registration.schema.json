{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:relational:v3:shadow-registration",
  "type": "object",
  "properties": {
    "schema": {
      "const": "relational.shadow-registration/v3"
    },
    "store_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "transaction_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "baseline_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "proof_mode": {
      "enum": [
        "fresh-independent-successor-registration",
        "io-probe-unqualified"
      ]
    },
    "request": {
