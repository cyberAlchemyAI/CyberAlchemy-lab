    "benchmark:install": "playwright install firefox",
    "benchmark:frontend": "npm run build && node benchmark/frontend-benchmark.mjs",
    "benchmark:pareto": "npm run build && node benchmark/pareto-benchmark.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@reviewjs/annotate": "1.2.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "axe-core": "4.13.0",
    "playwright": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
