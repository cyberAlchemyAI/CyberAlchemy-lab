{
  "schema_version": "alchlang-frontend-benchmark-config/v1",
  "variants": [
    { "id": "baseline", "treatment": "Current approved-for-testing layout" },
    { "id": "compact-spacing", "treatment": "Reduced vertical rhythm and component scale only" },
    { "id": "progressive-reference", "treatment": "Long reference sections behind explicit native disclosures" },
    { "id": "task-first", "treatment": "Working source editor precedes explanatory reading" }
  ],
  "surfaces": [
    { "id": "overview", "hash": "#overview" },
    { "id": "tutorial-workspace", "hash": "#quickstart" }
  ],
  "viewports": [
    { "id": "desktop", "width": 1440, "height": 1000 },
    { "id": "tablet", "width": 768, "height": 1024 },
    { "id": "mobile", "width": 390, "height": 844 }
  ],
  "hard_budgets": {
    "document_horizontal_overflow_px": 0,
    "axe_violations": 0,
    "console_errors": 0,
    "page_errors": 0,
    "failed_requests": 0,
    "http_errors": 0,
    "external_requests": 0,
    "javascript_bytes": 320000,
    "css_bytes": 85000,
    "total_gzip_bytes": 130000
  },
  "budget_basis": {
    "css_bytes": "85 kB raw ceiling includes the shared Exchange design system, responsive product lockup, and footer adapter; 130 kB total gzip includes the canonical 17.2 kB orb and 1.7 kB Lab identity assets with measured margin above the 126.1 kB integrated build."
  },
  "review_thresholds": {
    "dom_content_loaded_ms": 1000,
    "load_event_ms": 1500,
    "interactive_target_px": 24
  },
  "required_tutorial_sections": [
    "quickstart", "workspace", "model", "integration", "source", "sfol", "contracts",
    "backend-types", "type-selection", "lexical-reference",
    "declaration-reference", "formal-grammar", "domainspec-target", "compiler", "actions",
    "effects", "outbox", "evidence"
  ],
  "pareto": {
    "browser_objectives": [
      { "id": "tutorial_mobile_viewport_pages", "direction": "min", "epsilon": 1 },
      { "id": "tutorial_desktop_viewport_pages", "direction": "min", "epsilon": 1 }
    ],
    "human_objectives": [
      { "id": "median_task_time_seconds", "direction": "min", "epsilon": 2 },
      { "id": "comprehension_accuracy", "direction": "max", "epsilon": 0.03 },
      { "id": "meaning_coverage", "direction": "max", "epsilon": 0.02 },
      { "id": "pairwise_preference", "direction": "max", "epsilon": 0.05 }
    ]
  }
}
