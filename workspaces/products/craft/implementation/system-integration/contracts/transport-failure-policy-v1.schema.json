{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/system-integration/transport-failure-policy-v1.schema.json",
  "title": "DomainSpec candidate transport failure policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_id", "retry_eligibility", "max_attempts", "backoff", "unknown_outcome", "terminal_action", "evidence_boundary"],
  "properties": {
    "policy_id": {"$ref": "integration-reference-v1.schema.json"},
    "retry_eligibility": {"const": "idempotent-message-id-only"},
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 1000},
    "backoff": {"const": "exponential-bounded"},
    "unknown_outcome": {"const": "reconcile-by-message-id"},
    "terminal_action": {"const": "dead-letter"},
    "evidence_boundary": {"type": "string", "minLength": 1}
  }
}
