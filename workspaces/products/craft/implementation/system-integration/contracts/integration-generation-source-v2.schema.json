{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/system-integration/integration-generation-source-v2.schema.json",
  "title": "DomainSpec integration generation source v2 candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "persistence",
    "messaging",
    "external_api",
    "disclosure_policy",
    "orodi_binding"
  ],
  "properties": {
    "schema_version": {"const": "domainspec.integration-generation-source/v2-candidate"},
    "source_id": {"$ref": "#/$defs/ref"},
    "persistence": {"$ref": "persistence-composition-v2.schema.json"},
    "messaging": {"$ref": "messaging-composition-v2.schema.json"},
    "external_api": {"$ref": "external-api-composition-v2.schema.json"},
    "disclosure_policy": {"$ref": "integration-observation-v1.schema.json#/$defs/disclosurePolicy"},
    "orodi_binding": {"$ref": "integration-observation-v1.schema.json#/$defs/orodiBinding"}
  },
  "$defs": {
    "ref": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*(?:[-.:/#][A-Za-z0-9]+)*$"
    }
  }
}
