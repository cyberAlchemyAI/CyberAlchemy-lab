{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/system-integration/binding-manifest-v1.schema.json",
  "title": "Compiled DomainSpec system-integration binding manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "binding_set_id", "subject_ref", "profile", "language", "source_digest", "canonical_bindings", "binding_digest", "runtime_guarantees_observed", "authority_effect"],
  "properties": {
    "schema_version": {"const": "domainspec.system-integration-binding-manifest/v1"},
    "binding_set_id": {"type": "string"},
    "subject_ref": {"type": "string"},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_digest", "language_profile_id", "language_profile_digest", "architecture_id", "architecture_sha256"],
      "properties": {
        "profile_id": {"type": "string"}, "profile_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "language_profile_id": {"type": "string"}, "language_profile_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "architecture_id": {"const": "domainspec-durable-recovery@2"}, "architecture_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "language": {"enum": ["typescript", "python", "rust"]},
    "source_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "canonical_bindings": {"type": "object"},
    "binding_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "runtime_guarantees_observed": {"const": false},
    "authority_effect": {"const": "none"}
  }
}
