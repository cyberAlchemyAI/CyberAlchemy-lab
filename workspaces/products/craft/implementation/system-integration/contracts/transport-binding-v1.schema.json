{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/system-integration/transport-binding-v1.schema.json",
  "title": "DomainSpec candidate transport binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["binding_id", "mode", "direction", "operation_ref", "event_ref", "channel_ref", "delivery_policy_ref", "failure_policy_ref", "envelope_profile_ref", "evidence_boundary"],
  "properties": {
    "binding_id": {"$ref": "integration-reference-v1.schema.json"},
    "mode": {"const": "message"},
    "direction": {"const": "publish-subscribe"},
    "operation_ref": {"type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"},
    "event_ref": {"type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"},
    "channel_ref": {"$ref": "integration-reference-v1.schema.json"},
    "delivery_policy_ref": {"$ref": "integration-reference-v1.schema.json"},
    "failure_policy_ref": {"$ref": "integration-reference-v1.schema.json"},
    "envelope_profile_ref": {"const": "envelope:domainspec-event-json-v1"},
    "evidence_boundary": {"type": "string", "minLength": 1}
  }
}
