{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/system-integration/message-channel-v1.schema.json",
  "title": "DomainSpec candidate message channel v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["channel_id", "purpose", "allowed_event_refs", "publisher_operation_refs", "consumer_operation_refs", "evidence_boundary"],
  "properties": {
    "channel_id": {"type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "purpose": {"enum": ["delivery", "dead-letter"]},
    "allowed_event_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"}},
    "publisher_operation_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"}},
    "consumer_operation_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"}},
    "evidence_boundary": {"type": "string", "minLength": 1}
  }
}
