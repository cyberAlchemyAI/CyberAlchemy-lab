{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/system-integration/persistence-composition-v2.schema.json",
  "title": "DomainSpec persistence composition v2 candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "composition_id", "integration_kernel", "persistence_bindings", "persistence_mappings", "transaction_guarantees", "migrations", "runtime_guarantees_observed", "authority_effect"],
  "properties": {
    "schema_version": {"const": "domainspec.persistence-composition/v2-candidate"},
    "composition_id": {"$ref": "#/$defs/ref"},
    "integration_kernel": {"$ref": "integration-kernel-v2.schema.json"},
    "persistence_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/persistenceBinding"}},
    "persistence_mappings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/persistenceMapping"}},
    "transaction_guarantees": {"type": "array", "items": {"$ref": "#/$defs/transactionGuarantee"}},
    "migrations": {"type": "array", "items": {"$ref": "#/$defs/migration"}},
    "runtime_guarantees_observed": {"const": false},
    "authority_effect": {"const": "none"}
  },
  "$defs": {
    "ref": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*(?:[-.:/#][A-Za-z0-9]+)*$"},
    "text": {"type": "string", "minLength": 1},
    "refSet": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
    "persistenceBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["binding_id", "integration_binding_ref", "logical_subject_refs", "dependency_contract_ref", "adapter_ref", "resource_ref", "implementation_profile_ref", "logical_physical_mapping_ref", "evidence_boundary", "authority_effect"],
      "properties": {
        "binding_id": {"$ref": "#/$defs/ref"}, "integration_binding_ref": {"$ref": "#/$defs/ref"},
        "logical_subject_refs": {"$ref": "#/$defs/nonEmptyRefSet"}, "dependency_contract_ref": {"$ref": "#/$defs/ref"},
        "adapter_ref": {"$ref": "#/$defs/ref"}, "resource_ref": {"$ref": "#/$defs/ref"}, "implementation_profile_ref": {"$ref": "#/$defs/ref"},
        "logical_physical_mapping_ref": {"$ref": "#/$defs/ref"}, "evidence_boundary": {"$ref": "#/$defs/text"}, "authority_effect": {"const": "none"}
      }
    },
    "nonEmptyRefSet": {"allOf": [{"$ref": "#/$defs/refSet"}, {"minItems": 1}]},
    "physicalModel": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "model_kind", "physical_name", "version"],
      "properties": {"model_id": {"$ref": "#/$defs/ref"}, "model_kind": {"enum": ["relational-table", "document", "key-value"]}, "physical_name": {"$ref": "#/$defs/text"}, "version": {"$ref": "#/$defs/ref"}}
    },
    "identityMapping": {
      "type": "object", "additionalProperties": false,
      "required": ["logical_property_ref", "physical_field_ref", "conversion_ref"],
      "properties": {"logical_property_ref": {"$ref": "#/$defs/ref"}, "physical_field_ref": {"$ref": "#/$defs/ref"}, "conversion_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}}
    },
    "fieldMapping": {
      "type": "object", "additionalProperties": false,
      "required": ["logical_property_ref", "logical_shape", "physical_field_ref", "storage_shape", "collection_semantics", "conversion_ref"],
      "properties": {
        "logical_property_ref": {"$ref": "#/$defs/ref"}, "logical_shape": {"enum": ["scalar", "entity-reference", "value-object", "enum", "sum", "optional", "list", "set"]},
        "physical_field_ref": {"$ref": "#/$defs/ref"}, "storage_shape": {"enum": ["scalar", "foreign-key", "embedded", "discriminator", "nullable", "array", "join-table"]},
        "collection_semantics": {"enum": ["not-applicable", "ordered", "unique-unordered"]}, "conversion_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}
      }
    },
    "relationMapping": {
      "type": "object", "additionalProperties": false,
      "required": ["relation_ref", "source_field_ref", "target_model_ref", "target_field_ref", "cardinality", "storage_strategy"],
      "properties": {"relation_ref": {"$ref": "#/$defs/ref"}, "source_field_ref": {"$ref": "#/$defs/ref"}, "target_model_ref": {"$ref": "#/$defs/ref"}, "target_field_ref": {"$ref": "#/$defs/ref"}, "cardinality": {"enum": ["one-to-one", "many-to-one", "one-to-many", "many-to-many"]}, "storage_strategy": {"enum": ["foreign-key", "join-table", "embedded"]}}
    },
    "indexMapping": {
      "type": "object", "additionalProperties": false,
      "required": ["index_id", "model_ref", "physical_name", "field_refs", "unique", "order"],
      "properties": {"index_id": {"$ref": "#/$defs/ref"}, "model_ref": {"$ref": "#/$defs/ref"}, "physical_name": {"$ref": "#/$defs/text"}, "field_refs": {"$ref": "#/$defs/nonEmptyRefSet"}, "unique": {"type": "boolean"}, "order": {"enum": ["ordered", "unordered"]}}
    },
    "conversionRule": {
      "type": "object", "additionalProperties": false,
      "required": ["conversion_id", "source_shape", "target_shape", "direction", "lossless", "implementation_ref"],
      "properties": {"conversion_id": {"$ref": "#/$defs/ref"}, "source_shape": {"$ref": "#/$defs/text"}, "target_shape": {"$ref": "#/$defs/text"}, "direction": {"enum": ["to-storage", "from-storage", "bidirectional"]}, "lossless": {"type": "boolean"}, "implementation_ref": {"$ref": "#/$defs/ref"}}
    },
    "persistenceMapping": {
      "type": "object", "additionalProperties": false,
      "required": ["mapping_id", "logical_subject_refs", "physical_models", "identity_mappings", "field_mappings", "relation_mappings", "index_mappings", "conversion_rules", "version", "authority_effect"],
      "properties": {
        "mapping_id": {"$ref": "#/$defs/ref"}, "logical_subject_refs": {"$ref": "#/$defs/nonEmptyRefSet"},
        "physical_models": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/physicalModel"}},
        "identity_mappings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identityMapping"}},
        "field_mappings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fieldMapping"}},
        "relation_mappings": {"type": "array", "items": {"$ref": "#/$defs/relationMapping"}},
        "index_mappings": {"type": "array", "items": {"$ref": "#/$defs/indexMapping"}},
        "conversion_rules": {"type": "array", "items": {"$ref": "#/$defs/conversionRule"}},
        "version": {"$ref": "#/$defs/ref"}, "authority_effect": {"const": "none"}
      }
    },
    "transactionGuarantee": {
      "type": "object", "additionalProperties": false,
      "required": ["binding_id", "unit_of_work_contract_ref", "persistence_binding_refs", "participant_refs", "atomicity_scope", "local_commit_boundary_ref", "selected_guarantees", "implementation_profile_ref", "failure_mapping_ref", "evidence_boundary", "runtime_guarantees_observed", "authority_effect"],
      "properties": {
        "binding_id": {"$ref": "#/$defs/ref"}, "unit_of_work_contract_ref": {"$ref": "#/$defs/ref"}, "persistence_binding_refs": {"$ref": "#/$defs/nonEmptyRefSet"}, "participant_refs": {"$ref": "#/$defs/nonEmptyRefSet"},
        "atomicity_scope": {"const": "single-resource-local"}, "local_commit_boundary_ref": {"$ref": "#/$defs/ref"},
        "selected_guarantees": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["atomicity", "isolation", "durability", "conflict-detection", "rollback-restoration"]}},
        "implementation_profile_ref": {"$ref": "#/$defs/ref"}, "failure_mapping_ref": {"$ref": "#/$defs/ref"}, "evidence_boundary": {"$ref": "#/$defs/text"},
        "runtime_guarantees_observed": {"const": false}, "authority_effect": {"const": "none"}
      }
    },
    "migrationStep": {
      "type": "object", "additionalProperties": false,
      "required": ["step_id", "step_kind", "operation_ref", "reversible"],
      "properties": {"step_id": {"$ref": "#/$defs/ref"}, "step_kind": {"enum": ["schema", "data", "backfill", "verification"]}, "operation_ref": {"$ref": "#/$defs/ref"}, "reversible": {"type": "boolean"}}
    },
    "migration": {
      "type": "object", "additionalProperties": false,
      "required": ["migration_id", "persistence_binding_ref", "from_version", "to_version", "forward_steps", "data_transform_refs", "compatibility_window", "rollback_posture", "rollback_step_refs", "verification_refs", "authority_effect"],
      "properties": {
        "migration_id": {"$ref": "#/$defs/ref"}, "persistence_binding_ref": {"$ref": "#/$defs/ref"}, "from_version": {"$ref": "#/$defs/ref"}, "to_version": {"$ref": "#/$defs/ref"},
        "forward_steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/migrationStep"}}, "data_transform_refs": {"$ref": "#/$defs/refSet"},
        "compatibility_window": {"enum": ["none", "read-old-write-new", "dual-read", "dual-write"]}, "rollback_posture": {"enum": ["reversible", "forward-only", "restore-from-backup", "manual"]},
        "rollback_step_refs": {"$ref": "#/$defs/refSet"}, "verification_refs": {"$ref": "#/$defs/nonEmptyRefSet"}, "authority_effect": {"const": "none"}
      }
    }
  }
}
