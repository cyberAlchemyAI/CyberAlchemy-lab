{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/system-integration/delivery-policy-v1.schema.json",
  "title": "DomainSpec candidate delivery policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_id", "semantics", "acknowledgement_boundary", "ordering_scope", "visibility_timeout_seconds", "retention_seconds", "max_receive_count", "dead_letter_channel_ref", "deduplication_owner_ref", "evidence_boundary"],
  "properties": {
    "policy_id": {"$ref": "integration-reference-v1.schema.json"},
    "semantics": {"const": "at-least-once"},
    "acknowledgement_boundary": {"const": "provider-accepted"},
    "ordering_scope": {"const": "none"},
    "visibility_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 43200},
    "retention_seconds": {"type": "integer", "minimum": 60, "maximum": 1209600},
    "max_receive_count": {"type": "integer", "minimum": 1, "maximum": 1000},
    "dead_letter_channel_ref": {"$ref": "integration-reference-v1.schema.json"},
    "deduplication_owner_ref": {"const": "consumer:inbox-message-id"},
    "evidence_boundary": {"type": "string", "minLength": 1}
  }
}
