{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/system-integration/dependency-contract-v1.schema.json",
  "title": "D45 Concern-Specific Dependency Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "concern", "consumer_roles", "operation_signatures", "failure_surface", "implementation_profile_ref", "domain_interface_ref"],
  "properties": {
    "contract_id": {"$ref": "integration-reference-v1.schema.json"},
    "concern": {"type": "string", "minLength": 1, "not": {"pattern": "^[Pp][Oo][Rr][Tt]$"}},
    "consumer_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "operation_signatures": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "failure_surface": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "implementation_profile_ref": {"$ref": "integration-reference-v1.schema.json"},
    "domain_interface_ref": {"type": ["string", "null"], "pattern": "^DS-D1\\.11:[a-z][a-z0-9-]*$"}
  }
}
