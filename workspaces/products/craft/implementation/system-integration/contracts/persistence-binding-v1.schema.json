{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/system-integration/persistence-binding-v1.schema.json",
  "title": "D46 Persistence Binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["binding_id", "logical_subject_refs", "dependency_contract_ref", "adapter_ref", "resource_ref", "implementation_profile_ref", "logical_physical_mapping_ref", "evidence_boundary"],
  "properties": {
    "binding_id": {"$ref": "integration-reference-v1.schema.json"},
    "logical_subject_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "integration-reference-v1.schema.json"}},
    "dependency_contract_ref": {"$ref": "integration-reference-v1.schema.json"},
    "adapter_ref": {"$ref": "integration-reference-v1.schema.json"},
    "resource_ref": {"$ref": "integration-reference-v1.schema.json"},
    "implementation_profile_ref": {"$ref": "integration-reference-v1.schema.json"},
    "logical_physical_mapping_ref": {"$ref": "integration-reference-v1.schema.json"},
    "evidence_boundary": {"type": "string", "minLength": 1}
  }
}
