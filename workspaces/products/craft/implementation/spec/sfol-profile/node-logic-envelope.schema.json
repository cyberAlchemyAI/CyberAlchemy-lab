{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/sfol/node-logic-envelope/v1",
  "title": "DomainSpec Node Logic Envelope",
  "description": "Profile-level structural admission for a DS-SFOL node logic module. Deep AST validation remains owned by the DS-SFOL decoder.",
  "type": "object",
  "required": [
    "schema_version",
    "language_version",
    "module_id",
    "source",
    "declarations",
    "clauses"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "domainspec-node-logic/v1"},
    "language_version": {"const": "domainspec-sfol/v1"},
    "module_id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["feature_id", "node_id", "source_id", "source_path"],
      "additionalProperties": false,
      "properties": {
        "feature_id": {"type": "string", "minLength": 1},
        "node_id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "source_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        }
      }
    },
    "declarations": {"type": "array"},
    "clauses": {"type": "array", "minItems": 1}
  },
  "x-domainspec": {
    "record": "node-logic-envelope",
    "role": "development-profile-admission",
    "authority": "implementation-owned-development-profile",
    "version": "domainspec-node-logic/v1"
  }
}
