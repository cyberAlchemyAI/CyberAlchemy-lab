  adapter-protocol "are.module-adapter/v1"
  manifest-digest "b5ce4d4a3a5b31d92658d8cd53d3ac3ce07283ab7ed8adc164fee23c1221edb5"
  side-effects false
  authority-effect none

capability SemanticKey:
