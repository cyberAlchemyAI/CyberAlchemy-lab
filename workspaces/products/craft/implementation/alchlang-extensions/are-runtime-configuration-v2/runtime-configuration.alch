# Candidate successor to the historical exact v1 configuration.
# Binds the injected semantic runtime and compiled Alch artifact explicitly.
# Compilation and conformance do not admit or activate this runtime.
domain are-production-runtime
profile module-configuration-v2
owner agent-reasoning-engine-runtime-owner
runtime node>=26.8.1

configuration AreProductionSemanticCore:
  configuration-id "are-production-semantic-core-v2-candidate"
  status candidate
  authority-effect none

governed-by AdoptedModulePortConstitution:
