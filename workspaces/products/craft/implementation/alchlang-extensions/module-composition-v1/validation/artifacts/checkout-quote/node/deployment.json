{
  "schema_version": "alchlang.portable-http/v1",
  "entry": "index.mjs#handler",
  "launcher": "server.mjs",
  "target": "node-http",
  "runtime": "node>=26.8.1",
  "limits": {
    "request_bytes": 1048576,
    "request_read_timeout_ms": 30000
  },
  "method": "POST",
  "path": "/checkout-quote",
  "environment_references": [
    "CHECKOUT_API_TOKEN",
    "PRICE_SNAPSHOT_TOKEN",
    "PRICE_SNAPSHOT_URL",
    "SHIPPING_OPTIONS_TOKEN",
    "SHIPPING_OPTIONS_URL"
  ],
  "integrations": {
    "ItemPrice": {
      "query": {},
      "transport": "module-local",
      "module": "Pricing",
      "input": "input.pricing",
      "output": "Pricing__Quote",
      "timeout": 10000,
      "maxBytes": 262144
    },
    "ShippingPrice": {
      "query": {},
      "transport": "module-local",
      "module": "Shipping",
      "input": "input.shipping",
      "output": "Shipping__ShippingResponse",
      "timeout": 10000,
      "maxBytes": 262144
    }
  },
  "provisioned": false,
  "authority_effect": "none"
}
