domain are-module-port
profile semantic-contract-v1
owner agent-reasoning-engine-runtime-owner
logic sfol-v1
runtime node>=26.8.1

axiom PackagedVerifierHasExactIdentity:
  ontology "ARE-MODULE-PACKAGED-VERIFIER-AXIOM-EXACT-IDENTITY"
  meaning "A packaged verifier is one exact binary artifact for one declared operating system architecture target and admitted Rust source set."
  statement "A filename platform label or successful execution cannot substitute for the complete digest-bound artifact identity."
  subject domain
  commitment taken-as-given

axiom PackagedVerifierPrecedesComposition:
  ontology "ARE-MODULE-PACKAGED-VERIFIER-AXIOM-VERIFICATION-FIRST"
  meaning "The exact packaged verifier executes before static Module Port composition without invoking a compiler or package manager."
  statement "No configured adapter becomes available until the packaged verifier returns the expected passing receipt."
  subject domain
  commitment taken-as-given

axiom PackagedVerifierFailureIsClosed:
  ontology "ARE-MODULE-PACKAGED-VERIFIER-AXIOM-FAIL-CLOSED"
  meaning "A missing drifted substituted incompatible non-regular or non-executable verifier artifact blocks the complete module set."
  statement "There is no cargo fallback source rebuild or partial Module Port when packaged verification is unavailable."
  subject domain
  commitment taken-as-given

axiom PackagedVerifierDoesNotAuthorizeEffects:
  ontology "ARE-MODULE-PACKAGED-VERIFIER-AXIOM-NO-EFFECT-AUTHORITY"
  meaning "Packaging changes verifier delivery only and grants no new Module Port or host authority."
  statement "The packaged verifier cannot install hooks publish release deploy authorize adapter effects or select routes."
  subject domain
  commitment taken-as-given

intrinsic MatchExactArtifactIdentity:
  ontology "ARE-MODULE-PACKAGED-VERIFIER-INTRINSIC-MATCH-IDENTITY"
  meaning "Match a complete normalized artifact platform architecture or target identity without accepting a substring."
  operation contains-token
  input record
  output boolean

intrinsic AccumulateArtifactReason:
  ontology "ARE-MODULE-PACKAGED-VERIFIER-INTRINSIC-ACCUMULATE-REASON"
  meaning "Append one public artifact failure reason without reordering or duplicating existing reasons."
  operation append-reason
  input record
  output string-array

invariant ArtifactIdentityDoesNotCollapseSubstrings:
  ontology "ARE-MODULE-PACKAGED-VERIFIER-INVARIANT-IDENTITY-NON-COLLAPSE"
  meaning "An artifact identity check cannot accept a substring of a different platform architecture or target identity."
  grounded-by PackagedVerifierHasExactIdentity
  intrinsic MatchExactArtifactIdentity
  property token-non-collapse
  violation "ARE_MODULE_PACKAGED_VERIFIER_IDENTITY_COLLAPSE_DEFECT"

invariant ArtifactReasonsRemainOrderedAndDistinct:
  ontology "ARE-MODULE-PACKAGED-VERIFIER-INVARIANT-REASONS-ORDERED-DISTINCT"
  meaning "Artifact diagnostics preserve causal order and do not duplicate a recorded failure reason."
  grounded-by PackagedVerifierFailureIsClosed
  intrinsic AccumulateArtifactReason
  property ordered-distinct-append
  violation "ARE_MODULE_PACKAGED_VERIFIER_REASON_ACCUMULATION_DEFECT"

governed-by ModulePortCandidateConstitution:
  constitution-ref "ARE-MODULE-PORT-CONSTITUTION-CANDIDATE"
  version "1-candidate"
  status candidate
  selector "profile:semantic-contract-v1/domain:are-module-port"
  adopted false
  authority-effect none

validation ArtifactIdentityNonCollapseConformance:
  invariant ArtifactIdentityDoesNotCollapseSubstrings
  method fixture
  fixtures "packaged-verifier.fixtures.json"
  claim finite-evidence-only

validation ArtifactReasonConformance:
  invariant ArtifactReasonsRemainOrderedAndDistinct
  method fixture
  fixtures "packaged-verifier.fixtures.json"
  claim finite-evidence-only
