{
  "schema_version": "alchlang.portable-http/v1",
  "entry": "index.mjs#handler",
  "launcher": "server.mjs",
  "target": "node-http",
  "runtime": "node>=26.8.1",
  "limits": {
    "request_bytes": 262144,
    "request_read_timeout_ms": 5000
  },
  "method": "POST",
  "path": "/shipping-options",
  "environment_references": [
    "SHIPPING_API_TOKEN",
    "SHIPPING_OPTIONS_URL",
    "SHIPPING_OPTIONS_TOKEN"
  ],
  "integrations": {
    "ShippingOptions": {
      "query": {
        "country": "input.request.country",
        "weight": "input.request.weight_grams"
      },
      "transport": "provided-or-http",
      "provided": "input.snapshot",
      "output": "ShippingSnapshot",
      "urlEnv": "SHIPPING_OPTIONS_URL",
      "secretEnv": "SHIPPING_OPTIONS_TOKEN",
      "timeout": 3000,
      "maxBytes": 262144
    }
  },
  "provisioned": false,
  "authority_effect": "none"
}
