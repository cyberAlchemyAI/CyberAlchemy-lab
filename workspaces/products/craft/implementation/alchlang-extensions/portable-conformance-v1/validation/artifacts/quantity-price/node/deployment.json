{
  "schema_version": "alchlang.portable-http/v1",
  "entry": "index.mjs#handler",
  "launcher": "server.mjs",
  "target": "node-http",
  "runtime": "node>=26.8.1",
  "limits": {
    "request_bytes": 262144,
    "request_read_timeout_ms": 5000
  },
  "method": "POST",
  "path": "/quote",
  "environment_references": [
    "QUOTE_API_TOKEN",
    "PRICE_SNAPSHOT_URL",
    "PRICE_SNAPSHOT_TOKEN"
  ],
  "integrations": {
    "Prices": {
      "query": {
        "variant_id": "input.request.variant_id"
      },
      "transport": "provided-or-http",
      "provided": "input.snapshot",
      "output": "PriceSnapshot",
      "urlEnv": "PRICE_SNAPSHOT_URL",
      "secretEnv": "PRICE_SNAPSHOT_TOKEN",
      "timeout": 3000,
      "maxBytes": 262144
    }
  },
  "provisioned": false,
  "authority_effect": "none"
}
