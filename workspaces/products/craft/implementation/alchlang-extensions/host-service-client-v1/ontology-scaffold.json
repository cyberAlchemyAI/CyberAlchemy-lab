    {
      "from": "ServiceClient",
      "relation": "reads",
      "to": "SelectedFunction"
    },
    {
      "from": "ServiceClient",
      "relation": "sends",
      "to": "InvocationEnvelope"
    },
    {
      "from": "ServiceClient",
      "relation": "reports",
      "to": "UnknownOutcome"
    }
  ]
