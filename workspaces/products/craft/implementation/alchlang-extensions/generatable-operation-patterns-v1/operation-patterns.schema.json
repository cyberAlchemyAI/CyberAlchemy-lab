{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cav2:alchlang:operation-pattern-registry:schema:v1-candidate",
  "type": "object",
  "required": ["schema_version", "registry_id", "patterns", "authority_effect"],
  "properties": {
    "schema_version": { "const": "cav2.alchlang.operation-pattern-registry/v1-candidate" },
    "registry_id": { "type": "string", "minLength": 1 },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pattern_id", "architecture_pattern_status", "meta_type", "integration_binding", "generator", "conformance", "availability", "generated_artifacts", "blockers"],
        "properties": {
          "pattern_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "architecture_pattern_status": { "enum": ["candidate", "stable"] },
          "meta_type": { "$ref": "#/$defs/prerequisite" },
          "integration_binding": { "$ref": "#/$defs/prerequisite" },
          "generator": { "$ref": "#/$defs/prerequisite" },
          "conformance": { "$ref": "#/$defs/prerequisite" },
          "availability": { "enum": ["available", "blocked"] },
          "generated_artifacts": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "blockers": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        },
        "additionalProperties": false
      }
    },
    "authority_effect": { "const": "none" }
  },
  "$defs": {
    "prerequisite": {
      "type": "object",
      "required": ["id", "status"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "status": { "enum": ["closed", "open", "missing"] } },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
