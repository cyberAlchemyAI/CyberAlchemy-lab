# Candidate multi-entry assembly for compiled public policy functions.
# Open questions and remaining GET/stream work are owned by SERVICE-PLAN.md.
domain inference-policy-service "Inference policy service assembly"
profile service-v1
owner inference-router-owner

import CapabilitiesFunction from "./discovery/capabilities.alch"
import PublicErrorFunction from "./discovery/public-error.alch"

service InferencePolicyService:
  ontology "ALCH-INFERENCE-POLICY-SERVICE"
  meaning "Assemble compiled inference policy functions behind explicit, non-overlapping HTTP entry points."

entry Capabilities:
  function CapabilitiesFunction
  ontology "ALCH-INFERENCE-CAPABILITIES-ENTRY"
  meaning "Expose the compiled capability projection at its declared HTTP route."

entry PublicError:
  function PublicErrorFunction
  ontology "ALCH-INFERENCE-PUBLIC-ERROR-ENTRY"
  meaning "Expose the compiled public error projection at its declared HTTP route."
