# Candidate typed service function. Open questions: README.md.
domain health "Service health"
profile declarative-function-v1
portability node-rust-v1
owner inference-router-owner
logic sfol-v1
schema Input:
  unit: boolean const true
schema Health:
  status: string const "ok"
schema Output:
  status: string const "ok"
  value: Health

mapping HealthValue:
  meaning "Report process liveness without probing providers."
  target Health
  field status = "ok"
mapping Wrapped:
  meaning "Return liveness in the typed function envelope."
  target Output
  field status = "ok"
  field value = HealthValue
result Result:
  when true yield Wrapped

endpoint Function:
  target node-http
  runtime node>=26.8.1
  method POST
  path "/internal/health"
  input Input
  output Output
  result Result
  auth-env INFERENCE_INTERNAL_TOKEN
  max-bytes 65536
  timeout-ms 5000
  error-status 422
  status ok 200
