# Candidate generated public policy. Open questions: README.md.
domain authorized-catalog "Authorized tenant catalog"
profile declarative-function-v1
portability node-rust-v1
owner inference-router-owner
logic sfol-v1

schema Provider:
  binding_id: identifier max 128
  binding_version: identifier max 128
  model: identifier max 128
  enabled: boolean
  tenant_allowed: boolean
  task: string const "text.generate"
  context_limit: integer min 1 max 1000000
  output_limit: integer min 1 max 1000000
  streaming: boolean
  rank: integer min 0 max 1000000
schema Catalog:
  providers: Provider[] max 300
schema Output:
  status: string const "ok"
  providers: Provider[] max 300

query Authorized:
  meaning "Only enabled providers with a current affirmative tenant permission are visible."
  from row in input.providers
  where row.enabled and row.tenant_allowed
  select row
mapping List:
  meaning "Preserve eligible provider rows for compiled discovery and selection."
  target Output
  field status = "ok"
  field providers = Authorized
result Result:
  when true yield List

endpoint Function:
  target node-http
  runtime node>=26.8.1
  method POST
  path "/internal/authorized-catalog"
  input Catalog
  output Output
  result Result
  auth-env INFERENCE_INTERNAL_TOKEN
  max-bytes 262144
  timeout-ms 5000
  error-status 422
  status ok 200
