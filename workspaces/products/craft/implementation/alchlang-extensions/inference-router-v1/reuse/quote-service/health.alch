# Independent fixture; meanings and Open Questions: README.md.
domain quote-health "Quote health"
profile declarative-function-v1
portability node-rust-v1
owner service-fixture-owner
logic sfol-v1
schema Input:
  unit: boolean const true
schema Health:
  service: string const "quote"
schema Output:
  status: string const "ok"
  value: Health

mapping Healthy:
  meaning "Identify the live quote process."
  target Health
  field service = "quote"
mapping Wrapped:
  meaning "Return liveness without an operation call."
  target Output
  field status = "ok"
  field value = Healthy
result Result:
  when true yield Wrapped

endpoint Function:
  target node-http
  runtime node>=26.8.1
  method POST
  path "/internal/health"
  input Input
  output Output
  result Result
  auth-env QUOTE_INTERNAL_TOKEN
  max-bytes 65536
  timeout-ms 5000
  error-status 422
  status ok 200
