# Candidate provider SSE delta mapping. Open questions: STREAMING.md.
domain provider-stream-delta "Provider stream delta"
profile declarative-function-v1
portability node-rust-v1
owner inference-router-owner
logic sfol-v1

schema Input:
  text: string max 32768

schema Output:
  status: string const "mapped"
  text: string max 32768

mapping Delta:
  meaning "Preserve provider text fragments without mixing providers or repeating accumulated output."
  target Output
  field status = "mapped"
  field text = input.text

result Map:
  when true yield Delta

endpoint Mapper:
  target node-http
  runtime node>=26.8.1
  method POST
  path "/internal/provider-stream-delta"
  input Input
  output Output
  result Map
  auth-env INFERENCE_INTERNAL_TOKEN
  max-bytes 65536
  timeout-ms 5000
  error-status 422
  status mapped 200
