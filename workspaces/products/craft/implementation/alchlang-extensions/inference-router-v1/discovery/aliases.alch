# Candidate generated public policy. Open questions: README.md.
domain aliases "Public aliases"
profile declarative-function-v1
portability node-rust-v1
owner inference-router-owner
logic sfol-v1

schema Provider:
  binding_id: identifier max 128
  binding_version: identifier max 128
  model: identifier max 128
  enabled: boolean
  tenant_allowed: boolean
  task: string const "text.generate"
  context_limit: integer min 1 max 1000000
  output_limit: integer min 1 max 1000000
  streaming: boolean
  rank: integer min 0 max 1000000
schema Catalog:
  providers: Provider[] max 300
schema Output:
  status: string const "ok"
  aliases: identifier[] max 300

query Names:
  meaning "Select only enabled public aliases across configured strategies."
  from row in input.providers
  where row.enabled
  select row.model
mapping List:
  meaning "Return distinct aliases in portable lexical order."
  target Output
  field status = "ok"
  field aliases = sort(distinct(Names))
result Result:
  when true yield List

endpoint Function:
  target node-http
  runtime node>=26.8.1
  method POST
  path "/internal/aliases"
  input Catalog
  output Output
  result Result
  auth-env INFERENCE_INTERNAL_TOKEN
  max-bytes 262144
  timeout-ms 5000
  error-status 422
  status ok 200
