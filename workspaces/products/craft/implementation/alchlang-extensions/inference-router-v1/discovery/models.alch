# Candidate bounded pure iteration. Open questions: README.md.
domain models "Public model discovery"
profile query-iteration-v1
source-query "./aliases.alch"
source-field aliases
input-mapping "./summary-input.alch"
input-field value
item-query "./model-summary.alch"
item-field value
output-field models
max-items 100
max-output-bytes 65536
max-input-bytes 262144
timeout-ms 5000
concurrency 1
order input
partial-result reject
