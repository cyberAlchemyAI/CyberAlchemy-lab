schema Input:
  code: string max 256
  request_id: identifier max 128 optional
schema Error:
  code: string
schema Body:
  request_id: identifier max 128 optional
  error: Error
schema Output:
  status: string const "ok"
  http_status: integer min 400 max 599
  body: Body

mapping InvalidInputCode:
