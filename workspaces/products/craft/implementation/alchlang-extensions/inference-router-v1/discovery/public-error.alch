result Result:
  when input.code == "FORBIDDEN" yield ForbiddenResponse
  when input.code == "UNAUTHENTICATED" yield UnauthenticatedResponse
  when input.code == "INVALID_INPUT" yield InvalidInputResponse
  when input.code == "INVALID_IDEMPOTENCY_KEY" yield InvalidIdempotencyKeyResponse
  when input.code == "UNKNOWN_MODEL" yield UnknownModelResponse
  when input.code == "UNSUPPORTED_STRATEGY" yield UnsupportedStrategyResponse
  when input.code == "REQUEST_TOO_LARGE" yield RequestTooLargeResponse
  when input.code == "UNSUPPORTED_MEDIA_TYPE" yield UnsupportedMediaTypeResponse
  when input.code == "IDEMPOTENCY_CONFLICT" yield IdempotencyConflictResponse
  when input.code == "REQUEST_IN_PROGRESS" yield RequestInProgressResponse
  when input.code == "STREAM_NOT_REPLAYABLE" yield StreamNotReplayableResponse
  when input.code == "PREVIOUS_REQUEST_FAILED" yield PreviousRequestFailedResponse
  when input.code == "OVERLOADED" yield OverloadedResponse
  when input.code == "REQUEST_STORE_BUSY" yield RequestStoreBusyResponse
  when input.code == "REQUEST_STORE_FULL" yield RequestStoreFullResponse
  when input.code == "NO_ELIGIBLE_PROVIDER" yield NoEligibleProviderResponse
  when input.code == "DEADLINE_EXCEEDED" yield DeadlineExceededResponse
  when input.code == "CANCELLED" yield CancelledResponse
  when input.code == "PROVIDER_STATUS" yield ProviderStatusResponse
  when input.code == "PROVIDER_TRANSPORT_FAILED" yield ProviderTransportFailedResponse
  when input.code == "INVALID_PROVIDER_RESPONSE" yield InvalidProviderResponseResponse
  when input.code == "RESPONSE_TOO_LARGE" yield ResponseTooLargeResponse
  when input.code == "INVALID_STREAM_CONTENT_TYPE" yield InvalidStreamContentTypeResponse
  when input.code == "NOT_FOUND" yield NotFoundResponse
  when input.code == "METHOD_NOT_ALLOWED" yield MethodNotAllowedResponse
  when input.code != "FORBIDDEN" and input.code != "UNAUTHENTICATED" and input.code != "INVALID_INPUT" and input.code != "INVALID_IDEMPOTENCY_KEY" and input.code != "UNKNOWN_MODEL" and input.code != "UNSUPPORTED_STRATEGY" and input.code != "REQUEST_TOO_LARGE" and input.code != "UNSUPPORTED_MEDIA_TYPE" and input.code != "IDEMPOTENCY_CONFLICT" and input.code != "REQUEST_IN_PROGRESS" and input.code != "STREAM_NOT_REPLAYABLE" and input.code != "PREVIOUS_REQUEST_FAILED" and input.code != "OVERLOADED" and input.code != "REQUEST_STORE_BUSY" and input.code != "REQUEST_STORE_FULL" and input.code != "NO_ELIGIBLE_PROVIDER" and input.code != "DEADLINE_EXCEEDED" and input.code != "CANCELLED" and input.code != "PROVIDER_STATUS" and input.code != "PROVIDER_TRANSPORT_FAILED" and input.code != "INVALID_PROVIDER_RESPONSE" and input.code != "RESPONSE_TOO_LARGE" and input.code != "INVALID_STREAM_CONTENT_TYPE" and input.code != "NOT_FOUND" and input.code != "METHOD_NOT_ALLOWED" yield InternalErrorResponse

endpoint Function:
  target node-http
  runtime node>=26.8.1
  method POST
  path "/internal/public-error"
  input Input
  output Output
  result Result
  auth-env INFERENCE_INTERNAL_TOKEN
  max-bytes 262144
  timeout-ms 5000
  error-status 422
  status ok 200
