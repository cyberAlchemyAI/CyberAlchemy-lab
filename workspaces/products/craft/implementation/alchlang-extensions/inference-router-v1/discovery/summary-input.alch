# Candidate generated public policy. Open questions: README.md.
domain summary-input "Public summary-input"
profile declarative-function-v1
portability node-rust-v1
owner inference-router-owner
logic sfol-v1

schema Provider:
  binding_id: identifier max 128
  binding_version: identifier max 128
  model: identifier max 128
  enabled: boolean
  tenant_allowed: boolean
  task: string const "text.generate"
  context_limit: integer min 1 max 1000000
  output_limit: integer min 1 max 1000000
  streaming: boolean
  rank: integer min 0 max 1000000
schema Catalog:
  providers: Provider[] max 300
schema SummaryInput:
  providers: Provider[] max 300
  model: identifier
schema Input:
  context: Catalog
  item: identifier
schema Output:
  status: string const "ok"
  value: SummaryInput

mapping Argument:
  meaning "Bind one alias to the original catalog snapshot."
  target SummaryInput
  field providers = input.context.providers
  field model = input.item
mapping Wrapped:
  meaning "Expose the typed item-query argument."
  target Output
  field status = "ok"
  field value = Argument
result Result:
  when true yield Wrapped

endpoint Function:
  target node-http
  runtime node>=26.8.1
  method POST
  path "/internal/summary-input"
  input Input
  output Output
  result Result
  auth-env INFERENCE_INTERNAL_TOKEN
  max-bytes 262144
  timeout-ms 5000
  error-status 422
  status ok 200
