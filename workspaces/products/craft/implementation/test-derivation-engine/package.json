{
  "name": "@domainspec/test-derivation-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Deterministic test-derivation engine: compiles canonical feature docs into byte-stable test obligations (no LLM).",
  "engines": {
    "node": "26.8.1"
  },
  "main": "src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "typecheck:historical-backend": "tsc -p tsconfig.historical-backend.json",
    "typecheck:sfol": "tsc --noEmit -p tsconfig.sfol.json",
    "build": "node scripts/prepare-build.mjs && tsc -p tsconfig.json && node scripts/copy-build-assets.mjs && node scripts/verify-build.mjs",
    "test": "vitest run",
    "roundtrip": "tsx src/cli.ts roundtrip",
    "lint:docs": "tsx src/cli.ts lint",
    "sfol": "tsx src/sfol/cli.ts",
    "sfol:claim-cases": "tsx src/sfol/claim-cases/cli.ts",
    "sfol:native-link": "tsx src/sfol/claim-cases/native-link-cli.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "3.2.6",
    "tsx": "4.20.6"
  },
  "packageManager": "pnpm@10.34.5"
}
