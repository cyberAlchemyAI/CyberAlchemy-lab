{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:domainspec-v2:bte:logical-identity:v1",
  "title": "BTE Logical Identity v1",
  "description": "A versioned, domain-separated identity whose content digest is carried separately.",
  "type": "object",
  "required": ["schema_version", "domain", "namespace", "kind", "key", "version"],
  "properties": {
    "schema_version": { "const": "bte-logical-identity/v1" },
    "domain": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "namespace": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
    "kind": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "key": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$" },
    "version": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": false
}

