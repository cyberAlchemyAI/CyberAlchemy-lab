{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:domainspec-v2:bte:red-fixture-freeze-receipt:v1",
  "title": "BTE Red Fixture Freeze Receipt v1",
  "description": "A validation-owner freeze binding the exact red manifest to the exact contract publication.",
  "type": "object",
  "required": ["schema_version", "receipt_id", "manifest_handle", "contract_publication_receipt_handle", "validation_owner", "frozen_cases", "admission"],
  "properties": {
    "schema_version": { "const": "bte-red-fixture-freeze-receipt/v1" },
    "receipt_id": { "$ref": "urn:domainspec-v2:bte:logical-identity:v1" },
    "manifest_handle": { "$ref": "urn:domainspec-v2:bte:artifact-handle:v1" },
    "contract_publication_receipt_handle": { "$ref": "urn:domainspec-v2:bte:artifact-handle:v1" },
    "validation_owner": { "$ref": "urn:domainspec-v2:bte:authority-class:v1" },
    "frozen_cases": { "$ref": "urn:domainspec-v2:bte:exact-set:v1" },
    "admission": { "const": "not-granted" }
  },
  "additionalProperties": false
}

