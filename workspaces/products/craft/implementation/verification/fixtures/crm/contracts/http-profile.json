{
  "schema_version": "craft.generic-http-profile/v1-candidate",
  "id": "LocalCrmHttp",
  "target": "node-esm",
  "realization": "injected-request-response/v1-candidate",
  "capabilities": [
    "injected-http-get",
    "injected-http-post",
    "checked-response-mapping",
    "original-entry-auth"
  ],
  "application_profile": "contracts/selected-profile.json",
  "route_prefix": "/api",
  "limits": {
    "url_bytes": 4096,
    "header_bytes": 8192,
    "request_bytes": 65536,
    "response_bytes": 131072,
    "body_timeout_ms": 30000
  },
  "routes": [
    {
      "id": "LocalCrmHttp.Read",
      "service": "LocalCrmService",
      "entry": "LocalCrm.ReadStoredLeadEntry",
      "method": "GET",
      "path": "/leads/{id}",
      "query": [],
      "response_mapping": "LocalCrm.HttpLeadResponse"
    },
    {
      "id": "LocalCrmHttp.Qualify",
      "service": "LocalCrmService",
      "entry": "LocalCrm.CommitLeadQualificationEntry",
      "method": "POST",
      "path": "/lead-qualifications",
      "query": [],
      "response_mapping": "LocalCrm.HttpQualificationResponse"
    }
  ]
}
