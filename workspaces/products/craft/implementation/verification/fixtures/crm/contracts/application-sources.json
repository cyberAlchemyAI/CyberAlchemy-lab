{
  "schema": "craft.application-source-selection/v1",
  "roles": [
    {
      "role": "facts",
      "prefix": "facts-",
      "format": "json",
      "disclose": true
    },
    {
      "role": "evidence",
      "prefix": "evidence-",
      "format": "json",
      "disclose": true
    },
    {
      "role": "preferences",
      "prefix": "preferences-",
      "format": "json",
      "disclose": true
    },
    {
      "role": "approval",
      "prefix": "approval-",
      "format": "json",
      "disclose": false
    }
  ],
  "factsRole": "facts",
  "approvalRole": "approval",
  "policyId": "crm-processor",
  "target": {
    "sink": "hubspot",
    "recipient": "77",
    "recipientId": "5"
  },
  "projections": {
    "modelInput": {
      "subjectId": {
        "from": "id"
      },
      "sourceVersion": {
        "from": "sources.facts.revision"
      },
      "prompt": {
        "from": "sources.evidence.text"
      }
    },
    "review": {
      "objectVersion": {
        "from": "facts.objectVersion"
      },
      "identityVerified": {
        "from": "facts.identityVerified"
      },
      "contactAllowed": {
        "from": "facts.contactAllowed"
      },
      "duplicate": {
        "from": "facts.duplicate"
      },
      "expectedPreferenceVersion": {
        "from": "facts.expectedPreferenceVersion"
      },
      "strategic": {
        "from": "facts.strategic"
      },
      "primaryOwnerId": {
        "from": "facts.primaryOwnerId"
      },
      "secondaryOwnerId": {
        "from": "facts.secondaryOwnerId"
      },
      "currentPreferenceVersion": {
        "from": "sources.preferences.revision"
      },
      "evidence": {
        "each": "sources.evidence.json.items",
        "fields": {
          "sourceId": {
            "from": "item.sourceId"
          },
          "supportsIndustry": {
            "from": "item.supportsIndustry"
          },
          "industry": {
            "from": "item.industry"
          },
          "version": {
            "from": "sources.evidence.revision"
          },
          "permitted": {
            "literal": true
          }
        }
      }
    }
  }
}
