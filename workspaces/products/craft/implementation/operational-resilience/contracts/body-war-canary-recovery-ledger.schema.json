{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://domainspec.dev/orodi/body-war-canary-recovery-ledger.schema.json",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","run_id","project_name","effect_epoch","expected_resources","allowed_labels","ports","receipt_root","cleanup_executable_sha256","written_before_first_effect","recovery_status","authority_effect"],
  "properties":{
    "schema_version":{"const":"domainspec.orodi.body-war-canary-recovery-ledger/v1"},
    "run_id":{"type":"string","minLength":1},
    "project_name":{"type":"string","pattern":"^orodi-bw-"},
    "effect_epoch":{"type":"integer","minimum":0,"maximum":7},
    "expected_resources":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "allowed_labels":{"type":"object","additionalProperties":{"type":"string"}},
    "ports":{"type":"array","minItems":5,"maxItems":5,"uniqueItems":true,"items":{"type":"integer"}},
    "receipt_root":{"type":"string","minLength":1},
    "cleanup_executable_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "written_before_first_effect":{"const":true},
    "recovery_status":{"enum":["prepared","effect-known","cleanup-required","recovered","blocked-unknown-effect"]},
    "authority_effect":{"const":"none"}
  }
}
