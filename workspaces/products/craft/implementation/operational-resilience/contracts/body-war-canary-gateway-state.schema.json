{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://domainspec.dev/orodi/body-war-canary-gateway-state.schema.json",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","generation","stable_target","candidate_target","stable_weight","candidate_weight","candidate_fault_active","last_transition_at","authority_effect"],
  "properties":{
    "schema_version":{"const":"domainspec.orodi.body-war-canary-gateway-state/v1"},
    "generation":{"type":"integer","minimum":0,"maximum":9007199254740991},
    "stable_target":{"type":"string","minLength":1},
    "candidate_target":{"type":["string","null"]},
    "stable_weight":{"type":"integer","enum":[90,100]},
    "candidate_weight":{"type":"integer","enum":[0,10]},
    "candidate_fault_active":{"type":"boolean"},
    "last_transition_at":{"type":"string","format":"date-time"},
    "authority_effect":{"const":"none"}
  }
}
