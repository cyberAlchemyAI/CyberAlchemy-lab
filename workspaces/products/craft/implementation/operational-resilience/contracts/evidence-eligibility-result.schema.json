{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:domainspec:orodi:evidence-eligibility-result:v1",
  "title": "ORODI Candidate-Local Legacy-v1 Evidence Eligibility Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gate_id",
    "gate_version",
    "evidence_lane",
    "replay_id",
    "evaluated_at",
    "decision",
    "runtime_admission",
    "replay_observations",
    "runtime_admitted_observations",
    "eligibility_receipts",
    "derived_result",
    "findings",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {"const": "domainspec.orodi.evidence-eligibility-result/v1"},
    "gate_id": {"const": "domainspec.orodi.legacy-v1-evidence-eligibility"},
    "gate_version": {"const": "1.0.0-candidate-local"},
    "evidence_lane": {"const": "candidate-local-prototype"},
    "replay_id": {"type": "string", "minLength": 1},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "decision": {"enum": ["replay-only", "runtime-eligible", "rejected"]},
    "runtime_admission": {"const": "denied"},
    "replay_observations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/observation"}
    },
    "runtime_admitted_observations": {
      "type": "array",
      "maxItems": 0,
      "items": {"$ref": "#/$defs/observation"}
    },
    "eligibility_receipts": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/eligibilityReceipt"}
    },
    "derived_result": {
      "anyOf": [
        {"$ref": "#/$defs/derivedResult"},
        {"type": "null"}
      ]
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/evaluationFinding"}
    },
    "authority_effect": {"const": "none"}
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "rejected"}}, "required": ["decision"]},
      "then": {
        "properties": {
          "replay_observations": {"maxItems": 0},
          "runtime_admitted_observations": {"maxItems": 0},
          "eligibility_receipts": {"maxItems": 0},
          "derived_result": {"type": "null"},
          "findings": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"decision": {"const": "replay-only"}}, "required": ["decision"]},
      "then": {
        "properties": {
          "replay_observations": {"minItems": 1},
          "runtime_admitted_observations": {"maxItems": 0},
          "eligibility_receipts": {"minItems": 1},
          "derived_result": {"$ref": "#/$defs/derivedResult"},
          "findings": {"maxItems": 0}
        }
      }
    }
  ],
  "$defs": {
    "foundationalControlId": {"enum": ["C01", "C05", "C11", "C12", "C14", "C15"]},
    "evidenceState": {"enum": ["passed", "failed", "missing", "invalid", "inconclusive", "stale", "not-run"]},
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offered", "queued", "exported", "rejected", "dropped", "pending", "partial_success"],
      "properties": {
        "offered": {"type": "integer", "minimum": 0},
        "queued": {"type": "integer", "minimum": 0},
        "exported": {"type": "integer", "minimum": 0},
        "rejected": {"type": "integer", "minimum": 0},
        "dropped": {"type": "integer", "minimum": 0},
        "pending": {"type": "integer", "minimum": 0},
        "partial_success": {"type": "integer", "minimum": 0}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "observation_id", "plane", "kind", "mode", "correlation_id",
        "attributes", "attribute_allowlist", "cardinality", "telemetry", "deployment_effect",
        "independently_observed", "observed_at", "invalidation_key_digest"
      ],
      "properties": {
        "schema_version": {"const": "domainspec.orodi.observation/v1"},
        "observation_id": {"type": "string", "minLength": 1},
        "plane": {"enum": ["product", "workflow"]},
        "kind": {"enum": ["metric", "trace", "log", "health", "deployment-effect", "rollback-effect"]},
        "mode": {"enum": ["simulation", "live"]},
        "correlation_id": {"type": "string", "minLength": 1},
        "attributes": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "attribute_allowlist": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "cardinality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observed", "budget"],
          "properties": {
            "observed": {"type": "integer", "minimum": 0},
            "budget": {"type": "integer", "minimum": 0}
          }
        },
        "telemetry": {"$ref": "#/$defs/telemetry"},
        "deployment_effect": {"type": "boolean"},
        "independently_observed": {"type": "boolean"},
        "observed_at": {"type": "string", "format": "date-time"},
        "invalidation_key_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "eligibilityReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "observation_id", "source_shape_id", "decision",
        "eligible_controls", "ineligible_controls", "reason_codes", "authority_effect"
      ],
      "properties": {
        "schema_version": {"const": "domainspec.orodi.evidence-eligibility-receipt/v1"},
        "observation_id": {"type": "string", "minLength": 1},
        "source_shape_id": {"type": "string", "minLength": 1},
        "decision": {"enum": ["replay-only", "runtime-eligible", "rejected"]},
        "eligible_controls": {
          "type": "array",
          "maxItems": 0,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/foundationalControlId"}
        },
        "ineligible_controls": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/foundationalControlId"}
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "authority_effect": {"const": "none"}
      }
    },
    "derivedFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "detail"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "detail": {"type": "string", "minLength": 1}
      }
    },
    "derivedControlReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "control_id", "state", "evaluator_id", "rule_version",
        "observation_refs", "evaluated_at", "expires_at", "invalidation_key_digest",
        "findings", "authority_effect"
      ],
      "properties": {
        "schema_version": {"const": "domainspec.orodi.derived-control-receipt/v1"},
        "control_id": {"$ref": "#/$defs/foundationalControlId"},
        "state": {"$ref": "#/$defs/evidenceState"},
        "evaluator_id": {"type": "string", "pattern": "^domainspec\\.orodi\\.c(01|05|11|12|14|15)-evaluator$"},
        "rule_version": {"const": "1.0.0-candidate-local"},
        "observation_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "evaluated_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "invalidation_key_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/derivedFinding"}},
        "authority_effect": {"const": "none"}
      }
    },
    "mismatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_id", "claimed_state", "derived_state", "code"],
      "properties": {
        "control_id": {"$ref": "#/$defs/foundationalControlId"},
        "claimed_state": {
          "anyOf": [{"$ref": "#/$defs/evidenceState"}, {"type": "null"}]
        },
        "derived_state": {"$ref": "#/$defs/evidenceState"},
        "code": {"type": "string", "minLength": 1}
      }
    },
    "evaluationFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path", "detail"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "detail": {"type": "string", "minLength": 1}
      }
    },
    "derivedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "validator_id", "validator_version", "evidence_lane", "binding_id",
        "evaluated_at", "verdict", "comparison", "derived_controls", "mismatches",
        "findings", "authority_effect"
      ],
      "properties": {
        "schema_version": {"const": "domainspec.orodi.derived-control-set-result/v1"},
        "validator_id": {"const": "domainspec.orodi.foundational-derived-validator"},
        "validator_version": {"const": "1.0.0-candidate-local"},
        "evidence_lane": {"const": "candidate-local-prototype"},
        "binding_id": {"type": "string", "minLength": 1},
        "evaluated_at": {"type": "string", "format": "date-time"},
        "verdict": {"enum": ["pass", "reject"]},
        "comparison": {"enum": ["match", "mismatch", "unavailable"]},
        "derived_controls": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/derivedControlReceipt"}
        },
        "mismatches": {
          "type": "array",
          "maxItems": 6,
          "items": {"$ref": "#/$defs/mismatch"}
        },
        "findings": {"type": "array", "items": {"$ref": "#/$defs/evaluationFinding"}},
        "authority_effect": {"const": "none"}
      }
    }
  }
}
