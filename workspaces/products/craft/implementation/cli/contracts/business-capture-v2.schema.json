{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "craft.business-capture/v2-candidate",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "craft.business-capture/v2-candidate"
    },
    "source": {
      "$ref": "#/$defs/source_identity"
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/profile_identity"
      },
      "minItems": 1,
      "maxItems": 64
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tool_identity"
      },
      "minItems": 1,
      "maxItems": 64
    },
    "recipe_ref": {
      "const": "direct-entity-bool-operation/v2-candidate"
    },
    "authority_effect": {
      "const": "none"
    }
  },
  "required": [
    "schema_version",
    "source",
    "profiles",
    "tools",
    "recipe_ref",
    "authority_effect"
  ],
  "$comment": "Data shape only; original private custody and actual currentness are mandatory later owner checks. Open Questions: docs/BUSINESS-IDENTITIES-V2.md.",
  "$defs": {
    "profile_identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,127}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ]
    },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:\\u0000-\\u001f\\u007f])[^/]+(?:/[^/]+)*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes"
      ]
    },
    "tool_identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,127}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "sha256"
      ]
    }
  }
}
