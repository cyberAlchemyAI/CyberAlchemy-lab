{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "craft.operation-json-post/v1-candidate",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "craft.operation-json-post/v1-candidate"
    },
    "method": {
      "const": "POST"
    },
    "body": {
      "const": "whole-input"
    },
    "route_prefix": {
      "type": "string",
      "pattern": "^/(?:[A-Za-z][A-Za-z0-9_-]*/)*$",
      "maxLength": 256
    },
    "request_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60000
    }
  },
  "required": [
    "schema_version",
    "method",
    "body",
    "route_prefix",
    "request_bytes",
    "timeout_ms"
  ],
  "$defs": {},
  "description": "Closed candidate authoring contract. No acceptance, proof or admission follows from shape validation. Open questions: docs/BUSINESS-AUTHORING-CONTRACTS.md."
}
