{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/deployment-recipe-receipt/v1",
  "title": "DomainSpec deployment recipe receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "target", "project_id", "source_manifest_sha256", "compiled_certificate_sha256", "checked_interchange_sha256", "request_sha256", "target_implementation_sha256", "manifest_sha256", "plan_sha256", "artifact_count", "authority_effect", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "domainspec.deployment-recipe-receipt/v1"},
    "request_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "target": {"const": "aws-ecs-fargate-postgres-v1"},
    "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "source_manifest_sha256": {"$ref": "#/$defs/sha"},
    "compiled_certificate_sha256": {"$ref": "#/$defs/sha"},
    "checked_interchange_sha256": {"$ref": "#/$defs/sha"},
    "request_sha256": {"$ref": "#/$defs/sha"},
    "target_implementation_sha256": {"$ref": "#/$defs/sha"},
    "manifest_sha256": {"$ref": "#/$defs/sha"},
    "plan_sha256": {"$ref": "#/$defs/sha"},
    "artifact_count": {"type": "integer", "minimum": 1},
    "authority_effect": {"const": "none"},
    "receipt_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
