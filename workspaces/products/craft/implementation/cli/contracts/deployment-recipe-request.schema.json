{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/deployment-recipe-request/v1",
  "title": "DomainSpec deployment recipe request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "target", "application", "integration_binding_ids", "environment", "authority_effect"],
  "properties": {
    "schema_version": {"const": "domainspec.deployment-recipe-request/v1"},
    "request_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 30},
    "target": {"const": "aws-ecs-fargate-postgres-v1"},
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "source_root", "lockfile", "base_image", "api", "worker", "consumer", "domain_migrations_root"],
      "properties": {
        "language": {"const": "typescript"},
        "source_root": {"$ref": "#/$defs/relativePath"},
        "lockfile": {"$ref": "#/$defs/relativePath"},
        "base_image": {"type": "string", "pattern": "^[a-z0-9./_-]+:[A-Za-z0-9._-]+@sha256:[a-f0-9]{64}$"},
        "api": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entrypoint", "port", "health_path"],
          "properties": {
            "entrypoint": {"$ref": "#/$defs/entrypoint"},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "health_path": {"type": "string", "pattern": "^/(?!.*//)[A-Za-z0-9._~!$&'()*+,;=:@%/-]*$", "maxLength": 256}
          }
        },
        "worker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entrypoint"],
          "properties": {"entrypoint": {"$ref": "#/$defs/entrypoint"}}
        },
        "consumer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entrypoint"],
          "properties": {"entrypoint": {"$ref": "#/$defs/entrypoint"}}
        },
        "domain_migrations_root": {"$ref": "#/$defs/relativePath"}
      }
    },
    "integration_binding_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name_variable", "aws_region_variable"],
      "properties": {
        "name_variable": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "aws_region_variable": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
      }
    },
    "authority_effect": {"const": "none"}
  },
  "$defs": {
    "relativePath": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$", "minLength": 1, "maxLength": 512},
    "entrypoint": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\r\\n\\u0000]+$"}}
  }
}
