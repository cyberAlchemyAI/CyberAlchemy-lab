{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "craft.profile-lock/v1"
    },
    "engine_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "tool_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "asset_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "sha256",
          "asset_sha256"
        ]
      },
      "minItems": 1,
      "maxItems": 128
    },
    "lock_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "engine_sha256",
    "tool_sha256",
    "source_sha256",
    "packages",
    "lock_sha256"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "craft.profile-lock/v1",
  "description": "Versioned finite profile engine construction contract. Open questions: docs/PROFILE-AUTHORING.md."
}
