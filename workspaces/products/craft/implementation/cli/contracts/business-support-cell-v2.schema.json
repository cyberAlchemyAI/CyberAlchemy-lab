{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "craft.business-support-cell/v2-candidate",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "craft.business-support-cell/v2-candidate"
    },
    "cell_id": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,127}$"
    },
    "source_contract": {
      "const": "alchlang.business-spec/v2-candidate"
    },
    "recipe": {
      "const": "direct-entity-bool-operation/v2-candidate"
    },
    "descriptor": {
      "const": "node-http-entry-u0-v4"
    },
    "abi": {
      "const": "craft.u0.pure-submission/v1-candidate"
    },
    "entry_access": {
      "const": "public"
    },
    "effects": {
      "const": "none"
    },
    "evidence": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "stage": {
                "const": "declared"
              },
              "contract_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "stage",
              "contract_ref"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "stage": {
                "const": "generated"
              },
              "artifact_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "producer_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "stage",
              "artifact_sha256",
              "producer_sha256"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "stage": {
                "const": "native-observed"
              },
              "subject_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "producer_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "receipt_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "stage",
              "subject_sha256",
              "producer_sha256",
              "receipt_sha256"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "stage": {
                "const": "installed-tested"
              },
              "candidate_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "runner_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "receipt_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "stage",
              "candidate_sha256",
              "runner_sha256",
              "receipt_sha256"
            ]
          }
        ]
      },
      "minItems": 1,
      "maxItems": 256
    },
    "authority_effect": {
      "const": "none"
    }
  },
  "required": [
    "schema_version",
    "cell_id",
    "source_contract",
    "recipe",
    "descriptor",
    "abi",
    "entry_access",
    "effects",
    "evidence",
    "authority_effect"
  ],
  "$comment": "Data contract only; actual original owners/artifact bytes/observations and currentness are separately checked. Open Questions: docs/BUSINESS-COVERAGE-V2.md."
}
