{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "craft.business-authoring-lock/v2-candidate",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "craft.business-authoring-lock/v2-candidate"
    },
    "model_id": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,127}$"
    },
    "capture_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "executable_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "assurance_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "basis_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "selection_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "review_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decision_file_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "entry_intent_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "authority_effect": {
      "const": "none"
    },
    "lock_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "model_id",
    "capture_sha256",
    "executable_sha256",
    "assurance_sha256",
    "basis_sha256",
    "selection_sha256",
    "review_sha256",
    "decision_file_sha256",
    "entry_intent_sha256",
    "authority_effect",
    "lock_sha256"
  ],
  "$comment": "Data shape only; original private custody and actual currentness are mandatory later owner checks. Open Questions: docs/BUSINESS-IDENTITIES-V2.md."
}
