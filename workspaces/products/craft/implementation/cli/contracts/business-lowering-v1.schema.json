{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "craft.business-lowering/v1-candidate",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "craft.business-lowering/v1-candidate"
    },
    "recipe_ref": {
      "const": "ground-entity-bool-operation/v1-candidate"
    },
    "business_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "lock_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "origins": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/origin"
            },
            "minItems": 1,
            "maxItems": 16
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "artifact": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))[^/]+(?:/[^/]+)*$"
              },
              "pointer": {
                "type": "string",
                "minLength": 0,
                "maxLength": 4096
              }
            },
            "required": [
              "artifact",
              "pointer"
            ]
          }
        },
        "required": [
          "id",
          "origins",
          "target"
        ]
      },
      "minItems": 1,
      "maxItems": 10000
    },
    "authority_effect": {
      "const": "none"
    }
  },
  "required": [
    "schema_version",
    "recipe_ref",
    "business_sha256",
    "lock_sha256",
    "entries",
    "authority_effect"
  ],
  "$defs": {
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "business",
            "owner-decision",
            "semantic-adapter",
            "profile"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "selector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "kind",
        "source",
        "selector",
        "sha256"
      ]
    }
  },
  "description": "Closed candidate authoring contract. No acceptance, proof or admission follows from shape validation. Open questions: docs/BUSINESS-AUTHORING-CONTRACTS.md."
}
