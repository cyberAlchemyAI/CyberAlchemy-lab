{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "craft.business-authoring-lock/v1-candidate",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "craft.business-authoring-lock/v1-candidate"
    },
    "engine_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "tool_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decision_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,127}$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "asset_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "version",
          "sha256",
          "asset_sha256"
        ]
      },
      "minItems": 1,
      "maxItems": 128
    },
    "lock_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "engine_sha256",
    "tool_sha256",
    "source_sha256",
    "decision_sha256",
    "packages",
    "lock_sha256"
  ],
  "$defs": {},
  "description": "Closed candidate authoring contract. No acceptance, proof or admission follows from shape validation. Open questions: docs/BUSINESS-AUTHORING-CONTRACTS.md."
}
