{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "craft.profile-project/v2-candidate"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
    },
    "domain_sources": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_./-]*\\.alch$"
      }
    },
    "public_intents": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
          },
          "source": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_./-]*\\.alch$"
          },
          "result_ref": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
          },
          "input_ref": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
          },
          "output_ref": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
          },
          "access": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "public"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "policy"
                  },
                  "policy_ref": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
                  }
                },
                "required": [
                  "kind",
                  "policy_ref"
                ]
              }
            ]
          },
          "outcomes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
                },
                "kind": {
                  "enum": [
                    "success",
                    "business-rejection"
                  ]
                }
              },
              "required": [
                "code",
                "kind"
              ]
            }
          }
        },
        "required": [
          "id",
          "source",
          "result_ref",
          "input_ref",
          "output_ref",
          "access",
          "outcomes"
        ]
      }
    },
    "external_reads": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
          },
          "source": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_./-]*\\.alch$"
          },
          "output_ref": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
          },
          "request_fields": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "pattern": "^input\\.[A-Za-z][A-Za-z0-9_]*$"
            }
          }
        },
        "required": [
          "id",
          "source",
          "output_ref",
          "request_fields"
        ]
      }
    },
    "formal_claims": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
          },
          "source": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_./-]*\\.alch$"
          },
          "selector": {
            "type": "string",
            "pattern": "^(entity|calculation|rule|mapping|result|schema|policy):[A-Za-z][A-Za-z0-9_]*$"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "id",
          "source",
          "selector",
          "statement"
        ]
      }
    },
    "integration_configuration": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "id",
          "version",
          "path"
        ]
      }
    },
    "application_calls": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "operation_ref",
          "mapping_binding_ref",
          "access"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
          },
          "source": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_./-]*\\.alch$"
          },
          "operation_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "mapping_binding_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "access": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "public"
              }
            }
          }
        }
      }
    },
    "application_models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
          },
          "source": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_./-]*\\.alch$"
          },
          "semantics": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "id",
          "source",
          "semantics"
        ]
      },
      "minItems": 0,
      "maxItems": 16
    },
    "application_intents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
          },
          "application_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
          },
          "operation_ref": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,127}$"
          },
          "mapping_ref": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,127}$"
          },
          "mapping_arguments": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 32,
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,127}$"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "root": {
                  "type": "string",
                  "enum": [
                    "body",
                    "request",
                    "value"
                  ]
                },
                "path": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,127}$"
                  },
                  "minItems": 0,
                  "maxItems": 32
                }
              },
              "required": [
                "root",
                "path"
              ]
            }
          },
          "access": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "public"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "id",
          "application_id",
          "operation_ref",
          "mapping_ref",
          "mapping_arguments",
          "access"
        ]
      },
      "minItems": 0,
      "maxItems": 16
    }
  },
  "required": [
    "schema_version",
    "id",
    "domain_sources",
    "public_intents",
    "external_reads",
    "formal_claims",
    "profiles",
    "application_models",
    "application_intents"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "craft.profile-project/v2-candidate",
  "description": "Versioned business-only application inputs. Explicit accepted business meanings; claim proof absent. Open questions: docs/BUSINESS-APPLICATIONS.md."
}
