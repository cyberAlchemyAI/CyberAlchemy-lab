{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "craft.business-output/v2-candidate",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "craft.business-output/v2-candidate"
    },
    "mode": {
      "const": "code-only"
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "code",
              "api-contracts",
              "business-graph",
              "system-graph",
              "business-system-bridge",
              "base-model",
              "conjecture-problems"
            ]
          },
          "requiredness": {
            "enum": [
              "required",
              "optional"
            ]
          },
          "state": {
            "enum": [
              "pending-producer",
              "unsupported-optional"
            ]
          }
        },
        "required": [
          "kind",
          "requiredness",
          "state"
        ]
      },
      "minItems": 1,
      "maxItems": 7
    },
    "authority_effect": {
      "const": "none"
    }
  },
  "required": [
    "schema_version",
    "mode",
    "outputs",
    "authority_effect"
  ],
  "$comment": "Data contract only; actual original owners/artifact bytes/observations and currentness are separately checked. Open Questions: docs/BUSINESS-COVERAGE-V2.md."
}
