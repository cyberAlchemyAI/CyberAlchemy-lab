{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "domainspec.request-application-source/v1-candidate"
    },
    "source_id": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "operation_ref": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "mapping_ref": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "mapping_arguments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "parameter": {
                  "type": "string",
                  "maxLength": 256,
                  "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
                },
                "path": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 256,
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                  },
                  "minItems": 0,
                  "maxItems": 32
                }
              },
              "required": [
                "parameter",
                "path"
              ]
            },
            "minItems": 0,
            "maxItems": 32
          },
          "request_parameter": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "route": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "method": {
                "const": "POST"
              },
              "path": {
                "type": "string",
                "maxLength": 256,
                "pattern": "^/[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*$"
              }
            },
            "required": [
              "method",
              "path"
            ]
          },
          "access": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "public"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "id",
          "operation_ref",
          "mapping_ref",
          "mapping_arguments",
          "request_parameter",
          "route",
          "access"
        ]
      },
      "minItems": 1,
      "maxItems": 32
    }
  },
  "required": [
    "schema_version",
    "source_id",
    "entries"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/contracts/request-application-source-v1.schema.json",
  "description": "Closed adapter-derived carrier; constructor enforces uniqueness and checked graph joins. Open questions: business application BA05/06/18."
}
