{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "craft.business-decision/v2-candidate",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "craft.business-decision/v2-candidate"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,127}$"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "outcome": {
      "enum": [
        "accepted",
        "declined"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "canonicalization": {
          "const": "craft.business-review-keysort/v2"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "algorithm",
        "canonicalization",
        "sha256"
      ]
    },
    "capture_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "executable_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "assurance_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "authority_effect": {
      "const": "none"
    }
  },
  "required": [
    "schema_version",
    "decision_id",
    "owner",
    "outcome",
    "subject",
    "capture_sha256",
    "executable_sha256",
    "assurance_sha256",
    "authority_effect"
  ],
  "$comment": "Data shape only; original private custody and actual currentness are mandatory later owner checks. Open Questions: docs/BUSINESS-IDENTITIES-V2.md."
}
