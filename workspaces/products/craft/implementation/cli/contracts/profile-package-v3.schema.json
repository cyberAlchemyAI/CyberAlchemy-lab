  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "craft.profile-package/v3-candidate",
  "description": "V3 captured authoring package; reuses explicit v2 Operation technical role contracts, not v2 loading semantics. No dynamic recipes. Open questions: docs/BUSINESS-AUTHORING-CONTRACTS.md."
}
