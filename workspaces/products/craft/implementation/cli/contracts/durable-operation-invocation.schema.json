{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/contracts/durable-operation-invocation.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "invocation_id", "selector", "operation_input", "transaction"],
  "properties": {
    "schema_version": {"const": "domainspec.durable-operation-invocation/v1"},
    "invocation_id": {"type": "string", "minLength": 1},
    "selector": {"type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"},
    "operation_input": {"type": "object"},
    "transaction": {"type": "object", "additionalProperties": false, "required": ["aggregate_type", "aggregate_id", "expected_version", "occurred_at", "event_ids", "event_payloads", "max_attempts"], "properties": {
      "aggregate_type": {"type": "string", "minLength": 1}, "aggregate_id": {"type": "string", "minLength": 1}, "expected_version": {"type": "integer", "minimum": 0}, "occurred_at": {"type": "string", "format": "date-time"}, "event_ids": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}, "event_payloads": {"type": "object", "additionalProperties": {"type": "object"}}, "max_attempts": {"type": "integer", "minimum": 1}
    }}
  }
}
