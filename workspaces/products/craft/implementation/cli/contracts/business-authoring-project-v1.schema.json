{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "craft.business-authoring-project/v1-candidate",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "craft.business-authoring-project/v1-candidate"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,127}$"
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,127}$"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))[^/]+(?:/[^/]+)*$"
          }
        },
        "required": [
          "id",
          "source"
        ]
      },
      "minItems": 1,
      "maxItems": 16
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,127}$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))[^/]+(?:/[^/]+)*$"
          }
        },
        "required": [
          "id",
          "version",
          "path"
        ]
      },
      "minItems": 1,
      "maxItems": 128
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "model_id": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,127}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))[^/]+(?:/[^/]+)*$"
          }
        },
        "required": [
          "model_id",
          "path"
        ]
      },
      "minItems": 0,
      "maxItems": 16
    }
  },
  "required": [
    "schema_version",
    "id",
    "models",
    "profiles",
    "decisions"
  ],
  "$defs": {},
  "description": "Closed candidate authoring contract. No acceptance, proof or admission follows from shape validation. Open questions: docs/BUSINESS-AUTHORING-CONTRACTS.md."
}
