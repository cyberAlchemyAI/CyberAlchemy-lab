              "const": "craft.generic-service-artifacts/v1-candidate"
            },
            "package_schema": {
              "const": "craft.generic-service-artifacts/v1-candidate"
            },
            "status": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "source": {
              "$ref": "#/$defs/RelativePath"
            },
            "effect_scope": {
              "type": "string",
