{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/contracts/product-capabilities.schema.json",
  "title": "DomainSpec product capabilities v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "product_spine",
    "stable_commands",
    "experimental_commands",
    "authoring",
    "compiled_meta_types",
    "supported_languages",
    "limits",
    "runtime",
    "deployment_recipe",
    "recipe_qualification",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {
      "const": "domainspec.product-capabilities/v1"
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "version",
        "lifecycle"
      ],
      "properties": {
        "package": {
          "const": "@domainspec-v2/cli"
        },
        "version": {
          "type": "string",
          "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
        },
        "lifecycle": {
          "const": "stable"
        }
      }
    },
    "product_spine": {
      "const": "authored-source-to-compiled-graph-to-generated-targets-and-certificates"
    },
    "stable_commands": {
      "const": [
        "add",
        "instantiate",
        "instantiate-project",
        "verify-project",
        "verify-runtime",
        "compile",
        "build",
        "verify",
        "formalize",
        "formalize-check",
        "certify",
        "certify-check",
        "lint",
        "receipt",
        "capabilities",
        "doctor",
        "recipe-plan",
        "recipe-generate",
        "recipe-verify",
        "recipe-qualification-plan",
        "recipe-qualify",
        "recipe-qualification-verify"
      ]
    },
    "experimental_commands": {
      "const": [
        "run"
      ]
    },
    "authoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structured_cli_meta_types",
        "source_json_meta_types"
      ],
      "properties": {
        "structured_cli_meta_types": {
          "const": [
            "Operation",
            "Query",
            "Calculation",
            "Rule",
            "Policy",
            "Mapping"
          ]
        },
        "source_json_meta_types": {
          "const": [
            "Entity",
            "Value Object",
            "Enum",
            "Operation",
            "Query",
            "Calculation",
            "Rule",
            "Policy",
            "Workflow",
            "Interface",
            "Event",
            "Mapping",
            "State Machine"
          ]
        }
      }
    },
    "compiled_meta_types": {
      "const": [
        "Entity",
        "Value Object",
        "Enum",
        "Operation",
        "Query",
        "Calculation",
        "Rule",
        "Policy",
        "Workflow",
        "Interface",
        "Event",
        "Mapping",
        "State Machine"
      ]
    },
    "supported_languages": {
      "const": [
        "typescript",
        "python",
        "rust"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_file_bytes",
        "project_sources",
        "project_nodes",
        "project_relationships",
        "json_depth",
        "subprocess_timeout_ms"
      ],
      "properties": {
        "source_file_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "project_sources": {
          "type": "integer",
          "minimum": 1
        },
        "project_nodes": {
          "type": "integer",
          "minimum": 1
        },
        "project_relationships": {
          "type": "integer",
          "minimum": 1
        },
        "json_depth": {
          "type": "integer",
          "minimum": 1
        },
        "subprocess_timeout_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifecycle",
        "package_subpath"
      ],
      "properties": {
        "lifecycle": {
          "const": "experimental"
        },
        "package_subpath": {
          "const": "@domainspec-v2/cli/experimental/runtime"
        }
      }
    },
    "deployment_recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifecycle",
        "target",
        "messaging",
        "effects"
      ],
      "properties": {
        "lifecycle": {
          "const": "candidate"
        },
        "target": {
          "const": "aws-ecs-fargate-postgres-v1"
        },
        "messaging": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lifecycle",
            "provider",
            "guarantees"
          ],
          "properties": {
            "lifecycle": {
              "const": "candidate"
            },
            "provider": {
              "const": "aws-sqs"
            },
            "guarantees": {
              "const": [
                "at-least-once",
                "provider-acceptance-only"
              ]
            }
          }
        },
        "effects": {
          "const": "none"
        }
      }
    },
    "recipe_qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifecycle",
        "ontology_id",
        "qualification_level",
        "result_domain",
        "effect_ceiling",
        "effects"
      ],
      "properties": {
        "lifecycle": {
          "const": "candidate"
        },
        "ontology_id": {
          "const": "domainspec.recipe-qualification-ontology@1"
        },
        "qualification_level": {
          "const": "recipe-executable-v1"
        },
        "result_domain": {
          "const": [
            "pass",
            "fail",
            "not_evaluable"
          ]
        },
        "effect_ceiling": {
          "const": "no-external-effect"
        },
        "effects": {
          "const": "none"
        }
      }
    },
    "authority_effect": {
      "const": "none"
    },
    "profile_engine": {
      "const": {
        "lifecycle": "candidate",
        "library": "profileEngine",
        "frontend": "alchlang profile",
        "workflow": [
          "select",
          "check",
          "plan",
          "generate",
          "view",
          "verify"
        ],
        "target": "node-http",
        "external_effects": "read-only GET functions and zero-effects application invocation",
        "claim_ceiling": "checked generation; formal claims and operational admission unproved",
        "deferred": [
          "local hosting",
          "TDE",
          "EVF",
          "publication"
        ],
        "project_versions": [
          "craft.profile-project/v1",
          "craft.profile-project/v2-candidate"
        ],
        "business_applications": "Mapping-to-Operation; no reads/writes/events",
        "profile_extension": "registered mechanisms through locked metadata/assets"
      }
    },
    "computation": {
      "const": {
        "lifecycle": "candidate",
        "command": "computation",
        "source_contract": "domainspec.computation-source/v1-candidate",
        "semantics": "ordered-metered-v1-candidate",
        "target": "typescript",
        "pure": true,
        "effects": "none"
      }
    }
  }
}
