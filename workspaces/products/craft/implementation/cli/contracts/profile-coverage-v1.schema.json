{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "craft.profile-coverage/v1"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "lock_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "origin": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "business",
                  "profile-rule",
                  "integration-configuration"
                ]
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "selector": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false,
            "required": [
              "kind",
              "source",
              "selector",
              "sha256"
            ]
          },
          "kind": {
            "enum": [
              "business-obligation",
              "public-intent",
              "access-policy",
              "integration-binding",
              "generated-role",
              "formal-claim"
            ]
          },
          "state": {
            "enum": [
              "retained",
              "unsupported-required",
              "claim-residue"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "artifact_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "minItems": 0,
            "maxItems": 256
          },
          "evidence_states": {
            "type": "array",
            "items": {
              "enum": [
                "linked",
                "generated",
                "statically-checked",
                "finite-observed",
                "proved",
                "admitted"
              ]
            },
            "minItems": 0,
            "maxItems": 6
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "origin",
          "kind",
          "state",
          "reason",
          "artifact_refs",
          "evidence_states"
        ]
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "authority_effect": {
      "const": "none"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_sha256",
    "lock_sha256",
    "items",
    "authority_effect"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "craft.profile-coverage/v1",
  "description": "Versioned finite profile engine construction contract. Open questions: docs/PROFILE-AUTHORING.md."
}
