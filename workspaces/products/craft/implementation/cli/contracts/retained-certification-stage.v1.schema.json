{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/retained-certification-stage/v1",
  "title": "Failed certification stage observation",
  "description": "A failure-time observation, not durable ownership, quiescence, or cleanup authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "attempt_id", "target_directory", "staging_path", "created_at_ms", "created_dev", "created_ino", "created_uid", "parent_dev", "parent_ino", "parent_uid", "observed_at_ms", "named_status", "named_dev", "named_ino", "review_after_ms", "review_due", "quiescence", "cleanup_authorized"],
  "properties": {
    "schema_version": {"const": "domainspec.retained-certification-stage/v1"},
    "attempt_id": {"type": "string", "minLength": 1},
    "target_directory": {"type": "string", "minLength": 1},
    "staging_path": {"type": "string", "minLength": 1},
    "created_at_ms": {"type": "integer", "minimum": 0},
    "created_dev": {"type": "string", "pattern": "^[0-9]+$"},
    "created_ino": {"type": "string", "pattern": "^[0-9]+$"},
    "created_uid": {"type": "string", "pattern": "^[0-9]+$"},
    "parent_dev": {"type": "string", "pattern": "^[0-9]+$"},
    "parent_ino": {"type": "string", "pattern": "^[0-9]+$"},
    "parent_uid": {"type": "string", "pattern": "^[0-9]+$"},
    "observed_at_ms": {"type": "integer", "minimum": 0},
    "named_status": {"enum": ["same-inode-at-check", "changed-or-replaced-at-check", "missing-at-check", "unavailable-at-check"]},
    "named_dev": {"type": ["string", "null"], "pattern": "^[0-9]+$"},
    "named_ino": {"type": ["string", "null"], "pattern": "^[0-9]+$"},
    "review_after_ms": {"type": "integer", "minimum": 1},
    "review_due": {"type": "boolean"},
    "quiescence": {"const": "unverified"},
    "cleanup_authorized": {"const": false}
  }
}
