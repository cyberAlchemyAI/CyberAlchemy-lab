{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/contracts/request-application-binding-v1.schema.json",
  "title": "Checked request application binding candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "domain_source_manifest_sha256",
    "application_graph",
    "references",
    "runtime_guarantees_observed",
    "claim_ceiling",
    "authority_effect",
    "binding_sha256",
    "request_source_sha256",
    "application_plan_sha256",
    "source"
  ],
  "properties": {
    "schema_version": {
      "const": "domainspec.request-application-binding/v1-candidate"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "domain_source_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "application_graph": {
      "$ref": "compiled-request-application-graph-v1.schema.json"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pointer",
          "reference",
          "selector",
          "fragment",
          "reference_kind",
          "expected_node_kinds",
          "actual_node_kind"
        ],
        "properties": {
          "pointer": {
            "type": "string",
            "pattern": "^/"
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "selector": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"
          },
          "fragment": {
            "type": [
              "string",
              "null"
            ]
          },
          "reference_kind": {
            "enum": [
              "data",
              "public-contract",
              "field",
              "interface",
              "operation",
              "event",
              "mapping",
              "failure"
            ]
          },
          "expected_node_kinds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "actual_node_kind": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "runtime_guarantees_observed": {
      "const": false
    },
    "claim_ceiling": {
      "const": "formation-and-static-compilation-only"
    },
    "authority_effect": {
      "const": "none"
    },
    "binding_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "request_source_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "application_plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source": {
      "$ref": "request-application-source-v1.schema.json"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
