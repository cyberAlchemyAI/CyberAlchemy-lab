{
  "schema_version": "domainspec.node/v1",
  "node_id": "settlement-api",
  "feature_id": "alpha",
  "kind": "Interface",
  "body": {
    "description": "The typed settlement boundary.",
    "boundary_kind": "external",
    "version": "2",
    "compatibility": "backward",
    "operations": [
      {
        "operation_id": "settle",
        "operation_ref": "alpha:settle",
        "request": [
          {"field_id":"customer-id","type_ref":{"kind":"primitive","name":"uuid"},"required":true},
          {"field_id":"details","type_ref":{"kind":"reference","selector":"beta:settlement-details"},"required":true}
        ],
        "result": [
          {"field_id":"event","type_ref":{"kind":"reference","selector":"beta:settlement-completed"},"required":true}
        ]
      }
    ]
  }
}
