{
  "schema_version": "craft.technical-profile-source/v1-design",
  "id": "Profiles.MarketingApplication",
  "version": "0.1.0",
  "kind": "application",
  "sources": [
    "marketing-application.alch"
  ],
  "boundary": "Profiles.MarketingApplication.Family",
  "selection": {
    "mapping": "Profiles.MarketingApplication.BuildInputs",
    "arguments": {
      "options": {
        "layout": "ServiceAssembly"
      }
    },
    "checks": []
  },
  "target": {
    "consumer": "craft.application-inputs/v1",
    "package_schema": "craft.application-inputs/v1",
    "status": "resolved-schema-design-only"
  },
  "contracts": "contracts/marketing-application-inputs.json",
  "bindings": {
    "application": {
      "kind": "owner",
      "capability": "craft.profile-application-inputs",
      "source": "contracts/marketing-application-inputs.json",
      "contract": "craft.application-inputs/v1",
      "ports": {
        "preferences": {
          "direction": "requires",
          "contract": "craft.generated-query-source/v1",
          "effect": "read",
          "input_codec": "craft.grouped-preference-inputs/v1",
          "result_codec": "craft.generated-query-source/v1"
        }
      },
      "consumer_status": "implemented-original-source-profile-join",
      "descriptor_ref": "craft.application-inputs/v1",
      "recipe_ref": "craft.application-inputs/v1"
    }
  },
  "resource_requirements": [],
  "runtime_bindings": [],
  "limits": {
    "max_nodes": 64,
    "max_edges": 128,
    "max_items": 100,
    "fuel": 200000
  },
  "status": "source-authored-profile",
  "open_questions": [
    "Schedule acceptance is not delivery; post-schedule cancellation is not selected.",
    "Protected current preferences stay under original CRM Query authority; no model disclosure.",
    "Claims optional; hosting, TDE, EVF and publication deferred."
  ],
  "exports": [
    {
      "id": "preferences",
      "node": "application",
      "port": "preferences",
      "contract": "craft.generated-query-source/v1"
    }
  ]
}
