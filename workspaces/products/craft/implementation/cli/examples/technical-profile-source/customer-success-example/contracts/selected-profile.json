{
  "schema_version": "craft.generic-transaction-profile/v1-candidate",
  "id": "customer-success-sqlite",
  "target": "node-esm",
  "capabilities": [
    "Rule",
    "record-bool",
    "Operation",
    "Mapping",
    "record-uint64",
    "Calculation",
    "Policy",
    "bounded-values",
    "bounded-collections",
    "StateMachine",
    "Entity",
    "Query",
    "Entry",
    "keyed-sqlite-read",
    "auth-foundation-ready",
    "stateful-operation",
    "atomic-sqlite-transaction",
    "hidden-revision",
    "command-replay",
    "operation-policy-enforcement"
  ],
  "limits": {
    "max_input_bytes": 65536,
    "max_output_bytes": 65536,
    "max_value_bytes": 32768,
    "max_items": 100,
    "max_iterations": 100,
    "max_ast_nodes": 4096,
    "max_ast_depth": 64,
    "max_call_depth": 32,
    "fuel": 200000
  },
  "services": [
    {
      "id": "CustomerSuccessService",
      "module": "CustomerSuccess"
    }
  ],
  "entry_context": "customer-ready-scalars/v1-candidate",
  "auth_abi": "craft.commerce-auth-ready-bridge/v1-candidate",
  "auth_route_template": "commerce:{logical_entry_id}",
  "storage": "sqlite-atomic-command-values/v1-candidate",
  "application_namespace": "CustomerSuccess.PortfolioExample",
  "transaction_bounds": {
    "schema_version": "craft.generic-transaction-bounds/v1-candidate",
    "max_participants": 16,
    "max_read_observations": 128,
    "max_mutations": 128,
    "max_control_depth": 64,
    "max_command_key_bytes": 128,
    "max_command_key_scalars": 128,
    "max_command_tuple_bytes": 4096,
    "max_command_records": 1024,
    "max_command_journal_bytes": 16777216,
    "max_permission_trace_items": 128,
    "max_permission_trace_bytes": 32768
  }
}
