module Profiles.Library version 1

enum EdgeKind:
  value Dependency
  value Message
  value Observation

value-object Text:
  carrier String
  utf8-bytes 1..256
  unicode-scalars 1..256

value-object Node:
  id Text
  binding Text

value-object Edge:
  source Text
  sourcePort Text
  target Text
  targetPort Text
  contract Text
  kind EdgeKind
