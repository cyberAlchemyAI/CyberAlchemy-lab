{
  "schema": "craft.application-input-contract/v1",
  "family": "marketing-campaign/domain-v1",
  "assets": {
    "baseProfile": "contracts/marketing-application-base.json",
    "inferenceKernel": "contracts/marketing-application-inference.json",
    "sourceSelection": "contracts/marketing-application-source-selection.json",
    "effects": [
      {
        "name": "createDraft",
        "path": "contracts/marketing-application-effect-draft.json"
      },
      {
        "name": "setContent",
        "path": "contracts/marketing-application-effect-content.json"
      },
      {
        "name": "schedule",
        "path": "contracts/marketing-application-effect-schedule.json"
      },
      {
        "name": "metrics",
        "path": "contracts/marketing-application-effect-metrics.json"
      }
    ]
  },
  "roles": {
    "decision": {
      "targetRole": "Operation",
      "effect": "pure",
      "input": "PreferenceReviewRequest",
      "output": "Decision",
      "permission": "preserve-original-entry"
    }
  },
  "sourceContracts": {
    "facts": {
      "schema": "marketing-facts/v1",
      "adapter": "original-document-authority",
      "format": "json"
    },
    "brief": {
      "schema": "marketing-brief/v1",
      "adapter": "original-document-authority",
      "format": "json"
    },
    "uncitedBrief": {
      "schema": "marketing-uncitedBrief/v1",
      "adapter": "original-document-authority",
      "format": "json"
    },
    "preferences": {
      "schema": "marketing-preferences/v1",
      "adapter": "crm-preferences",
      "format": "json"
    },
    "approval": {
      "schema": "marketing-approval/v1",
      "adapter": "original-document-authority",
      "format": "json"
    }
  },
  "callbacks": "forbidden",
  "unknownPrimitive": "reject",
  "architectureProfiles": {
    "EntryModules": "protected-EntryModules.profile.json",
    "ServiceAssembly": "protected-ServiceAssembly.profile.json"
  },
  "open_questions": [
    "Schedule acceptance is not delivery; post-schedule cancellation is not selected.",
    "Protected current preferences stay under original CRM Query authority; no model disclosure.",
    "Claims optional; hosting, TDE, EVF and publication deferred."
  ]
}
