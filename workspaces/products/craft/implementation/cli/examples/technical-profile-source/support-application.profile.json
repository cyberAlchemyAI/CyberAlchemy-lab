{
  "schema_version": "craft.technical-profile-source/v1-design",
  "id": "Profiles.SupportApplication",
  "version": "0.1.0",
  "kind": "application",
  "sources": [
    "support-application.alch"
  ],
  "boundary": "Profiles.SupportApplication.Family",
  "selection": {
    "mapping": "Profiles.SupportApplication.BuildInputs",
    "arguments": {
      "options": {
        "layout": "ServiceAssembly"
      }
    },
    "checks": []
  },
  "target": {
    "consumer": "craft.application-inputs/v1",
    "package_schema": "craft.application-inputs/v1",
    "status": "resolved-schema-design-only"
  },
  "contracts": "contracts/support-application-inputs.json",
  "bindings": {
    "application": {
      "kind": "owner",
      "capability": "craft.profile-application-inputs",
      "source": "contracts/support-application-inputs.json",
      "contract": "craft.application-inputs/v1",
      "ports": {
        "rag": {
          "direction": "requires",
          "contract": "craft.rag-answer-binding/v1",
          "effect": "read",
          "input_codec": "craft.application-run/v1",
          "result_codec": "craft.rag-answer-binding/v1"
        }
      },
      "consumer_status": "implemented-original-source-profile-join",
      "descriptor_ref": "craft.application-inputs/v1",
      "recipe_ref": "craft.application-inputs/v1"
    }
  },
  "resource_requirements": [],
  "runtime_bindings": [],
  "limits": {
    "max_nodes": 32,
    "max_edges": 64,
    "max_items": 100,
    "fuel": 100000
  },
  "status": "source-authored-profile",
  "open_questions": [
    "Original RAG answer custody, provider mutation and Auth remain original owners.",
    "Business approval differs from private mechanical approval/content-review binding.",
    "Hosting, TDE, EVF, deployment, publication and real-provider qualification remain deferred."
  ],
  "exports": [
    {
      "id": "rag",
      "node": "application",
      "port": "rag",
      "contract": "craft.rag-answer-binding/v1"
    }
  ]
}
