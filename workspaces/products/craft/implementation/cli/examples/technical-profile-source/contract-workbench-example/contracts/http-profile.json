{
  "schema_version": "craft.generic-http-profile/v1-candidate",
  "id": "ContractWorkbenchHttp",
  "target": "node-esm",
  "realization": "injected-request-response/v1-candidate",
  "capabilities": [
    "injected-http-get",
    "injected-http-post",
    "checked-response-mapping",
    "original-entry-auth"
  ],
  "application_profile": "contracts/selected-profile.json",
  "route_prefix": "/api",
  "limits": {
    "url_bytes": 4096,
    "header_bytes": 8192,
    "request_bytes": 65536,
    "response_bytes": 131072,
    "body_timeout_ms": 30000
  },
  "routes": [
    {
      "id": "ContractWorkbenchHttp.RecordEdition",
      "service": "ContractWorkbenchService",
      "entry": "ContractWorkbench.RecordEditionEntry",
      "method": "POST",
      "path": "/editions",
      "query": [],
      "response_mapping": "ContractWorkbench.HttpRecordedEdition"
    },
    {
      "id": "ContractWorkbenchHttp.ReadEdition",
      "service": "ContractWorkbenchService",
      "entry": "ContractWorkbench.ReadEditionEntry",
      "method": "GET",
      "path": "/editions/{documentId}",
      "query": [],
      "response_mapping": "ContractWorkbench.HttpEdition"
    },
    {
      "id": "ContractWorkbenchHttp.ReviewComparison",
      "service": "ContractWorkbenchService",
      "entry": "ContractWorkbench.ReviewComparisonEntry",
      "method": "POST",
      "path": "/comparisons",
      "query": [],
      "response_mapping": "ContractWorkbench.HttpReview"
    }
  ]
}
