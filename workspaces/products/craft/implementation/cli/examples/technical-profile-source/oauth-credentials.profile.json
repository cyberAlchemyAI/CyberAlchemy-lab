{
  "schema_version": "craft.technical-profile-source/v1-design",
  "id": "Profiles.OAuthCredentials",
  "version": "0.1.0-candidate",
  "kind": "application",
  "sources": [
    "library.alch",
    "oauth-credentials.alch"
  ],
  "boundary": "Profiles.OAuthCredentials.Family",
  "selection": {
    "mapping": "Profiles.OAuthCredentials.Build",
    "arguments": {},
    "checks": []
  },
  "target": {
    "consumer": "craft.technical-profile-runtime/v1",
    "package_schema": "craft.technical-profile-runtime/v1",
    "status": "resolved-schema-design-only"
  },
  "contracts": "contracts/oauth-credentials-ports.json",
  "bindings": {
    "credential": {
      "kind": "native",
      "package": "@craft/ai-profiles",
      "version": "0.1.0",
      "export": "./credentials",
      "factory": "createOAuthCredentialResource",
      "capability": "craft.integration-kernel",
      "contract": "currentCredential",
      "ports": {
        "current": {
          "direction": "provides",
          "contract": "currentCredential"
        }
      },
      "identity_state": "source-inspected-not-installed-lock",
      "resource": "oauthGrant",
      "consumer_status": "requires-checked-profile-to-original-owner-join",
      "native_contract": {
        "identity_export": "OAUTH_CREDENTIALS_IDENTITY",
        "abi": "trusted-oauth-current-credential/v1",
        "contract": "oauth-refresh-token-credential/v1",
        "operations": [
          "credential.current",
          "credential.refresh",
          "credential.recover",
          "credential.revoke"
        ]
      }
    }
  },
  "resource_requirements": [
    {
      "id": "oauthGrant",
      "contract": "currentCredential",
      "configuration": "operator-supplied durable private path, encryption key, provider/account/grant, exact OAuth endpoint/client registration, current authority and HTTP owner",
      "compatibility": "refresh_token form grant; explicit required or optional refresh-token replacement; no provider qualification"
    }
  ],
  "runtime_bindings": [],
  "limits": {
    "max_nodes": 4,
    "max_edges": 4,
    "max_items": 100,
    "fuel": 100000
  },
  "exports": [
    {
      "id": "current",
      "node": "credential",
      "port": "current",
      "contract": "currentCredential"
    }
  ],
  "status": "source-authored-profile",
  "open_questions": [
    "Actual provider OAuth policy, rotation mode and token response compatibility require separate provider qualification.",
    "Key backup/recovery and rollback-resistant external epoch ownership remain deployment/operator responsibilities."
  ]
}
