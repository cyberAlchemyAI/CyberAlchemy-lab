{
  "schema_version": "craft.technical-profile-source/v1-design",
  "id": "Profiles.PermissionedRagApplication",
  "version": "0.1.0",
  "kind": "application",
  "sources": [
    "permissioned-rag-application.alch"
  ],
  "boundary": "Profiles.PermissionedRagApplication.Family",
  "selection": {
    "mapping": "Profiles.PermissionedRagApplication.BuildInputs",
    "arguments": {
      "options": {
        "layout": "ServiceAssembly"
      }
    },
    "checks": []
  },
  "target": {
    "consumer": "craft.application-inputs/v1",
    "package_schema": "craft.application-inputs/v1",
    "status": "resolved-schema-design-only"
  },
  "contracts": "contracts/permissioned-rag-application-inputs.json",
  "bindings": {
    "application": {
      "kind": "owner",
      "capability": "craft.profile-application-inputs",
      "source": "contracts/permissioned-rag-application-inputs.json",
      "contract": "craft.application-inputs/v1",
      "ports": {
        "ingestion": {
          "direction": "requires",
          "contract": "craft.generated-ingestion-reference/v1",
          "effect": "read",
          "input_codec": "craft.application-run/v1",
          "result_codec": "craft.generated-ingestion-reference/v1"
        },
        "answer": {
          "direction": "provides",
          "contract": "craft.rag-answer-binding/v1",
          "effect": "read",
          "input_codec": "craft.application-run/v1",
          "result_codec": "craft.rag-answer-binding/v1"
        }
      },
      "consumer_status": "implemented-original-source-profile-join",
      "descriptor_ref": "craft.application-inputs/v1",
      "recipe_ref": "craft.application-inputs/v1"
    }
  },
  "resource_requirements": [],
  "runtime_bindings": [],
  "limits": {
    "max_nodes": 32,
    "max_edges": 64,
    "max_items": 100,
    "fuel": 100000
  },
  "status": "source-authored-profile",
  "open_questions": [
    "Only original finite knowledge owners; no CRM provider or fabricated Query is selected.",
    "Operational control records do not introduce mandatory human approval.",
    "Real provider/model quality, hosting, TDE, EVF, deployment and publication remain deferred."
  ],
  "exports": [
    {
      "id": "ingestion",
      "node": "application",
      "port": "ingestion",
      "contract": "craft.generated-ingestion-reference/v1"
    },
    {
      "id": "answer",
      "node": "application",
      "port": "answer",
      "contract": "craft.rag-answer-binding/v1"
    }
  ]
}
