{
  "schema_version": "craft.technical-profile-source/v1-design",
  "id": "Profiles.CrmDomainApplication",
  "version": "0.1.0",
  "kind": "application",
  "sources": [
    "crm-domain-application.alch"
  ],
  "boundary": "Profiles.CrmDomainApplication.Family",
  "selection": {
    "mapping": "Profiles.CrmDomainApplication.BuildInputs",
    "arguments": {
      "options": {
        "layout": "ServiceAssembly"
      }
    },
    "checks": []
  },
  "target": {
    "consumer": "craft.application-inputs/v1",
    "package_schema": "craft.application-inputs/v1",
    "status": "resolved-schema-design-only"
  },
  "contracts": "contracts/application-inputs-domain.json",
  "bindings": {
    "application": {
      "kind": "owner",
      "capability": "craft.profile-application-inputs",
      "source": "contracts/application-inputs-domain.json",
      "contract": "craft.application-inputs/v1",
      "ports": {
        "preferences": {
          "direction": "provides",
          "contract": "craft.generated-query-source/v1",
          "effect": "read",
          "input_codec": "craft.grouped-preference-inputs/v1",
          "result_codec": "craft.generated-query-source/v1"
        }
      },
      "consumer_status": "implemented-original-source-profile-join",
      "descriptor_ref": "craft.application-inputs/v1",
      "recipe_ref": "craft.application-inputs/v1"
    }
  },
  "resource_requirements": [],
  "runtime_bindings": [],
  "limits": {
    "max_nodes": 32,
    "max_edges": 64,
    "max_items": 100,
    "fuel": 100000
  },
  "status": "source-authored-profile",
  "open_questions": [
    "Original application/native/provider/workflow owners retain authority and resource custody.",
    "Profile checking and recorded execution do not qualify production Auth, real providers or model quality.",
    "Hosting, TDE, EVF, deployment and publication remain deferred."
  ],
  "exports": [
    {
      "id": "preferences",
      "node": "application",
      "port": "preferences",
      "contract": "craft.generated-query-source/v1"
    }
  ]
}
