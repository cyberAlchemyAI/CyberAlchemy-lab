{
  "schema_version": "domainspec.node/v1",
  "feature_id": "commerce",
  "node_id": "integration-outbound",
  "kind": "Mapping",
  "body": {
    "description": "Map a declared order into the provider-neutral outbound integration boundary.",
    "target": "commerce:customer",
    "typed_contract": {
      "schema_version": "domainspec.typed-mapping/v2",
      "ontology_mapping": "COMMERCE-INTEGRATION-OUTBOUND",
      "inputs": [
        {
          "name": "order",
          "type": {
            "kind": "reference",
            "selector": "commerce:order",
            "projection": ["id"]
          }
        }
      ],
      "target": "commerce:customer",
      "fields": [
        {
          "target": "id",
          "value": {
            "op": "path",
            "root": "order",
            "properties": ["TEST-ORDER#id"]
          },
          "default": null
        },
        {
          "target": "name",
          "value": {
            "op": "literal",
            "type": "String",
            "value": "integration"
          },
          "default": null
        }
      ],
      "total": true
    }
  }
}
