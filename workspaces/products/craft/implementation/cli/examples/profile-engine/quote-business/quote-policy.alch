# Business fixture. Open questions: ../../../../docs/PROFILE-AUTHORING.md.
domain quote-policy "Describe the business constraints for requesting a quote"
owner quote-example-owner
logic sfol-v1

schema PolicyRequest:
  unit: boolean const true

schema PolicyResponse:
  status: string const "ok"
  min_quantity: integer const 1
  max_quantity: integer const 100
  total_when_unavailable: string const "0"

mapping PolicyDescription:
  meaning "State the authored quantity bounds and unavailable-total convention."
  target PolicyResponse
  field status = "ok"
  field min_quantity = 1
  field max_quantity = 100
  field total_when_unavailable = "0"

result DescribeQuotePolicy:
  when true yield PolicyDescription
