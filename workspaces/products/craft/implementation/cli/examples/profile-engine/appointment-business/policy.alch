# Open questions: README.md.
domain appointment-policy "Describe the authored scheduling inquiry policy"
owner appointment-example-owner
logic sfol-v1

schema PolicyInquiry:
  explain: boolean const true

schema SchedulingPolicy:
  status: string const "ok"
  min_minutes: integer const 15
  max_minutes: integer const 120
  creates_booking: boolean const false

mapping SchedulingRules:
  meaning "State duration limits and that this is an eligibility inquiry, not a booking command."
  target SchedulingPolicy
  field status = "ok"
  field min_minutes = 15
  field max_minutes = 120
  field creates_booking = false

result DescribeScheduling:
  when true yield SchedulingRules
