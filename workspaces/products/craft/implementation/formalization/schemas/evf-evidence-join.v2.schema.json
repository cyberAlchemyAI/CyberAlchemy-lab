{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/formalization/evf-evidence-join/v2-candidate",
  "title": "Post-TDE execution EVF evidence join candidate",
  "description": "A bounded pass projection, not provider authentication, runtime observation, proof, or release authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "join_id", "owner", "route_kind", "bindings", "comparability", "join_status", "bounded_conclusion", "residue", "revision_route", "authority_effect", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "domainspec-v2.evf-evidence-join/v2-candidate"},
    "join_id": {"$ref": "#/$defs/text"},
    "owner": {"const": "EVF"},
    "route_kind": {"const": "execution-evidence"},
    "bindings": {"type": "object", "additionalProperties": false, "required": ["formal_claim_ref", "capability_assessment_ref", "obligation_set_ref", "projection_ref", "preservation_binding_ref", "evaluation_request_ref", "finalized_scope", "native_source_bundle_ref", "runtime_binding_ref", "profile_ref", "provider_evidence_refs", "environment_refs", "result_semantics"], "properties": {"formal_claim_ref": {"$ref": "#/$defs/currentRef"}, "capability_assessment_ref": {"$ref": "#/$defs/currentRef"}, "obligation_set_ref": {"$ref": "#/$defs/currentRef"}, "projection_ref": {"$ref": "#/$defs/currentRef"}, "preservation_binding_ref": {"$ref": "#/$defs/currentRef"}, "evaluation_request_ref": {"$ref": "#/$defs/currentRef"}, "finalized_scope": {"$ref": "#/$defs/scope"}, "native_source_bundle_ref": {"$ref": "#/$defs/currentRef"}, "runtime_binding_ref": {"$ref": "#/$defs/currentRef"}, "profile_ref": {"$ref": "#/$defs/currentRef"}, "provider_evidence_refs": {"$ref": "#/$defs/currentRefSet"}, "environment_refs": {"$ref": "#/$defs/currentRefSet"}, "result_semantics": {"$ref": "#/$defs/text"}}},
    "comparability": {"const": {"same_claim": true, "same_evaluation_request": true, "same_domain": true, "same_result_semantics": true, "route_bindings_complete": true, "all_current": true}},
    "join_status": {"const": "PASS_BOUNDED"},
    "bounded_conclusion": {"$ref": "#/$defs/text"},
    "residue": {"const": []},
    "revision_route": {"const": "none"},
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"$ref": "#/$defs/text"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "currentRef": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes", "current"], "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/digest"}, "size_bytes": {"type": "integer", "minimum": 0}, "current": {"const": true}}},
    "currentRefSet": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/currentRef"}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["formal_claim_ref", "evaluation_context_ref", "interpretation_model_ref", "obligation_set_ref", "projection_ref", "preservation_binding_ref", "case_domain_sha256", "witness_input_set_sha256", "domain_and_bound_sha256"], "properties": {"formal_claim_ref": {"$ref": "#/$defs/currentRef"}, "evaluation_context_ref": {"$ref": "#/$defs/currentRef"}, "interpretation_model_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/currentRef"}]}, "obligation_set_ref": {"$ref": "#/$defs/currentRef"}, "projection_ref": {"$ref": "#/$defs/currentRef"}, "preservation_binding_ref": {"$ref": "#/$defs/currentRef"}, "case_domain_sha256": {"$ref": "#/$defs/digest"}, "witness_input_set_sha256": {"$ref": "#/$defs/digest"}, "domain_and_bound_sha256": {"$ref": "#/$defs/digest"}}}
  }
}
