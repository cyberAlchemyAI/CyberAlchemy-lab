{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/formalization/lean-profile-admission-candidate/v1",
  "title": "Lean Formal-Language Profile Admission Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "owner", "registry_ref", "profile_selector", "profile_snapshot", "consumer_claim_ref", "technical_validation_ref", "admission_question", "required_evidence", "options", "status", "authority_effect", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "domainspec-v2.lean-profile-admission-candidate/v1"},
    "candidate_id": {"const": "domainspec-v2.lean-dtt.auth-source-admission/v1"},
    "owner": {"const": "projects/domainspec-v2/formalization"},
    "registry_ref": {"$ref": "#/$defs/exactCurrentRef"},
    "profile_selector": {"const": "#/profiles/0"},
    "profile_snapshot": {"$ref": "#/$defs/profile"},
    "consumer_claim_ref": {"$ref": "#/$defs/exactCurrentRef"},
    "technical_validation_ref": {"$ref": "#/$defs/exactCurrentRef"},
    "admission_question": {"type": "string", "minLength": 1},
    "required_evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "options": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/option"}},
    "status": {"const": "candidate-awaiting-independent-review-and-owner-decision"},
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "exactCurrentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "current"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "current": {"const": true}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "version", "logic_family", "formal_claim_role", "tde_behavior", "provider_route", "result_semantics", "supported_constructs", "unsupported_or_bounded_constructs", "status", "authority_effect", "claim_ceiling"],
      "properties": {
        "profile_id": {"const": "lean-dtt"},
        "version": {"const": "1-candidate"},
        "logic_family": {"const": "dependent-type-theory"},
        "formal_claim_role": {"const": "canonical-source"},
        "tde_behavior": {"const": "carry-exact-handles-only"},
        "provider_route": {"const": "evf-theorem"},
        "result_semantics": {"type": "string", "minLength": 1},
        "supported_constructs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "unsupported_or_bounded_constructs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "status": {"const": "observed-candidate"},
        "authority_effect": {"const": "none"},
        "claim_ceiling": {"const": "theorem-in-exact-lean-model-only"}
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["option_id", "effect", "reversibility", "hazard_class"],
      "properties": {
        "option_id": {"enum": ["ADMIT", "REVISE", "DEFER", "REJECT"]},
        "effect": {"type": "string", "minLength": 1},
        "reversibility": {"enum": ["reversible", "irreversible"]},
        "hazard_class": {"enum": ["reversible", "authority"]}
      }
    }
  }
}
