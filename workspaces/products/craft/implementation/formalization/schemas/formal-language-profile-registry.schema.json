{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/formalization/formal-language-profile-registry/v1-candidate",
  "title": "Formal Language Profile Registry Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "status", "profiles", "selection_rules", "authority_effect", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "domainspec-v2.formal-language-profile-registry/v1-candidate"},
    "registry_id": {"$ref": "#/$defs/text"},
    "status": {"const": "candidate"},
    "profiles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/profile"}},
    "selection_rules": {"$ref": "#/$defs/textSet"},
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"$ref": "#/$defs/text"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "textSet": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "profile": {"type": "object", "additionalProperties": false, "required": ["profile_id", "version", "logic_family", "formal_claim_role", "tde_behavior", "provider_route", "result_semantics", "supported_constructs", "unsupported_or_bounded_constructs", "status", "authority_effect", "claim_ceiling"], "properties": {"profile_id": {"$ref": "#/$defs/text"}, "version": {"$ref": "#/$defs/text"}, "logic_family": {"$ref": "#/$defs/text"}, "formal_claim_role": {"enum": ["canonical-source", "canonical-or-projection", "projection-only"]}, "tde_behavior": {"enum": ["derive-from-admitted-projection", "carry-exact-handles-only", "not-a-tde-execution-profile"]}, "provider_route": {"enum": ["tde-runtime", "evf-solver", "evf-theorem", "evf-model-checker", "evf-relational", "evf-datalog", "none"]}, "result_semantics": {"$ref": "#/$defs/text"}, "supported_constructs": {"$ref": "#/$defs/textSet"}, "unsupported_or_bounded_constructs": {"$ref": "#/$defs/textSet"}, "status": {"enum": ["candidate", "observed-candidate", "unsupported"]}, "authority_effect": {"const": "none"}, "claim_ceiling": {"$ref": "#/$defs/text"}}}
  }
}
