{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/formalization/contract-set/v1-candidate",
  "title": "DomainSpec Formalization Contract Set Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_set_id", "status", "contracts", "compatibility_edges", "outcome_algebra", "authority_effect", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "domainspec-v2.formalization-contract-set/v1-candidate"},
    "contract_set_id": {"$ref": "#/$defs/text"},
    "status": {"const": "candidate"},
    "contracts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/contract"}},
    "compatibility_edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "outcome_algebra": {"type": "array", "uniqueItems": true, "items": {"enum": ["PASS_BOUNDED", "NON_PASS", "UNSUPPORTED", "INDETERMINATE", "STALE", "MISSING", "FAILED", "BLOCKED"]}},
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"$ref": "#/$defs/text"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "textSet": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "contract": {"type": "object", "additionalProperties": false, "required": ["contract_id", "artifact_kind", "schema_path", "owner", "producer", "consumers", "method_stage", "status", "canonical_input", "does_not_own"], "properties": {"contract_id": {"$ref": "#/$defs/text"}, "artifact_kind": {"$ref": "#/$defs/text"}, "schema_path": {"$ref": "#/$defs/text"}, "owner": {"$ref": "#/$defs/text"}, "producer": {"$ref": "#/$defs/text"}, "consumers": {"$ref": "#/$defs/textSet"}, "method_stage": {"$ref": "#/$defs/text"}, "status": {"enum": ["existing", "candidate", "external-existing", "external-planned"]}, "canonical_input": {"type": "boolean"}, "does_not_own": {"$ref": "#/$defs/textSet"}}},
    "edge": {"type": "object", "additionalProperties": false, "required": ["from_contract", "relation", "to_contract", "status", "rule"], "properties": {"from_contract": {"$ref": "#/$defs/text"}, "relation": {"enum": ["formalizes", "interprets", "projects-to", "consumed-by", "derived-from", "evidences", "binds-runtime", "joined-by", "supersedes-candidate"]}, "to_contract": {"$ref": "#/$defs/text"}, "status": {"enum": ["current", "candidate", "adapter-required"]}, "rule": {"$ref": "#/$defs/text"}}}
  }
}
