{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/formalization/provider-evidence-binding/v3-candidate",
  "title": "Unverified provider case-claim binding candidate",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "binding_id", "provider_owner", "provider_id", "provider_version", "formal_claim_ref", "obligation_ref", "projection_ref", "evaluation_request_ref", "finalized_scope", "native_source_bundle_ref", "runtime_binding_ref", "environment_ref", "provider_outcome_ref", "case_claim_refs", "reported_causal_outcome", "execution_status", "normalized_outcome", "evidence_status", "case_evidence_verification", "residue", "authority_effect", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "domainspec-v2.provider-evidence-binding/v3-candidate"},
    "binding_id": {"$ref": "#/$defs/text"}, "provider_owner": {"$ref": "#/$defs/text"},
    "provider_id": {"$ref": "#/$defs/text"}, "provider_version": {"$ref": "#/$defs/text"},
    "formal_claim_ref": {"$ref": "#/$defs/ref"}, "obligation_ref": {"$ref": "#/$defs/ref"},
    "projection_ref": {"$ref": "#/$defs/ref"}, "evaluation_request_ref": {"$ref": "#/$defs/ref"},
    "finalized_scope": {"$ref": "#/$defs/scope"}, "native_source_bundle_ref": {"$ref": "#/$defs/ref"},
    "runtime_binding_ref": {"$ref": "#/$defs/ref"}, "environment_ref": {"$ref": "#/$defs/ref"},
    "provider_outcome_ref": {"$ref": "#/$defs/ref"}, "case_claim_refs": {"$ref": "#/$defs/refSet"},
    "reported_causal_outcome": {"const": "pass"}, "execution_status": {"const": "not-observed"},
    "normalized_outcome": {"const": "blocked"}, "evidence_status": {"const": "unverified"},
    "case_evidence_verification": {"const": "unverified"},
    "residue": {"$ref": "#/$defs/residue"}, "authority_effect": {"const": "none"},
    "claim_ceiling": {"$ref": "#/$defs/text"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes", "current"], "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/digest"}, "size_bytes": {"type": "integer", "minimum": 1}, "current": {"const": true}}},
    "refSet": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}},
    "residue": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["formal_claim_ref", "evaluation_context_ref", "interpretation_model_ref", "obligation_set_ref", "projection_ref", "preservation_binding_ref", "case_domain_sha256", "witness_input_set_sha256", "domain_and_bound_sha256"], "properties": {"formal_claim_ref": {"$ref": "#/$defs/ref"}, "evaluation_context_ref": {"$ref": "#/$defs/ref"}, "interpretation_model_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/ref"}]}, "obligation_set_ref": {"$ref": "#/$defs/ref"}, "projection_ref": {"$ref": "#/$defs/ref"}, "preservation_binding_ref": {"$ref": "#/$defs/ref"}, "case_domain_sha256": {"$ref": "#/$defs/digest"}, "witness_input_set_sha256": {"$ref": "#/$defs/digest"}, "domain_and_bound_sha256": {"$ref": "#/$defs/digest"}}}
  }
}
