{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/formalization/provider-evidence-binding/v1-candidate",
  "title": "Provider Evidence Binding Candidate",
  "description": "A bridge to provider-owned receipts. It does not replace provider-native receipt schemas.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "binding_id", "provider_owner", "provider_id", "provider_version", "formal_claim_ref", "obligation_ref", "projection_ref", "native_source_bundle_ref", "runtime_binding_ref", "environment_ref", "provider_receipt_ref", "execution_status", "native_outcome", "normalized_outcome", "evidence_status", "residue", "authority_effect", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "domainspec-v2.provider-evidence-binding/v1-candidate"},
    "binding_id": {"$ref": "#/$defs/text"},
    "provider_owner": {"$ref": "#/$defs/text"},
    "provider_id": {"$ref": "#/$defs/text"},
    "provider_version": {"$ref": "#/$defs/text"},
    "formal_claim_ref": {"$ref": "#/$defs/exactRef"},
    "obligation_ref": {"$ref": "#/$defs/exactRef"},
    "projection_ref": {"$ref": "#/$defs/exactRef"},
    "native_source_bundle_ref": {"$ref": "#/$defs/exactRef"},
    "runtime_binding_ref": {"$ref": "#/$defs/exactRef"},
    "environment_ref": {"$ref": "#/$defs/exactRef"},
    "provider_receipt_ref": {"$ref": "#/$defs/exactRef"},
    "execution_status": {"enum": ["completed", "failed", "timeout", "blocked", "stale"]},
    "native_outcome": {"$ref": "#/$defs/text"},
    "normalized_outcome": {"enum": ["passed", "failed", "counterexample-observed", "witness-observed", "unsupported", "indeterminate", "timeout", "malformed", "stale", "provider-error", "blocked"]},
    "evidence_status": {"enum": ["current", "stale", "missing", "invalid"]},
    "residue": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"$ref": "#/$defs/text"}
  },
  "allOf": [
    {"if": {"properties": {"normalized_outcome": {"const": "passed"}}}, "then": {"properties": {"execution_status": {"const": "completed"}, "evidence_status": {"const": "current"}}}},
    {"if": {"properties": {"evidence_status": {"const": "current"}}}, "then": {"properties": {"formal_claim_ref": {"$ref": "#/$defs/exactCurrentRef"}, "obligation_ref": {"$ref": "#/$defs/exactCurrentRef"}, "projection_ref": {"$ref": "#/$defs/exactCurrentRef"}, "native_source_bundle_ref": {"$ref": "#/$defs/exactCurrentRef"}, "runtime_binding_ref": {"$ref": "#/$defs/exactCurrentRef"}, "environment_ref": {"$ref": "#/$defs/exactCurrentRef"}, "provider_receipt_ref": {"$ref": "#/$defs/exactCurrentRef"}}}},
    {"if": {"properties": {"execution_status": {"const": "timeout"}}}, "then": {"properties": {"normalized_outcome": {"const": "timeout"}}}}
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "exactRef": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes", "current"], "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/digest"}, "size_bytes": {"type": "integer", "minimum": 0}, "current": {"type": "boolean"}}},
    "exactCurrentRef": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes", "current"], "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/digest"}, "size_bytes": {"type": "integer", "minimum": 0}, "current": {"const": true}}}
  }
}
