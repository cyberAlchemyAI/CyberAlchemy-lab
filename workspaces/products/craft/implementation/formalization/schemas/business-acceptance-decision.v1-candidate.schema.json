{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/formalization/business-acceptance-decision/v1-candidate",
  "title": "BusinessMeaning acceptance decision candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "owner", "outcome", "subject", "authority_effect"],
  "properties": {
    "schema_version": {"const": "domainspec-v2.business-acceptance-decision/v1-candidate"},
    "decision_id": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["accepted", "rejected"]},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meaning_id", "version", "canonicalization", "digest_algorithm", "digest"],
      "properties": {
        "meaning_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "canonicalization": {"const": "domainspec-json-keysort-excluding-acceptance-v1"},
        "digest_algorithm": {"const": "sha256"},
        "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "authority_effect": {"const": "none"}
  },
  "description": "Candidate structural contract. The digest covers key-sorted JSON of the selected BusinessMeaning with its entire acceptance property omitted. The exact decision file is separately bound by its source reference. A local owner string does not authenticate issuance or grant authority."
}
