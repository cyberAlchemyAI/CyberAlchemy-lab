{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/formalization/evf-evidence-join/v3-candidate",
  "title": "Unverified case-claim EVF join candidate",
  "description": "The reported pass is structurally joined but never satisfies an obligation.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "join_id", "owner", "route_kind", "bindings", "declared_comparability", "comparability_verification", "case_evidence_verification", "join_status", "bounded_conclusion", "residue", "revision_route", "authority_effect", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "domainspec-v2.evf-evidence-join/v3-candidate"},
    "join_id": {"$ref": "#/$defs/text"}, "owner": {"const": "EVF"}, "route_kind": {"const": "execution-evidence"},
    "bindings": {"type": "object", "additionalProperties": false,
      "required": ["formal_claim_ref", "capability_assessment_ref", "obligation_set_ref", "projection_ref", "preservation_binding_ref", "evaluation_request_ref", "finalized_scope", "native_source_bundle_ref", "runtime_binding_ref", "profile_ref", "provider_evidence_refs", "environment_refs", "case_claim_refs", "result_semantics"],
      "properties": {
        "formal_claim_ref": {"$ref": "#/$defs/ref"}, "capability_assessment_ref": {"$ref": "#/$defs/ref"},
        "obligation_set_ref": {"$ref": "#/$defs/ref"}, "projection_ref": {"$ref": "#/$defs/ref"},
        "preservation_binding_ref": {"$ref": "#/$defs/ref"}, "evaluation_request_ref": {"$ref": "#/$defs/ref"},
        "finalized_scope": {"$ref": "#/$defs/scope"}, "native_source_bundle_ref": {"$ref": "#/$defs/ref"},
        "runtime_binding_ref": {"$ref": "#/$defs/ref"}, "profile_ref": {"$ref": "#/$defs/ref"},
        "provider_evidence_refs": {"$ref": "#/$defs/refSet"}, "environment_refs": {"$ref": "#/$defs/refSet"},
        "case_claim_refs": {"$ref": "#/$defs/refSet"}, "result_semantics": {"$ref": "#/$defs/text"}
      }
    },
    "declared_comparability": {"$ref": "#/$defs/comparability"},
    "comparability_verification": {"const": "unverified"}, "case_evidence_verification": {"const": "unverified"},
    "join_status": {"const": "BLOCKED"}, "bounded_conclusion": {"$ref": "#/$defs/text"},
    "residue": {"$ref": "#/$defs/residue"}, "revision_route": {"const": "provider"},
    "authority_effect": {"const": "none"}, "claim_ceiling": {"$ref": "#/$defs/text"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes", "current"], "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/digest"}, "size_bytes": {"type": "integer", "minimum": 1}, "current": {"const": true}}},
    "refSet": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}},
    "residue": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "comparability": {"type": "object", "additionalProperties": false, "required": ["same_claim", "same_evaluation_request", "same_domain", "same_result_semantics"], "properties": {"same_claim": {"const": true}, "same_evaluation_request": {"const": true}, "same_domain": {"const": true}, "same_result_semantics": {"const": true}}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["formal_claim_ref", "evaluation_context_ref", "interpretation_model_ref", "obligation_set_ref", "projection_ref", "preservation_binding_ref", "case_domain_sha256", "witness_input_set_sha256", "domain_and_bound_sha256"], "properties": {"formal_claim_ref": {"$ref": "#/$defs/ref"}, "evaluation_context_ref": {"$ref": "#/$defs/ref"}, "interpretation_model_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/ref"}]}, "obligation_set_ref": {"$ref": "#/$defs/ref"}, "projection_ref": {"$ref": "#/$defs/ref"}, "preservation_binding_ref": {"$ref": "#/$defs/ref"}, "case_domain_sha256": {"$ref": "#/$defs/digest"}, "witness_input_set_sha256": {"$ref": "#/$defs/digest"}, "domain_and_bound_sha256": {"$ref": "#/$defs/digest"}}}
  }
}
