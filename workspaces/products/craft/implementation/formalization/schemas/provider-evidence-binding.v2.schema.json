{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/formalization/provider-evidence-binding/v2-candidate",
  "title": "Post-TDE provider evidence binding candidate",
  "description": "Execution PASS_BOUNDED binds a finalized request and the exact case, candidate witness-input, bound, and preservation scope. It does not authenticate provider-native evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "binding_id", "provider_owner", "provider_id", "provider_version", "formal_claim_ref", "obligation_ref", "projection_ref", "evaluation_request_ref", "finalized_scope", "native_source_bundle_ref", "runtime_binding_ref", "environment_ref", "provider_receipt_ref", "execution_status", "native_outcome", "normalized_outcome", "evidence_status", "residue", "authority_effect", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "domainspec-v2.provider-evidence-binding/v2-candidate"},
    "binding_id": {"$ref": "#/$defs/text"},
    "provider_owner": {"$ref": "#/$defs/text"},
    "provider_id": {"$ref": "#/$defs/text"},
    "provider_version": {"$ref": "#/$defs/text"},
    "formal_claim_ref": {"$ref": "#/$defs/currentRef"},
    "obligation_ref": {"$ref": "#/$defs/currentRef"},
    "projection_ref": {"$ref": "#/$defs/currentRef"},
    "evaluation_request_ref": {"$ref": "#/$defs/currentRef"},
    "finalized_scope": {"$ref": "#/$defs/scope"},
    "native_source_bundle_ref": {"$ref": "#/$defs/currentRef"},
    "runtime_binding_ref": {"$ref": "#/$defs/currentRef"},
    "environment_ref": {"$ref": "#/$defs/currentRef"},
    "provider_receipt_ref": {"$ref": "#/$defs/currentRef"},
    "execution_status": {"const": "completed"},
    "native_outcome": {"const": "pass"},
    "normalized_outcome": {"const": "passed"},
    "evidence_status": {"const": "current"},
    "residue": {"const": []},
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"$ref": "#/$defs/text"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "currentRef": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes", "current"], "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/digest"}, "size_bytes": {"type": "integer", "minimum": 0}, "current": {"const": true}}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["formal_claim_ref", "evaluation_context_ref", "interpretation_model_ref", "obligation_set_ref", "projection_ref", "preservation_binding_ref", "case_domain_sha256", "witness_input_set_sha256", "domain_and_bound_sha256"], "properties": {"formal_claim_ref": {"$ref": "#/$defs/currentRef"}, "evaluation_context_ref": {"$ref": "#/$defs/currentRef"}, "interpretation_model_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/currentRef"}]}, "obligation_set_ref": {"$ref": "#/$defs/currentRef"}, "projection_ref": {"$ref": "#/$defs/currentRef"}, "preservation_binding_ref": {"$ref": "#/$defs/currentRef"}, "case_domain_sha256": {"$ref": "#/$defs/digest"}, "witness_input_set_sha256": {"$ref": "#/$defs/digest"}, "domain_and_bound_sha256": {"$ref": "#/$defs/digest"}}}
  }
}
