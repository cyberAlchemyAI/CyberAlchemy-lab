{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/documentation/user-guide/v1",
  "title": "DomainSpec Future-User Guide Manifest",
  "description": "A composition and evidence contract for a pre-release DomainSpec user guide. It governs reader movement, source boundaries, example posture, and validation expectations; it does not define the DomainSpec language or authorize release.",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "guide",
    "transport_contract",
    "source_contract",
    "learning_experience",
    "content_architecture",
    "example_contracts",
    "validation_contract",
    "xray_version",
    "example_id",
    "mode",
    "target_boundary",
    "renderer_level",
    "layer_interaction",
    "reader_contract",
    "reader_terms",
    "layer_reader_outcomes",
    "readability_dynamics",
    "lanes",
    "learning_residue"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "./COMPLETE-GUIDE.schema.json"
    },
    "schema_version": {
      "const": "domainspec-user-guide/v1"
    },
    "guide": {
      "$ref": "#/$defs/guideIdentity"
    },
    "transport_contract": {
      "$ref": "#/$defs/transportContract"
    },
    "source_contract": {
      "$ref": "#/$defs/sourceContract"
    },
    "learning_experience": {
      "$ref": "#/$defs/learningExperience"
    },
    "content_architecture": {
      "$ref": "#/$defs/contentArchitecture"
    },
    "example_contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/exampleContract"
      }
    },
    "validation_contract": {
      "$ref": "#/$defs/validationContract"
    },
    "xray_version": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "example_id": {
      "$ref": "#/$defs/kebabId"
    },
    "mode": {
      "enum": [
        "mixed",
        "stacked",
        "isolate",
        "compare",
        "trace"
      ]
    },
    "target_boundary": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "renderer_level": {
      "enum": [
        "L0",
        "L1",
        "L2"
      ]
    },
    "layer_interaction": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "stacked",
          "isolate",
          "compare",
          "trace"
        ]
      }
    },
    "reader_contract": {
      "$ref": "#/$defs/readerContract"
    },
    "reader_terms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/readerTerm"
      }
    },
    "layer_reader_outcomes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/readerOutcome"
      }
    },
    "readability_dynamics": {
      "$ref": "#/$defs/readabilityDynamics"
    },
    "lanes": {
      "$ref": "#/$defs/lanes"
    },
    "learning_residue": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "kebabId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "snakeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "claimClass": {
      "enum": [
        "source-backed",
        "inferred",
        "target-design",
        "captured-snapshot",
        "legacy"
      ]
    },
    "availability": {
      "enum": [
        "current-repository",
        "current-experimental",
        "legacy",
        "target-design",
        "reference",
        "mixed"
      ]
    },
    "guideIdentity": {
      "type": "object",
      "required": [
        "guide_id",
        "title",
        "status",
        "authority_effect",
        "revision",
        "metrics_snapshot",
        "artifacts"
      ],
      "additionalProperties": false,
      "properties": {
        "guide_id": {
          "const": "domainspec-v2-complete-guide"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "status": {
          "const": "future-user-documentation-candidate"
        },
        "authority_effect": {
          "const": "none"
        },
        "revision": {
          "$ref": "#/$defs/date"
        },
        "metrics_snapshot": {
          "$ref": "#/$defs/date"
        },
        "artifacts": {
          "type": "object",
          "required": [
            "markdown",
            "html",
            "manifest",
            "schema"
          ],
          "additionalProperties": false,
          "properties": {
            "markdown": {
              "$ref": "#/$defs/relativePath"
            },
            "html": {
              "$ref": "#/$defs/relativePath"
            },
            "manifest": {
              "$ref": "#/$defs/relativePath"
            },
            "schema": {
              "$ref": "#/$defs/relativePath"
            }
          }
        }
      }
    },
    "transportContract": {
      "type": "object",
      "required": [
        "transport_id",
        "proof_status",
        "intent_state",
        "objective",
        "target_public",
        "delivery_flow",
        "reader_movement",
        "human_gate",
        "success_signals"
      ],
      "additionalProperties": false,
      "properties": {
        "transport_id": {
          "const": "future_user_guide"
        },
        "proof_status": {
          "enum": [
            "candidate",
            "unproven"
          ]
        },
        "intent_state": {
          "enum": [
            "forming",
            "volatile",
            "frozen"
          ]
        },
        "objective": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "target_public": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "delivery_flow": {
          "const": "active"
        },
        "reader_movement": {
          "const": "active"
        },
        "human_gate": {
          "enum": [
            "not_applicable",
            "pending",
            "approved",
            "rejected"
          ]
        },
        "success_signals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "sourceContract": {
      "type": "object",
      "required": [
        "current_profile",
        "prerequisites",
        "command_availability",
        "editable_sources",
        "generated_outputs",
        "legacy_path",
        "planned_bridge",
        "non_goals",
        "boundary_rule"
      ],
      "additionalProperties": false,
      "properties": {
        "current_profile": {
          "description": "A source-backed summary for readers. This schema validates its shape only; the required profile-registry-sync check compares its content with the authoritative supported-profile registry.",
          "type": "object",
          "required": [
            "id",
            "version",
            "status",
            "release_admission",
            "kinds",
            "relationships",
            "authority_refs",
            "sync_check_id"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "version": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "status": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "release_admission": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "kinds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/nonEmptyString"
              }
            },
            "relationships": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/nonEmptyString"
              }
            },
            "authority_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/relativePath"
              }
            },
            "sync_check_id": {
              "const": "profile-registry-sync"
            }
          }
        },
        "prerequisites": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "command_availability": {
          "type": "object",
          "required": [
            "external_user_command",
            "repository_internal_tools"
          ],
          "additionalProperties": false,
          "properties": {
            "external_user_command": {
              "const": "not-established"
            },
            "repository_internal_tools": {
              "const": "available"
            }
          }
        },
        "editable_sources": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/editableSourceRole"
          }
        },
        "generated_outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/generatedOutputRole"
          }
        },
        "legacy_path": {
          "$ref": "#/$defs/legacyPathBoundary"
        },
        "planned_bridge": {
          "$ref": "#/$defs/plannedBridgeBoundary"
        },
        "non_goals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "boundary_rule": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "editableSourceRole": {
      "type": "object",
      "required": [
        "path",
        "role",
        "editable",
        "authority",
        "owner",
        "derived_from"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "role": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "editable": {
          "const": true
        },
        "authority": {
          "const": "consumer-project-source"
        },
        "owner": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "derived_from": {
          "type": "array",
          "maxItems": 0,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "generatedOutputRole": {
      "type": "object",
      "required": [
        "path",
        "role",
        "editable",
        "authority",
        "owner",
        "derived_from"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "role": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "editable": {
          "const": false
        },
        "authority": {
          "enum": [
            "generated-read-model",
            "generated-evidence"
          ]
        },
        "owner": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "derived_from": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "legacyPathBoundary": {
      "type": "object",
      "required": [
        "status",
        "input",
        "output",
        "rule",
        "fallback_forbidden",
        "joins_with"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "separate-legacy-path"
        },
        "input": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "output": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "rule": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "fallback_forbidden": {
          "const": true
        },
        "joins_with": {
          "type": "array",
          "maxItems": 0,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "plannedBridgeBoundary": {
      "type": "object",
      "required": [
        "status",
        "input",
        "output",
        "rule",
        "fallback_forbidden",
        "joins_with"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "designed-not-implemented"
        },
        "input": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "output": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "rule": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "fallback_forbidden": {
          "const": true
        },
        "joins_with": {
          "type": "array",
          "maxItems": 0,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "learningExperience": {
      "type": "object",
      "required": [
        "experience_id",
        "posture",
        "primary_analogy",
        "modes",
        "story",
        "explanation_pattern",
        "interaction_contract"
      ],
      "additionalProperties": false,
      "properties": {
        "experience_id": {
          "const": "key-and-door-guided-learning"
        },
        "posture": {
          "const": "teaching-simulation"
        },
        "primary_analogy": {
          "$ref": "#/$defs/primaryAnalogy"
        },
        "modes": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/learningMode"
          }
        },
        "story": {
          "$ref": "#/$defs/learningStory"
        },
        "explanation_pattern": {
          "type": "object",
          "required": [
            "required_parts"
          ],
          "additionalProperties": false,
          "properties": {
            "required_parts": {
              "type": "array",
              "minItems": 8,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/kebabId"
              }
            }
          }
        },
        "interaction_contract": {
          "$ref": "#/$defs/interactionContract"
        }
      }
    },
    "primaryAnalogy": {
      "type": "object",
      "required": [
        "label",
        "helps_explain",
        "breaks_before"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "helps_explain": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "breaks_before": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "learningMode": {
      "type": "object",
      "required": [
        "mode_id",
        "label",
        "entry_section",
        "availability"
      ],
      "additionalProperties": false,
      "properties": {
        "mode_id": {
          "enum": [
            "guided-story",
            "workbench",
            "reference"
          ]
        },
        "label": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "entry_section": {
          "$ref": "#/$defs/kebabId"
        },
        "availability": {
          "const": "implemented-static-guide"
        }
      }
    },
    "learningStory": {
      "type": "object",
      "required": [
        "story_id",
        "ordered_beats",
        "interaction_rule",
        "source_backed_beats",
        "target_design_beats",
        "claim_ceiling"
      ],
      "additionalProperties": false,
      "properties": {
        "story_id": {
          "const": "key-and-door"
        },
        "ordered_beats": {
          "const": [
            "frame",
            "describe",
            "connect",
            "check",
            "review",
            "evolve"
          ]
        },
        "interaction_rule": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_backed_beats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "frame",
              "describe",
              "connect",
              "check",
              "review",
              "evolve"
            ]
          }
        },
        "target_design_beats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "frame",
              "describe",
              "connect",
              "check",
              "review",
              "evolve"
            ]
          }
        },
        "claim_ceiling": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "interactionContract": {
      "type": "object",
      "required": [
        "runtime",
        "persistence",
        "network",
        "progressive_enhancement",
        "keyboard_required",
        "no_color_only",
        "reduced_motion",
        "state_consistency",
        "skip_target_focus",
        "status_messages",
        "mobile_fixed_overlays",
        "advanced_controls",
        "reader_movement",
        "reader_surface_voice"
      ],
      "additionalProperties": false,
      "properties": {
        "runtime": {
          "const": "local-static-client"
        },
        "persistence": {
          "const": "browser-local-only"
        },
        "network": {
          "const": "none"
        },
        "progressive_enhancement": {
          "const": true
        },
        "keyboard_required": {
          "const": true
        },
        "no_color_only": {
          "const": true
        },
        "reduced_motion": {
          "const": true
        },
        "state_consistency": {
          "const": true
        },
        "skip_target_focus": {
          "const": true
        },
        "status_messages": {
          "const": true
        },
        "mobile_fixed_overlays": {
          "const": "none"
        },
        "advanced_controls": {
          "const": "progressive-disclosure"
        },
        "reader_movement": {
          "const": "situation-choice-consequence-domain-term-next-question"
        },
        "reader_surface_voice": {
          "const": "direct-guidance-no-authoring-labels"
        }
      }
    },
    "contentArchitecture": {
      "type": "object",
      "required": [
        "entry_paths",
        "required_progression",
        "sections"
      ],
      "additionalProperties": false,
      "properties": {
        "entry_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/entryPath"
          }
        },
        "required_progression": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/kebabId"
          }
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sectionContract"
          }
        }
      }
    },
    "entryPath": {
      "type": "object",
      "required": [
        "path_id",
        "label",
        "reader_need",
        "section_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "path_id": {
          "$ref": "#/$defs/kebabId"
        },
        "label": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reader_need": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "section_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/kebabId"
          }
        }
      }
    },
    "sectionContract": {
      "type": "object",
      "required": [
        "section_id",
        "order",
        "title",
        "reader_job",
        "section_kind",
        "availability",
        "claim_classes",
        "must_answer",
        "evidence_refs",
        "reader_exit"
      ],
      "additionalProperties": false,
      "properties": {
        "section_id": {
          "$ref": "#/$defs/kebabId"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reader_job": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "section_kind": {
          "enum": [
            "orientation",
            "workflow",
            "authoring",
            "reference",
            "walkthrough",
            "boundary",
            "status",
            "troubleshooting",
            "extension",
            "evidence",
            "technical"
          ]
        },
        "availability": {
          "$ref": "#/$defs/availability"
        },
        "claim_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/claimClass"
          }
        },
        "must_answer": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "reader_exit": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "exampleContract": {
      "type": "object",
      "required": [
        "example_id",
        "label",
        "posture",
        "source_role",
        "complete",
        "copy_suitability",
        "observed_on",
        "decision_owner",
        "proves",
        "does_not_prove",
        "evidence_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "example_id": {
          "$ref": "#/$defs/kebabId"
        },
        "label": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "posture": {
          "enum": [
            "checked-current-fixture",
            "target-design-narrative",
            "legacy-example"
          ]
        },
        "source_role": {
          "enum": [
            "consumer-source",
            "narrative-only",
            "legacy-input"
          ]
        },
        "complete": {
          "type": "boolean"
        },
        "copy_suitability": {
          "enum": [
            "current-layout-reference",
            "story-only",
            "legacy-reference-only"
          ]
        },
        "observed_on": {
          "$ref": "#/$defs/date"
        },
        "decision_owner": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "proves": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
