{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domainspec.owner-decision-selection/v1",
  "title": "DomainSpec exact owner-decision selection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "selection_id",
    "decision_id",
    "candidate_digest",
    "subject_sha256",
    "selected_option",
    "owner_identity",
    "owner_route",
    "decision_source",
    "decided_at",
    "authority_effect",
    "claim_limit",
    "selection_digest"
  ],
  "properties": {
    "schema_version": {"const": "domainspec.owner-decision-selection/v1"},
    "selection_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "candidate_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "subject_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "selected_option": {"type": "string", "minLength": 1},
    "owner_identity": {"type": "string", "minLength": 1},
    "owner_route": {"type": "string", "minLength": 1},
    "decision_source": {"type": "string", "minLength": 1},
    "decided_at": {"type": "string", "format": "date-time"},
    "authority_effect": {"enum": ["definition-admission-only", "product-capability-adoption-only", "business-ontology-admission-only", "domainspec-source-acceptance-only", "domainspec-profile-eligibility-only", "system-ontology-admission-only"]},
    "prerequisite_selection_digests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "additional_source_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "claim_limit": {"type": "string", "minLength": 1},
    "selection_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
