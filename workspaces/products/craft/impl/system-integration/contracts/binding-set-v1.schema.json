{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/system-integration/binding-set-v1.schema.json",
  "title": "DomainSpec system-integration binding set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "binding_set_id", "profile_id", "subject_ref", "dependency_contracts", "persistence_bindings", "transaction_guarantee_bindings", "failure_outcome_bindings", "durable_workflow_runtime_bindings", "authority_effect"],
  "properties": {
    "schema_version": {"const": "domainspec.system-integration-binding-set/v1"},
    "binding_set_id": {"$ref": "integration-reference-v1.schema.json"},
    "profile_id": {"const": "domainspec.system-integration-profile/provider-neutral-v1"},
    "subject_ref": {"type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"},
    "dependency_contracts": {"type": "array", "minItems": 1, "items": {"$ref": "dependency-contract-v1.schema.json"}},
    "persistence_bindings": {"type": "array", "items": {"$ref": "persistence-binding-v1.schema.json"}},
    "transaction_guarantee_bindings": {"type": "array", "items": {"$ref": "transaction-guarantee-binding-v1.schema.json"}},
    "failure_outcome_bindings": {"type": "array", "items": {"$ref": "failure-outcome-binding-v1.schema.json"}},
    "durable_workflow_runtime_bindings": {"type": "array", "items": {"$ref": "durable-workflow-runtime-binding-v1.schema.json"}},
    "authority_effect": {"const": "none"}
  }
}
