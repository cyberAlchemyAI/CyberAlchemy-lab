{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/system-integration/failure-outcome-binding-v1.schema.json",
  "title": "D48 Failure Outcome Binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["binding_id", "concern_ref", "provider_outcome_ref", "outcome_class", "evidence_refs", "continuation_owner_ref"],
  "properties": {
    "binding_id": {"$ref": "integration-reference-v1.schema.json"},
    "concern_ref": {"$ref": "integration-reference-v1.schema.json"},
    "provider_outcome_ref": {"$ref": "integration-reference-v1.schema.json"},
    "outcome_class": {"enum": ["retryable", "non-retryable", "unknown"]},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "integration-reference-v1.schema.json"}},
    "continuation_owner_ref": {"$ref": "integration-reference-v1.schema.json"}
  }
}
