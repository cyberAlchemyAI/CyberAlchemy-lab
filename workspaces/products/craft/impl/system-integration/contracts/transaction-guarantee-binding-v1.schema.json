{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/system-integration/transaction-guarantee-binding-v1.schema.json",
  "title": "D47 Transaction Guarantee Binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["binding_id", "unit_of_work_contract_ref", "participant_refs", "atomicity_scope", "selected_guarantees", "implementation_profile_ref", "failure_outcome_binding_ref", "evidence_boundary"],
  "properties": {
    "binding_id": {"$ref": "integration-reference-v1.schema.json"},
    "unit_of_work_contract_ref": {"$ref": "integration-reference-v1.schema.json"},
    "participant_refs": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "integration-reference-v1.schema.json"}},
    "atomicity_scope": {"type": "string", "minLength": 1},
    "selected_guarantees": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["atomicity", "isolation", "durability", "conflict-detection", "rollback-restoration"]}},
    "implementation_profile_ref": {"$ref": "integration-reference-v1.schema.json"},
    "failure_outcome_binding_ref": {"$ref": "integration-reference-v1.schema.json"},
    "evidence_boundary": {"type": "string", "minLength": 1}
  }
}
