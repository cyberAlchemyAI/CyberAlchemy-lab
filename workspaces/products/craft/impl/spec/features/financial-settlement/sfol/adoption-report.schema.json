{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domainspec-sfol-adoption-report/v1",
  "title": "Financial Settlement experimental DS-SFOL adoption report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "authority",
    "authority_effect",
    "formal_owner_approval",
    "release_admission",
    "project_id",
    "schema",
    "tool",
    "source_proposal",
    "proof_context",
    "modules",
    "stage_sets",
    "case_count",
    "fixture_ids",
    "admitted_clause_ids",
    "admitted_residue",
    "non_admitted_residue",
    "mutations",
    "core_path_audit",
    "bte",
    "claims",
    "report_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "domainspec-sfol-adoption-report/v1"
    },
    "status": {
      "const": "pass"
    },
    "authority": {
      "const": "experimental-test-lane-evidence"
    },
    "authority_effect": {
      "const": "none"
    },
    "formal_owner_approval": {
      "const": false
    },
    "release_admission": {
      "const": "not-granted"
    },
    "project_id": {
      "const": "financial-settlement"
    },
    "schema": {
      "$ref": "#/$defs/fileHandle"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner",
        "validator",
        "consumer_adapter",
        "proof_tool_digest"
      ],
      "properties": {
        "runner": {
          "$ref": "#/$defs/fileHandle"
        },
        "validator": {
          "$ref": "#/$defs/fileHandle"
        },
        "consumer_adapter": {
          "$ref": "#/$defs/fileHandle"
        },
        "proof_tool_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "source_proposal": {
      "$ref": "#/$defs/fileHandle"
    },
    "proof_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph_digest",
        "manifest_digest",
        "build_digest",
        "source_set_digest",
        "profile_digest"
      ],
      "properties": {
        "graph_digest": {
          "$ref": "#/$defs/digest"
        },
        "manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "build_digest": {
          "$ref": "#/$defs/digest"
        },
        "source_set_digest": {
          "$ref": "#/$defs/digest"
        },
        "profile_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "clause_id",
          "module_id",
          "module_digest",
          "typed_artifact_digest",
          "denominator_digest",
          "case_ids",
          "proof_receipt_digest",
          "replay_digest"
        ],
        "properties": {
          "clause_id": {
            "enum": [
              "C3",
              "P4"
            ]
          },
          "module_id": {
            "type": "string",
            "minLength": 1
          },
          "module_digest": {
            "$ref": "#/$defs/digest"
          },
          "typed_artifact_digest": {
            "$ref": "#/$defs/digest"
          },
          "denominator_digest": {
            "$ref": "#/$defs/digest"
          },
          "case_ids": {
            "$ref": "#/$defs/nonEmptyStringSet"
          },
          "proof_receipt_digest": {
            "$ref": "#/$defs/digest"
          },
          "replay_digest": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "stage_sets": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "case_ids"
        ],
        "properties": {
          "stage": {
            "enum": [
              "C_spec",
              "C_projected",
              "C_validated",
              "C_typed",
              "T_generated",
              "C_bound",
              "O_run",
              "R_evaluated"
            ]
          },
          "case_ids": {
            "$ref": "#/$defs/nonEmptyStringSet"
          }
        }
      }
    },
    "case_count": {
      "const": 4
    },
    "fixture_ids": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "admitted_clause_ids": {
      "type": "array",
      "prefixItems": [
        {
          "const": "C3"
        },
        {
          "const": "P4"
        }
      ],
      "items": false
    },
    "admitted_residue": {
      "type": "array",
      "maxItems": 0
    },
    "non_admitted_residue": {
      "type": "array",
      "minItems": 13,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mutations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "C3-comparator",
        "C3-returned-value",
        "P4-missing-write",
        "P4-missing-event",
        "P4-wrong-amount",
        "P4-wrong-date",
        "P4-wrong-order",
        "P4-proof-input"
      ],
      "properties": {
        "C3-comparator": {
          "const": "detected"
        },
        "C3-returned-value": {
          "const": "detected"
        },
        "P4-missing-write": {
          "const": "detected"
        },
        "P4-missing-event": {
          "const": "detected"
        },
        "P4-wrong-amount": {
          "const": "detected"
        },
        "P4-wrong-date": {
          "const": "detected"
        },
        "P4-wrong-order": {
          "const": "detected"
        },
        "P4-proof-input": {
          "const": "detected"
        }
      }
    },
    "core_path_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "before_digest",
        "after_digest",
        "added",
        "removed",
        "changed"
      ],
      "properties": {
        "status": {
          "const": "pass"
        },
        "before_digest": {
          "$ref": "#/$defs/digest"
        },
        "after_digest": {
          "$ref": "#/$defs/digest"
        },
        "added": {
          "type": "array",
          "maxItems": 0
        },
        "removed": {
          "type": "array",
          "maxItems": 0
        },
        "changed": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "bte": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifier_status",
        "structural_result",
        "behavioral_authority"
      ],
      "properties": {
        "verifier_status": {
          "const": "pass"
        },
        "structural_result": {
          "const": "expected-red"
        },
        "behavioral_authority": {
          "const": false
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experimental_c3_p4_profile_complete",
        "full_financial_settlement_coverage",
        "formal_source_approval",
        "release_ready",
        "production_ready"
      ],
      "properties": {
        "experimental_c3_p4_profile_complete": {
          "const": true
        },
        "full_financial_settlement_coverage": {
          "const": false
        },
        "formal_source_approval": {
          "const": false
        },
        "release_ready": {
          "const": false
        },
        "production_ready": {
          "const": false
        }
      }
    },
    "report_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fileHandle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "nonEmptyStringSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
