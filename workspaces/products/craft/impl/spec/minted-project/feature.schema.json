{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/minted-project/feature/v1",
  "title": "Minted Feature Source",
  "description": "Consumer-owned feature manifest enumerating one canonical node file per node.",
  "type": "object",
  "required": ["schema_version", "feature_id", "source_layout", "node_sources"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "minted-feature/v1"},
    "feature_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "source_layout": {"const": "per-node-connections"},
    "node_sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$", "x-project-relative-path": true}
    }
  },
  "x-domainspec": {"record": "feature", "role": "source", "authority": "consumer-project-source", "version": "minted-feature/v1"}
}
