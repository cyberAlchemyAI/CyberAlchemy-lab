{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/minted-project/graph/v1",
  "title": "Minted Normalized Graph",
  "description": "Generated layout-neutral semantic read model with first-class nodes and edges.",
  "type": "object",
  "required": ["schema_version", "authority", "project_id", "language", "source_set_digest", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "minted-graph/v1"},
    "authority": {"const": "generated-semantic-read-model"},
    "project_id": {"type": "string", "minLength": 1},
    "language": {
      "type": "object",
      "required": ["profile_digest", "kinds_digest", "relationships_digest"],
      "additionalProperties": false,
      "properties": {
        "profile_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "kinds_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "relationships_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "source_set_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "feature_id", "kind", "intent", "body"],
        "additionalProperties": false,
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "feature_id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "intent": {"type": "string", "minLength": 1},
          "body": {"type": "object", "minProperties": 1}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["edge_id", "type", "from", "to"],
        "additionalProperties": false,
        "properties": {
          "edge_id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "x-domainspec": {"record": "graph", "role": "generated", "authority": "generated-semantic-read-model", "version": "minted-graph/v1"}
}
