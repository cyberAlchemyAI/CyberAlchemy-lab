{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/minted-project/node/v1",
  "title": "Minted Node Source",
  "description": "Consumer-owned canonical node source with typed body and source-owned outgoing connections.",
  "type": "object",
  "required": ["schema_version", "node_id", "feature_id", "kind", "intent", "body", "connections"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "minted-node/v1"},
    "node_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[A-Za-z][A-Za-z0-9]*$"},
    "feature_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "kind": {"type": "string", "minLength": 1},
    "intent": {"type": "string", "minLength": 1},
    "body": {"type": "object", "minProperties": 1},
    "connections": {"type": "array", "items": {"$ref": "./connection.schema.json"}}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "Entity"}}},
      "then": {"properties": {"body": {"$ref": "./formations/entity-body.schema.json"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "Event"}}},
      "then": {"properties": {"body": {"$ref": "./formations/event-body.schema.json"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "Operation"}}},
      "then": {"properties": {"body": {"$ref": "./formations/operation-body.schema.json"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "Rule"}}},
      "then": {"properties": {"body": {"$ref": "./formations/rule-body.schema.json"}}}
    }
  ],
  "x-domainspec": {"record": "node", "role": "source", "authority": "consumer-project-source", "version": "minted-node/v1"}
}
