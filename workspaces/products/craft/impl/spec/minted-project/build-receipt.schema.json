{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/minted-project/build-receipt/v1",
  "title": "Minted Build Receipt",
  "description": "Generated verification evidence binding the evaluated profile, language registries, source set, graph, provenance manifest, and Markdown view.",
  "type": "object",
  "required": ["schema_version", "authority", "status", "project_id", "language", "source_set_digest", "artifacts", "generator_version"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "minted-build-receipt/v1"},
    "authority": {"const": "generated-verification-evidence"},
    "status": {"enum": ["pass", "degraded"]},
    "project_id": {"type": "string", "minLength": 1},
    "language": {
      "type": "object",
      "required": ["profile_id", "profile_version", "profile_digest", "kinds_digest", "relationships_digest"],
      "additionalProperties": false,
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "profile_version": {"type": "string", "minLength": 1},
        "profile_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "kinds_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "relationships_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "source_set_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifacts": {
      "type": "object",
      "required": ["graph_digest", "source_manifest_digest", "markdown_view_digest", "markdown_content_digest"],
      "additionalProperties": false,
      "properties": {
        "graph_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_manifest_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "markdown_view_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "markdown_content_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "generator_version": {"type": "string", "minLength": 1}
  },
  "x-domainspec": {"record": "build-receipt", "role": "generated", "authority": "generated-verification-evidence", "version": "minted-build-receipt/v1"}
}
