{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/minted-project/formations/entity-body/v1",
  "title": "Minted Entity Body",
  "description": "Machine representation of the Entity typedness and identity formation criteria.",
  "type": "object",
  "required": ["fields"],
  "properties": {
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type", "identity"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "identity": {"type": "boolean"}
        }
      },
      "contains": {
        "type": "object",
        "required": ["identity"],
        "properties": {"identity": {"const": true}}
      }
    }
  },
  "x-domainspec": {"record": "entity-body", "role": "source", "authority": "consumer-project-source", "version": "minted-entity-body/v1"}
}
