{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/minted-project/connection/v1",
  "title": "Minted Source-Owned Connection",
  "description": "Stable outgoing edge identity authored by its source node. The from endpoint is derived and therefore forbidden here.",
  "type": "object",
  "required": ["edge_id", "type", "to"],
  "additionalProperties": false,
  "properties": {
    "edge_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*\\.edge\\.[a-z][a-z0-9-]*$"},
    "type": {"type": "string", "minLength": 1},
    "to": {"type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[A-Za-z][A-Za-z0-9]*$"}
  },
  "x-domainspec": {"record": "connection", "role": "source", "authority": "source-node-owned", "version": "minted-connection/v1", "derived_fields": ["from"]}
}
