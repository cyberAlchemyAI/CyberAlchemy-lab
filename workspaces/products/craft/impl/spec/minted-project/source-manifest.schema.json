{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/minted-project/source-manifest/v1",
  "title": "Minted Source Manifest",
  "description": "Generated provenance read model mapping every graph identity to one contained project-local source.",
  "type": "object",
  "required": ["schema_version", "authority", "project_id", "source_set_digest", "inputs", "records"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "minted-source-manifest/v1"},
    "authority": {"const": "generated-provenance-read-model"},
    "project_id": {"type": "string", "minLength": 1},
    "source_set_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "digest"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1, "x-project-relative-path": true},
          "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["record_type", "graph_id", "source_path", "source_digest"],
        "additionalProperties": false,
        "properties": {
          "record_type": {"enum": ["node", "edge"]},
          "graph_id": {"type": "string", "minLength": 1},
          "source_path": {"type": "string", "minLength": 1, "x-project-relative-path": true},
          "source_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  },
  "x-domainspec": {"record": "source-manifest", "role": "generated", "authority": "generated-provenance-read-model", "version": "minted-source-manifest/v1"}
}
