            "selector": "capacity-decision:capacity-snapshot"
          }
        }
      ],
      "result": {
        "kind": "named",
        "selector": "capacity-decision:capacity-decision"
      },
      "expression": {
        "op": "if",
        "condition": {
          "op": "rule_ref",
          "selector": "capacity-decision:within-capacity",
          "arguments": [
            {
              "parameter": "snapshot",
              "value": {
                "op": "path",
                "root": "snapshot",
                "properties": []
              }
            }
          ]
        },
        "then": {
          "variant": "Accept",
          "payload": null
        },
        "else": {
          "variant": "Reject",
          "payload": null
        }
      }
    }
  }
}
