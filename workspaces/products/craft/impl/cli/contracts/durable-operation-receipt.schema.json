{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/contracts/durable-operation-receipt.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "invocation_id", "provider", "provider_implementation_sha256", "project_id", "selector", "source_manifest_sha256", "compiled_certificate_sha256", "checked_interchange_sha256", "request_sha256", "semantic_output_sha256", "commit_status", "committed_version", "event_ids", "observed_guarantees", "authority_effect", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "domainspec.durable-operation-receipt/v1"}, "invocation_id": {"type": "string", "minLength": 1}, "provider": {"enum": ["sqlite-transactional-outbox-v1", "postgres-transactional-outbox-v1"]}, "provider_implementation_sha256": {"$ref": "#/$defs/sha256"}, "project_id": {"type": "string", "minLength": 1}, "selector": {"type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"}, "source_manifest_sha256": {"$ref": "#/$defs/sha256"}, "compiled_certificate_sha256": {"$ref": "#/$defs/sha256"}, "checked_interchange_sha256": {"$ref": "#/$defs/sha256"}, "request_sha256": {"$ref": "#/$defs/sha256"}, "semantic_output_sha256": {"$ref": "#/$defs/sha256"}, "commit_status": {"enum": ["committed", "already-committed", "guard-rejected"]}, "committed_version": {"type": ["integer", "null"], "minimum": 0}, "event_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "observed_guarantees": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "authority_effect": {"const": "none"}, "receipt_sha256": {"$ref": "#/$defs/sha256"}
  }, "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
