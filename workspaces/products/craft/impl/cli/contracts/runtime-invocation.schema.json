{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/contracts/runtime-invocation.schema.json",
  "title": "DomainSpec deterministic runtime invocation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "invocation_id", "provider", "steps"],
  "properties": {
    "schema_version": {"const": "domainspec.runtime-invocation/v1"},
    "invocation_id": {"$ref": "#/$defs/id"},
    "provider": {"const": "in-memory-v1"},
    "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "step": {
      "type": "object", "additionalProperties": false, "required": ["step_id", "selector", "input"],
      "properties": {"step_id": {"$ref": "#/$defs/id"}, "selector": {"type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"}, "input": {"type": "object"}}
    }
  }
}
