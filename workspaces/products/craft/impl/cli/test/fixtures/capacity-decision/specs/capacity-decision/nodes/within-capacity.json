{
  "schema_version": "domainspec.node/v1",
  "node_id": "within-capacity",
  "feature_id": "capacity-decision",
  "kind": "Rule",
  "body": {
    "description": "The request consumes strictly fewer units than are available.",
    "predicate": "structured:domainspec.typed-rule/v1",
    "typed_contract": {
      "schema_version": "domainspec.typed-rule/v1",
      "ontology_rule": "CAPACITY-RULE-WITHIN-AVAILABLE",
      "parameters": [
        {
          "name": "snapshot",
          "type": {"kind": "named", "selector": "capacity-decision:capacity-snapshot"}
        }
      ],
      "expression": {
        "op": "lt",
        "left": {
          "op": "path",
          "root": "snapshot",
          "properties": ["CAPACITY-SNAPSHOT#requested_units"]
        },
        "right": {
          "op": "path",
          "root": "snapshot",
          "properties": ["CAPACITY-SNAPSHOT#available_units"]
        }
      }
    }
  }
}
