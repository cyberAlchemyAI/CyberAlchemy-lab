{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:domainspec-v2:bte:red-fixture-manifest:v1",
  "title": "BTE Red Fixture Manifest v1",
  "description": "Validation-owner-authored red cases bound to one exact L0A publication digest.",
  "type": "object",
  "required": ["schema_version", "manifest_id", "contract_publication_sha256", "validation_owner", "cases"],
  "properties": {
    "schema_version": { "const": "bte-red-fixture-manifest/v1" },
    "manifest_id": { "$ref": "urn:domainspec-v2:bte:logical-identity:v1" },
    "contract_publication_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "validation_owner": { "$ref": "urn:domainspec-v2:bte:authority-class:v1" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["case_id", "subject_contract_id", "fixture", "expected_diagnostic"],
        "properties": {
          "case_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "subject_contract_id": { "type": "string", "minLength": 1 },
          "fixture": { "$ref": "urn:domainspec-v2:bte:artifact-handle:v1" },
          "expected_diagnostic": { "$ref": "urn:domainspec-v2:bte:diagnostic:v1" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

