{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:domainspec-v2:bte:exact-set:v1",
  "title": "BTE Exact Set v1",
  "description": "A nonempty declared member envelope with a separately recomputable membership digest.",
  "type": "object",
  "required": ["schema_version", "set_id", "membership_digest", "members"],
  "properties": {
    "schema_version": { "const": "bte-exact-set/v1" },
    "set_id": { "$ref": "urn:domainspec-v2:bte:logical-identity:v1" },
    "membership_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "members": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["logical_identity", "content_sha256"],
        "properties": {
          "logical_identity": { "$ref": "urn:domainspec-v2:bte:logical-identity:v1" },
          "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

