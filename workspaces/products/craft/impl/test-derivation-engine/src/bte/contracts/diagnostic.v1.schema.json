{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:domainspec-v2:bte:diagnostic:v1",
  "title": "BTE Diagnostic v1",
  "description": "One closed, precedence-ordered diagnostic observation.",
  "type": "object",
  "required": ["schema_version", "code", "precedence", "stage", "subject", "detail"],
  "properties": {
    "schema_version": { "const": "bte-diagnostic/v1" },
    "code": {
      "enum": [
        "BTE_SCHEMA_INVALID",
        "BTE_SCHEMA_UNSUPPORTED_KEYWORD",
        "BTE_LOGICAL_ID_MISSING",
        "BTE_LOGICAL_ID_EXTRA",
        "BTE_LOGICAL_ID_DUPLICATE",
        "BTE_DIGEST_MALFORMED",
        "BTE_DIGEST_MISMATCH",
        "BTE_CONTRACT_STALE",
        "BTE_PRODUCER_MISMATCH",
        "BTE_AUTHORITY_FORGED",
        "BTE_AUTHORITY_SUBSTITUTED",
        "BTE_PATH_ABSOLUTE",
        "BTE_PATH_TRAVERSAL",
        "BTE_PATH_SYMLINK_ESCAPE",
        "BTE_ROOT_UNDECLARED",
        "BTE_OUTPUT_OVERWRITE",
        "BTE_EXACT_SET_EMPTY",
        "BTE_EXACT_SET_DUPLICATE",
        "BTE_RECOMPOSITION_MISSING",
        "BTE_RECOMPOSITION_EXTRA",
        "BTE_RECOMPOSITION_OVERLAP",
        "BTE_DIAGNOSTIC_UNKNOWN",
        "BTE_DIAGNOSTIC_PRECEDENCE",
        "BTE_EXPECTATION_SELF_AUTHORED",
        "BTE_EXPECTATION_REWRITTEN"
      ]
    },
    "precedence": { "type": "integer", "minimum": 1 },
    "stage": { "enum": ["shape", "identity", "digest", "provenance", "authority", "containment", "write", "recomposition", "diagnostic", "expectation"] },
    "subject": { "type": "string", "minLength": 1 },
    "detail": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}

