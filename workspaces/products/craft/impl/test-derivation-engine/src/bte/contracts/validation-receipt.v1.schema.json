{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:domainspec-v2:bte:validation-receipt:v1",
  "title": "BTE Validation Receipt v1",
  "description": "A bounded L0 validation result that cannot grant admission or substitute for later evidence types.",
  "type": "object",
  "required": ["schema_version", "receipt_kind", "receipt_id", "publication_receipt_handle", "manifest_handle", "freeze_receipt_handle", "raw_results", "output_write_manifest", "result", "admission"],
  "properties": {
    "schema_version": { "const": "bte-validation-receipt/v1" },
    "receipt_kind": { "const": "validation" },
    "receipt_id": { "$ref": "urn:domainspec-v2:bte:logical-identity:v1" },
    "publication_receipt_handle": { "$ref": "urn:domainspec-v2:bte:artifact-handle:v1" },
    "manifest_handle": { "$ref": "urn:domainspec-v2:bte:artifact-handle:v1" },
    "freeze_receipt_handle": { "$ref": "urn:domainspec-v2:bte:artifact-handle:v1" },
    "raw_results": { "$ref": "urn:domainspec-v2:bte:exact-set:v1" },
    "output_write_manifest": { "$ref": "urn:domainspec-v2:bte:artifact-handle:v1" },
    "result": { "enum": ["pass", "fail"] },
    "admission": { "const": "not-granted" }
  },
  "additionalProperties": false
}

