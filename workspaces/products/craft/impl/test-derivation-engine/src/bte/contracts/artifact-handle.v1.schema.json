{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:domainspec-v2:bte:artifact-handle:v1",
  "title": "BTE Artifact Handle v1",
  "description": "An immutable project-relative artifact reference with identity, producer, authority, digest, and byte size.",
  "type": "object",
  "required": ["schema_version", "root_id", "path", "schema_id", "logical_identity", "sha256", "bytes", "producer", "authority"],
  "properties": {
    "schema_version": { "const": "bte-artifact-handle/v1" },
    "root_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "path": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$" },
    "schema_id": { "type": "string", "minLength": 1 },
    "logical_identity": { "$ref": "urn:domainspec-v2:bte:logical-identity:v1" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "bytes": { "type": "integer", "minimum": 0 },
    "producer": {
      "type": "object",
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "authority": { "$ref": "urn:domainspec-v2:bte:authority-class:v1" }
  },
  "additionalProperties": false
}

