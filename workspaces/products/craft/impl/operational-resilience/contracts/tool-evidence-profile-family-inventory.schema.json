{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:domainspec:orodi:tool-evidence-profile-family-inventory:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "inventory_id", "inventory_version", "valid_families", "deferred_extensions", "authority_effect"],
  "properties": {
    "schema_version": {"const": "domainspec.orodi.tool-evidence-profile-family-inventory/v1"},
    "inventory_id": {"const": "domainspec.orodi.tool-evidence-profile-families"},
    "inventory_version": {"const": "1.0.0-candidate-local"},
    "valid_families": {
      "type": "array", "minItems": 7, "maxItems": 7,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["family_id", "allowed_normalized_kinds", "required_safeguards", "required_referent_roles", "attribute_policy_sha256"],
        "properties": {
          "family_id": {"enum": ["telemetry", "health-failure", "workload", "fault", "canary-analysis", "deployment-observation", "rollback-observation"]},
          "allowed_normalized_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "required_safeguards": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "required_referent_roles": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "attribute_policy_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "deferred_extensions": {"const": ["infrastructure-plan", "compatibility"]},
    "authority_effect": {"const": "none"}
  }
}
