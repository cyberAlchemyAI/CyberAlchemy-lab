{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://domainspec.dev/orodi/body-war-canary-evidence-pack.schema.json",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","run_id","raw_pack_sha256","size_bytes","complete","protected_value_scan","decision_present","observer_present","teardown_present","runtime_project_residue","declared_preparation_residue","evidence_residue","source_mode","runtime_admission","authority_effect"],
  "properties":{
    "schema_version":{"const":"domainspec.orodi.body-war-canary-evidence-pack/v1"},
    "run_id":{"type":"string","minLength":1},
    "raw_pack_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "size_bytes":{"type":"integer","minimum":0,"maximum":33554432},
    "complete":{"const":true},
    "protected_value_scan":{"const":"pass"},
    "decision_present":{"const":true},
    "observer_present":{"const":true},
    "teardown_present":{"const":true},
    "runtime_project_residue":{"type":"array","maxItems":0},
    "declared_preparation_residue":{"type":"array","items":{"type":"string"}},
    "evidence_residue":{"type":"array","items":{"type":"string"}},
    "source_mode":{"const":"runtime-receipt-derived-offline-snapshot"},
    "runtime_admission":{"const":"denied"},
    "authority_effect":{"const":"none"}
  }
}
