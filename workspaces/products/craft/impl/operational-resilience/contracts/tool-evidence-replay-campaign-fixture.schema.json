{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:domainspec:orodi:tool-evidence-replay-campaign-fixture:v1",
  "title": "ORODI Candidate-Local Offline Replay Campaign Fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evaluated_at", "campaigns", "authority_effect"],
  "properties": {
    "schema_version": {"const": "domainspec.orodi.tool-evidence-replay-campaign-fixture/v1"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "campaigns": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/campaign"}
    },
    "authority_effect": {"const": "none"}
  },
  "$defs": {
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "campaign_id", "item_case_ids"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^golden-[a-z0-9-]+$"},
        "campaign_id": {"type": "string", "pattern": "^campaign-[a-z0-9-]+$"},
        "item_case_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^golden-[a-z0-9-]+$"}
        }
      }
    }
  }
}
