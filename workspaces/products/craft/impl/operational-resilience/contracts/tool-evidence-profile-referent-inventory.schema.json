{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:domainspec:orodi:tool-evidence-profile-referent-inventory:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "inventory_id", "inventory_version", "referents", "authority_effect"],
  "properties": {
    "schema_version": {"const": "domainspec.orodi.tool-evidence-profile-referent-inventory/v1"},
    "inventory_id": {"type": "string", "minLength": 1},
    "inventory_version": {"type": "string", "minLength": 1},
    "referents": {
      "type": "array", "minItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["ref", "role", "name", "version", "sha256", "bytes_utf8"],
        "properties": {
          "ref": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes_utf8": {"type": "string"}
        }
      }
    },
    "authority_effect": {"const": "none"}
  }
}
