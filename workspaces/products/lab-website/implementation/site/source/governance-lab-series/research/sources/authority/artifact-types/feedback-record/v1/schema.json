{
  "$id": "https://cyberalchemy.local/schemas/feedback-record/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "minLength": 1,
      "type": "string"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "kind": {
      "const": "feedback-record"
    },
    "lifecycle_state": {
      "enum": [
        "candidate",
        "active",
        "historical",
        "retired"
      ]
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "node_id": {
      "minLength": 1,
      "type": "string"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "context_ref": {
          "minLength": 1,
          "type": "string"
        },
        "feedback_kind": {
          "minLength": 1,
          "type": "string"
        },
        "interpretation_posture": {
          "minLength": 1,
          "type": "string"
        },
        "recorded_at": {
          "minLength": 1,
          "type": "string"
        },
        "source_ref": {
          "minLength": 1,
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "type": "string"
        },
        "target_ref": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "source_ref",
        "target_ref",
        "recorded_at",
        "feedback_kind",
        "statement",
        "context_ref",
        "interpretation_posture"
      ],
      "type": "object"
    },
    "relation_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "counterpart_kind": {
            "enum": [
              "agent-action",
              "agent-reflection",
              "challenge-event",
              "classification-assignment",
              "drift-assessment",
              "failure-assessment",
              "failure-occurrence",
              "feedback-record",
              "improvement-signal",
              "lesson-outcome-assessment",
              "operational-lesson",
              "policy",
              "preference-application-assessment",
              "source",
              "work-outcome-assessment"
            ]
          },
          "counterpart_ref": {
            "minLength": 1,
            "type": "string"
          },
          "direction": {
            "enum": [
              "source",
              "target"
            ]
          },
          "relation_kind_ref": {
            "enum": [
              "relation.challenges",
              "relation.derives-from",
              "relation.evidence-bears-on",
              "relation.governed-by",
              "relation.originates-from",
              "relation.produces",
              "relation.successor-of"
            ]
          }
        },
        "required": [
          "relation_kind_ref",
          "direction",
          "counterpart_kind",
          "counterpart_ref"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "cyberalchemy-lab-feedback-record/v1"
    },
    "scope_ref": {
      "minLength": 1,
      "type": "string"
    },
    "successor_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "node_id",
    "kind",
    "name",
    "lifecycle_state",
    "authority_effect",
    "owner_ref",
    "scope_ref",
    "evidence_refs",
    "challenge_route",
    "successor_refs",
    "relation_refs",
    "payload",
    "claim_ceiling"
  ],
  "type": "object"
}
