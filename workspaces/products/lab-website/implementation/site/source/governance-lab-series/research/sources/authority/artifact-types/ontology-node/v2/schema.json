{
  "$id": "https://cyberalchemy.local/schemas/ontology-node/v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "minLength": 1,
      "type": "string"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "kind": {
      "const": "ontology-node"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "node_id": {
      "minLength": 1,
      "type": "string"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "branch": {
          "enum": [
            "business",
            "system",
            "bridge",
            "mixed",
            "unknown"
          ]
        },
        "governance_binding": {
          "additionalProperties": false,
          "properties": {
            "authority_effect": {
              "const": "none"
            },
            "challenge_contract_ref": {
              "minLength": 1,
              "type": "string"
            },
            "commitment_confidence_ref": {
              "minLength": 1,
              "type": "string"
            },
            "evidence_confidence_ref": {
              "minLength": 1,
              "type": "string"
            },
            "governance_event_refs": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            },
            "semantic_event_ref": {
              "additionalProperties": false,
              "properties": {
                "semantic_cursor": {
                  "minimum": 1,
                  "type": "integer"
                },
                "semantic_event_digest": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                "semantic_event_id": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "semantic_event_id",
                "semantic_event_digest",
                "semantic_cursor"
              ],
              "type": "object"
            }
          },
          "required": [
            "semantic_event_ref",
            "governance_event_refs",
            "evidence_confidence_ref",
            "commitment_confidence_ref",
            "challenge_contract_ref",
            "authority_effect"
          ],
          "type": "object"
        },
        "node_type_ref": {
          "minLength": 1,
          "type": "string"
        },
        "ontology_manifest_ref": {
          "minLength": 1,
          "type": "string"
        },
        "ontology_ref": {
          "minLength": 1,
          "type": "string"
        },
        "profile_ref": {
          "minLength": 1,
          "type": "string"
        },
        "provenance_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "replay_source": {
          "const": false
        },
        "represented_subject": {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "kind": {
              "minLength": 1,
              "type": "string"
            },
            "ref": {
              "minLength": 1,
              "type": "string"
            },
            "version_ref": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "kind",
            "ref",
            "version_ref",
            "digest"
          ],
          "type": "object"
        },
        "semantic_state": {
          "additionalProperties": false,
          "properties": {
            "forbidden_collapse": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "label": {
              "minLength": 1,
              "type": "string"
            },
            "lifecycle": {
              "enum": [
                "active",
                "retired",
                "removed"
              ]
            },
            "proposition": {
              "minLength": 1,
              "type": "string"
            },
            "semantic_components": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            },
            "semantic_definition_refs": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            },
            "typed_properties": {
              "type": "object"
            },
            "use_obligations": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "lifecycle",
            "label",
            "proposition",
            "semantic_components",
            "semantic_definition_refs",
            "typed_properties",
            "use_obligations",
            "forbidden_collapse"
          ],
          "type": "object"
        }
      },
      "required": [
        "ontology_ref",
        "ontology_manifest_ref",
        "represented_subject",
        "node_type_ref",
        "profile_ref",
        "branch",
        "semantic_state",
        "governance_binding",
        "provenance_refs",
        "replay_source"
      ],
      "type": "object"
    },
    "record_state": {
      "enum": [
        "candidate",
        "admitted",
        "historical",
        "retired"
      ]
    },
    "schema_version": {
      "const": "cyberalchemy-lab-ontology-node/v2"
    },
    "scope_ref": {
      "minLength": 1,
      "type": "string"
    },
    "successor_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "node_id",
    "kind",
    "name",
    "record_state",
    "authority_effect",
    "owner_ref",
    "scope_ref",
    "evidence_refs",
    "challenge_route",
    "successor_refs",
    "payload",
    "claim_ceiling"
  ],
  "type": "object"
}
