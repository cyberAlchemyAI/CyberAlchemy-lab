{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/coordination-context/v2",
  "title": "CyberAlchemy Lab Coordination Context v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "cyberalchemy-lab-coordination-context/v2"},
    "coordination_context_id": {"type": "string", "pattern": "\\S"},
    "version": {"type": "string", "pattern": "\\S"},
    "status": {"const": "candidate-unadmitted"},
    "authority_effect": {"const": "none"},
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type_ref", "semantic_kind", "authority_kind", "lifecycle_posture_ref"],
      "properties": {
        "artifact_type_ref": {"const": "cal.artifact-type.coordination-context/v2"},
        "semantic_kind": {"const": "coordination-context"},
        "authority_kind": {"const": "none"},
        "lifecycle_posture_ref": {"type": "string", "pattern": "\\S"}
      }
    },
    "product_ref": {"type": "string", "pattern": "\\S"},
    "project_ref": {
      "anyOf": [
        {"type": "string", "pattern": "\\S"},
        {"type": "null"}
      ]
    },
    "goal_ref": {
      "anyOf": [
        {"type": "string", "pattern": "\\S"},
        {"type": "null"}
      ]
    },
    "purpose": {"type": "string", "pattern": "\\S"},
    "consumer_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "\\S"}
    },
    "intended_uses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "\\S"}
    },
    "subject_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "exclusions"],
      "properties": {
        "statement": {"type": "string", "pattern": "\\S"},
        "exclusions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "\\S"}
        }
      }
    },
    "source_policy_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "\\S"}
    },
    "bounded_context_refs": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "\\S"}
    },
    "owner_ref": {"type": "string", "pattern": "\\S"},
    "owner_route": {"type": "string", "pattern": "\\S"},
    "lifecycle_state": {
      "type": "string",
      "enum": ["draft", "active", "superseded", "retired"]
    },
    "predecessor_ref": {
      "anyOf": [
        {"type": "string", "pattern": "\\S"},
        {"type": "null"}
      ]
    },
    "revision_history": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revision", "decision_ref", "changed_fields"],
        "properties": {
          "revision": {"type": "string", "pattern": "\\S"},
          "decision_ref": {"type": "string", "pattern": "\\S"},
          "changed_fields": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "\\S"}
          }
        }
      }
    },
    "challenge_route": {"type": "string", "pattern": "\\S"},
    "evidence_refs": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "\\S"}
    },
    "residue_refs": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "\\S"}
    },
    "source_direction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical", "human_projection", "projection_policy", "generator_ref", "generator_sha256"],
      "properties": {
        "canonical": {"const": "coordination-context.json"},
        "human_projection": {"const": "COORDINATION-CONTEXT.md"},
        "projection_policy": {"const": "generated-only"},
        "generator_ref": {"const": "cal.generator.coordination-context-v2/v1"},
        "generator_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "claim_ceiling": {"type": "string", "pattern": "\\S"}
  },
  "required": [
    "schema_version",
    "coordination_context_id",
    "version",
    "status",
    "authority_effect",
    "classification",
    "product_ref",
    "project_ref",
    "goal_ref",
    "purpose",
    "consumer_refs",
    "intended_uses",
    "subject_scope",
    "source_policy_refs",
    "bounded_context_refs",
    "owner_ref",
    "owner_route",
    "lifecycle_state",
    "predecessor_ref",
    "revision_history",
    "challenge_route",
    "evidence_refs",
    "residue_refs",
    "source_direction",
    "claim_ceiling"
  ]
}
