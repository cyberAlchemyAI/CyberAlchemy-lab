{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle_state": {
            "const": "active"
          }
        },
        "required": [
          "lifecycle_state"
        ]
      },
      "then": {
        "properties": {
          "membership_refs": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "properties": {
    "authority_claim_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "type": "array",
      "uniqueItems": true
    },
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "claim_ceiling": {
      "pattern": "\\S",
      "type": "string"
    },
    "identity_boundary": {
      "pattern": "\\S",
      "type": "string"
    },
    "kind": {
      "const": "team"
    },
    "lifecycle_state": {
      "enum": [
        "proposed",
        "active",
        "suspended",
        "retired",
        "superseded"
      ],
      "type": "string"
    },
    "membership_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "type": "array",
      "uniqueItems": true
    },
    "name": {
      "pattern": "\\S",
      "type": "string"
    },
    "node_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "purpose": {
      "pattern": "\\S",
      "type": "string"
    },
    "responsibility_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "type": "array",
      "uniqueItems": true
    },
    "revision_history": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "type": "array",
      "uniqueItems": true
    },
    "role_assignment_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "type": "array",
      "uniqueItems": true
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "successor_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "authority_effect",
    "kind",
    "node_id",
    "owner_ref",
    "scope_ref",
    "status",
    "name",
    "purpose",
    "identity_boundary",
    "owner_route",
    "lifecycle_state",
    "membership_refs",
    "responsibility_refs",
    "role_assignment_refs",
    "authority_claim_refs",
    "revision_history",
    "successor_refs",
    "challenge_route",
    "claim_ceiling"
  ],
  "type": "object"
}
