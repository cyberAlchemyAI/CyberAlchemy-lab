{
  "$id": "https://cyberalchemy.local/schemas/workflow-decision-profile/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "minLength": 1,
      "type": "string"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "kind": {
      "const": "workflow-decision-profile"
    },
    "lifecycle_state": {
      "enum": [
        "candidate",
        "active",
        "historical",
        "retired"
      ]
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "node_id": {
      "minLength": 1,
      "type": "string"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "allowed_checkpoint_kinds": {
          "items": {
            "enum": [
              "before-application",
              "final-review"
            ]
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "decision_mode": {
          "enum": [
            "none",
            "single"
          ]
        },
        "default_checkpoint_kind": {
          "enum": [
            "before-application",
            "final-review",
            null
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "exact_target_required": {
          "const": true
        },
        "invalidation_conditions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "none_mode_authority_basis_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "post_decision_continuation_limit": {
          "minimum": 0,
          "type": "integer"
        },
        "workflow_type_ref": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "workflow_type_ref",
        "decision_mode",
        "allowed_checkpoint_kinds",
        "default_checkpoint_kind",
        "exact_target_required",
        "none_mode_authority_basis_refs",
        "invalidation_conditions",
        "post_decision_continuation_limit"
      ],
      "type": "object"
    },
    "relation_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "counterpart_kind": {
            "enum": [
              "policy"
            ]
          },
          "counterpart_ref": {
            "minLength": 1,
            "type": "string"
          },
          "direction": {
            "enum": [
              "source"
            ]
          },
          "relation_kind_ref": {
            "enum": [
              "relation.governed-by"
            ]
          }
        },
        "required": [
          "relation_kind_ref",
          "direction",
          "counterpart_kind",
          "counterpart_ref"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "cyberalchemy-lab-workflow-decision-profile/v1"
    },
    "scope_ref": {
      "minLength": 1,
      "type": "string"
    },
    "successor_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "node_id",
    "kind",
    "name",
    "lifecycle_state",
    "authority_effect",
    "owner_ref",
    "scope_ref",
    "evidence_refs",
    "challenge_route",
    "successor_refs",
    "relation_refs",
    "payload",
    "claim_ceiling"
  ],
  "type": "object"
}
