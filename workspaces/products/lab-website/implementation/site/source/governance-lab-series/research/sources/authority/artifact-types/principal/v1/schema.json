{
  "$id": "https://cyberalchemy.local/schemas/principal/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "minLength": 1,
      "type": "string"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "kind": {
      "const": "principal"
    },
    "lifecycle_state": {
      "enum": [
        "candidate",
        "active",
        "historical",
        "retired"
      ]
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "node_id": {
      "minLength": 1,
      "type": "string"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "principal_kind": {
          "minLength": 1,
          "type": "string"
        },
        "recognition_boundary_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "registry_ref": {
          "minLength": 1,
          "type": "string"
        },
        "stable_subject_ref": {
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "principal_kind",
        "stable_subject_ref",
        "recognition_boundary_refs",
        "registry_ref",
        "status"
      ],
      "type": "object"
    },
    "relation_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "counterpart_kind": {
            "enum": [
              "agent-instance",
              "challenge-event",
              "principal",
              "principal-reference"
            ]
          },
          "counterpart_ref": {
            "minLength": 1,
            "type": "string"
          },
          "direction": {
            "enum": [
              "source",
              "target"
            ]
          },
          "relation_kind_ref": {
            "enum": [
              "relation.acts-for",
              "relation.asserts-identity-of",
              "relation.challenges",
              "relation.successor-of"
            ]
          }
        },
        "required": [
          "relation_kind_ref",
          "direction",
          "counterpart_kind",
          "counterpart_ref"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "cyberalchemy-lab-principal/v1"
    },
    "scope_ref": {
      "minLength": 1,
      "type": "string"
    },
    "successor_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "node_id",
    "kind",
    "name",
    "lifecycle_state",
    "authority_effect",
    "owner_ref",
    "scope_ref",
    "evidence_refs",
    "challenge_route",
    "successor_refs",
    "relation_refs",
    "payload",
    "claim_ceiling"
  ],
  "type": "object"
}
