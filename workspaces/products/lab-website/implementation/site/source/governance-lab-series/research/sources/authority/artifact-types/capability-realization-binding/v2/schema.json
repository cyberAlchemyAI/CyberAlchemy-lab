{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "binding_state": {
            "const": "adopted"
          }
        },
        "required": [
          "binding_state"
        ]
      },
      "then": {
        "properties": {
          "adoption_decision_ref": {
            "pattern": "\\S",
            "type": "string"
          },
          "conformance_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "binding_state": {
            "const": "superseded"
          }
        },
        "required": [
          "binding_state"
        ]
      },
      "then": {
        "properties": {
          "successor_refs": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "properties": {
    "adoption_decision_ref": {
      "anyOf": [
        {
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "authority_effect": {
      "const": "none"
    },
    "binding_state": {
      "enum": [
        "candidate",
        "adopted",
        "retired",
        "superseded"
      ],
      "type": "string"
    },
    "binding_version": {
      "pattern": "\\S",
      "type": "string"
    },
    "capability_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "capability_version_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "challenge_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "conformance_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "type": "array",
      "uniqueItems": true
    },
    "contract": {
      "additionalProperties": false,
      "properties": {
        "context_policy_refs": {
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 100,
          "type": "array",
          "uniqueItems": true
        },
        "input_contract_refs": {
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 100,
          "type": "array",
          "uniqueItems": true
        },
        "output_contract_refs": {
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "input_contract_refs",
        "output_contract_refs",
        "context_policy_refs"
      ],
      "type": "object"
    },
    "kind": {
      "const": "capability-realization-binding"
    },
    "limitations": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "node_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "observation_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "type": "array",
      "uniqueItems": true
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "realization_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "contract_ref": {
            "pattern": "\\S",
            "type": "string"
          },
          "owner_ref": {
            "pattern": "\\S",
            "type": "string"
          },
          "realization_kind": {
            "enum": [
              "capability-instance",
              "agent-capability",
              "implementation",
              "service",
              "workflow"
            ],
            "type": "string"
          },
          "realization_ref": {
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "realization_ref",
          "realization_kind",
          "owner_ref",
          "contract_ref"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "successor_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "authority_effect",
    "capability_ref",
    "contract",
    "kind",
    "limitations",
    "node_id",
    "owner_ref",
    "realization_refs",
    "scope_ref",
    "status",
    "binding_version",
    "capability_version_ref",
    "binding_state",
    "adoption_decision_ref",
    "conformance_refs",
    "observation_refs",
    "successor_refs",
    "owner_route",
    "challenge_route"
  ],
  "type": "object"
}
