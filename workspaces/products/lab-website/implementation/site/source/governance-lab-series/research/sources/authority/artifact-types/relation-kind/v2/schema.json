{
  "$id": "https://cyberalchemy.local/schemas/relation-kind/v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "minLength": 1,
      "type": "string"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "kind": {
      "const": "relation-kind"
    },
    "lifecycle_state": {
      "enum": [
        "candidate",
        "active",
        "historical",
        "retired"
      ]
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "node_id": {
      "minLength": 1,
      "type": "string"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "absorbed_relation_kinds": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "allowed_endpoint_pairs": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "source_kind": {
                "minLength": 1,
                "not": {
                  "const": "*"
                },
                "type": "string"
              },
              "target_kind": {
                "minLength": 1,
                "not": {
                  "const": "*"
                },
                "type": "string"
              }
            },
            "required": [
              "source_kind",
              "target_kind"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "axis_id": {
          "pattern": "^axis\\.[a-z0-9-]+$",
          "type": "string"
        },
        "forbidden_inferences": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "group": {
          "minLength": 1,
          "type": "string"
        },
        "inverse_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "operational_effect": {
          "minLength": 1,
          "type": "string"
        },
        "predicate": {
          "pattern": "^[a-z0-9-]+$",
          "type": "string"
        },
        "qualifier_contract": {
          "additionalProperties": false,
          "properties": {
            "closed": {
              "const": true
            },
            "properties": {
              "additionalProperties": {
                "type": "object"
              },
              "minProperties": 1,
              "type": "object"
            },
            "required_axes": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "closed",
            "required_axes",
            "properties"
          ],
          "type": "object"
        },
        "relation_kind_id": {
          "pattern": "^relation\\.[a-z0-9-]+$",
          "type": "string"
        },
        "source_kinds": {
          "items": {
            "minLength": 1,
            "not": {
              "const": "*"
            },
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "target_kinds": {
          "items": {
            "minLength": 1,
            "not": {
              "const": "*"
            },
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "unique_question": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "relation_kind_id",
        "axis_id",
        "predicate",
        "group",
        "unique_question",
        "operational_effect",
        "source_kinds",
        "target_kinds",
        "allowed_endpoint_pairs",
        "qualifier_contract",
        "forbidden_inferences",
        "absorbed_relation_kinds",
        "inverse_ref"
      ],
      "type": "object"
    },
    "relation_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "counterpart_kind": {
            "minLength": 1,
            "type": "string"
          },
          "counterpart_ref": {
            "minLength": 1,
            "type": "string"
          },
          "direction": {
            "enum": [
              "source",
              "target"
            ]
          },
          "relation_kind_ref": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "relation_kind_ref",
          "direction",
          "counterpart_kind",
          "counterpart_ref"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "cyberalchemy-lab-relation-kind/v2"
    },
    "scope_ref": {
      "minLength": 1,
      "type": "string"
    },
    "successor_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "node_id",
    "kind",
    "name",
    "lifecycle_state",
    "authority_effect",
    "owner_ref",
    "scope_ref",
    "evidence_refs",
    "challenge_route",
    "successor_refs",
    "relation_refs",
    "payload",
    "claim_ceiling"
  ],
  "type": "object"
}
