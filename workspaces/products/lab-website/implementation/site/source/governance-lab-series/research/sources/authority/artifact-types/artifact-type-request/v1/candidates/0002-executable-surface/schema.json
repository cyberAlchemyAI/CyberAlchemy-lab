{
  "$id": "https://cyberalchemy.local/schemas/artifact-type-request/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "compatibility_analysis": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "existing_type_ref": {
            "minLength": 1,
            "type": "string"
          },
          "rejection_reason": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "existing_type_ref",
          "rejection_reason"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "consumed_as_subject": {
      "const": false
    },
    "expiry": {
      "additionalProperties": false,
      "properties": {
        "condition": {
          "minLength": 1,
          "type": "string"
        },
        "superseded_by": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "condition",
        "superseded_by"
      ],
      "type": "object"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "proposed_discriminator": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "const": "/schema_version"
        },
        "value": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "path",
        "value"
      ],
      "type": "object"
    },
    "proposed_package_home_ref": {
      "minLength": 1,
      "type": "string"
    },
    "proposed_semantic_kind": {
      "minLength": 1,
      "type": "string"
    },
    "representation_proposal": {
      "additionalProperties": false,
      "properties": {
        "canonical_filename": {
          "minLength": 1,
          "type": "string"
        },
        "human_filename": {
          "minLength": 1,
          "type": "string"
        },
        "projection_policy": {
          "const": "generated-only"
        }
      },
      "required": [
        "canonical_filename",
        "human_filename",
        "projection_policy"
      ],
      "type": "object"
    },
    "request_id": {
      "minLength": 1,
      "type": "string"
    },
    "resolution_evidence": {
      "additionalProperties": false,
      "properties": {
        "matches": {
          "maxItems": 0,
          "type": "array"
        },
        "registry_ref": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "registry_ref",
        "matches"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "cyberalchemy-lab-artifact-type-request/v1"
    },
    "semantic_definition_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "source_direction": {
      "additionalProperties": false,
      "properties": {
        "canonical": {
          "const": "request.json"
        },
        "generator_ref": {
          "minLength": 1,
          "type": "string"
        },
        "human_projection": {
          "const": "REQUEST.md"
        },
        "projection_policy": {
          "const": "generated-only"
        }
      },
      "required": [
        "canonical",
        "human_projection",
        "projection_policy",
        "generator_ref"
      ],
      "type": "object"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "validation_purpose": {
      "minLength": 1,
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "version",
    "status",
    "authority_effect",
    "owner_ref",
    "proposed_semantic_kind",
    "proposed_package_home_ref",
    "resolution_evidence",
    "compatibility_analysis",
    "semantic_definition_refs",
    "representation_proposal",
    "validation_purpose",
    "consumed_as_subject",
    "expiry",
    "source_direction",
    "claim_ceiling",
    "proposed_discriminator"
  ],
  "type": "object"
}
