{
  "$id": "https://cyberalchemy.local/schemas/project-semantic-event-history/v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "minLength": 1,
      "type": "string"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "kind": {
      "const": "project-semantic-event-history"
    },
    "lifecycle_state": {
      "enum": [
        "candidate",
        "active",
        "historical",
        "retired"
      ]
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "node_id": {
      "minLength": 1,
      "type": "string"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "append_only": {
          "const": true
        },
        "chain_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "event_records_are_replay_source": {
          "const": true
        },
        "events": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "change_kind": {
                "minLength": 1,
                "type": "string"
              },
              "cursor": {
                "minimum": 1,
                "type": "integer"
              },
              "event_digest": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "event_id": {
                "minLength": 1,
                "type": "string"
              },
              "material_refs": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "sha256": {
                      "pattern": "^[a-f0-9]{64}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "sha256"
                  ],
                  "type": "object"
                },
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "predecessor_state_digest": {
                "pattern": "^sha256:[a-f0-9]{64}$",
                "type": "string"
              },
              "predecessor_state_ref": {
                "minLength": 1,
                "type": "string"
              },
              "previous_event_digest": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "pattern": "^[a-f0-9]{64}$",
                    "type": "string"
                  }
                ]
              },
              "record_ref": {
                "minLength": 1,
                "type": "string"
              },
              "resulting_state_digest": {
                "pattern": "^sha256:[a-f0-9]{64}$",
                "type": "string"
              },
              "resulting_state_ref": {
                "minLength": 1,
                "type": "string"
              },
              "semantic_summary": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "event_id",
              "event_digest",
              "cursor",
              "previous_event_digest",
              "change_kind",
              "predecessor_state_ref",
              "predecessor_state_digest",
              "resulting_state_ref",
              "resulting_state_digest",
              "material_refs",
              "record_ref",
              "semantic_summary"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "history_id": {
          "minLength": 1,
          "type": "string"
        },
        "history_manifest_is_event_index": {
          "const": true
        },
        "latest_cursor": {
          "minimum": 1,
          "type": "integer"
        },
        "project_ref": {
          "minLength": 1,
          "type": "string"
        },
        "stream_id": {
          "minLength": 1,
          "type": "string"
        },
        "subject_ref": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "history_id",
        "project_ref",
        "subject_ref",
        "stream_id",
        "events",
        "latest_cursor",
        "chain_digest",
        "append_only",
        "event_records_are_replay_source",
        "history_manifest_is_event_index"
      ],
      "type": "object"
    },
    "relation_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "counterpart_kind": {
            "enum": [
              "admission-transaction"
            ]
          },
          "counterpart_ref": {
            "minLength": 1,
            "type": "string"
          },
          "direction": {
            "enum": [
              "target"
            ]
          },
          "relation_kind_ref": {
            "enum": [
              "relation.materializes-consequence"
            ]
          }
        },
        "required": [
          "relation_kind_ref",
          "direction",
          "counterpart_kind",
          "counterpart_ref"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "cyberalchemy-lab-project-semantic-event-history/v2"
    },
    "scope_ref": {
      "minLength": 1,
      "type": "string"
    },
    "successor_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "node_id",
    "kind",
    "name",
    "lifecycle_state",
    "authority_effect",
    "owner_ref",
    "scope_ref",
    "evidence_refs",
    "challenge_route",
    "successor_refs",
    "relation_refs",
    "payload",
    "claim_ceiling"
  ],
  "type": "object"
}
