  "requirements": [
    {
      "id": "COMP-01",
      "title": "Exact mixed representation and bootstrap registry compatibility",
      "prepared": "Scoped mixed-view proposal and exact per-subject carriers are accepted for preparation.",
      "remaining": "Independent representation/source-direction effect scopes and a compatible prerequisite-specific registry/index/drift package must be established. V1 check 06 cannot be marked PASS solely because the full mixed draft exists.",
      "owners": [
        "role:artifact-mechanics-owner",
        "role:definition-owner",
        "role:evidence-conformance-owner",
        "role:artifact-type-owner"
      ],
      "source": [
