{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Local exact candidate projection schema only; no admitted policy amendment or owner effect. Cross-field identity and integrity checked by check_package.py.",
  "$defs": {
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_effect",
        "candidate_source",
        "claim_ceiling",
        "entries",
        "owner_ref",
        "predecessor",
        "proposed_current_lookup",
        "record_id",
        "schema_version",
        "source_direction",
        "status"
      ],
      "properties": {
        "authority_effect": {
          "const": "none"
        },
        "candidate_source": {
          "type": "string"
        },
        "claim_ceiling": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "minItems": 194,
          "maxItems": 194,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "definition_id",
                  "version",
                  "term",
                  "path",
                  "admission_decision_ref",
                  "sha256",
                  "lifecycle_state"
                ],
                "properties": {
                  "definition_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "term": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "admission_decision_ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "lifecycle_state": {
                    "const": "admitted"
                  },
                  "predecessor_ref": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "definition_id",
                  "version",
                  "term",
                  "path",
                  "sha256",
                  "lifecycle_state"
                ],
                "properties": {
                  "definition_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "term": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "lifecycle_state": {
                    "const": "candidate-unadmitted"
                  }
                }
              }
            ]
          }
        },
        "owner_ref": {
          "type": "string"
        },
        "predecessor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "proposed_current_lookup": {
          "type": "object",
          "minProperties": 187,
          "maxProperties": 187,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "record_id": {
          "type": "string"
        },
        "schema_version": {
          "const": "cyberalchemy-lab-definition-registry-postimage/v1"
        },
        "source_direction": {
          "type": "object"
        },
        "status": {
          "const": "candidate-postimage"
        }
      }
    },
    "drift": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_effect",
        "baseline_audit",
        "claim_ceiling",
        "findings",
        "inherited_findings",
        "owner_ref",
        "registry_ref",
        "registry_sha256",
        "schema_version",
        "source_direction",
        "status",
        "summary",
        "title"
      ],
      "properties": {
        "authority_effect": {
          "const": "none"
        },
        "baseline_audit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "claim_ceiling": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "minItems": 21,
          "maxItems": 21
        },
        "inherited_findings": {
          "type": "array"
        },
        "owner_ref": {
          "type": "string"
        },
        "registry_ref": {
          "type": "string"
        },
        "registry_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "schema_version": {
          "const": "cal.define-definition-drift-postimage/v1"
        },
        "source_direction": {
          "type": "object"
        },
        "status": {
          "const": "candidate-evidence"
        },
        "summary": {
          "type": "object",
          "required": [
            "admission_ready"
          ],
          "properties": {
            "admission_ready": {
              "const": false
            }
          }
        },
        "title": {
          "type": "string"
        }
      }
    },
    "types": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_effect",
        "claim_ceiling",
        "inherited_admitted_contracts",
        "inherited_current_by_identity",
        "predecessor",
        "proposed_descriptor_revisions",
        "proposed_new_registrations",
        "proposed_selection_policy",
        "schema_version",
        "status"
      ],
      "properties": {
        "authority_effect": {
          "const": "none"
        },
        "claim_ceiling": {
          "type": "string"
        },
        "inherited_admitted_contracts": {
          "type": "array",
          "minItems": 143,
          "maxItems": 143
        },
        "inherited_current_by_identity": {
          "type": "object"
        },
        "predecessor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "proposed_descriptor_revisions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3
        },
        "proposed_new_registrations": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2
        },
        "proposed_selection_policy": {
          "type": "string"
        },
        "schema_version": {
          "const": "cal.define-artifact-type-registry-postimage/v1"
        },
        "status": {
          "const": "candidate-postimage"
        }
      }
    }
  }
}
