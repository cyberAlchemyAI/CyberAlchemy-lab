
mapping PreparationCliPart0:
  input gap_count UInt64
  target List<Step,100>
  total true
  expression [Step(target=[],value=JsonValue.Object(marker=true)),Step(target=[PathPart.Field(name="api_version")],value=JsonValue.Text(value="define.api/v1")),Step(target=[PathPart.Field(name="id")],value=JsonValue.Text(value="cli")),Step(target=[PathPart.Field(name="operation")],value=JsonValue.Text(value="prepare")),Step(target=[PathPart.Field(name="outcome")],value=JsonValue.Text(value=match (gap_count > 0) true => "prepared-with-gaps" else "prepared")),Step(target=[PathPart.Field(name="diagnostics")],value=JsonValue.Array(marker=true)),Step(target=[PathPart.Field(name="data")],value=JsonValue.Object(marker=true)),Step(target=[PathPart.Field(name="data"),PathPart.Field(name="pack")],value=JsonValue.Copy(document="prepared",selector="/body"))]

mapping PreparationCliPart1:
  input gap_count UInt64
  target List<Step,100>
  total true
  expression [Step(target=[PathPart.Field(name="data"),PathPart.Field(name="report")],value=JsonValue.Copy(document="prepared",selector="/report")),Step(target=[PathPart.Field(name="data"),PathPart.Field(name="root_sha256")],value=JsonValue.Copy(document="prepared",selector="/root_sha256")),Step(target=[PathPart.Field(name="data"),PathPart.Field(name="pack_sha256")],value=JsonValue.Copy(document="prepared",selector="/pack_sha256")),Step(target=[PathPart.Field(name="authority_effect")],value=JsonValue.Text(value="none")),Step(target=[PathPart.Field(name="observed_writes")],value=JsonValue.Array(marker=true)),Step(target=[PathPart.Field(name="observed_writes"),PathPart.Index(value=0)],value=JsonValue.Copy(document="publication",selector="/destination"))]
