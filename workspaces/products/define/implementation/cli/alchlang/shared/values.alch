module Define.Shared version 1

value-object Ref:
  carrier String
  utf8-bytes 1..256
  unicode-scalars 1..256

value-object Text:
  carrier String
  utf8-bytes 1..262144
  unicode-scalars 1..262144

value-object JsonText:
  carrier String
  utf8-bytes 1..1048576
  unicode-scalars 1..1048576

value-object Selector:
  carrier String
  utf8-bytes 0..1024
  unicode-scalars 0..1024

value-object Digest:
  carrier String
  utf8-bytes 64..64
  unicode-scalars 64..64
  pattern "^[a-f0-9]{64}$"

value-object FilePath:
  carrier String
  utf8-bytes 1..512
  unicode-scalars 1..512

value-object Binding:
  path FilePath
  sha256 Digest
  bytes UInt64
  digest_kind literal "original-file-sha256"
  invariant bytes <= 16777216

enum AuthorityEffect:
  value None wire "none"

enum Standing:
  value Candidate wire "candidate"

value-object Gap:
  gap_id Ref
  reason Text
  affected_use Ref
  continuation Text
