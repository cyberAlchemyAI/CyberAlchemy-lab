{
  "schema_version": "craft.generic-event-profile/v1-candidate",
  "id": "define-module-use-case-event-profile",
  "target": "node-esm",
  "capabilities": [
    "Rule",
    "record-bool",
    "Operation",
    "Mapping",
    "record-uint64",
    "Calculation",
    "Policy",
    "bounded-values",
    "bounded-collections",
    "StateMachine",
    "Entity",
    "Query",
    "Entry",
    "keyed-sqlite-read",
    "auth-foundation-ready",
    "stateful-operation",
    "atomic-sqlite-transaction",
    "hidden-revision",
    "command-replay",
    "Event",
    "event-handoff",
    "operation-policy-enforcement"
  ],
  "limits": {
    "max_input_bytes": 65536,
    "max_output_bytes": 65536,
    "max_value_bytes": 32768,
    "max_items": 100,
    "max_iterations": 100,
    "max_ast_nodes": 65536,
    "max_ast_depth": 128,
    "max_call_depth": 64,
    "fuel": 20000000
  },
  "services": [
    {
      "id": "DefineService",
      "module": "Define"
    },
    {
      "id": "LabIntegrationService",
      "module": "LabIntegration"
    }
  ],
  "entry_context": "customer-ready-scalars/v1-candidate",
  "auth_abi": "craft.commerce-auth-ready-bridge/v1-candidate",
  "auth_route_template": "commerce:{logical_entry_id}",
  "storage": "sqlite-fenced-event-handoff/v1-candidate",
  "application_namespace": "Define.ModuleUseCaseCandidate",
  "transaction_bounds": {
    "schema_version": "craft.generic-transaction-bounds/v1-candidate",
    "max_participants": 16,
    "max_read_observations": 128,
    "max_mutations": 128,
    "max_control_depth": 64,
    "max_command_key_bytes": 128,
    "max_command_key_scalars": 128,
    "max_command_tuple_bytes": 4096,
    "max_command_records": 1024,
    "max_command_journal_bytes": 16777216,
    "max_permission_trace_items": 128,
    "max_permission_trace_bytes": 32768
  },
  "string_policy": {
    "max_utf8_bytes": 256,
    "max_scalars": 256
  },
  "event_handoff": {
    "transport": "process-local-checked-envelope/v1-candidate",
    "delivery": "durable-at-least-once/v1-candidate"
  }
}
