mapping ApplicationCheckRecord:
  input fully_bound Bool
  input standing Text
  target List<Step,100>
  total true
  expression [Step(target=[],value=JsonValue.Object(marker=true)),Step(target=[PathPart.Field(name="application_id")],value=JsonValue.Copy(document="application",selector="/application_id")),Step(target=[PathPart.Field(name="fully_bound")],value=JsonValue.Bool(value=fully_bound)),Step(target=[PathPart.Field(name="meaning_standing")],value=JsonValue.Text(value=JsonString(standing))),Step(target=[PathPart.Field(name="domain_assessment_executed")],value=JsonValue.Bool(value=false))]


mapping ReadinessRecord:
  input status ReadinessView
  target List<Step,100>
  total true
  expression [Step(target=[],value=JsonValue.Object(marker=true)),Step(target=[PathPart.Field(name="outcome")],value=JsonValue.Text(value=match (status == ReadinessView.Ready) true => "ready" else match (status == ReadinessView.Blocked) true => "blocked" else "not-evaluable")),Step(target=[PathPart.Field(name="obligations")],value=JsonValue.Copy(document="obligations",selector="")),Step(target=[PathPart.Field(name="claim_ceiling")],value=JsonValue.Text(value="Candidate preparation and exact binding checks only; no semantic acceptance, domain execution, permission or admission."))]


mapping PreparationReport:
  input marker Bool
  target List<Step,100>
  total true
  expression [Step(target=[],value=JsonValue.Object(marker=true)),Step(target=[PathPart.Field(name="schema_version")],value=JsonValue.Text(value="cal.define.preparation-report/v3")),Step(target=[PathPart.Field(name="authority_effect")],value=JsonValue.Text(value="none")),Step(target=[PathPart.Field(name="structural_validity")],value=JsonValue.Text(value="valid")),Step(target=[PathPart.Field(name="capture_mode")],value=JsonValue.Copy(document="capture",selector="/mode")),Step(target=[PathPart.Field(name="application_checks")],value=JsonValue.Copy(document="checks",selector="")),Step(target=[PathPart.Field(name="readiness")],value=JsonValue.Copy(document="readiness",selector="")),Step(target=[PathPart.Field(name="assessment_execution_count")],value=JsonValue.UInt(value=0)),Step(target=[PathPart.Field(name="actual_owner_outcome")],value=JsonValue.Null(marker=true)),Step(target=[PathPart.Field(name="claim_ceiling")],value=JsonValue.Text(value="Candidate preparation and exact binding checks only; no semantic acceptance, domain execution, permission or admission."))]

