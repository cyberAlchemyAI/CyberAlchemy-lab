value-object ImportGroup:
  source Text
  selector Selector
  tag Text
  collection Bool

value-object ImportSelection:
  current_present Bool
  prefix_present Bool
  successor Bool

operation VerifyImportSelection:
  input value ImportSelection
  output Bool
  on value.current_present and not value.prefix_present and not value.successor reject existing-session-use-explicit-successor
  on value.successor and not value.current_present reject session-missing
  return true

calculation InitialImportTag:
  pure
  input successor Bool
  result Text
  expression match successor true => Text("ReviseRequest") else Text("Initialize")

mapping ImportGroups:
  input successor Bool
  target List<ImportGroup,100>
  total true
  expression [ImportGroup(source="start",selector="",tag=InitialImportTag(successor),collection=false),ImportGroup(source="context",selector="",tag="SetContext",collection=false),ImportGroup(source="request",selector="/required_concepts",tag="RequireConcept",collection=true),ImportGroup(source="request",selector="/source_bindings",tag="BindSource",collection=true),ImportGroup(source="request",selector="/evidence_bindings",tag="BindEvidence",collection=true),ImportGroup(source="request",selector="/handling",tag="HandleMeaning",collection=true),ImportGroup(source="request",selector="/applications",tag="PutApplication",collection=true),ImportGroup(source="request",selector="/assessments",tag="PutAssessment",collection=true),ImportGroup(source="request",selector="/materialization_selection",tag="SelectMaterialization",collection=true)]

mapping ImportStartPlan:
  input marker Bool
