  expression CodecRule(schema="{\"type\":\"object\",\"required\":[\"revision\"],\"properties\":{\"revision\":{\"type\":\"string\"}},\"not\":{\"required\":[\"kind\"],\"properties\":{\"kind\":{\"const\":\"external\"}}}}",actions=[CodecAction.Integer(field="revision")])

