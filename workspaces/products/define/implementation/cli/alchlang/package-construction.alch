  expression CodecRule(schema="{\"type\":\"object\",\"required\":[\"tag\",\"fields\"],\"properties\":{\"tag\":{\"const\":\"Reuse\"}}}",actions=[CodecAction.Project(steps=[Step(target=[],value=JsonValue.Object(marker=true)),Step(target=[PathPart.Field(name="concept_id")],value=JsonValue.Copy(document="input",selector="/fields/value/concept_id")),Step(target=[PathPart.Field(name="disposition")],value=JsonValue.Text(value="reuse")),Step(target=[PathPart.Field(name="payload")],value=JsonValue.Copy(document="input",selector="/fields/value"))]),CodecAction.Remove(selector="/payload/concept_id")])

