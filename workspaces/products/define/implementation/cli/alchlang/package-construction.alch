value-object HeaderInput:
  pack_ordinal UInt64
  pack_sha256 Digest
  pack_bytes UInt64
  invariant pack_ordinal < 256
  invariant pack_bytes <= 16777216

value-object MemberInput:
  ordinal UInt64
  path Text
  extension Selector
  sha256 Digest
  bytes UInt64
  invariant ordinal < 256
  invariant bytes <= 16777216

calculation MemberId:
  pure
  input ordinal UInt64
  result List<Piece,8>
  expression [Piece.Text(value="m"),Piece.UInt(value=ordinal,width=4)]

calculation MemberPath:
  pure
  input ordinal UInt64
  result PathPart
  expression PathPart.FieldParts(parts=MemberId(ordinal))

calculation MemberRole:
  pure
  input path Text
  result Text
  expression match (path == "pack.json") true => Text("pack") else match (path == "capture.json") true => Text("capture") else match (path == "report.json") true => Text("report") else Text("selected-input")

calculation MemberMedia:
  pure
  input extension Selector
  result Text
  expression match (extension == "json") true => Text("application/json") else Text("application/octet-stream")

mapping ManifestHeader:
  input value HeaderInput
  target List<Step,100>
  total true
  expression [Step(target=[],value=JsonValue.Object(marker=true)),Step(target=[PathPart.Field(name="schema_version")],value=JsonValue.Text(value="cal.define.package-manifest/v1")),Step(target=[PathPart.Field(name="package_id")],value=JsonValue.Copy(document="pack",selector="/pack_id")),Step(target=[PathPart.Field(name="revision")],value=JsonValue.Copy(document="pack",selector="/revision")),Step(target=[PathPart.Field(name="pack_binding")],value=JsonValue.Object(marker=true)),Step(target=[PathPart.Field(name="pack_binding"),PathPart.Field(name="member_id")],value=JsonValue.Concat(parts=MemberId(value.pack_ordinal))),Step(target=[PathPart.Field(name="pack_binding"),PathPart.Field(name="sha256")],value=JsonValue.Text(value=JsonString(Text(value.pack_sha256)))),Step(target=[PathPart.Field(name="pack_binding"),PathPart.Field(name="bytes")],value=JsonValue.UInt(value=value.pack_bytes)),Step(target=[PathPart.Field(name="pack_binding"),PathPart.Field(name="media_type")],value=JsonValue.Text(value="application/json")),Step(target=[PathPart.Field(name="members")],value=JsonValue.Object(marker=true)),Step(target=[PathPart.Field(name="required_roots")],value=JsonValue.Array(marker=true)),Step(target=[PathPart.Field(name="closure_purpose")],value=JsonValue.Text(value="frozen-pack-inspection")),Step(target=[PathPart.Field(name="limitations")],value=JsonValue.Array(marker=true)),Step(target=[PathPart.Field(name="limitations"),PathPart.Index(value=0)],value=JsonValue.Copy(document="pack",selector="/claim_ceiling")),Step(target=[PathPart.Field(name="limitations"),PathPart.Index(value=1)],value=JsonValue.Text(value="Historical source standing is preserved; current permission and readiness require separate observations.")),Step(target=[PathPart.Field(name="authority_effect")],value=JsonValue.Text(value="none"))]

mapping ManifestMember:
  input value MemberInput
  target List<Step,100>
  total true
  expression [Step(target=[PathPart.Field(name="members"),MemberPath(value.ordinal)],value=JsonValue.Object(marker=true)),Step(target=[PathPart.Field(name="members"),MemberPath(value.ordinal),PathPart.Field(name="path")],value=JsonValue.Text(value=JsonString(value.path))),Step(target=[PathPart.Field(name="members"),MemberPath(value.ordinal),PathPart.Field(name="role")],value=JsonValue.Text(value=JsonString(MemberRole(value.path)))),Step(target=[PathPart.Field(name="members"),MemberPath(value.ordinal),PathPart.Field(name="media_type")],value=JsonValue.Text(value=JsonString(MemberMedia(value.extension)))),Step(target=[PathPart.Field(name="members"),MemberPath(value.ordinal),PathPart.Field(name="encoding")],value=JsonValue.Text(value="original-bytes")),Step(target=[PathPart.Field(name="members"),MemberPath(value.ordinal),PathPart.Field(name="sha256")],value=JsonValue.Text(value=JsonString(Text(value.sha256)))),Step(target=[PathPart.Field(name="members"),MemberPath(value.ordinal),PathPart.Field(name="bytes")],value=JsonValue.UInt(value=value.bytes)),Step(target=[PathPart.Field(name="members"),MemberPath(value.ordinal),PathPart.Field(name="required")],value=JsonValue.Bool(value=true)),Step(target=[PathPart.Field(name="members"),MemberPath(value.ordinal),PathPart.Field(name="dependencies")],value=JsonValue.Array(marker=true)),Step(target=[PathPart.Field(name="required_roots"),PathPart.Index(value=value.ordinal)],value=JsonValue.Concat(parts=MemberId(value.ordinal)))]

value-object SchemaText:
  carrier String
  utf8-bytes 1..4096
  unicode-scalars 1..4096

enum CodecAction:
  variant Rename source Text target Text
  variant Integer field Text
  variant IntegerText field Text
  variant Decode field Text
  variant Encode field Text
  variant Unwrap selector Selector
  variant FieldUnwrap field Text selector Selector
  variant Project steps List<Step,100>
  variant Remove selector Selector
  variant DefaultNull field Text
  variant OmitNull field Text

value-object CodecRule:
  schema SchemaText
  actions List<CodecAction,24>

value-object CodecPlan:
  rules List<CodecRule,100>
  opaque_fields List<Text,24>

calculation ExportCodecRule0:
  pure
  result CodecRule
  expression CodecRule(schema="{\"type\":\"object\",\"required\":[\"tag\",\"fields\"],\"properties\":{\"tag\":{\"enum\":[\"External\",\"Embedded\"]}}}",actions=[CodecAction.Unwrap(selector="/fields/value")])

calculation ExportCodecRule1:
  pure
  result CodecRule
  expression CodecRule(schema="{\"type\":\"object\",\"required\":[\"bytes\"],\"properties\":{\"bytes\":{\"type\":\"string\"}}}",actions=[CodecAction.Integer(field="bytes")])

