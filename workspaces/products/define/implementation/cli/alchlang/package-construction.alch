value-object SchemaBinding:
  path Text
  sha256 Digest
  bytes UInt64
  digest_kind literal "original-file-sha256"
  invariant bytes <= 16777216

value-object SchemaSelection:
  binding SchemaBinding
  selector Selector

mapping RequestSchema:
  input marker Bool
  target SchemaSelection
  total true
  expression SchemaSelection(binding=SchemaBinding(path="workspaces/products/define/authority/contracts/portable-pack-v3.json",sha256="98544eb13d96ad2dbbd085fe3931d385007a5414ee176cd64ee56da1c4297817",bytes=69594,digest_kind="original-file-sha256"),selector="/schemas/request")

