
value-object SchemaObservation:
  allowed Bool
  structural Bool

value-object ParameterCollectionObservation:
  present Bool
  kind Text
  size UInt64

value-object AssessmentCodes:
  execution Text
  validation Text
  reported Text
  reason_present Bool
  reason_nonempty Bool

value-object PreparationScopeObservation:
  selected_use Text
  observed_use Text
  selected_adapter Digest
  observed_adapter Digest
  capture_mode Text
  permission_observation_present Bool
  live_observation_present Bool
