
value-object CliProjection:
  reconstruct Bool
  destination Selector

mapping InspectionCliReply:
  input value CliProjection
  target List<Step,100>
  total true
  expression match value.reconstruct true => [Step(target=[],value=JsonValue.Object(marker=true)),Step(target=[PathPart.Field(name="api_version")],value=JsonValue.Text(value="define.api/v1")),Step(target=[PathPart.Field(name="id")],value=JsonValue.Text(value="cli")),Step(target=[PathPart.Field(name="outcome")],value=JsonValue.Text(value="prepared")),Step(target=[PathPart.Field(name="authority_effect")],value=JsonValue.Text(value="none")),Step(target=[PathPart.Field(name="operation")],value=JsonValue.Text(value=match value.reconstruct true => "reconstruct" else "inspect")),Step(target=[PathPart.Field(name="diagnostics")],value=JsonValue.Array(marker=true)),Step(target=[PathPart.Field(name="data")],value=JsonValue.Object(marker=true)),Step(target=[PathPart.Field(name="data"),PathPart.Field(name="root_sha256")],value=JsonValue.Copy(document="inspection",selector="/root_sha256")),Step(target=[PathPart.Field(name="data"),PathPart.Field(name="posture")],value=JsonValue.Text(value="exact-frozen-reconstruction")),Step(target=[PathPart.Field(name="observed_writes")],value=JsonValue.Array(marker=true)),Step(target=[PathPart.Field(name="observed_writes"),PathPart.Index(value=0)],value=JsonValue.Text(value=JsonString(value.destination)))] else [Step(target=[],value=JsonValue.Object(marker=true)),Step(target=[PathPart.Field(name="api_version")],value=JsonValue.Text(value="define.api/v1")),Step(target=[PathPart.Field(name="id")],value=JsonValue.Text(value="cli")),Step(target=[PathPart.Field(name="outcome")],value=JsonValue.Text(value="prepared")),Step(target=[PathPart.Field(name="authority_effect")],value=JsonValue.Text(value="none")),Step(target=[PathPart.Field(name="operation")],value=JsonValue.Text(value=match value.reconstruct true => "reconstruct" else "inspect")),Step(target=[PathPart.Field(name="diagnostics")],value=JsonValue.Array(marker=true)),Step(target=[PathPart.Field(name="data")],value=JsonValue.Object(marker=true)),Step(target=[PathPart.Field(name="data"),PathPart.Field(name="root_sha256")],value=JsonValue.Copy(document="inspection",selector="/root_sha256")),Step(target=[PathPart.Field(name="data"),PathPart.Field(name="pack_sha256")],value=JsonValue.Copy(document="inspection",selector="/pack_sha256")),Step(target=[PathPart.Field(name="data"),PathPart.Field(name="required_members_verified")],value=JsonValue.Copy(document="inspection",selector="/required_members_verified")),Step(target=[PathPart.Field(name="data"),PathPart.Field(name="frozen_integrity")],value=JsonValue.Copy(document="inspection",selector="/frozen_integrity")),Step(target=[PathPart.Field(name="data"),PathPart.Field(name="current_permission")],value=JsonValue.Copy(document="inspection",selector="/current_permission"))]

mapping MaterializationCliReply:
  input destination Selector
  target List<Step,100>
  total true
  expression [Step(target=[],value=JsonValue.Object(marker=true)),Step(target=[PathPart.Field(name="api_version")],value=JsonValue.Text(value="define.api/v1")),Step(target=[PathPart.Field(name="id")],value=JsonValue.Text(value="cli")),Step(target=[PathPart.Field(name="operation")],value=JsonValue.Text(value="materialize")),Step(target=[PathPart.Field(name="outcome")],value=JsonValue.Text(value="prepared")),Step(target=[PathPart.Field(name="diagnostics")],value=JsonValue.Array(marker=true)),Step(target=[PathPart.Field(name="data")],value=JsonValue.Object(marker=true)),Step(target=[PathPart.Field(name="data"),PathPart.Field(name="report")],value=JsonValue.Copy(document="report",selector="")),Step(target=[PathPart.Field(name="observed_writes")],value=JsonValue.Array(marker=true)),Step(target=[PathPart.Field(name="observed_writes"),PathPart.Index(value=0)],value=JsonValue.Text(value=JsonString(destination))),Step(target=[PathPart.Field(name="authority_effect")],value=JsonValue.Text(value="none"))]
