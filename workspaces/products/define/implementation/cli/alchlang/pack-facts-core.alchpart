operation RequireOneParameterContract:
  input count UInt64
  output Bool
  on count != 1 reject parameter-contract-mismatch
  return true

operation RequireOneValueSource:
  input count UInt64
  output Bool
  on count != 1 reject unresolved-value-source
  return true

operation VerifyPreparationScope:
  input value PreparationScopeObservation
  output Bool
  on value.selected_use != value.observed_use reject captured-use-mismatch
  on value.selected_adapter != value.observed_adapter reject adapter-selection-mismatch
  on value.capture_mode != "local-snapshot" reject unsupported-capture-mode
  on value.permission_observation_present or value.live_observation_present reject snapshot-live-claim
  return true

