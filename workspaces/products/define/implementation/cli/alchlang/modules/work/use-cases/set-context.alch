module Define.Work.SetContext version 1
use Define.Work.Command
use Define.CommandOf
use Define.Work.Context
use Define.Invocation
use Define.Work.Payload
use Define.Work.Session
use Define.Work.Shared.Transition.ApplyTransition

calculation SetContextInput:
  pure
  input invocation Invocation
  result Context
  expression require-variant(CommandOf(invocation).payload,Payload.SetContext).value

mapping WithContext:
  input session Session
  input value Context
  target Session
  total true
  expression ApplyTransition(session,Payload.SetContext(value=value),"snapshot-construction")

operation SetContext:
  input current optional<Session>
  input invocation Invocation
  output optional<Session>
  when not (match invocation Command(value) => true else false):
    return current
  when not (match CommandOf(invocation).payload SetContext(value) => true else false):
    return current
  on absent(current) reject session-missing
  on SetContextInput(invocation).project != current.scope.project reject project-mismatch
  on SetContextInput(invocation).work != current.scope.work reject work-mismatch
  return some(WithContext(current,SetContextInput(invocation)))
