module Define.Meanings.RequireConcept version 1
use Define.Work.Command
use Define.CommandOf
use Define.Invocation
use Define.Work.Payload
use Define.Meanings.RequiredConcept
use Define.Work.Session
use Define.Work.Shared.Transition.ApplyTransition

calculation RequireConceptInput:
  pure
  input invocation Invocation
  result RequiredConcept
  expression require-variant(CommandOf(invocation).payload,Payload.RequireConcept).value

mapping WithConcept:
  input session Session
  input value RequiredConcept
  target Session
  total true
  expression ApplyTransition(session,Payload.RequireConcept(value=value),"snapshot-construction")

operation RequireConcept:
  input current optional<Session>
  input invocation Invocation
  output optional<Session>
  when not (match invocation Command(value) => true else false):
    return current
  when not (match CommandOf(invocation).payload RequireConcept(value) => true else false):
    return current
  on absent(current) reject session-missing
  on length(filter(current.required_concepts,item:RequiredConcept => item.concept_id == RequireConceptInput(invocation).concept_id)) > 0 reject duplicate-concept
  on length(current.required_concepts) >= 24 reject concept-capacity
  return some(WithConcept(current,RequireConceptInput(invocation)))
