module Define.Meanings.RecordMeaning version 1
use Define.Work.Command
use Define.CommandOf
use Define.Meanings.Handling
use Define.Meanings.HandlingId
use Define.Invocation
use Define.Work.Payload
use Define.Meanings.RequiredConcept
use Define.Work.Session
use Define.Work.Shared.Transition.ApplyTransition

calculation RecordMeaningInput:
  pure
  input invocation Invocation
  result Handling
  expression require-variant(CommandOf(invocation).payload,Payload.HandleMeaning).value

mapping WithHandling:
  input session Session
  input value Handling
  target Session
  total true
  expression ApplyTransition(session,Payload.HandleMeaning(value=value),"snapshot-construction")

operation RecordMeaning:
  input current optional<Session>
  input invocation Invocation
  output optional<Session>
  when not (match invocation Command(value) => true else false):
    return current
  when not (match CommandOf(invocation).payload HandleMeaning(value) => true else false):
    return current
  on absent(current) reject session-missing
  on length(filter(current.required_concepts,item:RequiredConcept => item.concept_id == HandlingId(RecordMeaningInput(invocation)))) != 1 reject required-concept-missing
  return some(WithHandling(current,RecordMeaningInput(invocation)))
