module Define.Conversation.Shared version 1
use Define.Conversation.QuestionStatus

state-machine QuestionLifecycle:
  state QuestionStatus
  input QuestionStatus
  initial Open
  terminal Answered, Corrected, Deferred, Refused
  transition Open Answered -> Answered
  transition Open Corrected -> Corrected
  transition Open Deferred -> Deferred
  transition Open Refused -> Refused
  otherwise reject invalid-response
