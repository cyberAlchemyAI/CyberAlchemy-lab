
value-object ValueFieldObservation:
  document Text
  selector Selector
  alias Text

mapping MaterializationDigestFields:
  input marker Bool
  target List<ValueFieldObservation,24>
  total true
  expression [ValueFieldObservation(document="selection",selector="/authority_scope",alias="selected_scope"),ValueFieldObservation(document="definition",selector="/scope/authority_scope_ref",alias="actual_scope"),ValueFieldObservation(document="meaning",selector="/statement",alias="selected_statement"),ValueFieldObservation(document="definition",selector="/voices/scientific_formal/normative_statement",alias="actual_statement"),ValueFieldObservation(document="meaning",selector="/boundaries",alias="selected_boundaries"),ValueFieldObservation(document="definition",selector="/boundaries",alias="actual_boundaries"),ValueFieldObservation(document="notation",selector="",alias="selected_notation"),ValueFieldObservation(document="definition",selector="/voices/scientific_formal/notation",alias="actual_notation"),ValueFieldObservation(document="definition",selector="/definition_id",alias="actual_identity"),ValueFieldObservation(document="definition",selector="/version",alias="actual_revision"),ValueFieldObservation(document="meaning",selector="/scope",alias="selected_applicability"),ValueFieldObservation(document="definition",selector="/scope/applicability",alias="actual_applicability")]

mapping MaterializationParentFields:
  input successor Bool
  target List<ValueFieldObservation,24>
  total true
  expression match successor true => [ValueFieldObservation(document="selection",selector="/parent_ref/identity",alias="parent_identity"),ValueFieldObservation(document="selection",selector="/parent_ref/revision",alias="parent_revision")] else []

mapping ExternalReferenceFields:
  input marker Bool
  target List<ValueFieldObservation,24>
  total true
  expression [ValueFieldObservation(document="reference",selector="/identity",alias="selected_identity"),ValueFieldObservation(document="identity",selector="/value",alias="observed_identity"),ValueFieldObservation(document="reference",selector="/revision",alias="selected_revision"),ValueFieldObservation(document="revision",selector="/value",alias="observed_revision")]

mapping EmbeddedReferenceFields:
  input marker Bool
  target List<ValueFieldObservation,24>
  total true
  expression [ValueFieldObservation(document="reference",selector="/pack_id",alias="selected_pack"),ValueFieldObservation(document="body",selector="/pack_id",alias="actual_pack"),ValueFieldObservation(document="reference",selector="/entry_id",alias="selected_identity"),ValueFieldObservation(document="entry_identity",selector="",alias="observed_identity")]

mapping PackageIdentityFields:
  input marker Bool
  target List<ValueFieldObservation,24>
  total true
  expression [ValueFieldObservation(document="manifest",selector="/package_id",alias="selected_id"),ValueFieldObservation(document="body",selector="/pack_id",alias="observed_id")]

mapping ApplicationScopeFields:
  input marker Bool
  target List<ValueFieldObservation,24>
  total true
  expression [ValueFieldObservation(document="request",selector="/consumer",alias="selected_consumer"),ValueFieldObservation(document="application",selector="/consumer",alias="actual_consumer")]

mapping ApplicationContractFields:
  input marker Bool
  target List<ValueFieldObservation,24>
  total true
  expression [ValueFieldObservation(document="application",selector="/parameter_contract_ref",alias="selected_id"),ValueFieldObservation(document="contract",selector="/contract_id",alias="actual_id")]

mapping PreparationScopeFields:
  input marker Bool
  target List<ValueFieldObservation,24>
  total true
  expression [ValueFieldObservation(document="request",selector="/adapter_selection_binding",alias="selected_adapter"),ValueFieldObservation(document="capture",selector="/adapter_selection_binding",alias="observed_adapter")]

mapping SuccessorFields:
  input present Bool
  target List<ValueFieldObservation,24>
  total true
  expression match present true => [ValueFieldObservation(document="request",selector="/request_id",alias="current_identity"),ValueFieldObservation(document="predecessor",selector="/pack_id",alias="predecessor_identity")] else [ValueFieldObservation(document="request",selector="/request_id",alias="current_identity")]
