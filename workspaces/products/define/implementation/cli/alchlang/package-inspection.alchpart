value-object LinkEncoding:
  prefix Selector
  path Text

mapping LinkBindingPlan:
  input value LinkEncoding
  target List<Step,100>
  total true
  expression [Step(target=[],value=JsonValue.Object(marker=true)),Step(target=[PathPart.Field(name="value")],value=JsonValue.Object(marker=true)),Step(target=[PathPart.Field(name="value"),PathPart.Field(name="selected")],value=JsonValue.Object(marker=true)),Step(target=[PathPart.Field(name="value"),PathPart.Field(name="selected"),PathPart.Field(name="path")],value=JsonValue.Concat(parts=[Piece.Text(value=JsonString(value.prefix)),Piece.Text(value=JsonString(value.path))])),Step(target=[PathPart.Field(name="value"),PathPart.Field(name="selected"),PathPart.Field(name="sha256")],value=JsonValue.Copy(document="item",selector="/sha256")),Step(target=[PathPart.Field(name="value"),PathPart.Field(name="selected"),PathPart.Field(name="bytes")],value=JsonValue.Copy(document="item",selector="/bytes")),Step(target=[PathPart.Field(name="value"),PathPart.Field(name="selected"),PathPart.Field(name="digest_kind")],value=JsonValue.Text(value="original-file-sha256")),Step(target=[PathPart.Field(name="value"),PathPart.Field(name="observed")],value=JsonValue.Copy(document="observed",selector=""))]

