  input value InspectionStatistics
  target List<Step,100>
  total true
  expression [Step(target=[],value=JsonValue.Object(marker=true)),Step(target=[PathPart.Field(name="root_sha256")],value=JsonValue.Text(value=JsonString(Text(value.root_sha256)))),Step(target=[PathPart.Field(name="pack_sha256")],value=JsonValue.Text(value=JsonString(Text(value.body_sha256)))),Step(target=[PathPart.Field(name="required_members_verified")],value=JsonValue.UInt(value=value.required_count)),Step(target=[PathPart.Field(name="frozen_integrity")],value=JsonValue.Text(value="verified")),Step(target=[PathPart.Field(name="current_permission")],value=JsonValue.Text(value="not-established")),Step(target=[PathPart.Field(name="authority_effect")],value=JsonValue.Text(value="none"))]

