
mapping SuccessorFacts:
  input present Bool
  target List<Step,100>
  total true
  expression [Step(target=[],value=JsonValue.Object(marker=true)),Step(target=[PathPart.Field(name="value")],value=JsonValue.Object(marker=true)),Step(target=[PathPart.Field(name="value"),PathPart.Field(name="current_identity_digest")],value=JsonValue.Copy(document="current_identity",selector="/canonical_value_sha256")),Step(target=[PathPart.Field(name="value"),PathPart.Field(name="current_revision")],value=JsonValue.UIntText(document="request",selector="/request_revision")),Step(target=[PathPart.Field(name="value"),PathPart.Field(name="predecessor_identity_digest")],value=match present true => JsonValue.Copy(document="predecessor_identity",selector="/canonical_value_sha256") else JsonValue.Null(marker=true)),Step(target=[PathPart.Field(name="value"),PathPart.Field(name="predecessor_revision")],value=match present true => JsonValue.UIntText(document="predecessor",selector="/revision") else JsonValue.Null(marker=true))]
