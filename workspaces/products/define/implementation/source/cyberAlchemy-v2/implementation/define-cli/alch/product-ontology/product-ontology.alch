# Candidate multi-entry assembly for the selected Alch Product Ontology source.
domain define-product-ontology "Define Product Ontology authoring"
profile service-v1
owner alch-language-product-owner

import ProductOntologyQuestionFunction from "./product-question.alch"
import ProductOntologyReadinessFunction from "./product-readiness.alch"

service DefineProductOntologyRuntime:
  ontology "ALCH-DEFINE-PRODUCT-ONTOLOGY-RUNTIME"
  meaning "Author a source-bound Product Ontology candidate without moving product meaning into Define core."

entry ProductOntologyQuestion:
  function ProductOntologyQuestionFunction
  ontology "ALCH-DEFINE-PRODUCT-ONTOLOGY-QUESTION-ENTRY"
  meaning "Select the next Product-owned meaning required by the selected Product Ontology contract."

entry ProductOntologyReadiness:
  function ProductOntologyReadinessFunction
  ontology "ALCH-DEFINE-PRODUCT-ONTOLOGY-READINESS-ENTRY"
  meaning "Require exact Definition Pack evidence, complete Product meaning, and independent language quality."

