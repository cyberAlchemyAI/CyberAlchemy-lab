{
  "schemas": {
    "OrthogonalityFacts": {
      "applicability_valid": {
        "type": "boolean"
      },
      "axis_identity_valid": {
        "type": "boolean"
      },
      "axis_structure_valid": {
        "type": "boolean"
      },
      "rationale_present": {
        "type": "boolean"
      },
      "cardinality_valid": {
        "type": "boolean"
      },
      "pair_targets_valid": {
        "type": "boolean"
      },
      "pair_coverage_complete": {
        "type": "boolean"
      },
      "pair_evidence_valid": {
        "type": "boolean"
      },
      "axes_non_redundant": {
        "type": "boolean"
      },
      "pairs_resolved": {
        "type": "boolean"
      },
      "couplings_named": {
        "type": "boolean"
      }
    },
    "OrthogonalityDecision": {
      "status": {
        "type": "string",
        "pattern": "^(pass|block)$"
      },
      "repair_focus": {
        "type": "string",
        "pattern": "^(none|orthogonality)$"
      },
      "authority_effect": {
        "type": "string",
        "const": "none"
      }
    }
  },
  "integrations": {},
  "flows": {},
  "endpoint": {
    "id": "DefineOrthogonality",
    "target": "node-http",
    "runtime": "node>=26.8.1",
    "method": "POST",
    "path": "/define/orthogonality",
    "input": "OrthogonalityFacts",
    "output": "OrthogonalityDecision",
    "authEnv": "DEFINE_LANGUAGE_GATE_TOKEN",
    "maxBytes": 16384,
    "timeout": 1000,
    "errorStatus": 422,
    "statuses": {
      "pass": 200,
      "block": 422
    },
    "errors": {},
    "result": "EvaluateOrthogonality"
  }
}
