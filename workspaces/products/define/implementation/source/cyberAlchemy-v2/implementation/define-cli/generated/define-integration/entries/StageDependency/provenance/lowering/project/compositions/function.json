{
  "source_text": "domain define-stage-dependency \"Define ontology stage dependency readiness\"\nprofile declarative-function-v1\nowner cyberalchemy-define-runtime-owner\nlogic sfol-v1\n\nschema DependencyFacts:\n  prerequisites_complete: boolean\n  receipts_current: boolean\n\nschema DependencyDecision:\n  status: string pattern \"^(block|ready)$\"\n  repair_focus: string pattern \"^(prerequisites|receipt-currency|none)$\"\n  authority_effect: string const \"none\"\n\nmapping PrerequisitesBlocked:\n  ontology \"ALCH-DEFINE-STAGE-PREREQUISITES-BLOCKED\"\n  meaning \"Block only the selected ontology stage while a declared prerequisite is absent.\"\n  target DependencyDecision\n  field status = \"block\"\n  field repair_focus = \"prerequisites\"\n  field authority_effect = \"none\"\n\nmapping ReceiptCurrencyBlocked:\n  ontology \"ALCH-DEFINE-STAGE-RECEIPT-CURRENCY-BLOCKED\"\n  meaning \"Reject stale or substituted prerequisite evidence without rewriting the prerequisite.\"\n  target DependencyDecision\n  field status = \"block\"\n  field repair_focus = \"receipt-currency\"\n  field authority_effect = \"none\"\n\nmapping DependenciesReady:\n  ontology \"ALCH-DEFINE-STAGE-DEPENDENCIES-READY\"\n  meaning \"Report exact prerequisite evidence ready without admitting any artifact.\"\n  target DependencyDecision\n  field status = \"ready\"\n  field repair_focus = \"none\"\n  field authority_effect = \"none\"\n\nrule PrerequisiteMissing:\n  ontology \"ALCH-DEFINE-STAGE-PREREQUISITE-MISSING\"\n  meaning \"Every declared prerequisite stage needs one exact candidate handoff receipt.\"\n  condition input.prerequisites_complete == false\n\nrule ReceiptNotCurrent:\n  ontology \"ALCH-DEFINE-STAGE-RECEIPT-NOT-CURRENT\"\n  meaning \"Present prerequisite receipts must bind the current declared candidate.\"\n  condition input.prerequisites_complete and input.receipts_current == false\n\nrule DependencySetReady:\n  ontology \"ALCH-DEFINE-STAGE-DEPENDENCY-SET-READY\"\n  meaning \"All declared prerequisites are present and current.\"\n  condition input.prerequisites_complete and input.receipts_current\n\nresult EvaluateStageDependency:\n  ontology \"ALCH-DEFINE-EVALUATE-STAGE-DEPENDENCY\"\n  meaning \"Select one dependency repair focus or permit the selected stage to continue.\"\n  when PrerequisiteMissing yield PrerequisitesBlocked\n  when ReceiptNotCurrent yield ReceiptCurrencyBlocked\n  when DependencySetReady yield DependenciesReady\n\nendpoint DefineStageDependency:\n  target node-http\n  runtime node>=26.8.1\n  method POST\n  path \"/define/integration/stage-dependency\"\n  input DependencyFacts\n  output DependencyDecision\n  result EvaluateStageDependency\n  auth-env DEFINE_RUNTIME_TOKEN\n  max-bytes 16384\n  timeout-ms 1000\n  error-status 422\n  status block 422\n  status ready 200\n\n",
