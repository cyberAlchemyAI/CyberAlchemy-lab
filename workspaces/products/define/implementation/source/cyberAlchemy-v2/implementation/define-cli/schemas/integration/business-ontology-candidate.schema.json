{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cav2.alch-business-ontology-candidate/v1",
  "type": "object",
  "required": ["schema_version", "ontology_type", "source_ontology_ref", "source_ontology_digest", "product_candidate_digest", "product_handoff_receipt_digest", "dependency_receipt_set_digest", "business", "orthogonality", "non_collapse", "status", "authority_effect"],
  "properties": {
    "schema_version": {"const": "cav2.alch-business-ontology-candidate/v1"},
    "ontology_type": {"const": "business"},
    "source_ontology_ref": {"type": "string", "minLength": 1},
    "source_ontology_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "product_candidate_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "product_handoff_receipt_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dependency_receipt_set_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "business": {
      "type": "object",
      "required": ["meaning_owner", "bounded_model", "concepts_and_relationships", "domain_rule", "lifecycle", "authority_boundary"],
      "properties": {
        "meaning_owner": {"type": "string", "minLength": 1},
        "bounded_model": {"type": "string", "minLength": 1},
        "concepts_and_relationships": {"type": "string", "minLength": 1},
        "domain_rule": {"type": "string", "minLength": 1},
        "lifecycle": {"type": "string", "minLength": 1},
        "authority_boundary": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "orthogonality": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "non_collapse": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "status": {"const": "candidate"},
    "authority_effect": {"const": "none"}
  },
  "additionalProperties": false
}
