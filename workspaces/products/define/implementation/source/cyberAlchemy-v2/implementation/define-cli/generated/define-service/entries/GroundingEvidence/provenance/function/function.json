{
  "schemas": {
    "GroundingEvidenceFacts": {
      "posture": {
        "type": "string",
        "pattern": "^(direct|candidate-inference|user-corrected|unsupported)$"
      },
      "rationale_present": {
        "type": "boolean"
      }
    },
    "GroundingEvidenceDecision": {
      "status": {
        "type": "string",
        "pattern": "^(accept|review|block)$"
      },
      "repair_focus": {
        "type": "string",
        "pattern": "^(none|evidence|user-confirmation)$"
      },
      "requires_direct_match": {
        "type": "boolean"
      },
      "authority_effect": {
        "type": "string",
        "const": "none"
      }
    }
  },
  "integrations": {},
  "flows": {},
  "endpoint": {
    "id": "DefineGroundingEvidence",
    "target": "node-http",
    "runtime": "node>=26.8.1",
    "method": "POST",
    "path": "/define/grounding-evidence",
    "input": "GroundingEvidenceFacts",
    "output": "GroundingEvidenceDecision",
    "authEnv": "DEFINE_LANGUAGE_GATE_TOKEN",
    "maxBytes": 16384,
    "timeout": 1000,
    "errorStatus": 422,
    "statuses": {
      "accept": 200,
      "review": 409,
      "block": 422
    },
    "errors": {},
    "result": "EvaluateGroundingEvidence"
  }
}
