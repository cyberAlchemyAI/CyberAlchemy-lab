{
  "schemas": {
    "GroundingFacts": {
      "schema_valid": {
        "type": "boolean"
      },
      "targets_valid": {
        "type": "boolean"
      },
      "coverage_complete": {
        "type": "boolean"
      },
      "sources_present": {
        "type": "boolean"
      },
      "direct_matches": {
        "type": "boolean"
      },
      "evidence_valid": {
        "type": "boolean"
      },
      "candidate_inference_present": {
        "type": "boolean"
      },
      "user_confirmed": {
        "type": "boolean"
      }
    },
    "GroundingDecision": {
      "status": {
        "type": "string",
        "pattern": "^(pass|review|block)$"
      },
      "repair_focus": {
        "type": "string",
        "pattern": "^(none|semantic-grounding|user-confirmation)$"
      },
      "authority_effect": {
        "type": "string",
        "const": "none"
      }
    }
  },
  "integrations": {},
  "flows": {},
  "endpoint": {
    "id": "DefineSemanticGrounding",
    "target": "node-http",
    "runtime": "node>=26.8.1",
    "method": "POST",
    "path": "/define/semantic-grounding",
    "input": "GroundingFacts",
    "output": "GroundingDecision",
    "authEnv": "DEFINE_LANGUAGE_GATE_TOKEN",
    "maxBytes": 16384,
    "timeout": 1000,
    "errorStatus": 422,
    "statuses": {
      "pass": 200,
      "review": 409,
      "block": 422
    },
    "errors": {},
    "result": "EvaluateSemanticGrounding"
  }
}
