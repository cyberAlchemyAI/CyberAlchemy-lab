{
  "schemas": {
    "DispositionFacts": {
      "action": {
        "type": "string",
        "pattern": "^(reuse|specialize|propose|open|defer|refuse|unsupported)$"
      },
      "definition_reference_present": {
        "type": "boolean"
      },
      "base_reference_present": {
        "type": "boolean"
      },
      "specialization_scope_present": {
        "type": "boolean"
      },
      "proposal_present": {
        "type": "boolean"
      }
    },
    "DispositionDecision": {
      "status": {
        "type": "string",
        "pattern": "^(accepted|block)$"
      },
      "disposition": {
        "type": "string",
        "pattern": "^(reuse|specialize|propose|open|none)$"
      },
      "repair_focus": {
        "type": "string",
        "pattern": "^(none|unsupported-action|definition-reference|specialization|proposal)$"
      },
      "authority_effect": {
        "type": "string",
        "const": "none"
      }
    }
  },
  "integrations": {},
  "flows": {},
  "endpoint": {
    "id": "DefineConceptDisposition",
    "target": "node-http",
    "runtime": "node>=26.8.1",
    "method": "POST",
    "path": "/define/concept-disposition",
    "input": "DispositionFacts",
    "output": "DispositionDecision",
    "authEnv": "DEFINE_RUNTIME_TOKEN",
    "maxBytes": 16384,
    "timeout": 1000,
    "errorStatus": 422,
    "statuses": {
      "accepted": 200,
      "block": 422
    },
    "errors": {},
    "result": "EvaluateConceptDisposition"
  }
}
