{
  "schemas": {
    "LanguageChecks": {
      "semantic_grounding": {
        "type": "string",
        "pattern": "^(pass|review|block)$"
      },
      "non_collapse": {
        "type": "string",
        "pattern": "^(pass|block)$"
      },
      "orthogonality": {
        "type": "string",
        "pattern": "^(pass|block)$"
      },
      "user_confirmed": {
        "type": "boolean"
      }
    },
    "ReadinessDecision": {
      "status": {
        "type": "string",
        "pattern": "^(pass|review|block)$"
      },
      "repair_focus": {
        "type": "string",
        "pattern": "^(none|semantic-grounding|non-collapse|orthogonality|user-confirmation)$"
      },
      "authority_effect": {
        "type": "string",
        "const": "none"
      }
    }
  },
  "integrations": {},
  "flows": {},
  "endpoint": {
    "id": "DefineLanguageReadiness",
    "target": "node-http",
    "runtime": "node>=26.8.1",
    "method": "POST",
    "path": "/define/language-readiness",
    "input": "LanguageChecks",
    "output": "ReadinessDecision",
    "authEnv": "DEFINE_LANGUAGE_GATE_TOKEN",
    "maxBytes": 16384,
    "timeout": 1000,
    "errorStatus": 422,
    "statuses": {
      "pass": 200,
      "review": 409,
      "block": 422
    },
    "errors": {
      "FUNCTION_OUTPUT_SCHEMA": 500,
      "FUNCTION_BODY_LIMIT": 413
    },
    "result": "EvaluateLanguageReadiness"
  }
}
