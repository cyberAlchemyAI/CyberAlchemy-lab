{
  "schemas": {
    "BusinessQuestionFacts": {
      "meaning_owner_present": {
        "type": "boolean"
      },
      "bounded_model_present": {
        "type": "boolean"
      },
      "concepts_and_relationships_present": {
        "type": "boolean"
      },
      "domain_rule_present": {
        "type": "boolean"
      },
      "lifecycle_present": {
        "type": "boolean"
      },
      "authority_boundary_present": {
        "type": "boolean"
      }
    },
    "BusinessQuestionDecision": {
      "status": {
        "type": "string",
        "pattern": "^(ask|complete)$"
      },
      "next_focus": {
        "type": "string",
        "pattern": "^(meaning-owner|bounded-model|concepts-and-relationships|domain-rule|lifecycle|authority-boundary|none)$"
      },
      "authority_effect": {
        "type": "string",
        "const": "none"
      }
    }
  },
  "integrations": {},
  "flows": {},
  "endpoint": {
    "id": "DefineBusinessOntologyQuestion",
    "target": "node-http",
    "runtime": "node>=26.8.1",
    "method": "POST",
    "path": "/define/business-ontology/question",
    "input": "BusinessQuestionFacts",
    "output": "BusinessQuestionDecision",
    "authEnv": "DEFINE_RUNTIME_TOKEN",
    "maxBytes": 16384,
    "timeout": 1000,
    "errorStatus": 422,
    "statuses": {
      "ask": 200,
      "complete": 200
    },
    "errors": {},
    "result": "SelectBusinessOntologyQuestion"
  }
}
