{
  "schemas": {
    "DependencyFacts": {
      "prerequisites_complete": {
        "type": "boolean"
      },
      "receipts_current": {
        "type": "boolean"
      }
    },
    "DependencyDecision": {
      "status": {
        "type": "string",
        "pattern": "^(block|ready)$"
      },
      "repair_focus": {
        "type": "string",
        "pattern": "^(prerequisites|receipt-currency|none)$"
      },
      "authority_effect": {
        "type": "string",
        "const": "none"
      }
    }
  },
  "integrations": {},
  "flows": {},
  "endpoint": {
    "id": "DefineStageDependency",
    "target": "node-http",
    "runtime": "node>=26.8.1",
    "method": "POST",
    "path": "/define/integration/stage-dependency",
    "input": "DependencyFacts",
    "output": "DependencyDecision",
    "authEnv": "DEFINE_RUNTIME_TOKEN",
    "maxBytes": 16384,
    "timeout": 1000,
    "errorStatus": 422,
    "statuses": {
      "block": 422,
      "ready": 200
    },
    "errors": {},
    "result": "EvaluateStageDependency"
  }
}
