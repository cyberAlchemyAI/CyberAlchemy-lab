# Candidate multi-entry assembly for Define decision functions.
domain define-runtime "CyberAlchemy Define decision runtime"
profile service-v1
owner cyberalchemy-define-owner

import SemanticGroundingFunction from "./define-semantic-grounding.alch"
import GroundingEvidenceFunction from "./define-grounding-evidence.alch"
import NonCollapseFunction from "./define-non-collapse.alch"
import NonCollapseEvidenceFunction from "./define-non-collapse-evidence.alch"
import OrthogonalityFunction from "./define-orthogonality.alch"
import OrthogonalityEvidenceFunction from "./define-orthogonality-evidence.alch"
import LanguageReadinessFunction from "./define-language-readiness.alch"
import ScopeReadinessFunction from "./define-scope-readiness.alch"
import ConceptDispositionFunction from "./define-concept-disposition.alch"
import PackReadinessFunction from "./define-pack-readiness.alch"
import AlchHandoffReadinessFunction from "./define-alch-handoff-readiness.alch"

service DefineDecisionRuntime:
  ontology "ALCH-DEFINE-DECISION-RUNTIME"
  meaning "Assemble compiled Define semantic and workflow decisions behind explicit, non-overlapping entry points."

entry SemanticGrounding:
  function SemanticGroundingFunction
  ontology "ALCH-DEFINE-SEMANTIC-GROUNDING-ENTRY"
  meaning "Evaluate semantic grounding evidence facts."

entry GroundingEvidence:
  function GroundingEvidenceFunction
  ontology "ALCH-DEFINE-GROUNDING-EVIDENCE-ENTRY"
  meaning "Classify one grounding evidence posture."

entry NonCollapse:
  function NonCollapseFunction
  ontology "ALCH-DEFINE-NON-COLLAPSE-ENTRY"
  meaning "Evaluate candidate-term non-collapse evidence facts."

entry NonCollapseEvidence:
  function NonCollapseEvidenceFunction
  ontology "ALCH-DEFINE-NON-COLLAPSE-EVIDENCE-ENTRY"
  meaning "Classify one term-pair relation posture."

entry Orthogonality:
  function OrthogonalityFunction
  ontology "ALCH-DEFINE-ORTHOGONALITY-ENTRY"
  meaning "Evaluate classification-axis orthogonality evidence facts."

entry OrthogonalityEvidence:
  function OrthogonalityEvidenceFunction
  ontology "ALCH-DEFINE-ORTHOGONALITY-EVIDENCE-ENTRY"
  meaning "Classify one axis-pair relation and its coupling evidence."

entry LanguageReadiness:
  function LanguageReadinessFunction
  ontology "ALCH-DEFINE-LANGUAGE-READINESS-ENTRY"
  meaning "Aggregate the independent language-quality decisions."

entry ScopeReadiness:
  function ScopeReadinessFunction
  ontology "ALCH-DEFINE-SCOPE-READINESS-ENTRY"
  meaning "Select the next scope-intake focus before human confirmation."

entry ConceptDisposition:
  function ConceptDispositionFunction
  ontology "ALCH-DEFINE-CONCEPT-DISPOSITION-ENTRY"
  meaning "Validate one requested concept disposition."

entry PackReadiness:
  function PackReadinessFunction
  ontology "ALCH-DEFINE-PACK-READINESS-ENTRY"
  meaning "Evaluate Definition Pack structure and handoff posture."

entry AlchHandoffReadiness:
  function AlchHandoffReadinessFunction
  ontology "ALCH-DEFINE-ALCH-HANDOFF-READINESS-ENTRY"
  meaning "Require an exact reviewed Definition Pack and every independent language-quality dimension before candidate Alch compilation."
