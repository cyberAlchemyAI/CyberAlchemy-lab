#!/usr/bin/env bash
set -euo pipefail
DEFINE_WORKSPACE_ROOT="$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
DEFINITION_LAB_ROOT="$(cd -- "$DEFINE_WORKSPACE_ROOT/../../.." && pwd -P)"
if [[ "${1-}" == "lab" ]]; then
  shift
  exec "$DEFINITION_LAB_ROOT/define/define-lab" "$@"
fi
exec node "$DEFINITION_LAB_ROOT/implementation/define-cli/v1/bin/define.mjs" "$@"
