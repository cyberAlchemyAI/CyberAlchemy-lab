{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cyberalchemy-lab:ontology-product-event-runtime-candidate:v1",
  "title": "CyberAlchemy Lab Ontology Product Event Runtime Candidate",
  "type": "object",
  "required": ["schema_version", "candidate_id", "version", "status", "construction_stage", "predecessor", "product_increment", "acceptance_material", "acceptance_criteria", "product_test", "authority_effect", "operational_residue", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "cyberalchemy-lab-ontology-product-event-runtime-candidate/v1"},
    "candidate_id": {"const": "CAL-ONTOLOGY-AS-PRODUCT-CANDIDATE-0006-EVENT-RUNTIME-REALIZATION"},
    "status": {"const": "ready-for-product-approval"},
    "construction_stage": {"const": "CAV2-D65-TESTABLE-PRODUCT-FREEZE"},
    "acceptance_material": {
      "type": "array",
      "minItems": 19,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "role"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "role": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "authority_effect": {"const": "none"}
  },
  "additionalProperties": true
}
