{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cyberalchemy-lab-cohesive-ontology-system/v1",
  "title": "CyberAlchemy Lab cohesive ontology system",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "system_id",
    "version",
    "ontology_type",
    "status",
    "authority_effect",
    "owner_route",
    "purpose",
    "sources",
    "components",
    "relations",
    "catalog_projection",
    "canonical_truth_contract",
    "admission_model",
    "query_contract",
    "residue",
    "source_direction",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "cyberalchemy-lab-cohesive-ontology-system/v1"},
    "system_id": {"const": "cal.ontology-system.lab-cohesion"},
    "version": {"type": "string", "minLength": 1},
    "ontology_type": {"const": "business-system-bridge"},
    "status": {"const": "testable-product-candidate"},
    "authority_effect": {"const": "none"},
    "owner_route": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "path", "sha256", "posture", "owner_route"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "posture": {"type": "string", "minLength": 1},
          "owner_route": {"type": "string", "minLength": 1}
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_id", "kind", "branch", "authority_state", "owner_route", "source_refs"],
        "properties": {
          "component_id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "branch": {"enum": ["business", "system", "bridge", "governance", "context"]},
          "authority_state": {"type": "string", "minLength": 1},
          "owner_route": {"type": "string", "minLength": 1},
          "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "relations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relation_id", "type", "source", "target", "status", "source_refs"],
        "properties": {
          "relation_id": {"type": "string", "minLength": 1},
          "type": {"enum": ["realized_by", "depends_on", "constrained_by", "observed_by", "tested_by", "drifts_from", "traced_to"]},
          "source": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "status": {"type": "string", "minLength": 1},
          "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "catalog_projection": {"type": "object"},
    "canonical_truth_contract": {"type": "object"},
    "admission_model": {"type": "object"},
    "query_contract": {"type": "object"},
    "residue": {"type": "array", "minItems": 1},
    "source_direction": {"type": "object"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  }
}
