      "mutation_test": "complete_governance_state_and_challenge_contract_are_non_vacuous",
      "expected_failure": "GOVERNANCE_EVENT_DECODE_FAILED",
      "non_vacuity": "A semantic-state patch cannot enter the closed governance event shape."
