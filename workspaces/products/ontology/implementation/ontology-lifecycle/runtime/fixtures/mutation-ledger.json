      "mutation_test": "expected_version_and_atomic_semantic_batch_are_enforced",
      "expected_failure": "SUBJECT_EVENT_CHAIN_BROKEN",
      "non_vacuity": "The first otherwise-valid event is not persisted when the second event breaks continuity."
    },
    {
      "obligation": "expected-stream-version-check",
      "positive_test": "valid_semantic_and_governance_appends_are_immediately_replayable",
      "mutation_test": "expected_version_and_atomic_semantic_batch_are_enforced",
      "expected_failure": "EXPECTED_STREAM_VERSION_MISMATCH",
      "non_vacuity": "The target directory count is unchanged after a stale expected version."
    },
    {
      "obligation": "monotonic-stream-position",
      "positive_test": "valid_semantic_and_governance_appends_are_immediately_replayable",
      "mutation_test": "cursor_identity_stream_and_chain_mutations_each_fail",
      "expected_failure": "SUBJECT_EVENT_CHAIN_BROKEN",
      "non_vacuity": "Per-stream position is derived from ordered events and bound to the predecessor digest."
    },
    {
      "obligation": "monotonic-commit-position",
      "positive_test": "deterministic_rebuilds_match_for_all_read_models",
      "mutation_test": "cursor_identity_stream_and_chain_mutations_each_fail",
      "expected_failure": "GRAPH_CURSOR_NOT_CONTIGUOUS",
      "non_vacuity": "Changing one semantic cursor prevents store admission."
    },
    {
      "obligation": "unique-event-identity",
      "positive_test": "deterministic_rebuilds_match_for_all_read_models",
      "mutation_test": "event_identity_is_unique_across_stream_families",
      "expected_failure": "GLOBAL_EVENT_ID_DUPLICATE",
      "non_vacuity": "A governance ID copied from a semantic event is rejected after both histories validate locally."
    },
    {
      "obligation": "one-stream-per-subject",
      "positive_test": "latest_snapshots_are_per_subject_and_keep_tombstones",
      "mutation_test": "cursor_identity_stream_and_chain_mutations_each_fail",
      "expected_failure": "SUBJECT_STREAM_ID_MISMATCH",
      "non_vacuity": "A valid event moved to another derived stream is rejected."
    },
    {
      "obligation": "semantic-governance-stream-separation",
