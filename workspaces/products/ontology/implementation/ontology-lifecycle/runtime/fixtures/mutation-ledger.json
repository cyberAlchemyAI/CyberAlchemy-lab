    {
      "obligation": "exact-cross-stream-reference-join",
      "positive_test": "governed_view_requires_governance_for_the_exact_latest_epoch",
      "mutation_test": "exact_governance_reference_mutations_each_fail",
      "expected_failure": "GOVERNANCE_REFERENCE_MISSING or GOVERNANCE_REFERENCE_MISMATCH",
      "non_vacuity": "Event ID, digest, and semantic cursor are mutated independently."
