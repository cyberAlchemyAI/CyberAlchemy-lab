{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "dataset",
    "initial_semantic_cursor",
    "initial_governance_cursor",
    "staged_replacement_semantic_cursor",
    "staged_replacement_governance_cursor",
    "renamed_replacement_semantic_cursor",
    "renamed_replacement_governance_cursor",
    "final_semantic_cursor",
    "final_governance_cursor",
    "expected_final_index_digest",
    "fault_process_exit",
    "attempt_count",
    "required_replacement_strategy",
    "required_controls",
    "power_loss_durability_claim",
    "canonical_replay_source",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {"const": "cal-checkpoint-crash-consistency-requirements/v1-prototype"},
    "profile_id": {"const": "w7-process-interruption"},
    "dataset": {"const": "cal-w7-ontology-product-epoch-001"},
    "initial_semantic_cursor": {"const": 15},
    "initial_governance_cursor": {"const": 15},
    "staged_replacement_semantic_cursor": {"const": 23},
    "staged_replacement_governance_cursor": {"const": 23},
    "renamed_replacement_semantic_cursor": {"const": 35},
    "renamed_replacement_governance_cursor": {"const": 35},
    "final_semantic_cursor": {"const": 47},
    "final_governance_cursor": {"const": 47},
    "expected_final_index_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fault_process_exit": {"const": 75},
    "attempt_count": {"const": 2},
    "required_replacement_strategy": {"const": "same_directory_synced_stage_atomic_rename"},
    "required_controls": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "power_loss_durability_claim": {"const": false},
    "canonical_replay_source": {"const": false},
    "authority_effect": {"const": "none"}
  },
  "additionalProperties": false
}
