{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cal:sustained-ingestion-requirements:v1-prototype",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "batch_count",
    "queue_capacity",
    "reader_thread_count",
    "minimum_reader_observations",
    "attempt_count",
    "maximum_process_elapsed_ns",
    "minimum_throughput_batches_per_second",
    "maximum_projection_latency_ns",
    "maximum_pending_over_capacity",
    "require_deterministic_paused_overload",
    "require_retry_after_overload",
    "require_exact_final_rebuild_equivalence",
    "require_zero_invalid_reader_observations",
    "require_old_snapshot_retention",
    "require_exact_drain",
    "require_zero_final_cursor_lag",
    "canonical_replay_source",
    "authority_effect",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "cal-sustained-ingestion-requirements/v1-prototype"},
    "profile_id": {"const": "sustained"},
    "batch_count": {"type": "integer", "minimum": 100},
    "queue_capacity": {"type": "integer", "minimum": 1},
    "reader_thread_count": {"type": "integer", "minimum": 1},
    "minimum_reader_observations": {"type": "integer", "minimum": 1},
    "attempt_count": {"const": 2},
    "maximum_process_elapsed_ns": {"type": "integer", "minimum": 1},
    "minimum_throughput_batches_per_second": {"type": "number", "exclusiveMinimum": 0},
    "maximum_projection_latency_ns": {"type": "integer", "minimum": 1},
    "maximum_pending_over_capacity": {"const": 1},
    "require_deterministic_paused_overload": {"const": true},
    "require_retry_after_overload": {"const": true},
    "require_exact_final_rebuild_equivalence": {"const": true},
    "require_zero_invalid_reader_observations": {"const": true},
    "require_old_snapshot_retention": {"const": true},
    "require_exact_drain": {"const": true},
    "require_zero_final_cursor_lag": {"const": true},
    "canonical_replay_source": {"const": false},
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"const": "local_synthetic_single_writer_sustained_ingestion_prototype_evidence_only"}
  },
  "additionalProperties": false
}
