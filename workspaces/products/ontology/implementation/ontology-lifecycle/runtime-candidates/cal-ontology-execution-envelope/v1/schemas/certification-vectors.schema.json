{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cal.d65-adapter-certification-vectors/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "vectors"],
  "properties": {
    "schema_version": {"const": "cal.d65-adapter-certification-vectors/v1"},
    "vectors": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["vector_id", "scenario", "expected_execution_result", "expected_failure_code", "state_invariant", "external_effects"],
        "properties": {
          "vector_id": {"type": "string", "pattern": "^CERT-[0-9]{2}-[A-Z-]+$"},
          "scenario": {"type": "string"},
          "expected_execution_result": {"enum": ["PASS", "BLOCK", "META"]},
          "expected_failure_code": {"type": ["string", "null"]},
          "state_invariant": {"const": "exact-preimage"},
          "external_effects": {"const": false}
        }
      }
    }
  }
}
