{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cal.d65-epoch-002-definition-prototype/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "prototype_id", "construction_id", "stage_id", "status", "authority_effect", "intent", "source_bindings", "terms", "evidence_bindings", "work_plan", "next_product_frontier", "product_approval", "challenge_route", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "cal.d65-epoch-002-definition-prototype/v1"},
    "prototype_id": {"const": "CAL-D65-EPOCH-002-DEFINITION-PROTOTYPE-001"},
    "construction_id": {"const": "CA2-CONSTRUCTION-CYBERALCHEMY-LAB-ONTOLOGY-RUNTIME-EXPORT-CUTOVER-EPOCH-002"},
    "stage_id": {"const": "D65-S1"},
    "status": {"const": "prototype"},
    "authority_effect": {"const": "none"},
    "intent": {"type": "string", "minLength": 1},
    "source_bindings": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "repository", "path", "selector_kind", "selector", "sha256"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "repository": {"enum": ["/home/vrondelli/projects/domainspec-core", "/home/vrondelli/projects/CyberAlchemy-lab"]},
          "path": {"type": "string", "minLength": 1},
          "selector_kind": {"enum": ["level-two-section", "whole-file"]},
          "selector": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "terms": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term_id", "term", "disposition", "definition_ref", "normative", "plain_language", "boundary"],
        "properties": {
          "term_id": {"type": "string", "minLength": 1},
          "term": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["reuse", "prototype"]},
          "definition_ref": {"type": ["string", "null"]},
          "normative": {"type": "string", "minLength": 1},
          "plain_language": {"type": "string", "minLength": 1},
          "boundary": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence_bindings": {"type": "array", "minItems": 3, "items": {"type": "object", "required": ["path", "sha256"]}},
    "work_plan": {"type": "object", "required": ["lane", "current_frontier", "operational_tasks", "continuation_status"]},
    "next_product_frontier": {"const": "D65-S2"},
    "product_approval": {"const": "not-requested"},
    "challenge_route": {"type": "string", "minLength": 1},
    "claim_ceiling": {"type": "string", "minLength": 1}
  }
}
