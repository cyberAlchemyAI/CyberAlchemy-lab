{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cal-d65-system-ontology-package/v1",
  "$defs": {
    "profile": {
      "type": "object",
      "required": ["schema_version", "package_id", "ontology_id", "stage", "status", "source_graph", "system_ontology", "owner_gate", "claim_ceiling"],
      "properties": {
        "stage": {"const": "D65-S5"},
        "status": {"const": "candidate-not-admitted"},
        "owner_gate": {"const": "G-D65-COMPILE"},
        "implementation_binding_present": {"const": false}
      }
    },
    "systemOntology": {
      "type": "object",
      "required": ["schema_version", "ontology_id", "authority", "status", "source", "semantic_graph", "event_calculus", "claim_ceiling"],
      "properties": {
        "schema_version": {"const": "cal.d65-system-runtime-ontology/v1"},
        "authority": {"const": "generated-system-runtime-read-model"},
        "status": {"const": "candidate-unadmitted"}
      }
    },
    "compileReceipt": {
      "type": "object",
      "required": ["schema_version", "result", "outputs", "deterministic_internal_double_compile", "claim_ceiling"],
      "properties": {
        "result": {"const": "PASS"},
        "deterministic_internal_double_compile": {"const": true}
      }
    }
  }
}
