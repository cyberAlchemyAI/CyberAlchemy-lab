  "schema_version": "cal.business-ontology-relations/v1",
  "relation_vocabulary": [
    {"type":"requires","source_roles":["capability","domain_concept","workflow"],"target_roles":["domain_concept","business_rule","policy"],"meaning":"The source cannot satisfy its business meaning without the target.","forbidden_collapse":"Requirement is not satisfaction or implementation evidence."},
    {"type":"serves","source_roles":["capability","domain_concept"],"target_roles":["actor"],"meaning":"The source is shaped for the actor's declared business use.","forbidden_collapse":"Service does not grant authority or prove value."},
    {"type":"accepts","source_roles":["domain_concept"],"target_roles":["domain_concept"],"meaning":"The source admits the target as a typed business input after its policy checks.","forbidden_collapse":"Acceptance in a contract is not ontology admission or access authorization."},
    {"type":"binds","source_roles":["domain_concept"],"target_roles":["actor","domain_concept"],"meaning":"The source establishes one version-exact business association.","forbidden_collapse":"A business binding is not an implementation ConstructionBinding."},
    {"type":"selects","source_roles":["domain_concept"],"target_roles":["domain_concept"],"meaning":"The source names the exact target used by a calculation or view.","forbidden_collapse":"Selection does not own, mutate, or admit the target."},
    {"type":"derived_from","source_roles":["domain_concept"],"target_roles":["domain_concept"],"meaning":"The source is a rebuildable derivative of the target.","forbidden_collapse":"Derivative state cannot become canonical input."},
    {"type":"delivers","source_roles":["domain_concept","workflow"],"target_roles":["domain_concept","outcome"],"meaning":"The source makes the target available only after declared checks pass.","forbidden_collapse":"Delivery is not product proof or source admission."},
    {"type":"governed_by","source_roles":["domain_concept","workflow"],"target_roles":["business_rule","policy","domain_concept"],"meaning":"The target constrains the source's allowed business behavior.","forbidden_collapse":"A governing relation does not activate runtime enforcement."},
    {"type":"routes_to","source_roles":["domain_concept","workflow"],"target_roles":["domain_concept"],"meaning":"The source sends a declared challenge or dispute to the target route.","forbidden_collapse":"Routing does not decide the challenge."},
    {"type":"produces","source_roles":["capability","workflow"],"target_roles":["outcome"],"meaning":"The source is intended to yield the target business outcome when eventually realized and conformant.","forbidden_collapse":"Desired production is not occurrence evidence."},
    {"type":"coordinates","source_roles":["workflow"],"target_roles":["domain_concept","policy"],"meaning":"The workflow orders use of the target contract or policy.","forbidden_collapse":"Coordination is not implementation."},
    {"type":"binds_predecessor","source_roles":["domain_concept"],"target_roles":["capability","domain_concept"],"meaning":"The Integration Epoch names the exact predecessor identity used by this candidate.","forbidden_collapse":"Epoch binding is not admission, completion, or release."}
  ],
