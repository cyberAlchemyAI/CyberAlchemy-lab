{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cyberalchemy-lab:ontology-lifecycle:challenge-contract-state:v2-candidate",
  "title": "Challenge contract governance state",
  "type": "object",
  "additionalProperties": false,
  "required": ["challenge_response", "valid_challenge_modes", "contradiction_edges", "validation_edges", "owner_route", "resolution_gate", "blocking_questions", "challenge_residue_route"],
  "properties": {
    "challenge_response": {"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:common:v2-candidate#/$defs/NonEmptyString"},
    "valid_challenge_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["evidence", "contradiction", "owner_review"]}},
    "contradiction_edges": {"type": "array", "uniqueItems": true, "items": {"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:common:v2-candidate#/$defs/EdgeReference"}},
    "validation_edges": {"type": "array", "uniqueItems": true, "items": {"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:common:v2-candidate#/$defs/EdgeReference"}},
    "owner_route": {"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:common:v2-candidate#/$defs/NonEmptyString"},
    "resolution_gate": {"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:common:v2-candidate#/$defs/Identifier"},
    "blocking_questions": {"type": "array", "uniqueItems": true, "items": {"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:common:v2-candidate#/$defs/NonEmptyString"}},
    "challenge_residue_route": {"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:common:v2-candidate#/$defs/NonEmptyString"}
  },
  "x-definition-ref": "ontology-lifecycle.challenge-contract",
  "x-authority-effect": "none"
}
