{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cyberalchemy-lab:ontology-lifecycle:governance-state:v2-candidate",
  "title": "Ontology governance state for one exact semantic epoch",
  "type": "object",
  "additionalProperties": false,
  "required": ["semantic_ref", "provenance", "owner_route", "candidate_or_maturity_status", "promotion_state_or_handle", "authority_kind_and_posture", "authority_effect", "evidence_confidence", "commitment_confidence", "challenge_contract", "residue", "conflicts", "drift_owner", "invalidation_route"],
  "properties": {
    "semantic_ref": {"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:common:v2-candidate#/$defs/ExactSemanticEventReference"},
    "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:common:v2-candidate#/$defs/ProvenanceEntry"}},
    "owner_route": {"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:common:v2-candidate#/$defs/NonEmptyString"},
    "candidate_or_maturity_status": {"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:common:v2-candidate#/$defs/Identifier"},
    "promotion_state_or_handle": {"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:common:v2-candidate#/$defs/Identifier"},
    "authority_kind_and_posture": {
      "type": "object", "additionalProperties": false, "required": ["kind", "posture"],
      "properties": {"kind": {"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:common:v2-candidate#/$defs/Identifier"}, "posture": {"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:common:v2-candidate#/$defs/Identifier"}}
    },
    "authority_effect": {"const": "none"},
    "evidence_confidence": {"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:common:v2-candidate#/$defs/ConfidenceReference"},
    "commitment_confidence": {"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:common:v2-candidate#/$defs/ConfidenceReference"},
    "challenge_contract": {"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:challenge-contract-state:v2-candidate"},
    "residue": {"type": "array", "items": {"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:common:v2-candidate#/$defs/TypedResidue"}},
    "conflicts": {"type": "array", "items": {"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:common:v2-candidate#/$defs/TypedConflict"}},
    "drift_owner": {"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:common:v2-candidate#/$defs/NonEmptyString"},
    "invalidation_route": {"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:common:v2-candidate#/$defs/NonEmptyString"}
  },
  "x-definition-ref": "ontology-lifecycle.ontology-governance-state",
  "x-authority-effect": "none"
}
