{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cyberalchemy-lab:ontology-lifecycle:semantic-event:v2-candidate",
  "title": "Canonical complete-state semantic event",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_kind", "event_family", "event_id", "event_digest", "stream_id", "subject_identity", "previous_event_digest", "semantic_cursor", "complete_resulting_semantic_state"],
  "properties": {
    "source_kind": {"const": "canonical_event"},
    "event_family": {"const": "semantic"},
    "event_id": {"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:common:v2-candidate#/$defs/Identifier"},
    "event_digest": {"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:common:v2-candidate#/$defs/Sha256"},
    "stream_id": {"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:common:v2-candidate#/$defs/Identifier"},
    "subject_identity": {"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:common:v2-candidate#/$defs/OntologySubjectIdentity"},
    "previous_event_digest": {"oneOf": [{"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:common:v2-candidate#/$defs/Sha256"}, {"type": "null"}]},
    "semantic_cursor": {"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:common:v2-candidate#/$defs/Cursor"},
    "complete_resulting_semantic_state": {"oneOf": [{"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:node-state:v2-candidate"}, {"$ref": "urn:cyberalchemy-lab:ontology-lifecycle:relation-state:v2-candidate"}]}
  },
  "x-replay-source": true,
  "x-authority-effect": "none"
}
