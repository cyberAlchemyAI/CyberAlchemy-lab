{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cal.schema.product-ontology-runtime-integration/v1",
  "type": "object",
  "additionalProperties": true,
  "$defs": {
    "profile": {"type":"object","required":["schema_version","ontology_id","ontology_type","branch","materialization","package_root","package_owner","visibility","candidate_status","authority_effect","owner_gate","blocked_outputs"]},
    "sources": {"type":"object","required":["schema_version","sources"],"properties":{"sources":{"type":"array","minItems":8}}},
    "capability": {"type":"object","required":["schema_version","capability_id","definition_ref","product_ref","business_ontology_ref","outcome","outcome_refs","scope","exclusions","participant_refs","consumer_refs","definition_binding_refs","owner_routes","lifecycle_posture","adoption_state","evidence_refs","challenge_route","authority_effect","claim_limit"]},
    "nodes": {"type":"object","required":["schema_version","nodes"],"properties":{"nodes":{"type":"array","minItems":16}}},
    "relations": {"type":"object","required":["schema_version","relation_vocabulary","relations"],"properties":{"relation_vocabulary":{"type":"array","minItems":7},"relations":{"type":"array","minItems":15}}},
    "residue": {"type":"object","required":["schema_version","residue"],"properties":{"residue":{"type":"array","minItems":4}}},
    "decision_request": {"type":"object","required":["schema_version","request_id","gate_id","status","question","candidate_refs","options","decision_owner_route","blocked_until_selection","authority_effect","claim_ceiling"]}
  }
}
