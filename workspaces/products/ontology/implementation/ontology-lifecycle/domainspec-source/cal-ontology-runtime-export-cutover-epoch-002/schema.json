{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "feature_id", "stage_id", "status", "predecessors", "contexts", "context_map", "aggregates", "commands", "events", "projections", "invariants", "typed_failures", "public_adapter_contract", "next_product_frontier", "product_approval", "authority_effect", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "domainspec.authored-source/v2"},
    "project_id": {"const": "cal-ontology-runtime-export-cutover-epoch-002"},
    "feature_id": {"const": "public-v2-context-adapters"},
    "stage_id": {"const": "D65-S4"},
    "status": {"const": "prototype"},
    "predecessors": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "contexts": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["ref", "role", "version"]}},
    "context_map": {"type": "object", "required": ["ref", "version", "direction", "relationship"]},
    "aggregates": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["aggregate_id", "stream_identity", "semantic_stream", "governance_stream", "state_calculation"]}},
    "commands": {"type": "array", "minItems": 4},
    "events": {"type": "array", "minItems": 5},
    "projections": {"type": "array", "minItems": 3},
    "invariants": {"type": "array", "minItems": 5},
    "typed_failures": {"type": "array", "minItems": 8, "uniqueItems": true},
    "public_adapter_contract": {"type": "object", "required": ["crate", "modules", "map_binding_symbol", "source_runtime", "admitted_runtime_mutation"]},
    "next_product_frontier": {"const": "D65-S5"},
    "product_approval": {"const": "not-requested"},
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  }
}
