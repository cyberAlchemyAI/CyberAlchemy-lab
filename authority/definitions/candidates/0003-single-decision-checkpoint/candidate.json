    "disposition": "open-for-reuse-from-craft",
    "reason": "Workflow is a load-bearing dependency but must come from the Craft/DomainSpec migration rather than an independent Lab redefinition.",
    "required_resolution": "Select an exact Craft Workflow definition and admit its source selector for Lab use before promotion review."
  },
  "evaluation_profile_ref": "CAL-EVALUATION-DEFINITION-V1",
