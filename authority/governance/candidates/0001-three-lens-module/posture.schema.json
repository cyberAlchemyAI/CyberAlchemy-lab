{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/governance-posture-view/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "view_kind",
    "module_ref",
    "subject_ref",
    "subject_version_ref",
    "source_bundle_ref",
    "source_bundle_sha256",
    "authority_effect",
    "replay_source",
    "authority",
    "provenance",
    "lifecycle",
    "independent_facets",
    "project_history_at_foundation_bundle",
    "claim_ceiling",
    "project_history_at_bootstrap_bundle"
  ],
  "properties": {
    "schema_version": {
      "const": "cyberalchemy-lab-governance-posture-view/v1"
    },
    "view_kind": {
      "const": "governance-posture-view"
    },
    "module_ref": {
      "const": "CAL-GOVERNANCE-MODULE-CANDIDATE-0001"
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "subject_version_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_bundle_ref": {
      "enum": [
        "CAL-CYBERALCHEMY-LAB-OPERATIONAL-FOUNDATION-BUNDLE-0071",
        "CAL-PROJECT-STATE-BOOTSTRAP-BUNDLE-0072"
      ]
    },
    "source_bundle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authority_effect": {
      "const": "none"
    },
    "replay_source": {
      "const": false
    },
    "authority": {
      "type": "object",
      "required": [
        "effective_instance_state",
        "admission_decision_ref",
        "admission_effect",
        "declared_owner_ref",
        "action_authorization",
        "authority_grant",
        "declared_owner_source_field"
      ],
      "properties": {
        "effective_instance_state": {
          "enum": [
            "admitted-current",
            "admitted-historical"
          ]
        },
        "admission_decision_ref": {
          "type": "string"
        },
        "admission_effect": {
          "enum": [
            "foundation-artifact-instance-admission-only",
            "project-state-bootstrap-instance-admission-only"
          ]
        },
        "declared_owner_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "action_authorization": {
          "const": "not-evaluated"
        },
        "authority_grant": {
          "const": "not-inferred"
        },
        "declared_owner_source_field": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_path",
        "source_sha256",
        "admitted_copy_path",
        "admitted_copy_sha256",
        "source_copy_integrity",
        "declared_provenance_refs",
        "lineage_relations",
        "declared_evidence_refs",
        "evidence_sufficiency"
      ],
      "properties": {
        "source_path": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "admitted_copy_path": {
          "type": "string"
        },
        "admitted_copy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_copy_integrity": {
          "const": "exact-match"
        },
        "declared_provenance_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lineage_relations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "relation_id",
              "relation_kind_ref",
              "target_ref",
              "qualifiers"
            ],
            "properties": {
              "relation_id": {
                "type": "string"
              },
              "relation_kind_ref": {
                "enum": [
                  "relation.originates-from",
                  "relation.derives-from"
                ]
              },
              "target_ref": {
                "type": "string"
              },
              "qualifiers": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        },
        "declared_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_sufficiency": {
          "const": "not-assessed"
        }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "artifact_type_contract_state",
        "artifact_instance_state",
        "embedded_source_status",
        "embedded_source_lifecycle_state",
        "domain_status",
        "domain_status_vocabulary_ref",
        "realization_binding_refs",
        "runtime_effect_of_admission_decision",
        "runtime_current_state",
        "successor_of_refs",
        "superseded_by_refs"
      ],
      "properties": {
        "artifact_type_contract_state": {
          "const": "admitted-current"
        },
        "artifact_instance_state": {
          "enum": [
            "admitted-current",
            "admitted-historical"
          ]
        },
        "embedded_source_status": {
          "type": "string"
        },
        "embedded_source_lifecycle_state": {
          "type": "string"
        },
        "domain_status": {
          "type": "string"
        },
        "domain_status_vocabulary_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "realization_binding_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runtime_effect_of_admission_decision": {
          "const": "none"
        },
        "runtime_current_state": {
          "const": "not-evaluated"
        },
        "successor_of_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "superseded_by_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "independent_facets": {
      "type": "object",
      "required": [
        "kind",
        "status",
        "evidence_confidence",
        "commitment",
        "provenance",
        "owner",
        "residue"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "evidence_confidence": {
          "const": "not-assessed"
        },
        "commitment": {
          "type": "string"
        },
        "provenance": {
          "const": "digest-bound-source-and-admission-copy"
        },
        "owner": {
          "type": "string"
        },
        "residue": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "project_history_at_foundation_bundle": {
      "type": "object",
      "required": [
        "semantic",
        "governance",
        "event_instances_in_this_bundle"
      ],
      "properties": {
        "semantic": {
          "const": "declared-empty-at-cursor-0"
        },
        "governance": {
          "const": "declared-empty-at-cursor-0"
        },
        "event_instances_in_this_bundle": {
          "const": 0
        }
      },
      "additionalProperties": false
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "project_history_at_bootstrap_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_ref",
        "semantic_cursor",
        "semantic_event_ids",
        "governance_cursor",
        "governance_event_ids",
        "latest_admitted_project_state_ref",
        "next_successor_obligation"
      ],
      "properties": {
        "bundle_ref": {
          "const": "CAL-PROJECT-STATE-BOOTSTRAP-BUNDLE-0072"
        },
        "semantic_cursor": {
          "const": 1
        },
        "semantic_event_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "governance_cursor": {
          "const": 1
        },
        "governance_event_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "latest_admitted_project_state_ref": {
          "const": "project-state:cyberalchemy-v2-to-lab-migration:decision-0071"
        },
        "next_successor_obligation": {
          "type": "string"
        }
      }
    }
  }
}
