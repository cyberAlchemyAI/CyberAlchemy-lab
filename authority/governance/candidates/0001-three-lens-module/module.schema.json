{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/governance-module/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "module_id",
    "name",
    "status",
    "authority_effect",
    "owner_ref",
    "scope_ref",
    "purpose",
    "composition_rule",
    "canonical_definition_refs",
    "lenses",
    "independent_facets",
    "lifecycle_layers",
    "explicit_bridges",
    "projection_contract",
    "current_integration",
    "open_gaps",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "cyberalchemy-lab-governance-module/v1"
    },
    "module_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "authority_effect": {
      "const": "none"
    },
    "owner_ref": {
      "type": "string",
      "minLength": 1
    },
    "scope_ref": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "composition_rule": {
      "type": "string",
      "minLength": 1
    },
    "canonical_definition_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "lenses": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/lens"
      }
    },
    "independent_facets": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/facet"
      }
    },
    "lifecycle_layers": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "explicit_bridges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/bridge"
      }
    },
    "projection_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_authority",
        "replay_source",
        "freshness_rule",
        "incomplete_source_rule",
        "challenge_route"
      ],
      "properties": {
        "kind": {
          "const": "governance-posture-view"
        },
        "source_authority": {
          "const": "none"
        },
        "replay_source": {
          "const": false
        },
        "freshness_rule": {
          "type": "string",
          "minLength": 1
        },
        "incomplete_source_rule": {
          "type": "string",
          "minLength": 1
        },
        "challenge_route": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "current_integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition_and_type_bundle_ref",
        "operational_foundation_bundle_ref",
        "project_bootstrap_bundle_ref",
        "initial_project_state_ref",
        "current_admitted_project_state_ref",
        "project_history_state",
        "first_successor_result",
        "next_successor_obligation"
      ],
      "properties": {
        "definition_and_type_bundle_ref": {
          "type": "string",
          "minLength": 1
        },
        "operational_foundation_bundle_ref": {
          "type": "string",
          "minLength": 1
        },
        "project_bootstrap_bundle_ref": {
          "type": "string",
          "minLength": 1
        },
        "initial_project_state_ref": {
          "type": "string",
          "minLength": 1
        },
        "current_admitted_project_state_ref": {
          "type": "string",
          "minLength": 1
        },
        "project_history_state": {
          "type": "string",
          "minLength": 1
        },
        "first_successor_result": {
          "type": "string",
          "minLength": 1
        },
        "next_successor_obligation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "open_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "state",
          "impact"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "const": "open"
          },
          "impact": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "strings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "lens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "canonical_inputs",
        "output",
        "forbidden_inferences"
      ],
      "properties": {
        "id": {
          "enum": [
            "authority",
            "provenance",
            "lifecycle"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "canonical_inputs": {
          "$ref": "#/$defs/strings"
        },
        "output": {
          "type": "string",
          "minLength": 1
        },
        "forbidden_inferences": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "facet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "meaning"
      ],
      "properties": {
        "id": {
          "enum": [
            "kind",
            "status",
            "evidence_confidence",
            "commitment",
            "provenance",
            "owner",
            "residue"
          ]
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requires",
        "may_change",
        "must_preserve"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "requires": {
          "$ref": "#/$defs/strings"
        },
        "may_change": {
          "$ref": "#/$defs/strings"
        },
        "must_preserve": {
          "$ref": "#/$defs/strings"
        }
      }
    }
  }
}
