{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/artifact-type/v2",
  "title": "CyberAlchemy Lab Artifact Type v2 candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","artifact_type_id","version","name","status","authority_effect","classification","semantic_owner_ref","semantic_definition_refs","semantic_definition_bindings","schema_ref","schema_digest","predecessor","registration_policy","source_direction","self_application","registered_types","claim_ceiling"],
  "properties": {
    "schema_version": {"const":"cyberalchemy-lab-artifact-type/v2"},
    "artifact_type_id": {"const":"cal.artifact-type.artifact-type"},
    "version": {"const":"2.0.0-candidate.1"},
    "name": {"const":"Artifact Type"},
    "status": {"const":"candidate-unadmitted"},
    "authority_effect": {"const":"none"},
    "classification": {"type":"object","additionalProperties":false,"required":["artifact_type_ref","semantic_kind","authority_kind","lifecycle_posture_ref"],"properties":{"artifact_type_ref":{"const":"cal.artifact-type.artifact-type/v2"},"semantic_kind":{"const":"artifact-type"},"authority_kind":{"const":"none"},"lifecycle_posture_ref":{"type":"string","minLength":1}}},
    "semantic_owner_ref": {"type":"string","minLength":1},
    "semantic_definition_refs": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "semantic_definition_bindings": {"type":"array","minItems":1,"items":{"$ref":"#/$defs/definitionBinding"}},
    "schema_ref": {"const":"cal.schema.artifact-type/v2"},
    "schema_digest": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "predecessor": {"type":"object","additionalProperties":false,"required":["artifact_type_ref","artifact_path","artifact_sha256","schema_path","schema_sha256","admission_decision_ref"],"properties":{"artifact_type_ref":{"const":"cal.artifact-type.artifact-type/v1"},"artifact_path":{"type":"string","minLength":1},"artifact_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"schema_path":{"type":"string","minLength":1},"schema_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"admission_decision_ref":{"const":"CAL-DECISION-0013-FOUNDATION-01-ADMISSION"}}},
    "registration_policy": {"type":"object","additionalProperties":false,"required":["legacy_registration_rule","new_registration_rule","candidate_rule","admission_rule","non_effect"],"properties":{"legacy_registration_rule":{"type":"string","minLength":1},"new_registration_rule":{"type":"string","minLength":1},"candidate_rule":{"type":"string","minLength":1},"admission_rule":{"type":"string","minLength":1},"non_effect":{"type":"string","minLength":1}}},
    "source_direction": {"type":"object","additionalProperties":false,"required":["canonical","human_projection","projection_policy","generator_ref","generator_sha256"],"properties":{"canonical":{"const":"artifact.json"},"human_projection":{"const":"ARTIFACT.md"},"projection_policy":{"const":"generated-only"},"generator_ref":{"const":"cal.generator.artifact-type-v2-projection/v1"},"generator_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},
    "self_application": {"type":"object","additionalProperties":false,"required":["mode","bound","non_effect"],"properties":{"mode":{"const":"bounded-successor-self-description"},"bound":{"type":"string","minLength":1},"non_effect":{"type":"string","minLength":1}}},
    "registered_types": {"type":"array","minItems":1,"items":{"$ref":"#/$defs/registeredType"}},
    "claim_ceiling": {"type":"string","minLength":1}
  },
  "$defs": {
    "definitionBinding": {"type":"object","additionalProperties":false,"required":["definition_ref","path","sha256","admission_posture"],"properties":{"definition_ref":{"type":"string","minLength":1},"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"admission_posture":{"enum":["candidate-unadmitted","admitted"]}}},
    "registeredType": {"type":"object","additionalProperties":false,"required":["artifact_type_ref","semantic_kind","semantic_definition_refs","schema_path","schema_selector","schema_sha256","distinct_validation_purpose"],"properties":{"artifact_type_ref":{"type":"string","minLength":1},"semantic_kind":{"type":"string","minLength":1},"semantic_definition_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"schema_path":{"type":"string","minLength":1},"schema_selector":{"type":["string","null"]},"schema_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"distinct_validation_purpose":{"type":"string","minLength":1}}}
  }
}
