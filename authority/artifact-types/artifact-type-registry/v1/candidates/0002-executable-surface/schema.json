{
  "$defs": {
    "direction": {
      "additionalProperties": false,
      "properties": {
        "canonical": {
          "const": "registry.json"
        },
        "generator_ref": {
          "minLength": 1,
          "type": "string"
        },
        "human_projection": {
          "const": "REGISTRY.md"
        },
        "projection_policy": {
          "const": "generated-only"
        }
      },
      "required": [
        "canonical",
        "human_projection",
        "projection_policy",
        "generator_ref"
      ],
      "type": "object"
    },
    "entry": {
      "additionalProperties": false,
      "properties": {
        "admission_decision_ref": {
          "minLength": 1,
          "type": "string"
        },
        "artifact_path": {
          "minLength": 1,
          "type": "string"
        },
        "artifact_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "artifact_type_ref": {
          "minLength": 1,
          "type": "string"
        },
        "instance_discriminator": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "const": "/schema_version"
            },
            "value": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "path",
            "value"
          ],
          "type": "object"
        },
        "lifecycle_state": {
          "enum": [
            "admitted-current",
            "admitted-historical"
          ]
        },
        "schema_path": {
          "minLength": 1,
          "type": "string"
        },
        "schema_selector": {
          "type": [
            "string",
            "null"
          ]
        },
        "schema_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "semantic_definition_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "semantic_kind": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "artifact_type_ref",
        "lifecycle_state",
        "semantic_kind",
        "artifact_path",
        "artifact_sha256",
        "schema_path",
        "schema_selector",
        "schema_sha256",
        "instance_discriminator",
        "semantic_definition_refs",
        "admission_decision_ref"
      ],
      "type": "object"
    }
  },
  "$id": "https://cyberalchemy.local/schemas/artifact-type-registry/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/entry"
      },
      "minItems": 1,
      "type": "array"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "registry_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "cyberalchemy-lab-artifact-type-registry/v1"
    },
    "source_direction": {
      "$ref": "#/$defs/direction"
    },
    "status": {
      "enum": [
        "candidate-unadmitted",
        "candidate-postimage"
      ]
    },
    "version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "registry_id",
    "version",
    "status",
    "authority_effect",
    "owner_ref",
    "entries",
    "source_direction",
    "claim_ceiling"
  ],
  "type": "object"
}
