operation BeginJoinPlan:
  input id UInt64
  input observation JoinObservation
  input join_key JoinIdentity
  output JoinRun
  requires join_key.id == id and join_key.run_ref == observation.run_ref and join_key.workspace == observation.workspace and join_key.operation == observation.original_operation on-false reject join-identity-mismatch
  requires Verified(join_key.evidence,join_key.evidence.subject,observation.workspace,observation.source_cut,Ref("stable-join-identity")) and join_key.evidence.subject.ref == observation.run_ref on-false reject join-identity-unverified
  requires id > 0 and join_key.operation_key > 0 on-false reject join-id-required
  requires observation.phase == JoinPhase.Proposed on-false reject initial-join-phase-required
  requires observation.source_cut == observation.current_source_cut on-false reject join-source-stale
  requires observation.native_outcome == NativeOutcome.Unobserved and observation.publication_outcome == NativeOutcome.Unobserved on-false reject observed-effect-not-an-initial-plan
  transaction CreateInertJoinPlan:
    atomic-participants JoinRun
    create stored JoinRun:
      id <- id
      operation_key <- join_key.operation_key
      run_ref <- observation.run_ref
      workspace <- observation.workspace
      operation_ref <- observation.original_operation
      source_cut <- observation.source_cut
      phase <- JoinPhase.Proposed
      revision <- 1
    on-unique-conflict reject join-plan-identity-conflict
    on-proven-rollback fail join-plan-rolled-back
    on-unknown-commit fail join-plan-outcome-unknown
  return stored
entry Lab.SharedDesign.BeginJoinPlanEntry:
  invokes Lab.SharedDesign.BeginJoinPlan
  interaction request-response
  access:
    authenticated customer
    permission lab-design.plan
    auth-resource lab-design
    auth-action plan
    auth-scope candidate-design-only

operation ValidateJoinTransition:
  input phase JoinPhase
  input signal JoinSignal
  output Bool
  on JoinLifecycle.propose(phase,signal).tag != "transition" reject invalid-join-transition
  return true

rule JoinOutcomeAllowed:
  input value JoinTransition
  expression (value.signal == JoinSignal.SelectContext and (value.observed_outcome == NativeOutcome.Unobserved)) or (value.signal == JoinSignal.PrepareDraft and (value.observed_outcome == NativeOutcome.Unobserved)) or (value.signal == JoinSignal.RequestReview and (value.observed_outcome == NativeOutcome.Unobserved)) or (value.signal == JoinSignal.ObserveSemanticAcceptance and (value.observed_outcome == NativeOutcome.Committed)) or (value.signal == JoinSignal.ObservePermission and (value.observed_outcome == NativeOutcome.Committed)) or (value.signal == JoinSignal.ObserveNativeUnknown and (value.observed_outcome == NativeOutcome.Unknown)) or (value.signal == JoinSignal.ObserveNativeCommit and (value.observed_outcome == NativeOutcome.Committed or value.observed_outcome == NativeOutcome.Replayed)) or (value.signal == JoinSignal.ObserveRefusal and (value.observed_outcome == NativeOutcome.Refused)) or (value.signal == JoinSignal.PreparePublication and (value.observed_outcome == NativeOutcome.Unobserved)) or (value.signal == JoinSignal.ObservePublicationUnknown and (value.observed_outcome == NativeOutcome.Unknown)) or (value.signal == JoinSignal.ObservePublication and (value.observed_outcome == NativeOutcome.Committed or value.observed_outcome == NativeOutcome.Replayed)) or (value.signal == JoinSignal.RequestSourceTransition and (value.observed_outcome == NativeOutcome.Unobserved)) or (value.signal == JoinSignal.ObserveSourceTransition and (value.observed_outcome == NativeOutcome.Committed or value.observed_outcome == NativeOutcome.Replayed))

operation AssessJoinTransition:
  input value JoinTransition
  output Bool
  on value.revision == 0 or value.revision != value.observed_revision reject join-revision-conflict
  on value.observed_operation != value.join_key.operation or value.observed_run != value.join_key.run_ref or value.observed_phase != value.phase or value.observed_signal != value.signal reject join-observation-mismatch
  on value.signal == JoinSignal.ObserveRefusal and value.observed_outcome != NativeOutcome.Refused reject join-refusal-unproven
  on not JoinOutcomeAllowed(value) reject join-outcome-incompatible
  on not Verified(value.evidence,value.past_fact,value.join_key.workspace,value.cut,Ref("join-transition")) reject join-transition-unverified
  on JoinLifecycle.propose(value.phase,value.signal).tag != "transition" reject invalid-join-transition
  return true
