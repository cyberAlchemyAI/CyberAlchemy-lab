entity JoinRun:
  id UInt64
  operation_key UInt64
  run_ref Ref
  workspace Ref
  operation_ref Ref
  source_cut Digest
  phase JoinPhase
  revision UInt64
  identity id
  unique operation_key
query ReadJoinRun:
  input id UInt64
  input workspace Ref
  source row JoinRun
  output optional<JoinRun>
  where row.id == id and row.workspace == workspace
  project row
  on-missing return none
  on-unavailable fail join-store-unavailable
interface FuturePortContracts:
  kind bounded-schema
  exposes DefinitionReview, CompatibilityCase, ExecutionContext, CreationPlan, NativeReceipt, PublicationCase, LifecycleCase, ConstructionCase, ConstructionCompletion

operation ReviewFiveDefinitions:
  input expected List<Binding,5>
  input reviews List<DefinitionReview,5>
  output List<Decision,5>
  on not FiveTargetsMatch(expected,reviews) or not ReviewTargetsUnique(reviews) reject five-exact-definition-targets-required
  return map(reviews,item:DefinitionReview => DefinitionReviewPlan(item))

entry Lab.SharedDesign.ReviewFiveDefinitionsEntry:
  invokes Lab.SharedDesign.ReviewFiveDefinitions
  interaction request-response
  access:
    authenticated customer
    permission lab-design.inspect
    auth-resource lab-design
    auth-action inspect
    auth-scope candidate-design-only

operation SelectCompatibility:
  input value CompatibilityCase
  output Decision
  return CarrierCompatibility(value)

entry Lab.SharedDesign.SelectCompatibilityEntry:
