{
  "stages": [
    "definitions",
    "artifacts",
    "ontology",
    "business-system bridge ontology",
    "system-ontology",
    "AlchLang",
    "generation"
  ],
  "handoffs": [
    {
      "from": "definitions",
      "to": "artifacts",
      "input": "DEFINITIONS.json",
      "output": "CONTRACTS.json"
    },
    {
      "from": "artifacts",
      "to": "ontology",
      "input": "CONTRACTS.json",
      "output": "ONTOLOGY.json"
    },
    {
      "from": "ontology",
      "to": "business-system bridge ontology",
      "input": "ONTOLOGY.json",
      "output": "BRIDGE.json"
    },
    {
      "from": "business-system bridge ontology",
      "to": "system-ontology",
      "input": "BRIDGE.json",
      "output": "SYSTEM.json"
    },
    {
      "from": "system-ontology",
      "to": "AlchLang",
      "input": "SYSTEM.json",
      "output": "../../..//implementation/lab-runtime/alchlang/shared-records/design.alch"
    },
    {
      "from": "AlchLang",
      "to": "generation",
      "input": "../../..//implementation/lab-runtime/alchlang/shared-records/design.alch",
      "output": "GENERATION-RECEIPT.json"
    }
  ]
}
