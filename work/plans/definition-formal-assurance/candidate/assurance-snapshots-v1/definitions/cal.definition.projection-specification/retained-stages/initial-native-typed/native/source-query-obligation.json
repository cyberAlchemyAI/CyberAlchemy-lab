{"authority_effect":"none","obligations":[{"actual_outcome_target_in_T":false,"clause_id":"PS-001","end_character":290,"excerpt":"View-bearing concept is not a vault node type, not an ontology branch by\nitself, not a lifecycle state, not a promotion state, and not a reason to create\na new tree for every term. It names the threshold where a concept needs a\ngoverned view because ordinary prose is no longer safe enough.","excerpt_sha256":"9bae4d24dc120bd3f500b21f6984be87f1339493d612793e5772c44f1af7a424","necessary_declaration_guard_in_T":true,"query_id":"Concept-not-ActualOwnerFidelity","selected_in_T":false,"selector":"/boundaries/0","source":{"definition_id":"cal.definition.projection-specification","path":"evidence/migrations/cyberalchemy-v2-to-lab/candidates/0004-artifact-reconstruction-pipeline/layers/l1-semantic-repeatability/definitions/projection-specification/v1/definition.json","sha256":"42cff2435ac4e732bf0ea45a2e0f5d6fcdf2921f17b18bbd1b1adcc4e643eb24","version_ref":"cal.definition.projection-specification@1.0.0-candidate.1"},"start_character":0},{"actual_outcome_target_in_T":false,"clause_id":"PS-002","end_character":251,"excerpt":"Candidate Definition reconstructed from an accepted normalization scaffold and exact CyberAlchemy-v2 source sections. It is not admitted and grants no implementation, migration, registry, publication, release, deployment, or external-effect authority.","excerpt_sha256":"38515a26e8d8fd2e37df0bb358b20a1c2dc85985c4a3ff6126fe06189e982db9","necessary_declaration_guard_in_T":false,"query_id":"Concept-not-ActualOwnerFidelity","selected_in_T":false,"selector":"/claim_ceiling","source":{"definition_id":"cal.definition.projection-specification","path":"evidence/migrations/cyberalchemy-v2-to-lab/candidates/0004-artifact-reconstruction-pipeline/layers/l1-semantic-repeatability/definitions/projection-specification/v1/definition.json","sha256":"42cff2435ac4e732bf0ea45a2e0f5d6fcdf2921f17b18bbd1b1adcc4e643eb24","version_ref":"cal.definition.projection-specification@1.0.0-candidate.1"},"start_character":0},{"actual_outcome_target_in_T":false,"clause_id":"PS-003","end_character":282,"excerpt":"Use view-bearing concept when a concept starts carrying enough work that future\nagents need a dedicated lens over its meaning, system structure, run evidence,\nresidue, or promotion status. The view should make the concept inspectable and\nusable without loading the whole repository.","excerpt_sha256":"21919be6958210eb19fce4a78449f6c269f35c5fadbdf579a87bbb3d99b78912","necessary_declaration_guard_in_T":true,"query_id":"Concept-not-ActualOwnerFidelity","selected_in_T":false,"selector":"/scope/applicability","source":{"definition_id":"cal.definition.projection-specification","path":"evidence/migrations/cyberalchemy-v2-to-lab/candidates/0004-artifact-reconstruction-pipeline/layers/l1-semantic-repeatability/definitions/projection-specification/v1/definition.json","sha256":"42cff2435ac4e732bf0ea45a2e0f5d6fcdf2921f17b18bbd1b1adcc4e643eb24","version_ref":"cal.definition.projection-specification@1.0.0-candidate.1"},"start_character":0},{"actual_outcome_target_in_T":false,"clause_id":"PS-004","end_character":22,"excerpt":"scope.shared-authority","excerpt_sha256":"855b1c3e4e83ef160b03e88d06128fed58cacabf57a2880c29ec23451ef3264b","necessary_declaration_guard_in_T":false,"query_id":"Concept-not-ActualOwnerFidelity","selected_in_T":false,"selector":"/scope/authority_scope_ref","source":{"definition_id":"cal.definition.projection-specification","path":"evidence/migrations/cyberalchemy-v2-to-lab/candidates/0004-artifact-reconstruction-pipeline/layers/l1-semantic-repeatability/definitions/projection-specification/v1/definition.json","sha256":"42cff2435ac4e732bf0ea45a2e0f5d6fcdf2921f17b18bbd1b1adcc4e643eb24","version_ref":"cal.definition.projection-specification@1.0.0-candidate.1"},"start_character":0},{"actual_outcome_target_in_T":false,"clause_id":"PS-005","end_character":78,"excerpt":"Admission, activation, publication, release, d