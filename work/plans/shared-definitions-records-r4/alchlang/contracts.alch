module Lab.SharedDesign.Contracts version 1
value-object Ref:
  carrier String
  utf8-bytes 1..256
  unicode-scalars 1..256
value-object Digest:
  carrier String
  utf8-bytes 64..64
  unicode-scalars 64..64
  pattern "^[a-f0-9]{64}$"
value-object Binding:
  ref Ref
  sha256 Digest
  bytes UInt64

enum Carrier:
  value V1
  value V2
enum Disposition:
  value Pending
  value Accepted
  value Rejected
  value Revise
  value Deferred
enum Decision:
  value CandidateOnly
  value NeedsEvidence
  value NeedsContextUpdate
  value NeedsOwnerReview
  value InvalidEvidence
  value Rejected
  value Stale
  value HistoricalRead
  value CandidateV2
  value CandidateSuccessor
  value NeedsRelationReview
  value NeedsMeaningChange
  value IdentityRewriteRefused
  value AutomaticDowngradeRefused
  value UnsupportedRelation
  value NeedsHost
  value NeedsCustody
  value NeedsProject
  value WrongScope
  value ContextPlanReady
  value NeedsRouteWiring
  value DraftPlanReady
  value NeedsRegistryContract
  value NeedsPermission
  value PreserveRefusal
  value PreserveCompleted
  value NeedsSourceTransition
  value InspectOriginalOperation
  value NeedsNativeCommit
  value NeedsPublicationRebase
  value PublicationPlanReady
  value PreservePublicationReceipt
  value NeedsImpactClosure
  value LifecyclePlanReady
  value NeedsConstructionCompatibility
  value NeedsCoverage
  value NeedsCompletionEvidence
  value GenerationEntryPlanReady
  value ConformancePlanReady

enum CompatibilityIntent:
  value ReadRetained
  value CreateV2
  value Upgrade
  value Downgrade
value-object DispositionEvidence:
  target Binding
  previous optional<Binding>
  owner Ref
  scope Ref
  source_cut Digest
  outcome Disposition
  role_assignment optional<Binding>
  verification_receipt optional<Binding>
value-object DefinitionReview:
  target Binding
  expected_owner Ref
  scope Ref
  source_cut Digest
  source_current Bool
  fields_receipt optional<Binding>
  consumer_bindings_current Bool
  disposition optional<DispositionEvidence>
value-object RelationMapping:
  source_edge Binding
  target_edge Binding
  old_kind Ref
  new_kind Ref
  review Binding
value-object CompatibilityCase:
  expected_owner Ref
  expected_scope Ref
  cut Digest
  fidelity Verification
  source_edges List<Binding,24>
  target_edges List<Binding,24>
  intent CompatibilityIntent
  source_carrier Carrier
  target_carrier Carrier
  source_body Binding
  target_body Binding
  selected_schema Binding
  observed_schema Binding
  schema_receipt optional<Binding>
  target_schema_valid Bool
  carrier_current Bool
  carrier_admission optional<Binding>
  source_normative Digest
  target_normative Digest
  source_relations List<Ref,24>
  target_relations List<Ref,24>
  allowed_target_relations List<Ref,24>
  relation_mappings List<RelationMapping,24>
  lineage optional<Binding>
  meaning_review optional<DispositionEvidence>

enum WorkspaceKind:
  value Product
  value Project
value-object ExecutionContext:
  workspace Ref
  kind WorkspaceKind
  project optional<Ref>
  work optional<Ref>
  linked_projects List<Ref,24>
  runtime_ref Ref
  host optional<Binding>
  host_project_only Bool
  custody optional<Binding>
  store optional<Ref>
  source_cut Digest
  current_source_cut Digest
  effect_requested Bool

enum CreationKind:
  value Definition
  value ArtifactType
  value Record
value-object CreationCase:
  kind CreationKind
  context_decision Decision
  original Binding
  selected_carrier Ref
  verification_receipt optional<Binding>
  target_scope Ref
  source_cut Digest
  public_route_compiled Bool
value-object CreationPlan:
  decision Decision
  entry_ref Ref
  original Binding
  source_cut Digest
  unsigned Bool
  authority_effect literal "none"

enum NativeOutcome:
  value Unobserved
  value Committed
  value Replayed
  value Unknown
  value Refused
  value NotDispatched
value-object NativeReceipt:
  head Digest
  workspace Ref
  operation_ref Ref
  proposal Binding
  targets Digest
  source_cut Digest
  outcome NativeOutcome
  proof Binding
value-object PublicationCase:
  expected_selector Binding
  observed_selector Binding
  snapshot AdmissionSnapshot
  bundle Binding
  bundle_review Verification
  canonical_permission optional<Verification>
  observed_receipt optional<PublicationObservation>
  native_head Digest
  workspace Ref
  source_cut Digest
  expected_registry Binding
  observed_registry Binding
  proposed_registry Binding
  expected_targets Digest
  proposal Binding
  operation_ref Ref
  target_bodies List<Binding,64>
  semantic_reviews List<DefinitionReview,64>
  registry_contract_current Bool
  registry_contract optional<Binding>
  permission optional<Binding>
  permission_proposal optional<Binding>
  native_receipt optional<NativeReceipt>
  publication_receipt optional<Binding>
  published_postimage optional<Binding>

enum JoinPhase:
  value Proposed
  value ContextSelected
  value DraftPrepared
  value AwaitingSemanticReview
  value AwaitingPermission
  value ReadyToDispatch
  value NativeUnknown
  value LocalCommitted
  value PublicationPrepared
  value PublicationUnknown
  value CanonicalPublished
  value SourceTransitionPending
  value Completed
  value Refused
enum JoinSignal:
  value SelectContext
  value PrepareDraft
  value RequestReview
  value ObserveSemanticAcceptance
  value ObservePermission
  value ObserveNativeUnknown
  value ObserveNativeCommit
  value PreparePublication
  value ObservePublicationUnknown
  value ObservePublication
  value RequestSourceTransition
  value ObserveSourceTransition
  value ObserveRefusal
value-object JoinObservation:
  terminal_receipt optional<Verification>
  published_snapshot optional<Binding>
  published_verification optional<Verification>
  run_ref Ref
  workspace Ref
  phase JoinPhase
  source_cut Digest
  current_source_cut Digest
  original_operation Ref
  native_outcome NativeOutcome
  publication_outcome NativeOutcome

enum LifecycleIntent:
  value Revise
  value Withdraw
  value RepresentationUpgrade
value-object LifecycleCase:
  reviewed_current Binding
  operation Ref
  reviewed_operation Ref
  proposal Binding
  reviewed_intent LifecycleIntent
  reviewed_successor optional<Binding>
  expected_owner Ref
  scope Ref
  transition_review Verification
  impact_review Verification
  permission_review optional<Verification>
  intent LifecycleIntent
  current Binding
  successor optional<Binding>
  owner_review optional<DispositionEvidence>
  source_cut Digest
  closure_cut Digest
  closure_receipt optional<Binding>
  unresolved_dependents UInt64
  consumer_manifest optional<Binding>
  truncated Bool
  permission optional<Binding>

enum Stage:
  value Definitions
  value Artifacts
  value Business
  value Bridge
  value System
  value AlchLang
  value Generation
value-object StageSubject:
  stage Stage
  subject Binding
  source_cut Digest
value-object StageHandoff:
  source_stage Stage
  target_stage Stage
  input_subject Binding
  output_subject Binding
  source_cut Digest
  contract Binding
value-object ConstructionCase:
  selected_targets List<Binding,64>
  admitted_targets List<Binding,64>
  review_targets List<Binding,24>
  selection Binding
  selection_review Verification
  specifications List<CheckSpecification,100>
  source_cut Digest
  stages List<StageSubject,7>
  handoffs List<StageHandoff,6>
  required_obligations List<Ref,100>
  specified_checks List<Ref,100>
  unresolved_mappings UInt64
  definitions List<DefinitionReview,24>
  definition_targets List<Binding,64>
  definition_selection_receipt optional<Binding>
  construction_compatibility optional<Binding>
  prototype_selection optional<Binding>
  language_selection optional<Binding>
  native_closure optional<Binding>
  resolved_capabilities_receipt optional<Binding>
  effects_requested Bool
  permission optional<Binding>
value-object ConstructionCompletion:
  assessed_entry Binding
  expected_entry Binding
  entry_receipt EntryReceipt
  assessment Verification
  results List<CheckResult,100>
  entry_decision Decision
  expected_source_cut Digest
  observed_source_cut Digest
  output_manifest optional<Binding>
  assessed_output optional<Binding>
  independent_assessment optional<Binding>
  independence_review optional<Binding>
  required_checks List<Ref,100>
  passed_checks List<Ref,100>
  failed_checks UInt64
  unknown_checks UInt64

value-object Verification:
  subject Binding
  scope Ref
  cut Digest
  predicate Ref
  issuer Ref
  policy Binding
  proof Binding
value-object PublicationObservation:
  selector_before Binding
  selected_source Binding
  operation Ref
  bundle Binding
  predecessor Binding
  postimage Binding
  evidence Verification
value-object CheckSpecification:
  obligation Ref
  source Binding
  executor Binding
  fixture Binding
value-object EntryReceipt:
  entry Binding
  selection Binding
  specifications List<CheckSpecification,100>
  evidence Verification
value-object CheckResult:
  specification CheckSpecification
  output Binding
  passed Bool

value-object AdmissionSnapshot:
  expected_selector Binding
  bundle Binding
  operation Ref
  workspace Ref
  cut Digest
  expected_head Digest
  predecessor Binding
  registry Binding
  index Binding
  source Binding
  targets Digest
  draft_only Bool
  readers Verification
  migration Verification
value-object JoinIdentity:
  operation_key UInt64
  id UInt64
  run_ref Ref
  workspace Ref
  operation Ref
  evidence Verification
value-object JoinTransition:
  observed_operation Ref
  observed_run Ref
  observed_phase JoinPhase
  observed_signal JoinSignal
  observed_outcome NativeOutcome
  join_key JoinIdentity
  phase JoinPhase
  signal JoinSignal
  revision UInt64
  observed_revision UInt64
  cut Digest
  past_fact Binding
  evidence Verification
