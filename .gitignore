# Operating-system and editor residue
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Local environment and credentials
.env
.env.*
!.env.example

# Common generated/runtime residue
node_modules/
__pycache__/
*.py[cod]
target/
dist/
build/
coverage/

# Lean compiler outputs and local build cache; retain source and verification records
