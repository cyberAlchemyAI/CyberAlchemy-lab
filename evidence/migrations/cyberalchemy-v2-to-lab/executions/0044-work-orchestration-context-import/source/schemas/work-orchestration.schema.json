{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/private/schemas/work-orchestration/v1",
  "title": "CyberAlchemy v2 bounded composite work business ontology",
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "text": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "selector"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^CAP-SEL-WORK-ORCH-"},
        "selector": {"$ref": "#/$defs/text"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "package_id", "ontology_id", "title", "ontology_type", "branch", "materialization", "package_root", "package_owner", "meaning_owner", "product_ref", "product_capability_ref", "visibility", "candidate_status", "construction_stage", "authority_effect", "source_registry", "definition_registry", "product_capability", "product_capability_support", "node_registry", "relation_registry", "residue_registry", "schema_path", "validator_path", "blocked_outputs"],
      "properties": {
        "schema_ref": {"const": "schemas/work-orchestration.schema.json#/$defs/profile"},
        "schema_version": {"const": "cav2-work-orchestration-profile/v1"},
        "package_id": {"const": "cav2.work-orchestration"},
        "ontology_id": {"const": "cav2.work-orchestration.business"},
        "title": {"$ref": "#/$defs/text"},
        "ontology_type": {"const": "business-domain"},
        "branch": {"const": "business"},
        "materialization": {"const": "package-required"},
        "package_root": {"const": "cyberAlchemy-v2/work-orchestration"},
        "package_owner": {"const": "CyberAlchemy v2 work-orchestration capability owner"},
        "meaning_owner": {"$ref": "#/$defs/text"},
        "product_ref": {"const": "CA2-PRODUCT-CYBERALCHEMY"},
        "product_capability_ref": {"const": "CA2-CAP-EXECUTE-BOUNDED-COMPOSITE-WORK"},
        "visibility": {"const": "private"},
        "candidate_status": {"const": "candidate"},
        "construction_stage": {"const": "business-ontology-candidate"},
        "authority_effect": {"const": "none"},
        "source_registry": {"const": "sources.json"},
        "definition_registry": {"const": "definitions.json"},
        "product_capability": {"const": "product-capability.json"},
        "product_capability_support": {"const": "product-capability-support.json"},
        "node_registry": {"const": "nodes.json"},
        "relation_registry": {"const": "relations.json"},
        "residue_registry": {"const": "residue.json"},
        "schema_path": {"const": "schemas/work-orchestration.schema.json"},
        "validator_path": {"const": "scripts/validate.py"},
        "blocked_outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "path", "selection_kind", "selector", "sha256", "posture", "owner_route"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^CAP-SEL-WORK-ORCH-"},
        "path": {"$ref": "#/$defs/text"},
        "selection_kind": {"enum": ["whole-file", "markdown-section"]},
        "selector": {"$ref": "#/$defs/text"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "posture": {"$ref": "#/$defs/text"},
        "owner_route": {"$ref": "#/$defs/text"}
      }
    },
    "sourceRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "sources"],
      "properties": {
        "schema_ref": {"const": "schemas/work-orchestration.schema.json#/$defs/sourceRegistry"},
        "schema_version": {"const": "cav2-work-orchestration-sources/v1"},
        "sources": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/source"}}
      }
    },
    "canonicalBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition_ref", "source_ref", "selector_sha256", "local_use", "authority_effect"],
      "properties": {
        "definition_ref": {"enum": ["CAV2-D65", "CAV2-D67"]},
        "source_ref": {"type": "string", "pattern": "^CAP-SEL-WORK-ORCH-"},
        "selector_sha256": {"$ref": "#/$defs/sha256"},
        "local_use": {"$ref": "#/$defs/text"},
        "authority_effect": {"const": "none"}
      }
    },
    "localTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term_id", "term", "meaning", "owner_route", "canonical_status", "forbidden_collapse"],
      "properties": {
        "term_id": {"type": "string", "pattern": "^WO-TERM-"},
        "term": {"$ref": "#/$defs/text"},
        "meaning": {"$ref": "#/$defs/text"},
        "owner_route": {"$ref": "#/$defs/text"},
        "canonical_status": {"const": "package-local-candidate"},
        "forbidden_collapse": {"$ref": "#/$defs/text"}
      }
    },
    "definitionRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "canonical_bindings", "local_terms", "authority_effect"],
      "properties": {
        "schema_ref": {"const": "schemas/work-orchestration.schema.json#/$defs/definitionRegistry"},
        "schema_version": {"const": "cav2-work-orchestration-definitions/v1"},
        "canonical_bindings": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/canonicalBinding"}},
        "local_terms": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/localTerm"}},
        "authority_effect": {"const": "none"}
      }
    },
    "realizationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_id", "state", "candidate_ref", "system_ontology_ref", "implementation_ref", "blockers", "authority_effect"],
      "properties": {
        "binding_id": {"const": "CA2-CAP-BIND-WORK-ORCHESTRATION-UNSELECTED"},
        "state": {"const": "not_evaluable"},
        "candidate_ref": {"type": ["string", "null"]},
        "system_ontology_ref": {"type": ["string", "null"]},
        "implementation_ref": {"type": ["string", "null"]},
        "blockers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "authority_effect": {"const": "none"}
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation_id", "statement", "state"],
      "properties": {
        "obligation_id": {"type": "string", "pattern": "^WO-OBL-"},
        "statement": {"$ref": "#/$defs/text"},
        "state": {"enum": ["model-checkable", "not_evaluable", "blocked"]}
      }
    },
    "obligationRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_id", "aggregate_state", "obligations"],
      "properties": {
        "registry_id": {"const": "CA2-CAP-OBLIGATIONS-BOUNDED-COMPOSITE-WORK"},
        "aggregate_state": {"const": "not_evaluable"},
        "obligations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/obligation"}}
      }
    },
    "productCapabilitySupport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "capability_ref", "instance_status", "adoption_state", "construction_stage", "realization_binding", "obligation_registry", "authority_effect"],
      "properties": {
        "schema_ref": {"const": "schemas/work-orchestration.schema.json#/$defs/productCapabilitySupport"},
        "schema_version": {"const": "cav2-work-orchestration-product-capability-support/v1"},
        "capability_ref": {"const": "CA2-CAP-EXECUTE-BOUNDED-COMPOSITE-WORK"},
        "instance_status": {"const": "candidate"},
        "adoption_state": {"const": "not-adopted"},
        "construction_stage": {"const": "business-ontology-candidate"},
        "realization_binding": {"$ref": "#/$defs/realizationBinding"},
        "obligation_registry": {"$ref": "#/$defs/obligationRegistry"},
        "authority_effect": {"const": "none"}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "role", "plain_language", "claim", "source_refs", "owner_route", "candidate_status", "authority_effect", "forbidden_collapse", "open_questions"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"$ref": "#/$defs/text"},
        "role": {"enum": ["product_projection", "product_capability", "actor", "outcome", "contract", "policy", "domain_concept", "realization_candidate"]},
        "plain_language": {"$ref": "#/$defs/text"},
        "claim": {"$ref": "#/$defs/text"},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}},
        "owner_route": {"$ref": "#/$defs/text"},
        "candidate_status": {"$ref": "#/$defs/text"},
        "authority_effect": {"const": "none"},
        "forbidden_collapse": {"$ref": "#/$defs/text"},
        "open_questions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
      }
    },
    "nodeRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "nodes"],
      "properties": {
        "schema_ref": {"const": "schemas/work-orchestration.schema.json#/$defs/nodeRegistry"},
        "schema_version": {"const": "cav2-work-orchestration-nodes/v1"},
        "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}}
      }
    },
    "relationType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source_roles", "target_roles", "meaning", "forbidden_collapse"],
      "properties": {
        "type": {"type": "string", "pattern": "^[a-z][a-z_]*$"},
        "source_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "target_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "meaning": {"$ref": "#/$defs/text"},
        "forbidden_collapse": {"$ref": "#/$defs/text"}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "source", "target", "source_refs", "owner_route", "authority_effect", "claim_limit"],
      "properties": {
        "id": {"type": "string", "pattern": "^WO-REL-"},
        "type": {"type": "string", "pattern": "^[a-z][a-z_]*$"},
        "source": {"$ref": "#/$defs/id"},
        "target": {"$ref": "#/$defs/id"},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}},
        "owner_route": {"$ref": "#/$defs/text"},
        "authority_effect": {"const": "none"},
        "claim_limit": {"$ref": "#/$defs/text"}
      }
    },
    "relationRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "relation_vocabulary", "relations", "authority_effect"],
      "properties": {
        "schema_ref": {"const": "schemas/work-orchestration.schema.json#/$defs/relationRegistry"},
        "schema_version": {"const": "cav2-work-orchestration-relations/v1"},
        "relation_vocabulary": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/relationType"}},
        "relations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/relation"}},
        "authority_effect": {"const": "none"}
      }
    },
    "residue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["residue_id", "status", "description", "owner_route", "next_action", "subject_refs", "evidence_refs", "authority_effect"],
      "properties": {
        "residue_id": {"type": "string", "pattern": "^CAP-RES-WORK-ORCH-"},
        "status": {"enum": ["open", "blocked", "deferred", "closed"]},
        "description": {"$ref": "#/$defs/text"},
        "owner_route": {"$ref": "#/$defs/text"},
        "next_action": {"$ref": "#/$defs/text"},
        "subject_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^CAP-SEL-WORK-ORCH-"}},
        "authority_effect": {"const": "none"}
      }
    },
    "residueRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "residue", "authority_effect"],
      "properties": {
        "schema_ref": {"const": "schemas/work-orchestration.schema.json#/$defs/residueRegistry"},
        "schema_version": {"const": "cav2-work-orchestration-residue/v1"},
        "residue": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/residue"}},
        "authority_effect": {"const": "none"}
      }
    }
  }
}
