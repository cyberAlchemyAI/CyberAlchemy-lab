  "relation_vocabulary": [
    {"type": "offers", "source_roles": ["product_projection"], "target_roles": ["product_capability"], "meaning": "The Product proposes one stable capability outcome.", "forbidden_collapse": "Does not adopt or realize the capability."},
    {"type": "enables", "source_roles": ["product_capability"], "target_roles": ["outcome"], "meaning": "The capability makes one bounded outcome possible.", "forbidden_collapse": "Does not prove product value or implementation."},
    {"type": "serves", "source_roles": ["product_capability"], "target_roles": ["actor"], "meaning": "The capability names a participant or consumer.", "forbidden_collapse": "Does not grant that actor authority."},
    {"type": "accepts", "source_roles": ["product_capability"], "target_roles": ["contract"], "meaning": "The capability consumes one declared contract.", "forbidden_collapse": "Does not accept any concrete instance."},
    {"type": "produces", "source_roles": ["product_capability"], "target_roles": ["contract"], "meaning": "The capability exposes one declared output boundary.", "forbidden_collapse": "Does not claim a runtime produced an output."},
    {"type": "governed_by", "source_roles": ["product_capability", "realization_candidate"], "target_roles": ["policy"], "meaning": "The subject must preserve one policy boundary.", "forbidden_collapse": "Does not activate enforcement."},
    {"type": "specifies", "source_roles": ["contract"], "target_roles": ["domain_concept"], "meaning": "A contract requires or exposes one concept.", "forbidden_collapse": "Does not instantiate the concept."},
    {"type": "contains", "source_roles": ["domain_concept"], "target_roles": ["domain_concept"], "meaning": "One structural concept contains another by declared composition.", "forbidden_collapse": "Does not transfer authority or ownership."},
    {"type": "instantiates", "source_roles": ["domain_concept"], "target_roles": ["domain_concept"], "meaning": "A run invokes one exact definition.", "forbidden_collapse": "Does not mutate the definition."},
    {"type": "records", "source_roles": ["domain_concept"], "target_roles": ["domain_concept"], "meaning": "A run contributes accepted structural history.", "forbidden_collapse": "Does not make structural history domain truth."},
    {"type": "derived_from", "source_roles": ["domain_concept"], "target_roles": ["domain_concept"], "meaning": "A projection is rebuilt from exact accepted inputs.", "forbidden_collapse": "Does not make the projection authoritative source."},
    {"type": "crosses", "source_roles": ["domain_concept"], "target_roles": ["policy"], "meaning": "An adapter must respect one explicit policy boundary.", "forbidden_collapse": "Does not grant an effect or credential."},
    {"type": "routes_through", "source_roles": ["domain_concept"], "target_roles": ["domain_concept"], "meaning": "Structural progress depends on a work-owned gate result.", "forbidden_collapse": "Does not make routing own the semantic verdict."},
    {"type": "may_be_realized_by", "source_roles": ["product_capability"], "target_roles": ["realization_candidate"], "meaning": "A proposal may later realize part of the capability after separate gates.", "forbidden_collapse": "Does not select, bind, adopt, or prove the realization."}
