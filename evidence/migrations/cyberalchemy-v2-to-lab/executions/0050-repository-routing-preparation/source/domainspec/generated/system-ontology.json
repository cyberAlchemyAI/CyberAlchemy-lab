        "required_conditions": [
          "entry route is always CA2-ROUTE-ENTRY",
          "exactly one objective route is selected",
          "every authority root belongs to cyberAlchemy-v2",
          "every fallback route is null",
          "blocked capabilities remain blocked",
          "native operations cannot expand route authority",
          "resolve user-cited names through the project index before asking for paths",
          "lookup returns resolved, ambiguous, not_found, or not_evaluable; it never selects the first ambiguous match",
          "lookup source currency checks only selected entries; unrelated source drift cannot block a lookup",
          "source discovery never grants implementation, project registration, or external-effect authority",
          "explicit domainspec-core lookup selects CA2-ROUTE-DOMAINSPEC-CORE and the separate bounded inventory",
          "physical source mounts select exactly the umbrella or sibling layout without search or missing-file fallback",
          "logical cyberAlchemy-v2 sources remain inside the local checkout; external compiler sources retain their declared mount and source digests",
          "ARE CLI evaluates the verified registry and returns non-authorizing decisions with caller session/request bindings",
          "context, effect and continuation require a current route receipt; neither receipts nor caller metadata authenticate approvals",
          "host hooks and MCP remain deferred stages; the local CLI neither dispatches effects nor creates durable repository sessions",
          "prompt hook projection remains advisory, excludes raw prompt text from developer context, and does not prove native host delivery or grant effects",
          "tool events require their originating in-memory request binding; Stop observations never certify completion; native terminal status is transport evidence only"
        ],
        "missing_route_behavior": "select CA2-ROUTE-AMBIGUOUS and request a decision",
        "missing_capability_behavior": "block without fallback",
