{
  "acceptance_mapping": [
    {
      "id": "KEP-HOST-RULE-WALLET-SIGNATURE",
      "statement": "Every mutating participant command verifies the exact canonical message against that Knowledge Identity's registered wallet key."
    },
    {
      "id": "KEP-HOST-RULE-CLIENT-SECRETS",
      "statement": "Plaintext, content keys, wallet secrets and encryption private keys never enter the service API or persisted state."
    },
    {
      "id": "KEP-HOST-RULE-CIPHERTEXT-IDENTITY",
      "statement": "Ciphertext and every recipient envelope must match their declared SHA-256 byte identity before persistence."
    },
    {
      "id": "KEP-HOST-RULE-PREPARED-NOT-ACTIVE",
      "statement": "Preparing a grant does not add the recipient, advance revision or permit recipient retrieval."
    },
    {
      "id": "KEP-HOST-RULE-FINALIZED-ONLY",
      "statement": "A grant or reissue becomes active only after a matching transaction is independently observed as finalized on Solana Devnet."
    },
    {
      "id": "KEP-HOST-RULE-PRESERVE-A",
      "statement": "Grant activation adds B without removing A or any other current owner."
    },
    {
      "id": "KEP-HOST-RULE-ENVELOPE-ISOLATION",
      "statement": "An access response contains only the authenticated current owner's active envelope."
    },
    {
      "id": "KEP-HOST-RULE-REISSUE-PRESERVATION",
      "statement": "Reissue changes only B's binding and envelope plus revision; owners, artifact version, policy and epoch stay fixed."
    },
    {
      "id": "KEP-HOST-RULE-NO-PRICE",
      "statement": "All hosted grants have zero knowledge consideration; network and hosting costs remain separate observations."
    },
    {
      "id": "KEP-HOST-RULE-RECOVERY-HONESTY",
      "statement": "Logical SQL layers are not claimed as independent backups; VPS readiness requires a verified off-host encrypted archive restore."
    }
  ],
