{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_authorized": {
      "const": false
    },
    "authority_effect": {
      "const": "none"
    },
    "authorization_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "caller_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "entitlement_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "generator_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "language": {
      "enum": [
        "typescript",
        "python",
        "rust"
      ]
    },
    "meta_type_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "node_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "project_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "project_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "target_relative": {
      "pattern": "\\S",
      "type": "string"
    }
  },
  "required": [
    "action_authorized",
    "authority_effect",
    "authorization_ref",
    "caller_ref",
    "entitlement_ref",
    "generator_sha256",
    "language",
    "meta_type_ref",
    "node_id",
    "project_ref",
    "project_sha256",
    "target_relative"
  ],
  "type": "object"
}
