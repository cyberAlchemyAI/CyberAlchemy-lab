{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_authorized": {
      "const": false
    },
    "authority_effect": {
      "const": "none"
    },
    "node_ids": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "project_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "project_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "validation_passed": {
      "type": "boolean"
    },
    "validation_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "action_authorized",
    "authority_effect",
    "node_ids",
    "project_ref",
    "project_sha256",
    "validation_passed",
    "validation_receipt_sha256"
  ],
  "type": "object"
}
