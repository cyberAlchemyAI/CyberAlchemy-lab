{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_authorized": {
      "const": false
    },
    "authority_effect": {
      "const": "none"
    },
    "symlink_components": {
      "type": "boolean"
    },
    "target_exists": {
      "type": "boolean"
    },
    "target_relative": {
      "pattern": "\\S",
      "type": "string"
    }
  },
  "required": [
    "action_authorized",
    "authority_effect",
    "symlink_components",
    "target_exists",
    "target_relative"
  ],
  "type": "object"
}
