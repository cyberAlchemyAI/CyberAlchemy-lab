{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_authorized": {
      "const": false
    },
    "artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "authority_effect": {
      "const": "none"
    },
    "correlation_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "omissions": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "action_authorized",
    "artifact_sha256",
    "authority_effect",
    "correlation_id",
    "omissions",
    "receipt_sha256",
    "request_sha256",
    "version"
  ],
  "type": "object"
}
