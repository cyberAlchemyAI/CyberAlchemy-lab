{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_authorized": {
      "const": false
    },
    "authority_effect": {
      "const": "none"
    },
    "operation": {
      "enum": [
        "inspect",
        "mutate",
        "promote"
      ]
    },
    "read_only": {
      "type": "boolean"
    }
  },
  "required": [
    "action_authorized",
    "authority_effect",
    "operation",
    "read_only"
  ],
  "type": "object"
}
