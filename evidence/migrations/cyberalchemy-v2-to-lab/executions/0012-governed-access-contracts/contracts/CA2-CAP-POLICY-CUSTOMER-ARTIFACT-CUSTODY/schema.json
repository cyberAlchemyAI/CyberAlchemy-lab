{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_authorized": {
      "const": false
    },
    "authority_effect": {
      "const": "none"
    },
    "custody_terms_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "customer_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "destination_owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "terms_accepted": {
      "type": "boolean"
    }
  },
  "required": [
    "action_authorized",
    "authority_effect",
    "custody_terms_sha256",
    "customer_ref",
    "destination_owner_ref",
    "terms_accepted"
  ],
  "type": "object"
}
