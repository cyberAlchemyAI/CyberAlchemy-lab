{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_authorized": {
      "const": false
    },
    "authority_effect": {
      "const": "none"
    },
    "caller_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "correlation_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "expires_at": {
      "minimum": 0,
      "type": "integer"
    },
    "idempotency_key": {
      "pattern": "\\S",
      "type": "string"
    },
    "issued_at": {
      "minimum": 0,
      "type": "integer"
    },
    "payload_contract_ref": {
      "const": "CA2-CAP-CONTRACT-AGENT-INSTANTIATION-REQUEST"
    },
    "payload_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "action_authorized",
    "authority_effect",
    "caller_ref",
    "correlation_id",
    "expires_at",
    "idempotency_key",
    "issued_at",
    "payload_contract_ref",
    "payload_sha256",
    "version"
  ],
  "type": "object"
}
