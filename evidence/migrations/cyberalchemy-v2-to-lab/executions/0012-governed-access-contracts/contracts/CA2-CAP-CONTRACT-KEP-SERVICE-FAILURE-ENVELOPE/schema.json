{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_authorized": {
      "const": false
    },
    "artifacts": {
      "maxItems": 0,
      "type": "array"
    },
    "authority_effect": {
      "const": "none"
    },
    "code": {
      "enum": [
        "invalid-input",
        "scope-mismatch",
        "expired",
        "target-exists",
        "unsupported-realization"
      ]
    },
    "correlation_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "retryable": {
      "type": "boolean"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "action_authorized",
    "artifacts",
    "authority_effect",
    "code",
    "correlation_id",
    "request_sha256",
    "retryable",
    "version"
  ],
  "type": "object"
}
