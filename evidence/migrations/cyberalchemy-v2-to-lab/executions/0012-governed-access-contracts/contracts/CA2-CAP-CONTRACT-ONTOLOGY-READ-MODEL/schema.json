{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_authorized": {
      "const": false
    },
    "authority_effect": {
      "const": "none"
    },
    "omissions": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "projection_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "read_only": {
      "const": true
    },
    "registry_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "selector": {
      "pattern": "\\S",
      "type": "string"
    }
  },
  "required": [
    "action_authorized",
    "authority_effect",
    "omissions",
    "projection_sha256",
    "read_only",
    "registry_sha256",
    "selector"
  ],
  "type": "object"
}
