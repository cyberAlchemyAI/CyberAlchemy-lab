{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_authorized": {
      "const": false
    },
    "authority_effect": {
      "const": "none"
    },
    "caller_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "entitlement_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "evidence_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "expires_at": {
      "minimum": 0,
      "type": "integer"
    },
    "operations": {
      "items": {
        "enum": [
          "instantiate",
          "inspect"
        ]
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    }
  },
  "required": [
    "action_authorized",
    "authority_effect",
    "caller_ref",
    "entitlement_ref",
    "evidence_sha256",
    "expires_at",
    "operations",
    "scope_ref"
  ],
  "type": "object"
}
