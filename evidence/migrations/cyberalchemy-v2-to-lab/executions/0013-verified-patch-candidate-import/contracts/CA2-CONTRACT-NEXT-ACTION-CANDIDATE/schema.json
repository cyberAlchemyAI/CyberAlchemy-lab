{
  "$id": "are.next-action-candidate/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "expected_base_tree_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "expected_file_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "operation": {
      "const": "replace-file"
    },
    "path": {
      "minLength": 1,
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "schema_version": {
      "const": "are.next-action-candidate/v1"
    },
    "utf8": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "operation",
    "path",
    "expected_base_tree_sha256",
    "expected_file_sha256",
    "utf8",
    "authority_effect"
  ],
  "title": "ARE Next Action Candidate",
  "type": "object"
}
