{
  "schema_ref": "schemas/agent-router.schema.json#/$defs/routeRegistry",
  "schema_version": "cav2-agent-route-registry/v1",
  "registry_id": "cav2.agent-routing.routes",
  "entry_route_id": "CA2-ROUTE-ENTRY",
  "routes": [
    {
      "route_id": "CA2-ROUTE-ENTRY",
      "objective": "bootstrap and classify every repository request",
      "match": ["every request before repository work"],
      "authority_root": "cyberAlchemy-v2/agent-routing",
      "read_first": ["cyberAlchemy-v2/agent-routing/profile.json", "cyberAlchemy-v2/agent-routing/routes.json", "cyberAlchemy-v2/agent-routing/ROUTER.md"],
      "capability_ref": "CA2-CAP-ROUTE-REPOSITORY-WORK",
      "execution_mode": "native-inline",
      "lifecycle_state": "available",
      "requires_user_authorization": false,
      "write_ceiling": "none",
      "fallback_route": null,
      "blockers": []
    },
    {
      "route_id": "CA2-ROUTE-LOCATE",
      "objective": "locate repository projects, products, capabilities, or protocols cited by name",
      "match": [
        "find project by name",
        "locate user-cited project",
        "find named product or protocol",
        "unknown repository path",
        "resolve project alias"
      ],
      "authority_root": "cyberAlchemy-v2/agent-routing",
      "read_first": [
        "cyberAlchemy-v2/agent-routing/project-index.json",
        "cyberAlchemy-v2/agent-routing/PROJECT-LOOKUP.md"
      ],
      "capability_ref": "CA2-CAP-ROUTE-REPOSITORY-WORK",
      "execution_mode": "native-inline",
      "lifecycle_state": "available",
      "requires_user_authorization": false,
      "write_ceiling": "none; source-location lookup only",
      "fallback_route": null,
      "blockers": []
    },
    {
      "route_id": "CA2-ROUTE-RECENT",
      "objective": "retrieve bounded recent committed changes for an explicitly selected repository project or path",
      "match": [
        "recent committed files",
        "recent changes in a project",
        "recover recent repository context",
        "what changed recently"
      ],
      "excludes": [
        "durable repository session lifecycle remains CA2-ROUTE-SESSION",
        "commit or publish changes resolves to CA2-ROUTE-PUBLISH",
        "cache refresh or hook installation requires CA2-ROUTE-IMPLEMENT and its exact write scope"
      ],
      "authority_root": "cyberAlchemy-v2/agent-routing",
      "read_first": [
        "cyberAlchemy-v2/agent-routing/capabilities/recent-context/profile.json",
        "cyberAlchemy-v2/agent-routing/capabilities/recent-context/README.md",
        "cyberAlchemy-v2/agent-routing/project-index.json"
      ],
      "capability_ref": "CA2-CAP-ROUTE-REPOSITORY-WORK",
      "execution_mode": "native-inline",
      "lifecycle_state": "available",
      "requires_user_authorization": false,
      "write_ceiling": "none; recent-context query emits metadata to stdout only",
      "fallback_route": null,
      "blockers": []
    },
    {
      "route_id": "CA2-ROUTE-UNDERSTAND",
      "objective": "understand a non-ontology system, product, or architecture",
      "match": ["explain", "map", "inspect architecture", "understand system"],
      "excludes": ["direct registered ontology inspection or query resolves to CA2-ROUTE-ONTOLOGY", "source-location lookup for user-cited names resolves to CA2-ROUTE-LOCATE", "recent committed metadata resolves to CA2-ROUTE-RECENT"],
      "authority_root": "cyberAlchemy-v2",
      "read_first": ["cyberAlchemy-v2/SOURCE-MAP.md"],
      "capability_ref": "CA2-CAP-ROUTE-REPOSITORY-WORK",
      "execution_mode": "native-inline",
      "lifecycle_state": "available",
      "requires_user_authorization": false,
      "write_ceiling": "none",
      "fallback_route": null,
      "blockers": []
    },
    {
      "route_id": "CA2-ROUTE-RESEARCH",
      "objective": "perform bounded research or evidence collection",
      "match": ["research", "compare evidence", "investigate"],
      "excludes": ["source-location lookup for user-cited names resolves to CA2-ROUTE-LOCATE", "recent committed metadata resolves to CA2-ROUTE-RECENT"],
      "authority_root": "cyberAlchemy-v2/research",
      "read_first": ["cyberAlchemy-v2/SOURCE-MAP.md"],
      "capability_ref": "CA2-CAP-ROUTE-REPOSITORY-WORK",
      "execution_mode": "native-inline",
      "lifecycle_state": "candidate",
      "requires_user_authorization": false,
      "write_ceiling": "research evidence explicitly requested by the user",
      "fallback_route": null,
      "blockers": []
    },
    {
      "route_id": "CA2-ROUTE-DEFINE",
      "objective": "clarify meaning and author candidate definitions or intent",
      "match": ["define", "clarify intent", "author definition pack", "refine meaning"],
      "authority_root": "cyberAlchemy-v2/define",
      "read_first": ["cyberAlchemy-v2/define/profile.json", "cyberAlchemy-v2/define/README.md"],
      "capability_ref": "CA2-CAP-ROUTE-REPOSITORY-WORK",
      "execution_mode": "native-bounded-mutation",
      "lifecycle_state": "available",
      "requires_user_authorization": true,
      "write_ceiling": "candidate Definition Packs and handled-definition records only; no promotion, implementation, construction handoff, publication, release, deployment, or external effect",
      "fallback_route": null,
      "blockers": []
    },
    {
      "route_id": "CA2-ROUTE-PLAN",
      "objective": "plan work, decompose goals, or prepare a construction binding",
      "match": ["plan", "decompose goal", "prepare implementation", "construction binding"],
      "authority_root": "cyberAlchemy-v2/goals",
      "read_first": ["cyberAlchemy-v2/goals/profile.json", "cyberAlchemy-v2/goals/README.md"],
      "capability_ref": "CA2-CAP-ROUTE-REPOSITORY-WORK",
      "execution_mode": "native-inline",
      "lifecycle_state": "available",
      "requires_user_authorization": false,
      "write_ceiling": "planning candidates only; no implementation authority",
      "fallback_route": null,
      "blockers": ["CyberAlchemy-v2 Goals validation is currently blocked; planning output cannot be registered as admitted execution state"]
    },
    {
      "route_id": "CA2-ROUTE-IMPLEMENT",
      "objective": "perform an explicitly authorized bounded repository implementation",
      "match": ["implement", "change code", "change configuration", "repair"],
      "authority_root": "cyberAlchemy-v2/ontology/governance",
      "read_first": ["cyberAlchemy-v2/goals/profile.json", "cyberAlchemy-v2/ontology/governance/profile.json", "cyberAlchemy-v2/agent-routing/ROUTER.md"],
      "capability_ref": "CA2-CAP-ROUTE-REPOSITORY-WORK",
      "execution_mode": "native-bounded-mutation",
      "lifecycle_state": "candidate",
      "requires_user_authorization": true,
      "write_ceiling": "exact user-authorized files and effects under a D65 construction boundary",
      "fallback_route": null,
      "blockers": ["no admitted CyberAlchemy-v2 bounded-execution runtime; only exact owner-directed native mutation may proceed"]
    },
    {
      "route_id": "CA2-ROUTE-DEFINITIONS",
      "objective": "audit or change canonical CyberAlchemy-v2 vocabulary",
      "match": ["definition governance", "canonical term", "vocabulary", "definition drift"],
      "authority_root": "cyberAlchemy-v2/authority/definitions",
      "read_first": ["cyberAlchemy-v2/authority/definitions/DEFINITIONS.md", "cyberAlchemy-v2/authority/definitions/DEFINITIONS-INDEX.md", "cyberAlchemy-v2/SOURCE-MAP.md"],
      "capability_ref": "CA2-CAP-ROUTE-REPOSITORY-WORK",
      "execution_mode": "human-decision",
      "lifecycle_state": "available",
      "requires_user_authorization": true,
      "write_ceiling": "candidate definition changes and synchronized private consumers only",
      "fallback_route": null,
      "blockers": []
    },
    {
      "route_id": "CA2-ROUTE-GOVERNANCE",
      "objective": "evaluate authority, invariants, admission, or evidence claims",
      "match": ["governance", "authority", "admission", "invariant", "acceptance"],
      "authority_root": "cyberAlchemy-v2/ontology/governance",
      "read_first": ["cyberAlchemy-v2/ontology/governance/profile.json", "cyberAlchemy-v2/ontology/governance/README.md"],
      "capability_ref": "CA2-CAP-ROUTE-REPOSITORY-WORK",
      "execution_mode": "human-decision",
      "lifecycle_state": "candidate",
      "requires_user_authorization": true,
      "write_ceiling": "non-effectful governance evidence unless an exact owner decision grants more",
      "fallback_route": null,
      "blockers": ["governance enforcement runtime is not admitted"]
    },
    {
      "route_id": "CA2-ROUTE-VALIDATE",
      "objective": "run bounded non-ontology validation and report evidence",
      "match": ["validate", "test", "audit implementation", "check evidence"],
      "excludes": ["registered ontology validation resolves to CA2-ROUTE-ONTOLOGY"],
      "authority_root": "cyberAlchemy-v2/ontology/governance",
      "read_first": ["cyberAlchemy-v2/ontology/governance/profile.json", "cyberAlchemy-v2/agent-routing/ROUTER.md"],
      "capability_ref": "CA2-CAP-ROUTE-REPOSITORY-WORK",
      "execution_mode": "native-inline",
      "lifecycle_state": "available",
      "requires_user_authorization": false,
      "write_ceiling": "run-local evidence explicitly permitted by the selected validator",
      "fallback_route": null,
      "blockers": []
    },
    {
      "route_id": "CA2-ROUTE-ONTOLOGY",
      "objective": "operate the registered read-only ontology runtime directly",
      "match": ["ontology catalog", "ontology snapshot", "retrieve ontology record", "ontology runtime preflight", "understand registered ontology", "query registered ontology", "validate registered ontology"],
      "authority_root": "cyberAlchemy-v2/implementation/ontology-runtime",
      "read_first": ["cyberAlchemy-v2/implementation/ontology-runtime/profile.json", "cyberAlchemy-v2/implementation/ontology-runtime/registry.json", "cyberAlchemy-v2/implementation/ontology-runtime/README.md"],
      "capability_ref": "CA2-CAP-ROUTE-REPOSITORY-WORK",
      "execution_mode": "native-inline",
      "lifecycle_state": "candidate",
      "requires_user_authorization": false,
      "write_ceiling": "none; direct runtime operations are read-only and emit JSON to stdout",
      "fallback_route": null,
      "blockers": ["ontology runtime construction and conformance remain not_evaluable; only the tested local read-only candidate operations are available"]
    },
    {
      "route_id": "CA2-ROUTE-DELEGATE",
      "objective": "delegate bounded work to native background helpers",
      "match": ["delegate", "subagent", "parallel investigation", "background helper"],
      "authority_root": "cyberAlchemy-v2/agent-routing",
      "read_first": ["cyberAlchemy-v2/agent-routing/ROUTER.md", "cyberAlchemy-v2/ontology/governance/profile.json"],
      "capability_ref": "CA2-CAP-ROUTE-REPOSITORY-WORK",
      "execution_mode": "native-background-helper",
      "lifecycle_state": "candidate",
      "requires_user_authorization": true,
      "write_ceiling": "one bounded helper; multi-helper fan-out requires an explicit user-approved sheet",
      "fallback_route": null,
      "blockers": []
    },
    {
      "route_id": "CA2-ROUTE-SESSION",
      "objective": "create or close a durable repository session artifact",
      "match": ["new repository session", "close repository session", "durable session"],
      "authority_root": "cyberAlchemy-v2/context",
      "read_first": ["cyberAlchemy-v2/context/profile.json", "cyberAlchemy-v2/context/README.md"],
      "capability_ref": "CA2-CAP-ROUTE-REPOSITORY-WORK",
      "execution_mode": "blocked-until-capability",
      "lifecycle_state": "blocked",
      "requires_user_authorization": true,
      "write_ceiling": "none",
      "fallback_route": null,
      "blockers": ["CyberAlchemy-v2 Context runtime is not implemented"]
    },
    {
      "route_id": "CA2-ROUTE-PUBLISH",
      "objective": "commit, push, publish, release, deploy, or change a submodule pointer",
      "match": ["commit", "push", "publish", "release", "deploy", "submodule"],
      "authority_root": "cyberAlchemy-v2/ontology/governance",
      "read_first": ["cyberAlchemy-v2/ontology/governance/profile.json", "SUBMODULE-DISCIPLINE.md"],
      "capability_ref": "CA2-CAP-ROUTE-REPOSITORY-WORK",
      "execution_mode": "human-decision",
      "lifecycle_state": "candidate",
      "requires_user_authorization": true,
      "write_ceiling": "the exact accepted publication or deployment envelope",
      "fallback_route": null,
      "blockers": ["publication and deployment require separate exact authorization"]
    },
    {
      "route_id": "CA2-ROUTE-PREVIEW",
      "objective": "serve, open, inspect, or stop one exact local HTML preview",
      "match": ["preview local html", "open local html", "serve local html", "stop local preview"],
      "authority_root": "cyberAlchemy-v2/agent-routing",
      "read_first": ["cyberAlchemy-v2/agent-routing/ROUTER.md"],
      "capability_ref": "CA2-CAP-ROUTE-REPOSITORY-WORK",
      "execution_mode": "native-browser",
      "lifecycle_state": "candidate",
      "requires_user_authorization": true,
      "write_ceiling": "loopback preview state only; no HTML mutation or remote exposure",
      "fallback_route": null,
      "blockers": []
    },
    {
      "route_id": "CA2-ROUTE-AMBIGUOUS",
      "objective": "request the smallest decision for an unmatched or conflicting objective",
      "match": ["no unique route", "conflicting route", "missing target decision"],
      "authority_root": "cyberAlchemy-v2/agent-routing",
      "read_first": ["cyberAlchemy-v2/agent-routing/ROUTER.md"],
      "capability_ref": "CA2-CAP-ROUTE-REPOSITORY-WORK",
      "execution_mode": "native-inline",
      "lifecycle_state": "available",
      "requires_user_authorization": false,
      "write_ceiling": "none",
      "fallback_route": null,
      "blockers": []
    }
  ],
  "authority_effect": "none"
}
