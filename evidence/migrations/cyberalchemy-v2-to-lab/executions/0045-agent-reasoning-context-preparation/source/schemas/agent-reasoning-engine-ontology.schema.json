{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/agent-reasoning-engine-ontology/v1",
  "title": "CyberAlchemy-v2 Agent Reasoning Engine Ontology",
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "id": {"type": "string", "minLength": 1},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "package_id", "ontology_id", "ontology_type", "package_root", "package_owner", "meaning_owner", "system_owner", "visibility", "status", "authority_effect", "product_capability_ref", "product_record", "benchmark_scorecard", "benchmark_evidence", "source_registry", "business_ontology", "bridge_registry", "domainspec_project", "system_ontology", "implementation_target", "schema_path", "validator_path", "residue_registry", "receipt_root", "stage_states", "blocked_effects"],
      "properties": {
        "schema_ref": {"const": "schemas/agent-reasoning-engine-ontology.schema.json#/$defs/profile"},
        "schema_version": {"const": "cav2-agent-reasoning-engine-ontology-profile/v1"},
        "package_id": {"const": "cav2.agent-reasoning-engine.product"},
        "ontology_id": {"const": "cav2.agent-reasoning-engine.bridge.v1"},
        "ontology_type": {"const": "business-system-bridge"},
        "package_root": {"const": "cyberAlchemy-v2/agent-reasoning-engine"},
        "package_owner": {"$ref": "#/$defs/nonEmptyString"},
        "meaning_owner": {"$ref": "#/$defs/nonEmptyString"},
        "system_owner": {"$ref": "#/$defs/nonEmptyString"},
        "visibility": {"const": "private"},
        "status": {"const": "candidate-first-class"},
        "authority_effect": {"const": "none"},
        "product_capability_ref": {"const": "CA2-CAP-REASON-AND-MANAGE-CONTEXT"},
        "product_record": {"const": "product.json"},
        "benchmark_scorecard": {"const": "benchmark-scorecard.json"},
        "benchmark_evidence": {"const": "benchmark-evidence.json"},
        "source_registry": {"const": "sources.json"},
        "business_ontology": {"const": "business-ontology.json"},
        "bridge_registry": {"const": "bridge.json"},
        "domainspec_project": {"const": "domainspec/project.json"},
        "system_ontology": {"const": "domainspec/generated/system-ontology.json"},
        "implementation_target": {"const": "cyberAlchemy-v2/implementation/agent-reasoning-engine"},
        "schema_path": {"const": "schemas/agent-reasoning-engine-ontology.schema.json"},
        "validator_path": {"const": "scripts/validate.py"},
        "residue_registry": {"const": "residue.jsonl"},
        "receipt_root": {"const": "receipts"},
        "stage_states": {
          "type": "object",
          "additionalProperties": false,
          "required": ["definition", "product_ontology", "product_capability", "business_ontology", "domainspec_source", "compiled_graph", "system_ontology", "bridge_validation", "implementation", "static_conformance", "runtime_evidence"],
          "properties": {
            "definition": {"const": "validated"},
            "product_ontology": {"const": "referenced"},
            "product_capability": {"const": "candidate"},
            "business_ontology": {"const": "candidate"},
            "domainspec_source": {"const": "candidate"},
            "compiled_graph": {"const": "candidate-generated"},
            "system_ontology": {"const": "candidate-generated"},
            "bridge_validation": {"const": "candidate"},
            "implementation": {"const": "candidate-partial-realizations"},
            "static_conformance": {"const": "not_evaluable"},
            "runtime_evidence": {"const": "not_evaluable"}
          }
        },
        "blocked_effects": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}}
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "product_id", "name", "parent_product_ref", "product_thesis", "benchmark_scorecard_ref", "capability_refs", "product_package_root", "implementation_target", "construction_lane", "operational_residue", "lifecycle_posture", "authority_effect", "claim_limit"],
      "properties": {
        "schema_ref": {"const": "schemas/agent-reasoning-engine-ontology.schema.json#/$defs/product"},
        "schema_version": {"const": "cav2-agent-reasoning-engine-product/v1"},
        "product_id": {"const": "CA2-PRODUCT-AGENT-REASONING-ENGINE"},
        "name": {"const": "Agent Reasoning Engine"},
        "parent_product_ref": {"const": "CA2-PRODUCT-CYBERALCHEMY"},
        "product_thesis": {"$ref": "#/$defs/nonEmptyString"},
        "benchmark_scorecard_ref": {"const": "benchmark-scorecard.json"},
        "capability_refs": {"const": ["CA2-CAP-REASON-AND-MANAGE-CONTEXT"]},
        "product_package_root": {"const": "cyberAlchemy-v2/agent-reasoning-engine"},
        "implementation_target": {"const": "cyberAlchemy-v2/implementation/agent-reasoning-engine"},
        "construction_lane": {
          "type": "object",
          "additionalProperties": false,
          "required": ["frontier", "runnable_now"],
          "properties": {
            "frontier": {"$ref": "#/$defs/nonEmptyString"},
            "runnable_now": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}}
          }
        },
        "operational_residue": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "lifecycle_posture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "product_approval", "canonical_adoption"],
          "properties": {
            "status": {"const": "candidate"},
            "product_approval": {"const": "not-requested"},
            "canonical_adoption": {"const": "not-granted"}
          }
        },
        "authority_effect": {"const": "none"},
        "claim_limit": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "businessNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "meaning"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["Product", "Product Capability", "Outcome", "Actor", "Domain Concept", "Workflow", "Business Rule", "Policy"]},
        "meaning": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "businessRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "type", "target"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "source": {"$ref": "#/$defs/id"},
        "type": {"enum": ["belongs_to", "produces", "serves", "consumes", "constrains", "precedes", "manages", "exposes", "preserves"]},
        "target": {"$ref": "#/$defs/id"}
      }
    },
    "businessOntology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "ontology_id", "ontology_type", "branch", "nodes", "relations", "authority_effect"],
      "properties": {
        "schema_ref": {"const": "schemas/agent-reasoning-engine-ontology.schema.json#/$defs/businessOntology"},
        "schema_version": {"const": "cav2-agent-reasoning-engine-business-ontology/v1"},
        "ontology_id": {"const": "CA2-ARE-BUSINESS-ONTOLOGY"},
        "ontology_type": {"const": "business-domain"},
        "branch": {"const": "business"},
        "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/businessNode"}},
        "relations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/businessRelation"}},
        "authority_effect": {"const": "none"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "scope_kind", "selector", "sha256", "role", "branch"],
      "properties": {
        "id": {"type": "string", "pattern": "^CAP-SEL-"},
        "path": {"$ref": "#/$defs/nonEmptyString"},
        "scope_kind": {"enum": ["whole-file", "heading-section"]},
        "selector": {"type": ["string", "null"]},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "role": {"enum": ["canonical-definition", "owner-direction", "product-source", "system-design", "implementation-evidence", "decision-evidence"]},
        "branch": {"enum": ["business", "system", "bridge"]}
      }
    },
    "sourceRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "registry_id", "sources", "authority_effect"],
      "properties": {
        "schema_ref": {"const": "schemas/agent-reasoning-engine-ontology.schema.json#/$defs/sourceRegistry"},
        "schema_version": {"const": "cav2-agent-reasoning-engine-sources/v1"},
        "registry_id": {"const": "cav2.agent-reasoning-engine.sources"},
        "sources": {"type": "array", "minItems": 8, "items": {"$ref": "#/$defs/source"}},
        "authority_effect": {"const": "none"}
      }
    },
    "benchmarkBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["json_pointer", "expected"],
      "properties": {
        "json_pointer": {"type": "string", "pattern": "^/"},
        "expected": {}
      }
    },
    "benchmarkRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_id", "surface", "score", "latency", "status", "evidence_posture", "evidence_ref", "status_pointer", "bindings"],
      "properties": {
        "row_id": {"type": "string", "pattern": "^ARE-SCORE-"},
        "surface": {"$ref": "#/$defs/nonEmptyString"},
        "score": {"$ref": "#/$defs/nonEmptyString"},
        "latency": {"$ref": "#/$defs/nonEmptyString"},
        "status": {"enum": ["PASS", "FAIL", "NOT_EVALUATED"]},
        "evidence_posture": {"enum": ["current-deterministic-run", "current-disjoint-holdout-run", "current-deterministic-replay", "recorded-live-run-gpt-5.6-luna", "recorded-negative-experiment"]},
        "evidence_ref": {"type": "string", "pattern": "^CAP-SEL-ARE-BENCHMARK-"},
        "status_pointer": {"type": "string", "pattern": "^/"},
        "bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/benchmarkBinding"}}
      }
    },
    "benchmarkScorecard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "scorecard_id", "product_ref", "benchmark_profile_ref", "evidence_epoch", "environment", "rows", "unscored_surfaces", "claim_limit", "authority_effect"],
      "properties": {
        "schema_ref": {"const": "schemas/agent-reasoning-engine-ontology.schema.json#/$defs/benchmarkScorecard"},
        "schema_version": {"const": "cav2-agent-reasoning-engine-benchmark-scorecard/v1"},
        "scorecard_id": {"const": "CA2-ARE-BENCHMARK-SCORECARD-001"},
        "product_ref": {"const": "CA2-PRODUCT-AGENT-REASONING-ENGINE"},
        "benchmark_profile_ref": {"const": "CAP-SEL-ARE-BENCHMARK-PROFILE"},
        "evidence_epoch": {"type": "string", "format": "date"},
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["node", "platform", "arch"],
          "properties": {
            "node": {"const": "v26.8.1"},
            "platform": {"const": "linux"},
            "arch": {"const": "x64"}
          }
        },
        "rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/benchmarkRow"}},
        "unscored_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["surface_id", "surface", "status", "reason"],
            "properties": {
              "surface_id": {"type": "string", "pattern": "^ARE-UNSCORED-"},
              "surface": {"$ref": "#/$defs/nonEmptyString"},
              "status": {"const": "NOT_EVALUATED"},
              "reason": {"$ref": "#/$defs/nonEmptyString"}
            }
          }
        },
        "claim_limit": {"$ref": "#/$defs/nonEmptyString"},
        "authority_effect": {"const": "none"}
      }
    },
    "benchmarkEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "evidence_id", "benchmark_profile_sha256", "environment", "results", "projection_posture", "authority_effect"],
      "properties": {
        "schema_ref": {"const": "schemas/agent-reasoning-engine-ontology.schema.json#/$defs/benchmarkEvidence"},
        "schema_version": {"const": "cav2-agent-reasoning-engine-benchmark-evidence/v1"},
        "evidence_id": {"const": "CA2-ARE-BENCHMARK-EVIDENCE-001"},
        "benchmark_profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["node", "platform", "arch"],
          "properties": {
            "node": {"const": "v26.8.1"},
            "platform": {"const": "linux"},
            "arch": {"const": "x64"}
          }
        },
        "results": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deterministic", "adaptive_reuse", "adaptive_reuse_holdout", "compaction_live", "literal_intent_scorer", "route_continuation"],
          "properties": {
            "deterministic": {"type": "object"},
            "adaptive_reuse": {"type": "object"},
            "adaptive_reuse_holdout": {"type": "object"},
            "compaction_live": {"type": "object"},
            "literal_intent_scorer": {"type": "object"},
            "route_continuation": {"type": "object"}
          }
        },
        "projection_posture": {"$ref": "#/$defs/nonEmptyString"},
        "authority_effect": {"const": "none"}
      }
    },
    "bridgeEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "relation", "target", "realization_status", "evidence_refs"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "source": {"$ref": "#/$defs/id"},
        "relation": {"enum": ["realized_by", "depends_on", "constrained_by", "observed_by", "tested_by", "drifts_from", "traced_to"]},
        "target": {"$ref": "#/$defs/id"},
        "realization_status": {"enum": ["candidate-trace", "bounded-realization", "gap"]},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^CAP-SEL-"}}
      }
    },
    "bridgeGap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "business_refs", "system_refs", "meaning"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["open", "blocked", "not_evaluable"]},
        "business_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "system_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "meaning": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "bridgeOntology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "ontology_id", "ontology_type", "branches", "business_ontology_ref", "system_ontology_ref", "edges", "gaps", "authority_effect", "claim_limit"],
      "properties": {
        "schema_ref": {"const": "schemas/agent-reasoning-engine-ontology.schema.json#/$defs/bridgeOntology"},
        "schema_version": {"const": "cav2-agent-reasoning-engine-bridge/v1"},
        "ontology_id": {"const": "cav2.agent-reasoning-engine.bridge.v1"},
        "ontology_type": {"const": "business-system-bridge"},
        "branches": {"const": ["business", "system"]},
        "business_ontology_ref": {"const": "business-ontology.json"},
        "system_ontology_ref": {"const": "domainspec/generated/system-ontology.json"},
        "edges": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/bridgeEdge"}},
        "gaps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/bridgeGap"}},
        "authority_effect": {"const": "none"},
        "claim_limit": {"$ref": "#/$defs/nonEmptyString"}
      }
    }
  }
}
