    "rules": [
      {
        "enforcement_state": "candidate",
        "rule_id": "DST3-RULE-THREE-DISTINCT-DOMAINS",
        "statement": "Protection completes only when all three required layers have pairwise-distinct failure-domain identities."
      },
      {
        "enforcement_state": "candidate",
        "rule_id": "DST3-RULE-IDENTITY-CLOSURE",
        "statement": "Every layer representation verifies to the same qualified byte identity."
      },
      {
        "enforcement_state": "candidate",
        "rule_id": "DST3-RULE-OPERATIONAL-NOT-BACKUP",
        "statement": "Operational SQL success alone never establishes backup or recovery readiness."
      },
      {
        "enforcement_state": "candidate",
        "rule_id": "DST3-RULE-JOURNAL-APPEND-ONLY",
        "statement": "Recovery journal events are immutable and append-only."
      },
      {
        "enforcement_state": "candidate",
        "rule_id": "DST3-RULE-ARCHIVE-IMMUTABLE",
        "statement": "Archive objects and manifests are content-addressed and never overwritten."
      },
      {
        "enforcement_state": "candidate",
        "rule_id": "DST3-RULE-CANDIDATE-NOT-RESTORED",
        "statement": "A restore candidate is never a verified restoration."
      },
      {
        "enforcement_state": "candidate",
        "rule_id": "DST3-RULE-VERIFY-DESTINATION",
        "statement": "Restoration requires destination retrieval and exact verification for the closed object set."
      },
      {
        "enforcement_state": "candidate",
        "rule_id": "DST3-RULE-SQL-DIALECT-OUTSIDE-IDENTITY",
        "statement": "Database dialect, placeholders, binary types, adapter, and connection protocol never enter object identity."
      },
      {
        "enforcement_state": "candidate",
        "rule_id": "DST3-RULE-POSTGRES-FIRST-NOT-ONLY",
        "statement": "PostgreSQL is the first conforming adapter and cannot become the SQL portability contract."
      },
      {
        "enforcement_state": "candidate",
        "rule_id": "DST3-RULE-FAILURE-NO-PROMOTION",
        "statement": "Any missing layer, shared failure domain, mismatch, incomplete set, or unavailable source yields typed failure and no success."
      },
      {
        "enforcement_state": "candidate",
        "rule_id": "DST3-RULE-SECRETS-EXCLUDED",
        "statement": "Plaintext, unwrapped keys, private keys, and credentials are excluded from every layer and evidence record."
      },
      {
        "enforcement_state": "candidate",
        "rule_id": "DST3-RULE-EVIDENCE-BOUNDED",
        "statement": "Protection and recovery claims are bounded to exact realizations, policies, failure domains, object sets, and observation intervals."
      }
