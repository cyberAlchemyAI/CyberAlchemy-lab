{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "minLength": 1,
      "type": "string"
    },
    "authority_effect": {
      "const": "none"
    },
    "construction_id": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "request_context_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "thread_id": {
      "minLength": 1,
      "type": "string"
    },
    "turn_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "attempt_id",
    "authority_effect",
    "construction_id",
    "evidence_manifest_sha256",
    "request_context_sha256",
    "thread_id",
    "turn_id"
  ],
  "type": "object"
}
