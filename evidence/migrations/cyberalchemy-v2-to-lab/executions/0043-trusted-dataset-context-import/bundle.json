  "definitions": {
    "definitions": [
      {
        "meaning": "An immutable dataset version whose declared mapping, validation, publication, and lineage obligations have evidence for one run.",
        "term": "TrustedDataset"
      },
      {
        "meaning": "A content-addressed reference to data bytes; RWO carries the reference and never the bulk data.",
        "term": "DataReference"
      },
      {
        "meaning": "The single logical authority for accepted run transitions, receipts, checkpoints, and their hash chain.",
        "term": "AcceptedHistory"
      },
      {
        "meaning": "A source position accepted only after its corresponding dataset version is durably published.",
        "term": "SourceCheckpoint"
      },
      {
        "meaning": "Evidence that a content-addressed dataset version was atomically installed or already existed with identical bytes.",
        "term": "PublicationReceipt"
      },
      {
        "meaning": "Invalid material retained with validation findings and no publication authority.",
        "term": "QuarantineResidue"
      },
      {
        "meaning": "A physical accepted-history binding whose per-run chain is serialized and guarded by PostgreSQL transactions.",
        "term": "PostgreSQLAcceptedHistory"
      },
      {
        "meaning": "A content-addressed PostgreSQL publication containing one immutable logical set of normalized observations.",
        "term": "DatasetVersion"
      }
    ]
  },
  "limitations": [
    "No typed relationship or branch semantics inferred from concept names or rule prose.",
    "SourceCheckpoint, PublicationReceipt and physical history definitions remain in the separate definition registry; not silently added as source ontology entities.",
    "Profile references to code/generated outputs remain source metadata; snapshot is not a standalone executable package.",
    "No ETL, publication, connector, SQL or recovery execution."
  ],
