{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/private/schemas/framings/v1",
  "title": "CyberAlchemy v2 contextual framings capability ontology",
  "$defs": {
    "text": {"type":"string","minLength":1},
    "id": {"type":"string","minLength":1,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "profile": {"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","package_id","ontology_id","ontology_type","branch","package_root","package_owner","visibility","status","authority_effect","parent_capability_ref","product_capability_ref","source_registry","node_registry","relation_registry","product_capability_path","schema_path","validator_path","residue_registry","receipt_root","stage_states","blocked_effects"],"properties":{"schema_ref":{"const":"schemas/framings.schema.json#/$defs/profile"},"schema_version":{"const":"cav2-framings-profile/v1"},"package_id":{"const":"cav2.agent-reasoning-engine.framings"},"ontology_id":{"const":"cav2.agent-reasoning-engine.framings.business.v1"},"ontology_type":{"const":"business-domain"},"branch":{"const":"business"},"package_root":{"const":"cyberAlchemy-v2/agent-reasoning-engine/framings"},"package_owner":{"$ref":"#/$defs/text"},"visibility":{"const":"private"},"status":{"const":"candidate"},"authority_effect":{"const":"none"},"parent_capability_ref":{"const":"CA2-CAP-REASON-AND-MANAGE-CONTEXT"},"product_capability_ref":{"const":"CA2-CAP-GENERATE-CONTEXTUAL-FRAMINGS"},"source_registry":{"const":"sources.json"},"node_registry":{"const":"nodes.json"},"relation_registry":{"const":"relations.json"},"product_capability_path":{"const":"product-capability.json"},"schema_path":{"const":"schemas/framings.schema.json"},"validator_path":{"const":"scripts/validate.py"},"residue_registry":{"const":"residue.jsonl"},"receipt_root":{"const":"receipts"},"stage_states":{"type":"object","minProperties":1},"blocked_effects":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/text"}}}},
    "revision": {"type":"object","additionalProperties":false,"required":["revision","date","change","owner_route"],"properties":{"revision":{"type":"integer","minimum":1},"date":{"type":"string","format":"date"},"change":{"$ref":"#/$defs/text"},"owner_route":{"$ref":"#/$defs/text"}}},
    "productCapability": {"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","capability_id","definition_ref","product_ref","parent_capability_ref","business_ontology_ref","outcome","scope","inputs","outputs","exclusions","owner_routes","lifecycle_posture","revision_history","challenge_route","authority_effect","claim_limit"],"properties":{"schema_ref":{"const":"schemas/framings.schema.json#/$defs/productCapability"},"schema_version":{"const":"cav2-framings-product-capability/v1"},"capability_id":{"const":"CA2-CAP-GENERATE-CONTEXTUAL-FRAMINGS"},"definition_ref":{"const":"CAV2-D67"},"product_ref":{"const":"CA2-PRODUCT-CYBERALCHEMY"},"parent_capability_ref":{"const":"CA2-CAP-REASON-AND-MANAGE-CONTEXT"},"business_ontology_ref":{"const":"CA2-FRAMINGS-BUSINESS-ONTOLOGY"},"outcome":{"$ref":"#/$defs/text"},"scope":{"$ref":"#/$defs/text"},"inputs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"outputs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"exclusions":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/text"}},"owner_routes":{"type":"array","minItems":5,"maxItems":5,"uniqueItems":true,"items":{"$ref":"#/$defs/text"}},"lifecycle_posture":{"type":"object","additionalProperties":false,"required":["status","adoption","implementation","conformance"],"properties":{"status":{"const":"candidate"},"adoption":{"const":"not-adopted"},"implementation":{"const":"not-implemented"},"conformance":{"const":"not_evaluable"}}},"revision_history":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/revision"}},"challenge_route":{"$ref":"#/$defs/text"},"authority_effect":{"const":"none"},"claim_limit":{"$ref":"#/$defs/text"}}},
    "source": {"type":"object","additionalProperties":false,"required":["source_id","path","scope_kind","selector","sha256","role","owner_route"],"properties":{"source_id":{"type":"string","pattern":"^FRM-SEL-"},"path":{"type":"string","pattern":"^cyberAlchemy-v2/"},"scope_kind":{"enum":["whole-file","heading-section"]},"selector":{"type":["string","null"]},"sha256":{"$ref":"#/$defs/sha256"},"role":{"$ref":"#/$defs/text"},"owner_route":{"$ref":"#/$defs/text"}}},
    "sourceRegistry": {"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","sources","authority_effect"],"properties":{"schema_ref":{"const":"schemas/framings.schema.json#/$defs/sourceRegistry"},"schema_version":{"const":"cav2-framings-sources/v1"},"sources":{"type":"array","minItems":3,"items":{"$ref":"#/$defs/source"}},"authority_effect":{"const":"none"}}},
    "node": {"type":"object","additionalProperties":false,"required":["id","kind","meaning","source_refs","status","authority_effect"],"properties":{"id":{"$ref":"#/$defs/id"},"kind":{"enum":["Product","Parent Capability","Product Capability","Business Ontology","Outcome","Domain Concept","Workflow","Business Rule"]},"meaning":{"$ref":"#/$defs/text"},"source_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^FRM-SEL-"}},"status":{"enum":["projected","candidate"]},"authority_effect":{"const":"none"}}},
    "nodeRegistry": {"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","nodes","authority_effect"],"properties":{"schema_ref":{"const":"schemas/framings.schema.json#/$defs/nodeRegistry"},"schema_version":{"const":"cav2-framings-nodes/v1"},"nodes":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/node"}},"authority_effect":{"const":"none"}}},
    "relationType": {"type":"object","additionalProperties":false,"required":["type","source_kinds","target_kinds"],"properties":{"type":{"type":"string","pattern":"^[a-z][a-z_]*$"},"source_kinds":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/text"}},"target_kinds":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/text"}}}},
    "relation": {"type":"object","additionalProperties":false,"required":["id","type","source","target","source_refs","authority_effect"],"properties":{"id":{"type":"string","pattern":"^CA2-FRAMINGS-REL-"},"type":{"type":"string","pattern":"^[a-z][a-z_]*$"},"source":{"$ref":"#/$defs/id"},"target":{"$ref":"#/$defs/id"},"source_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^FRM-SEL-"}},"authority_effect":{"const":"none"}}},
    "relationRegistry": {"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","relation_types","relations","authority_effect"],"properties":{"schema_ref":{"const":"schemas/framings.schema.json#/$defs/relationRegistry"},"schema_version":{"const":"cav2-framings-relations/v1"},"relation_types":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/relationType"}},"relations":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/relation"}},"authority_effect":{"const":"none"}}},
    "validationReceipt": {"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","validated_at","status","package_root","ontology_type","branch","authority_effect","counts","material_digest","checks","warnings","errors","claim_ceiling"],"properties":{"schema_ref":{"const":"schemas/framings.schema.json#/$defs/validationReceipt"},"schema_version":{"const":"cav2-framings-validation/v1"},"validated_at":{"type":"string","format":"date-time"},"status":{"enum":["PASS","BLOCK"]},"package_root":{"const":"cyberAlchemy-v2/agent-reasoning-engine/framings"},"ontology_type":{"const":"business-domain"},"branch":{"const":"business"},"authority_effect":{"const":"none"},"counts":{"type":"object"},"material_digest":{"$ref":"#/$defs/sha256"},"checks":{"type":"array","items":{"$ref":"#/$defs/text"}},"warnings":{"type":"array","items":{"type":"string"}},"errors":{"type":"array","items":{"type":"string"}},"claim_ceiling":{"$ref":"#/$defs/text"}}}
  }
}
