{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/commercial-agent-access.schema.json",
  "title": "CyberAlchemy Commercial Agent Access Candidate Package",
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]+$"},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "package_id", "ontology_id", "title", "ontology_type", "branch", "materialization", "package_root", "package_owner", "meaning_owner", "product_ref", "product_capability_ref", "visibility", "candidate_status", "construction_stage", "authority_effect", "source_registry", "definition_registry", "product_capability", "product_capability_support", "node_registry", "relation_registry", "residue_registry", "schema_path", "validator_path", "blocked_outputs"],
      "properties": {
        "schema_ref": {"const": "schemas/commercial-agent-access.schema.json#/$defs/profile"},
        "schema_version": {"const": "cav2-commercial-agent-access-profile/v1"},
        "package_id": {"const": "cav2.commercial-agent-access"},
        "ontology_id": {"const": "cav2.commercial-agent-access.business"},
        "title": {"$ref": "#/$defs/text"},
        "ontology_type": {"const": "business-domain"},
        "branch": {"const": "business"},
        "materialization": {"const": "package-required"},
        "package_root": {"const": "cyberAlchemy-v2/commercial-agent-access"},
        "package_owner": {"$ref": "#/$defs/text"},
        "meaning_owner": {"$ref": "#/$defs/text"},
        "product_ref": {"const": "CA2-PRODUCT-CYBERALCHEMY"},
        "product_capability_ref": {"const": "CA2-CAP-PROVIDE-GOVERNED-SYSTEM-BUILDING-ACCESS"},
        "visibility": {"const": "private"},
        "candidate_status": {"const": "candidate"},
        "construction_stage": {"const": "business-ontology-candidate"},
        "authority_effect": {"const": "none"},
        "source_registry": {"const": "sources.json"},
        "definition_registry": {"const": "definitions.json"},
        "product_capability": {"const": "product-capability.json"},
        "product_capability_support": {"const": "product-capability-support.json"},
        "node_registry": {"const": "nodes.json"},
        "relation_registry": {"const": "relations.json"},
        "residue_registry": {"const": "residue.json"},
        "schema_path": {"const": "schemas/commercial-agent-access.schema.json"},
        "validator_path": {"const": "scripts/validate.py"},
        "blocked_outputs": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "path", "selector", "expected_sha256", "expected_size", "role", "authority_effect"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^CAP-SEL-"},
        "path": {"$ref": "#/$defs/text"},
        "selector": {"$ref": "#/$defs/text"},
        "expected_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "expected_size": {"type": "integer", "minimum": 1},
        "role": {"$ref": "#/$defs/text"},
        "authority_effect": {"const": "none"}
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "sources", "authority_effect"],
      "properties": {
        "schema_ref": {"const": "schemas/commercial-agent-access.schema.json#/$defs/sources"},
        "schema_version": {"const": "cav2-commercial-agent-access-sources/v1"},
        "sources": {"type": "array", "minItems": 6, "items": {"$ref": "#/$defs/source"}},
        "authority_effect": {"const": "none"}
      }
    },
    "localDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition_id", "term", "status", "meaning", "excludes", "source_refs"],
      "properties": {
        "definition_id": {"type": "string", "pattern": "^CAA-DEF-"},
        "term": {"$ref": "#/$defs/text"},
        "status": {"const": "candidate-local"},
        "meaning": {"$ref": "#/$defs/text"},
        "excludes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^CAP-SEL-"}}
      }
    },
    "definitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "scope", "definitions", "authority_effect"],
      "properties": {
        "schema_ref": {"const": "schemas/commercial-agent-access.schema.json#/$defs/definitions"},
        "schema_version": {"const": "cav2-commercial-agent-access-definitions/v1"},
        "scope": {"const": "CA2-CAP-PROVIDE-GOVERNED-SYSTEM-BUILDING-ACCESS"},
        "definitions": {"type": "array", "minItems": 10, "items": {"$ref": "#/$defs/localDefinition"}},
        "authority_effect": {"const": "none"}
      }
    },
    "productCapabilitySupport": {
      "type": "object",
      "required": ["schema_ref", "schema_version", "capability_ref", "instance_status", "adoption_state", "construction_stage", "realization_binding", "realization_candidates", "obligation_registry", "authority_effect"],
      "properties": {
        "schema_ref": {"const": "schemas/commercial-agent-access.schema.json#/$defs/productCapabilitySupport"},
        "schema_version": {"const": "cav2-commercial-agent-access-support/v1"},
        "capability_ref": {"const": "CA2-CAP-PROVIDE-GOVERNED-SYSTEM-BUILDING-ACCESS"},
        "instance_status": {"const": "candidate"},
        "adoption_state": {"const": "not-adopted"},
        "construction_stage": {"const": "business-ontology-candidate"},
        "realization_binding": {"type": "object"},
        "realization_candidates": {"type": "array", "minItems": 4},
        "obligation_registry": {"type": "object"},
        "authority_effect": {"const": "none"}
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "kind", "label", "status", "meaning", "owner_route", "source_refs", "authority_effect"],
      "properties": {
        "node_id": {"$ref": "#/$defs/id"},
        "kind": {"$ref": "#/$defs/text"},
        "label": {"$ref": "#/$defs/text"},
        "status": {"enum": ["candidate", "unselected"]},
        "meaning": {"$ref": "#/$defs/text"},
        "owner_route": {"$ref": "#/$defs/text"},
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^CAP-SEL-"}},
        "authority_effect": {"const": "none"}
      }
    },
    "nodes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "ontology_id", "nodes", "authority_effect"],
      "properties": {
        "schema_ref": {"const": "schemas/commercial-agent-access.schema.json#/$defs/nodes"},
        "schema_version": {"const": "cav2-commercial-agent-access-nodes/v1"},
        "ontology_id": {"const": "cav2.commercial-agent-access.business"},
        "nodes": {"type": "array", "minItems": 20, "items": {"$ref": "#/$defs/node"}},
        "authority_effect": {"const": "none"}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation_id", "from", "type", "to", "status", "condition", "authority_effect"],
      "properties": {
        "relation_id": {"type": "string", "pattern": "^CAA-REL-"},
        "from": {"$ref": "#/$defs/id"},
        "type": {"$ref": "#/$defs/text"},
        "to": {"$ref": "#/$defs/id"},
        "status": {"enum": ["candidate", "unselected"]},
        "condition": {"$ref": "#/$defs/text"},
        "authority_effect": {"const": "none"}
      }
    },
    "relations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "ontology_id", "relations", "authority_effect"],
      "properties": {
        "schema_ref": {"const": "schemas/commercial-agent-access.schema.json#/$defs/relations"},
        "schema_version": {"const": "cav2-commercial-agent-access-relations/v1"},
        "ontology_id": {"const": "cav2.commercial-agent-access.business"},
        "relations": {"type": "array", "minItems": 18, "items": {"$ref": "#/$defs/relation"}},
        "authority_effect": {"const": "none"}
      }
    },
    "residueItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["residue_id", "status", "statement", "owner_route", "next_action"],
      "properties": {
        "residue_id": {"type": "string", "pattern": "^CAP-RES-SYSTEM-BUILDING-"},
        "status": {"enum": ["open", "blocked", "deferred"]},
        "statement": {"$ref": "#/$defs/text"},
        "owner_route": {"$ref": "#/$defs/text"},
        "next_action": {"$ref": "#/$defs/text"}
      }
    },
    "residue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "residue", "authority_effect"],
      "properties": {
        "schema_ref": {"const": "schemas/commercial-agent-access.schema.json#/$defs/residue"},
        "schema_version": {"const": "cav2-commercial-agent-access-residue/v1"},
        "residue": {"type": "array", "minItems": 8, "items": {"$ref": "#/$defs/residueItem"}},
        "authority_effect": {"const": "none"}
      }
    }
  }
}
