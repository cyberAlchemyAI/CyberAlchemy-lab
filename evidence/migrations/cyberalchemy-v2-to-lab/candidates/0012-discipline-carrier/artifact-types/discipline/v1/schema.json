{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type_ref": {
      "const": "cal.artifact-type.discipline/v1"
    },
    "authority_effect": {
      "const": "none"
    },
    "boundaries": {
      "pattern": "\\S",
      "type": "string"
    },
    "capabilities": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "artifact": {
            "additionalProperties": false,
            "properties": {
              "path": {
                "pattern": "\\S",
                "type": "string"
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "type": "object"
          },
          "capability_ref": {
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "artifact",
          "capability_ref"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 2,
      "type": "array"
    },
    "claim_ceiling": {
      "pattern": "\\S",
      "type": "string"
    },
    "discipline_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "evidence_profile": {
      "const": "candidate:validation-material-map/v1"
    },
    "governance_route_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "hardening_move": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "pattern": "\\S",
          "type": "string"
        },
        "completion_evidence_required": {
          "pattern": "\\S",
          "type": "string"
        },
        "owner_ref": {
          "pattern": "\\S",
          "type": "string"
        },
        "route_ref": {
          "pattern": "\\S",
          "type": "string"
        }
      },
      "required": [
        "action",
        "completion_evidence_required",
        "owner_ref",
        "route_ref"
      ],
      "type": "object"
    },
    "maturity_status": {
      "const": "candidate"
    },
    "practice": {
      "pattern": "\\S",
      "type": "string"
    },
    "recurrence_evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "capability_ref": {
            "pattern": "\\S",
            "type": "string"
          },
          "occurrence_id": {
            "pattern": "\\S",
            "type": "string"
          },
          "receipt": {
            "additionalProperties": false,
            "properties": {
              "path": {
                "pattern": "\\S",
                "type": "string"
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "type": "object"
          }
        },
        "required": [
          "capability_ref",
          "occurrence_id",
          "receipt"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 2,
      "type": "array"
    },
    "schema_version": {
      "const": "cal-discipline-record/v1"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "source_direction": {
      "additionalProperties": false,
      "properties": {
        "canonical": {
          "const": "discipline-record.json"
        },
        "human_projection": {
          "const": "DISCIPLINE.md"
        },
        "projection_policy": {
          "const": "generated-only"
        }
      },
      "required": [
        "canonical",
        "human_projection",
        "projection_policy"
      ],
      "type": "object"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "steward_ref": {
      "pattern": "\\S",
      "type": "string"
    }
  },
  "required": [
    "artifact_type_ref",
    "authority_effect",
    "boundaries",
    "capabilities",
    "claim_ceiling",
    "discipline_id",
    "evidence_profile",
    "governance_route_ref",
    "hardening_move",
    "maturity_status",
    "practice",
    "recurrence_evidence",
    "schema_version",
    "scope_ref",
    "source_direction",
    "status",
    "steward_ref"
  ],
  "type": "object"
}
