{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type_ref": {
      "const": "cal.artifact-type.schema-change/v1"
    },
    "authority_effect": {
      "const": "none"
    },
    "change_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "claim_ceiling": {
      "pattern": "\\S",
      "type": "string"
    },
    "compatibility_claim": {
      "enum": [
        "breaking-on-witnesses",
        "compatible-on-witnesses"
      ]
    },
    "migration_obligation": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "postimage": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "\\S",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "preimage": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "\\S",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "reason": {
      "pattern": "\\S",
      "type": "string"
    },
    "residue": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "consequence": {
            "pattern": "\\S",
            "type": "string"
          },
          "missing": {
            "pattern": "\\S",
            "type": "string"
          },
          "owner_ref": {
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "consequence",
          "missing",
          "owner_ref"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "rollback_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "rollout_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "schema_version": {
      "const": "cal-schema-change-record/v1"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "source_direction": {
      "additionalProperties": false,
      "properties": {
        "canonical": {
          "const": "schema-change-record.json"
        },
        "human_projection": {
          "const": "SCHEMA-CHANGE.md"
        },
        "projection_policy": {
          "const": "generated-only"
        }
      },
      "required": [
        "canonical",
        "human_projection",
        "projection_policy"
      ],
      "type": "object"
    },
    "source_evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "pattern": "\\S",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "validator_ref": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "\\S",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "witnesses": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "after": {
            "additionalProperties": false,
            "properties": {
              "path": {
                "pattern": "\\S",
                "type": "string"
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "type": "object"
          },
          "before": {
            "additionalProperties": false,
            "properties": {
              "path": {
                "pattern": "\\S",
                "type": "string"
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "type": "object"
          },
          "expected_after_on_migrated": {
            "const": true
          },
          "expected_after_on_original": {
            "type": "boolean"
          },
          "expected_before": {
            "const": true
          },
          "witness_id": {
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "after",
          "before",
          "expected_after_on_migrated",
          "expected_after_on_original",
          "expected_before",
          "witness_id"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "artifact_type_ref",
    "authority_effect",
    "change_id",
    "claim_ceiling",
    "compatibility_claim",
    "migration_obligation",
    "owner_ref",
    "postimage",
    "preimage",
    "reason",
    "residue",
    "rollback_route",
    "rollout_route",
    "schema_version",
    "scope_ref",
    "source_direction",
    "source_evidence",
    "status",
    "validator_ref",
    "witnesses"
  ],
  "type": "object"
}
