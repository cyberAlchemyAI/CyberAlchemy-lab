{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type_ref": {
      "const": "cal.artifact-type.policy/v1"
    },
    "authority_effect": {
      "const": "none"
    },
    "blocking_questions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "question": {
            "pattern": "\\S",
            "type": "string"
          },
          "question_id": {
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "question",
          "question_id"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
    },
    "challenge_residue_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "challenge_response": {
      "pattern": "\\S",
      "type": "string"
    },
    "claim_ceiling": {
      "pattern": "\\S",
      "type": "string"
    },
    "contradiction_edges": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "policy_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "profile": {
      "const": "candidate:contestability-routing/v1"
    },
    "resolution_gate": {
      "pattern": "\\S",
      "type": "string"
    },
    "schema_version": {
      "const": "cal-policy-record/v1"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "source_direction": {
      "additionalProperties": false,
      "properties": {
        "canonical": {
          "const": "policy-record.json"
        },
        "human_projection": {
          "const": "POLICY.md"
        },
        "projection_policy": {
          "const": "generated-only"
        }
      },
      "required": [
        "canonical",
        "human_projection",
        "projection_policy"
      ],
      "type": "object"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "subject_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "valid_challenge_modes": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "validation_edges": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "artifact_type_ref",
    "authority_effect",
    "blocking_questions",
    "challenge_residue_route",
    "challenge_response",
    "claim_ceiling",
    "contradiction_edges",
    "owner_ref",
    "owner_route",
    "policy_id",
    "profile",
    "resolution_gate",
    "schema_version",
    "scope_ref",
    "source_direction",
    "status",
    "subject_ref",
    "valid_challenge_modes",
    "validation_edges"
  ],
  "type": "object"
}
