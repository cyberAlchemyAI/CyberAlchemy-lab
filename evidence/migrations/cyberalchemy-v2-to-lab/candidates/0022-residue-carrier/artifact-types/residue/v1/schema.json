{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type_ref": {
      "const": "cal.artifact-type.residue/v1"
    },
    "authority_effect": {
      "const": "none"
    },
    "claim_ceiling": {
      "pattern": "\\S",
      "type": "string"
    },
    "closure_condition": {
      "pattern": "\\S",
      "type": "string"
    },
    "observed_remainder": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "pattern": "\\S",
            "type": "string"
          },
          "issue": {
            "enum": [
              "missing",
              "changed"
            ]
          }
        },
        "required": [
          "field",
          "issue"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
    },
    "owner_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "preservation_condition": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "pattern": "\\S",
          "type": "string"
        },
        "required_fields": {
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "description",
        "required_fields"
      ],
      "type": "object"
    },
    "profile": {
      "const": "candidate:json-field-preservation/v1"
    },
    "residue_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "residue_type": {
      "const": "representation-loss"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "\\S",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "cal-residue-record/v1"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "\\S",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "source_direction": {
      "additionalProperties": false,
      "properties": {
        "canonical": {
          "const": "residue-record.json"
        },
        "human_projection": {
          "const": "RESIDUE.md"
        },
        "projection_policy": {
          "const": "generated-only"
        }
      },
      "required": [
        "canonical",
        "human_projection",
        "projection_policy"
      ],
      "type": "object"
    },
    "source_operation": {
      "pattern": "\\S",
      "type": "string"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "treatment": {
      "enum": [
        "repair",
        "type",
        "gate",
        "climb",
        "accept",
        "defer"
      ]
    },
    "treatment_route": {
      "pattern": "\\S",
      "type": "string"
    }
  },
  "required": [
    "artifact_type_ref",
    "authority_effect",
    "claim_ceiling",
    "closure_condition",
    "observed_remainder",
    "owner_route",
    "preservation_condition",
    "profile",
    "residue_id",
    "residue_type",
    "result",
    "schema_version",
    "scope_ref",
    "source",
    "source_direction",
    "source_operation",
    "status",
    "treatment",
    "treatment_route"
  ],
  "type": "object"
}
