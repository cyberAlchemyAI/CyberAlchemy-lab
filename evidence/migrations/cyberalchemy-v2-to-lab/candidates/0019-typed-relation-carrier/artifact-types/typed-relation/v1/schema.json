{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type_ref": {
      "const": "cal.artifact-type.typed-relation/v1"
    },
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "claim_ceiling": {
      "pattern": "\\S",
      "type": "string"
    },
    "declared_effect": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "const": "validation"
        },
        "description": {
          "pattern": "\\S",
          "type": "string"
        }
      },
      "required": [
        "category",
        "description"
      ],
      "type": "object"
    },
    "direction": {
      "const": "source-to-target"
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "pattern": "\\S",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
    },
    "owner_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "profile": {
      "const": "candidate:artifact-definition-binding/v1"
    },
    "relation_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "relation_kind_ref": {
      "const": "candidate:binds-definition/v1"
    },
    "schema_version": {
      "const": "cal-typed-relation-record/v1"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "binding": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "pattern": "\\S",
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "type": "object"
        },
        "object_ref": {
          "pattern": "\\S",
          "type": "string"
        }
      },
      "required": [
        "binding",
        "object_ref"
      ],
      "type": "object"
    },
    "source_direction": {
      "additionalProperties": false,
      "properties": {
        "canonical": {
          "const": "typed-relation-record.json"
        },
        "human_projection": {
          "const": "TYPED-RELATION.md"
        },
        "projection_policy": {
          "const": "generated-only"
        }
      },
      "required": [
        "canonical",
        "human_projection",
        "projection_policy"
      ],
      "type": "object"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "target": {
      "additionalProperties": false,
      "properties": {
        "binding": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "pattern": "\\S",
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "type": "object"
        },
        "object_ref": {
          "pattern": "\\S",
          "type": "string"
        }
      },
      "required": [
        "binding",
        "object_ref"
      ],
      "type": "object"
    }
  },
  "required": [
    "artifact_type_ref",
    "authority_effect",
    "challenge_route",
    "claim_ceiling",
    "declared_effect",
    "direction",
    "evidence",
    "owner_route",
    "profile",
    "relation_id",
    "relation_kind_ref",
    "schema_version",
    "scope_ref",
    "source",
    "source_direction",
    "status",
    "target"
  ],
  "type": "object"
}
