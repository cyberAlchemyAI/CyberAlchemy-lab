{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "action_id": {
            "pattern": "\\S",
            "type": "string"
          },
          "gate_refs": {
            "items": {
              "pattern": "\\S",
              "type": "string"
            },
            "maxItems": 100,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "instruction": {
            "pattern": "\\S",
            "type": "string"
          },
          "reads": {
            "items": {
              "pattern": "\\S",
              "type": "string"
            },
            "maxItems": 100,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "role_ref": {
            "pattern": "\\S",
            "type": "string"
          },
          "writes": {
            "items": {
              "pattern": "\\S",
              "type": "string"
            },
            "maxItems": 100,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "action_id",
          "gate_refs",
          "instruction",
          "reads",
          "role_ref",
          "writes"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
    },
    "artifact_type_ref": {
      "const": "cal.artifact-type.method/v1"
    },
    "authority_effect": {
      "const": "none"
    },
    "boundary": {
      "pattern": "\\S",
      "type": "string"
    },
    "claim_ceiling": {
      "pattern": "\\S",
      "type": "string"
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "pattern": "\\S",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
    },
    "gates": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "condition": {
            "pattern": "\\S",
            "type": "string"
          },
          "gate_id": {
            "pattern": "\\S",
            "type": "string"
          },
          "on_failure": {
            "const": "stop-and-record-residue"
          },
          "role_ref": {
            "pattern": "\\S",
            "type": "string"
          },
          "subject_refs": {
            "items": {
              "pattern": "\\S",
              "type": "string"
            },
            "maxItems": 100,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "condition",
          "gate_id",
          "on_failure",
          "role_ref",
          "subject_refs"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
    },
    "inputs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "pattern": "\\S",
            "type": "string"
          },
          "slot_id": {
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "description",
          "slot_id"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
    },
    "method_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "outputs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "pattern": "\\S",
            "type": "string"
          },
          "slot_id": {
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "description",
          "slot_id"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "purpose": {
      "pattern": "\\S",
      "type": "string"
    },
    "recomposition_rule": {
      "pattern": "\\S",
      "type": "string"
    },
    "residue_rule": {
      "additionalProperties": false,
      "properties": {
        "instruction": {
          "pattern": "\\S",
          "type": "string"
        },
        "owner_ref": {
          "pattern": "\\S",
          "type": "string"
        },
        "route_ref": {
          "pattern": "\\S",
          "type": "string"
        }
      },
      "required": [
        "instruction",
        "owner_ref",
        "route_ref"
      ],
      "type": "object"
    },
    "reuse": {
      "additionalProperties": false,
      "properties": {
        "fixed_fields": {
          "items": {
            "enum": [
              "scope_ref",
              "inputs",
              "actions",
              "roles",
              "gates",
              "outputs",
              "evidence",
              "residue_rule",
              "validation_rule",
              "recomposition_rule",
              "boundary"
            ]
          },
          "maxItems": 100,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "specializable_fields": {
          "items": {
            "enum": [
              "scope_ref",
              "inputs",
              "actions",
              "roles",
              "gates",
              "outputs",
              "evidence",
              "residue_rule",
              "validation_rule",
              "recomposition_rule",
              "boundary"
            ]
          },
          "maxItems": 100,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "specialization_rule": {
          "pattern": "\\S",
          "type": "string"
        }
      },
      "required": [
        "fixed_fields",
        "specializable_fields",
        "specialization_rule"
      ],
      "type": "object"
    },
    "roles": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": "cal-method-record/v1"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "source_direction": {
      "additionalProperties": false,
      "properties": {
        "canonical": {
          "const": "method-record.json"
        },
        "human_projection": {
          "const": "METHOD.md"
        },
        "projection_policy": {
          "const": "generated-only"
        }
      },
      "required": [
        "canonical",
        "human_projection",
        "projection_policy"
      ],
      "type": "object"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "validation_rule": {
      "additionalProperties": false,
      "properties": {
        "completion_condition": {
          "pattern": "\\S",
          "type": "string"
        },
        "required_gate_refs": {
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "completion_condition",
        "required_gate_refs"
      ],
      "type": "object"
    }
  },
  "required": [
    "actions",
    "artifact_type_ref",
    "authority_effect",
    "boundary",
    "claim_ceiling",
    "evidence",
    "gates",
    "inputs",
    "method_id",
    "outputs",
    "owner_ref",
    "purpose",
    "recomposition_rule",
    "residue_rule",
    "reuse",
    "roles",
    "schema_version",
    "scope_ref",
    "source_direction",
    "status",
    "validation_rule"
  ],
  "type": "object"
}
