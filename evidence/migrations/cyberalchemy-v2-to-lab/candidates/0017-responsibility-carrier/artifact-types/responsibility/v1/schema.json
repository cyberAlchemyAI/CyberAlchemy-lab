{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type_ref": {
      "const": "cal.artifact-type.responsibility/v1"
    },
    "authority_boundary": {
      "pattern": "\\S",
      "type": "string"
    },
    "authority_effect": {
      "const": "none"
    },
    "claim_ceiling": {
      "pattern": "\\S",
      "type": "string"
    },
    "criteria": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "criterion_id": {
            "pattern": "\\S",
            "type": "string"
          },
          "description": {
            "pattern": "\\S",
            "type": "string"
          },
          "expected": {
            "type": [
              "string",
              "integer",
              "boolean"
            ]
          },
          "field": {
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "criterion_id",
          "description",
          "expected",
          "field"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
    },
    "escalation_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "obligation": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "profile": {
      "const": "candidate:bound-json-obligation/v1"
    },
    "responsibility_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "review_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "schema_version": {
      "const": "cal-responsibility-record/v1"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "source_direction": {
      "additionalProperties": false,
      "properties": {
        "canonical": {
          "const": "responsibility-record.json"
        },
        "human_projection": {
          "const": "RESPONSIBILITY.md"
        },
        "projection_policy": {
          "const": "generated-only"
        }
      },
      "required": [
        "canonical",
        "human_projection",
        "projection_policy"
      ],
      "type": "object"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "subject": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "\\S",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    }
  },
  "required": [
    "artifact_type_ref",
    "authority_boundary",
    "authority_effect",
    "claim_ceiling",
    "criteria",
    "escalation_route",
    "obligation",
    "owner_ref",
    "profile",
    "responsibility_id",
    "review_route",
    "schema_version",
    "scope_ref",
    "source_direction",
    "status",
    "subject"
  ],
  "type": "object"
}
