{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adopted_to_proceed": {
      "const": false
    },
    "artifact_type_ref": {
      "const": "cal.artifact-type.hypothesis/v1"
    },
    "authority_effect": {
      "const": "none"
    },
    "claim_ceiling": {
      "pattern": "\\S",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "falsification_condition": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "proposition": {
      "pattern": "\\S",
      "type": "string"
    },
    "proposition_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "schema_version": {
      "const": "cyberalchemy-lab-hypothesis/v1"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "source_direction": {
      "additionalProperties": false,
      "properties": {
        "canonical": {
          "const": "proposition.json"
        },
        "human_projection": {
          "const": "PROPOSITION.md"
        },
        "projection_policy": {
          "const": "generated-only"
        }
      },
      "required": [
        "canonical",
        "human_projection",
        "projection_policy"
      ],
      "type": "object"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "support_condition": {
      "pattern": "\\S",
      "type": "string"
    },
    "test_method": {
      "pattern": "\\S",
      "type": "string"
    },
    "truth_posture": {
      "const": "unestablished"
    }
  },
  "required": [
    "adopted_to_proceed",
    "artifact_type_ref",
    "authority_effect",
    "claim_ceiling",
    "evidence_refs",
    "falsification_condition",
    "owner_ref",
    "proposition",
    "proposition_id",
    "schema_version",
    "scope_ref",
    "source_direction",
    "status",
    "support_condition",
    "test_method",
    "truth_posture"
  ],
  "title": "Hypothesis candidate instance",
  "type": "object"
}
