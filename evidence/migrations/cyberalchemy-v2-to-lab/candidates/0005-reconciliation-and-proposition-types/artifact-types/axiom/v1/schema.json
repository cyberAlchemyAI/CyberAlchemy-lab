{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type_ref": {
      "const": "cal.artifact-type.axiom/v1"
    },
    "authority_effect": {
      "const": "none"
    },
    "claim_ceiling": {
      "pattern": "\\S",
      "type": "string"
    },
    "commitment": {
      "const": "high"
    },
    "derived_within_scope": {
      "const": false
    },
    "downstream_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "minItems": 2,
      "type": "array",
      "uniqueItems": true
    },
    "evidence_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "proposition": {
      "pattern": "\\S",
      "type": "string"
    },
    "proposition_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "revision_impact": {
      "pattern": "\\S",
      "type": "string"
    },
    "schema_version": {
      "const": "cyberalchemy-lab-axiom/v1"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "source_direction": {
      "additionalProperties": false,
      "properties": {
        "canonical": {
          "const": "proposition.json"
        },
        "human_projection": {
          "const": "PROPOSITION.md"
        },
        "projection_policy": {
          "const": "generated-only"
        }
      },
      "required": [
        "canonical",
        "human_projection",
        "projection_policy"
      ],
      "type": "object"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "subject": {
      "const": "world-or-domain"
    },
    "truth_posture": {
      "const": "taken-as-given-within-scope"
    }
  },
  "required": [
    "artifact_type_ref",
    "authority_effect",
    "claim_ceiling",
    "commitment",
    "derived_within_scope",
    "downstream_refs",
    "evidence_refs",
    "owner_ref",
    "proposition",
    "proposition_id",
    "revision_impact",
    "schema_version",
    "scope_ref",
    "source_direction",
    "status",
    "subject",
    "truth_posture"
  ],
  "title": "Axiom candidate instance",
  "type": "object"
}
