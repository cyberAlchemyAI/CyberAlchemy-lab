{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "amendment_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "artifact_type_ref": {
      "const": "cal.artifact-type.authority-model/v1"
    },
    "authority_effect": {
      "const": "none"
    },
    "authority_kinds": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "claim_ceiling": {
      "pattern": "\\S",
      "type": "string"
    },
    "conflict_rule": {
      "const": "reject-overlapping-kind-posture-rules"
    },
    "effects": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "model_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "operations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "effect_ref": {
            "pattern": "\\S",
            "type": "string"
          },
          "operation_id": {
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "effect_ref",
          "operation_id"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "postures": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "profile": {
      "const": "candidate:closed-authority-routing/v1"
    },
    "rules": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "allowed_effects": {
            "items": {
              "pattern": "\\S",
              "type": "string"
            },
            "maxItems": 100,
            "minItems": 0,
            "type": "array",
            "uniqueItems": true
          },
          "blocked_effects": {
            "items": {
              "pattern": "\\S",
              "type": "string"
            },
            "maxItems": 100,
            "minItems": 0,
            "type": "array",
            "uniqueItems": true
          },
          "gate_ref": {
            "pattern": "\\S",
            "type": "string"
          },
          "kind_ref": {
            "pattern": "\\S",
            "type": "string"
          },
          "non_collapse_rules": {
            "items": {
              "pattern": "\\S",
              "type": "string"
            },
            "maxItems": 100,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "owner_route": {
            "pattern": "\\S",
            "type": "string"
          },
          "posture_ref": {
            "pattern": "\\S",
            "type": "string"
          },
          "rule_id": {
            "pattern": "\\S",
            "type": "string"
          },
          "validation_surface_ref": {
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "allowed_effects",
          "blocked_effects",
          "gate_ref",
          "kind_ref",
          "non_collapse_rules",
          "owner_route",
          "posture_ref",
          "rule_id",
          "validation_surface_ref"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "cal-authority-model-record/v1"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "source_direction": {
      "additionalProperties": false,
      "properties": {
        "canonical": {
          "const": "authority-model-record.json"
        },
        "human_projection": {
          "const": "AUTHORITY-MODEL.md"
        },
        "projection_policy": {
          "const": "generated-only"
        }
      },
      "required": [
        "canonical",
        "human_projection",
        "projection_policy"
      ],
      "type": "object"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "unknown_kind_rule": {
      "const": "blocked-until-owner-amends-model"
    }
  },
  "required": [
    "amendment_route",
    "artifact_type_ref",
    "authority_effect",
    "authority_kinds",
    "claim_ceiling",
    "conflict_rule",
    "effects",
    "model_id",
    "operations",
    "owner_ref",
    "postures",
    "profile",
    "rules",
    "schema_version",
    "scope_ref",
    "source_direction",
    "status",
    "unknown_kind_rule"
  ],
  "type": "object"
}
