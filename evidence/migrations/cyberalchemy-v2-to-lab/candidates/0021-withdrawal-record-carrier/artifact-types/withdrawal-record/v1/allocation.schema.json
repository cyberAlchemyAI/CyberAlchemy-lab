{
  "additionalProperties": false,
  "properties": {
    "proposed_ids": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 10000,
      "type": "array",
      "uniqueItems": true
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "withdrawal_record": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "\\S",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    }
  },
  "required": [
    "proposed_ids",
    "scope_ref",
    "withdrawal_record"
  ],
  "type": "object"
}
