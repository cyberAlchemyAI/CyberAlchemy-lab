{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type_ref": {
      "const": "cal.artifact-type.withdrawal-record/v1"
    },
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "claim_ceiling": {
      "pattern": "\\S",
      "type": "string"
    },
    "normalization": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "\\S",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "owner_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "profile": {
      "const": "candidate:normalized-withdrawal-reservation/v1"
    },
    "reason": {
      "pattern": "\\S",
      "type": "string"
    },
    "record_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "reservations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "permanently_reserved": {
            "const": true
          },
          "retired_id": {
            "pattern": "\\S",
            "type": "string"
          },
          "successor_id": {
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "permanently_reserved",
          "retired_id",
          "successor_id"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "cal-withdrawal-record/v1"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "source_direction": {
      "additionalProperties": false,
      "properties": {
        "canonical": {
          "const": "withdrawal-record.json"
        },
        "human_projection": {
          "const": "WITHDRAWAL-RECORD.md"
        },
        "projection_policy": {
          "const": "generated-only"
        }
      },
      "required": [
        "canonical",
        "human_projection",
        "projection_policy"
      ],
      "type": "object"
    },
    "status": {
      "const": "candidate-unadmitted"
    }
  },
  "required": [
    "artifact_type_ref",
    "authority_effect",
    "challenge_route",
    "claim_ceiling",
    "normalization",
    "owner_route",
    "profile",
    "reason",
    "record_id",
    "reservations",
    "schema_version",
    "scope_ref",
    "source_direction",
    "status"
  ],
  "type": "object"
}
