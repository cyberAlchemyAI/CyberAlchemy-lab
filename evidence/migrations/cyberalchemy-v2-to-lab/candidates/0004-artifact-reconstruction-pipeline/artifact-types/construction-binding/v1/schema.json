{
  "$id": "https://cyberalchemy.local/schemas/reconstruction/cyberalchemy-lab-construction-binding/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type_ref": {
      "const": "cal.artifact-type.construction-binding/v1"
    },
    "authority_effect": {
      "const": "none"
    },
    "binding_id": {
      "minLength": 1,
      "type": "string"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "profile_ref": {
      "minLength": 1,
      "type": "string"
    },
    "profile_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "cyberalchemy-lab-construction-binding/v1"
    },
    "source_direction": {
      "additionalProperties": false,
      "properties": {
        "canonical": {
          "minLength": 1,
          "type": "string"
        },
        "human_projection": {
          "minLength": 1,
          "type": "string"
        },
        "projection_policy": {
          "const": "generated-only"
        }
      },
      "required": [
        "canonical",
        "human_projection",
        "projection_policy"
      ],
      "type": "object"
    },
    "stage_bindings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "artifact_ref": {
            "minLength": 1,
            "type": "string"
          },
          "artifact_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "stage_id": {
            "minLength": 1,
            "type": "string"
          },
          "state": {
            "enum": [
              "planned",
              "prototype",
              "tested-product"
            ]
          }
        },
        "required": [
          "stage_id",
          "artifact_ref",
          "artifact_sha256",
          "state"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "subject_ref": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "binding_id",
    "artifact_type_ref",
    "status",
    "authority_effect",
    "owner_ref",
    "subject_ref",
    "profile_ref",
    "profile_sha256",
    "stage_bindings",
    "source_direction",
    "claim_ceiling"
  ],
  "title": "Construction Binding v1",
  "type": "object"
}
