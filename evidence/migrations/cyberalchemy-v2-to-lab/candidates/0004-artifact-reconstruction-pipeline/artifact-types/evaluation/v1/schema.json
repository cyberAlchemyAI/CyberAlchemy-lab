{
  "$id": "https://cyberalchemy.local/schemas/reconstruction/cyberalchemy-lab-evaluation/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "aggregate_result": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_EVALUABLE"
      ]
    },
    "artifact_type_ref": {
      "const": "cal.artifact-type.evaluation/v1"
    },
    "authority_effect": {
      "const": "none"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "evaluation_id": {
      "minLength": 1,
      "type": "string"
    },
    "outcomes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "blockers": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "check_id": {
            "minLength": 1,
            "type": "string"
          },
          "evidence_refs": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_EVALUABLE"
            ]
          }
        },
        "required": [
          "check_id",
          "result",
          "evidence_refs",
          "blockers"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "profile_ref": {
      "minLength": 1,
      "type": "string"
    },
    "profile_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "cyberalchemy-lab-evaluation/v1"
    },
    "source_direction": {
      "additionalProperties": false,
      "properties": {
        "canonical": {
          "minLength": 1,
          "type": "string"
        },
        "human_projection": {
          "minLength": 1,
          "type": "string"
        },
        "projection_policy": {
          "const": "generated-only"
        }
      },
      "required": [
        "canonical",
        "human_projection",
        "projection_policy"
      ],
      "type": "object"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "subject_ref": {
      "minLength": 1,
      "type": "string"
    },
    "subject_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "evaluation_id",
    "artifact_type_ref",
    "status",
    "authority_effect",
    "owner_ref",
    "profile_ref",
    "profile_sha256",
    "subject_ref",
    "subject_sha256",
    "outcomes",
    "aggregate_result",
    "source_direction",
    "claim_ceiling"
  ],
  "title": "Evaluation v1",
  "type": "object"
}
