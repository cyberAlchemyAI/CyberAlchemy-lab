{
  "$id": "https://cyberalchemy.local/schemas/reconstruction/cyberalchemy-lab-evaluation-profile/v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type_ref": {
      "const": "cal.artifact-type.evaluation-profile/v2"
    },
    "authority_effect": {
      "const": "none"
    },
    "checks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "check_id": {
            "minLength": 1,
            "type": "string"
          },
          "depends_on": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "purpose": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "check_id",
          "purpose",
          "depends_on"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "decision_rule": {
      "minLength": 1,
      "type": "string"
    },
    "evaluation_kind": {
      "minLength": 1,
      "type": "string"
    },
    "evaluation_mode": {
      "const": "collect-all"
    },
    "outcomes": {
      "const": [
        "PASS",
        "FAIL",
        "NOT_EVALUABLE"
      ]
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "profile_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "cyberalchemy-lab-evaluation-profile/v2"
    },
    "source_direction": {
      "additionalProperties": false,
      "properties": {
        "canonical": {
          "minLength": 1,
          "type": "string"
        },
        "human_projection": {
          "minLength": 1,
          "type": "string"
        },
        "projection_policy": {
          "const": "generated-only"
        }
      },
      "required": [
        "canonical",
        "human_projection",
        "projection_policy"
      ],
      "type": "object"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "subject_artifact_type_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "profile_id",
    "artifact_type_ref",
    "status",
    "authority_effect",
    "owner_ref",
    "evaluation_kind",
    "subject_artifact_type_refs",
    "outcomes",
    "evaluation_mode",
    "checks",
    "decision_rule",
    "source_direction",
    "claim_ceiling"
  ],
  "title": "Evaluation Profile v2",
  "type": "object"
}
