{
  "$id": "https://cyberalchemy.local/schemas/reconstruction/cyberalchemy-lab-implementation-binding/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type_ref": {
      "const": "cal.artifact-type.implementation-binding/v1"
    },
    "authority_effect": {
      "const": "none"
    },
    "binding_id": {
      "minLength": 1,
      "type": "string"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "implementation_targets": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "obligation_refs": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "path",
          "obligation_refs"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "cyberalchemy-lab-implementation-binding/v1"
    },
    "source_direction": {
      "additionalProperties": false,
      "properties": {
        "canonical": {
          "minLength": 1,
          "type": "string"
        },
        "human_projection": {
          "minLength": 1,
          "type": "string"
        },
        "projection_policy": {
          "const": "generated-only"
        }
      },
      "required": [
        "canonical",
        "human_projection",
        "projection_policy"
      ],
      "type": "object"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "system_model_ref": {
      "minLength": 1,
      "type": "string"
    },
    "system_model_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "binding_id",
    "artifact_type_ref",
    "status",
    "authority_effect",
    "owner_ref",
    "system_model_ref",
    "system_model_sha256",
    "implementation_targets",
    "source_direction",
    "claim_ceiling"
  ],
  "title": "Implementation Binding v1",
  "type": "object"
}
