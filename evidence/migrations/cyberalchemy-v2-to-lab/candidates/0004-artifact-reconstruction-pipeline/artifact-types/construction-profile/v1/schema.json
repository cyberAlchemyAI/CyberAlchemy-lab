{
  "$id": "https://cyberalchemy.local/schemas/reconstruction/cyberalchemy-lab-construction-profile/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval_boundary": {
      "minLength": 1,
      "type": "string"
    },
    "artifact_type_ref": {
      "const": "cal.artifact-type.construction-profile/v1"
    },
    "authority_effect": {
      "const": "none"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "ordering_rule": {
      "minLength": 1,
      "type": "string"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "profile_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "cyberalchemy-lab-construction-profile/v1"
    },
    "source_direction": {
      "additionalProperties": false,
      "properties": {
        "canonical": {
          "minLength": 1,
          "type": "string"
        },
        "human_projection": {
          "minLength": 1,
          "type": "string"
        },
        "projection_policy": {
          "const": "generated-only"
        }
      },
      "required": [
        "canonical",
        "human_projection",
        "projection_policy"
      ],
      "type": "object"
    },
    "stages": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidence_kind": {
            "minLength": 1,
            "type": "string"
          },
          "predecessor_refs": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "stage_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "stage_id",
          "predecessor_refs",
          "evidence_kind"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "status": {
      "const": "candidate-unadmitted"
    }
  },
  "required": [
    "schema_version",
    "profile_id",
    "artifact_type_ref",
    "status",
    "authority_effect",
    "owner_ref",
    "stages",
    "ordering_rule",
    "approval_boundary",
    "source_direction",
    "claim_ceiling"
  ],
  "title": "Construction Profile v1",
  "type": "object"
}
