{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "additionalProperties": false,
      "properties": {
        "principal_ref": {
          "pattern": "\\S",
          "type": "string"
        },
        "role_ref": {
          "pattern": "\\S",
          "type": "string"
        }
      },
      "required": [
        "principal_ref",
        "role_ref"
      ],
      "type": "object"
    },
    "artifact_type_ref": {
      "const": "cal.artifact-type.decision/v1"
    },
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "claim_ceiling": {
      "pattern": "\\S",
      "type": "string"
    },
    "decision_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "declared_effect": {
      "pattern": "\\S",
      "type": "string"
    },
    "proposal": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "\\S",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "proposal_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "provenance_kind": {
      "enum": [
        "simulation",
        "recorded-owner-statement"
      ]
    },
    "rationale": {
      "pattern": "\\S",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "schema_version": {
      "const": "cyberalchemy-lab-decision/v1"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "selected_option_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "source_direction": {
      "additionalProperties": false,
      "properties": {
        "canonical": {
          "const": "decision.json"
        },
        "human_projection": {
          "const": "DECISION.md"
        },
        "projection_policy": {
          "const": "generated-only"
        }
      },
      "required": [
        "canonical",
        "human_projection",
        "projection_policy"
      ],
      "type": "object"
    },
    "statement": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "\\S",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "subject": {
      "additionalProperties": false,
      "properties": {
        "material_manifest": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "pattern": "\\S",
              "type": "string"
            },
            "sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "type": "object"
        },
        "path": {
          "pattern": "\\S",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "subject_ref": {
          "pattern": "\\S",
          "type": "string"
        }
      },
      "required": [
        "material_manifest",
        "path",
        "sha256",
        "subject_ref"
      ],
      "type": "object"
    },
    "supersession_policy": {
      "const": "new-record-required-preserve-prior-bytes"
    }
  },
  "required": [
    "actor",
    "artifact_type_ref",
    "authority_effect",
    "challenge_route",
    "claim_ceiling",
    "decision_id",
    "declared_effect",
    "proposal",
    "proposal_id",
    "provenance_kind",
    "rationale",
    "recorded_at",
    "schema_version",
    "scope_ref",
    "selected_option_id",
    "source_direction",
    "statement",
    "status",
    "subject",
    "supersession_policy"
  ],
  "title": "Decision candidate bound to an exact proposal and statement",
  "type": "object"
}
