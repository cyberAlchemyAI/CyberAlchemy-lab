{
  "additionalProperties": false,
  "properties": {
    "actor": {
      "additionalProperties": false,
      "properties": {
        "principal_ref": {
          "pattern": "\\S",
          "type": "string"
        },
        "role_ref": {
          "pattern": "\\S",
          "type": "string"
        }
      },
      "required": [
        "principal_ref",
        "role_ref"
      ],
      "type": "object"
    },
    "authority_effect": {
      "const": "none"
    },
    "proposal_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "proposal_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "provenance_kind": {
      "enum": [
        "simulation",
        "recorded-owner-statement"
      ]
    },
    "recorded_at": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "selected_option_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "statement_text": {
      "pattern": "\\S",
      "type": "string"
    },
    "subject": {
      "additionalProperties": false,
      "properties": {
        "material_manifest": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "pattern": "\\S",
              "type": "string"
            },
            "sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "type": "object"
        },
        "path": {
          "pattern": "\\S",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "subject_ref": {
          "pattern": "\\S",
          "type": "string"
        }
      },
      "required": [
        "material_manifest",
        "path",
        "sha256",
        "subject_ref"
      ],
      "type": "object"
    }
  },
  "required": [
    "actor",
    "authority_effect",
    "proposal_id",
    "proposal_sha256",
    "provenance_kind",
    "recorded_at",
    "scope_ref",
    "selected_option_id",
    "statement_text",
    "subject"
  ],
  "type": "object"
}
