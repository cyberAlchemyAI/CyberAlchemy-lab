{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assignee_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "assignment_basis": {
      "pattern": "\\S",
      "type": "string"
    },
    "authority_effect": {
      "const": "none"
    },
    "kind": {
      "const": "role-assignment"
    },
    "node_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "period": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "start": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "end",
        "start"
      ],
      "type": "object"
    },
    "role_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "status": {
      "const": "candidate-unadmitted"
    }
  },
  "required": [
    "assignee_ref",
    "assignment_basis",
    "authority_effect",
    "kind",
    "node_id",
    "owner_ref",
    "period",
    "role_ref",
    "scope_ref",
    "status"
  ],
  "type": "object"
}
