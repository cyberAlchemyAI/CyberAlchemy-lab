{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "identity_boundary": {
      "pattern": "\\S",
      "type": "string"
    },
    "kind": {
      "const": "context"
    },
    "node_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "profile_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "purpose": {
      "pattern": "\\S",
      "type": "string"
    },
    "relevance": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "status": {
      "const": "candidate-unadmitted"
    }
  },
  "required": [
    "authority_effect",
    "identity_boundary",
    "kind",
    "node_id",
    "owner_ref",
    "profile_ref",
    "purpose",
    "relevance",
    "scope_ref",
    "status"
  ],
  "type": "object"
}
