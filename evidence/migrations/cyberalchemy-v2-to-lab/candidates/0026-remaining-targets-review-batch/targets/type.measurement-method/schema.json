{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "conditions": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "kind": {
      "const": "measurement-method"
    },
    "node_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "procedure": {
      "pattern": "\\S",
      "type": "string"
    },
    "property": {
      "pattern": "\\S",
      "type": "string"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "uncertainty_rule": {
      "pattern": "\\S",
      "type": "string"
    },
    "unit": {
      "pattern": "\\S",
      "type": "string"
    }
  },
  "required": [
    "authority_effect",
    "conditions",
    "kind",
    "node_id",
    "owner_ref",
    "procedure",
    "property",
    "scope_ref",
    "status",
    "uncertainty_rule",
    "unit"
  ],
  "type": "object"
}
