{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "anchor_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "authority_effect": {
      "const": "none"
    },
    "budget": {
      "minimum": 1,
      "type": "integer"
    },
    "context_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "kind": {
      "const": "context-request"
    },
    "node_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "policy_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "question": {
      "pattern": "\\S",
      "type": "string"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "status": {
      "const": "candidate-unadmitted"
    }
  },
  "required": [
    "anchor_refs",
    "authority_effect",
    "budget",
    "context_ref",
    "kind",
    "node_id",
    "owner_ref",
    "policy_ref",
    "question",
    "scope_ref",
    "status"
  ],
  "type": "object"
}
