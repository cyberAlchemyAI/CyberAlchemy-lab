{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "kind": {
      "const": "measurement-result"
    },
    "method_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "node_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "type": "string"
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "receipt_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "subject_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "uncertainty": {
      "minimum": 0,
      "type": "number"
    },
    "unit": {
      "pattern": "\\S",
      "type": "string"
    },
    "value": {
      "type": "number"
    }
  },
  "required": [
    "authority_effect",
    "kind",
    "method_ref",
    "node_id",
    "observed_at",
    "owner_ref",
    "receipt_ref",
    "scope_ref",
    "status",
    "subject_ref",
    "uncertainty",
    "unit",
    "value"
  ],
  "type": "object"
}
