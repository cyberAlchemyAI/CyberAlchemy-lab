{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "identity_boundary": {
      "pattern": "\\S",
      "type": "string"
    },
    "kind": {
      "const": "team"
    },
    "name": {
      "pattern": "\\S",
      "type": "string"
    },
    "node_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "purpose": {
      "pattern": "\\S",
      "type": "string"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "status": {
      "const": "candidate-unadmitted"
    }
  },
  "required": [
    "authority_effect",
    "identity_boundary",
    "kind",
    "name",
    "node_id",
    "owner_ref",
    "owner_route",
    "purpose",
    "scope_ref",
    "status"
  ],
  "type": "object"
}
