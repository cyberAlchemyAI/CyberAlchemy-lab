{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "asserted_identifier": {
      "pattern": "\\S",
      "type": "string"
    },
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "evidence_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "kind": {
      "const": "identity-claim"
    },
    "node_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "person_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "status": {
      "const": "candidate-unadmitted"
    }
  },
  "required": [
    "asserted_identifier",
    "authority_effect",
    "challenge_route",
    "evidence_ref",
    "kind",
    "node_id",
    "owner_ref",
    "person_ref",
    "scope_ref",
    "status"
  ],
  "type": "object"
}
