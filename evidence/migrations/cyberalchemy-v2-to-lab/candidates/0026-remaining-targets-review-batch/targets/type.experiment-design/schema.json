{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "conditions": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "kind": {
      "const": "experiment-design"
    },
    "measures": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "node_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "project_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "protocol_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "question": {
      "pattern": "\\S",
      "type": "string"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "stop_conditions": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "subject_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "variables": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "authority_effect",
    "conditions",
    "kind",
    "measures",
    "node_id",
    "owner_ref",
    "project_ref",
    "protocol_ref",
    "question",
    "scope_ref",
    "status",
    "stop_conditions",
    "subject_ref",
    "variables"
  ],
  "type": "object"
}
