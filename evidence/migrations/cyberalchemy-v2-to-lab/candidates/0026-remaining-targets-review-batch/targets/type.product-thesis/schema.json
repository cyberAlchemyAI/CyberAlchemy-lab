{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assumptions": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "audience": {
      "pattern": "\\S",
      "type": "string"
    },
    "authority_effect": {
      "const": "none"
    },
    "kind": {
      "const": "product-thesis"
    },
    "node_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "problem": {
      "pattern": "\\S",
      "type": "string"
    },
    "product_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "revision_criteria": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "value_proposition": {
      "pattern": "\\S",
      "type": "string"
    }
  },
  "required": [
    "assumptions",
    "audience",
    "authority_effect",
    "kind",
    "node_id",
    "owner_ref",
    "problem",
    "product_ref",
    "revision_criteria",
    "scope_ref",
    "status",
    "value_proposition"
  ],
  "type": "object"
}
