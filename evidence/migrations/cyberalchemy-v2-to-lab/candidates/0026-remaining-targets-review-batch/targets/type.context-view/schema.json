{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "kind": {
      "const": "context-view"
    },
    "node_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "request_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "residue_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "selected_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "selection_basis": {
      "pattern": "\\S",
      "type": "string"
    },
    "status": {
      "const": "candidate-unadmitted"
    }
  },
  "required": [
    "authority_effect",
    "kind",
    "node_id",
    "owner_ref",
    "request_ref",
    "residue_refs",
    "scope_ref",
    "selected_refs",
    "selection_basis",
    "status"
  ],
  "type": "object"
}
