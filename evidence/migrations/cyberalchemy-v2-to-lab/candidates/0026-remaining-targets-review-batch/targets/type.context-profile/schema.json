{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowed_anchor_kinds": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "authority_effect": {
      "const": "none"
    },
    "identity_fields": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "kind": {
      "const": "context-profile"
    },
    "maximum_anchors": {
      "minimum": 1,
      "type": "integer"
    },
    "minimum_anchors": {
      "minimum": 0,
      "type": "integer"
    },
    "node_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "successor_rule": {
      "pattern": "\\S",
      "type": "string"
    }
  },
  "required": [
    "allowed_anchor_kinds",
    "authority_effect",
    "identity_fields",
    "kind",
    "maximum_anchors",
    "minimum_anchors",
    "node_id",
    "owner_ref",
    "scope_ref",
    "status",
    "successor_rule"
  ],
  "type": "object"
}
