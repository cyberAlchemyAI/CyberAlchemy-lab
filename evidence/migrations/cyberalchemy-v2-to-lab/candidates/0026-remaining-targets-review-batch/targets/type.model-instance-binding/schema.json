{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "extension_scope": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "inherited_contract": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "instance_authority_scope": {
      "pattern": "\\S",
      "type": "string"
    },
    "instance_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "kind": {
      "const": "model-instance-binding"
    },
    "node_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "parent_authority_scope": {
      "pattern": "\\S",
      "type": "string"
    },
    "parent_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "status": {
      "const": "candidate-unadmitted"
    }
  },
  "required": [
    "authority_effect",
    "extension_scope",
    "inherited_contract",
    "instance_authority_scope",
    "instance_ref",
    "kind",
    "node_id",
    "owner_ref",
    "parent_authority_scope",
    "parent_ref",
    "scope_ref",
    "status"
  ],
  "type": "object"
}
