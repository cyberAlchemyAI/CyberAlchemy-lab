{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "input_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "inquiry_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "kind": {
      "const": "research-run"
    },
    "limitations": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "method_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "node_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "output_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "period": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "start": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "end",
        "start"
      ],
      "type": "object"
    },
    "receipt_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "status": {
      "const": "candidate-unadmitted"
    }
  },
  "required": [
    "authority_effect",
    "input_refs",
    "inquiry_ref",
    "kind",
    "limitations",
    "method_ref",
    "node_id",
    "output_refs",
    "owner_ref",
    "period",
    "receipt_ref",
    "scope_ref",
    "status"
  ],
  "type": "object"
}
