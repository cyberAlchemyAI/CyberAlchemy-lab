{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "counterevidence_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "evidence_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "kind": {
      "const": "finding"
    },
    "limitations": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "node_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "question_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "statement": {
      "pattern": "\\S",
      "type": "string"
    },
    "status": {
      "const": "candidate-unadmitted"
    }
  },
  "required": [
    "authority_effect",
    "counterevidence_refs",
    "evidence_ref",
    "kind",
    "limitations",
    "node_id",
    "owner_ref",
    "question_ref",
    "scope_ref",
    "statement",
    "status"
  ],
  "type": "object"
}
