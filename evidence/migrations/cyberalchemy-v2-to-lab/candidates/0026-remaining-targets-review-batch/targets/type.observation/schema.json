{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "conditions": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "evidence_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "kind": {
      "const": "observation"
    },
    "node_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "type": "string"
    },
    "observer_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "readout": {
      "pattern": "\\S",
      "type": "string"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "subject_ref": {
      "pattern": "\\S",
      "type": "string"
    }
  },
  "required": [
    "authority_effect",
    "conditions",
    "evidence_ref",
    "kind",
    "node_id",
    "observed_at",
    "observer_ref",
    "owner_ref",
    "readout",
    "scope_ref",
    "status",
    "subject_ref"
  ],
  "type": "object"
}
