{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "identity_scope": {
      "pattern": "\\S",
      "type": "string"
    },
    "kind": {
      "const": "person-reference"
    },
    "local_label": {
      "pattern": "\\S",
      "type": "string"
    },
    "minimization_basis": {
      "pattern": "\\S",
      "type": "string"
    },
    "node_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "status": {
      "const": "candidate-unadmitted"
    }
  },
  "required": [
    "authority_effect",
    "identity_scope",
    "kind",
    "local_label",
    "minimization_basis",
    "node_id",
    "owner_ref",
    "scope_ref",
    "status"
  ],
  "type": "object"
}
