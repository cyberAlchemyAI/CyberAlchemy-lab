{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type_ref": {
      "const": "cal.artifact-type.authority-claim/v1"
    },
    "authority_effect": {
      "const": "none"
    },
    "authority_surface": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "\\S",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "basis": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "basis_kind": {
            "enum": [
              "evidence",
              "decision"
            ]
          },
          "binding": {
            "additionalProperties": false,
            "properties": {
              "path": {
                "pattern": "\\S",
                "type": "string"
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "type": "object"
          },
          "supports": {
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "basis_kind",
          "binding",
          "supports"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
    },
    "challenge_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "claim_ceiling": {
      "pattern": "\\S",
      "type": "string"
    },
    "claim_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "governed_object": {
      "additionalProperties": false,
      "properties": {
        "binding": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "pattern": "\\S",
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "type": "object"
        },
        "object_ref": {
          "pattern": "\\S",
          "type": "string"
        }
      },
      "required": [
        "binding",
        "object_ref"
      ],
      "type": "object"
    },
    "intended_effect": {
      "pattern": "\\S",
      "type": "string"
    },
    "kind_ref": {
      "const": "definition"
    },
    "operation_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "posture_ref": {
      "const": "candidate"
    },
    "profile": {
      "const": "candidate:definition-authority-claim/v1"
    },
    "schema_version": {
      "const": "cal-authority-claim-record/v1"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "source_direction": {
      "additionalProperties": false,
      "properties": {
        "canonical": {
          "const": "authority-claim-record.json"
        },
        "human_projection": {
          "const": "AUTHORITY-CLAIM.md"
        },
        "projection_policy": {
          "const": "generated-only"
        }
      },
      "required": [
        "canonical",
        "human_projection",
        "projection_policy"
      ],
      "type": "object"
    },
    "status": {
      "const": "candidate-unadmitted"
    }
  },
  "required": [
    "artifact_type_ref",
    "authority_effect",
    "authority_surface",
    "basis",
    "challenge_route",
    "claim_ceiling",
    "claim_id",
    "governed_object",
    "intended_effect",
    "kind_ref",
    "operation_ref",
    "owner_ref",
    "owner_route",
    "posture_ref",
    "profile",
    "schema_version",
    "scope_ref",
    "source_direction",
    "status"
  ],
  "type": "object"
}
