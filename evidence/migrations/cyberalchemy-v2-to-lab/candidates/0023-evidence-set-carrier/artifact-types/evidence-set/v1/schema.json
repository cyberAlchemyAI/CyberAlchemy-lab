{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type_ref": {
      "const": "cal.artifact-type.evidence-set/v1"
    },
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "claim_ceiling": {
      "pattern": "\\S",
      "type": "string"
    },
    "gaps": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "missing": {
            "pattern": "\\S",
            "type": "string"
          },
          "next_step": {
            "pattern": "\\S",
            "type": "string"
          },
          "owner_route": {
            "pattern": "\\S",
            "type": "string"
          },
          "question_ref": {
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "missing",
          "next_step",
          "owner_route",
          "question_ref"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 0,
      "type": "array"
    },
    "members": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "binding": {
            "additionalProperties": false,
            "properties": {
              "path": {
                "pattern": "\\S",
                "type": "string"
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "type": "object"
          },
          "contributions": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "question_ref": {
                  "pattern": "\\S",
                  "type": "string"
                },
                "rationale": {
                  "pattern": "\\S",
                  "type": "string"
                },
                "role": {
                  "enum": [
                    "supporting",
                    "counterevidence",
                    "context"
                  ]
                }
              },
              "required": [
                "question_ref",
                "rationale",
                "role"
              ],
              "type": "object"
            },
            "maxItems": 100,
            "minItems": 1,
            "type": "array"
          },
          "member_id": {
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "binding",
          "contributions",
          "member_id"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 0,
      "type": "array"
    },
    "owner_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "profile": {
      "const": "candidate:question-evidence-inventory/v1"
    },
    "questions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "question": {
            "pattern": "\\S",
            "type": "string"
          },
          "question_id": {
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "question",
          "question_id"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "cal-evidence-set-record/v1"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "set_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "source_direction": {
      "additionalProperties": false,
      "properties": {
        "canonical": {
          "const": "evidence-set-record.json"
        },
        "human_projection": {
          "const": "EVIDENCE-SET.md"
        },
        "projection_policy": {
          "const": "generated-only"
        }
      },
      "required": [
        "canonical",
        "human_projection",
        "projection_policy"
      ],
      "type": "object"
    },
    "status": {
      "const": "candidate-unadmitted"
    }
  },
  "required": [
    "artifact_type_ref",
    "authority_effect",
    "challenge_route",
    "claim_ceiling",
    "gaps",
    "members",
    "owner_route",
    "profile",
    "questions",
    "schema_version",
    "scope_ref",
    "set_id",
    "source_direction",
    "status"
  ],
  "type": "object"
}
