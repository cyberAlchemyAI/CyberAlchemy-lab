{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type_ref": {
      "const": "cal.artifact-type.invariant/v1"
    },
    "authority_effect": {
      "const": "none"
    },
    "checks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "check_id": {
            "pattern": "\\S",
            "type": "string"
          },
          "expected": {
            "type": "integer"
          },
          "field": {
            "pattern": "\\S",
            "type": "string"
          },
          "operator": {
            "enum": [
              "equals",
              "at-least",
              "at-most"
            ]
          }
        },
        "required": [
          "check_id",
          "field",
          "operator",
          "expected"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
    },
    "claim_ceiling": {
      "pattern": "\\S",
      "type": "string"
    },
    "evaluation_profile": {
      "const": "candidate:integer-observation-comparison/v1"
    },
    "grounding_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "invariant_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "must_hold": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "schema_version": {
      "const": "cyberalchemy-lab-invariant/v1"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "source_direction": {
      "additionalProperties": false,
      "properties": {
        "canonical": {
          "const": "invariant.json"
        },
        "human_projection": {
          "const": "INVARIANT.md"
        },
        "projection_policy": {
          "const": "generated-only"
        }
      },
      "required": [
        "canonical",
        "human_projection",
        "projection_policy"
      ],
      "type": "object"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "subject_kind": {
      "const": "system-or-artifact"
    },
    "subject_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "violation_meaning": {
      "pattern": "\\S",
      "type": "string"
    }
  },
  "required": [
    "artifact_type_ref",
    "authority_effect",
    "checks",
    "claim_ceiling",
    "evaluation_profile",
    "grounding_refs",
    "invariant_id",
    "must_hold",
    "owner_ref",
    "schema_version",
    "scope_ref",
    "source_direction",
    "status",
    "subject_kind",
    "subject_ref",
    "violation_meaning"
  ],
  "title": "Invariant candidate with bounded integer comparison profile",
  "type": "object"
}
