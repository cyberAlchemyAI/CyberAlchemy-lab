{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type_ref": {
      "const": "cal.artifact-type.lineage-map/v1"
    },
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "claim_ceiling": {
      "pattern": "\\S",
      "type": "string"
    },
    "coverage": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "map_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "mappings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "disposition": {
            "enum": [
              "retain",
              "revise",
              "reclassify",
              "split",
              "collapse"
            ]
          },
          "legacy_id": {
            "pattern": "\\S",
            "type": "string"
          },
          "successors": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "binding": {
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "pattern": "\\S",
                      "type": "string"
                    },
                    "sha256": {
                      "pattern": "^[0-9a-f]{64}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "sha256"
                  ],
                  "type": "object"
                },
                "target_id": {
                  "pattern": "\\S",
                  "type": "string"
                }
              },
              "required": [
                "binding",
                "target_id"
              ],
              "type": "object"
            },
            "maxItems": 100,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "disposition",
          "legacy_id",
          "successors"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
    },
    "normalization": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "\\S",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "owner_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "profile": {
      "const": "candidate:normalized-successor-map/v1"
    },
    "schema_version": {
      "const": "cal-lineage-map-record/v1"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "source_direction": {
      "additionalProperties": false,
      "properties": {
        "canonical": {
          "const": "lineage-map-record.json"
        },
        "human_projection": {
          "const": "LINEAGE-MAP.md"
        },
        "projection_policy": {
          "const": "generated-only"
        }
      },
      "required": [
        "canonical",
        "human_projection",
        "projection_policy"
      ],
      "type": "object"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "target_index": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "\\S",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    }
  },
  "required": [
    "artifact_type_ref",
    "authority_effect",
    "challenge_route",
    "claim_ceiling",
    "coverage",
    "map_id",
    "mappings",
    "normalization",
    "owner_route",
    "profile",
    "schema_version",
    "scope_ref",
    "source_direction",
    "status",
    "target_index"
  ],
  "type": "object"
}
