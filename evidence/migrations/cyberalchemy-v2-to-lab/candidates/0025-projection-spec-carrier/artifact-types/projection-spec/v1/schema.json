{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type_ref": {
      "const": "cal.artifact-type.projection-spec/v1"
    },
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "claim_ceiling": {
      "pattern": "\\S",
      "type": "string"
    },
    "fields": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "source_field": {
            "pattern": "\\S",
            "type": "string"
          },
          "view_field": {
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "source_field",
          "view_field"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
    },
    "omissions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "pattern": "\\S",
            "type": "string"
          },
          "source_field": {
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "reason",
          "source_field"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 0,
      "type": "array"
    },
    "owner_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "profile": {
      "const": "candidate:json-field-view/v1"
    },
    "projection_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "schema_version": {
      "const": "cal-projection-spec-record/v1"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "\\S",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "source_direction": {
      "additionalProperties": false,
      "properties": {
        "canonical": {
          "const": "projection-spec-record.json"
        },
        "human_projection": {
          "const": "PROJECTION-SPEC.md"
        },
        "projection_policy": {
          "const": "generated-only"
        }
      },
      "required": [
        "canonical",
        "human_projection",
        "projection_policy"
      ],
      "type": "object"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "update_policy": {
      "const": "regenerate-from-bound-source"
    },
    "view_authority": {
      "const": "none"
    }
  },
  "required": [
    "artifact_type_ref",
    "authority_effect",
    "challenge_route",
    "claim_ceiling",
    "fields",
    "omissions",
    "owner_route",
    "profile",
    "projection_id",
    "schema_version",
    "scope_ref",
    "source",
    "source_direction",
    "status",
    "update_policy",
    "view_authority"
  ],
  "type": "object"
}
