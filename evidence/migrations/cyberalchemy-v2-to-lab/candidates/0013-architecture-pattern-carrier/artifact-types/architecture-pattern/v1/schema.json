{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "applicability": {
      "additionalProperties": false,
      "properties": {
        "exclusions": {
          "pattern": "\\S",
          "type": "string"
        },
        "required_context": {
          "additionalProperties": {
            "pattern": "\\S",
            "type": "string"
          },
          "minProperties": 1,
          "type": "object"
        }
      },
      "required": [
        "exclusions",
        "required_context"
      ],
      "type": "object"
    },
    "artifact_type_ref": {
      "const": "cal.artifact-type.architecture-pattern/v1"
    },
    "authority_effect": {
      "const": "none"
    },
    "claim_ceiling": {
      "pattern": "\\S",
      "type": "string"
    },
    "consequences": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "consequence_id": {
            "pattern": "\\S",
            "type": "string"
          },
          "description": {
            "pattern": "\\S",
            "type": "string"
          },
          "force_refs": {
            "items": {
              "pattern": "\\S",
              "type": "string"
            },
            "maxItems": 100,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "kind": {
            "enum": [
              "benefit",
              "cost",
              "risk"
            ]
          }
        },
        "required": [
          "consequence_id",
          "description",
          "force_refs",
          "kind"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
    },
    "constraints": {
      "const": [
        "stable-scope",
        "unique-event-identities",
        "contiguous-sequence",
        "unchanged-prefix"
      ]
    },
    "context": {
      "pattern": "\\S",
      "type": "string"
    },
    "forces": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "pattern": "\\S",
            "type": "string"
          },
          "force_id": {
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "description",
          "force_id"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "pattern_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "problem": {
      "pattern": "\\S",
      "type": "string"
    },
    "profile": {
      "const": "candidate:append-only-ledger-snapshots/v1"
    },
    "response": {
      "pattern": "\\S",
      "type": "string"
    },
    "schema_version": {
      "const": "cal-architecture-pattern-record/v1"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "source_direction": {
      "additionalProperties": false,
      "properties": {
        "canonical": {
          "const": "architecture-pattern-record.json"
        },
        "human_projection": {
          "const": "ARCHITECTURE-PATTERN.md"
        },
        "projection_policy": {
          "const": "generated-only"
        }
      },
      "required": [
        "canonical",
        "human_projection",
        "projection_policy"
      ],
      "type": "object"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "witness": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "pattern": "\\S",
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "type": "object"
        },
        "before": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "pattern": "\\S",
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "type": "object"
        },
        "context": {
          "additionalProperties": {
            "pattern": "\\S",
            "type": "string"
          },
          "type": "object"
        }
      },
      "required": [
        "after",
        "before",
        "context"
      ],
      "type": "object"
    }
  },
  "required": [
    "applicability",
    "artifact_type_ref",
    "authority_effect",
    "claim_ceiling",
    "consequences",
    "constraints",
    "context",
    "forces",
    "owner_ref",
    "pattern_id",
    "problem",
    "profile",
    "response",
    "schema_version",
    "scope_ref",
    "source_direction",
    "status",
    "witness"
  ],
  "type": "object"
}
