{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type_ref": {
      "const": "cal.artifact-type.gate/v1"
    },
    "authority_boundary": {
      "pattern": "\\S",
      "type": "string"
    },
    "authority_effect": {
      "const": "none"
    },
    "claim_ceiling": {
      "pattern": "\\S",
      "type": "string"
    },
    "criteria": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "criterion_id": {
            "pattern": "\\S",
            "type": "string"
          },
          "description": {
            "pattern": "\\S",
            "type": "string"
          },
          "expected": {
            "type": [
              "string",
              "integer",
              "boolean"
            ]
          },
          "field": {
            "pattern": "\\S",
            "type": "string"
          },
          "on_failure": {
            "enum": [
              "block",
              "flag",
              "defer"
            ]
          },
          "risk": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "description": {
                    "pattern": "\\S",
                    "type": "string"
                  },
                  "follow_up": {
                    "pattern": "\\S",
                    "type": "string"
                  },
                  "owner_ref": {
                    "pattern": "\\S",
                    "type": "string"
                  }
                },
                "required": [
                  "description",
                  "follow_up",
                  "owner_ref"
                ],
                "type": "object"
              }
            ]
          }
        },
        "required": [
          "criterion_id",
          "description",
          "expected",
          "field",
          "on_failure",
          "risk"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
    },
    "effect_boundary": {
      "additionalProperties": false,
      "properties": {
        "effect": {
          "pattern": "\\S",
          "type": "string"
        },
        "from_state": {
          "pattern": "\\S",
          "type": "string"
        },
        "to_state": {
          "pattern": "\\S",
          "type": "string"
        }
      },
      "required": [
        "effect",
        "from_state",
        "to_state"
      ],
      "type": "object"
    },
    "escalation_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "gate_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "profile": {
      "const": "candidate:bound-json-gate/v1"
    },
    "record_location": {
      "pattern": "\\S",
      "type": "string"
    },
    "review_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "schema_version": {
      "const": "cal-gate-record/v1"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "source_direction": {
      "additionalProperties": false,
      "properties": {
        "canonical": {
          "const": "gate-record.json"
        },
        "human_projection": {
          "const": "GATE.md"
        },
        "projection_policy": {
          "const": "generated-only"
        }
      },
      "required": [
        "canonical",
        "human_projection",
        "projection_policy"
      ],
      "type": "object"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "subject": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "\\S",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "verdicts": {
      "const": [
        "pass",
        "flag",
        "block",
        "defer"
      ]
    }
  },
  "required": [
    "artifact_type_ref",
    "authority_boundary",
    "authority_effect",
    "claim_ceiling",
    "criteria",
    "effect_boundary",
    "escalation_route",
    "gate_id",
    "owner_ref",
    "profile",
    "record_location",
    "review_route",
    "schema_version",
    "scope_ref",
    "source_direction",
    "status",
    "subject",
    "verdicts"
  ],
  "type": "object"
}
