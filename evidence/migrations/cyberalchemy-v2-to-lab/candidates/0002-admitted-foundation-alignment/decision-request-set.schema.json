{
  "$id": "https://cyberalchemy.local/schemas/migration-decision-request-set/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "candidate_manifest": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "decision_mode": {
      "const": "single-checkpoint-ordered-independent-decisions"
    },
    "decision_request_set_id": {
      "minLength": 1,
      "type": "string"
    },
    "interaction_count": {
      "const": 1
    },
    "requests": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "authority_scope_ref": {
            "minLength": 1,
            "type": "string"
          },
          "decision_kind": {
            "enum": [
              "product-approval",
              "definition-admission",
              "artifact-type-admission",
              "migration-execution-authorization"
            ]
          },
          "depends_on": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "invalidation_conditions": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "owner_ref": {
            "minLength": 1,
            "type": "string"
          },
          "request_id": {
            "minLength": 1,
            "type": "string"
          },
          "requested_effect": {
            "minLength": 1,
            "type": "string"
          },
          "requested_outcome": {
            "const": "approve"
          },
          "sequence": {
            "maximum": 4,
            "minimum": 1,
            "type": "integer"
          },
          "targets": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "path": {
                  "minLength": 1,
                  "type": "string"
                },
                "sha256": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "request_id",
          "sequence",
          "decision_kind",
          "owner_ref",
          "authority_scope_ref",
          "targets",
          "requested_outcome",
          "requested_effect",
          "depends_on",
          "invalidation_conditions"
        ],
        "type": "object"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    },
    "schema_version": {
      "const": "cyberalchemy-lab-migration-decision-request-set/v1"
    },
    "semantic_definition_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 4,
      "type": "array",
      "uniqueItems": true
    },
    "status": {
      "const": "awaiting-owner-decision"
    },
    "validation_receipt": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "decision_request_set_id",
    "status",
    "authority_effect",
    "candidate_manifest",
    "validation_receipt",
    "interaction_count",
    "decision_mode",
    "semantic_definition_refs",
    "requests",
    "claim_ceiling"
  ],
  "type": "object"
}
