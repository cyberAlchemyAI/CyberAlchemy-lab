{
  "$id": "https://cyberalchemy.local/schemas/migration-decision-record/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "copy_boundary": {
      "additionalProperties": false,
      "properties": {
        "additive_only": {
          "const": true
        },
        "overwrite": {
          "const": false
        },
        "publication": {
          "const": false
        },
        "source_deletion": {
          "const": false
        },
        "source_mutation": {
          "const": false
        }
      },
      "required": [
        "additive_only",
        "overwrite",
        "source_mutation",
        "source_deletion",
        "publication"
      ],
      "type": "object"
    },
    "decision_record_id": {
      "minLength": 1,
      "type": "string"
    },
    "decision_request_set_path": {
      "minLength": 1,
      "type": "string"
    },
    "decision_request_set_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "decisions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "authorized_effect": {
            "minLength": 1,
            "type": "string"
          },
          "decision_kind": {
            "enum": [
              "product-approval",
              "definition-admission",
              "artifact-type-admission",
              "migration-execution-authorization"
            ]
          },
          "outcome": {
            "const": "approved"
          },
          "owner_ref": {
            "minLength": 1,
            "type": "string"
          },
          "request_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "decision_kind",
          "owner_ref",
          "outcome",
          "authorized_effect"
        ],
        "type": "object"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    },
    "principal_ref": {
      "const": "person:vrondelli"
    },
    "schema_version": {
      "const": "cyberalchemy-lab-migration-decision-record/v1"
    },
    "status": {
      "const": "owner-decided"
    },
    "validation_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "decision_record_id",
    "status",
    "decision_request_set_path",
    "decision_request_set_sha256",
    "candidate_manifest_sha256",
    "validation_receipt_sha256",
    "principal_ref",
    "decisions",
    "copy_boundary",
    "claim_ceiling"
  ],
  "type": "object"
}
