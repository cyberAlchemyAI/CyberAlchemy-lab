{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type_ref": {
      "const": "cal.artifact-type.schema/v1"
    },
    "authority_effect": {
      "const": "none"
    },
    "claim_ceiling": {
      "pattern": "\\S",
      "type": "string"
    },
    "connection_rules": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "max_per_source": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "max_per_target": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "min_per_source": {
            "minimum": 0,
            "type": "integer"
          },
          "min_per_target": {
            "minimum": 0,
            "type": "integer"
          },
          "relation_ref": {
            "pattern": "\\S",
            "type": "string"
          },
          "source_kind": {
            "pattern": "\\S",
            "type": "string"
          },
          "target_kind": {
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "max_per_source",
          "max_per_target",
          "min_per_source",
          "min_per_target",
          "relation_ref",
          "source_kind",
          "target_kind"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 0,
      "type": "array"
    },
    "constraints": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "closed_fields": {
            "type": "boolean"
          },
          "fields": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "pattern": "\\S",
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                },
                "value_type": {
                  "enum": [
                    "string",
                    "integer",
                    "boolean"
                  ]
                }
              },
              "required": [
                "name",
                "required",
                "value_type"
              ],
              "type": "object"
            },
            "maxItems": 100,
            "minItems": 0,
            "type": "array"
          },
          "kind_ref": {
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "closed_fields",
          "fields",
          "kind_ref"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 0,
      "type": "array"
    },
    "kinds": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "path_equations": {
      "const": []
    },
    "profile": {
      "const": "candidate:finite-typed-graph/v1"
    },
    "relations": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "relative_level": {
      "additionalProperties": false,
      "properties": {
        "occupant_level_ref": {
          "pattern": "\\S",
          "type": "string"
        },
        "schema_level_ref": {
          "pattern": "\\S",
          "type": "string"
        }
      },
      "required": [
        "occupant_level_ref",
        "schema_level_ref"
      ],
      "type": "object"
    },
    "schema_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "schema_version": {
      "const": "cyberalchemy-lab-schema-carrier/v1"
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "source_direction": {
      "additionalProperties": false,
      "properties": {
        "canonical": {
          "const": "schema-record.json"
        },
        "human_projection": {
          "const": "SCHEMA.md"
        },
        "projection_policy": {
          "const": "generated-only"
        }
      },
      "required": [
        "canonical",
        "human_projection",
        "projection_policy"
      ],
      "type": "object"
    },
    "status": {
      "const": "candidate-unadmitted"
    }
  },
  "required": [
    "artifact_type_ref",
    "authority_effect",
    "claim_ceiling",
    "connection_rules",
    "constraints",
    "kinds",
    "owner_ref",
    "path_equations",
    "profile",
    "relations",
    "relative_level",
    "schema_id",
    "schema_version",
    "scope_ref",
    "source_direction",
    "status"
  ],
  "title": "Schema carrier with a bounded finite typed graph profile",
  "type": "object"
}
