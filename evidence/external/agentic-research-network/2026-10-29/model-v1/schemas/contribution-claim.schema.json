{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/arn/contribution-claim/v1",
  "title": "ARN contribution-claim candidate record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "version",
    "status",
    "authority_effect",
    "subject_ref",
    "owner_ref",
    "source_refs",
    "challenge_route",
    "claim_ceiling",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "arn.contribution-claim/v1"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "authority_effect": {
      "const": "none"
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "owner_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "challenge_route": {
      "type": "string",
      "minLength": 1
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program_ref",
        "charter_ref",
        "object_ref",
        "claimant_ref",
        "collaborator_refs",
        "role",
        "source_artifact_refs",
        "causal_claim",
        "baseline_ref",
        "requested_treatment",
        "duplicate_disclosures",
        "submitted_at"
      ],
      "properties": {
        "program_ref": {
          "type": "string",
          "minLength": 1
        },
        "charter_ref": {
          "type": "string",
          "minLength": 1
        },
        "object_ref": {
          "type": "string",
          "minLength": 1
        },
        "claimant_ref": {
          "type": "string",
          "minLength": 1
        },
        "collaborator_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "role": {
          "enum": [
            "research-advance",
            "execution-work",
            "mixed"
          ]
        },
        "source_artifact_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "causal_claim": {
          "type": "string",
          "minLength": 1
        },
        "baseline_ref": {
          "type": "string",
          "minLength": 1
        },
        "requested_treatment": {
          "enum": [
            "none",
            "work-reward",
            "participation",
            "both"
          ]
        },
        "duplicate_disclosures": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "submitted_at": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
