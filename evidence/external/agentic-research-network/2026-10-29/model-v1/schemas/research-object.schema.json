{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/arn/research-object/v1",
  "title": "ARN research-object candidate record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "version",
    "status",
    "authority_effect",
    "subject_ref",
    "owner_ref",
    "source_refs",
    "challenge_route",
    "claim_ceiling",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "arn.research-object/v1"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "authority_effect": {
      "const": "none"
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "owner_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "challenge_route": {
      "type": "string",
      "minLength": 1
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inquiry_ref",
        "unit",
        "content_digest",
        "claim",
        "mechanism_delta",
        "rival_explanation",
        "discriminating_prediction",
        "smallest_test",
        "decision_ref",
        "lineage_refs"
      ],
      "properties": {
        "inquiry_ref": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "enum": [
            "hypothesis",
            "simulator",
            "case",
            "scorer",
            "evaluator",
            "workflow",
            "study-design",
            "product-feedback"
          ]
        },
        "content_digest": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "mechanism_delta": {
          "type": "string",
          "minLength": 1
        },
        "rival_explanation": {
          "type": "string",
          "minLength": 1
        },
        "discriminating_prediction": {
          "type": "string",
          "minLength": 1
        },
        "smallest_test": {
          "type": "string",
          "minLength": 1
        },
        "decision_ref": {
          "type": "string",
          "minLength": 1
        },
        "lineage_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
