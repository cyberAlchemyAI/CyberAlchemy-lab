{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/arn/reward-policy/v1",
  "title": "ARN reward-policy candidate record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "version",
    "status",
    "authority_effect",
    "subject_ref",
    "owner_ref",
    "source_refs",
    "challenge_route",
    "claim_ceiling",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "arn.reward-policy/v1"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "authority_effect": {
      "const": "none"
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "owner_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "challenge_route": {
      "type": "string",
      "minLength": 1
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instrument",
        "supply_rule",
        "budget_cap",
        "eligible_work",
        "verification_rule",
        "negative_result_rule",
        "anti_sybil_rule",
        "mint_authority_ref",
        "redemption_rule",
        "open_decisions"
      ],
      "properties": {
        "instrument": {
          "type": "string",
          "minLength": 1
        },
        "supply_rule": {
          "type": "string",
          "minLength": 1
        },
        "budget_cap": {
          "type": "string",
          "minLength": 1
        },
        "eligible_work": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "verification_rule": {
          "type": "string",
          "minLength": 1
        },
        "negative_result_rule": {
          "type": "string",
          "minLength": 1
        },
        "anti_sybil_rule": {
          "type": "string",
          "minLength": 1
        },
        "mint_authority_ref": {
          "type": "string",
          "minLength": 1
        },
        "redemption_rule": {
          "type": "string",
          "minLength": 1
        },
        "open_decisions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
