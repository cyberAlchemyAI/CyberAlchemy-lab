{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/arn/program-budget/v1",
  "title": "ARN program-budget candidate record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "version",
    "status",
    "authority_effect",
    "subject_ref",
    "owner_ref",
    "source_refs",
    "challenge_route",
    "claim_ceiling",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "arn.program-budget/v1"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "authority_effect": {
      "const": "none"
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "owner_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "challenge_route": {
      "type": "string",
      "minLength": 1
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program_ref",
        "currency",
        "total_cap",
        "research_allocation",
        "review_allocation",
        "operations_allocation",
        "reserve",
        "funding_source_refs",
        "spending_authority_ref",
        "period",
        "open_decisions"
      ],
      "properties": {
        "program_ref": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "type": "string",
          "minLength": 1
        },
        "total_cap": {
          "type": "string",
          "minLength": 1
        },
        "research_allocation": {
          "type": "string",
          "minLength": 1
        },
        "review_allocation": {
          "type": "string",
          "minLength": 1
        },
        "operations_allocation": {
          "type": "string",
          "minLength": 1
        },
        "reserve": {
          "type": "string",
          "minLength": 1
        },
        "funding_source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "spending_authority_ref": {
          "type": "string",
          "minLength": 1
        },
        "period": {
          "type": "string",
          "minLength": 1
        },
        "open_decisions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
