{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/arn/revenue-statement/v1",
  "title": "ARN revenue-statement candidate record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "version",
    "status",
    "authority_effect",
    "subject_ref",
    "owner_ref",
    "source_refs",
    "challenge_route",
    "claim_ceiling",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "arn.revenue-statement/v1"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "authority_effect": {
      "const": "none"
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "owner_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "challenge_route": {
      "type": "string",
      "minLength": 1
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_ref",
        "period",
        "policy_ref",
        "gross_receipts",
        "refunds",
        "allowed_costs",
        "reserves",
        "excluded_receipts",
        "distributable_amount",
        "source_receipt_refs",
        "audit_ref"
      ],
      "properties": {
        "product_ref": {
          "type": "string",
          "minLength": 1
        },
        "period": {
          "type": "string",
          "minLength": 1
        },
        "policy_ref": {
          "type": "string",
          "minLength": 1
        },
        "gross_receipts": {
          "type": "string",
          "minLength": 1
        },
        "refunds": {
          "type": "string",
          "minLength": 1
        },
        "allowed_costs": {
          "type": "string",
          "minLength": 1
        },
        "reserves": {
          "type": "string",
          "minLength": 1
        },
        "excluded_receipts": {
          "type": "string",
          "minLength": 1
        },
        "distributable_amount": {
          "type": "string",
          "minLength": 1
        },
        "source_receipt_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "audit_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
