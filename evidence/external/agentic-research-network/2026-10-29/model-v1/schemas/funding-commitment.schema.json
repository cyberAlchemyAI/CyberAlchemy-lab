{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/arn/funding-commitment/v1",
  "title": "ARN funding-commitment candidate record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "version",
    "status",
    "authority_effect",
    "subject_ref",
    "owner_ref",
    "source_refs",
    "challenge_route",
    "claim_ceiling",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "arn.funding-commitment/v1"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "authority_effect": {
      "const": "none"
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "owner_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "challenge_route": {
      "type": "string",
      "minLength": 1
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program_ref",
        "funder_ref",
        "disclosure_ref",
        "instrument",
        "amount",
        "currency",
        "state",
        "permitted_uses",
        "refund_rule",
        "rights_summary",
        "source_receipt_ref"
      ],
      "properties": {
        "program_ref": {
          "type": "string",
          "minLength": 1
        },
        "funder_ref": {
          "type": "string",
          "minLength": 1
        },
        "disclosure_ref": {
          "type": "string",
          "minLength": 1
        },
        "instrument": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "pledged",
            "cleared",
            "cancelled",
            "refunded"
          ]
        },
        "permitted_uses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "refund_rule": {
          "type": "string",
          "minLength": 1
        },
        "rights_summary": {
          "type": "string",
          "minLength": 1
        },
        "source_receipt_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
