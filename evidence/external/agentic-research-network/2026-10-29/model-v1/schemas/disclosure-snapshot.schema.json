{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/arn/disclosure-snapshot/v1",
  "title": "ARN disclosure-snapshot candidate record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "version",
    "status",
    "authority_effect",
    "subject_ref",
    "owner_ref",
    "source_refs",
    "challenge_route",
    "claim_ceiling",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "arn.disclosure-snapshot/v1"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "authority_effect": {
      "const": "none"
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "owner_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "challenge_route": {
      "type": "string",
      "minLength": 1
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_ref",
        "as_of",
        "thesis_ref",
        "charter_ref",
        "evidence_status",
        "budget_ref",
        "rights_policy_ref",
        "reward_policy_ref",
        "participation_policy_ref",
        "risks",
        "open_decisions",
        "publication_decision_ref"
      ],
      "properties": {
        "product_ref": {
          "type": "string",
          "minLength": 1
        },
        "as_of": {
          "type": "string",
          "minLength": 1
        },
        "thesis_ref": {
          "type": "string",
          "minLength": 1
        },
        "charter_ref": {
          "type": "string",
          "minLength": 1
        },
        "evidence_status": {
          "type": "string",
          "minLength": 1
        },
        "budget_ref": {
          "type": "string",
          "minLength": 1
        },
        "rights_policy_ref": {
          "type": "string",
          "minLength": 1
        },
        "reward_policy_ref": {
          "type": "string",
          "minLength": 1
        },
        "participation_policy_ref": {
          "type": "string",
          "minLength": 1
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "open_decisions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "publication_decision_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
