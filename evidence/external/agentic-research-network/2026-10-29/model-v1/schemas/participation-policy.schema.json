{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/arn/participation-policy/v1",
  "title": "ARN participation-policy candidate record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "version",
    "status",
    "authority_effect",
    "subject_ref",
    "owner_ref",
    "source_refs",
    "challenge_route",
    "claim_ceiling",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "arn.participation-policy/v1"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "authority_effect": {
      "const": "none"
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "owner_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "challenge_route": {
      "type": "string",
      "minLength": 1
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_ref",
        "eligible_advance_rule",
        "unit_allocation_rule",
        "denominator_rule",
        "revenue_policy_ref",
        "duration_rule",
        "dilution_rule",
        "adjustment_rule",
        "legal_instrument_ref",
        "open_decisions"
      ],
      "properties": {
        "product_ref": {
          "type": "string",
          "minLength": 1
        },
        "eligible_advance_rule": {
          "type": "string",
          "minLength": 1
        },
        "unit_allocation_rule": {
          "type": "string",
          "minLength": 1
        },
        "denominator_rule": {
          "type": "string",
          "minLength": 1
        },
        "revenue_policy_ref": {
          "type": "string",
          "minLength": 1
        },
        "duration_rule": {
          "type": "string",
          "minLength": 1
        },
        "dilution_rule": {
          "type": "string",
          "minLength": 1
        },
        "adjustment_rule": {
          "type": "string",
          "minLength": 1
        },
        "legal_instrument_ref": {
          "type": "string",
          "minLength": 1
        },
        "open_decisions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
