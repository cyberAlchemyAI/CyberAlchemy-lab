{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/arn/simulation-policy/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "authority_effect", "product_ref", "work_asset", "participation_asset", "stablecoin_asset", "work_cap_units", "epoch_release_cap_units", "participation_cap_units", "revenue_share_bps", "funder_share_bps", "minimum_independent_reviews", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "arn.simulation-policy/v1"},
    "status": {"const": "simulation-only"},
    "authority_effect": {"const": "none"},
    "product_ref": {"type": "string", "minLength": 1},
    "work_asset": {"type": "string", "minLength": 1},
    "participation_asset": {"type": "string", "minLength": 1},
    "stablecoin_asset": {"type": "string", "minLength": 1},
    "work_cap_units": {"type": "integer", "minimum": 1},
    "epoch_release_cap_units": {"type": "integer", "minimum": 1},
    "participation_cap_units": {"type": "integer", "minimum": 1},
    "revenue_share_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
    "funder_share_bps": {"const": 0},
    "minimum_independent_reviews": {"type": "integer", "minimum": 2},
    "claim_ceiling": {"type": "string", "minLength": 1}
  }
}
