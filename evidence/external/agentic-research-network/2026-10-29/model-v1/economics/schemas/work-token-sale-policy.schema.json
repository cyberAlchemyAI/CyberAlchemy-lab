{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/arn/work-token-sale-policy/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "version",
    "status",
    "authority_effect",
    "subject_ref",
    "owner_ref",
    "source_refs",
    "challenge_route",
    "claim_ceiling",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "arn.work-token-sale-policy/v1"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "authority_effect": {
      "const": "none"
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "owner_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "challenge_route": {
      "type": "string",
      "minLength": 1
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_ref",
        "sale_tranche_w_units",
        "price_c_per_w_unit",
        "buyer_rights",
        "settlement_rule",
        "refund_rule",
        "permitted_fund_use",
        "sale_disclosure_ref",
        "legal_decision_ref",
        "open_decisions"
      ],
      "properties": {
        "product_ref": {
          "type": "string",
          "minLength": 1
        },
        "sale_tranche_w_units": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "price_c_per_w_unit": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "buyer_rights": {
          "type": "string",
          "minLength": 1
        },
        "settlement_rule": {
          "type": "string",
          "minLength": 1
        },
        "refund_rule": {
          "type": "string",
          "minLength": 1
        },
        "permitted_fund_use": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "sale_disclosure_ref": {
          "type": "string",
          "minLength": 1
        },
        "legal_decision_ref": {
          "type": "string",
          "minLength": 1
        },
        "open_decisions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
