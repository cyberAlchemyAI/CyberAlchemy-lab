{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/arn/independent-evaluation/v1",
  "title": "ARN independent-evaluation candidate record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "version",
    "status",
    "authority_effect",
    "subject_ref",
    "owner_ref",
    "source_refs",
    "challenge_route",
    "claim_ceiling",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "arn.independent-evaluation/v1"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "authority_effect": {
      "const": "none"
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "owner_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "challenge_route": {
      "type": "string",
      "minLength": 1
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "submission_ref",
        "reviewer_ref",
        "conflict_declaration",
        "gates",
        "decision_resolved",
        "evidence_refs",
        "challenge_deadline",
        "review_quality_status"
      ],
      "properties": {
        "submission_ref": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_ref": {
          "type": "string",
          "minLength": 1
        },
        "conflict_declaration": {
          "type": "string",
          "minLength": 1
        },
        "gates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_trace",
            "rights",
            "reproducibility",
            "independence",
            "nonduplicate",
            "bounded_cost"
          ],
          "properties": {
            "source_trace": {
              "enum": [
                "pass",
                "fail",
                "unknown"
              ]
            },
            "rights": {
              "enum": [
                "pass",
                "fail",
                "unknown"
              ]
            },
            "reproducibility": {
              "enum": [
                "pass",
                "fail",
                "unknown"
              ]
            },
            "independence": {
              "enum": [
                "pass",
                "fail",
                "unknown"
              ]
            },
            "nonduplicate": {
              "enum": [
                "pass",
                "fail",
                "unknown"
              ]
            },
            "bounded_cost": {
              "enum": [
                "pass",
                "fail",
                "unknown"
              ]
            }
          }
        },
        "decision_resolved": {
          "type": "boolean"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "challenge_deadline": {
          "type": "string",
          "minLength": 1
        },
        "review_quality_status": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        }
      }
    }
  }
}
