{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/arn/submission-commitment/v1",
  "title": "ARN submission-commitment candidate record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "version",
    "status",
    "authority_effect",
    "subject_ref",
    "owner_ref",
    "source_refs",
    "challenge_route",
    "claim_ceiling",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "arn.submission-commitment/v1"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "authority_effect": {
      "const": "none"
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "owner_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "challenge_route": {
      "type": "string",
      "minLength": 1
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_ref",
        "slot_id",
        "miner_ref",
        "commitment_digest",
        "submitted_at",
        "model_lineage_refs"
      ],
      "properties": {
        "task_ref": {
          "type": "string",
          "minLength": 1
        },
        "slot_id": {
          "type": "integer",
          "minimum": 0
        },
        "miner_ref": {
          "type": "string",
          "minLength": 1
        },
        "commitment_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "submitted_at": {
          "type": "string",
          "minLength": 1
        },
        "model_lineage_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
