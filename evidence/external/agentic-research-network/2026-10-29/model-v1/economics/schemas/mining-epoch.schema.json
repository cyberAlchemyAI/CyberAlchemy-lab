{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/arn/mining-epoch/v1",
  "title": "ARN mining-epoch candidate record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "version",
    "status",
    "authority_effect",
    "subject_ref",
    "owner_ref",
    "source_refs",
    "challenge_route",
    "claim_ceiling",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "arn.mining-epoch/v1"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "authority_effect": {
      "const": "none"
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "owner_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "challenge_route": {
      "type": "string",
      "minLength": 1
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program_ref",
        "policy_ref",
        "release_cap_units",
        "start_at",
        "end_at",
        "task_admission_deadline",
        "close_rule",
        "decision_ref"
      ],
      "properties": {
        "program_ref": {
          "type": "string",
          "minLength": 1
        },
        "policy_ref": {
          "type": "string",
          "minLength": 1
        },
        "release_cap_units": {
          "type": "integer",
          "minimum": 1
        },
        "start_at": {
          "type": "string",
          "minLength": 1
        },
        "end_at": {
          "type": "string",
          "minLength": 1
        },
        "task_admission_deadline": {
          "type": "string",
          "minLength": 1
        },
        "close_rule": {
          "type": "string",
          "minLength": 1
        },
        "decision_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
