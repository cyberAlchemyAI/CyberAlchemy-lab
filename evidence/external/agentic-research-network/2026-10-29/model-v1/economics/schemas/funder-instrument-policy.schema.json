{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/arn/funder-instrument-policy/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "version",
    "status",
    "authority_effect",
    "subject_ref",
    "owner_ref",
    "source_refs",
    "challenge_route",
    "claim_ceiling",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "arn.funder-instrument-policy/v1"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "authority_effect": {
      "const": "none"
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "owner_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "challenge_route": {
      "type": "string",
      "minLength": 1
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program_ref",
        "product_ref",
        "instrument_kind",
        "work_sale_tranche_ref",
        "funder_share_bps",
        "fixed_funder_unit_cap",
        "consideration_rule",
        "rights_summary",
        "refund_rule",
        "loss_and_priority_rule",
        "legal_decision_ref",
        "open_decisions"
      ],
      "properties": {
        "program_ref": {
          "type": "string",
          "minLength": 1
        },
        "product_ref": {
          "type": "string",
          "minLength": 1
        },
        "instrument_kind": {
          "enum": [
            "undecided",
            "grant",
            "sponsorship",
            "w-purchase",
            "revenue-contract"
          ]
        },
        "work_sale_tranche_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "funder_share_bps": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "fixed_funder_unit_cap": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "consideration_rule": {
          "type": "string",
          "minLength": 1
        },
        "rights_summary": {
          "type": "string",
          "minLength": 1
        },
        "refund_rule": {
          "type": "string",
          "minLength": 1
        },
        "loss_and_priority_rule": {
          "type": "string",
          "minLength": 1
        },
        "legal_decision_ref": {
          "type": "string",
          "minLength": 1
        },
        "open_decisions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
