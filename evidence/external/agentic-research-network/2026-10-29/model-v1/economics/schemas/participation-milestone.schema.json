{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/arn/participation-milestone/v1",
  "title": "ARN participation-milestone candidate record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "version",
    "status",
    "authority_effect",
    "subject_ref",
    "owner_ref",
    "source_refs",
    "challenge_route",
    "claim_ceiling",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "arn.participation-milestone/v1"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "authority_effect": {
      "const": "none"
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "owner_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "challenge_route": {
      "type": "string",
      "minLength": 1
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_ref",
        "program_ref",
        "policy_ref",
        "unit_cap",
        "decision_target_ref",
        "acceptance_conditions",
        "owner_decision_ref",
        "appeal_rule"
      ],
      "properties": {
        "product_ref": {
          "type": "string",
          "minLength": 1
        },
        "program_ref": {
          "type": "string",
          "minLength": 1
        },
        "policy_ref": {
          "type": "string",
          "minLength": 1
        },
        "unit_cap": {
          "type": "integer",
          "minimum": 1
        },
        "decision_target_ref": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "owner_decision_ref": {
          "type": "string",
          "minLength": 1
        },
        "appeal_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
