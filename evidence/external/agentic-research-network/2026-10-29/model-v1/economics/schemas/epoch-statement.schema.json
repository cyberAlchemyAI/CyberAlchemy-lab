{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/arn/epoch-statement/v1",
  "title": "ARN epoch-statement candidate record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "version",
    "status",
    "authority_effect",
    "subject_ref",
    "owner_ref",
    "source_refs",
    "challenge_route",
    "claim_ceiling",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "arn.epoch-statement/v1"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "authority_effect": {
      "const": "none"
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "owner_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "challenge_route": {
      "type": "string",
      "minLength": 1
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epoch_ref",
        "policy_ref",
        "release_cap_units",
        "reserved_units",
        "awarded_units",
        "released_units",
        "task_refs",
        "ledger_root_digest",
        "close_decision_ref"
      ],
      "properties": {
        "epoch_ref": {
          "type": "string",
          "minLength": 1
        },
        "policy_ref": {
          "type": "string",
          "minLength": 1
        },
        "release_cap_units": {
          "type": "integer",
          "minimum": 1
        },
        "reserved_units": {
          "type": "integer",
          "minimum": 0
        },
        "awarded_units": {
          "type": "integer",
          "minimum": 0
        },
        "released_units": {
          "type": "integer",
          "minimum": 0
        },
        "task_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "ledger_root_digest": {
          "type": "string",
          "minLength": 1
        },
        "close_decision_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
