{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/arn/appeal-case/v1",
  "title": "ARN appeal-case candidate record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "version",
    "status",
    "authority_effect",
    "claim_ceiling",
    "subject_ref",
    "claimant_ref",
    "original_decision_ref",
    "grounds",
    "original_evidence_refs",
    "new_evidence_refs",
    "filed_at",
    "deadline_at",
    "case_state",
    "freeze_scope",
    "panel_refs",
    "outcome",
    "remedy_refs",
    "owner_ref",
    "challenge_route"
  ],
  "properties": {
    "schema_version": {
      "const": "arn.appeal-case/v1"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "authority_effect": {
      "const": "none"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "claimant_ref": {
      "type": "string",
      "minLength": 1
    },
    "original_decision_ref": {
      "type": "string",
      "minLength": 1
    },
    "grounds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "original_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "new_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "filed_at": {
      "type": "string",
      "minLength": 1
    },
    "deadline_at": {
      "type": "string",
      "minLength": 1
    },
    "case_state": {
      "enum": [
        "open",
        "under-review",
        "remanded",
        "closed"
      ]
    },
    "freeze_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "panel_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "outcome": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "remedy_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "owner_ref": {
      "type": "string",
      "minLength": 1
    },
    "challenge_route": {
      "type": "string",
      "minLength": 1
    }
  }
}
