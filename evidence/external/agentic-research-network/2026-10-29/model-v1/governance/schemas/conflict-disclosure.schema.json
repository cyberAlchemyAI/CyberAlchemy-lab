{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/arn/conflict-disclosure/v1",
  "title": "ARN conflict-disclosure candidate record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "version",
    "status",
    "authority_effect",
    "claim_ceiling",
    "subject_ref",
    "principal_ref",
    "scope_ref",
    "relationship_refs",
    "conflict_tags",
    "disclosed_at",
    "recusal_action_refs",
    "owner_ref",
    "challenge_route"
  ],
  "properties": {
    "schema_version": {
      "const": "arn.conflict-disclosure/v1"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "authority_effect": {
      "const": "none"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "principal_ref": {
      "type": "string",
      "minLength": 1
    },
    "scope_ref": {
      "type": "string",
      "minLength": 1
    },
    "relationship_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "conflict_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "disclosed_at": {
      "type": "string",
      "minLength": 1
    },
    "recusal_action_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "owner_ref": {
      "type": "string",
      "minLength": 1
    },
    "challenge_route": {
      "type": "string",
      "minLength": 1
    }
  }
}
