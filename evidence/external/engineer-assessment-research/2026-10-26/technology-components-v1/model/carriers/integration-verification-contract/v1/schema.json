{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type_ref": {
      "const": "ea.artifact-type.integration-verification-contract/v1-candidate"
    },
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "minLength": 1,
      "type": "string"
    },
    "checks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "acceptance": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "stimulus": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "stimulus",
          "acceptance"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "environment": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_requirements": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "failure_route": {
      "minLength": 1,
      "type": "string"
    },
    "objective": {
      "minLength": 1,
      "type": "string"
    },
    "option_review_ref": {
      "minLength": 1,
      "type": "string"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "record_id": {
      "minLength": 1,
      "type": "string"
    },
    "rejection_gates": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "result_refs": {
      "maxItems": 0,
      "type": "array"
    },
    "run_refs": {
      "maxItems": 0,
      "type": "array"
    },
    "schema_version": {
      "const": "ea.integration-verification-contract/v1-candidate"
    },
    "source_excerpt_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "source_index": {
      "minimum": 0,
      "type": "integer"
    },
    "source_ref": {
      "minLength": 1,
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "threshold_registration": {
      "minLength": 1,
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "record_id",
    "version",
    "status",
    "authority_effect",
    "source_ref",
    "source_sha256",
    "source_index",
    "source_excerpt_sha256",
    "owner_ref",
    "challenge_route",
    "claim_ceiling",
    "schema_version",
    "artifact_type_ref",
    "option_review_ref",
    "objective",
    "environment",
    "checks",
    "failure_route",
    "evidence_requirements",
    "rejection_gates",
    "threshold_registration",
    "run_refs",
    "result_refs"
  ],
  "type": "object"
}
