{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type_ref": {
      "const": "ea.artifact-type.integration-option-review/v1-candidate"
    },
    "authority_effect": {
      "const": "none"
    },
    "boundary": {
      "minLength": 1,
      "type": "string"
    },
    "challenge_route": {
      "minLength": 1,
      "type": "string"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "decision_constraints": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "options": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "benefits": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "component_refs": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 0,
            "type": "array"
          },
          "dependencies": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "disposition": {
            "minLength": 1,
            "type": "string"
          },
          "evidence_maturity": {
            "minLength": 1,
            "type": "string"
          },
          "failure_modes": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "source_refs": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "tradeoffs": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "why": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "why",
          "benefits",
          "tradeoffs",
          "failure_modes",
          "source_refs",
          "component_refs",
          "dependencies",
          "evidence_maturity",
          "disposition"
        ],
        "type": "object"
      },
      "minItems": 2,
      "type": "array"
    },
    "owner_decision_ref": {
      "type": "null"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "problem": {
      "minLength": 1,
      "type": "string"
    },
    "provisional_preference": {
      "minLength": 1,
      "type": "string"
    },
    "rationale": {
      "minLength": 1,
      "type": "string"
    },
    "record_id": {
      "minLength": 1,
      "type": "string"
    },
    "rejected_alternatives": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array"
    },
    "requirement_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "revisit_triggers": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "ea.integration-option-review/v1-candidate"
    },
    "source_excerpt_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "source_index": {
      "minimum": 0,
      "type": "integer"
    },
    "source_ref": {
      "minLength": 1,
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "unresolved_assumptions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "verification_contract_ref": {
      "minLength": 1,
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "record_id",
    "version",
    "status",
    "authority_effect",
    "source_ref",
    "source_sha256",
    "source_index",
    "source_excerpt_sha256",
    "owner_ref",
    "challenge_route",
    "claim_ceiling",
    "schema_version",
    "artifact_type_ref",
    "boundary",
    "problem",
    "requirement_refs",
    "options",
    "provisional_preference",
    "rationale",
    "unresolved_assumptions",
    "decision_constraints",
    "revisit_triggers",
    "rejected_alternatives",
    "verification_contract_ref",
    "owner_decision_ref"
  ],
  "type": "object"
}
