{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "replace_same_slot"
          }
        }
      },
      "then": {
        "properties": {
          "successor_assignment_ref": {
            "minLength": 1,
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "continue_offline_capture",
              "resume_upload",
              "wait_same_assignment"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "successor_assignment_ref": {
            "type": "null"
          }
        }
      }
    }
  ],
  "properties": {
    "actor_ref": {
      "minLength": 1,
      "type": "string"
    },
    "analysis_posture": {
      "enum": [
        "primary-candidate",
        "sensitivity-only",
        "excluded"
      ]
    },
    "artifact_type_ref": {
      "const": "ea.artifact-type.recovery-decision/v1-candidate"
    },
    "authority_effect": {
      "const": "none"
    },
    "case_version_ref": {
      "minLength": 1,
      "type": "string"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "created_at": {
      "minLength": 1,
      "type": "string"
    },
    "decision_id": {
      "minLength": 1,
      "type": "string"
    },
    "event_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "idempotency_key": {
      "minLength": 1,
      "type": "string"
    },
    "media_ref": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "outcome": {
      "enum": [
        "wait_same_assignment",
        "continue_offline_capture",
        "resume_upload",
        "technical_void",
        "replace_same_slot",
        "human_review",
        "withdrawn"
      ]
    },
    "policy_ref": {
      "minLength": 1,
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "type": "string"
    },
    "recorded_seconds_remaining": {
      "maximum": 600,
      "minimum": 0,
      "type": [
        "number",
        "null"
      ]
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "rule_ref": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "ea.recovery-decision/v1-candidate"
    },
    "session_assignment_ref": {
      "minLength": 1,
      "type": "string"
    },
    "slot": {
      "maximum": 3,
      "minimum": 1,
      "type": "integer"
    },
    "status": {
      "enum": [
        "candidate-unadmitted",
        "synthetic-fixture",
        "recorded"
      ]
    },
    "successor_assignment_ref": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "supersedes_ref": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "timer_deadline": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "timing_assurance": {
      "enum": [
        "server-evidenced",
        "client-only",
        "unknown"
      ]
    }
  },
  "required": [
    "schema_version",
    "artifact_type_ref",
    "status",
    "authority_effect",
    "claim_ceiling",
    "decision_id",
    "revision",
    "session_assignment_ref",
    "case_version_ref",
    "slot",
    "policy_ref",
    "rule_ref",
    "event_refs",
    "outcome",
    "reason",
    "timer_deadline",
    "recorded_seconds_remaining",
    "timing_assurance",
    "analysis_posture",
    "successor_assignment_ref",
    "media_ref",
    "actor_ref",
    "idempotency_key",
    "created_at",
    "supersedes_ref"
  ],
  "title": "recovery-decision candidate record",
  "type": "object"
}
