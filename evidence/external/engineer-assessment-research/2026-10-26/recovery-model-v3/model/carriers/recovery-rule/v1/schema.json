{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type_ref": {
      "const": "ea.artifact-type.recovery-rule/v1-candidate"
    },
    "authority_effect": {
      "const": "none"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "default_disposition": {
      "enum": [
        "wait_same_assignment",
        "continue_offline_capture",
        "resume_upload",
        "technical_void",
        "human_review",
        "withdrawn"
      ]
    },
    "detection": {
      "minLength": 1,
      "type": "string"
    },
    "failure_class": {
      "minLength": 1,
      "type": "string"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "participant_message": {
      "minLength": 1,
      "type": "string"
    },
    "phase": {
      "enum": [
        "before_start",
        "recording",
        "upload_pending",
        "transcript_pending",
        "scoring_pending",
        "any_nonterminal"
      ]
    },
    "policy_ref": {
      "minLength": 1,
      "type": "string"
    },
    "preserve": {
      "minLength": 1,
      "type": "string"
    },
    "rule_id": {
      "minLength": 1,
      "pattern": "^RR-[0-9]{2}$",
      "type": "string"
    },
    "schema_version": {
      "const": "ea.recovery-rule/v1-candidate"
    },
    "source_excerpt_sha256": {
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "source_index": {
      "minimum": 0,
      "type": "integer"
    },
    "source_ref": {
      "const": "model/recovery/rule-source.json"
    },
    "source_sha256": {
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "status": {
      "enum": [
        "candidate-unadmitted",
        "synthetic-fixture",
        "recorded"
      ]
    },
    "timer_behavior": {
      "enum": [
        "not_started",
        "continues_original_deadline",
        "stopped_no_extension",
        "stop"
      ]
    },
    "version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "artifact_type_ref",
    "status",
    "authority_effect",
    "claim_ceiling",
    "rule_id",
    "version",
    "policy_ref",
    "failure_class",
    "phase",
    "detection",
    "preserve",
    "timer_behavior",
    "default_disposition",
    "participant_message",
    "source_ref",
    "source_sha256",
    "source_index",
    "source_excerpt_sha256",
    "owner_ref"
  ],
  "title": "recovery-rule candidate record",
  "type": "object"
}
