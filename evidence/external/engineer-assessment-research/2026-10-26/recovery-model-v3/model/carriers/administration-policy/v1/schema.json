{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type_ref": {
      "const": "ea.artifact-type.administration-policy/v1-candidate"
    },
    "authority_effect": {
      "const": "none"
    },
    "case_exposure_trigger": {
      "const": "start_acknowledged"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "critical_reveal_grace_seconds": {
      "const": 0
    },
    "max_technical_replacements_per_slot": {
      "minimum": 0,
      "type": "integer"
    },
    "offline_capture_condition": {
      "minLength": 1,
      "type": "string"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "policy_id": {
      "minLength": 1,
      "type": "string"
    },
    "reconnect_extra_seconds": {
      "const": 0
    },
    "recorded_seconds_limit": {
      "const": 600
    },
    "release_decision_ref": {
      "type": "null"
    },
    "replacement_requires_released_compatible_form": {
      "const": true
    },
    "rule_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": "ea.administration-policy/v1-candidate"
    },
    "source_ref": {
      "const": "software/RECOVERY-PROTOCOL.md"
    },
    "source_sha256": {
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "status": {
      "enum": [
        "candidate-unadmitted",
        "synthetic-fixture",
        "recorded"
      ]
    },
    "timing_uncertainty_handling": {
      "minLength": 1,
      "type": "string"
    },
    "upload_window_minutes": {
      "minimum": 1,
      "type": "integer"
    },
    "version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "artifact_type_ref",
    "status",
    "authority_effect",
    "claim_ceiling",
    "policy_id",
    "version",
    "source_ref",
    "source_sha256",
    "owner_ref",
    "recorded_seconds_limit",
    "case_exposure_trigger",
    "reconnect_extra_seconds",
    "upload_window_minutes",
    "critical_reveal_grace_seconds",
    "max_technical_replacements_per_slot",
    "replacement_requires_released_compatible_form",
    "offline_capture_condition",
    "timing_uncertainty_handling",
    "rule_refs",
    "release_decision_ref"
  ],
  "title": "administration-policy candidate record",
  "type": "object"
}
