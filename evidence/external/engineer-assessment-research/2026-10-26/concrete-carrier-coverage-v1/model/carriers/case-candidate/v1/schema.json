{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type_ref": {
      "const": "ea.artifact-type.case-candidate/v1-candidate"
    },
    "authority_effect": {
      "const": "none"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "record_id": {
      "pattern": "^EA-C[1-3]-[A-Z]+-[0-9]{3}$",
      "type": "string"
    },
    "schema_version": {
      "const": "ea.case-candidate/v1-candidate"
    },
    "session": {
      "maximum": 3,
      "minimum": 1,
      "type": "integer"
    },
    "source_ref": {
      "minLength": 1,
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "status": {
      "const": "draft-unreleased"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "artifact_type_ref",
    "record_id",
    "version",
    "status",
    "authority_effect",
    "session",
    "title",
    "source_ref",
    "source_sha256",
    "owner_ref",
    "claim_ceiling"
  ],
  "type": "object"
}
