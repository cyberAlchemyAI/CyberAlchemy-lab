{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type_ref": {
      "const": "ea.artifact-type.question-workflow/v1-candidate"
    },
    "authority_effect": {
      "const": "none"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "fields": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "minLength": 1,
          "type": "string"
        },
        "workflow": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "label",
        "workflow"
      ],
      "type": "object"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "record_id": {
      "const": "Q-W01"
    },
    "schema_version": {
      "const": "ea.question-workflow/v1-candidate"
    },
    "source_excerpt_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "source_line": {
      "minimum": 1,
      "type": "integer"
    },
    "source_ref": {
      "const": "software/QUESTION-LIFECYCLE.md"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "artifact_type_ref",
    "record_id",
    "version",
    "status",
    "authority_effect",
    "fields",
    "source_ref",
    "source_sha256",
    "source_line",
    "source_excerpt_sha256",
    "owner_ref",
    "claim_ceiling"
  ],
  "type": "object"
}
