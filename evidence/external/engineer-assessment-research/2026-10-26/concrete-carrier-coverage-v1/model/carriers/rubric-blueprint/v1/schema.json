{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type_ref": {
      "const": "ea.artifact-type.rubric-blueprint/v1-candidate"
    },
    "authority_effect": {
      "const": "none"
    },
    "case_candidate_ref": {
      "minLength": 1,
      "type": "string"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "dimensions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "anchor_2": {
            "minLength": 1,
            "type": "string"
          },
          "anchor_3": {
            "minLength": 1,
            "type": "string"
          },
          "anchor_4_or_na": {
            "minLength": 1,
            "type": "string"
          },
          "dimension_id": {
            "minLength": 1,
            "type": "string"
          },
          "label": {
            "minLength": 1,
            "type": "string"
          },
          "observable_evidence": {
            "minLength": 1,
            "type": "string"
          },
          "source_excerpt_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "dimension_id",
          "label",
          "observable_evidence",
          "anchor_2",
          "anchor_3",
          "anchor_4_or_na",
          "source_excerpt_sha256"
        ],
        "type": "object"
      },
      "maxItems": 6,
      "minItems": 6,
      "type": "array"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "record_id": {
      "pattern": "^draft-rubric:EA-C[1-3]-[A-Z]+-[0-9]{3}$",
      "type": "string"
    },
    "schema_version": {
      "const": "ea.rubric-blueprint/v1-candidate"
    },
    "source_ref": {
      "minLength": 1,
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "status": {
      "const": "draft-unreleased"
    },
    "universal_anchor_ref": {
      "const": "research/scoring-model.md"
    },
    "version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "artifact_type_ref",
    "record_id",
    "version",
    "status",
    "authority_effect",
    "case_candidate_ref",
    "universal_anchor_ref",
    "dimensions",
    "source_ref",
    "source_sha256",
    "owner_ref",
    "claim_ceiling"
  ],
  "type": "object"
}
