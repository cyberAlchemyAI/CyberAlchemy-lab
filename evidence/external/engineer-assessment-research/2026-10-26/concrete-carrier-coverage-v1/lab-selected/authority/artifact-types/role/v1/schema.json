{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_boundary": {
      "pattern": "\\S",
      "type": "string"
    },
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "claim_ceiling": {
      "pattern": "\\S",
      "type": "string"
    },
    "eligible_authority_relation_kinds": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "type": "array",
      "uniqueItems": true
    },
    "exclusions": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "functions": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "kind": {
      "const": "role"
    },
    "lifecycle_state": {
      "enum": [
        "draft",
        "active",
        "retired",
        "superseded"
      ],
      "type": "string"
    },
    "name": {
      "pattern": "\\S",
      "type": "string"
    },
    "node_id": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "owner_route": {
      "pattern": "\\S",
      "type": "string"
    },
    "purpose": {
      "pattern": "\\S",
      "type": "string"
    },
    "responsibility_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "type": "array",
      "uniqueItems": true
    },
    "scope_ref": {
      "pattern": "\\S",
      "type": "string"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "successor_refs": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "authority_effect",
    "kind",
    "node_id",
    "owner_ref",
    "scope_ref",
    "status",
    "name",
    "purpose",
    "functions",
    "responsibility_refs",
    "eligible_authority_relation_kinds",
    "authority_boundary",
    "exclusions",
    "lifecycle_state",
    "successor_refs",
    "owner_route",
    "challenge_route",
    "claim_ceiling"
  ],
  "type": "object"
}
