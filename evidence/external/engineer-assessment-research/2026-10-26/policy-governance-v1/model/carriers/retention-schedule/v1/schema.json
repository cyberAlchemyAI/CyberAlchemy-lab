{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval_ref": {
      "type": "null"
    },
    "artifact_type_ref": {
      "const": "ea.artifact-type.retention-schedule/v1-candidate"
    },
    "authority_effect": {
      "const": "none"
    },
    "challenge_route": {
      "minLength": 1,
      "type": "string"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "controller_ref": {
      "type": "null"
    },
    "entries": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "data_class": {
            "minLength": 1,
            "type": "string"
          },
          "deletion_route": {
            "minLength": 1,
            "type": "string"
          },
          "derivative_lineage": {
            "minLength": 1,
            "type": "string"
          },
          "duration_unit": {
            "type": "null"
          },
          "duration_value": {
            "type": "null"
          },
          "exception_route": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "owner_role": {
            "minLength": 1,
            "type": "string"
          },
          "purpose": {
            "minLength": 1,
            "type": "string"
          },
          "source_refs": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "start_trigger": {
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "const": "candidate-unapproved"
          }
        },
        "required": [
          "id",
          "data_class",
          "purpose",
          "start_trigger",
          "duration_value",
          "duration_unit",
          "deletion_route",
          "derivative_lineage",
          "exception_route",
          "owner_role",
          "source_refs",
          "status"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "jurisdiction": {
      "type": "null"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "policy_ref": {
      "minLength": 1,
      "type": "string"
    },
    "record_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "ea.retention-schedule/v1-candidate"
    },
    "source_excerpt_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "source_index": {
      "minimum": 0,
      "type": "integer"
    },
    "source_ref": {
      "minLength": 1,
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "record_id",
    "version",
    "status",
    "authority_effect",
    "source_ref",
    "source_sha256",
    "source_index",
    "source_excerpt_sha256",
    "owner_ref",
    "challenge_route",
    "claim_ceiling",
    "schema_version",
    "artifact_type_ref",
    "policy_ref",
    "jurisdiction",
    "controller_ref",
    "approval_ref",
    "entries"
  ],
  "type": "object"
}
