{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type_ref": {
      "const": "ea.artifact-type.technology-component/v1-candidate"
    },
    "authority_effect": {
      "const": "none"
    },
    "boundary_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array"
    },
    "challenge_route": {
      "minLength": 1,
      "type": "string"
    },
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "component_kind": {
      "minLength": 1,
      "type": "string"
    },
    "data_exposure": {
      "minLength": 1,
      "type": "string"
    },
    "legal_processor_ref": {
      "type": "null"
    },
    "license_or_terms_ref": {
      "type": "null"
    },
    "lifecycle_status": {
      "const": "unverified"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "operating_owner_ref": {
      "type": "null"
    },
    "owner_ref": {
      "minLength": 1,
      "type": "string"
    },
    "publisher_or_maintainer_ref": {
      "type": "null"
    },
    "record_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "ea.technology-component/v1-candidate"
    },
    "selection_posture": {
      "const": "candidate-only"
    },
    "source_excerpt_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "source_index": {
      "minimum": 0,
      "type": "integer"
    },
    "source_ref": {
      "minLength": 1,
      "type": "string"
    },
    "source_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "status": {
      "const": "candidate-unadmitted"
    },
    "unresolved": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "upstream_identity_ref": {
      "type": "null"
    },
    "version": {
      "minLength": 1,
      "type": "string"
    },
    "version_pin": {
      "type": "null"
    }
  },
  "required": [
    "record_id",
    "version",
    "status",
    "authority_effect",
    "source_ref",
    "source_sha256",
    "source_index",
    "source_excerpt_sha256",
    "owner_ref",
    "challenge_route",
    "claim_ceiling",
    "schema_version",
    "artifact_type_ref",
    "name",
    "component_kind",
    "boundary_refs",
    "source_refs",
    "selection_posture",
    "version_pin",
    "license_or_terms_ref",
    "publisher_or_maintainer_ref",
    "upstream_identity_ref",
    "lifecycle_status",
    "legal_processor_ref",
    "operating_owner_ref",
    "data_exposure",
    "unresolved"
  ],
  "type": "object"
}
